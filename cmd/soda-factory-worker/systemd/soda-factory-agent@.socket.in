[Unit]
Description=Factory exact-run agent admission socket for %i
BindsTo=soda-factory-provider-relay@%i.service
After=soda-factory-provider-relay@%i.service

[Socket]
ListenStream=/run/soda-factory/agents/%i.sock
SocketUser=root
SocketMode=0600
DirectoryMode=0755
Accept=no
Service=soda-factory-agent@%i.service
RemoveOnStop=yes
