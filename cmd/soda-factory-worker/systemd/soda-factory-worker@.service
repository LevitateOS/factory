[Unit]
Description=Factory isolated worker instance
Requires=soda-factory-worker.socket

[Service]
Type=simple
ExecStart=/usr/libexec/soda-factory-worker
StandardInput=socket
StandardOutput=inherit
StandardError=journal
DynamicUser=yes
UMask=0077
RuntimeDirectory=soda-factory-worker/%i
RuntimeDirectoryMode=0700
ProtectHome=yes
PrivateTmp=yes
PrivateIPC=yes
KeyringMode=private
PrivateDevices=yes
ProtectProc=invisible
ProtectSystem=strict
ProtectControlGroups=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
NoNewPrivileges=yes
SystemCallArchitectures=native
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
CapabilityBoundingSet=
AmbientCapabilities=
Delegate=yes
CPUAccounting=yes
MemoryAccounting=yes
TasksAccounting=yes
TasksMax=128
MemoryMax=1G
CPUQuota=100%
TimeoutStartSec=10s
RuntimeMaxSec=4h
KillMode=control-group
