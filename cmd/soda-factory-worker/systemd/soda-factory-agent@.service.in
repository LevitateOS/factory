[Unit]
Description=Factory isolated agent boundary for run %i
BindsTo=soda-factory-provider-relay@%i.service
After=soda-factory-provider-relay@%i.service
JoinsNamespaceOf=soda-factory-provider-relay@%i.service

[Service]
Type=exec
ExecStart=/usr/libexec/soda-factory-agent %i @DESKTOP_UID@
DynamicUser=yes
UMask=0077
RuntimeDirectory=soda-factory-agent/%i
RuntimeDirectoryMode=0700
TemporaryFileSystem=/run/soda-factory-agent:mode=0700
# This mount belongs to this service instance. The worker creates its 0700
# run directory inside it after checking the mount identity and size.
TemporaryFileSystem=/run/factory-agent-private:mode=1777,size=768M
InaccessiblePaths=/tmp /var/tmp /dev/shm /run/lock
BindReadOnlyPaths=/run/soda-factory-broker/preparations/%i/output/repo:/run/factory-source
BindReadOnlyPaths=/run/soda-factory-broker/preparations/%i/agent.role:/run/factory-role
ProtectHome=yes
PrivateTmp=yes
PrivateIPC=yes
KeyringMode=private
PrivateDevices=yes
ProtectProc=invisible
PrivatePIDs=yes
PrivateNetwork=yes
IPAddressDeny=any
IPAddressAllow=127.0.0.1/32
RestrictAddressFamilies=AF_UNIX AF_INET
ProtectSystem=strict
ProtectControlGroups=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
NoNewPrivileges=yes
SystemCallArchitectures=native
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
CapabilityBoundingSet=
AmbientCapabilities=
# Keep the main process in a leaf so the delegated root can enable controllers.
Slice=system.slice
Delegate=cpu memory pids
DelegateSubgroup=init
TemporaryFileSystem=/sys/fs/cgroup:mode=0755
BindPaths=/sys/fs/cgroup/system.slice/soda-factory-agent@%i.service:/sys/fs/cgroup/factory
CPUAccounting=yes
MemoryAccounting=yes
TasksAccounting=yes
CPUQuota=100%
MemoryMax=1G
MemorySwapMax=0
TasksMax=128
TimeoutStartSec=10s
# A stalled namespace init may not handle SIGTERM during startup. Bound the
# grace period before systemd kills the entire service control group.
TimeoutStopSec=2s
RuntimeMaxSec=4h5m
KillMode=control-group
