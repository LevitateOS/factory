[Unit]
Description=Factory isolated agent boundary for run %i
Requires=soda-factory-provider-relay@%i.service
After=soda-factory-provider-relay@%i.service
JoinsNamespaceOf=soda-factory-provider-relay@%i.service

[Service]
Type=exec
ExecStart=/usr/libexec/soda-factory-agent %i @DESKTOP_UID@
DynamicUser=yes
UMask=0077
RuntimeDirectory=soda-factory-agent/%i
RuntimeDirectoryMode=0700
BindReadOnlyPaths=/run/soda-factory-broker/preparations/%i/output/repo:/run/factory-source
BindReadOnlyPaths=/run/soda-factory-broker/preparations/%i/agent.role:/run/factory-role
ProtectHome=yes
PrivateTmp=yes
PrivateIPC=yes
KeyringMode=private
PrivateDevices=yes
ProtectProc=invisible
PrivateNetwork=yes
IPAddressDeny=any
IPAddressAllow=127.0.0.1/32
RestrictAddressFamilies=AF_UNIX AF_INET
ProtectSystem=strict
ProtectControlGroups=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
NoNewPrivileges=yes
SystemCallArchitectures=native
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
CapabilityBoundingSet=
AmbientCapabilities=
Delegate=yes
CPUAccounting=yes
MemoryAccounting=yes
TasksAccounting=yes
CPUQuota=100%
MemoryMax=1G
TasksMax=128
TimeoutStartSec=10s
RuntimeMaxSec=4h
KillMode=control-group
