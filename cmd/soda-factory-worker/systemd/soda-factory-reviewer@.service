[Unit]
Description=Factory isolated reviewer run for %i

[Service]
Type=exec
ExecStart=/usr/libexec/soda-factory-reviewer %i
DynamicUser=yes
UMask=0077
RuntimeDirectory=soda-factory-reviewer/%i
RuntimeDirectoryMode=0700
BindReadOnlyPaths=/run/soda-factory-broker/preparations/%i/output/repo:/run/factory-worktree
ProtectHome=yes
PrivateTmp=yes
PrivateIPC=yes
KeyringMode=private
PrivateDevices=yes
ProtectProc=invisible
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
ProtectSystem=strict
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
NoNewPrivileges=yes
SystemCallArchitectures=native
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
CapabilityBoundingSet=
AmbientCapabilities=
CPUAccounting=yes
MemoryAccounting=yes
TasksAccounting=yes
CPUQuota=100%
MemoryMax=128M
TasksMax=32
TimeoutStartSec=10s
RuntimeMaxSec=15s
KillMode=control-group
