[Unit]
Description=Factory prepared source Git operations for %i

[Service]
Type=oneshot
DynamicUser=yes
ExecStart=/usr/libexec/soda-factory-preparer context
BindReadOnlyPaths=/run/soda-factory-broker/preparations/%i/output/repo:/run/factory-output/repo
BindReadOnlyPaths=/run/soda-factory-broker/preparations/%i/context-request.json:/run/factory-context-request
BindReadOnlyPaths=/run/soda-factory-broker/runs/%i/bundle:/run/factory-context-base.bundle
BindReadOnlyPaths=/run/soda-factory-broker/preparations/%i/context-candidate.bundle:/run/factory-context-candidate.bundle
BindPaths=/run/soda-factory-broker/preparations/%i/context-output:/run/factory-context-output
TemporaryFileSystem=/run/factory-context-private:rw,size=96M,mode=0777
UMask=0022
ProtectHome=yes
PrivateTmp=yes
PrivateIPC=yes
KeyringMode=private
PrivateDevices=yes
ProtectProc=invisible
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
ProtectSystem=strict
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
NoNewPrivileges=yes
SystemCallArchitectures=native
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
CapabilityBoundingSet=
AmbientCapabilities=
CPUAccounting=yes
MemoryAccounting=yes
TasksAccounting=yes
CPUQuota=100%
MemoryMax=128M
MemorySwapMax=0
TasksMax=32
TimeoutStartSec=30s
TimeoutStopSec=2s
KillMode=control-group
