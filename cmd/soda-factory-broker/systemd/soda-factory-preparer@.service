[Unit]
Description=Factory isolated reviewer checkout preparation for %i

[Service]
Type=oneshot
DynamicUser=yes
EnvironmentFile=/run/soda-factory-broker/preparations/%i/manifest.env
ExecStart=/usr/libexec/soda-factory-preparer %i ${FACTORY_CANDIDATE} ${FACTORY_BUNDLE_SHA256}
BindReadOnlyPaths=/run/soda-factory-broker/runs/%i:/run/factory-source
BindPaths=/run/soda-factory-broker/preparations/%i/output:/run/factory-output
UMask=0022
ProtectHome=yes
PrivateTmp=yes
PrivateIPC=yes
KeyringMode=private
PrivateDevices=yes
ProtectProc=invisible
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
ProtectSystem=strict
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
NoNewPrivileges=yes
SystemCallArchitectures=native
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
CapabilityBoundingSet=
AmbientCapabilities=
CPUAccounting=yes
MemoryAccounting=yes
TasksAccounting=yes
CPUQuota=100%
MemoryMax=128M
MemorySwapMax=0
TasksMax=32
# Per-entry deadlines come from the exact approved setup-limits.json (10s each
# when absent). This is the independent hard ceiling, including checkout work.
TimeoutStartSec=3660s
TimeoutStopSec=2s
KillMode=control-group
