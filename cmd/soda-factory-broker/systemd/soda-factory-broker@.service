[Unit]
Description=Factory privileged run staging instance
Requires=soda-factory-broker.socket

[Service]
Type=simple
ExecStart=/usr/libexec/soda-factory-broker
StandardInput=socket
StandardOutput=inherit
StandardError=journal
UMask=0077
RuntimeDirectory=soda-factory-broker
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ProtectHome=yes
PrivateTmp=yes
PrivateIPC=yes
KeyringMode=private
PrivateDevices=yes
ProtectProc=invisible
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
NoNewPrivileges=yes
SystemCallArchitectures=native
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
CapabilityBoundingSet=
AmbientCapabilities=
MemoryAccounting=yes
TasksAccounting=yes
TasksMax=16
MemoryMax=64M
RuntimeMaxSec=15s
KillMode=control-group
