{
  "name": "@factory/product",
  "private": true,
  "workspaces": [
    "tools/lit-check"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run build:desktop-ui",
    "build:server": "go build -mod=readonly -o .artifacts/bin/soda-factory-server ./cmd/soda-factory-server",
    "build:factory-ui": "bun scripts/build-factory-ui.ts",
    "build:desktop-ui": "bun scripts/build-desktop-ui.ts",
    "build:desktop": "bun scripts/build-desktop.ts",
    "storybook": "storybook dev --config-dir frontend/storybook --host 127.0.0.1 --port 6006 --no-open",
    "build:storybook": "storybook build --config-dir frontend/storybook --output-dir .artifacts/storybook",
    "typecheck": "bun --bun node_modules/typescript/bin/tsc -p tsconfig.json && bun --bun node_modules/typescript/bin/tsc -p tsconfig.browser.json && bun --bun node_modules/typescript/bin/tsc -p tools/lit-check/tsconfig.json",
    "check:boundaries": "bash scripts/check-factory-boundaries.sh",
    "check:lit": "bun scripts/check-lit.ts",
    "check:ts-unitban": "bun scripts/check-ts-unitban.ts",
    "dev:desktop-ui": "bun run build:storybook && cargo run --locked -p soda-factory-ui --features native-ui",
    "check:desktop-ui": "bun run build:storybook && cargo run --locked -p soda-factory-ui --features native-ui -- --check",
    "check:desktop-diff": "bun run build:storybook && cargo run --locked -p soda-factory-ui --features native-ui -- --check-diff"
  },
  "dependencies": {
    "@pierre/diffs": "1.6.4",
    "lit": "3.3.3",
    "marked": "18.1.3",
    "dompurify": "3.4.17"
  },
  "devDependencies": {
    "@storybook/web-components-vite": "10.6.6",
    "@types/bun": "1.4.4",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "jsdom": "31.0.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "playwright": "1.65.0",
    "storybook": "10.6.6",
    "typescript": "7.0.2",
    "vite": "8.3.7"
  },
  "trustedDependencies": []
}
