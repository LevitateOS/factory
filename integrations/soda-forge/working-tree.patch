+// Native PostgreSQL upgrade and three-lifetime proof for immutable edit capture.
+// Provider JSON is opaque fixture preparation; no provider operation is sent.
+func checkNativeHumanReviewDevelopmentSchema(t *testing.T, s *Store, dsn, path string) {
+	t.Helper()
+	ctx := t.Context()
+	pull := os.Getenv("SODA_NATIVE_HUMAN_PULL_CREATE_SCHEMA_FILE") != ""
+	merge := pull || os.Getenv("SODA_NATIVE_HUMAN_MERGE_SCHEMA_FILE") != ""
+	reviewer := merge || os.Getenv("SODA_NATIVE_HUMAN_REVIEW_REQUEST_SCHEMA_FILE") != ""
+	thread := reviewer || os.Getenv("SODA_NATIVE_HUMAN_THREAD_SCHEMA_FILE") != ""
+	inline := thread || os.Getenv("SODA_NATIVE_HUMAN_INLINE_SCHEMA_FILE") != ""
+	script, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// The generated development-copy SQL must refuse the actual native database.
+	conn, err := s.db.Conn(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := conn.ExecContext(ctx, string(script)); err == nil {
+		t.Fatal("development SQL admitted native database")
+	}
+	if _, err := conn.ExecContext(ctx, "ROLLBACK"); err != nil {
+		t.Fatal(err)
+	}
+	if err := conn.Close(); err != nil {
+		t.Fatal(err)
+	}
+	var version int
+	if err := s.db.QueryRowContext(ctx, "SELECT version FROM schema_version").Scan(&version); err != nil || version != SchemaVersion() {
+		t.Fatal("development SQL changed native marker", version, err)
+	}
+	// This database belongs only to the driver's new private cluster.
+	if _, err := s.db.ExecContext(ctx, "CREATE DATABASE soda_dev"); err != nil {
+		t.Fatal(err)
+	}
+	uri, err := url.Parse(dsn)
+	if err != nil {
+		t.Fatal("invalid private native DSN")
+	}
+	uri.Path = "/soda_dev"
+	development, err := Open(uri.String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer development.Close()
