new file mode 100644
index 0000000000000000000000000000000000000000..4f109c5146ad3cb0829bc676d7779c6a5a395990
--- /dev/null
+++ b/internal/factory/service/work_journeys.go
@@ -0,0 +1,78 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"strconv"
+	"time"
+
+	"github.com/levitateos/sodaos/internal/collaboration"
+	"github.com/levitateos/sodaos/internal/factory"
+	"github.com/levitateos/sodaos/internal/store"
+)
+
+type WorkVisibility func(context.Context, collaboration.ActorID, collaboration.RepositoryID) error
+
+type WorkJourneys struct {
+	Store      *store.Store
+	Visibility WorkVisibility
+}
+
+var (
+	ErrWorkJourneyInvalid     = errors.New("invalid issue-work journey scope")
+	ErrWorkJourneyUnavailable = errors.New("issue-work journey is unavailable")
+	ErrWorkJourneyVisibility  = errors.New("issue-work journey is not visible")
+	ErrWorkJourneyScope       = errors.New("issue-work journey record conflicts with its scope")
+)
+
+// Read resolves its recorded owner/publication itself. Callers supply current
+// admission, never a browser-selected assignment or claimed delivery evidence.
+// No model, provider-effect or execution port is available to this read.
+func (s WorkJourneys) Read(ctx context.Context, actor collaboration.ActorID, repository collaboration.RepositoryID, issue int64) (*IssueJourney, error) {
+	if actor < 1 || repository < 1 || issue < 1 {
+		return nil, ErrWorkJourneyInvalid
+	}
+	if s.Store == nil || s.Visibility == nil {
+		return nil, ErrWorkJourneyUnavailable
+	}
+	visible := func() error {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		if err := s.Visibility(ctx, actor, repository); err != nil {
+			return errors.Join(ErrWorkJourneyVisibility, err)
+		}
+		return ctx.Err()
+	}
+	if err := visible(); err != nil {
+		return nil, err
+	}
+	var owner *factory.Assignment
+	if recorded, err := s.Store.LatestIssueAssignment(ctx, int64(repository), issue); err == nil {
+		if recorded.Repository != int64(repository) || recorded.Issue != issue {
+			return nil, ErrWorkJourneyScope
+		}
+		owner = &recorded
+	} else if !errors.Is(err, store.ErrNotFound) {
+		return nil, err
+	}
+	var publication *factory.Publication
+	if owner != nil {
+		if recorded, err := s.Store.PublicationByAssignment(ctx, owner.ID); err == nil {
+			if recorded.Repository != int64(repository) || recorded.Issue != issue || recorded.AssignmentID != owner.ID {
+				return nil, ErrWorkJourneyScope
+			}
+			publication = &recorded
+		} else if !errors.Is(err, store.ErrNotFound) {
+			return nil, err
+		}
+	}
+	view, err := s.assemble(ctx, int64(repository), issue, strconv.FormatInt(issue, 10), owner, publication, time.Now().Unix())
+	if err != nil {
+		return nil, err
+	}
+	if err := visible(); err != nil {
+		return nil, err
+	}
+	return view, nil
+}
diff --git a/internal/factory/service/work_reads.go b/internal/factory/service/work_reads.go
new file mode 100644
index 0000000000000000000000000000000000000000..da7deb3d58d0fcc83fe7e3617054b8fa300ded8b
--- /dev/null
+++ b/internal/factory/service/work_reads.go
@@ -0,0 +1,105 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"strconv"
+	"time"
+
+	"github.com/levitateos/sodaos/internal/collaboration"
+	"github.com/levitateos/sodaos/internal/factory"
+	"github.com/levitateos/sodaos/internal/store"
+)
+
+type WorkReads struct {
+	Store      *store.Store
+	Visibility WorkVisibility
+}
+
+var (
+	ErrWorkReadUnavailable = errors.New("recorded work reads are unavailable")
+	ErrWorkReadVisibility  = errors.New("recorded work is not visible")
+	ErrWorkReadQuery       = errors.New("invalid recorded work query")
+)
+
+func (s WorkReads) visible(ctx context.Context, actor collaboration.ActorID, repository collaboration.RepositoryID, issue int64) error {
+	if actor < 1 || repository < 1 || issue < 1 {
+		return ErrWorkReadQuery
+	}
+	if s.Store == nil || s.Visibility == nil {
+		return ErrWorkReadUnavailable
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if err := s.Visibility(ctx, actor, repository); err != nil {
+		return errors.Join(ErrWorkReadVisibility, err)
+	}
+	return ctx.Err()
+}
+
+// Assignment returns exact recorded inputs/results and held capacity after
+// current visibility admission. Stored prompt bytes never select credentials.
+func (s WorkReads) Assignment(ctx context.Context, actor collaboration.ActorID, repository collaboration.RepositoryID, issue int64) (*AssignmentView, error) {
+	if err := s.visible(ctx, actor, repository, issue); err != nil {
+		return nil, err
+	}
+	current, err := s.Store.LatestIssueAssignment(ctx, int64(repository), issue)
+	if err != nil {
+		return nil, err
+	}
+	if current.Repository != int64(repository) || current.Issue != issue {
+		return nil, ErrWorkJourneyScope
+	}
+	var reservation *factory.Reservation
+	if held, err := s.Store.Reservation(ctx, current.ID); err == nil {
+		if held.Repository != int64(repository) || held.AssignmentID != current.ID {
+			return nil, ErrWorkJourneyScope
+		}
+		reservation = &held
+	} else if !errors.Is(err, store.ErrNotFound) {
+		return nil, err
+	}
+	var publication *factory.Publication
+	if recorded, err := s.Store.PublicationByAssignment(ctx, current.ID); err == nil {
+		if recorded.Repository != int64(repository) || recorded.Issue != issue || recorded.AssignmentID != current.ID {
+			return nil, ErrWorkJourneyScope
+		}
+		publication = &recorded
+	} else if !errors.Is(err, store.ErrNotFound) {
+		return nil, err
+	}
+	view := assignmentDTO(current, reservation, publication)
+	if err := s.visible(ctx, actor, repository, issue); err != nil {
+		return nil, err
+	}
+	return &view, nil
+}
+
+// Priority reads existing journal comparisons, never a new comparison. Foreign
+// candidates remain counted but their identities/selections are not exposed.
+func (s WorkReads) Priority(ctx context.Context, actor collaboration.ActorID, repository collaboration.RepositoryID, issue int64, cursor store.PriorityComparisonCursor, limit int) (*IssuePriorityView, error) {
+	if limit < 1 || limit > store.MaxPriorityComparisons || cursor.BeforeUnix < 0 || (cursor.BeforeUnix != 0 || cursor.BeforeSnapshot != "") && (cursor.BeforeUnix <= 0 || !factory.ValidDigest(cursor.BeforeSnapshot)) {
+		return nil, ErrWorkReadQuery
+	}
+	if err := s.visible(ctx, actor, repository, issue); err != nil {
+		return nil, err
+	}
+	receipts, more, err := s.Store.PriorityReceiptsForIssue(ctx, int64(repository), issue, cursor, limit)
+	if err != nil {
+		return nil, err
+	}
+	observed := time.Now().Unix()
+	view := &IssuePriorityView{Comparisons: []priorityComparisonView{}, Repository: strconv.FormatInt(int64(repository), 10), Issue: strconv.FormatInt(issue, 10), ObservedUnix: observed}
+	for _, receipt := range receipts {
+		view.Comparisons = append(view.Comparisons, priorityComparisonDTO(receipt, int64(repository), observed))
+	}
+	if more && len(receipts) > 0 {
+		trailing := receipts[len(receipts)-1]
+		view.NextBeforeUnix, view.NextBeforeSnapshot = trailing.CreatedUnix, trailing.Snapshot
+	}
+	if err := s.visible(ctx, actor, repository, issue); err != nil {
+		return nil, err
+	}
+	return view, nil
+}
diff --git a/internal/factory/service/worker_admission.go b/internal/factory/service/worker_admission.go
new file mode 100644
index 0000000000000000000000000000000000000000..7918471ec589fca42a60c9b90ba5a4c77a43d8f7
--- /dev/null
+++ b/internal/factory/service/worker_admission.go
@@ -0,0 +1,142 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"strconv"
+	"time"
+
+	"github.com/levitateos/sodaos/internal/collaboration"
+	"github.com/levitateos/sodaos/internal/factory"
+	"github.com/levitateos/sodaos/internal/factory/execution"
+	"github.com/levitateos/sodaos/internal/project"
+	"github.com/levitateos/sodaos/internal/store"
+)
+
+// WorkerAdmission consumes an authenticated capability and observes its recorded
+// worker. Inspect supplies runtime facts, never a new launch or credential.
+// Activation and current stop/preparation gates remain in the existing store.
+type WorkerAdmission struct {
+	Store   *store.Store
+	Inspect func(context.Context, execution.RunAddress) (execution.RunObservation, error)
+}
+
+var (
+	ErrWorkerUnavailable = errors.New("worker observation is unavailable")
+	ErrWorkerBinding     = errors.New("worker no longer matches its admitted capability")
+	ErrWorkerObservation = errors.New("worker is not running in its admitted environment")
+)
+
+func (s WorkerAdmission) current(ctx context.Context, admitted factory.MCPCapability) (factory.MCPCapability, factory.Assignment, factory.Run, error) {
+	var empty factory.MCPCapability
+	var assignment factory.Assignment
+	var run factory.Run
+	cap, err := s.Store.GetMCPCapability(ctx, admitted.ID)
+	if err != nil {
+		return empty, assignment, run, err
+	}
+	if cap.Validate() != nil || cap.ScopeDigest() != admitted.ScopeDigest() || cap.Expired(time.Now()) || (cap.State != factory.MCPCapabilityStaged && cap.State != factory.MCPCapabilityActive) {
+		return empty, assignment, run, ErrWorkerBinding
+	}
+	if err := s.Store.CheckMCPWorkActive(ctx, cap); err != nil {
+		return empty, assignment, run, err
+	}
+	assignment, err = s.Store.Assignment(ctx, cap.AssignmentID)
+	if err != nil {
+		return empty, assignment, run, err
+	}
+	if assignment.ID != cap.AssignmentID || assignment.Run != cap.RunID || assignment.ProjectID != cap.Project || assignment.Repository != cap.Repository || assignment.SourceCommit != cap.SourceDigest || assignment.Subject.SubjectKey(assignment.Repository) != cap.Subject || strconv.FormatInt(assignment.NativeRev, 10) != cap.AcceptedRevision {
+		return empty, assignment, run, ErrWorkerBinding
+	}
+	run, err = s.Store.FactoryRun(ctx, cap.RunID)
+	if err != nil {
+		return empty, assignment, run, err
+	}
+	if run.ID != cap.RunID || run.ProjectID != cap.Project || run.Role != assignment.Role || run.InputSHA != assignment.SourceCommit || run.Reconciled || run.Outcome != "" || (!run.Deadline.IsZero() && !time.Now().Before(run.Deadline)) {
+		return empty, assignment, run, ErrWorkerBinding
+	}
+	return cap, assignment, run, ctx.Err()
+}
+
+func workerObservation(run factory.Run, observation execution.RunObservation) error {
+	address := execution.RunAddress{Run: run.ID, Workspace: run.ProjectID}
+	if observation.ValidateFor(address) != nil || observation.Kind != run.RuntimeKind() || !observation.Live || observation.Phase != project.FactoryRunning || observation.Retirement != execution.Running || observation.Role != run.Role || observation.ExitCode != nil {
+		return ErrWorkerObservation
+	}
+	if run.Native != nil {
+		if run.Native.Sealed || run.Native.Provenance.Process == nil {
+			return ErrWorkerObservation
+		}
+		if observation.Native.Process == nil || observation.Native.Process.ExitCode != nil || observation.Native.Process.ExitSignal != nil {
+			return ErrWorkerObservation
+		}
+		next := *run.Native
+		next.Provenance, next.Retirement = *observation.Native, observation.Retirement
+		if !next.Advances(*run.Native) {
+			return ErrWorkerObservation
+		}
+		return nil
+	}
+	if observation.Kind != collaboration.Appliance || observation.Appliance == nil {
+		return ErrWorkerObservation
+	}
+	actual := observation.Appliance.Invocation
+	if actual.Generation < 1 || actual.Unit == "" || actual.Container == "" || actual.Invocation == "" || (run.IdentityGeneration > 0 && run.IdentityGeneration != actual.Generation) {
+		return ErrWorkerObservation
+	}
+	if invocation := run.InvocationID(); invocation != "" && invocation != actual.Invocation {
+		return ErrWorkerObservation
+	}
+	if recorded := run.ApplianceInvocation; recorded != nil && !actual.Advances(*recorded) {
+		return ErrWorkerObservation
+	}
+	return nil
+}
+
+// Prepare activates only a currently observed, matching worker. Every request
+// reloads current records after I/O, so a cached credential/observation cannot
+// outlive revocation, stop or a different captured process incarnation.
+func (s WorkerAdmission) Prepare(ctx context.Context, admitted factory.MCPCapability) (factory.MCPCapability, error) {
+	var empty factory.MCPCapability
+	if s.Store == nil || s.Inspect == nil {
+		return empty, ErrWorkerUnavailable
+	}
+	if admitted.Validate() != nil || (admitted.State != factory.MCPCapabilityStaged && admitted.State != factory.MCPCapabilityActive) {
+		return empty, ErrWorkerBinding
+	}
+	bounded, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	cap, _, run, err := s.current(bounded, admitted)
+	if err != nil {
+		return empty, err
+	}
+	observation, err := s.Inspect(bounded, execution.RunAddress{Run: run.ID, Workspace: run.ProjectID})
+	if err != nil {
+		return empty, errors.Join(ErrWorkerObservation, err)
+	}
+	if err := workerObservation(run, observation); err != nil {
+		return empty, err
+	}
+	cap, _, latest, err := s.current(bounded, admitted)
+	if err != nil {
+		return empty, err
+	}
+	if err := workerObservation(latest, observation); err != nil {
+		return empty, err
+	}
+	if err := bounded.Err(); err != nil {
+		return empty, err
+	}
+	if cap.State == factory.MCPCapabilityStaged {
+		if err := s.Store.ActivateObservedMCPCapability(bounded, cap); err != nil {
+			return empty, err
+		}
+	}
+	// The transaction owns final activation/stop checks. Return its current
+	// record, including concurrent retirement, instead of the supplied snapshot.
+	cap, _, _, err = s.current(bounded, admitted)
+	if err != nil {
+		return empty, err
+	}
+	return cap, nil
+}
