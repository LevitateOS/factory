+    },
+    PullComments {
+        repository: String,
+        number: u32,
+        page: u32,
+        limit: u32,
+    },
+}
+pub struct Reply {
+    pub status: u16,
+    pub body: Value,
+}
+#[derive(Debug, PartialEq, Eq)]
+pub enum Error {
+    Credential(CredentialError),
+    Invalid,
+    Unavailable,
+    Protocol,
+    Provider(u16),
+}
+impl std::fmt::Display for Error {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::Credential(error) => write!(f, "{error}"),
+            Self::Invalid => f.write_str("invalid native GitHub read"),
+            Self::Unavailable => f.write_str("native GitHub transport is unavailable"),
+            Self::Protocol => f.write_str("invalid native GitHub response"),
+            Self::Provider(status) => write!(f, "GitHub verification refused (HTTP {status})"),
+        }
+    }
+}
+impl std::error::Error for Error {}
+
+fn commit_id(value: &str) -> bool {
+    matches!(value.len(), 40 | 64)
+        && value
+            .bytes()
+            .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+}
+
+fn file_page_matches(value: &Value, page: u64, limit: u64) -> bool {
+    let Some(total) = value["total"].as_u64().filter(|v| *v <= 3000) else {
+        return false;
+    };
+    let offset = (page - 1) * limit;
+    if offset >= total && !(page == 1 && total == 0) {
+        return false;
+    }
+    let count = limit.min(total - offset);
+    let next = if offset + count < total { page + 1 } else { 0 };
+    value["page"] == page
+        && value["limit"] == limit
+        && value["next_page"] == next
+        && value["items"]
+            .as_array()
+            .is_some_and(|items| items.len() as u64 == count)
+}
+
+impl NativeSupervisor {
+    /// Verify an unpersisted token before native login calls Credentials::store.
+    /// Account and Token have neither Serialize nor Debug; no browser receives
+    /// them. Refusal/cancellation drops the token without touching OS custody.
+    /// The future owns channel inputs so stopping the supervisor can proceed.
+    pub fn github_verify(
+        &self,
+        token: Token,
+    ) -> impl std::future::Future<Output = Result<(Account, Token), Error>> {
+        let channel = self.github_channel();
+        async move {
+            tokio::time::timeout(Duration::from_secs(8), async move {
+                let (receive, alive) = channel.map_err(|_| Error::Unavailable)?;
+                let channel = receive
+                    .await
+                    .map_err(|_| Error::Unavailable)?
+                    .map_err(|_| Error::Unavailable)?;
+                if !alive.load(Ordering::SeqCst) {
+                    return Err(Error::Unavailable);
+                }
+                let value = std::str::from_utf8(token.as_bytes()).map_err(|_| Error::Invalid)?;
+                let response = soda_unix_http::request_authenticated_async(
+                    &channel.socket,
+                    "POST",
+                    "/api/native/github/read",
+                    "soda-native",
+                    br#"{"kind":"verify"}"#,
+                    &channel.key,
+                    &[
+                        ("X-Soda-Native-Instance", &channel.instance),
+                        ("X-Soda-GitHub-Credential", value),
+                    ],
+                    Duration::from_secs(7),
+                    soda_unix_http::Limits {
+                        header_bytes: 16384,
+                        body_bytes: 4096,
+                    },
+                )
+                .await
+                .map_err(|_| Error::Unavailable)?;
+                if !alive.load(Ordering::SeqCst) {
+                    return Err(Error::Unavailable);
+                }
+                if response.status != 200 {
+                    return Err(if (400..=599).contains(&response.status) {
+                        Error::Provider(response.status)
+                    } else {
+                        Error::Protocol
+                    });
+                }
+                let body: Value =
+                    serde_json::from_slice(&response.body).map_err(|_| Error::Protocol)?;
+                let remote = body["account"]["external_id"]
+                    .as_str()
+                    .ok_or(Error::Protocol)?;
+                if body["kind"] != "verify"
+                    || body.get("connection").is_some()
+                    || remote
+                        .parse::<i64>()
+                        .ok()
+                        .is_none_or(|id| id < 1 || id.to_string() != remote)
+                    || body["account"]["login"]
+                        .as_str()
+                        .is_none_or(|login| login.is_empty())
+                {
+                    return Err(Error::Protocol);
+                }
+                let account = Account::new(Provider::Github, "https://github.com", remote)
+                    .map_err(|_| Error::Protocol)?;
+                Ok((account, token))
+            })
+            .await
+            .map_err(|_| Error::Unavailable)?
+        }
+    }
+
+    /// The future owns its channel inputs and does not borrow the supervisor.
+    /// Host retirement can proceed while it waits; alive/instance/key and the
+    /// native credential lease remain mandatory before returning a result.
+    pub fn github_read<'a>(
+        &self,
+        credentials: &'a Credentials,
+        capability: &'a TokenCapability,
+        query: Read,
+    ) -> impl std::future::Future<Output = Result<Reply, Error>> + 'a {
+        let channel = self.github_channel();
+        async move {
+            let account = capability.account();
+            if account.provider != Provider::Github || account.origin != "https://github.com" {
+                return Err(Error::Invalid);
+            }
+            match &query {
+                Read::Repositories { page, limit }
+                | Read::Issues { page, limit, .. }
+                | Read::Pulls { page, limit, .. }
+                | Read::PullReviews { page, limit, .. }
+                | Read::PullReviewComments { page, limit, .. }
+                | Read::PullCheckRuns { page, limit, .. }
+                | Read::PullCommitStatuses { page, limit, .. }
+                | Read::IssueComments { page, limit, .. }
+                | Read::PullComments { page, limit, .. }
+                    if *page == 0 || *page > 1_000_000 || *limit == 0 || *limit > 50 =>
+                {
+                    return Err(Error::Invalid)
+                }
+                _ => (),
+            }
+            if let Read::PullFiles {
+                page,
+                limit,
+                base,
+                head,
+                ..
+            } = &query
+            {
+                if *page == 0
+                    || *page > 3000
+                    || *limit == 0
+                    || *limit > 10
+                    || *page > 1 && base.is_empty()
+                    || !(base.is_empty() && head.is_empty() || commit_id(base) && commit_id(head))
+                {
+                    return Err(Error::Invalid);
+                }
+            }
+            if let Read::PullCheckRuns { page, head, .. }
+            | Read::PullCommitStatuses { page, head, .. } = &query
+            {
+                if head.is_empty() && *page != 1 || !head.is_empty() && !commit_id(head) {
+                    return Err(Error::Invalid);
+                }
+            }
+            match &query {
+                Read::Repository { repository }
+                | Read::Issues { repository, .. }
+                | Read::Issue { repository, .. }
+                | Read::Pulls { repository, .. }
+                | Read::Pull { repository, .. }
+                | Read::PullDiff { repository, .. }
+                | Read::PullFiles { repository, .. }
+                | Read::PullReviews { repository, .. }
+                | Read::PullReview { repository, .. }
+                | Read::PullReviewComments { repository, .. }
+                | Read::PullReviewComment { repository, .. }
+                | Read::PullCheckRuns { repository, .. }
+                | Read::PullCommitStatuses { repository, .. }
+                | Read::IssueComments { repository, .. }
+                | Read::PullComments { repository, .. }
+                    if repository.parse::<u64>().ok().is_none_or(|v| {
+                        v == 0 || v > i64::MAX as u64 || v.to_string() != *repository
+                    }) =>
+                {
+                    return Err(Error::Invalid)
+                }
+                _ => (),
+            }
+            match &query {
+                Read::Issue { number: 0, .. }
+                | Read::Pull { number: 0, .. }
+                | Read::PullDiff { number: 0, .. }
+                | Read::PullFiles { number: 0, .. }
+                | Read::PullReviews { number: 0, .. }
+                | Read::PullReview { number: 0, .. }
+                | Read::PullReviewComments { number: 0, .. }
+                | Read::PullReviewComment { number: 0, .. }
+                | Read::PullCheckRuns { number: 0, .. }
+                | Read::PullCommitStatuses { number: 0, .. }
+                | Read::IssueComments { number: 0, .. }
+                | Read::PullComments { number: 0, .. } => return Err(Error::Invalid),
+                Read::Issues { state, .. } | Read::Pulls { state, .. }
+                    if !matches!(state.as_str(), "" | "open" | "closed" | "all") =>
+                {
+                    return Err(Error::Invalid)
+                }
+                Read::PullDiff { base, head, .. }
+                    if !(base.is_empty() && head.is_empty()
+                        || commit_id(base) && commit_id(head)) =>
+                {
+                    return Err(Error::Invalid)
+                }
+                Read::PullReview { review_id, .. }
+                    if review_id.parse::<u64>().ok().is_none_or(|v| {
+                        v == 0 || v > i64::MAX as u64 || v.to_string() != *review_id
+                    }) =>
+                {
+                    return Err(Error::Invalid)
+                }
+                Read::PullReviewComment { comment_id, .. }
+                    if comment_id.parse::<u64>().ok().is_none_or(|v| {
+                        v == 0 || v > i64::MAX as u64 || v.to_string() != *comment_id
+                    }) =>
+                {
+                    return Err(Error::Invalid)
+                }
+                _ => (),
+            }
+            let mut body = serde_json::to_value(query).map_err(|_| Error::Invalid)?;
+            body["account"] = Value::String(account.account.clone());
+            body["connection"] = Value::String(account.connection.clone());
+            let kind = body["kind"].clone();
+            let resource_scope = match kind.as_str() {
+                Some("issues" | "issue") => Some(("issues", body["repository"].clone())),
+                Some("pulls" | "pull") => Some(("pulls", body["repository"].clone())),
+                Some("pull_reviews" | "pull_review") => {
+                    Some(("reviews", body["repository"].clone()))
+                }
+                Some("pull_review_comments" | "pull_review_comment") => {
+                    Some(("review_comments", body["repository"].clone()))
+                }
+                Some("pull_check_runs") => Some(("checks", body["repository"].clone())),
+                Some("pull_commit_statuses") => Some(("statuses", body["repository"].clone())),
+                Some("pull_diff") => Some(("diff", body["repository"].clone())),
+                Some("issue_comments" | "pull_comments") => {
+                    Some(("discussion", body["repository"].clone()))
+                }
+                _ => None,
+            };
+            let discussion_parent = match kind.as_str() {
+                Some("issue_comments") => Some(("issue", body["number"].clone())),
+                Some("pull_comments") => Some(("pull", body["number"].clone())),
+                _ => None,
+            };
+            let diff_pin = (kind == "pull_diff" || kind == "pull_files").then(|| {
+                (
+                    body["repository"].clone(),
+                    body["number"].clone(),
+                    body["base"].clone(),
+                    body["head"].clone(),
+                )
+            });
+            let file_page = (kind == "pull_files").then(|| {
+                (
+                    body["page"].as_u64().unwrap(),
+                    body["limit"].as_u64().unwrap(),
+                )
+            });
+            let review_parent = match kind.as_str() {
+                Some("pull_reviews") => Some((
+                    "reviews",
+                    body["number"].clone(),
+                    None,
+                    body["limit"].as_u64().unwrap(),
+                )),
+                Some("pull_review") => Some((
+                    "reviews",
+                    body["number"].clone(),
+                    Some(body["review_id"].clone()),
+                    1,
+                )),
+                Some("pull_review_comments") => Some((
+                    "review_comments",
+                    body["number"].clone(),
+                    None,
+                    body["limit"].as_u64().unwrap(),
+                )),
+                Some("pull_review_comment") => Some((
+                    "review_comments",
+                    body["number"].clone(),
+                    Some(body["comment_id"].clone()),
+                    1,
+                )),
+                _ => None,
+            };
+            let check_scope =
+                (kind == "pull_check_runs" || kind == "pull_commit_statuses").then(|| {
+                    (
+                        if kind == "pull_commit_statuses" {
+                            "statuses"
+                        } else {
+                            "checks"
+                        },
+                        body["number"].clone(),
+                        body["head"].clone(),
+                        body["limit"].as_u64().unwrap(),
+                    )
+                });
+            let body = serde_json::to_vec(&body).map_err(|_| Error::Invalid)?;
+            let (receive, alive) = channel.map_err(|_| Error::Unavailable)?;
+            let channel = tokio::time::timeout(Duration::from_secs(3), receive)
+                .await
+                .map_err(|_| Error::Unavailable)?
+                .map_err(|_| Error::Unavailable)?
+                .map_err(|_| Error::Unavailable)?;
+            if !alive.load(Ordering::SeqCst) {
+                return Err(Error::Unavailable);
+            }
+            let response = credentials
+                .with_token_operation(capability, async |token| {
+                    if !alive.load(Ordering::SeqCst) {
+                        return Err(Error::Unavailable);
+                    }
+                    let token = std::str::from_utf8(token).map_err(|_| Error::Invalid)?;
+                    let response = soda_unix_http::request_authenticated_async(
+                        &channel.socket,
+                        "POST",
+                        "/api/native/github/read",
+                        "soda-native",
+                        &body,
+                        &channel.key,
+                        &[
+                            ("X-Soda-Native-Instance", &channel.instance),
+                            ("X-Soda-GitHub-Credential", token),
+                        ],
+                        Duration::from_secs(7),
+                        soda_unix_http::Limits {
+                            header_bytes: 16384,
+                            body_bytes: 2 * 1024 * 1024,
+                        },
+                    )
+                    .await
+                    .map_err(|_| Error::Unavailable)?;
+                    if !alive.load(Ordering::SeqCst) {
+                        return Err(Error::Unavailable);
+                    }
+                    let body: Value =
+                        serde_json::from_slice(&response.body).map_err(|_| Error::Protocol)?;
+                    if !body.is_object() {
+                        return Err(Error::Protocol);
+                    }
+                    if response.status == 200
+                        && (body["connection"] != account.connection
+                            || body["account"]["external_id"] != account.account
+                            || body["kind"] != kind
+                            || resource_scope.as_ref().is_some_and(|(field, repository)| {
+                                body[*field]["repository"] != *repository
+                            })
+                            || discussion_parent.as_ref().is_some_and(|(kind, number)| {
+                                body["discussion"]["subject"]["kind"] != *kind
+                                    || body["discussion"]["subject"]["number"] != *number
+                            })
+                            || diff_pin
+                                .as_ref()
+                                .is_some_and(|(repository, number, base, head)| {
+                                    let diff = if kind == "pull_files" {
+                                        &body["files"]["diff"]
+                                    } else {
+                                        &body["diff"]
+                                    };
+                                    diff["repository"] != *repository
+                                        || diff["pull"]["kind"] != "pull"
+                                        || diff["pull"]["number"] != *number
+                                        || diff["base"].as_str().is_none_or(|v| !commit_id(v))
+                                        || diff["head"].as_str().is_none_or(|v| !commit_id(v))
+                                        || base != ""
+                                            && (diff["base"] != *base || diff["head"] != *head)
+                                })
+                            || file_page.is_some_and(|(page, limit)| {
+                                !file_page_matches(&body["files"], page, limit)
+                            })
+                            || review_parent
+                                .as_ref()
+                                .is_some_and(|(field, number, id, limit)| {
+                                    let reviews = &body[*field];
+                                    reviews["pull"]["kind"] != "pull"
+                                        || reviews["pull"]["number"] != *number
+                                        || reviews["items"].as_array().is_none_or(|items| {
+                                            items.len() as u64 > *limit
+                                                || id.as_ref().is_some_and(|id| {
+                                                    items.len() != 1
+                                                        || items[0]["external_id"] != *id
+                                                })
+                                        })
+                                        || id.is_some() && reviews["next_page"] != 0
+                                })
+                            || check_scope
+                                .as_ref()
+                                .is_some_and(|(field, number, head, limit)| {
+                                    let checks = &body[*field];
+                                    checks["pull"]["kind"] != "pull"
+                                        || checks["pull"]["number"] != *number
+                                        || checks["head"].as_str().is_none_or(|v| !commit_id(v))
+                                        || head != "" && checks["head"] != *head
+                                        || checks["items"].as_array().is_none_or(|items| {
+                                            items.len() as u64 > *limit
+                                                || items
+                                                    .iter()
+                                                    .any(|item| item["head"] != checks["head"])
+                                        })
+                                }))
+                    {
+                        return Err(Error::Protocol);
+                    }
+                    Ok(Reply {
+                        status: response.status,
+                        body,
+                    })
+                })
+                .await
+                .map_err(Error::Credential)??;
+            if !alive.load(Ordering::SeqCst) {
+                return Err(Error::Unavailable);
+            }
+            Ok(response)
+        }
+    }
+}
diff --git a/lib/desktop-runtime/src/supervisor.rs b/lib/desktop-runtime/src/supervisor.rs
new file mode 100644
index 0000000000000000000000000000000000000000..eefbc946ea02a4489bc964aaafbc71bc129e0ea5
--- /dev/null
+++ b/lib/desktop-runtime/src/supervisor.rs
@@ -0,0 +1,450 @@
+//! Native children stay on one owner thread. No browser command, connection,
+//! credential or executor authority is provided by process readiness.
+use crate::database::{parent_death, private_dir, private_file, NativePostgres};
+use soda_unix_http::{request_authenticated, Limits};
+use std::fs::{self, File};
+use std::io::Read;
+use std::os::unix::fs::PermissionsExt;
+use std::os::unix::process::CommandExt;
+use std::path::{Path, PathBuf};
+use std::process::{Child, Command, Stdio};
+use std::sync::mpsc::{self, Receiver, Sender};
+use std::sync::{
+    atomic::{AtomicBool, Ordering},
+    Arc,
+};
+use std::thread::{self, JoinHandle};
+use std::time::{Duration, Instant};
+
+type Result<T> = std::result::Result<T, String>;
+const START_TIMEOUT: Duration = Duration::from_secs(15);
+const STOP_TIMEOUT: Duration = Duration::from_secs(30);
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct NativeReady {
+    pub profile: String,
+    pub instance: String,
+    pub backend_process: u32,
+    pub database_process: u32,
+}
+enum Control {
+    Probe(Sender<Result<NativeReady>>),
+    Product {
+        method: String,
+        target: String,
+        body: Vec<u8>,
+        reply: Sender<Result<soda_unix_http::Response>>,
+    },
+    Stop,
+    GithubChannel(tokio::sync::oneshot::Sender<Result<NativeChannel>>),
+}
+pub(crate) struct NativeChannel {
+    pub socket: PathBuf,
+    pub key: zeroize::Zeroizing<String>,
+    pub instance: String,
+}
+struct Retire(Arc<AtomicBool>);
+impl Drop for Retire {
+    fn drop(&mut self) {
+        self.0.store(false, Ordering::SeqCst);
+    }
+}
+/// Owns only this profile's children. The private key/DSN never leave the owner.
+/// Window closure must retain this object; explicit Quit consumes it with stop.
+pub struct NativeSupervisor {
+    control: Sender<Control>,
+    owner: Option<JoinHandle<Result<()>>>,
+    alive: Arc<AtomicBool>,
+}
+impl NativeSupervisor {
+    pub fn start(payload: &Path, backend: &Path, profile: &Path) -> Result<Self> {
+        let (control, commands) = mpsc::channel();
+        let (started, ready) = mpsc::channel();
+        let payload = payload.to_path_buf();
+        let backend = backend.to_path_buf();
+        let profile = profile.to_path_buf();
+        let alive = Arc::new(AtomicBool::new(true));
+        let owner_alive = alive.clone();
+        let owner = thread::Builder::new()
+            .name("factory-native-owner".into())
+            .spawn(move || {
+                let _retire = Retire(owner_alive.clone());
+                let mut children = match Children::start(&payload, &backend, &profile) {
+                    Ok(children) => children,
+                    Err(error) => {
+                        let _ = started.send(Err(error.clone()));
+                        return Err(error);
+                    }
+                };
+                let initial = children.health();
+                if started.send(initial.clone()).is_err() || initial.is_err() {
+                    return children.stop();
+                }
+                let failure = run_owner(&mut children, commands);
+                owner_alive.store(false, Ordering::SeqCst);
+                let stopped = children.stop();
+                match (failure, stopped) {
+                    (Some(error), _) => Err(error),
+                    (None, stopped) => stopped,
+                }
+            })
+            .map_err(|_| "native supervisor owner could not start")?;
+        let mut supervisor = Self {
+            control,
+            owner: Some(owner),
+            alive,
+        };
+        match ready.recv() {
+            Ok(Ok(_)) => Ok(supervisor),
+            Ok(Err(error)) => {
+                let _ = supervisor.stop_inner();
+                Err(error)
+            }
+            Err(_) => {
+                let _ = supervisor.stop_inner();
+                Err("native supervisor startup stopped".into())
+            }
+        }
+    }
+    /// Fresh bounded store/process readiness, never execution or account admission.
+    pub fn health(&self) -> Result<NativeReady> {
+        let (reply, response) = mpsc::channel();
+        self.control
+            .send(Control::Probe(reply))
+            .map_err(|_| "native supervisor is unavailable")?;
+        response
+            .recv_timeout(Duration::from_secs(5))
+            .map_err(|_| "native readiness is unavailable")?
+    }
+    /// Native host boundary only. GUI callers must use the shell's typed route
+    /// descriptors; this method never accepts another socket or capability.
+    pub fn product(
+        &self,
+        method: &str,
+        target: &str,
+        body: &[u8],
+    ) -> Result<soda_unix_http::Response> {
+        if !matches!(method, "GET" | "POST")
+            || target.len() > 2048
+            || !target.starts_with("/api/factory/")
+            || target.bytes().any(|b| b.is_ascii_control())
+            || body.len() > 65536
+        {
+            return Err("unsupported native product request".into());
+        }
+        let (reply, response) = mpsc::channel();
+        self.control
+            .send(Control::Product {
+                method: method.into(),
+                target: target.into(),
+                body: body.into(),
+                reply,
+            })
+            .map_err(|_| "native runtime is unavailable")?;
+        response
+            .recv_timeout(Duration::from_secs(20))
+            .map_err(|_| "native product request timed out")?
+    }
+    pub fn stop(mut self) -> Result<()> {
+        self.stop_inner()
+    }
+    pub(crate) fn github_channel(
+        &self,
+    ) -> Result<(
+        tokio::sync::oneshot::Receiver<Result<NativeChannel>>,
+        Arc<AtomicBool>,
+    )> {
+        if !self.alive.load(Ordering::SeqCst) {
+            return Err("native runtime is retired".into());
+        }
+        let (send, receive) = tokio::sync::oneshot::channel();
+        self.control
+            .send(Control::GithubChannel(send))
+            .map_err(|_| "native runtime is unavailable")?;
+        Ok((receive, self.alive.clone()))
+    }
+    fn stop_inner(&mut self) -> Result<()> {
+        let Some(owner) = self.owner.take() else {
+            return Ok(());
+        };
+        let _ = self.control.send(Control::Stop);
+        owner.join().map_err(|_| "native supervisor owner failed")?
+    }
+}
+impl Drop for NativeSupervisor {
+    fn drop(&mut self) {
+        if let Err(error) = self.stop_inner() {
+            eprintln!("native supervisor retirement: {error}");
+        }
+    }
+}
+fn run_owner(children: &mut Children, commands: Receiver<Control>) -> Option<String> {
+    loop {
+        match commands.recv_timeout(Duration::from_millis(100)) {
+            Ok(Control::Stop) | Err(mpsc::RecvTimeoutError::Disconnected) => return None,
+            Ok(Control::Product {
+                method,
+                target,
+                body,
+                reply,
+            }) => {
+                let result = children.health().and_then(|_| {
+                    request_authenticated(
+                        &children.profile.join("backend.sock"),
+                        &method,
+                        &target,
+                        "soda-native",
+                        &body,
+                        &children.key,
+                        Duration::from_secs(15),
+                        Limits {
+                            header_bytes: 16384,
+                            body_bytes: 2 * 1024 * 1024,
+                        },
+                    )
+                    .map_err(|_| "native product response is unavailable".into())
+                });
+                let _ = reply.send(result);
+            }
+            Ok(Control::Probe(reply)) => {
+                let result = children.health();
+                let failed = result.as_ref().err().cloned();
+                let _ = reply.send(result);
+                if failed.is_some() {
+                    return failed;
+                }
+            }
+            Ok(Control::GithubChannel(reply)) => {
+                let result = children.health().map(|ready| NativeChannel {
+                    socket: children.profile.join("backend.sock"),
+                    key: zeroize::Zeroizing::new(children.key.clone()),
+                    instance: ready.instance,
+                });
+                let _ = reply.send(result);
+            }
+            Err(mpsc::RecvTimeoutError::Timeout) => (),
+        }
+        if let Err(error) = children.check_children() {
+            return Some(error);
+        }
+    }
+}
+struct Children {
+    database: Option<NativePostgres>,
+    backend: Option<Child>,
+    profile: PathBuf,
+    identity: String,
+    key: String,
+    instance: Option<String>,
+    _lock: File,
+}
+impl Children {
+    fn start(payload: &Path, backend: &Path, profile: &Path) -> Result<Self> {
+        let backend =
+            fs::canonicalize(backend).map_err(|_| "native backend executable is unavailable")?;
+        let metadata =
+            fs::metadata(&backend).map_err(|_| "native backend executable is unavailable")?;
+        if !metadata.is_file() || metadata.permissions().mode() & 0o111 == 0 {
+            return Err("native backend executable is unavailable".into());
+        }
+        private_dir(profile).map_err(|error| error.to_string())?;
+        let profile = fs::canonicalize(profile).map_err(|_| "native profile is unavailable")?;
+        let lock = private_file(&profile.join("supervisor.lock"), false)
+            .map_err(|_| "native supervisor lock is unavailable")?;
+        lock.try_lock()
+            .map_err(|_| "another native supervisor owns this profile")?;
+        let mut database =
+            NativePostgres::start(payload, &profile).map_err(|error| error.to_string())?;
+        let config = database
+            .backend_config()
+            .map_err(|error| error.to_string())?;
+        let identity = read_private(&profile.join("profile.id"), 32)?;
+        let key = read_private(&profile.join("backend.key"), 64)?;
+        let log = private_file(&profile.join("backend.log"), false)
+            .map_err(|_| "native backend log is unavailable")?;
+        let mut command = Command::new(backend);
+        command
+            .arg("--config")
+            .arg(config)
+            .env_clear()
+            .env("PATH", "/usr/bin:/bin")
+            .env("LANG", "C.UTF-8")
+            .env("TMPDIR", profile.join("tmp"))
+            .stdin(Stdio::null())
+            .stdout(
+                log.try_clone()
+                    .map_err(|_| "native backend log is unavailable")?,
+            )
+            .stderr(log)
+            .process_group(0);
+        parent_death(&mut command, libc::SIGTERM);
+        let child = command
+            .spawn()
+            .map_err(|_| "native backend could not start")?;
+        let mut children = Self {
+            database: Some(database),
+            backend: Some(child),
+            profile,
+            identity,
+            key,
+            instance: None,
+            _lock: lock,
+        };
+        let deadline = Instant::now() + START_TIMEOUT;
+        loop {
+            children.check_children()?;
+            if children.health().is_ok() {
+                return Ok(children);
+            }
+            if Instant::now() >= deadline {
+                return Err("native backend readiness timed out; inspect backend.log".into());
+            }
+            thread::sleep(Duration::from_millis(25));
+        }
+    }
+    fn check_children(&mut self) -> Result<()> {
+        self.database
+            .as_mut()
+            .ok_or("native database is stopped")?
+            .check_running()
+            .map_err(|_| "owned native database exited")?;
+        if self
+            .backend
+            .as_mut()
+            .ok_or("native backend is stopped")?
+            .try_wait()
+            .map_err(|_| "native backend observation failed")?
+            .is_some()
+        {
+            return Err("owned native backend exited; inspect backend.log".into());
+        }
+        Ok(())
+    }
+    fn health(&mut self) -> Result<NativeReady> {
+        self.check_children()?;
+        let response = request_authenticated(
+            &self.profile.join("backend.sock"),
+            "GET",
+            "/healthz",
+            "soda-native",
+            &[],
+            &self.key,
+            Duration::from_secs(3),
+            Limits {
+                header_bytes: 8192,
+                body_bytes: 4096,
+            },
+        )
+        .map_err(|_| "native readiness could not be read")?;
+        if response.status != 200 {
+            return Err("native readiness was refused".into());
+        }
+        let value: serde_json::Value =
+            serde_json::from_slice(&response.body).map_err(|_| "native readiness is invalid")?;
+        let row = value.as_object().ok_or("native readiness is invalid")?;
+        let instance = row
+            .get("instance")
+            .and_then(|value| value.as_str())
+            .ok_or("native readiness lacks instance")?;
+        if row.len() != 3
+            || row.get("status").and_then(|value| value.as_str()) != Some("ready")
+            || row.get("profile").and_then(|value| value.as_str()) != Some(&self.identity)
+            || !hex(instance, 32)
+            || self
+                .instance
+                .as_ref()
+                .is_some_and(|previous| previous != instance)
+        {
+            return Err("native readiness identity changed".into());
+        }
+        self.instance = Some(instance.into());
+        Ok(NativeReady {
+            profile: self.identity.clone(),
+            instance: instance.into(),
+            backend_process: self.backend.as_ref().unwrap().id(),
+            database_process: self.database.as_ref().unwrap().process_id(),
+        })
+    }
+    fn stop(&mut self) -> Result<()> {
+        // Stop Go admission/drain before stopping PostgreSQL. Failure still retires
+        // both owned children and is never reported as a clean shutdown.
+        let backend = match self.backend.take() {
+            Some(mut child) => stop_backend(&mut child),
+            None => Ok(()),
+        };
+        let database = match self.database.take() {
+            Some(database) => database.stop().map_err(|error| error.to_string()),
+            None => Ok(()),
+        };
+        backend.and(database)
+    }
+}
+impl Drop for Children {
+    fn drop(&mut self) {
+        let _ = self.stop();
+    }
+}
+fn read_private(path: &Path, length: usize) -> Result<String> {
+    let file = private_file(path, false).map_err(|_| "native private input is unavailable")?;
+    let mut value = String::new();
+    file.take(length as u64 + 1)
+        .read_to_string(&mut value)
+        .map_err(|_| "native private input is invalid")?;
+    if !hex(&value, length) {
+        return Err("native private input is invalid".into());
+    }
+    Ok(value)
+}
+fn hex(value: &str, length: usize) -> bool {
+    value.len() == length
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+}
+fn stop_backend(child: &mut Child) -> Result<()> {
+    if child
+        .try_wait()
+        .map_err(|_| "native backend observation failed")?
+        .is_some()
+    {
+        return Err("native backend exited before shutdown".into());
+    }
+    if unsafe { libc::kill(child.id() as i32, libc::SIGTERM) } != 0 {
+        let _ = child.kill();
+        let _ = child.wait();
+        return Err("native backend retirement signal failed".into());
+    }
+    let deadline = Instant::now() + STOP_TIMEOUT;
+    loop {
+        match child.try_wait() {
+            Ok(Some(status)) => {
+                return if status.success() {
+                    Ok(())
+                } else {
+                    Err("native backend shutdown failed".into())
+                }
+            }
+            Ok(None) => (),
+            Err(_) => return Err("native backend observation failed".into()),
+        }
+        if Instant::now() >= deadline {
+            unsafe {
+                libc::kill(-(child.id() as i32), libc::SIGKILL);
+            }
+            let _ = child.wait();
+            return Err("native backend shutdown timed out and was killed".into());
+        }
+        thread::sleep(Duration::from_millis(25));
+    }
+}
+
+/// Prepare the fixed native profile before a webview can use its own data dir.
+pub fn prepare_profile(profile: &Path) -> Result<()> {
+    use std::os::unix::fs::DirBuilderExt;
+    let mut dirs = std::fs::DirBuilder::new();
+    dirs.recursive(true)
+        .mode(0o700)
+        .create(profile)
+        .map_err(|_| "native profile directory is unavailable")?;
+    private_dir(profile).map_err(|error| error.to_string())
+}
