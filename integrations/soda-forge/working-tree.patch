+		id  collaboration.RepositoryID
+		err error
+	}
+	results := make(chan result, count)
+	var wg sync.WaitGroup
+	for range count {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			repo, err := s.ObserveCollaborationRepository(ctx, a.ID, "opaque-repo-node", "team/concurrent")
+			results <- result{repo.ID, err}
+		}()
+	}
