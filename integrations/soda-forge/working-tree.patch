@@ -0,0 +1,456 @@
+import {LitElement, html} from 'lit';
+import {check, id, object} from '../api/models.js';
+import type {FactoryTransport} from '../api/transport.js';
+import {SodaFactoryFeed} from '../feed/feed.js';
+import type {FactoryFeedContext} from '../feed/feed.js';
+import {SodaIntent} from '../request/request.js';
+import type {IntentAPI} from '../request/request.js';
+import {SodaFactoryWorkOverview, SodaFactoryWorkPlan} from '../work/progress.js';
+import type {WorkOverviewContext, WorkPlanContext} from '../work/progress.js';
+import {SodaFactoryWorkDetail} from '../work/detail.js';
+import type {WorkDetailContext} from '../work/detail.js';
+import {SodaFactoryIssues} from '../issues/issues.js';
+import type {IssueListContext} from '../issues/issues.js';
+import {mountIssueScreen} from '../issues/screen.js';
+import type {IssueDetailContext} from '../issues/detail.js';
+import type {IssueCommentPorts} from '../issues/comment.js';
+import {SodaFactoryIssueCreate} from '../issues/create.js';
+import type {IssueCreatePorts} from '../issues/create.js';
+import type {IssueEditorPorts} from '../issues/editor.js';
+import type {JourneyContext} from '../work/journey.js';
+import {SodaFactoryLibrary} from '../library/library.js';
+import type {LibraryContext, LibrarySource} from '../library/library.js';
+import {SodaFactoryWatch} from '../watch/watch.js';
+import type {FactoryWatchContext, FactoryWatchRenderer} from '../watch/ports.js';
+import {admitFactoryRoute, factoryRouteTitle} from './routes.js';
+import type {FactoryRoute} from './routes.js';
+
+/** Host-resolved ports, never host-created DOM or a second workflow model. */
+export type FactoryScreen =
+  | {readonly kind: 'feed'; readonly context: FactoryFeedContext}
+  | {readonly kind: 'request'; readonly api: IntentAPI; readonly blocked: boolean}
+  | {readonly kind: 'work'; readonly context: WorkOverviewContext}
+  | {readonly kind: 'issues'; readonly context: Omit<IssueListContext, 'openIssue'>}
+  | {readonly kind: 'issue-new'; readonly context: IssueCreatePorts}
+  | {
+      readonly kind: 'issue';
+      readonly context: IssueDetailContext;
+      readonly journey?: JourneyContext;
+      readonly comment?: IssueCommentPorts;
+      readonly editor?: IssueEditorPorts;
+    }
+  | {readonly kind: 'work-detail'; readonly context: WorkDetailContext}
+  | {readonly kind: 'plan'; readonly context: WorkPlanContext}
+  | {readonly kind: 'library'; readonly context: LibraryContext}
+  | {
+      readonly kind: 'watch';
+      readonly context: FactoryWatchContext;
+      readonly renderer: () => Promise<FactoryWatchRenderer>;
+    };
+
+export interface FactoryAppContext {
+  readonly transport: FactoryTransport;
+  /** Host-admitted stable profile/provider/account reference; never a credential. */
+  readonly scope: string;
+  readonly host: string;
+  readonly actor: string;
+  readonly accountLabel: string;
+  readonly route: FactoryRoute;
+  resolve(route: FactoryRoute, signal: AbortSignal): Promise<FactoryScreen>;
+  navigate(route: FactoryRoute): void;
+}
+
+/** Production application composition shared by desktop and host integrations.
+ * It creates no connection, backend, provider or executor. Hosts own admission. */
+export class SodaFactoryApp extends LitElement {
+  static properties = {message: {state: true}, busy: {state: true}, screen: {state: true}, scheme: {type: String}};
+  declare scheme: 'light' | 'dark' | undefined;
+  declare private message: string;
+  declare private busy: boolean;
+  declare private screen: HTMLElement | undefined;
+  private current: FactoryAppContext | undefined;
+  private generation = '';
+  private lifetime = new AbortController();
+  private disposeScreen: (() => void) | undefined;
+
+  constructor() {
+    super();
+    this.message = 'Choose an account to open Factory.';
+    this.busy = false;
+    this.screen = undefined;
+    this.scheme = undefined;
+    this.addEventListener('library-source-open', this.openLibrarySource);
+  }
+  protected createRenderRoot() {
+    return this;
+  }
+  set context(context: FactoryAppContext | undefined) {
+    if (context === this.current && context?.transport.generation === this.generation) return;
+    this.retire();
+    if (!context) return;
+    try {
+      check(
+        /^[a-f0-9]{32}$/.test(context.host) &&
+          id(context.actor) &&
+          typeof context.scope === 'string' &&
+          context.scope.trim().length > 0 &&
+          context.scope.length <= 1024 &&
+          !/[\u0000-\u001f\u007f]/.test(context.scope)
+      );
+      check(
+        typeof context.accountLabel === 'string' && !!context.accountLabel.trim() && context.accountLabel.length <= 256
+      );
+      check(
+        typeof context.transport.generation === 'string' &&
+          !!context.transport.generation &&
+          typeof context.resolve === 'function' &&
+          typeof context.navigate === 'function'
+      );
+      admitFactoryRoute(context.route);
+      this.current = context;
+      this.generation = context.transport.generation;
+      void this.load(context);
+    } catch {
+      this.message = 'The Factory account or destination is unavailable.';
+    }
+  }
+  disconnectedCallback() {
+    this.retire();
+    super.disconnectedCallback();
+  }
+  private retire() {
+    this.lifetime.abort();
+    this.lifetime = new AbortController();
+    this.current = undefined;
+    this.generation = '';
+    this.message = 'Choose an account to open Factory.';
+    this.busy = false;
+    this.clearScreen();
+  }
+  private clearScreen() {
+    const dispose = this.disposeScreen;
+    this.disposeScreen = undefined;
+    this.screen = undefined;
+    dispose?.();
+  }
+  private own<T extends HTMLElement>(view: T, retire: () => void): T {
+    // A resolved view can be retired before Lit has connected it. Explicitly
+    // clear its binding rather than depending solely on disconnectedCallback.
+    this.disposeScreen = () => {
+      retire();
+      view.remove();
+    };
+    return view;
+  }
+  private live(context: FactoryAppContext, signal: AbortSignal): boolean {
+    if (this.current !== context || signal !== this.lifetime.signal || signal.aborted) return false;
+    if (context.transport.generation !== this.generation) {
+      this.retire();
+      return false;
+    }
+    return true;
+  }
+  private async load(context: FactoryAppContext) {
+    const signal = this.lifetime.signal;
+    if (!this.live(context, signal) || this.busy) return;
+    this.busy = true;
+    this.message = 'Opening ' + factoryRouteTitle(context.route) + '…';
+    try {
+      const ports = await context.resolve(context.route, signal);
+      if (!this.live(context, signal)) return;
+      check(ports.kind === context.route.kind);
+      this.screen = this.mount(context, ports, signal);
+      this.message = '';
+    } catch {
+      if (this.live(context, signal)) {
+        this.clearScreen();
+        if (this.live(context, signal)) this.message = 'Could not open this view. Refresh to try again.';
+      }
+    } finally {
+      if (this.live(context, signal)) this.busy = false;
+    }
+  }
+  private mount(context: FactoryAppContext, ports: FactoryScreen, signal: AbortSignal): HTMLElement {
+    const route = context.route;
+    if (ports.kind !== 'request') check(ports.context.transport === context.transport);
+    switch (ports.kind) {
+      case 'issue-new': {
+        check(route.kind === 'issue-new' && ports.context.repository === route.repository);
+        check(
+          ports.context.host === context.host &&
+            ports.context.actor === context.actor &&
+            ports.context.scope === context.scope
+        );
+        const view = new SodaFactoryIssueCreate();
+        this.own(view, () => {
+          view.context = undefined;
+        });
+        view.context = {
+          ...ports.context,
+          openIssue: (issue, childSignal) => {
+            check(
+              this.live(context, signal) &&
+                !childSignal.aborted &&
+                issue.kind === 'issue' &&
+                issue.repository === route.repository &&
+                id(issue.number)
+            );
+            this.navigate({kind: 'issue', repository: route.repository, issue: issue.number});
+          },
+        };
+        return view;
+      }
+      case 'issues': {
+        check(route.kind === 'issues' && ports.context.repository === route.repository);
+        check(
+          ports.context.host === context.host &&
+            ports.context.actor === context.actor &&
+            ports.context.scope === context.scope
+        );
+        const view = new SodaFactoryIssues();
+        this.own(view, () => {
+          view.context = undefined;
+        });
+        view.context = {
+          ...ports.context,
+          openIssue: (issue, childSignal) => {
+            check(
+              this.live(context, signal) &&
+                !childSignal.aborted &&
+                issue.kind === 'issue' &&
+                issue.repository === route.repository &&
+                id(issue.number)
+            );
+            this.navigate({kind: 'issue', repository: route.repository, issue: issue.number});
+          },
+        };
+        return view;
+      }
+      case 'issue': {
+        check(
+          route.kind === 'issue' && ports.context.repository === route.repository && ports.context.issue === route.issue
+        );
+        check(
+          ports.context.host === context.host &&
+            ports.context.actor === context.actor &&
+            ports.context.scope === context.scope
+        );
+        const screen = mountIssueScreen(
+          ports.context,
+          ports.journey,
+          signal,
+          () => this.live(context, signal),
+          undefined,
+          ports.comment,
+          ports.editor
+        );
+        return this.own(screen.element, screen.dispose);
+      }
+      case 'feed': {
+        check(
+          route.kind === 'feed' &&
+            ports.context.host.draftScope === context.scope &&
+            ports.context.account === context.actor
+        );
+        check(
+          route.repository === undefined
+            ? ports.context.global === true
+            : ports.context.repository === route.repository && !ports.context.global
+        );
+        const view = new SodaFactoryFeed();
+        this.own(view, () => {
+          view.context = undefined;
+        });
+        view.context = ports.context;
+        if (route.post) view.post = route.post;
+        return view;
+      }
+      case 'request': {
+        check(route.kind === 'request' && typeof ports.api === 'function' && typeof ports.blocked === 'boolean');
+        const view = new SodaIntent();
+        this.own(view, () => {
+          view.active = false;
+          view.api = undefined;
+        });
+        view.actor = context.actor;
+        view.draftScope = context.scope;
+        view.request = route.intent ?? '';
+        view.blocked = ports.blocked;
+        view.api = async (path, body, childSignal) => {
+          check(this.live(context, signal));
+          const joined = childSignal ? AbortSignal.any([signal, childSignal]) : signal;
+          joined.throwIfAborted();
+          const value = await ports.api(path, body, joined);
+          check(this.live(context, signal));
+          joined.throwIfAborted();
+          return value;
+        };
+        view.active = true;
+        return view;
+      }
+      case 'work': {
+        check(
+          route.kind === 'work' &&
+            ports.context.repository === route.repository &&
+            ports.context.intentID === route.intent
+        );
+        const view = new SodaFactoryWorkOverview();
+        this.own(view, () => {
+          view.context = undefined;
+        });
+        view.context = ports.context;
+        return view;
+      }
+      case 'work-detail': {
+        check(
+          route.kind === 'work-detail' &&
+            ports.context.repository === route.repository &&
+            ports.context.issue === route.issue
+        );
+        const view = new SodaFactoryWorkDetail();
+        this.own(view, () => {
+          view.context = undefined;
+        });
+        const scope = ports.context.commandScope;
+        view.context = {
+          ...ports.context,
+          ...(scope
+            ? {
+                commandScope: async (childSignal: AbortSignal) => {
+                  check(this.live(context, signal));
+                  const value = await scope(AbortSignal.any([signal, childSignal]));
+                  check(this.live(context, signal) && value === context.scope);
+                  return value;
+                },
+              }
+            : {}),
+        };
+        return view;
+      }
+      case 'plan': {
+        check(
+          route.kind === 'plan' &&
+            ports.context.repository === route.repository &&
+            ports.context.issues.join(',') === route.issues.join(',')
+        );
+        const view = new SodaFactoryWorkPlan();
+        this.own(view, () => {
+          view.context = undefined;
+        });
+        view.context = ports.context;
+        return view;
+      }
+      case 'library': {
+        check(route.kind === 'library' && ports.context.repository === route.repository);
+        const view = new SodaFactoryLibrary();
+        this.own(view, () => {
+          view.context = undefined;
+        });
+        view.itemID = route.item;
+        view.context = ports.context;
+        return view;
+      }
+      case 'watch': {
+        check(
+          route.kind === 'watch' &&
+            ports.context.runId === route.run &&
+            ports.context.role === route.role &&
+            ports.context.issue === route.issue &&
+            ports.context.attempt === route.attempt
+        );
+        const source = ports.context.source;
+        const view = new SodaFactoryWatch();
+        this.own(view, () => view.dispose());
+        view.configure(
+          {
+            ...ports.context,
+            source: {
+              repository: async (childSignal) => {
+                check(this.live(context, signal));
+                const repository = await source.repository(AbortSignal.any([signal, childSignal]));
+                check(this.live(context, signal) && repository === route.repository);
+                return repository;
+              },
+              connect: () => {
+                check(this.live(context, signal));
+                return source.connect();
+              },
+              attachment: (cursor, generation) => {
+                check(this.live(context, signal));
+                return source.attachment(cursor, generation);
+              },
+            },
+          },
+          ports.renderer
+        );
+        return view;
+      }
+    }
+  }
+  private navigate(route: FactoryRoute) {
+    const context = this.current,
+      signal = this.lifetime.signal;
+    if (!context || !this.live(context, signal)) return;
+    try {
+      admitFactoryRoute(route);
+      context.navigate(route);
+    } catch {
+      if (this.live(context, signal)) this.message = 'This destination is unavailable.';
+    }
+  }
+  private openLibrarySource = (event: Event) => {
+    const context = this.current;
+    if (!context || context.route.kind !== 'library' || event.target !== this.screen || !(event instanceof CustomEvent))
+      return;
+    try {
+      const source = object(event.detail) as unknown as LibrarySource;
+      check(source.repository === context.route.repository);
+      this.navigate({kind: 'feed', repository: source.repository, post: source.id});
+    } catch {
+      this.message = 'The source post is unavailable.';
+    }
+  };
+  protected render() {
+    const context = this.current;
+    const repository = context && 'repository' in context.route ? context.route.repository : undefined;
+    const links: {label: string; route: FactoryRoute}[] = [
+      {label: 'Feed', route: {kind: 'feed'}},
+      {label: 'New request', route: {kind: 'request'}},
+      ...(repository
+        ? [
+            {label: 'Work', route: {kind: 'work' as const, repository}},
+            {label: 'Issues', route: {kind: 'issues' as const, repository}},
+            {label: 'New issue', route: {kind: 'issue-new' as const, repository}},
+            {label: 'Knowledge', route: {kind: 'library' as const, repository}},
+          ]
+        : []),
+    ];
+    return html`<div class="soda-factory-root soda-factory-app" data-factory-scheme=${this.scheme ?? ''}>
+      <header>
+        <h1>Factory</h1>
+        ${context ? html`<p>Acting as ${context.accountLabel}</p>` : ''}
+      </header>
+      <nav aria-label="Factory">
+        ${links.map(
+          (link) => html`<button
+            type="button"
+            aria-current=${context?.route.kind === link.route.kind || (link.route.kind === 'issues' && context?.route.kind === 'issue') || (link.route.kind === 'work' && (context?.route.kind === 'work-detail' || context?.route.kind === 'plan')) ? 'page' : 'false'}
+            ?disabled=${!context}
+            @click=${() => this.navigate(link.route)}
+          >
+            ${link.label}
+          </button>`
+        )}
+      </nav>
+      <main
+        aria-label=${context ? factoryRouteTitle(context.route) : 'Factory'}
+        aria-busy=${this.busy ? 'true' : 'false'}
+      >
+        <p role="status">${this.message}</p>
+        ${this.screen ?? ''}
+        ${context && !this.screen && !this.busy ? html`<button type="button" @click=${() => void this.load(context)}>Refresh view</button>` : ''}
+      </main>
+    </div>`;
+  }
+}
+customElements.define('soda-factory-app', SodaFactoryApp);
diff --git a/frontend/factory/app/routes.ts b/frontend/factory/app/routes.ts
new file mode 100644
index 0000000000000000000000000000000000000000..484627ae0bf8863ee6f25188cd75dea46ca56c9b
--- /dev/null
+++ b/frontend/factory/app/routes.ts
@@ -0,0 +1,78 @@
+import {check, id} from '../api/models.js';
+import {decisionID} from '../api/request-response.js';
+import {factoryRunID} from '../api/run-response.js';
+import {libraryID} from '../api/library-response.js';
+
+/** Canonical product destinations. Hosts own URLs, history and account selection. */
+export type FactoryRoute =
+  | {readonly kind: 'feed'; readonly repository?: string; readonly post?: string}
+  | {readonly kind: 'request'; readonly intent?: string}
+  | {readonly kind: 'work'; readonly repository: string; readonly intent?: string}
+  | {readonly kind: 'issues'; readonly repository: string}
+  | {readonly kind: 'issue-new'; readonly repository: string}
+  | {readonly kind: 'issue'; readonly repository: string; readonly issue: string}
+  | {readonly kind: 'work-detail'; readonly repository: string; readonly issue: string}
+  | {readonly kind: 'plan'; readonly repository: string; readonly issues: readonly string[]}
+  | {readonly kind: 'library'; readonly repository: string; readonly item?: string}
+  | {
+      readonly kind: 'watch';
+      readonly repository: string;
+      readonly run: string;
+      readonly role: string;
+      readonly issue?: string;
+      readonly attempt?: string;
+    };
+
+export function admitFactoryRoute(route: FactoryRoute): void {
+  check(route && typeof route === 'object');
+  switch (route.kind) {
+    case 'feed':
+      check(
+        (route.repository === undefined || id(route.repository)) && (route.post === undefined || libraryID(route.post))
+      );
+      check(route.post === undefined || route.repository !== undefined);
+      return;
+    case 'request':
+      check(route.intent === undefined || decisionID(route.intent));
+      return;
+    case 'work':
+      check(id(route.repository) && (route.intent === undefined || decisionID(route.intent)));
+      return;
+    case 'issues':
+    case 'issue-new':
+      check(id(route.repository));
+      return;
+    case 'issue':
+    case 'work-detail':
+      check(id(route.repository) && id(route.issue));
+      return;
+    case 'plan':
+      check(id(route.repository) && Array.isArray(route.issues) && route.issues.length <= 64 && route.issues.every(id));
+      return;
+    case 'library':
+      check(id(route.repository) && (route.item === undefined || libraryID(route.item)));
+      return;
+    case 'watch':
+      check(id(route.repository) && factoryRunID(route.run) && /^[a-z][a-z0-9-]{0,63}$/.test(route.role));
+      check(route.issue === undefined || id(route.issue));
+      check(route.attempt === undefined || /^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$/.test(route.attempt));
+      return;
+    default:
+      throw Error('Unknown Factory destination');
+  }
+}
+
+export function factoryRouteTitle(route: FactoryRoute): string {
+  return {
+    feed: 'Feed',
+    request: 'Request',
+    work: 'Work',
+    issues: 'Issues',
+    'issue-new': 'New issue',
+    issue: 'Issue',
+    'work-detail': 'Work detail',
+    plan: 'Work plan',
+    library: 'Knowledge',
+    watch: 'Watch',
+  }[route.kind];
+}
diff --git a/frontend/factory/feed/review-record.ts b/frontend/factory/feed/review-record.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f449d716628382359f53272d0612d0b5a781d18a
--- /dev/null
+++ b/frontend/factory/feed/review-record.ts
@@ -0,0 +1,79 @@
+import {check, id, object} from '../api/models.js';
+import {decisionID} from '../api/request-response.js';
+import {inspectStored, writeStored} from '../shared/drafts.js';
+
+export interface ReviewAddress {
+  readonly scope: string;
+  readonly repository: string;
+  readonly post: string;
+  readonly actor: string;
+}
+/** The backend's existing idempotency identity is the source post/revision,
+ * product intent and accepted predecessor, rather than a new client nonce. */
+export interface PendingReview {
+  readonly revision: number;
+  readonly intent: string;
+  readonly acceptedRevision: string;
+}
+function key(address: ReviewAddress): string {
+  check(
+    typeof address.scope === 'string' &&
+      address.scope.trim().length > 0 &&
+      address.scope.length <= 1024 &&
+      !/[\u0000-\u001f\u007f]/.test(address.scope)
+  );
+  check(id(address.repository) && id(address.actor) && /^[a-f0-9]{32}$/.test(address.post));
+  return `soda-feed-review:v1:${encodeURIComponent(address.scope)}:${address.repository}:${address.post}:${address.actor}`;
+}
+function parse(value: unknown): PendingReview {
+  const row = object(value);
+  check(
+    Object.keys(row).length === 3 &&
+      typeof row.revision === 'number' &&
+      Number.isSafeInteger(row.revision) &&
+      row.revision >= 0 &&
+      row.revision < Number.MAX_SAFE_INTEGER
+  );
+  check(decisionID(row.intent) && decisionID(row.acceptedRevision));
+  return {revision: row.revision, intent: row.intent, acceptedRevision: row.acceptedRevision};
+}
+export function sameReview(a: PendingReview, b: PendingReview): boolean {
+  return a.revision === b.revision && a.intent === b.intent && a.acceptedRevision === b.acceptedRevision;
+}
+export function readReview(address: ReviewAddress): {
+  pending: PendingReview | undefined;
+  blocked: boolean;
+  durable: boolean;
+} {
+  const stored = inspectStored(key(address));
+  if (stored.value === '') return {pending: undefined, blocked: false, durable: stored.durable};
+  if (stored.value !== undefined && stored.value.length <= 8192) {
+    try {
+      const row = object(JSON.parse(stored.value));
+      check(
+        Object.keys(row).length === 5 &&
+          row.scope === address.scope &&
+          row.repository === address.repository &&
+          row.post === address.post &&
+          row.actor === address.actor
+      );
+      return {pending: parse(row.pending), blocked: false, durable: stored.durable};
+    } catch {
+      /* Preserve unknown and foreign bytes. */
+    }
+  }
+  return {pending: undefined, blocked: true, durable: stored.durable};
+}
+export function retainReview(address: ReviewAddress, pending: PendingReview): 'saved' | 'unavailable' | 'conflict' {
+  parse(pending);
+  const current = readReview(address);
+  if (current.blocked || (current.pending && !sameReview(current.pending, pending))) return 'conflict';
+  if (current.pending && current.durable) return 'saved';
+  return writeStored(key(address), JSON.stringify({...address, pending})) ? 'saved' : 'unavailable';
+}
+export function settleReview(address: ReviewAddress, pending: PendingReview): boolean {
+  const current = readReview(address);
+  if (current.blocked || !current.pending || !sameReview(current.pending, pending)) return false;
+  writeStored(key(address), '');
+  return true;
+}
diff --git a/frontend/factory/feed/revision-record.ts b/frontend/factory/feed/revision-record.ts
new file mode 100644
index 0000000000000000000000000000000000000000..cc2286e56edd998e5ac79ce1512518a86df4b7a4
--- /dev/null
+++ b/frontend/factory/feed/revision-record.ts
@@ -0,0 +1,115 @@
+import {check, id, object} from '../api/models.js';
+import {inspectStored, writeStored} from '../shared/drafts.js';
+
+export interface RevisionAddress {
+  readonly scope: string;
+  readonly repository: string;
+  readonly post: string;
+  readonly author: string;
+}
+export interface RevisionWriting {
+  readonly body: string;
+  readonly original?: string;
+}
+export interface PendingRevision {
+  readonly command: string;
+  readonly revision: number;
+  readonly body: string;
+  readonly baseBody: string;
+  readonly writing: RevisionWriting;
+}
+const postID = /^[a-f0-9]{32}$/;
+function key(address: RevisionAddress): string {
+  check(
+    typeof address.scope === 'string' &&
+      address.scope.trim().length > 0 &&
+      address.scope.length <= 1024 &&
+      !/[\u0000-\u001f\u007f]/.test(address.scope) &&
+      id(address.repository) &&
+      id(address.author) &&
+      postID.test(address.post)
+  );
+  return `soda-feed-retry:v1:${encodeURIComponent(address.scope)}:${address.repository}:${address.post}:${address.author}`;
+}
+export function revisionBody(writing: RevisionWriting): string {
+  return writing.original === undefined ? writing.body : writing.original + '\n\nClarification: ' + writing.body;
+}
+export function sameRevisionWriting(a: RevisionWriting, b: RevisionWriting): boolean {
+  return a.body === b.body && a.original === b.original;
+}
+export function samePendingRevision(a: PendingRevision, b: PendingRevision): boolean {
+  return (
+    a.command === b.command &&
+    a.revision === b.revision &&
+    a.body === b.body &&
+    a.baseBody === b.baseBody &&
+    sameRevisionWriting(a.writing, b.writing)
+  );
+}
+function parse(value: unknown): PendingRevision {
+  const row = object(value),
+    writing = object(row.writing);
+  check(Object.keys(row).length === 5 && typeof row.command === 'string' && postID.test(row.command));
+  check(
+    typeof row.revision === 'number' &&
+      Number.isSafeInteger(row.revision) &&
+      row.revision >= 0 &&
+      row.revision < Number.MAX_SAFE_INTEGER
+  );
+  check(typeof row.body === 'string' && row.body.trim() && [...row.body].length <= 4000);
+  check(typeof row.baseBody === 'string' && [...row.baseBody].length <= 4000);
+  check(typeof writing.body === 'string' && (writing.original === undefined || typeof writing.original === 'string'));
+  check(Object.keys(writing).every((key) => key === 'body' || key === 'original'));
+  const result = {
+    command: row.command,
+    revision: row.revision,
+    body: row.body,
+    baseBody: row.baseBody,
+    writing: {body: writing.body, ...(writing.original === undefined ? {} : {original: writing.original})},
+  };
+  check(revisionBody(result.writing) === result.body);
+  return result;
+}
+/** Unknown, foreign or unreadable bytes are never treated as an empty slot. */
+export function readRevision(address: RevisionAddress): {
+  pending: PendingRevision | undefined;
+  blocked: boolean;
+  durable: boolean;
+} {
+  const stored = inspectStored(key(address));
+  if (stored.value === '') return {pending: undefined, blocked: false, durable: stored.durable};
+  if (stored.value !== undefined && stored.value.length <= 128 * 1024) {
+    try {
+      const row = object(JSON.parse(stored.value));
+      check(
+        Object.keys(row).length === 5 &&
+          row.scope === address.scope &&
+          row.repository === address.repository &&
+          row.post === address.post &&
+          row.author === address.author
+      );
+      return {pending: parse(row.pending), blocked: false, durable: stored.durable};
+    } catch {
+      /* Preserve the exact record. */
+    }
+  }
+  return {pending: undefined, blocked: true, durable: stored.durable};
+}
+/** No new effect is dispatched before its exact intent is durably retained. */
+export function retainRevision(
+  address: RevisionAddress,
+  pending: PendingRevision
+): 'saved' | 'unavailable' | 'conflict' {
+  parse(pending);
+  const current = readRevision(address);
+  if (current.blocked || (current.pending && !samePendingRevision(current.pending, pending))) return 'conflict';
+  if (current.pending && current.durable) return 'saved';
+  return writeStored(key(address), JSON.stringify({...address, pending})) ? 'saved' : 'unavailable';
+}
+/** A late receipt cannot remove a replacement or an unknown record. */
+export function settleRevision(address: RevisionAddress, pending: PendingRevision): boolean {
+  const current = readRevision(address);
+  if (current.blocked || !current.pending || !samePendingRevision(current.pending, pending)) return false;
+  writeStored(key(address), '');
+  return true;
+}
diff --git a/frontend/factory/issues/comment-record.ts b/frontend/factory/issues/comment-record.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e855cbd3c7a384ab819712cfae62620a99a202fd
--- /dev/null
+++ b/frontend/factory/issues/comment-record.ts
@@ -0,0 +1,149 @@
+import {check, id, object} from '../api/models.js';
+import {inspectPersisted, writeStored} from '../shared/drafts.js';
+import {factoryCommandId} from '../api/run-response.js';
+
+export interface CommentAddress {
+  scope: string;
+  host: string;
+  actor: string;
+  repository: string;
+  issue: string;
+}
+export interface PendingComment {
+  command: string;
+  body: string;
+  external: string;
+  draft: string;
+  cancel: boolean;
+}
+export interface CommentWriting {
+  draft: {revision: string; body: string};
+  pending?: PendingComment;
+}
+export interface CommentSaved {
+  raw: string | undefined;
+  writing: CommentWriting | undefined;
+  blocked: boolean;
+  durable: boolean;
+}
+const issued = (value: unknown): value is string => typeof value === 'string' && /^[a-f0-9]{32}$/.test(value);
+const unsaved = new Map<string, {raw: string; baseline: string | undefined}>();
+const fields = ({scope, host, actor, repository, issue}: CommentAddress): CommentAddress => ({
+  scope,
+  host,
+  actor,
+  repository,
+  issue,
+});
+export function commentRecordKey(address: CommentAddress): string {
+  check(issued(address.host) && id(address.actor) && id(address.repository) && id(address.issue));
+  check(!!address.scope.trim() && address.scope.length <= 1024 && !/[\u0000-\u001f\u007f]/.test(address.scope));
+  return `soda-issue-comment:v1:${encodeURIComponent(address.scope)}:${address.host}:${address.actor}:${address.repository}:${address.issue}`;
+}
+export function validCommentBody(body: string): boolean {
+  return (
+    /[^\p{White_Space}]/u.test(body) &&
+    !body.includes('\0') &&
+    new TextEncoder().encode(body).length <= 65536 &&
+    [...body].every((char) => {
+      const code = char.codePointAt(0)!;
+      return code < 0xd800 || code > 0xdfff;
+    })
+  );
+}
+export function samePendingComment(a: PendingComment, b: PendingComment): boolean {
+  return a.command === b.command && a.body === b.body && a.external === b.external && a.draft === b.draft;
+}
+function decode(raw: string | undefined, address: CommentAddress): CommentWriting | undefined {
+  if (!raw) return;
+  try {
+    const row = object(JSON.parse(raw)),
+      writing = object(row.writing),
+      draft = object(writing.draft);
+    check(Object.keys(row).length === 6 && Object.entries(fields(address)).every(([key, value]) => row[key] === value));
+    check(Object.keys(writing).length === (writing.pending === undefined ? 1 : 2));
+    check(Object.keys(draft).length === 2 && issued(draft.revision) && typeof draft.body === 'string');
+    const result: CommentWriting = {draft: {revision: draft.revision, body: draft.body}};
+    if (writing.pending !== undefined) {
+      const pending = object(writing.pending);
+      check(Object.keys(pending).length === 5 && issued(pending.command) && issued(pending.draft));
+      check(typeof pending.body === 'string' && validCommentBody(pending.body));
+      check(
+        typeof pending.external === 'string' &&
+          !!pending.external.trim() &&
+          pending.external.length <= 512 &&
+          !pending.external.includes('\0')
+      );
+      check(typeof pending.cancel === 'boolean');
+      result.pending = {
+        command: pending.command,
+        body: pending.body,
+        external: pending.external,
+        draft: pending.draft,
+        cancel: pending.cancel,
+      };
+    }
+    return result;
+  } catch {
+    return;
+  }
+}
+export function readCommentWriting(address: CommentAddress): CommentSaved {
+  const key = commentRecordKey(address),
+    persisted = inspectPersisted(key),
+    local = unsaved.get(key);
+  const raw = local?.raw ?? persisted.value,
+    writing = decode(raw, address);
+  return {
+    raw,
+    writing,
+    durable: !local && persisted.durable,
+    blocked: (raw !== '' && !writing) || (!!local && persisted.value !== local.baseline),
+  };
+}
+/** Compare the exact observed bytes, retaining a failed write's persisted
+ * baseline across remounts, as the request draft owner does. Never overwrite a
+ * newer document's writing, unknown bytes or a submission with another intent. */
+export function saveCommentWriting(
+  address: CommentAddress,
+  expected: string | undefined,
+  writing: CommentWriting
+): 'saved' | 'unavailable' | 'conflict' {
+  const key = commentRecordKey(address),
+    current = readCommentWriting(address);
+  if (current.blocked || current.raw !== expected) return 'conflict';
+  const raw = JSON.stringify({...fields(address), writing});
+  check(decode(raw, address) !== undefined);
+  const persisted = inspectPersisted(key),
+    baseline = unsaved.get(key)?.baseline ?? expected;
+  if (persisted.value !== baseline) return 'conflict';
+  unsaved.set(key, {raw, baseline});
+  // An unreadable persisted baseline cannot authorize overwriting unknown data.
+  if (persisted.value === undefined || !writeStored(key, raw)) return 'unavailable';
+  unsaved.delete(key);
+  return 'saved';
+}
+export function emptyCommentWriting(): CommentWriting {
+  return {draft: {revision: factoryCommandId(), body: ''}};
+}
+
+/** Explicitly recover the persisted draft while retaining this document's
+ * unresolved submission. Two different submissions must never replace each other. */
+export function reloadCommentWriting(address: CommentAddress): CommentSaved {
+  const key = commentRecordKey(address),
+    persisted = inspectPersisted(key),
+    local = unsaved.get(key);
+  if (!local || persisted.value === undefined) return readCommentWriting(address);
+  const saved = decode(persisted.value, address),
+    pending = decode(local.raw, address)?.pending;
+  if (persisted.value !== '' && !saved) return readCommentWriting(address);
+  if (pending) {
+    if (saved?.pending && !samePendingComment(pending, saved.pending)) return readCommentWriting(address);
+    const writing: CommentWriting = {
+      draft: saved?.draft ?? emptyCommentWriting().draft,
+      pending: {...pending, cancel: pending.cancel || !!saved?.pending?.cancel},
+    };
+    unsaved.set(key, {raw: JSON.stringify({...fields(address), writing}), baseline: persisted.value});
+  } else unsaved.delete(key);
+  return readCommentWriting(address);
+}
