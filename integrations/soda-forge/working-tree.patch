+		t.Fatal(err)
+	}
+	reopened, err := store.Open(dsn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = reopened.Close() })
+	observer.Identities, err = NewFountainIdentities(ctx, reopened, host.ID)
