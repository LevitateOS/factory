diff --git a/internal/factory/runtime/native_server.go b/internal/factory/runtime/native_server.go
new file mode 100644
index 0000000000000000000000000000000000000000..8d4ddde4a0c3f6f0c113b3201bcea04b8682218a
--- /dev/null
+++ b/internal/factory/runtime/native_server.go
@@ -0,0 +1,166 @@
+package runtime
+
+import (
+	"context"
+	"crypto/subtle"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"net"
+	"net/http"
+	"strings"
+	"sync/atomic"
+	"time"
+
+	"github.com/levitateos/sodaos/internal/collaboration"
+	factoryservice "github.com/levitateos/sodaos/internal/factory/service"
+	"github.com/levitateos/sodaos/internal/store"
+)
+
+type nativePeerKey struct{}
+
+// RunNative owns the Go network/store lifetime inside an existing Rust-owned
+// native database profile. Rust owns provisioning and child supervision. This
+// process recovers proved interrupted assessments before readiness, without
+// adopting a ledger, reconciling unobserved runs or starting background work.
+func RunNative(ctx context.Context, path string, connector http.Handler) (runErr error) {
+	config, err := LoadNative(path)
+	if err != nil {
+		return err
+	}
+	if ctx.Err() != nil {
+		return nil
+	}
+	listener, release, err := nativeListener(config)
+	if err != nil {
+		return err
+	}
+	defer func() { runErr = errors.Join(runErr, release()) }()
+	startup, cancelStartup := context.WithTimeout(ctx, 10*time.Second)
+	defer cancelStartup()
+	db, err := store.OpenContext(startup, config.DatabaseDSN())
+	if err != nil {
+		if ctx.Err() != nil {
+			return nil
+		}
+		return errors.New("native Factory database startup failed")
+	}
+	defer func() { runErr = errors.Join(runErr, db.Close()) }()
+	application := NewNativeApplication(factoryservice.ApplicationPorts{Store: db}, nil)
+	defer func() { runErr = errors.Join(runErr, application.Close()) }()
+	if err := application.Recover(startup); err != nil {
+		if ctx.Err() != nil {
+			return nil
+		}
+		return errors.New("native Factory retained recovery failed")
+	}
+	cancelStartup()
+	var closing atomic.Bool
+	server := &http.Server{Handler: nativeHandler(config, application, connector, &closing),
+		ReadHeaderTimeout: 5 * time.Second, ReadTimeout: 10 * time.Second,
+		WriteTimeout: 10 * time.Second, IdleTimeout: 30 * time.Second, MaxHeaderBytes: 16384,
+		BaseContext: func(net.Listener) context.Context { return ctx }, ConnContext: nativePeerContext,
+	}
+	served := make(chan error, 1)
+	go func() { served <- server.Serve(listener) }()
+	var serveErr error
+	var serveStopped bool
+	select {
+	case serveErr = <-served:
+		serveStopped = true
+	case <-ctx.Done():
+	}
+	closing.Store(true)
+	application.StopAdmission()
+	shutdown, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	err = server.Shutdown(shutdown)
+	cancel()
+	if err != nil {
+		_ = server.Close()
+	}
+	if !serveStopped {
+		serveErr = <-served
+	}
+	if errors.Is(serveErr, http.ErrServerClosed) {
+		serveErr = nil
+	} else if serveErr != nil {
+		serveErr = errors.New("native Factory listener stopped")
+	}
+	return errors.Join(serveErr, err)
+}
+
+func nativeHandler(config NativeConfig, application *NativeApplication, connector http.Handler, closing *atomic.Bool) http.Handler {
+	key := []byte(hex.EncodeToString(config.IPCKey()))
+	instance := collaboration.NewID()
+	mux := http.NewServeMux()
+	db := application.application.Store
+	mux.Handle("/api/factory/", application)
+	mux.Handle("/api/repositories/", application)
+	if connector != nil {
+		mux.Handle("/api/native/github/read", application.application.Coordinator.AdmitHTTP(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			if values := r.Header.Values("X-Soda-Native-Instance"); len(values) != 1 || values[0] != instance {
+				nativeResponse(w, 401, map[string]string{"error": "retired_native_instance"})
+				return
+			}
+			connector.ServeHTTP(w, r)
+		})))
+	}
+	mux.HandleFunc("GET /healthz", func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodGet {
+			w.Header().Set("Allow", http.MethodGet)
+			nativeResponse(w, 405, map[string]string{"error": "method_not_allowed"})
+			return
+		}
+		if r.URL.RawQuery != "" || r.URL.ForceQuery {
+			nativeResponse(w, 400, map[string]string{"error": "invalid_request"})
+			return
+		}
+		ctx, cancel := context.WithTimeout(r.Context(), 2*time.Second)
+		defer cancel()
+		if closing.Load() || db.Ping(ctx) != nil {
+			nativeResponse(w, 503, map[string]string{"error": "store_unavailable"})
+			return
+		}
+		nativeResponse(w, 200, map[string]string{"status": "ready", "profile": string(config.Profile), "instance": instance})
+	})
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Cache-Control", "no-store")
+		// The Rust bridge owns this channel. Webviews never receive its key or
+		// connect directly; a browser origin cannot establish native authority.
+		for name := range r.Header {
+			if strings.EqualFold(name, "Origin") || strings.HasPrefix(strings.ToLower(name), "sec-fetch-") {
+				nativeResponse(w, 403, map[string]string{"error": "private_channel_required"})
+				return
+			}
+		}
+		auth := r.Header.Values("Authorization")
+		var bearer string
+		if len(auth) == 1 {
+			if value, ok := strings.CutPrefix(auth[0], "Bearer "); ok {
+				bearer = value
+			}
+		}
+		peer, _ := r.Context().Value(nativePeerKey{}).(bool)
+		if !peer || len(auth) != 1 || len(bearer) != len(key) || subtle.ConstantTimeCompare([]byte(bearer), key) != 1 {
+			nativeResponse(w, 401, map[string]string{"error": "unauthorized"})
+			return
+		}
+		if closing.Load() {
+			nativeResponse(w, 503, map[string]string{"error": "shutting_down"})
+			return
+		}
+		if r.URL.RawPath != "" {
+			nativeResponse(w, 400, map[string]string{"error": "invalid_request"})
+			return
+		}
+		r.Body = http.MaxBytesReader(w, r.Body, 65536)
+		mux.ServeHTTP(w, r)
+	})
+}
+
+func nativeResponse(w http.ResponseWriter, status int, body map[string]string) {
+	w.Header().Set("Content-Type", "application/json; charset=utf-8")
+	w.Header().Set("Cache-Control", "no-store")
+	w.WriteHeader(status)
+	_ = json.NewEncoder(w).Encode(body)
+}
diff --git a/internal/factory/runtime/placement.go b/internal/factory/runtime/placement.go
new file mode 100644
index 0000000000000000000000000000000000000000..89a2ef1d9c1957dd9fa32631b70d3afff65c4e3b
--- /dev/null
+++ b/internal/factory/runtime/placement.go
@@ -0,0 +1,63 @@
+// Package runtime owns Factory runtime placement records. Rust owns processes
+// and native supervision; this package does not launch or control OS processes.
+package runtime
+
+import (
+	"errors"
+	"time"
+
+	"github.com/levitateos/sodaos/internal/collaboration"
+)
+
+type (
+	PlacementState string
+	Coordination   string
+)
+
+const (
+	PlacementInactive     PlacementState = "inactive"
+	PlacementActive       PlacementState = "active"
+	PlacementRetiring     PlacementState = "retiring"
+	FountainCentral       Coordination   = "fountain_central"
+	LocalSingleController Coordination   = "local_single_controller"
+)
+
+var ErrPlacement = errors.New("factory placement unavailable or stale")
+
+// Placement is the retained selection, not a lease synthesized from a login.
+// Runtime changes require retirement of old work before activating a strictly
+// newer generation. Fountain's gateway owns central CAS; GitHub's first release
+// has one configured controller. A local lock cannot prove global exclusion.
+type Placement struct {
+	Host         collaboration.HostID       `json:"host"`
+	Repository   collaboration.RepositoryID `json:"repository,string"`
+	Runtime      collaboration.RuntimeID    `json:"runtime"`
+	Generation   int64                      `json:"generation,string"`
+	State        PlacementState             `json:"state"`
+	Coordination Coordination               `json:"coordination"`
+	SelectedBy   collaboration.ActorID      `json:"selected_by,string"`
+	Revision     collaboration.Revision     `json:"revision"`
+	UpdatedAt    time.Time                  `json:"updated_at"`
+}
+
+func (p Placement) Validate() error {
+	if !collaboration.ValidID(string(p.Host)) || p.Repository <= 0 ||
+		!collaboration.ValidID(string(p.Runtime)) || p.Generation <= 0 || p.SelectedBy <= 0 ||
+		!collaboration.ValidText(string(p.Revision), 256) || p.UpdatedAt.IsZero() ||
+		(p.State != PlacementInactive && p.State != PlacementActive && p.State != PlacementRetiring) ||
+		(p.Coordination != FountainCentral && p.Coordination != LocalSingleController) {
+		return ErrPlacement
+	}
+	return nil
+}
+
+// RequireDispatch checks an authoritative placement observation against the
+// exact retained dispatch binding. The caller must hold its owning store/gateway
+// exclusion gate through admission; this method is not a lock or lease.
+func (p Placement) RequireDispatch(host collaboration.HostID, repository collaboration.RepositoryID, runtime collaboration.RuntimeID, generation int64) error {
+	if p.Validate() != nil || p.State != PlacementActive || p.Host != host || p.Repository != repository ||
+		p.Runtime != runtime || p.Generation != generation {
+		return ErrPlacement
+	}
+	return nil
+}
