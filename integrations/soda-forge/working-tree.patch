+			}
+			_ = logFile.Close()
+		}
+		t.Cleanup(stop)
+		client := &http.Client{Timeout: time.Second}
+		for deadline := time.Now().Add(15 * time.Second); time.Now().Before(deadline); time.Sleep(25 * time.Millisecond) {
