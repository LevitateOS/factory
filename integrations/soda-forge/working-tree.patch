+	return r.Method == http.MethodPost && len(p) == 9 && p[1] == "api" && p[2] == "factory" && p[3] == "collaboration" && p[4] == "repositories" && (p[6] == "issues" || p[6] == "pulls") && p[8] == "edits"
+}
