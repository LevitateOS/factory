+++ b/internal/github/review_comments.go
@@ -0,0 +1,147 @@
+package github
+
+import (
+	"context"
+	"strconv"
+	"time"
+
+	sdk "github.com/google/go-github/v93/github"
+	"github.com/levitateos/sodaos/internal/collaboration"
+)
+
+// ReviewCommentRecord retains raw inline-review evidence. A reply may reference
+// a comment outside this page. OriginalCommit is a review commit, NOT a diff
+// base; nullable positions do not by themselves prove outdatedness/resolution.
+type ReviewCommentRecord struct {
+	ExternalID        string      `json:"external_id"`
+	ReviewID          *string     `json:"review_id"`
+	ReplyTo           *string     `json:"reply_to"`
+	Author            *IssueActor `json:"author"`
+	AuthorAssociation *string     `json:"author_association"`
+	Body              *string     `json:"body"`
+	Path              *string     `json:"path"`
+	DiffHunk          *string     `json:"diff_hunk"`
+	Commit            *string     `json:"commit"`
+	OriginalCommit    *string     `json:"original_commit"`
+	Line              *int        `json:"line"`
+	StartLine         *int        `json:"start_line"`
+	OriginalLine      *int        `json:"original_line"`
+	OriginalStartLine *int        `json:"original_start_line"`
+	Side              *string     `json:"side"`
+	StartSide         *string     `json:"start_side"`
+	Position          *int        `json:"position"`
+	OriginalPosition  *int        `json:"original_position"`
+	SubjectType       *string     `json:"subject_type"`
+	HTMLURL           *string     `json:"html_url"`
+	CreatedAt         *time.Time  `json:"created_at"`
+	UpdatedAt         *time.Time  `json:"updated_at"`
+}
+
+type ReviewCommentPage struct {
+	Repository string                `json:"repository"`
+	Name       string                `json:"name"`
+	Pull       DiscussionSubject     `json:"pull"`
+	Items      []ReviewCommentRecord `json:"items"`
+	NextPage   int                   `json:"next_page"`
+}
+
+func (c *Client) PullReviewComments(ctx context.Context, repository int64, number, page, limit int) (ReviewCommentPage, error) {
+	if repository < 1 || number < 1 || !pageQuery(page, limit) {
+		return ReviewCommentPage{}, ErrInvalidRequest
+	}
+	return c.pullReviewComments(ctx, repository, number, page, limit, 0)
+}
+func (c *Client) PullReviewComment(ctx context.Context, repository int64, number int, comment int64) (ReviewCommentPage, error) {
+	if repository < 1 || number < 1 || comment < 1 {
+		return ReviewCommentPage{}, ErrInvalidRequest
+	}
+	return c.pullReviewComments(ctx, repository, number, 0, 1, comment)
+}
+
+func (c *Client) pullReviewComments(ctx context.Context, repository int64, number, page, limit int, comment int64) (ReviewCommentPage, error) {
+	ctx, cancel := context.WithTimeout(ctx, timeout)
+	defer cancel()
+	owner, name, err := c.issueLocator(ctx, repository)
+	if err != nil {
+		return ReviewCommentPage{}, err
+	}
+	parent, err := c.discussionSubject(ctx, repository, owner, name, "pull", number)
+	if err != nil {
+		return ReviewCommentPage{}, err
+	}
+	var items []*sdk.PullRequestComment
+	var response *sdk.Response
+	if comment == 0 {
+		items, response, err = c.sdk.PullRequests.ListComments(ctx, owner, name, number, &sdk.PullRequestListCommentsOptions{Sort: "created", Direction: "asc", ListOptions: sdk.ListOptions{Page: page, PerPage: limit}})
+	} else {
+		var item *sdk.PullRequestComment
+		item, response, err = c.sdk.PullRequests.GetComment(ctx, owner, name, comment)
+		items = []*sdk.PullRequestComment{item}
+	}
+	info, err := result(ctx, response, err)
+	if err != nil {
+		return ReviewCommentPage{}, err
+	}
+	if items == nil || len(items) > limit || info.NextPage != 0 && (comment != 0 || len(items) == 0 || info.NextPage <= page || info.NextPage > 1_000_000) {
+		return ReviewCommentPage{}, ErrInvalidResponse
+	}
+	r := ReviewCommentPage{Repository: strconv.FormatInt(repository, 10), Name: owner + "/" + name, Pull: parent, Items: make([]ReviewCommentRecord, 0, len(items)), NextPage: info.NextPage}
+	seen := map[int64]bool{}
+	for _, item := range items {
+		if item == nil || item.GetID() < 1 || seen[item.GetID()] || comment != 0 && item.GetID() != comment || item.GetURL() != "https://api.github.com/repos/"+owner+"/"+name+"/pulls/comments/"+strconv.FormatInt(item.GetID(), 10) {
+			return ReviewCommentPage{}, ErrInvalidResponse
+		}
+		if item.GetPullRequestURL() != "https://api.github.com/repos/"+owner+"/"+name+"/pulls/"+strconv.Itoa(number) {
+			return ReviewCommentPage{}, ErrNotVisible
+		}
+		seen[item.GetID()] = true
+		record := ReviewCommentRecord{ExternalID: strconv.FormatInt(item.GetID(), 10), Body: item.Body, Path: item.Path, DiffHunk: item.DiffHunk, Commit: item.CommitID, OriginalCommit: item.OriginalCommitID,
+			Line: item.Line, StartLine: item.StartLine, OriginalLine: item.OriginalLine, OriginalStartLine: item.OriginalStartLine, Side: item.Side, StartSide: item.StartSide, Position: item.Position, OriginalPosition: item.OriginalPosition, SubjectType: item.SubjectType, AuthorAssociation: item.AuthorAssociation, HTMLURL: item.HTMLURL, CreatedAt: issueTime(item.CreatedAt), UpdatedAt: issueTime(item.UpdatedAt)}
+		for _, commit := range []*string{record.Commit, record.OriginalCommit} {
+			if commit != nil && !collaboration.ValidCommitID(collaboration.CommitID(*commit)) {
+				return ReviewCommentPage{}, ErrInvalidResponse
+			}
+		}
+		for _, line := range []*int{record.Line, record.StartLine, record.OriginalLine, record.OriginalStartLine} {
+			if line != nil && *line < 1 {
+				return ReviewCommentPage{}, ErrInvalidResponse
+			}
+		}
+		for _, position := range []*int{record.Position, record.OriginalPosition} {
+			if position != nil && *position < 0 {
+				return ReviewCommentPage{}, ErrInvalidResponse
+			}
+		}
+		for _, pair := range []struct {
+			native *int64
+			local  **string
+		}{{item.PullRequestReviewID, &record.ReviewID}, {item.InReplyTo, &record.ReplyTo}} {
+			if pair.native != nil {
+				if *pair.native < 1 {
+					return ReviewCommentPage{}, ErrInvalidResponse
+				}
+				value := strconv.FormatInt(*pair.native, 10)
+				*pair.local = &value
+			}
+		}
+		if item.User != nil {
+			author, err := issueActor(item.User)
+			if err != nil {
+				return ReviewCommentPage{}, err
+			}
+			record.Author = &author
+		}
+		r.Items = append(r.Items, record)
+	}
+	after, err := c.discussionSubject(ctx, repository, owner, name, "pull", number)
+	if err != nil {
+		return ReviewCommentPage{}, err
+	}
+	if after != parent {
+		return ReviewCommentPage{}, ErrInvalidResponse
+	}
+	if err := c.checkIssueLocator(ctx, repository, owner, name); err != nil {
+		return ReviewCommentPage{}, err
+	}
+	return r, nil
+}
diff --git a/internal/github/reviews.go b/internal/github/reviews.go
new file mode 100644
index 0000000000000000000000000000000000000000..f53b06edc6215518b6370631a1cdc1a21e9b95da
--- /dev/null
+++ b/internal/github/reviews.go
@@ -0,0 +1,122 @@
+package github
+
+import (
+	"context"
+	"strconv"
+	"time"
+
+	sdk "github.com/google/go-github/v93/github"
+	"github.com/levitateos/sodaos/internal/collaboration"
+)
+
+// Review submissions are distinct from ordinary comments and inline threads.
+// These are provider-local facts; no canonical identity or action is inferred.
+type ReviewRecord struct {
+	ExternalID    string      `json:"external_id"`
+	Author        *IssueActor `json:"author"`
+	Body          string      `json:"body"`
+	State         string      `json:"state"`
+	ProviderState string      `json:"provider_state"`
+	Commit        *string     `json:"commit"`
+	SubmittedAt   *time.Time  `json:"submitted_at"`
+}
+type ReviewPage struct {
+	Repository string            `json:"repository"`
+	Name       string            `json:"name"`
+	Pull       DiscussionSubject `json:"pull"`
+	Items      []ReviewRecord    `json:"items"`
+	NextPage   int               `json:"next_page"`
+}
+
+func (c *Client) PullReviews(ctx context.Context, repository int64, number, page, limit int) (ReviewPage, error) {
+	if repository < 1 || number < 1 || !pageQuery(page, limit) {
+		return ReviewPage{}, ErrInvalidRequest
+	}
+	return c.pullReviews(ctx, repository, number, page, limit, 0)
+}
+func (c *Client) PullReview(ctx context.Context, repository int64, number int, review int64) (ReviewPage, error) {
+	if repository < 1 || number < 1 || review < 1 {
+		return ReviewPage{}, ErrInvalidRequest
+	}
+	return c.pullReviews(ctx, repository, number, 0, 1, review)
+}
+
+// Both list and detail bracket the selected actual PR identity and repository
+// visibility. They are live pages, not an atomic history or a latest-head vote.
+func (c *Client) pullReviews(ctx context.Context, repository int64, number, page, limit int, review int64) (ReviewPage, error) {
+	ctx, cancel := context.WithTimeout(ctx, timeout)
+	defer cancel()
+	owner, name, err := c.issueLocator(ctx, repository)
+	if err != nil {
+		return ReviewPage{}, err
+	}
+	parent, err := c.discussionSubject(ctx, repository, owner, name, "pull", number)
+	if err != nil {
+		return ReviewPage{}, err
+	}
+	var reviews []*sdk.PullRequestReview
+	var response *sdk.Response
+	if review == 0 {
+		reviews, response, err = c.sdk.PullRequests.ListReviews(ctx, owner, name, number, &sdk.ListOptions{Page: page, PerPage: limit})
+	} else {
+		var item *sdk.PullRequestReview
+		item, response, err = c.sdk.PullRequests.GetReview(ctx, owner, name, number, review)
+		reviews = []*sdk.PullRequestReview{item}
+	}
+	info, err := result(ctx, response, err)
+	if err != nil {
+		return ReviewPage{}, err
+	}
+	if reviews == nil || len(reviews) > limit || info.NextPage != 0 && (review != 0 || info.NextPage <= page || info.NextPage > 1_000_000) {
+		return ReviewPage{}, ErrInvalidResponse
+	}
+	result := ReviewPage{Repository: strconv.FormatInt(repository, 10), Name: owner + "/" + name, Pull: parent, Items: make([]ReviewRecord, 0, len(reviews)), NextPage: info.NextPage}
+	seen := map[int64]bool{}
+	for _, item := range reviews {
+		if item == nil || item.GetID() < 1 || seen[item.GetID()] || review != 0 && item.GetID() != review || item.GetPullRequestURL() != "https://api.github.com/repos/"+owner+"/"+name+"/pulls/"+strconv.Itoa(number) {
+			return ReviewPage{}, ErrInvalidResponse
+		}
+		seen[item.GetID()] = true
+		record := ReviewRecord{ExternalID: strconv.FormatInt(item.GetID(), 10), Body: item.GetBody(), State: "unknown", ProviderState: item.GetState(), SubmittedAt: issueTime(item.SubmittedAt)}
+		switch item.GetState() {
+		case "PENDING":
+			record.State = "pending"
+		case "APPROVED":
+			record.State = "approved"
+		case "CHANGES_REQUESTED":
+			record.State = "changes_requested"
+		case "COMMENTED":
+			record.State = "commented"
+		case "DISMISSED":
+			record.State = "dismissed"
+		}
+		if record.State == "pending" && record.SubmittedAt != nil {
+			return ReviewPage{}, ErrInvalidResponse
+		}
+		if item.CommitID != nil {
+			if !collaboration.ValidCommitID(collaboration.CommitID(*item.CommitID)) {
+				return ReviewPage{}, ErrInvalidResponse
+			}
+			record.Commit = item.CommitID
+		}
+		if item.User != nil {
+			actor, err := issueActor(item.User)
+			if err != nil {
+				return ReviewPage{}, err
+			}
+			record.Author = &actor
+		}
+		result.Items = append(result.Items, record)
+	}
+	after, err := c.discussionSubject(ctx, repository, owner, name, "pull", number)
+	if err != nil {
+		return ReviewPage{}, err
+	}
+	if after != parent {
+		return ReviewPage{}, ErrNotVisible
+	}
+	if err := c.checkIssueLocator(ctx, repository, owner, name); err != nil {
+		return ReviewPage{}, err
+	}
+	return result, nil
+}
diff --git a/internal/store/factory_feed_post_retry.go b/internal/store/factory_feed_post_retry.go
new file mode 100644
index 0000000000000000000000000000000000000000..14ebc9f88a4c5206ac54f6e4924a69c740540011
--- /dev/null
+++ b/internal/store/factory_feed_post_retry.go
@@ -0,0 +1,80 @@
+package store
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"strconv"
+	"time"
+
+	"github.com/levitateos/sodaos/internal/factory"
+)
+
+// RetryIssueMakerFeedPostCommand commits the retry and its immutable receipt in
+// one transaction. replayed is true only for an already committed command; that
+// path never changes the current post/intake. Callers must admit current actor
+// visibility and authorship before calling, including when recovering a receipt.
+func (s *Store) RetryIssueMakerFeedPostCommand(ctx context.Context, request factory.FeedPostRetryCommand, at int64) (receipt factory.FeedPostRetryReceipt, replayed bool, err error) {
+	command, err := request.Command()
+	if err != nil {
+		return receipt, false, err
+	}
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		return receipt, false, err
+	}
+	defer func() { _ = tx.Rollback() }()
+	stored, created, err := recordFactoryCommandTx(ctx, tx, command, time.Unix(at, 0))
+	if err != nil {
+		return receipt, false, err
+	}
+	if stored.Type != command.Type || stored.Target != command.Target || stored.Principal != command.Principal || stored.Payload != command.Payload {
+		return receipt, false, ErrCommandConflict
+	}
+	// Check actual retained scope even for replay. The receipt is historical, so
+	// head revision/processing state must not be required to match its result.
+	var author string
+	var repository int64
+	if err = tx.QueryRowContext(ctx, `SELECT author,repository FROM factory_feed_posts WHERE id=$1 FOR UPDATE`, request.Post).Scan(&author, &repository); err != nil {
+		return receipt, false, err
+	}
+	if author != request.Author || repository != request.Repository {
+		return receipt, false, ErrStaleRevision
+	}
+	if !created {
+		if stored.Finished == "" || stored.Outcome == "" {
+			return receipt, false, errors.New("post retry command has no committed receipt")
+		}
+		if err = json.Unmarshal([]byte(stored.Outcome), &receipt); err != nil {
+			return receipt, false, err
+		}
+		if err = receipt.Validate(request); err != nil {
+			return receipt, false, err
+		}
+		return receipt, true, nil
+	}
+	if err = retryFeedPostTx(ctx, tx, request.Post, request.Author, request.ExpectedRevision, request.Body, at, true, request.Repository); err != nil {
+		return receipt, false, err
+	}
+	var revision int64
+	var body string
+	if err = tx.QueryRowContext(ctx, `SELECT revision,body FROM factory_feed_posts WHERE id=$1`, request.Post).Scan(&revision, &body); err != nil {
+		return receipt, false, err
+	}
+	receipt = factory.FeedPostRetryReceipt{CommandID: request.ID, Post: request.Post, Repository: strconv.FormatInt(request.Repository, 10), Author: request.Author, ExpectedRevision: request.ExpectedRevision, Revision: revision, BodyDigest: factory.MCPInputDigest([]byte(body))}
+	if err = receipt.Validate(request); err != nil {
+		return receipt, false, err
+	}
+	outcome, err := json.Marshal(receipt)
+	if err != nil {
+		return receipt, false, err
+	}
+	result, err := tx.ExecContext(ctx, `UPDATE factory_commands SET outcome=$2,finished=$3 WHERE id=$1 AND finished=''`, request.ID, string(outcome), time.Unix(at, 0).UTC().Format(time.RFC3339Nano))
+	if err = checkGrantRowsAffected(result, err, "post retry receipt save failed"); err != nil {
+		return receipt, false, err
+	}
+	if err = tx.Commit(); err != nil {
+		return receipt, false, err
+	}
+	return receipt, false, nil
+}
diff --git a/internal/store/factory_human_comment.go b/internal/store/factory_human_comment.go
new file mode 100644
index 0000000000000000000000000000000000000000..2d8415bda2e481d0deee4c51a52d8c6f205131e8
--- /dev/null
+++ b/internal/store/factory_human_comment.go
@@ -0,0 +1,150 @@
+package store
+
+import (
+	"context"
+	"encoding/json"
+	"time"
+
+	"github.com/levitateos/sodaos/internal/collaboration"
+	"github.com/levitateos/sodaos/internal/factory"
+)
+
+// CaptureHumanComment commits preparation before any remote effect. A concurrent
+// identical request returns the winning preparation, even when the losing caller
+// observed a different revision/deadline. Dispatch ONLY the returned capture.
+// Callers must still check current human authority before submit/get/cancel.
+func (s *Store) CaptureHumanComment(ctx context.Context, capture factory.HumanCommentCapture) (factory.HumanCommentCapture, bool, error) {
+	cmd, err := capture.Command()
+	if err != nil {
+		return factory.HumanCommentCapture{}, false, err
+	}
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		return factory.HumanCommentCapture{}, false, err
+	}
+	defer tx.Rollback()
+	q := capture.Request
+	var bound bool
+	err = tx.QueryRowContext(ctx, `SELECT l.adopted AND EXISTS(SELECT 1 FROM collaboration_repositories r JOIN collaboration_actors a ON a.host=r.host WHERE r.host=$1 AND r.id=$2 AND a.id=$3) FROM collaboration_ledger l WHERE singleton FOR SHARE`, q.Host, q.Repository, q.Actor).Scan(&bound)
+	if err != nil {
+		return factory.HumanCommentCapture{}, false, err
+	}
+	if !bound {
+		return factory.HumanCommentCapture{}, false, collaboration.ErrUnboundLedger
+	}
+	result, err := tx.ExecContext(ctx, `INSERT INTO factory_commands(id,type,target,principal,digest,payload,created) VALUES($1,$2,$3,$4,$5,$6,$7) ON CONFLICT(id) DO NOTHING`, cmd.ID, cmd.Type, cmd.Target, cmd.Principal, cmd.Digest, cmd.Payload, time.Now().UTC().Format(time.RFC3339Nano))
+	if err != nil {
+		return factory.HumanCommentCapture{}, false, err
+	}
+	n, err := result.RowsAffected()
+	if err != nil {
+		return factory.HumanCommentCapture{}, false, err
+	}
+	var stored factory.Command
+	err = tx.QueryRowContext(ctx, `SELECT id,type,target,principal,digest,payload,outcome,created,finished FROM factory_commands WHERE id=$1 FOR UPDATE`, cmd.ID).Scan(&stored.ID, &stored.Type, &stored.Target, &stored.Principal, &stored.Digest, &stored.Payload, &stored.Outcome, &stored.Created, &stored.Finished)
+	if err != nil {
+		return factory.HumanCommentCapture{}, false, err
+	}
+	if stored.Type != factory.CommandHumanComment {
+		return factory.HumanCommentCapture{}, false, ErrCommandConflict
+	}
+	saved, err := factory.DecodeHumanCommentCapture(stored)
+	if err != nil {
+		return factory.HumanCommentCapture{}, false, err
+	}
+	if saved.Request != q {
+		return factory.HumanCommentCapture{}, false, ErrCommandConflict
+	}
+	if err := tx.Commit(); err != nil {
+		return factory.HumanCommentCapture{}, false, err
+	}
+	return saved, n == 0, nil
+}
+
+// ObserveHumanComment saves only validated adapter observations in the existing
+// command row. The row lock serializes overlapping replies; immutable capture and
+// terminal guards remain the database's final boundary. No network runs in SQL.
+func (s *Store) ObserveHumanComment(ctx context.Context, c factory.HumanCommentCapture, o collaboration.OperationLookup) (collaboration.OperationLookup, error) {
+	var empty collaboration.OperationLookup
+	cmd, err := c.Command()
+	if err != nil {
+		return empty, err
+	}
+	if err := factory.ValidateHumanCommentObservation(c, o); err != nil {
+		return empty, err
+	}
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		return empty, err
+	}
+	defer tx.Rollback()
+	var stored factory.Command
+	err = tx.QueryRowContext(ctx, `SELECT id,type,target,principal,digest,payload,outcome,created,finished FROM factory_commands WHERE id=$1 FOR UPDATE`, cmd.ID).Scan(&stored.ID, &stored.Type, &stored.Target, &stored.Principal, &stored.Digest, &stored.Payload, &stored.Outcome, &stored.Created, &stored.Finished)
+	if err != nil {
+		return empty, err
+	}
+	if stored.Type != cmd.Type || stored.Target != cmd.Target || stored.Principal != cmd.Principal || stored.Digest != cmd.Digest || stored.Payload != cmd.Payload {
+		return empty, ErrCommandConflict
+	}
+	if _, err := factory.DecodeHumanCommentCapture(stored); err != nil {
+		return empty, err
+	}
+	if stored.Outcome != "" {
+		var prior collaboration.OperationLookup
+		if json.Unmarshal([]byte(stored.Outcome), &prior) != nil {
+			return empty, factory.ErrHumanCommentObservation
+		}
+		o, err = factory.AdvanceHumanCommentObservation(c, prior, o)
+		if err != nil {
+			return empty, err
+		}
+	}
+	raw, err := json.Marshal(o)
+	if err != nil {
+		return empty, err
+	}
+	if len(raw) > 64<<10 {
+		return empty, factory.ErrHumanCommentObservation
+	}
+	if stored.Finished != "" {
+		if !factory.HumanCommentFinished(o) || string(raw) != stored.Outcome {
+			return empty, factory.ErrHumanCommentObservation
+		}
+	} else if string(raw) != stored.Outcome {
+		finished := ""
+		if factory.HumanCommentFinished(o) {
+			finished = time.Now().UTC().Format(time.RFC3339Nano)
+		}
+		result, err := tx.ExecContext(ctx, `UPDATE factory_commands SET outcome=$2,finished=$3 WHERE id=$1 AND finished=''`, cmd.ID, string(raw), finished)
+		if err := checkGrantRowsAffected(result, err, "human comment observation save failed"); err != nil {
+			return empty, err
+		}
+	}
+	if err := tx.Commit(); err != nil {
+		return empty, err
+	}
+	return o, nil
+}
+
+// HumanCommentCapture looks up by admitted exact request, before preparing any
+// new provider snapshot. Absence is ErrNotFound, never proof of a remote outcome.
+func (s *Store) HumanCommentCapture(ctx context.Context, q factory.HumanCommentCommand) (factory.HumanCommentCapture, error) {
+	if err := q.Validate(); err != nil {
+		return factory.HumanCommentCapture{}, err
+	}
+	cmd, err := s.FactoryCommand(ctx, q.ID)
+	if err != nil {
+		return factory.HumanCommentCapture{}, err
+	}
+	if cmd.Type != factory.CommandHumanComment {
+		return factory.HumanCommentCapture{}, ErrCommandConflict
+	}
+	saved, err := factory.DecodeHumanCommentCapture(cmd)
+	if err != nil {
+		return factory.HumanCommentCapture{}, err
+	}
+	if saved.Request != q {
+		return factory.HumanCommentCapture{}, ErrCommandConflict
+	}
+	return saved, nil
+}
diff --git a/internal/store/factory_human_edit.go b/internal/store/factory_human_edit.go
