+++ b/internal/factory/service/post_commands.go
@@ -0,0 +1,195 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"strconv"
+	"time"
+
+	"github.com/levitateos/sodaos/internal/collaboration"
+	"github.com/levitateos/sodaos/internal/factory"
+	"github.com/levitateos/sodaos/internal/store"
+)
+
+// PostCapture stores provider-owned authorization and issue-context evidence.
+// It grants no general repository/execution capability and starts no worker.
+type PostCapture struct {
+	Authorization func(context.Context, collaboration.ActorID, string, int64) error
+	Context       func(context.Context, collaboration.ActorID, string, int64) error
+}
+
+type PostCommands struct {
+	Posts   Posts
+	Capture PostCapture
+}
+
+var (
+	ErrPostInputInvalid       = errors.New("invalid feed post")
+	ErrPostSourceNotFound     = errors.New("post source is not visible")
+	ErrPostAuthorRequired     = errors.New("only the author can revise this request")
+	ErrPostRetryConflict      = errors.New("post retry conflicts with its recorded state")
+	ErrPostCaptureUnavailable = errors.New("post context capture is unavailable")
+)
+
+func (s PostCommands) Submit(ctx context.Context, actor collaboration.ActorID, authorName string, req factory.PostRequest) (factory.PostResponse, error) {
+	var empty factory.PostResponse
+	if err := req.Validate(); err != nil {
+		return empty, errors.Join(ErrPostInputInvalid, err)
+	}
+	if err := s.Posts.visible(ctx, actor, req.Repository); err != nil {
+		return empty, err
+	}
+	author := strconv.FormatInt(int64(actor), 10)
+	id, revision, err := s.Posts.Store.FeedPostSubmission(ctx, req.Repository, author, req.IdempotencyKey)
+	if errors.Is(err, store.ErrNotFound) {
+		var source *factory.PostSource
+		if req.ParentID != "" {
+			resolved, err := s.Posts.Store.ResolvePostParent(ctx, req.Repository, req.ParentID)
+			if errors.Is(err, store.ErrNotFound) {
+				return empty, ErrPostSourceNotFound
+			}
+			if err != nil {
+				return empty, err
+			}
+			source = resolved
+			req.SourceKind, req.SourceID = resolved.Kind, resolved.ID
+		}
+		id, revision, err = s.Posts.Store.SaveFeedPostWithSource(ctx, req, author, authorName, time.Now().Unix(), source)
+	}
+	if err != nil {
+		return empty, err
+	}
+	if err := s.Posts.Store.RecordIssueMakerIntake(ctx, id, revision); err != nil {
+		return empty, err
+	}
+	if err := s.refresh(ctx, actor, id, revision, "Could not read this repository's issues using your current access. Retry the request."); err != nil {
+		return empty, err
+	}
+	return s.response(ctx, id, true)
+}
+
+func (s PostCommands) retryAuthor(ctx context.Context, actor collaboration.ActorID, id string, repository int64) (string, error) {
+	if actor <= 0 {
+		return "", ErrPostNotFound
+	}
+	if s.Posts.Store == nil || s.Posts.Visibility == nil {
+		return "", ErrPostViewUnavailable
+	}
+	detail, err := s.Posts.Store.FeedPost(ctx, id)
+	if errors.Is(err, store.ErrNotFound) {
+		return "", ErrPostNotFound
+	}
+	if err != nil {
+		return "", err
+	}
+	if err := s.Posts.visible(ctx, actor, detail.Record.Repository); err != nil {
+		return "", err
+	}
+	if detail.Record.Repository != repository {
+		return "", ErrPostNotFound
+	}
+	if detail.Record.Author != strconv.FormatInt(int64(actor), 10) {
+		return "", ErrPostAuthorRequired
+	}
+	return detail.Record.Author, nil
+}
+
+func (s PostCommands) Retry(ctx context.Context, actor collaboration.ActorID, id string, in factory.FeedPostRetryRequest) (factory.FeedPostRetryReceipt, error) {
+	var empty factory.FeedPostRetryReceipt
+	request := factory.FeedPostRetryCommand{ID: in.CommandID, Post: id, Repository: in.Repository, Author: strconv.FormatInt(int64(actor), 10), ExpectedRevision: in.ExpectedRevision, Body: in.Body}
+	if err := request.Validate(); err != nil {
+		return empty, errors.Join(ErrPostInputInvalid, err)
+	}
+	if _, err := s.retryAuthor(ctx, actor, id, in.Repository); err != nil {
+		return empty, err
+	}
+	receipt, replayed, err := s.Posts.Store.RetryIssueMakerFeedPostCommand(ctx, request, time.Now().Unix())
+	if err != nil {
+		return empty, errors.Join(ErrPostRetryConflict, err)
+	}
+	if _, err := s.retryAuthor(ctx, actor, id, in.Repository); err != nil {
+		return empty, err
+	}
+	if !replayed {
+		// Only this newly committed transition owns best-effort capture. A
+		// historical receipt never recaptures or mutates a later intake/head.
+		message := "Could not refresh this request's issues using your current repository access. Try again."
+		if err := s.refresh(ctx, actor, id, receipt.Revision, message); err != nil {
+			if err := s.waitForContext(ctx, id, receipt.Revision, message); err != nil && !errors.Is(err, store.ErrStaleRevision) {
+				return empty, err
+			}
+		}
+	}
+	if _, err := s.retryAuthor(ctx, actor, id, in.Repository); err != nil {
+		return empty, err
+	}
+	return receipt, nil
+}
+
+// RetryReceipt is read-only recovery. An absent ID does not create a command or
+// retry work, and a retained receipt cannot substitute for current authority.
+func (s PostCommands) RetryReceipt(ctx context.Context, actor collaboration.ActorID, id, commandID string, repository int64) (factory.FeedPostRetryReceipt, error) {
+	var empty factory.FeedPostRetryReceipt
+	if !factory.ValidID(id) || !factory.ValidID(commandID) || repository <= 0 {
+		return empty, ErrPostInputInvalid
+	}
+	author, err := s.retryAuthor(ctx, actor, id, repository)
+	if err != nil {
+		return empty, err
+	}
+	command, err := s.Posts.Store.FactoryCommand(ctx, commandID)
+	if errors.Is(err, store.ErrNotFound) {
+		return empty, ErrPostNotFound
+	}
+	if err != nil {
+		return empty, err
+	}
+	receipt, err := factory.ReadFeedPostRetryReceipt(command, id, repository, author)
+	if err != nil {
+		return empty, ErrPostNotFound
+	}
+	if _, err := s.retryAuthor(ctx, actor, id, repository); err != nil {
+		return empty, err
+	}
+	return receipt, nil
+}
+
+func (s PostCommands) refresh(ctx context.Context, actor collaboration.ActorID, id string, revision int64, message string) error {
+	captured, err := s.Posts.Store.PostUsesIssueMaker(ctx, id, revision)
+	if err != nil {
+		return err
+	}
+	if captured && s.Capture.Authorization != nil {
+		// Provider proof capture is best effort. The recorded captured path
+		// cannot create an issue without that proof, and never becomes legacy.
+		_ = s.Capture.Authorization(ctx, actor, id, revision)
+	}
+	err = ErrPostCaptureUnavailable
+	if s.Capture.Context != nil {
+		err = s.Capture.Context(ctx, actor, id, revision)
+	}
+	if err != nil {
+		return s.waitForContext(ctx, id, revision, message)
+	}
+	return nil
+}
+
+func (s PostCommands) waitForContext(ctx context.Context, id string, revision int64, message string) error {
+	return s.Posts.Store.NotePostContextWait(ctx, id, revision, PostStalledContext, message)
+}
+
+func (s PostCommands) response(ctx context.Context, id string, includeSource bool) (factory.PostResponse, error) {
+	pipe, err := s.Posts.Store.PostIntake(ctx, id)
+	if err != nil {
+		return factory.PostResponse{}, err
+	}
+	response := PostResponse(pipe)
+	if includeSource {
+		detail, err := s.Posts.Store.FeedPost(ctx, id)
+		if err != nil {
+			return factory.PostResponse{}, err
+		}
+		response.Source = detail.Source
+	}
+	return response, nil
+}
diff --git a/internal/factory/service/post_context.go b/internal/factory/service/post_context.go
new file mode 100644
index 0000000000000000000000000000000000000000..43349c39c9b548ac0ea316eabda821834ed90b26
--- /dev/null
+++ b/internal/factory/service/post_context.go
@@ -0,0 +1,172 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"strconv"
+
+	"github.com/levitateos/sodaos/internal/collaboration"
+	"github.com/levitateos/sodaos/internal/factory"
+	"github.com/levitateos/sodaos/internal/store"
+)
+
+// PostIssueQuery requests an open-issue page, or one explicit issue (including
+// closed issues). A number is local to the admitted canonical repository.
+type PostIssueQuery struct {
+	Cursor string
+	Number int64
+	Limit  int
+}
+
+// PostIssueReader reads current human-visible discussion context. Only scope,
+// number, observation, title/body and state are consumed; unobserved external
+// record IDs are not fabricated and this read supplies no execution proof.
+type PostIssueReader func(context.Context, collaboration.ActorID, collaboration.RepositoryID, PostIssueQuery) (collaboration.Page[collaboration.Issue], error)
+
+type PostContext struct {
+	Posts  Posts
+	Issues PostIssueReader
+}
+
+var ErrPostContextPage = errors.New("issue context page is unavailable or did not advance")
+
+// Prepare uses the exact captured revision, never a background provider read.
+// Missing human context waits without spending a routing judgment.
+func (s PostContext) Prepare(ctx context.Context, in PostJudgeInput) (PostJudgeInput, error) {
+	if s.Posts.Store == nil {
+		return in, ErrPostIssueContext
+	}
+	candidates, err := s.Posts.Store.PostIssueContext(ctx, in.SourcePost.Record.ID, in.SourcePost.Record.Revision)
+	if err != nil {
+		return in, ErrPostIssueContext
+	}
+	in.Candidates = candidates
+	return in, nil
+}
+
+// Capture saves a complete bounded context for this exact author's revision.
+// It never consults a model, creates an issue or enrolls execution authority.
+func (s PostContext) Capture(ctx context.Context, actor collaboration.ActorID, id string, revision int64) error {
+	if actor < 1 {
+		return ErrPostNotFound
+	}
+	if s.Posts.Store == nil || s.Issues == nil {
+		return ErrPostCaptureUnavailable
+	}
+	detail, err := s.Posts.Store.FeedPost(ctx, id)
+	if err != nil {
+		return err
+	}
+	if detail.Record.Deleted || detail.Record.Revoked {
+		return ErrPostNotFound
+	}
+	if detail.Record.Author != strconv.FormatInt(int64(actor), 10) {
+		return ErrPostAuthorRequired
+	}
+	if detail.Record.Revision != revision {
+		return store.ErrStaleRevision
+	}
+	repository := detail.Record.Repository
+	if err := s.Posts.visible(ctx, actor, repository); err != nil {
+		return err
+	}
+	input, err := CollectPostJudgeInput(ctx, s.Posts.Store, detail)
+	if err != nil {
+		return err
+	}
+	read := func(query PostIssueQuery) (collaboration.Page[collaboration.Issue], error) {
+		var empty collaboration.Page[collaboration.Issue]
+		if err := s.Posts.visible(ctx, actor, repository); err != nil {
+			return empty, err
+		}
+		page, err := s.Issues(ctx, actor, collaboration.RepositoryID(repository), query)
+		if err != nil {
+			return empty, err
+		}
+		if err := ctx.Err(); err != nil {
+			return empty, err
+		}
+		if page.Observation.State != collaboration.ReadAvailable || page.Complete != (page.Next == "") || len(page.Items) > query.Limit {
+			return empty, ErrPostContextPage
+		}
+		for _, issue := range page.Items {
+			if issue.Observation.State != collaboration.ReadAvailable || issue.Ref.Kind != collaboration.SubjectIssue || issue.Ref.Repository != collaboration.RepositoryID(repository) || issue.Ref.Number < 1 || issue.State != "open" && issue.State != "closed" {
+				return empty, ErrPostContextPage
+			}
+			if query.Number > 0 && issue.Ref.Number != query.Number {
+				return empty, ErrPostContextPage
+			}
+		}
+		return page, nil
+	}
+	byIssue := map[int64]factory.PostWorkCandidate{}
+	order := []int64{}
+	add := func(issue collaboration.Issue) error {
+		number := issue.Ref.Number
+		candidate := factory.PostWorkCandidate{Issue: number, Title: issue.Title, Objective: issue.Body, Summary: store.TruncateFeedSummary(issue.Title + "\n" + issue.Body), Status: issue.State, Origin: factory.PostCandidateRecent}
+		for _, previous := range input.Candidates {
+			if previous.Issue == number {
+				candidate.Origin, candidate.WorkerStatus = previous.Origin, previous.Status
+				break
+			}
+		}
+		if err := candidate.Validate(); err != nil {
+			return err
+		}
+		if _, exists := byIssue[number]; !exists {
+			order = append(order, number)
+		}
+		byIssue[number] = candidate
+		return nil
+	}
+	cursor := ""
+	seen := map[string]bool{"": true}
+	for {
+		page, err := read(PostIssueQuery{Cursor: cursor, Limit: 50})
+		if err != nil {
+			return err
+		}
+		for _, issue := range page.Items {
+			if err := add(issue); err != nil {
+				return err
+			}
+		}
+		if len(order) > 250 {
+			return errors.New("Choose the issue this request concerns; there are too many open issues to assess together.")
+		}
+		if page.Next == "" {
+			break
+		}
+		if len(page.Items) == 0 || seen[page.Next] || len(seen) >= 250 {
+			return ErrPostContextPage
+		}
+		seen[page.Next] = true
+		cursor = page.Next
+	}
+	for _, candidate := range input.Candidates {
+		if candidate.Origin == factory.PostCandidateRecent {
+			continue
+		}
+		if _, exists := byIssue[candidate.Issue]; exists {
+			continue
+		}
+		page, err := read(PostIssueQuery{Number: candidate.Issue, Limit: 1})
+		if err != nil {
+			return err
+		}
+		if len(page.Items) != 1 || !page.Complete {
+			return ErrPostContextPage
+		}
+		if err := add(page.Items[0]); err != nil {
+			return err
+		}
+	}
+	candidates := make([]factory.PostWorkCandidate, 0, len(order))
+	for _, number := range order {
+		candidates = append(candidates, byIssue[number])
+	}
+	if err := s.Posts.visible(ctx, actor, repository); err != nil {
+		return err
+	}
+	return s.Posts.Store.SavePostIssueContext(ctx, id, revision, candidates)
+}
diff --git a/internal/factory/service/post_effects.go b/internal/factory/service/post_effects.go
new file mode 100644
index 0000000000000000000000000000000000000000..69d686acc003df34a5d7988160fc9aa03a35a0e1
--- /dev/null
+++ b/internal/factory/service/post_effects.go
@@ -0,0 +1,214 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"strconv"
+	"time"
+
+	"github.com/levitateos/sodaos/internal/collaboration"
+	"github.com/levitateos/sodaos/internal/factory"
+	"github.com/levitateos/sodaos/internal/store"
+)
+
+// PostEffectStore reads the actual source and its recorded authored draft.
+// Effect receipts remain in the existing provider operation journal.
+type PostEffectStore interface {
+	FeedPost(context.Context, string) (store.FeedPostDetail, error)
+	PostDraft(context.Context, string, int64) (factory.IssueDraft, error)
+}
+
+type PostEffectGraph interface {
+	factory.GraphCodec
+	CheckIntentOwner(context.Context, int64, int64, int64) (int64, error)
+	SubmitGraph(context.Context, factory.IntentGeneration, int64) (factory.GraphOperationOutcome, error)
+	LookupGraph(context.Context, factory.IntentGeneration, int64) (factory.GraphOperationLookup, error)
+}
+
+// PostIssueEffects binds deterministic issue/feedback effects to the current
+// recorded human source. Graph supplies current author/publishing admission and
+// provider encoding; saving a feed post grants no execution authority.
+type PostIssueEffects struct {
+	Store PostEffectStore
+	Graph PostEffectGraph
+	Actor int64
+}
+
+var _ PostIssueCreator = (*PostIssueEffects)(nil)
+
+var (
+	ErrPostEffectUnavailable = errors.New("post issue delivery is unavailable")
+	ErrPostEffectSource      = errors.New("post issue source changed or is unavailable")
+	ErrPostEffectUnknown     = errors.New("post issue operation outcome is unknown")
+	ErrPostEffectReceipt     = errors.New("post issue receipt does not match its operation and scope")
+)
+
+func (s *PostIssueEffects) source(ctx context.Context, repository int64, id string) (store.FeedPostDetail, int64, error) {
+	var empty store.FeedPostDetail
+	if s == nil || s.Store == nil || s.Graph == nil || s.Actor <= 0 {
+		return empty, 0, ErrPostEffectUnavailable
+	}
+	if err := ctx.Err(); err != nil {
+		return empty, 0, err
+	}
+	post, err := s.Store.FeedPost(ctx, id)
+	if err != nil {
+		return empty, 0, err
+	}
+	author, authorErr := strconv.ParseInt(post.Record.Author, 10, 64)
+	if repository <= 0 || post.Record.Validate() != nil || post.Record.ID != id ||
+		post.Record.Repository != repository || post.Record.Deleted || post.Record.Revoked || authorErr != nil || author <= 0 || strconv.FormatInt(author, 10) != post.Record.Author {
+		return empty, 0, ErrPostEffectSource
+	}
+	return post, author, nil
+}
+
+func (s *PostIssueEffects) current(ctx context.Context, post store.FeedPostDetail, draft *factory.IssueDraft) (int64, error) {
+	latest, author, err := s.source(ctx, post.Record.Repository, post.Record.ID)
+	if err != nil {
+		return 0, err
+	}
+	if latest.Record != post.Record || latest.Body != post.Body {
+		return 0, ErrPostEffectSource
+	}
+	if draft != nil {
+		saved, err := s.Store.PostDraft(ctx, post.Record.ID, post.Record.Revision)
+		if err != nil {
+			return 0, err
+		}
+		if saved != *draft || draft.SourcePost != post.Record.ID || draft.Revision != post.Record.Revision {
+			return 0, ErrPostEffectSource
+		}
+	}
+	revision, err := s.Graph.CheckIntentOwner(ctx, post.Record.Repository, author, s.Actor)
+	if err != nil {
+		return 0, err
+	}
+	// Current permission reads may race a local edit/revocation. Re-read the
+	// source after that I/O before returning data or submitting an effect.
+	latest, _, err = s.source(ctx, post.Record.Repository, post.Record.ID)
+	if err != nil {
+		return 0, err
+	}
+	if latest.Record != post.Record || latest.Body != post.Body {
+		return 0, ErrPostEffectSource
+	}
+	if draft != nil {
+		saved, err := s.Store.PostDraft(ctx, post.Record.ID, post.Record.Revision)
+		if err != nil {
+			return 0, err
+		}
+		if saved != *draft {
+			return 0, ErrPostEffectSource
+		}
+	}
+	if revision < 1 {
+		return 0, ErrPostEffectUnavailable
+	}
+	return revision, ctx.Err()
+}
+
+func postIssueOperationID(post string) string {
+	// Preserve historical operation identities across the vocabulary/package move.
+	return "commentissue-" + post
+}
+
+func (s *PostIssueEffects) receiptIndex(ctx context.Context, repository int64, id string, outcome factory.GraphOperationOutcome) (int64, error) {
+	if outcome.OperationID != postIssueOperationID(id) || outcome.Effect != collaboration.EffectCommitted || len(outcome.Receipt) == 0 {
+		return 0, ErrPostEffectUnknown
+	}
+	facts, err := s.Graph.DecodeGraphReceipt(ctx, outcome.Receipt)
+	if err != nil {
+		return 0, errors.Join(ErrPostEffectReceipt, err)
+	}
+	issue, exists := facts.Creates[id]
+	if facts.Repository != repository || facts.Actor != s.Actor || !exists || len(facts.Creates) != 1 || len(facts.Edits) != 0 ||
+		issue.IssueID <= 0 || issue.IssueIndex <= 0 || issue.ContentVersion < 0 {
+		return 0, ErrPostEffectReceipt
+	}
+	return issue.IssueIndex, nil
+}
+
+func (s *PostIssueEffects) CreatePostIssue(ctx context.Context, draft factory.IssueDraft, repository int64) (int64, error) {
+	if err := draft.Validate(); err != nil {
+		return 0, err
+	}
+	post, _, err := s.source(ctx, repository, draft.SourcePost)
+	if err != nil {
+		return 0, err
+	}
+	// Semantic content has one owner; the adapter encodes its actual provider
+	// payload while retaining the exact historical Fountain operation identity.
+	payload, err := s.Graph.EncodeGraph(collaboration.GraphIntent{Creates: []collaboration.GraphCreate{{
+		Key: draft.SourcePost, Title: draft.Title, Body: PostIssueBody(draft),
+	}}}, repository)
+	if err != nil {
+		return 0, err
+	}
+	revision, err := s.current(ctx, post, &draft)
+	if err != nil {
+		return 0, err
+	}
+	generation := factory.IntentGeneration{
+		OperationID: postIssueOperationID(draft.SourcePost), ActorID: s.Actor, NativeRev: revision,
+		AuthRevision: "comment/" + draft.SourcePost + "/r" + strconv.FormatInt(draft.Revision, 10),
+		NotAfter:     time.Now().Add(5 * time.Minute).Unix(), Payload: payload,
+	}
+	outcome, err := s.Graph.SubmitGraph(ctx, generation, repository)
+	if err != nil {
+		return 0, err
+	}
+	return s.receiptIndex(ctx, repository, draft.SourcePost, outcome)
+}
+
+func (s *PostIssueEffects) LookupPostIssue(ctx context.Context, repository int64, id string) (int64, error) {
+	post, _, err := s.source(ctx, repository, id)
+	if err != nil {
+		return 0, err
+	}
+	if _, err = s.current(ctx, post, nil); err != nil {
+		return 0, err
+	}
+	lookup, err := s.Graph.LookupGraph(ctx, factory.IntentGeneration{OperationID: postIssueOperationID(id), ActorID: s.Actor}, repository)
+	if err != nil {
+		return 0, err
+	}
+	var issue int64
+	switch {
+	case lookup.State == collaboration.LookupNotObserved && lookup.Record == nil:
+		// Only confirmed absence allows the driver to attempt this same operation.
+	case lookup.State == collaboration.LookupFound && lookup.Record != nil:
+		issue, err = s.receiptIndex(ctx, repository, id, *lookup.Record)
+	default:
+		err = ErrPostEffectUnknown
+	}
+	if err != nil {
+		return 0, err
+	}
+	if _, err = s.current(ctx, post, nil); err != nil {
+		return 0, err
+	}
+	return issue, nil
+}
+
+func (s *PostIssueEffects) DeliverPostFeedback(ctx context.Context, comment store.FeedPostDetail, issue int64) error {
+	post, _, err := s.source(ctx, comment.Record.Repository, comment.Record.ID)
+	if err != nil {
+		return err
+	}
+	if issue <= 0 || post.Record != comment.Record || post.Body != comment.Body {
+		return ErrPostEffectSource
+	}
+	writer, ok := s.Graph.(interface {
+		DeliverIssueFeedback(context.Context, int64, int64, int64, string, string) error
+	})
+	if !ok {
+		return ErrPostEffectUnavailable
+	}
+	if _, err := s.current(ctx, post, nil); err != nil {
+		return err
+	}
+	marker := "<!-- soda-feed:" + post.Record.ID + ":r" + strconv.FormatInt(post.Record.Revision, 10) + " -->"
+	body := "Feedback from @" + post.AuthorName + " in the project feed:\n\n" + post.Body
+	return writer.DeliverIssueFeedback(ctx, post.Record.Repository, issue, s.Actor, marker, body)
+}
diff --git a/internal/factory/service/post_judgment.go b/internal/factory/service/post_judgment.go
new file mode 100644
index 0000000000000000000000000000000000000000..8991032c89b3e8b8625ffe271ddfb7d7c5094a08
--- /dev/null
+++ b/internal/factory/service/post_judgment.go
@@ -0,0 +1,46 @@
+package service
+
+import (
+	"context"
+
+	"github.com/levitateos/sodaos/internal/factory"
+	"github.com/levitateos/sodaos/internal/factory/control"
+)
+
+// ChoicePostJudge translates the post-routing policy through the same Choice
+// port used by contribution reviews. Transport, model and credentials belong to
+// its supplied chooser. A routing answer grants no authority or dispatch.
+type ChoicePostJudge struct{ Chooser control.ProductJudgment }
+
+func (j *ChoicePostJudge) JudgePost(ctx context.Context, input PostJudgeInput) (PostJudgment, error) {
+	var empty PostJudgment
+	if j == nil || j.Chooser == nil {
+		return empty, control.ErrPriorityUnavailable
+	}
+	keys := PostChoiceKeys(input.Candidates)
+	choices := make(map[string]any, len(keys))
+	for _, key := range keys {
+		switch key {
+		case factory.PostRouteNewIssue:
+			choices[key] = "A concrete new deliverable or change that no listed issue already covers."
+		case factory.PostRouteDiscussion:
+			choices[key] = "Conversation or acknowledgement without a request to change the product."
+		default:
+			if question, ok := PostClarificationQuestion(key); ok {
+				choices[key] = "The comment requires an answer to: " + question
+			} else {
+				choices[key] = "Continue the specific listed issue only if its objective covers this requested result."
+			}
+		}
+	}
+	answer, err := j.Chooser.Select(ctx, PostJudgeState(input), PostRouteRubric, choices)
+	if err != nil {
+		return empty, err
+	}
+	judgment, err := PostJudgmentFromSelection(answer.Selected, input.Candidates)
+	if err != nil {
+		return empty, err
+	}
+	judgment.Routing = PostRouting(answer, keys, input.Candidates)
+	return judgment, nil
+}
diff --git a/internal/factory/service/post_pipeline.go b/internal/factory/service/post_pipeline.go
new file mode 100644
index 0000000000000000000000000000000000000000..9760cbdddfb05e491e2b9714445879e385a07010
--- /dev/null
+++ b/internal/factory/service/post_pipeline.go
@@ -0,0 +1,482 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"time"
+
+	"github.com/levitateos/sodaos/internal/factory"
+	"github.com/levitateos/sodaos/internal/store"
+)
+
+// ErrPostDraftPending keeps an admitted planning attempt pending without spending another attempt.
+var ErrPostDraftPending = errors.New("comment planning run still settling")
+
+// PostDraftPending supplies retained authoring progress from a planning adapter.
+type PostDraftPending struct{ Progress factory.PostAuthoring }
+
+func (e *PostDraftPending) Error() string { return e.Progress.Detail }
+func (e *PostDraftPending) Unwrap() error { return ErrPostDraftPending }
+
+// ErrPostIssueContext reports unavailable current repository context without consuming a judgment attempt.
+var ErrPostIssueContext = errors.New("Refresh this request to read its issues using your current repository access.")
+
+const PostStalledContext = "context"
+
+// PostStalled names a missing collaborator for the next admitted stage.
+func PostStalled(pipe factory.PostIntake, wired *PostCollaborators) string {
+	if wired == nil {
+		wired = &PostCollaborators{}
+	}
+	switch {
+	case pipe.AdmitPostJudgment() && wired.Judge == nil:
+		return "jev"
+	case pipe.AdmitPostDraft() && wired.Drafter == nil:
+		return "product_lead"
+	case pipe.AdmitPostEffect() && wired.Creator == nil:
+		return "forge"
+	}
+	return ""
+}
+
+// PostBody hides the text of closed sources while keeping their
+// tombstone resolvable.
+func PostBody(detail store.FeedPostDetail) string {
+	if detail.Record.Deleted || detail.Record.Revoked {
+		return ""
+	}
+	return detail.Body
+}
+
+// DrivePostIntake advances one durable comment request through
+// judgment, draft and native effect, reloading after every step so a
+// concurrent advance wins honestly through CAS instead of being
+// dropped. Each stage checks its own admission; a refused stage waits
+// in pending without spending.
+func DrivePostIntake(ctx context.Context, st *store.Store, wired *PostCollaborators, id string) (factory.PostResponse, error) {
+	var empty factory.PostResponse
+	if st == nil {
+		return empty, errors.New("comment store is unavailable")
+	}
+	// One drive flows a fresh submission through every wired stage
+	// but consumes at most one attempt per stage: a failed call waits
+	// for the next replay instead of burning the bounded retries in one
+	// request. A concurrent advance wins honestly through CAS; the
+	// response below always reloads stored truth.
+	for range 8 {
+		pipe, err := st.PostIntake(ctx, id)
+		if err != nil {
+			return empty, err
+		}
+		detail, err := st.FeedPost(ctx, id)
+		if err != nil {
+			return empty, err
+		}
+		if detail.Record.Deleted || detail.Record.Revoked {
+			// The write path already settles the effect as blocked;
+			// report the stored states without spending anything.
+			return PostResponse(pipe), nil
+		}
+		if detail.Source != nil && detail.Source.Product != nil && pipe.Judgment == factory.PostJudgmentApplied && pipe.Route == factory.PostRouteNewIssue {
+			// Product revisions enter the existing explicit review/adoption
+			// owner. Creating a detached issue here would duplicate its graph.
+			return PostResponse(pipe), nil
+		}
+		if pipe.Judgment == factory.PostJudgmentApplied && pipe.Route == factory.PostRouteNewIssue {
+			captured, err := st.PostUsesIssueMaker(ctx, id, pipe.Revision)
+			if err != nil {
+				return empty, err
+			}
+			if captured {
+				if wired == nil || wired.IssueMaker == nil {
+					_ = st.NotePostProgress(ctx, id, "Issue Maker is unavailable. Restore its connection to continue this saved request.")
+					return PostResponse(pipe), nil
+				}
+				return wired.IssueMaker(ctx, pipe, detail)
+			}
+		}
+		var advanced bool
+		switch {
+		case pipe.AdmitPostJudgment() && wired != nil && wired.Judge != nil:
+			advanced, err = drivePostJudgment(ctx, st, wired, pipe, detail)
+		case pipe.AdmitPostDraft() && wired != nil && wired.Drafter != nil:
+			advanced, err = drivePostDraft(ctx, st, wired.Drafter, pipe, detail)
+		case pipe.AdmitPostEffect() && wired != nil && wired.Creator != nil:
+			advanced, err = DrivePostEffect(ctx, st, wired.Creator, pipe, detail)
+		case pipe.Route == factory.PostRouteExistingWork && pipe.Judgment == factory.PostJudgmentApplied && pipe.Effect == factory.PostEffectPending && pipe.Attempts < factory.PostAttemptLimit && wired != nil:
+			advanced, err = drivePostFeedback(ctx, st, wired.Creator, pipe, detail)
+		default:
+			return PostResponse(pipe), nil
+		}
+		if err != nil {
+			// A concurrent advance wins honestly: report its stored
+			// outcome instead of failing the replay.
+			if errors.Is(err, store.ErrStaleRevision) {
+				fresh, reloadErr := st.PostIntake(ctx, id)
+				if reloadErr != nil {
+					return empty, reloadErr
+				}
+				return PostResponse(fresh), nil
+			}
+			return empty, err
+		}
+		if !advanced {
+			fresh, err := st.PostIntake(ctx, id)
+			if err != nil {
+				return empty, err
+			}
+			return PostResponse(fresh), nil
+		}
+	}
+	pipe, err := st.PostIntake(ctx, id)
+	if err != nil {
+		return empty, err
+	}
+	return PostResponse(pipe), nil
+}
+
+// postCandidateLimit bounds the existing-work candidates one
+// routing judgment may weigh.
+const postCandidateLimit = 8
+
+// CollectPostJudgeInput assembles one judgment's complete input
+// from recorded state: the comment with its persisted source
+// snapshot, its reply parent's recorded evidence, and the
+// existing-work candidates merged bound-first (bound issue scope,
+// source snapshot, reply parent, recent repository work), deduped by
+// issue with recorded summaries filled from whichever origin has
+// them. A failed recent-work read fails the judgment instead of
+// routing blind; an unreadable or closed parent simply contributes
+// no evidence.
+func CollectPostJudgeInput(ctx context.Context, st *store.Store, detail store.FeedPostDetail) (PostJudgeInput, error) {
+	input := PostJudgeInput{SourcePost: detail}
+	recent, err := st.RecentPostWorkCandidates(ctx, detail.Record.Repository, postCandidateLimit)
+	if err != nil {
+		return PostJudgeInput{}, err
+	}
+	byIssue := map[int64]*factory.PostWorkCandidate{}
+	var ordered []*factory.PostWorkCandidate
+	add := func(candidate factory.PostWorkCandidate) {
+		if candidate.Issue <= 0 {
+			return
+		}
+		if existing, ok := byIssue[candidate.Issue]; ok {
+			if existing.Summary == "" {
+				existing.Summary = candidate.Summary
+			}
+			if existing.Status == "" {
+				existing.Status = candidate.Status
+			}
+			return
+		}
+		merged := candidate
+		byIssue[candidate.Issue] = &merged
+		ordered = append(ordered, &merged)
+	}
+	if detail.Record.Issue > 0 {
+		add(factory.PostWorkCandidate{Issue: detail.Record.Issue, Origin: factory.PostCandidateBound})
+	}
+	if detail.Source != nil && detail.Source.Issue > 0 {
+		add(factory.PostWorkCandidate{
+			Issue: detail.Source.Issue, Summary: detail.Source.Summary,
+			Status: detail.Source.Status, Origin: factory.PostCandidateSource,
+		})
+	}
+	if detail.Record.ParentID != "" {
+		parent := &PostParentEvidence{SourcePost: detail.Record.ParentID}
+		if parentDetail, err := st.FeedPost(ctx, detail.Record.ParentID); err == nil &&
+			parentDetail.Record.Repository == detail.Record.Repository &&
+			!parentDetail.Record.Deleted && !parentDetail.Record.Revoked {
+			parent.Body = store.TruncateFeedSummary(parentDetail.Body)
+			parent.Issue = parentDetail.Record.Issue
+		}
+		if parentPipe, err := st.PostIntake(ctx, detail.Record.ParentID); err == nil && parent.Issue <= 0 {
+			parent.Issue = parentPipe.Issue
+		}
+		input.Parent = parent
+		if parent.Issue > 0 {
+			add(factory.PostWorkCandidate{Issue: parent.Issue, Origin: factory.PostCandidateParent})
+		}
+	}
+	for _, candidate := range recent {
+		add(candidate)
+	}
+	for _, candidate := range ordered {
+		if err := candidate.Validate(); err != nil {
+			return PostJudgeInput{}, err
+		}
+		input.Candidates = append(input.Candidates, *candidate)
+		if len(input.Candidates) == postCandidateLimit {
+			break
+		}
+	}
+	return input, nil
+}
+
+// applyPostJudgment advances one pipeline with a settled routing
+// outcome. An existing_work judgment persists which work it selected
+// in the pipeline's issue link; every other route clears it.
+func drivePostFeedback(ctx context.Context, st *store.Store, creator PostIssueCreator, pipe factory.PostIntake, detail store.FeedPostDetail) (bool, error) {
+	requested, err := st.PostFeedbackRequested(ctx, pipe.SourcePost, pipe.Revision)
+	if err != nil || !requested {
+		return false, err
+	}
+	writer, ok := creator.(interface {
+		DeliverPostFeedback(context.Context, store.FeedPostDetail, int64) error
+	})
+	if !ok {
+		_ = st.NotePostProgress(ctx, pipe.SourcePost, "Feedback delivery is unavailable. Restore Factory’s connection before retrying.")
+		return false, nil
+	}
+	if err = writer.DeliverPostFeedback(ctx, detail, pipe.Issue); err != nil {
+		_ = st.NotePostProgress(ctx, pipe.SourcePost, "Could not confirm delivery to the issue discussion. Check repository access and refresh before retrying.")
+		return false, notePostFailure(ctx, st, pipe, false)
+	}
+	next := pipe
+	next.Effect = factory.PostEffectApplied
+	if err = st.AdvancePostIntake(ctx, pipe, next); err != nil {
+		return false, err
+	}
+	_ = st.NotePostProgress(ctx, pipe.SourcePost, "Feedback added to the issue discussion. Accepted requirements have not been changed.")
+	return true, nil
+}
+
+func applyPostJudgment(ctx context.Context, st *store.Store, pipe factory.PostIntake, judgment PostJudgment) error {
+	next := pipe
+	next.Judgment = factory.PostJudgmentApplied
+	next.Route = judgment.Route
+	next.Issue = 0
+	if judgment.Route == factory.PostRouteExistingWork {
+		next.Issue = judgment.Issue
+	}
+	if err := st.AdvancePostIntake(ctx, pipe, next); err != nil {
+		return err
+	}
+	if judgment.Route == factory.PostRouteNewIssue {
+		_ = st.NotePostAuthoring(ctx, pipe.SourcePost, pipe.Revision, factory.PostAuthoring{State: factory.PostAuthoringQueued, Detail: "JEV identified new work. Waiting for the Product Lead to prepare the issue."}, time.Now().Unix())
+	}
+	if judgment.Routing != nil {
+		if err := st.NotePostRouting(ctx, pipe.SourcePost, *judgment.Routing); err != nil {
+			return err
+		}
+	}
+	if judgment.Route == factory.PostRouteClarify {
+		question := judgment.Question
+		if question == "" {
+			question = postClarificationQuestions["clarify_result"]
+		}
+		return st.NotePostProgress(ctx, pipe.SourcePost, question)
+	}
+	return nil
+}
+
+// drivePostJudgment routes one comment with one JEV Choice and stores
+// the answer on the request row. A failed call retries on a later pass,
+// bounded by the attempt count.
+func drivePostJudgment(ctx context.Context, st *store.Store, wired *PostCollaborators, pipe factory.PostIntake, detail store.FeedPostDetail) (bool, error) {
+	// Gathering context reads this server and Forge only; a failure there
+	// (Forge restarting, say) spends no JEV attempt. The request waits
+	// with the reason visible and the next pass reads again.
+	input, err := CollectPostJudgeInput(ctx, st, detail)
+	if err != nil {
+		_ = st.NotePostProgress(ctx, pipe.SourcePost, "The original request context could not be read yet. It is read again shortly.")
+		return false, nil
+	}
+	if wired.Prepare != nil {
+		if input, err = wired.Prepare(ctx, input); err != nil {
+			_ = st.NotePostProgress(ctx, pipe.SourcePost, err.Error())
+			stall := ""
+			if errors.Is(err, ErrPostIssueContext) {
+				stall = PostStalledContext
+			}
+			_ = st.NotePostStall(ctx, pipe.SourcePost, stall)
+			return false, nil
+		}
+	}
+	_ = st.NotePostStall(ctx, pipe.SourcePost, "")
+	judgment, err := wired.Judge.JudgePost(ctx, input)
+	if err != nil {
+		_ = st.NotePostProgress(ctx, pipe.SourcePost, "JEV could not assess this request. Check the System One connection and retry assessment.")
+		return false, notePostFailure(ctx, st, pipe, true)
+	}
+	switch judgment.Route {
+	case factory.PostRouteNewIssue, factory.PostRouteDiscussion, factory.PostRouteClarify:
+		if judgment.Issue != 0 {
+			return false, notePostFailure(ctx, st, pipe, true)
+		}
+	case factory.PostRouteExistingWork:
+		if _, err := PostJudgmentFromSelection(postExistingChoice(judgment.Issue), input.Candidates); err != nil {
+			return false, notePostFailure(ctx, st, pipe, true)
+		}
+	default:
+		return false, notePostFailure(ctx, st, pipe, true)
+	}
+	if err := applyPostJudgment(ctx, st, pipe, judgment); err != nil {
+		return false, err
+	}
+	return true, nil
+}
+
+// drivePostDraft runs one Product Lead LLM authoring call for a
+// new_issue route. A malformed draft settles the draft as invalid
+// before any native effect; a failed call keeps its attempt for retry.
+func drivePostDraft(ctx context.Context, st *store.Store, drafter PostDrafter, pipe factory.PostIntake, detail store.FeedPostDetail) (bool, error) {
+	draft, err := drafter.DraftPostIssue(ctx, detail)
+	if err != nil {
+		var pending *PostDraftPending
+		if errors.As(err, &pending) {
+			_ = st.NotePostAuthoring(ctx, pipe.SourcePost, pipe.Revision, pending.Progress, time.Now().Unix())
+		} else if ctx.Err() == nil {
+			state := factory.PostAuthoringFailed
+			if errors.Is(err, ErrPostDraftPending) {
+				state = factory.PostAuthoringUnknown
+			}
+			_ = st.NotePostAuthoring(ctx, pipe.SourcePost, pipe.Revision, factory.PostAuthoring{State: state, Detail: err.Error()}, time.Now().Unix())
+		}
+		// A launched planning run that is still settling — or a drive
+		// interrupted by service shutdown — is not an authoring
+		// failure: the draft stays pending with its bounded attempts
+		// intact and the next service pass resumes the same funded
+		// attempt instead of spending again.
+		if errors.Is(err, ErrPostDraftPending) || ctx.Err() != nil {
+			_ = st.NotePostProgress(ctx, pipe.SourcePost, err.Error())
+			return false, nil
+		}
+		_ = st.NotePostProgress(ctx, pipe.SourcePost, err.Error())
+		return false, notePostFailure(ctx, st, pipe, false)
+	}
+	draft.SourcePost = pipe.SourcePost
+	draft.Revision = pipe.Revision
+	if err := st.RecordPostDraft(ctx, draft); err != nil {
+		if !errors.Is(err, store.ErrInvalidPostDraft) {
+			return false, err
+		}
+		next := pipe
+		next.Draft = factory.PostDraftInvalid
+		next.Effect = factory.PostEffectBlocked
+		if advanceErr := st.AdvancePostIntake(ctx, pipe, next); advanceErr != nil {
+			return false, advanceErr
+		}
+		return true, nil
+	}
+	next := pipe
+	next.Draft = factory.PostDraftApplied
+	if err := st.AdvancePostIntake(ctx, pipe, next); err != nil {
+		return false, err
+	}
+	return true, nil
+}
+
+// DrivePostEffect creates the native issue behind an applied draft.
+// It reconciles first: an issue already created from this comment (lost
+// effect reply) settles without duplicating, and the graph operation is
+// idempotent. The draft must still bind the current source revision. An
+// unavailable lookup is unknown and cannot authorize another creation.
+func DrivePostEffect(ctx context.Context, st *store.Store, creator PostIssueCreator, pipe factory.PostIntake, detail store.FeedPostDetail) (bool, error) {
+	if st == nil || creator == nil {
+		return false, errors.New("post issue creator is unavailable")
+	}
+	if detail.Record.Revision != pipe.Revision {
+		return false, nil
+	}
+	draft, err := st.PostDraft(ctx, pipe.SourcePost, pipe.Revision)
+	if err != nil {
+		return false, notePostFailure(ctx, st, pipe, false)
+	}
+	issue, err := creator.LookupPostIssue(ctx, detail.Record.Repository, pipe.SourcePost)
+	if err == nil && issue <= 0 {
+		issue, err = creator.CreatePostIssue(ctx, draft, detail.Record.Repository)
+	}
+	if err != nil || issue <= 0 {
+		_ = st.NotePostProgress(ctx, pipe.SourcePost, "Could not confirm issue creation. Retry checks for an existing issue before creating one.")
+		return false, notePostFailure(ctx, st, pipe, false)
+	}
+	next := pipe
+	next.Effect = factory.PostEffectVerified
+	next.Issue = issue
+	if err := st.AdvancePostIntake(ctx, pipe, next); err != nil {
+		return false, err
+	}
+	return true, nil
+}
+
+// notePostFailure records one retry attempt; when the bounded
+// attempts run out the open stage settles honestly (judgment failed,
+// otherwise the draft/effect stays retryable only while attempts
+// remain, and the caller sees pending until then).
+func notePostFailure(ctx context.Context, st *store.Store, pipe factory.PostIntake, failJudgment bool) error {
+	if err := st.NotePostAttempt(ctx, pipe.SourcePost); err != nil {
+		if failJudgment {
+			next := pipe
+			next.Judgment = factory.PostJudgmentFailed
+			_ = st.AdvancePostIntake(ctx, pipe, next)
+		}
+		return nil
+	}
+	fresh, err := st.PostIntake(ctx, pipe.SourcePost)
+	if err != nil {
+		return err
+	}
+	if fresh.Attempts < factory.PostAttemptLimit {
+		return nil
+	}
+	next := fresh
+	if failJudgment && next.Judgment == factory.PostJudgmentPending {
+		next.Judgment = factory.PostJudgmentFailed
+	}
+	if advanceErr := st.AdvancePostIntake(ctx, fresh, next); advanceErr != nil {
+		return advanceErr
+	}
+	return nil
+}
+
+// postExistingIssue names the already-tracked issue one pipeline
+// linked on the existing_work route, zero on every other route.
+func PostExistingIssue(pipe factory.PostIntake) int64 {
+	if pipe.Route == factory.PostRouteExistingWork {
+		return pipe.Issue
+	}
+	return 0
+}
+
+// PostResponse renders one stored pipeline row as the POST answer.
+func PostResponse(pipe factory.PostIntake) factory.PostResponse {
+	return factory.PostResponse{
+		Attempts: pipe.Attempts, AttemptLimit: factory.PostAttemptLimit,
+		SourcePost: pipe.SourcePost, Revision: pipe.Revision, Intake: pipe.Intake,
+		Judgment: pipe.Judgment, Route: pipe.Route, Draft: pipe.Draft,
+		Effect: pipe.Effect, Issue: pipe.Issue, ExistingIssue: PostExistingIssue(pipe),
+	}
+}
+
+// PostDriveLimit bounds the stored comment requests one service
+// pass advances: authoring and native effects are expensive, and the
+// coordinator pass must stay responsive to factory work.
+const PostDriveLimit = 4
+
+// DrivePendingPosts advances one bounded page of durable comment
+// requests through their wired stages and reports how many drove
+// without error. Per-request failures keep their stored state for a
+// later pass; exactly-once advancement rests on the pipeline CAS, the
+// single funded planning attempt and the deterministic native operation
+// identity.
+func DrivePendingPosts(ctx context.Context, st *store.Store, wired *PostCollaborators, limit int) int {
+	if st == nil {
+		return 0
+	}
+	pending, err := st.PendingPostIntakes(ctx, limit)
+	if err != nil {
+		return 0
+	}
+	driven := 0
+	for _, pipe := range pending {
+		if ctx.Err() != nil {
+			break
+		}
+		_ = st.NotePostProgress(ctx, pipe.SourcePost, "")
+		if _, err := DrivePostIntake(ctx, st, wired, pipe.SourcePost); err == nil {
+			driven++
+		}
+	}
+	return driven
+}
diff --git a/internal/factory/service/post_routing.go b/internal/factory/service/post_routing.go
new file mode 100644
index 0000000000000000000000000000000000000000..1e9215b51735b95e8e6204ce9c88d912cd5dabce
--- /dev/null
+++ b/internal/factory/service/post_routing.go
@@ -0,0 +1,214 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strconv"
+	"strings"
+
+	"github.com/levitateos/sodaos/internal/factory"
+	"github.com/levitateos/sodaos/internal/store"
+)
+
+// Feed comment backend (R32.2/R32.14): one comment POST persists the
+// comment identity, revision and scope plus its durable intake request
+// and answers promptly with the stored pipeline states. The funded JEV
+// routing, Product Lead LLM draft and native effect advance
+// service-side behind the stored request rows (DrivePendingPosts,
+// bound to the coordinator lifecycle), never inside the browser
+// request: a request that times out or a service that restarts resumes
+// the same stored request exactly once, and the comment GET re-reads
+// the settled outcome. Unwired stages wait truthfully in pending:
+// nothing spends and nothing dispatches without its collaborator.
+// Reads never drive: GET serves stored state only. No per-comment
+// approvals exist; a discussion route only ever records discussion.
+
+// PostJudgment is one routing outcome: the assessed route plus,
+// for existing_work, the already-tracked issue the judgment selected.
+type PostJudgment struct {
+	Route    string
+	Issue    int64
+	Question string
+	// Routing is the Choice behind this outcome, kept for the feed.
+	Routing *factory.PostRouting
+}
+
+// postRoutingLabels names the base routing options for people.
+var postRoutingLabels = map[string]string{
+	factory.PostRouteNewIssue:   "New work",
+	factory.PostRouteDiscussion: "Just discussion",
+	"clarify_target":            "Ask which app or issue",
+	"clarify_result":            "Ask what the result should be",
+	"clarify_conflict":          "Ask which requirement wins",
+}
+
+// PostRouting records one routing answer with every offered option.
+func PostRouting(answer factory.PriorityAnswer, keys []string, candidates []factory.PostWorkCandidate) *factory.PostRouting {
+	labels := make(map[string]string, len(keys))
+	for key, label := range postRoutingLabels {
+		labels[key] = label
+	}
+	for _, candidate := range candidates {
+		label := fmt.Sprintf("Issue #%d", candidate.Issue)
+		if name := strings.TrimSpace(candidate.Title); name != "" {
+			label += " · " + name
+		} else if objective := strings.TrimSpace(candidate.Objective); objective != "" {
+			label += " · " + objective
+		}
+		labels[postExistingChoice(candidate.Issue)] = store.TruncateFeedSummary(label)
+	}
+	routing := &factory.PostRouting{Selected: answer.Selected, Confidence: answer.Confidence}
+	for _, key := range keys {
+		routing.Options = append(routing.Options, factory.PostRoutingOption{
+			Key: key, Label: labels[key], Probability: answer.Probabilities[key],
+		})
+	}
+	return routing
+}
+
+var postClarificationQuestions = map[string]string{
+	"clarify_target":   "Which app, page, or existing issue should this request apply to?",
+	"clarify_result":   "What should change, and what should the result look like?",
+	"clarify_conflict": "Which of the conflicting requirements should take precedence?",
+}
+
+// PostParentEvidence carries the recorded reply-parent facts one
+// judgment may weigh: the parent comment identity, a bounded preview
+// of its stored text and the native issue its own pipeline linked.
+type PostParentEvidence struct {
+	SourcePost string
+	Body       string
+	Issue      int64
+}
+
+// PostJudgeInput carries everything one routing judgment may
+// weigh: the comment with its persisted source snapshot, its reply
+// parent's recorded evidence, and the existing-work candidates.
+type PostJudgeInput struct {
+	SourcePost store.FeedPostDetail
+	Parent     *PostParentEvidence
+	Candidates []factory.PostWorkCandidate
+}
+
+// PostJudge routes one comment through one JEV Choice.
+type PostJudge interface {
+	JudgePost(ctx context.Context, input PostJudgeInput) (PostJudgment, error)
+}
+
+// PostDrafter authors one issue draft from a comment through the
+// Product Lead LLM: title, body, objective and acceptance plus the Soda
+// work metadata the native creation validates.
+type PostDrafter interface {
+	DraftPostIssue(ctx context.Context, comment store.FeedPostDetail) (factory.IssueDraft, error)
+}
+
+// PostIssueCreator validates and creates native issues from drafts
+// through the existing native issue/graph ops, and looks up the issue
+// already created from a comment so a lost effect reply reconciles
+// instead of duplicating.
+type PostIssueCreator interface {
+	CreatePostIssue(ctx context.Context, draft factory.IssueDraft, repository int64) (int64, error)
+	LookupPostIssue(ctx context.Context, repository int64, postID string) (int64, error)
+}
+
+// PostCollaborators carries the wired Lane B stages. Nil stages wait
+// in pending; the driver never spends or dispatches through a nil.
+type PostCollaborators struct {
+	IssueMaker func(context.Context, factory.PostIntake, store.FeedPostDetail) (factory.PostResponse, error)
+	Judge      PostJudge
+	// Prepare adds the native issue context the judge weighs.
+	Prepare func(context.Context, PostJudgeInput) (PostJudgeInput, error)
+	Drafter PostDrafter
+	Creator PostIssueCreator
+}
+
+// postRouteRubric is the single JEV Choice rubric behind comment
+// routing: code supplies the complete comment state — body, bound
+// issue scope, resolved source snapshot, reply-parent evidence and
+// the existing-work candidates — and the explicit outcomes.
+const PostRouteRubric = "Route one feed comment to exactly one outcome: " +
+	"new_issue when it requests a concrete change that needs new tracked work; " +
+	"existing_<issue> for one listed candidate when the comment belongs to that already tracked work; " +
+	"discussion when it is an acknowledgement or discussion that must never create an issue; " +
+	"clarify_target when the target is ambiguous, clarify_result when the desired result is unclear, or clarify_conflict when requirements conflict. " +
+	"Match the requested deliverable against actual issue objectives. Project membership, recent activity, generic worker status, or being a reply do not establish an objective match. " +
+	"Use existing work for the same deliverable or a correction of that deliverable; a distinct requested change needs new work even when the comment replies to an older post."
+
+// postExistingChoice names the Choice key selecting one
+// existing-work candidate issue.
+func postExistingChoice(issue int64) string {
+	return "existing_" + strconv.FormatInt(issue, 10)
+}
+
+// PostChoiceKeys lists the admitted Choice keys for one judgment:
+// the three base routes plus one key per existing-work candidate.
+// With no candidates there is no existing-work key to select, so a
+// comment can never be routed to work the server never listed.
+func PostChoiceKeys(candidates []factory.PostWorkCandidate) []string {
+	keys := []string{factory.PostRouteNewIssue, factory.PostRouteDiscussion, "clarify_target", "clarify_result", "clarify_conflict"}
+	for _, candidate := range candidates {
+		keys = append(keys, postExistingChoice(candidate.Issue))
+	}
+	return keys
+}
+
+// PostJudgmentFromSelection parses one recorded Choice selection
+// into its route and selected issue. Only selections the choice
+// actually offered admit: an existing-work key outside the candidate
+// set refuses instead of linking unlisted work.
+func PostJudgmentFromSelection(selected string, candidates []factory.PostWorkCandidate) (PostJudgment, error) {
+	if question, ok := postClarificationQuestions[selected]; ok {
+		return PostJudgment{Route: factory.PostRouteClarify, Question: question}, nil
+	}
+	if selected == factory.PostRouteNewIssue || selected == factory.PostRouteDiscussion {
+		return PostJudgment{Route: selected}, nil
+	}
+	for _, candidate := range candidates {
+		if selected == postExistingChoice(candidate.Issue) {
+			return PostJudgment{Route: factory.PostRouteExistingWork, Issue: candidate.Issue}, nil
+		}
+	}
+	return PostJudgment{}, errors.New("comment judgment selected an outcome it was never offered")
+}
+
+// PostJudgeState renders the complete supplied state for one
+// routing Choice: the comment, its persisted source snapshot, its
+// reply parent's recorded evidence and the existing-work candidates.
+func PostJudgeState(input PostJudgeInput) map[string]any {
+	comment := input.SourcePost
+	state := map[string]any{
+		"repository": comment.Record.Repository, "issue": comment.Record.Issue,
+		"parent_id": comment.Record.ParentID, "body": comment.Body,
+	}
+	if comment.Source != nil {
+		state["source"] = map[string]any{
+			"kind": comment.Source.Kind, "id": comment.Source.ID,
+			"issue": comment.Source.Issue, "pr": comment.Source.PR,
+			"ref": comment.Source.Ref, "status": comment.Source.Status,
+			"summary": comment.Source.Summary,
+		}
+	}
+	if input.Parent != nil {
+		state["parent"] = map[string]any{
+			"comment": input.Parent.SourcePost, "body": input.Parent.Body,
+			"issue": input.Parent.Issue,
+		}
+	}
+	candidates := make([]map[string]any, 0, len(input.Candidates))
+	for _, candidate := range input.Candidates {
+		candidates = append(candidates, map[string]any{
+			"issue": candidate.Issue, "summary": candidate.Summary,
+			"status": candidate.Status, "origin": candidate.Origin,
+			"title": candidate.Title, "objective": candidate.Objective, "execution_status": candidate.WorkerStatus,
+		})
+	}
+	state["candidates"] = candidates
+	return state
+}
+
+// PostClarificationQuestion supplies the routing policy wording to model adapters.
+func PostClarificationQuestion(key string) (string, bool) {
+	question, ok := postClarificationQuestions[key]
+	return question, ok
+}
diff --git a/internal/factory/service/post_views.go b/internal/factory/service/post_views.go
new file mode 100644
index 0000000000000000000000000000000000000000..0e4837e78ae41b82e33dbd3756b6477291080035
--- /dev/null
+++ b/internal/factory/service/post_views.go
@@ -0,0 +1,276 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"strconv"
+	"time"
+
+	"github.com/levitateos/sodaos/internal/collaboration"
+	"github.com/levitateos/sodaos/internal/factory"
+	"github.com/levitateos/sodaos/internal/store"
+)
+
+// PostVisibility checks current access for the admitted canonical actor.
+// Every served post/reply, including repeated repository scopes, is checked.
+type PostVisibility func(context.Context, collaboration.ActorID, int64) error
+
+type Posts struct {
+	Store         *store.Store
+	Visibility    PostVisibility
+	WriteAccess   RequestWriteAccess
+	Collaborators *PostCollaborators
+}
+
+var (
+	ErrPostNotFound        = errors.New("post is not available")
+	ErrPostViewUnavailable = errors.New("post view is unavailable")
+	ErrPostVisibility      = errors.New("post repository is not visible")
+	ErrPostRepliesInvalid  = errors.New("invalid conversation scope or cursor")
+	ErrPostProductNotFound = errors.New("product change is not available")
+)
+
+type PostReplies struct {
+	Items      []map[string]any `json:"items"`
+	NextBefore int64            `json:"next_before"`
+}
+
+func (s Posts) visible(ctx context.Context, actor collaboration.ActorID, repository int64) error {
+	if actor <= 0 {
+		return ErrPostNotFound
+	}
+	if s.Store == nil || s.Visibility == nil {
+		return ErrPostViewUnavailable
+	}
+	if err := s.Visibility(ctx, actor, repository); err != nil {
+		return errors.Join(ErrPostVisibility, err)
+	}
+	return nil
+}
+
+// Read projects stored facts only. It cannot judge, draft, create an issue or
+// dispatch work. Visibility is current even when a caller already read a parent.
+func (s Posts) Read(ctx context.Context, actor collaboration.ActorID, id string) (map[string]any, error) {
+	if actor <= 0 {
+		return nil, ErrPostNotFound
+	}
+	if s.Store == nil || s.Visibility == nil {
+		return nil, ErrPostViewUnavailable
+	}
+	entry, err := s.Store.FeedEntryByID(ctx, id)
+	if errors.Is(err, store.ErrNotFound) {
+		return nil, ErrPostNotFound
+	}
+	if err != nil {
+		return nil, err
+	}
+	if err := s.visible(ctx, actor, entry.Repository); err != nil {
+		return nil, err
+	}
+	if entry.Kind == factory.FeedKindRecord {
+		entries := []factory.FeedEntry{entry}
+		EnrichRecords(ctx, s.Store, nil, entries)
+		EnrichParents(ctx, s.Store, entries)
+		post := entries[0]
+		return map[string]any{"post_id": post.ID, "kind": post.Kind, "repository": strconv.FormatInt(post.Repository, 10), "parent_id": post.ParentID, "parent_author": post.ParentAuthor, "author_name": post.Author, "actor": post.Actor, "at": post.At, "body": post.Summary, "status": post.Status, "issue_scope": post.Issue, "payload": post.Payload, "assignment": post.Assignment}, nil
+	}
+	detail, err := s.Store.FeedPost(ctx, entry.ID)
+	if errors.Is(err, store.ErrNotFound) {
+		return nil, ErrPostNotFound
+	}
+	if err != nil {
+		return nil, err
+	}
+	if detail.Contribution != nil || detail.Consultation != nil || (detail.Payload != nil && detail.Payload.Communication != nil) {
+		return WorkerPostResponse(detail), nil
+	}
+	pipe, err := s.Store.PostIntake(ctx, detail.Record.ID)
+	if err != nil {
+		return nil, err
+	}
+	progress, _ := s.Store.PostProgress(ctx, detail.Record.ID)
+	return s.project(ctx, actor, detail, pipe, progress), nil
+}
+
+func (s Posts) Replies(ctx context.Context, actor collaboration.ActorID, repository int64, parent string, before int64) (PostReplies, error) {
+	var empty PostReplies
+	if repository <= 0 || before < 0 {
+		return empty, ErrPostRepliesInvalid
+	}
+	if err := s.visible(ctx, actor, repository); err != nil {
+		return empty, err
+	}
+	source, err := s.Store.ResolvePostParent(ctx, repository, parent)
+	if errors.Is(err, store.ErrNotFound) {
+		return empty, ErrPostNotFound
+	}
+	if err != nil {
+		return empty, err
+	}
+	ids, next, err := s.Store.FeedReplyIDs(ctx, repository, source.Kind, source.ID, before)
+	if err != nil {
+		return empty, err
+	}
+	result := PostReplies{Items: []map[string]any{}, NextBefore: next}
+	for _, id := range ids {
+		item, err := s.Read(ctx, actor, id)
+		if err != nil {
+			return empty, err
+		}
+		result.Items = append(result.Items, item)
+	}
+	return result, nil
+}
+
+// ReviewProduct opens the source-bound draft through the existing store CAS.
+// Current repository write authority and private intent ownership are separate
+// prerequisites. This handoff does not accept, generate or execute work.
+func (s Posts) ReviewProduct(ctx context.Context, actor collaboration.ActorID, id string, revision int64) (map[string]any, error) {
+	if actor <= 0 {
+		return nil, ErrPostProductNotFound
+	}
+	if s.Store == nil || s.Visibility == nil {
+		return nil, ErrPostViewUnavailable
+	}
+	detail, err := s.Store.FeedPost(ctx, id)
+	if errors.Is(err, store.ErrNotFound) {
+		return nil, ErrPostProductNotFound
+	}
+	if err != nil {
+		return nil, err
+	}
+	if detail.Source == nil || detail.Source.Product == nil {
+		return nil, ErrPostProductNotFound
+	}
+	if err := s.visible(ctx, actor, detail.Record.Repository); err != nil {
+		return nil, err
+	}
+	requests := Requests{Store: s.Store, WriteAccess: s.WriteAccess}
+	if err := requests.authorizeWrite(ctx, actor, detail.Record.Repository); err != nil {
+		return nil, err
+	}
+	if _, err := requests.Revision(ctx, actor, detail.Source.Product.Intent); err != nil {
+		if errors.Is(err, ErrRequestNotFound) {
+			return nil, ErrPostProductNotFound
+		}
+		return nil, err
+	}
+	if _, err := s.Store.ReviewPostProductChange(ctx, id, revision, int64(actor), time.Now().Unix()); err != nil {
+		if errors.Is(err, store.ErrNotFound) {
+			return nil, ErrPostProductNotFound
+		}
+		return nil, err
+	}
+	return s.Read(ctx, actor, id)
+}
+
+func (s Posts) canOpenProduct(ctx context.Context, actor collaboration.ActorID, repository int64, view *store.PostProductChange) bool {
+	if view.State == "accepted" {
+		_, err := (Requests{Store: s.Store}).Revision(ctx, actor, view.Intent)
+		return err == nil
+	}
+	return s.WriteAccess != nil && s.WriteAccess(ctx, actor, repository) == nil
+}
+
+func (s Posts) project(ctx context.Context, actor collaboration.ActorID, detail store.FeedPostDetail, pipe factory.PostIntake, progress string) map[string]any {
+	author := strconv.FormatInt(int64(actor), 10)
+	response := feedPostResponse(detail, pipe, progress, author)
+	if maker, err := s.Store.PostIssueMaker(ctx, detail.Record.ID, pipe.Revision); err == nil {
+		response["issue_maker"] = map[string]any{"post": maker.Scope.Post, "state": maker.State, "detail": maker.Detail, "checked": maker.Checked}
+	} else if pipe.Judgment == factory.PostJudgmentApplied && pipe.Route == factory.PostRouteNewIssue && (detail.Source == nil || detail.Source.Product == nil) {
+		if captured, err := s.Store.PostUsesIssueMaker(ctx, detail.Record.ID, pipe.Revision); err == nil && captured {
+			response["issue_maker"] = map[string]any{"post": "", "state": "queued"}
+		}
+	}
+	if pipe.Route == factory.PostRouteNewIssue && pipe.Draft == factory.PostDraftPending {
+		if authoring, err := s.Store.PostAuthoring(ctx, detail.Record.ID); err == nil && authoring != nil {
+			copy := *authoring
+			if detail.Record.Author != author {
+				copy.Intent = ""
+			}
+			response["authoring"] = copy
+			if copy.State == factory.PostAuthoringWaiting && copy.Run == "" && detail.Record.Author == author {
+				response["can_retry"] = true
+			}
+		}
+	}
+	if pipe.AdmitPostJudgment() && detail.Record.Author == author && !detail.Record.Deleted && !detail.Record.Revoked {
+		if _, err := s.Store.PostIssueContext(ctx, detail.Record.ID, detail.Record.Revision); err != nil {
+			response["stalled"] = PostStalledContext
+			response["can_retry"] = true
+		}
+	}
+	if routing, err := s.Store.PostRouting(ctx, detail.Record.ID); err == nil && routing != nil {
+		response["routing"] = routing
+	}
+	if !detail.Record.Deleted && !detail.Record.Revoked {
+		if stalled := PostStalled(pipe, s.Collaborators); stalled != "" {
+			response["stalled"] = stalled
+		} else if stall, err := s.Store.PostStall(ctx, detail.Record.ID); err == nil && stall != "" && pipe.AdmitPostJudgment() && response["stalled"] == nil {
+			response["stalled"] = stall
+		}
+	}
+	if view, err := s.Store.PostProductChange(ctx, detail, pipe, int64(actor)); err == nil && view != nil {
+		view.CanReview = view.CanReview && s.canOpenProduct(ctx, actor, detail.Record.Repository, view)
+		response["product_change"] = view
+		response["can_retry"] = false
+	} else if err != nil && isPostProductLane(detail, pipe) {
+		// The lane is same-product but the read failed: project the miss
+		// explicitly so the comment never falls back to detached generic
+		// progress that would claim unrelated native work.
+		response["product_change"] = store.UnavailablePostProductChange(detail.Source.Product.Intent, detail.Source.Product.AcceptedRevision)
+		response["can_retry"] = false
+	}
+	return response
+}
+
+// isPostProductLane reports whether the comment sits on the same-product
+// review handoff: an accepted source behind an applied new-issue pipeline
+// with no linked native issue. Only this lane may carry product_change, so
+// only this lane maps a projection error to the explicit unavailable view.
+func isPostProductLane(detail store.FeedPostDetail, pipe factory.PostIntake) bool {
+	return detail.Source != nil && detail.Source.Product != nil &&
+		pipe.Judgment == factory.PostJudgmentApplied && pipe.Route == factory.PostRouteNewIssue && pipe.Issue == 0
+}
+
+func feedPostResponse(detail store.FeedPostDetail, pipe factory.PostIntake, progress, actor string) map[string]any {
+	return map[string]any{
+		"post_id": detail.Record.ID, "revision": detail.Record.Revision,
+		"repository": strconv.FormatInt(detail.Record.Repository, 10), "author": detail.Record.Author,
+		"author_name": detail.AuthorName, "at": detail.At, "issue_scope": detail.Record.Issue,
+		"parent_id": detail.Record.ParentID, "edited": detail.Record.Edited,
+		"deleted": detail.Record.Deleted, "revoked": detail.Record.Revoked,
+		"body": PostBody(detail), "status": store.PostStatus(&pipe),
+		"intake": pipe.Intake, "judgment": pipe.Judgment, "route": pipe.Route,
+		"draft": pipe.Draft, "effect": pipe.Effect, "issue": pipe.Issue,
+		"existing_issue": PostExistingIssue(pipe), "source": detail.Source,
+		"attempts": pipe.Attempts, "attempt_limit": factory.PostAttemptLimit,
+		"detail":    progress,
+		"can_retry": detail.Record.Author == actor && !detail.Record.Deleted && !detail.Record.Revoked && pipe.RetryAllowed(),
+	}
+}
+
+func WorkerPostResponse(detail store.FeedPostDetail) map[string]any {
+	var communication *factory.FeedCommunication
+	if detail.Payload != nil {
+		communication = detail.Payload.Communication
+	}
+	// The retained contribution keeps its int64 scope. Project the HTTP
+	// identity as a string alongside the enclosing post's repository.
+	var contribution any
+	if detail.Contribution != nil {
+		contribution = struct {
+			*factory.ContributionReview
+			Repository string `json:"repository"`
+		}{detail.Contribution, strconv.FormatInt(detail.Contribution.Repository, 10)}
+	}
+	return map[string]any{
+		"post_id": detail.Record.ID, "revision": detail.Record.Revision, "repository": strconv.FormatInt(detail.Record.Repository, 10),
+		"author": detail.Record.Author, "author_name": detail.AuthorName, "actor": detail.Actor, "at": detail.At,
+		"issue_scope": detail.Record.Issue, "parent_id": detail.Record.ParentID, "body": PostBody(detail),
+		"status": detail.Status, "deleted": detail.Record.Deleted, "revoked": detail.Record.Revoked, "edited": false,
+		"can_retry": false, "communication": communication, "consultation": detail.Consultation,
+		"assignment": detail.Assignment, "source": detail.Source,
+		"contribution": contribution,
+	}
+}
