+++ b/frontend/factory/issues/screen.ts
@@ -0,0 +1,119 @@
+import {check, object} from '../api/models.js';
+import {SodaFactoryIssue} from './detail.js';
+import type {IssueDetailContext} from './detail.js';
+import {SodaFactoryWorkJourney} from '../work/journey.js';
+import type {JourneyContext} from '../work/journey.js';
+import {SodaFactoryIssueComment} from './comment.js';
+import type {IssueCommentPorts} from './comment.js';
+import {SodaFactoryIssueEditor} from './editor.js';
+import type {IssueEditorPorts} from './editor.js';
+
+/** One composition for native-header Fountain pages and the standalone frame.
+ * A current primary issue read gates optional Factory facts and host controls. */
+export function mountIssueScreen(
+  context: IssueDetailContext,
+  journey: JourneyContext | undefined,
+  signal: AbortSignal,
+  live: () => boolean,
+  availability?: (available: boolean) => void,
+  comment?: IssueCommentPorts,
+  editor?: IssueEditorPorts
+) {
+  if (journey)
+    check(
+      journey.transport === context.transport &&
+        journey.repository === context.repository &&
+        journey.issue === context.issue
+    );
+  if (comment)
+    check(
+      comment.host === context.host &&
+        comment.actor === context.actor &&
+        comment.repository === context.repository &&
+        comment.issue === context.issue &&
+        comment.scope === context.scope &&
+        comment.transport === context.transport
+    );
+  if (editor)
+    check(
+      editor.host === context.host &&
+        editor.actor === context.actor &&
+        editor.repository === context.repository &&
+        editor.issue === context.issue &&
+        editor.scope === context.scope &&
+        editor.transport === context.transport
+    );
+  const element = document.createElement('section'),
+    view = new SodaFactoryIssue(),
+    facts = new SodaFactoryWorkJourney(),
+    composer = new SodaFactoryIssueComment(),
+    edit = new SodaFactoryIssueEditor();
+  element.className = 'soda-issue-screen';
+  if (editor) element.append(edit);
+  element.append(view);
+  if (comment) element.append(composer);
+  if (journey) element.append(facts);
+  view.addEventListener('factory-issue-read', (event) => {
+    if (signal.aborted || !live() || event.target !== view || !(event instanceof CustomEvent)) return;
+    let available = false;
+    let external = '';
+    try {
+      const state = object(event.detail);
+      available =
+        state.available === true &&
+        state.host === context.host &&
+        state.repository === context.repository &&
+        state.issue === context.issue &&
+        state.actor === context.actor &&
+        state.scope === context.scope;
+      if (available && typeof state.external === 'string' && !!state.external.trim() && state.external.length <= 512)
+        external = state.external;
+    } catch {
+      /* Invalid child display facts retire the optional journey. */
+    }
+    facts.context = available && journey ? journey : undefined;
+    composer.context =
+      available && external && comment
+        ? {
+            ...comment,
+            parent: {kind: 'issue', repository: context.repository, number: context.issue, external_id: external},
+          }
+        : undefined;
+    edit.context =
+      available && external && editor
+        ? {
+            ...editor,
+            parent: {kind: 'issue', repository: context.repository, number: context.issue, external_id: external},
+          }
+        : undefined;
+    availability?.(available);
+  });
+  composer.addEventListener('issue-comment-saved', (event) => {
+    if (!signal.aborted && live() && event.target === composer) void view.refresh();
+  });
+  edit.addEventListener('issue-edit-saved', (event) => {
+    if (!signal.aborted && live() && event.target === edit) void view.refresh();
+  });
+  view.context = {
+    ...context,
+    openLink: async (url, childSignal) => {
+      check(live());
+      const joined = AbortSignal.any([signal, childSignal]);
+      joined.throwIfAborted();
+      await context.openLink(url, joined);
+      check(live());
+      joined.throwIfAborted();
+    },
+  };
+  return {
+    element,
+    dispose() {
+      view.context = undefined;
+      facts.context = undefined;
+      composer.context = undefined;
+      edit.context = undefined;
+      availability?.(false);
+      element.remove();
+    },
+  };
+}
diff --git a/frontend/factory/request/draft.ts b/frontend/factory/request/draft.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f04fc324a1c0b1bf5d299729f8dc645cb5638311
--- /dev/null
+++ b/frontend/factory/request/draft.ts
@@ -0,0 +1,240 @@
+import {check, id} from '../api/models.js';
+import {decisionID} from '../api/request-response.js';
+import type {IntentTask, ProductIdea} from '../api/request-response.js';
+import {inspectPersisted, writeStored} from '../shared/drafts.js';
+
+export interface RequestDraftAddress {
+  scope: string;
+  actor: string;
+  subject: string;
+}
+/** Exact pre-prune edges and target idea lineage; never inferred during restore. */
+export interface ShelvedDepRepair {
+  deps: string[];
+  ideas: string[];
+  depIdeas?: Record<string, string[]>;
+}
+export interface RequestDraft {
+  base: string;
+  repository: string;
+  objective: string;
+  department: string;
+  maxIssues: number;
+  changeText: string;
+  ideas: {id: string; decision: ProductIdea['decision']; correction?: string}[];
+  approach?: 'complete_first' | 'incremental';
+  shelf: IntentTask[];
+  shelfDeps: Record<string, ShelvedDepRepair>;
+}
+export type DraftProblem = 'unavailable' | 'invalid' | 'foreign' | 'conflict';
+export interface RequestDraftRead {
+  raw: string | undefined;
+  draft: RequestDraft | undefined;
+  durable: boolean;
+  problem: DraftProblem | undefined;
+  /** The actual stored copy, if validated for this account and subject. */
+  persisted: RequestDraft | undefined;
+}
+// Keep unsent bytes and the original persisted baseline across component remounts.
+// A later successful read must not mistake another document's writing for that baseline.
+const pending = new Map<string, {raw: string; baseline: string | undefined; protected: boolean}>();
+export function requestDraftKey(address: RequestDraftAddress): string {
+  check(
+    typeof address.scope === 'string' &&
+      address.scope.trim().length > 0 &&
+      address.scope.length <= 1024 &&
+      !/[\u0000-\u001f\u007f]/.test(address.scope) &&
+      id(address.actor) &&
+      (address.subject === 'new' || decisionID(address.subject))
+  );
+  return `soda-intent-draft:v1:${encodeURIComponent(address.scope)}:${address.actor}:${address.subject}`;
+}
+const object = (value: unknown): value is Record<string, unknown> =>
+  !!value && typeof value === 'object' && !Array.isArray(value);
+const exact = (row: Record<string, unknown>, required: string[], optional: string[] = []) =>
+  required.every((key) => Object.hasOwn(row, key)) &&
+  Object.keys(row).every((key) => required.includes(key) || optional.includes(key));
+const text = (value: unknown, limit: number): value is string => typeof value === 'string' && value.length <= limit;
+function ids(value: unknown, limit: number, nonempty = false): value is string[] {
+  return (
+    Array.isArray(value) &&
+    value.length <= limit &&
+    (!nonempty || value.length > 0) &&
+    value.every(decisionID) &&
+    new Set(value).size === value.length
+  );
+}
+function task(value: unknown): value is IntentTask {
+  if (!object(value) || !exact(value, ['key', 'objective', 'outcomes', 'idea_ids'], ['depends_on'])) return false;
+  return (
+    decisionID(value.key) &&
+    text(value.objective, 4000) &&
+    Array.isArray(value.outcomes) &&
+    value.outcomes.length <= 64 &&
+    value.outcomes.every((entry) => text(entry, 4000) && entry.length > 0) &&
+    ids(value.idea_ids, 64, true) &&
+    (value.depends_on === undefined || ids(value.depends_on, 64))
+  );
+}
+function repairs(value: unknown): value is Record<string, ShelvedDepRepair> {
+  return (
+    object(value) &&
+    Object.keys(value).length <= 64 &&
+    Object.entries(value).every(
+      ([key, row]) =>
+        decisionID(key) &&
+        object(row) &&
+        exact(row, ['deps', 'ideas'], ['depIdeas']) &&
+        ids(row.deps, 64) &&
+        ids(row.ideas, 50, true) &&
+        (row.depIdeas === undefined ||
+          (object(row.depIdeas) &&
+            Object.keys(row.depIdeas).length <= 64 &&
+            Object.entries(row.depIdeas).every(([dep, links]) => decisionID(dep) && ids(links, 50, true))))
+    )
+  );
+}
+function valid(row: Record<string, unknown>): boolean {
+  if (
+    !exact(
+      row,
+      [
+        'scope',
+        'actor',
+        'subject',
+        'base',
+        'repository',
+        'objective',
+        'department',
+        'maxIssues',
+        'changeText',
+        'ideas',
+        'shelf',
+        'shelfDeps',
+      ],
+      ['approach']
+    )
+  )
+    return false;
+  if (
+    !(row.base === '' || decisionID(row.base)) ||
+    !(row.repository === '0' || id(row.repository)) ||
+    !text(row.objective, 16000) ||
+    !text(row.department, 25) ||
+    (row.department !== '' && !decisionID(row.department)) ||
+    !Number.isInteger(row.maxIssues) ||
+    Number(row.maxIssues) < 1 ||
+    Number(row.maxIssues) > 64 ||
+    !text(row.changeText, 4000) ||
+    !Array.isArray(row.ideas) ||
+    row.ideas.length > 50 ||
+    !row.ideas.every(
+      (idea) =>
+        object(idea) &&
+        exact(idea, ['id', 'decision'], ['correction']) &&
+        decisionID(idea.id) &&
+        ['pending', 'accept', 'decline', 'edit'].includes(String(idea.decision)) &&
+        (idea.correction === undefined || text(idea.correction, 4000))
+    ) ||
+    (row.approach !== undefined && row.approach !== 'complete_first' && row.approach !== 'incremental') ||
+    !Array.isArray(row.shelf) ||
+    row.shelf.length > 64 ||
+    !row.shelf.every(task) ||
+    !repairs(row.shelfDeps)
+  )
+    return false;
+  const ideaIDs = new Set(row.ideas.map((idea) => idea.id));
+  return (
+    ideaIDs.size === row.ideas.length &&
+    new Set(row.shelf.map((entry) => entry.key)).size === row.shelf.length &&
+    row.shelf.every((entry) => entry.idea_ids.every((link) => ideaIDs.has(link))) &&
+    (row.subject !== 'new' ||
+      (row.base === '' && row.repository === '0' && row.ideas.length === 0 && row.shelf.length === 0))
+  );
+}
+function decode(raw: string | undefined, address: RequestDraftAddress): {draft?: RequestDraft; problem?: DraftProblem} {
+  if (raw === '') return {};
+  if (raw === undefined) return {problem: 'unavailable'};
+  if (raw.length <= 32 * 1024 * 1024) {
+    try {
+      const row: unknown = JSON.parse(raw);
+      if (object(row) && valid(row)) {
+        if (row.scope !== address.scope || row.actor !== address.actor || row.subject !== address.subject)
+          return {problem: 'foreign'};
+        const {scope: _scope, actor: _actor, subject: _subject, ...draft} = row;
+        return {draft: draft as unknown as RequestDraft};
+      }
+    } catch {
+      /* Keep the original bytes. */
+    }
+  }
+  return {problem: 'invalid'};
+}
+export function validRequestDraft(address: RequestDraftAddress, value: unknown): value is RequestDraft {
+  if (!object(value) || ['scope', 'actor', 'subject'].some((key) => Object.hasOwn(value, key))) return false;
+  return !!decode(JSON.stringify({...address, ...value}), address).draft;
+}
+export function readRequestDraft(address: RequestDraftAddress): RequestDraftRead {
+  const key = requestDraftKey(address),
+    saved = inspectPersisted(key),
+    local = pending.get(key);
+  const raw = local?.raw ?? saved.value,
+    result = decode(raw, address),
+    persisted = decode(saved.value, address);
+  const conflict =
+    local &&
+    (local.protected ||
+      (saved.value !== undefined &&
+        saved.value !== local.baseline &&
+        saved.value !== local.raw &&
+        !(local.baseline === undefined && saved.value === '')));
+  return {
+    raw,
+    draft: result.draft,
+    persisted: persisted.draft,
+    durable: !local && saved.durable,
+    problem:
+      result.problem ??
+      persisted.problem ??
+      (conflict ? 'conflict' : saved.value === undefined ? 'unavailable' : undefined),
+  };
+}
+export function retainRequestDraft(
+  address: RequestDraftAddress,
+  draft: RequestDraft,
+  expected: string | undefined,
+  protect = false
+): {status: 'saved' | 'unavailable' | 'conflict' | 'invalid'; raw: string | undefined} {
+  const key = requestDraftKey(address),
+    raw = JSON.stringify({...address, ...draft});
+  if (!decode(raw, address).draft) return {status: 'invalid', raw: expected};
+  const current = readRequestDraft(address),
+    local = pending.get(key),
+    stored = inspectPersisted(key);
+  // An unpersisted copy belongs to its observing view too. Never replace a
+  // newer document-local copy on behalf of a stale component.
+  if (local && current.raw !== expected) return {status: 'conflict', raw: expected};
+  const baseline = local ? local.baseline : expected;
+  const protectedCopy = protect || !!local?.protected;
+  const persistedProblem = decode(stored.value, address).problem;
+  const conflict =
+    current.raw !== expected ||
+    protectedCopy ||
+    persistedProblem === 'invalid' ||
+    persistedProblem === 'foreign' ||
+    (stored.value !== undefined &&
+      stored.value !== baseline &&
+      stored.value !== local?.raw &&
+      stored.value !== raw &&
+      !(baseline === undefined && stored.value === ''));
+  if (conflict || stored.value === undefined) {
+    pending.set(key, {raw, baseline, protected: protectedCopy});
+    return {status: conflict ? 'conflict' : 'unavailable', raw};
+  }
+  if (writeStored(key, raw)) {
+    pending.delete(key);
+    return {status: 'saved', raw};
+  }
+  pending.set(key, {raw, baseline, protected: false});
+  return {status: 'unavailable', raw};
+}
diff --git a/frontend/factory/request/exploration-record.ts b/frontend/factory/request/exploration-record.ts
new file mode 100644
index 0000000000000000000000000000000000000000..df7e37645f0cbea6951771fb8db4a47ab641ed47
--- /dev/null
+++ b/frontend/factory/request/exploration-record.ts
@@ -0,0 +1,169 @@
+import {check, object} from '../api/models.js';
+import {exploration} from '../api/request-response.js';
+import type {Exploration, IntentRevision} from '../api/request-response.js';
+import {requestDraftKey, validRequestDraft} from './draft.js';
+import type {RequestDraft, RequestDraftAddress} from './draft.js';
+import {revisionInput} from './save-record.js';
+import {inspectPersisted} from '../shared/drafts.js';
+
+/** The original input revision identifies the existing atomic exploration transition. */
+export interface PendingExploration {
+  host: string;
+  revision: IntentRevision;
+  writing: RequestDraft;
+}
+export function explorationKey(address: RequestDraftAddress): string {
+  check(address.subject !== 'new');
+  return requestDraftKey(address).replace('soda-intent-draft:', 'soda-intent-exploration:');
+}
+const exact = (row: Record<string, unknown>, keys: string[]) =>
+  check(Object.keys(row).length === keys.length && keys.every((key) => Object.hasOwn(row, key)));
+function parse(raw: string, address: RequestDraftAddress): PendingExploration {
+  check(raw.length <= 32 * 1024 * 1024);
+  const row = object(JSON.parse(raw));
+  exact(row, ['scope', 'actor', 'subject', 'pending']);
+  check(row.scope === address.scope && row.actor === address.actor && row.subject === address.subject);
+  const pending = object(row.pending);
+  exact(pending, ['host', 'revision', 'writing']);
+  check(typeof pending.host === 'string' && /^[a-f0-9]{32}$/.test(pending.host));
+  const revision = revisionInput(pending.revision);
+  check(revision.intent === address.subject && revision.state === 'draft');
+  check(
+    validRequestDraft(address, pending.writing) &&
+      pending.writing.base === revision.id &&
+      pending.writing.repository === revision.repository
+  );
+  return pending as unknown as PendingExploration;
+}
+export function readExplorationCommand(address: RequestDraftAddress): {pending?: PendingExploration; blocked: boolean} {
+  try {
+    const stored = inspectPersisted(explorationKey(address));
+    if (stored.value === '') return {blocked: false};
+    if (stored.value !== undefined) return {pending: parse(stored.value, address), blocked: false};
+  } catch {
+    /* Preserve unknown bytes. */
+  }
+  return {blocked: true};
+}
+const same = (a: PendingExploration, b: PendingExploration) => JSON.stringify(a) === JSON.stringify(b);
+async function locked<T>(address: RequestDraftAddress, body: () => T): Promise<T> {
+  check(!!navigator.locks);
+  return navigator.locks.request(explorationKey(address), body);
+}
+export async function retainExploration(address: RequestDraftAddress, pending: PendingExploration): Promise<boolean> {
+  const raw = JSON.stringify({...address, pending});
+  parse(raw, address);
+  try {
+    return await locked(address, () => {
+      const current = readExplorationCommand(address);
+      if (current.blocked || current.pending) return false;
+      localStorage.setItem(explorationKey(address), raw);
+      const stored = readExplorationCommand(address);
+      return !!stored.pending && same(stored.pending, pending);
+    });
+  } catch {
+    return false;
+  }
+}
+/** Archive the exact writing and observed result before clearing its matching command. */
+export async function settleExploration(
+  address: RequestDraftAddress,
+  pending: PendingExploration,
+  result?: ExplorationResult
+): Promise<boolean> {
+  try {
+    return await locked(address, () => {
+      const current = readExplorationCommand(address);
+      if (current.blocked || !current.pending || !same(current.pending, pending)) return false;
+      const key = explorationKey({...address, subject: pending.revision.id}).replace(
+        'soda-intent-exploration:',
+        'soda-intent-exploration-receipt:'
+      );
+      const baseline = JSON.stringify({...address, pending}),
+        raw = JSON.stringify({...address, pending, ...(result ? {result} : {})}),
+        stored = inspectPersisted(key);
+      if (
+        stored.value === undefined ||
+        (stored.value !== '' && stored.value !== raw && !(result && stored.value === baseline))
+      )
+        return false;
+      localStorage.setItem(key, raw);
+      localStorage.removeItem(explorationKey(address));
+      return inspectPersisted(explorationKey(address)).value === '';
+    });
+  } catch {
+    return false;
+  }
+}
+export interface ExplorationResult {
+  revision: IntentRevision;
+  advice: Exploration;
+}
+/** Strict transition identity before using the existing presentation decoder. */
+export function explorationResult(value: unknown, pending: PendingExploration, actor: string): ExplorationResult {
+  const row = object(value);
+  check(
+    row.owner === actor &&
+      Number.isSafeInteger(row.created_unix) &&
+      Number(row.created_unix) > 0 &&
+      row.planning_calls === 0
+  );
+  const {owner: _owner, created_unix: _created, planning_calls: _calls, exploration: raw, ...authored} = row;
+  const revision = revisionInput(authored),
+    basis = pending.revision;
+  check(
+    revision.intent === basis.intent &&
+      revision.predecessor === basis.id &&
+      revision.id !== basis.id &&
+      revision.state === 'draft' &&
+      revision.repository === basis.repository &&
+      revision.objective === basis.objective &&
+      revision.max_issues === basis.max_issues &&
+      (revision.department || '') === (basis.department || '')
+  );
+  const advice = object(raw),
+    content = object(advice.content);
+  check(
+    content.intent === basis.intent &&
+      content.revision === basis.id &&
+      content.objective === basis.objective &&
+      typeof content.producer === 'string' &&
+      content.producer.length > 0 &&
+      typeof content.supported === 'boolean'
+  );
+  check(Array.isArray(content.unknowns) && content.unknowns.every((v) => typeof v === 'string'));
+  check(
+    Array.isArray(advice.challenges) &&
+      advice.challenges.length <= 50 &&
+      Array.isArray(advice.settled) &&
+      advice.settled.length <= 50
+  );
+  const ideas = new Set(revision.ideas.map((idea) => idea.id));
+  for (const value of advice.challenges) {
+    const challenge = object(value);
+    check(ideas.has(String(challenge.idea)));
+    for (const key of ['assumption', 'consequence', 'recommendation']) check(typeof challenge[key] === 'string');
+  }
+  check(advice.settled.every((value) => typeof value === 'string' && ideas.has(value)));
+  for (const key of ['recommendation', 'consistency'])
+    if (advice[key] !== undefined && advice[key] !== null) {
+      const recorded = object(advice[key]);
+      check(recorded.intent === basis.intent && recorded.revision === basis.id);
+    }
+  return {revision, advice: exploration(advice)};
+}
+export function explorationReceipt(
+  value: unknown,
+  pending: PendingExploration,
+  actor: string
+): ExplorationResult | undefined {
+  const row = object(value);
+  check(row.intent === pending.revision.intent && row.basis_revision === pending.revision.id);
+  if (row.state === 'none') {
+    exact(row, ['intent', 'basis_revision', 'state']);
+    return undefined;
+  }
+  exact(row, ['intent', 'basis_revision', 'state', 'result']);
+  check(row.state === 'recorded');
+  return explorationResult(row.result, pending, actor);
+}
diff --git a/frontend/factory/request/generation-record.ts b/frontend/factory/request/generation-record.ts
new file mode 100644
index 0000000000000000000000000000000000000000..735f391d2b5328a495e9e6de501f451bdcfe13df
--- /dev/null
+++ b/frontend/factory/request/generation-record.ts
@@ -0,0 +1,146 @@
+import {check, id, object} from '../api/models.js';
+import type {IntentRevision} from '../api/request-response.js';
+import {requestDraftKey, validRequestDraft} from './draft.js';
+import type {RequestDraft, RequestDraftAddress} from './draft.js';
+import {revisionInput} from './save-record.js';
+import {inspectPersisted} from '../shared/drafts.js';
+
+export interface PendingGeneration {
+  host: string;
+  revision: IntentRevision;
+  operation: string;
+  writing: RequestDraft;
+}
+export function generationKey(address: RequestDraftAddress): string {
+  check(address.subject !== 'new');
+  return requestDraftKey(address).replace('soda-intent-draft:', 'soda-intent-generation:');
+}
+const exact = (row: Record<string, unknown>, keys: string[]) =>
+  check(Object.keys(row).length === keys.length && keys.every((key) => Object.hasOwn(row, key)));
+function parse(raw: string, address: RequestDraftAddress): PendingGeneration {
+  check(raw.length <= 32 * 1024 * 1024);
+  const row = object(JSON.parse(raw));
+  exact(row, ['scope', 'actor', 'subject', 'pending']);
+  check(row.scope === address.scope && row.actor === address.actor && row.subject === address.subject);
+  const pending = object(row.pending);
+  exact(pending, ['host', 'revision', 'operation', 'writing']);
+  check(typeof pending.host === 'string' && /^[a-f0-9]{32}$/.test(pending.host));
+  const revision = revisionInput(pending.revision);
+  check(revision.intent === address.subject && revision.state === 'accepted' && id(revision.repository));
+  check(
+    typeof pending.operation === 'string' &&
+      pending.operation.length > 0 &&
+      pending.operation.length <= 256 &&
+      !/[\u0000-\u001f\u007f]/.test(pending.operation)
+  );
+  check(
+    validRequestDraft(address, pending.writing) &&
+      pending.writing.base === revision.id &&
+      pending.writing.repository === revision.repository
+  );
+  return {
+    host: pending.host,
+    revision: pending.revision as IntentRevision,
+    operation: pending.operation,
+    writing: pending.writing,
+  };
+}
+export function readGeneration(address: RequestDraftAddress): {pending?: PendingGeneration; blocked: boolean} {
+  try {
+    const stored = inspectPersisted(generationKey(address));
+    if (stored.value === '') return {blocked: false};
+    if (stored.value !== undefined) return {pending: parse(stored.value, address), blocked: false};
+  } catch {
+    /* Preserve unknown bytes. */
+  }
+  return {blocked: true};
+}
+const same = (a: PendingGeneration, b: PendingGeneration) => JSON.stringify(a) === JSON.stringify(b);
+async function locked<T>(address: RequestDraftAddress, body: () => T): Promise<T> {
+  check(!!navigator.locks);
+  return navigator.locks.request(generationKey(address), body);
+}
+export async function retainGeneration(address: RequestDraftAddress, pending: PendingGeneration): Promise<boolean> {
+  const raw = JSON.stringify({...address, pending});
+  parse(raw, address);
+  try {
+    return await locked(address, () => {
+      const current = readGeneration(address);
+      if (current.blocked || current.pending) return false;
+      window.localStorage.setItem(generationKey(address), raw);
+      const stored = readGeneration(address);
+      return !!stored.pending && same(stored.pending, pending);
+    });
+  } catch {
+    return false;
+  }
+}
+/** Preserve captured writing before removing only the matching command. */
+export async function settleGeneration(address: RequestDraftAddress, pending: PendingGeneration): Promise<boolean> {
+  try {
+    return await locked(address, () => {
+      const current = readGeneration(address);
+      if (current.blocked || !current.pending || !same(current.pending, pending)) return false;
+      const key = generationKey({...address, subject: pending.revision.id}).replace(
+        'soda-intent-generation:',
+        'soda-intent-generation-receipt:'
+      );
+      const raw = JSON.stringify({...address, pending}),
+        archived = inspectPersisted(key);
+      if (archived.value === undefined || (archived.value !== '' && archived.value !== raw)) return false;
+      window.localStorage.setItem(key, raw);
+      window.localStorage.removeItem(generationKey(address));
+      return inspectPersisted(generationKey(address)).value === '';
+    });
+  } catch {
+    return false;
+  }
+}
+export interface GenerationReceipt {
+  state: 'not_requested' | 'pending' | 'committed' | 'completed' | 'refused';
+  operation: string;
+  raw: Record<string, unknown>;
+}
+/** Validate identity independently of the lenient display/status projection. */
+export function generationReceipt(
+  value: unknown,
+  revision: IntentRevision,
+  expectedOperation?: string
+): GenerationReceipt {
+  const row = object(value);
+  check(row.intent_id === revision.intent && row.revision_id === revision.id);
+  check(['not_requested', 'pending', 'committed', 'completed', 'refused'].includes(String(row.state)));
+  if (row.state === 'not_requested') {
+    exact(row, ['intent_id', 'revision_id', 'state']);
+    return {state: 'not_requested', operation: 'intent-' + revision.id, raw: row};
+  }
+  check(
+    typeof row.operation_id === 'string' &&
+      row.operation_id.length <= 256 &&
+      !/[\u0000-\u001f\u007f]/.test(row.operation_id)
+  );
+  const cycle = row.reassessment_cycle || row.repair_cycle;
+  check(!(row.reassessment_cycle && row.repair_cycle));
+  const local =
+    row.local_only === true &&
+    row.state === 'completed' &&
+    row.operation_id === '' &&
+    typeof cycle === 'string' &&
+    /^[a-f0-9]{32}$/.test(cycle);
+  check(row.operation_id !== '' || local);
+  const operation = local ? 'local:' + cycle : String(row.operation_id);
+  check(expectedOperation === undefined || operation === expectedOperation);
+  check(id(row.actor_id) && Number.isSafeInteger(row.native_revision) && Number(row.native_revision) > 0);
+  check(Number.isSafeInteger(row.not_after) && Number(row.not_after) > 0);
+  check(typeof row.intent_digest === 'string' && /^[a-f0-9]{64}$/.test(row.intent_digest));
+  check(row.authorization_revision === revision.id + ':' + row.intent_digest);
+  check(
+    Array.isArray(row.submitted_tasks) &&
+      row.submitted_tasks.length <= 64 &&
+      !!row.payload &&
+      typeof row.payload === 'object'
+  );
+  object(row.payload);
+  if (row.task_issue_ids !== undefined) object(row.task_issue_ids);
+  return {state: row.state as GenerationReceipt['state'], operation, raw: row};
+}
diff --git a/frontend/factory/request/planning-record.ts b/frontend/factory/request/planning-record.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9622433b29f48508bf91b2a87889b6504603bf05
--- /dev/null
+++ b/frontend/factory/request/planning-record.ts
@@ -0,0 +1,178 @@
+import {check, id, object} from '../api/models.js';
+import {intentPlanStatus} from '../api/request-response.js';
+import type {IntentRevision, IntentPlanStatus} from '../api/request-response.js';
+import {requestDraftKey, validRequestDraft} from './draft.js';
+import type {RequestDraft, RequestDraftAddress} from './draft.js';
+import {revisionInput} from './save-record.js';
+import {inspectPersisted} from '../shared/drafts.js';
+
+export interface PendingPlanning {
+  host: string;
+  revision: IntentRevision;
+  operation: 'propose_intent' | 'decomposition_options';
+  writing: RequestDraft;
+  assignment: string;
+  run: string;
+  launch: 'unknown' | 'confirmed' | 'unconfirmed';
+}
+const nativeID = (value: unknown): value is string => typeof value === 'string' && /^[a-f0-9]{32}$/.test(value);
+export function planningKey(address: RequestDraftAddress): string {
+  check(address.subject !== 'new');
+  return requestDraftKey(address).replace('soda-intent-draft:', 'soda-intent-planning:');
+}
+const exact = (row: Record<string, unknown>, keys: string[]) =>
+  check(Object.keys(row).length === keys.length && keys.every((key) => Object.hasOwn(row, key)));
+function parse(raw: string, address: RequestDraftAddress): PendingPlanning {
+  check(raw.length <= 32 * 1024 * 1024);
+  const row = object(JSON.parse(raw));
+  exact(row, ['scope', 'actor', 'subject', 'pending']);
+  check(row.scope === address.scope && row.actor === address.actor && row.subject === address.subject);
+  const pending = object(row.pending);
+  exact(pending, ['host', 'revision', 'operation', 'writing', 'assignment', 'run', 'launch']);
+  check(nativeID(pending.host));
+  const revision = revisionInput(pending.revision);
+  check(revision.intent === address.subject && revision.state === 'draft' && id(revision.repository));
+  check(pending.operation === 'propose_intent' || pending.operation === 'decomposition_options');
+  check(
+    validRequestDraft(address, pending.writing) &&
+      pending.writing.base === revision.id &&
+      pending.writing.repository === revision.repository
+  );
+  check(
+    (pending.assignment === '' && pending.run === '' && pending.launch === 'unknown') ||
+      (nativeID(pending.assignment) &&
+        nativeID(pending.run) &&
+        ['unknown', 'confirmed', 'unconfirmed'].includes(String(pending.launch)))
+  );
+  return pending as unknown as PendingPlanning;
+}
+const rawPlanning = (address: RequestDraftAddress, pending: PendingPlanning) => JSON.stringify({...address, pending});
+const same = (a: PendingPlanning, b: PendingPlanning) => JSON.stringify(a) === JSON.stringify(b);
+// Preserve observed reply identities through remounts if storage fails after dispatch.
+const observed = new Map<string, {baseline: string | undefined; pending: PendingPlanning}>();
+export function readPlanning(address: RequestDraftAddress): {
+  pending?: PendingPlanning;
+  blocked: boolean;
+  durable: boolean;
+} {
+  try {
+    const key = planningKey(address),
+      stored = inspectPersisted(key),
+      local = observed.get(key);
+    if (local)
+      return {
+        pending: local.pending,
+        blocked:
+          stored.value === undefined ||
+          (stored.value !== local.baseline && stored.value !== rawPlanning(address, local.pending)),
+        durable: stored.value === rawPlanning(address, local.pending),
+      };
+    if (stored.value === '') return {blocked: false, durable: true};
+    if (stored.value !== undefined) return {pending: parse(stored.value, address), blocked: false, durable: true};
+  } catch {
+    /* Preserve unknown bytes. */
+  }
+  return {blocked: true, durable: false};
+}
+async function locked<T>(address: RequestDraftAddress, body: () => T): Promise<T> {
+  check(!!navigator.locks);
+  return navigator.locks.request(planningKey(address), body);
+}
+export async function retainPlanning(address: RequestDraftAddress, pending: PendingPlanning): Promise<boolean> {
+  const raw = rawPlanning(address, pending);
+  parse(raw, address);
+  try {
+    return await locked(address, () => {
+      const current = readPlanning(address);
+      if (current.blocked || current.pending) return false;
+      window.localStorage.setItem(planningKey(address), raw);
+      const written = readPlanning(address);
+      return !!written.pending && same(written.pending, pending) && written.durable;
+    });
+  } catch {
+    return false;
+  }
+}
+export async function bindPlanning(
+  address: RequestDraftAddress,
+  previous: PendingPlanning,
+  next: PendingPlanning
+): Promise<boolean> {
+  const key = planningKey(address),
+    raw = rawPlanning(address, next);
+  parse(raw, address);
+  try {
+    return await locked(address, () => {
+      const current = readPlanning(address);
+      if (current.blocked || !current.pending || !same(current.pending, previous)) {
+        observed.set(key, {baseline: observed.get(key)?.baseline ?? rawPlanning(address, previous), pending: next});
+        return false;
+      }
+      const baseline = inspectPersisted(key).value;
+      try {
+        window.localStorage.setItem(key, raw);
+        observed.delete(key);
+        return true;
+      } catch {
+        observed.set(key, {baseline, pending: next});
+        return false;
+      }
+    });
+  } catch {
+    observed.set(key, {baseline: observed.get(key)?.baseline ?? rawPlanning(address, previous), pending: next});
+    return false;
+  }
+}
+export async function settlePlanning(address: RequestDraftAddress, pending: PendingPlanning): Promise<boolean> {
+  try {
+    return await locked(address, () => {
+      const key = planningKey(address),
+        current = readPlanning(address);
+      if (current.blocked || !current.pending || !same(current.pending, pending)) return false;
+      const archive = planningKey({...address, subject: pending.revision.id}).replace(
+        'soda-intent-planning:',
+        'soda-intent-planning-receipt:'
+      );
+      const raw = rawPlanning(address, pending),
+        stored = inspectPersisted(archive);
+      if (stored.value === undefined || (stored.value !== '' && stored.value !== raw)) return false;
+      window.localStorage.setItem(archive, raw);
+      window.localStorage.removeItem(key);
+      observed.delete(key);
+      return inspectPersisted(key).value === '';
+    });
+  } catch {
+    return false;
+  }
+}
+export function planningReceipt(
+  value: unknown,
+  pending: Pick<PendingPlanning, 'revision' | 'operation' | 'assignment' | 'run'>
+): IntentPlanStatus {
+  const row = object(value);
+  check(
+    row.intent === pending.revision.intent && row.revision === pending.revision.id && row.launch_confirmed === undefined
+  );
+  check(['none', 'pending', 'completed', 'attention', 'failed', 'cancelled'].includes(String(row.state)));
+  if (row.state === 'none') exact(row, ['intent', 'revision', 'state']);
+  else {
+    check(row.operation === pending.operation && nativeID(row.assignment_id) && nativeID(row.run_id));
+    check(!pending.assignment || (row.assignment_id === pending.assignment && row.run_id === pending.run));
+    check(row.candidates === undefined || (Number.isSafeInteger(row.candidates) && Number(row.candidates) >= 0));
+    check(row.summary === undefined || typeof row.summary === 'string');
+    check(row.review === undefined);
+  }
+  return intentPlanStatus(row);
+}
+export function planningLaunch(value: unknown, pending: PendingPlanning): PendingPlanning {
+  const row = object(value);
+  check(row.revision_id === pending.revision.id && nativeID(row.assignment_id) && nativeID(row.run_id));
+  check(!pending.assignment || (row.assignment_id === pending.assignment && row.run_id === pending.run));
+  check(row.launch_confirmed === undefined || typeof row.launch_confirmed === 'boolean');
+  return {
+    ...pending,
+    assignment: row.assignment_id,
+    run: row.run_id,
+    launch: row.launch_confirmed === false ? 'unconfirmed' : 'confirmed',
+  };
+}
diff --git a/frontend/factory/request/save-record.ts b/frontend/factory/request/save-record.ts
new file mode 100644
index 0000000000000000000000000000000000000000..acd32d191e32842c003dee556ec3fd01f70f0cde
--- /dev/null
+++ b/frontend/factory/request/save-record.ts
@@ -0,0 +1,217 @@
+import {check, id, object} from '../api/models.js';
+import {decisionID, intentRevision} from '../api/request-response.js';
+import type {IntentRevision} from '../api/request-response.js';
+import {requestDraftKey, validRequestDraft} from './draft.js';
+import type {RequestDraft, RequestDraftAddress} from './draft.js';
+import {inspectPersisted} from '../shared/drafts.js';
+
+/** The immutable revision ID is the existing server save identity. */
+export interface PendingSave {
+  host: string;
+  revision: IntentRevision;
+  before: RequestDraft;
+  after: RequestDraft;
+}
+export interface SaveRead {
+  pending?: PendingSave;
+  blocked: boolean;
+}
+export function saveKey(address: RequestDraftAddress): string {
+  return requestDraftKey(address).replace('soda-intent-draft:', 'soda-intent-save:');
+}
+const receiptKey = (address: RequestDraftAddress, revision: string) =>
+  saveKey({...address, subject: revision}).replace('soda-intent-save:', 'soda-intent-save-receipt:');
+const exact = (row: Record<string, unknown>, required: string[], optional: string[] = []) =>
+  check(
+    required.every((key) => Object.hasOwn(row, key)) &&
+      Object.keys(row).every((key) => required.includes(key) || optional.includes(key))
+  );
+const text = (value: unknown, limit: number) => check(typeof value === 'string' && value.length <= limit);
+function ids(value: unknown, limit: number) {
+  check(
+    Array.isArray(value) && value.length <= limit && value.every(decisionID) && new Set(value).size === value.length
+  );
+}
+/** Validate all authored fields before comparing; the display decoder is intentionally lenient. */
+export function revisionInput(value: unknown): IntentRevision {
+  const row = object(value);
+  exact(
+    row,
+    ['id', 'intent', 'repository', 'objective', 'ideas', 'tasks', 'state', 'max_issues'],
+    ['predecessor', 'department', 'approach', 'effective_outcomes']
+  );
+  check(decisionID(row.id) && decisionID(row.intent) && (row.repository === '0' || id(row.repository)));
+  check(row.predecessor === undefined || decisionID(row.predecessor));
+  check(row.department === undefined || row.department === '' || decisionID(row.department));
+  text(row.objective, 16000);
+  check(['draft', 'accepted', 'declined', 'rejected', 'abandoned'].includes(String(row.state)));
+  check(Number.isInteger(row.max_issues) && Number(row.max_issues) >= 1 && Number(row.max_issues) <= 64);
+  check(
+    row.approach === undefined ||
+      row.approach === '' ||
+      row.approach === 'complete_first' ||
+      row.approach === 'incremental'
+  );
+  check(Array.isArray(row.ideas) && row.ideas.length <= 50 && Array.isArray(row.tasks) && row.tasks.length <= 64);
+  for (const value of row.ideas) {
+    const idea = object(value);
+    exact(
+      idea,
+      ['id', 'description', 'consequence', 'assumption', 'decision'],
+      ['correction', 'source', 'provenance', 'actor', 'evidence', 'material']
+    );
+    check(decisionID(idea.id) && typeof idea.assumption === 'boolean');
+    text(idea.description, 4000);
+    text(idea.consequence, 4000);
+    check(['pending', 'accept', 'decline', 'edit'].includes(String(idea.decision)));
+    for (const key of ['correction', 'source', 'provenance', 'evidence'])
+      if (idea[key] !== undefined) text(idea[key], 4000);
+    check(idea.actor === undefined || idea.actor === '0' || id(idea.actor));
+    check(idea.material === undefined || typeof idea.material === 'boolean');
+  }
+  for (const value of row.tasks) {
+    const task = object(value);
+    exact(task, ['key', 'objective', 'outcomes', 'idea_ids'], ['depends_on']);
+    check(decisionID(task.key));
+    text(task.objective, 4000);
+    check(Array.isArray(task.outcomes) && task.outcomes.length <= 64);
+    for (const outcome of task.outcomes) text(outcome, 4000);
+    ids(task.idea_ids, 64);
+    if (task.depends_on !== undefined) ids(task.depends_on, 64);
+  }
+  if (row.effective_outcomes !== undefined) ids(row.effective_outcomes, 50);
+  const revision = intentRevision(row);
+  // Match Go's omitempty representation while preserving every authored value and array order.
+  for (const idea of revision.ideas) {
+    if (idea.actor === '0') delete idea.actor;
+    if (idea.material === false) delete idea.material;
+  }
+  for (const task of revision.tasks) if (task.depends_on?.length === 0) delete task.depends_on;
+  if (revision.effective_outcomes?.length === 0) delete revision.effective_outcomes;
+  return revision;
+}
+export function savedReceipt(value: unknown, actor: string, pending: PendingSave): IntentRevision {
+  const row = object(value);
+  check(
+    row.owner === actor &&
+      Number.isSafeInteger(row.created_unix) &&
+      Number(row.created_unix) > 0 &&
+      row.planning_calls === 0
+  );
+  const {owner: _owner, created_unix: _time, planning_calls: _calls, ...authored} = row;
+  const saved = revisionInput(authored);
+  check(JSON.stringify(saved) === JSON.stringify(revisionInput(pending.revision)));
+  return saved;
+}
+function parse(raw: string, address: RequestDraftAddress): PendingSave {
+  check(raw.length <= 32 * 1024 * 1024);
+  const row = object(JSON.parse(raw));
+  exact(row, ['scope', 'actor', 'subject', 'pending']);
+  check(row.scope === address.scope && row.actor === address.actor && row.subject === address.subject);
+  const pending = object(row.pending);
+  exact(pending, ['host', 'revision', 'before', 'after']);
+  check(typeof pending.host === 'string' && /^[a-f0-9]{32}$/.test(pending.host));
+  revisionInput(pending.revision);
+  const revision = pending.revision as unknown as IntentRevision;
+  check(validRequestDraft(address, pending.before));
+  check(validRequestDraft({...address, subject: revision.intent}, pending.after));
+  const before = pending.before as unknown as RequestDraft,
+    after = pending.after as unknown as RequestDraft;
+  check(
+    address.subject === 'new'
+      ? before.base === '' && !revision.predecessor
+      : address.subject === revision.intent && before.base === revision.predecessor
+  );
+  check(after.base === revision.id && after.repository === revision.repository);
+  check(
+    after.objective === before.objective &&
+      after.changeText === before.changeText &&
+      after.maxIssues === revision.max_issues
+  );
+  check(
+    JSON.stringify(after.ideas) ===
+      JSON.stringify(
+        revision.ideas.map(({id, decision, correction}) => ({
+          id,
+          decision,
+          ...(correction === undefined ? {} : {correction}),
+        }))
+      )
+  );
+  return {host: pending.host, revision, before, after};
+}
+export function readSave(address: RequestDraftAddress): SaveRead {
+  const stored = inspectPersisted(saveKey(address));
+  if (stored.value === '') return {blocked: false};
+  try {
+    if (stored.value !== undefined) return {pending: parse(stored.value, address), blocked: false};
+  } catch {
+    /* Preserve unknown bytes. */
+  }
+  return {blocked: true};
+}
+export const sameSave = (a: PendingSave, b: PendingSave): boolean => JSON.stringify(a) === JSON.stringify(b);
+/** Web Locks serialize admission across documents; never pretend localStorage is CAS. */
+async function locked<T>(address: RequestDraftAddress, body: () => T): Promise<T> {
+  check(!!navigator.locks);
+  return navigator.locks.request(saveKey(address), body);
+}
+export async function retainSave(address: RequestDraftAddress, pending: PendingSave): Promise<boolean> {
+  const raw = JSON.stringify({...address, pending});
+  parse(raw, address);
+  try {
+    return await locked(address, () => {
+      const current = readSave(address);
+      if (current.blocked || current.pending) return false;
+      window.localStorage.setItem(saveKey(address), raw);
+      const saved = readSave(address);
+      return !!saved.pending && sameSave(saved.pending, pending);
+    });
+  } catch {
+    return false;
+  }
+}
+/** Archive exact recovery metadata before removing the pending slot. Neither write replaces unknown bytes. */
+export async function settleSave(address: RequestDraftAddress, pending: PendingSave): Promise<boolean> {
+  try {
+    return await locked(address, () => {
+      const current = readSave(address);
+      if (current.blocked || !current.pending || !sameSave(current.pending, pending)) return false;
+      const key = receiptKey(address, pending.revision.id),
+        stored = inspectPersisted(key),
+        raw = JSON.stringify({...address, pending});
+      if (stored.value === undefined || (stored.value !== '' && stored.value !== raw)) return false;
+      window.localStorage.setItem(key, raw);
+      window.localStorage.removeItem(saveKey(address));
+      return inspectPersisted(saveKey(address)).value === '';
+    });
+  } catch {
+    return false;
+  }
+}
+/** Caller must freshly prove receipt absence and a head that fences this predecessor. */
+export async function releaseObsoleteSave(address: RequestDraftAddress, pending: PendingSave): Promise<boolean> {
+  try {
+    return await locked(address, () => {
+      const current = readSave(address);
+      if (current.blocked || !current.pending || !sameSave(current.pending, pending)) return false;
+      window.localStorage.removeItem(saveKey(address));
+      return inspectPersisted(saveKey(address)).value === '';
+    });
+  } catch {
+    return false;
+  }
+}
+export function savedDraft(address: RequestDraftAddress, revision: IntentRevision): RequestDraft | undefined {
+  try {
+    const raw = inspectPersisted(receiptKey(address, revision.id)).value;
+    if (!raw) return;
+    const row = object(JSON.parse(raw));
+    check(row.subject === 'new' || row.subject === revision.intent);
+    const pending = parse(raw, {...address, subject: String(row.subject)});
+    check(JSON.stringify(revisionInput(revision)) === JSON.stringify(revisionInput(pending.revision)));
+    return pending.after;
+  } catch {
+    return;
+  }
+}
diff --git a/frontend/factory/shared/markdown.ts b/frontend/factory/shared/markdown.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1b2750cd4b77d2c620dec6e15d89386415bf1db0
--- /dev/null
+++ b/frontend/factory/shared/markdown.ts
@@ -0,0 +1,115 @@
+import {Marked} from 'marked';
+import DOMPurify from 'dompurify';
+
+const escape = (value: string) =>
+  value.replace(/[&<>"']/g, (char) => ({'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'})[char]!);
+// Keep attachments explicit until a host supplies authenticated media reads.
+const parser = new Marked({
+  gfm: true,
+  async: false,
+  renderer: {
+    image({href, text}) {
+      return `<a href="${escape(href)}">${escape(text || 'Image attachment')}</a>`;
+    },
+  },
+});
+
+export function markdownLink(value: string): string | undefined {
+  try {
+    const url = new URL(value);
+    if (!['https:', 'http:', 'mailto:'].includes(url.protocol) || url.username || url.password) return;
+    return url.href;
+  } catch {
+    return;
+  }
+}
+
+/** Sanitized DOM nodes, never provider HTML inserted directly into a template.
+ * The host resolves provider-specific relative references before URL policy. */
+export function issueMarkdown(
+  body: string,
+  resolveLink: (href: string) => string | undefined,
+  section = 'issue'
+): DocumentFragment {
+  const fragment = DOMPurify.sanitize(parser.parse(body, {async: false}), {
+    RETURN_DOM_FRAGMENT: true,
+    ALLOWED_TAGS: [
+      'p',
+      'br',
+      'hr',
+      'h1',
+      'h2',
+      'h3',
+      'h4',
+      'h5',
+      'h6',
+      'strong',
+      'em',
+      'del',
+      'blockquote',
+      'pre',
+      'code',
+      'ul',
+      'ol',
+      'li',
+      'a',
+      'table',
+      'thead',
+      'tbody',
+      'tr',
+      'th',
+      'td',
+      'input',
+      'details',
+      'summary',
+      'kbd',
+    ],
+    ALLOWED_ATTR: ['href', 'title', 'start', 'type', 'checked', 'disabled', 'open', 'colspan', 'rowspan'],
+    ALLOW_DATA_ATTR: false,
+    ALLOW_ARIA_ATTR: false,
+  });
+  // Heading targets belong to this rendered body. Scope comment headings so
+  // identical text in a description and several comments cannot steal a jump.
+  const headings = new Map<string, string>();
+  const used = new Set<string>();
+  const namespace = [...new TextEncoder().encode(section)].map((byte) => byte.toString(16).padStart(2, '0')).join('');
+  for (const heading of fragment.querySelectorAll('h1,h2,h3,h4,h5,h6')) {
+    const base =
+      (heading.textContent ?? '')
+        .trim()
+        .toLowerCase()
+        .replace(/[^\p{L}\p{N}_\s-]/gu, '')
+        .replace(/\s/g, '-') || 'section';
+    let slug = base,
+      duplicate = 0;
+    while (used.has(slug)) slug = base + '-' + ++duplicate;
+    used.add(slug);
+    const target = 'user-content-' + namespace + '-' + slug;
+    heading.id = target;
+    headings.set(slug, target);
+  }
+  for (const anchor of fragment.querySelectorAll('a')) {
+    let href = anchor.getAttribute('href');
+    let safe: string | undefined;
+    try {
+      if (href?.startsWith('#')) {
+        const heading = headings.get(decodeURIComponent(href.slice(1)));
+        if (heading) href = '#' + encodeURIComponent(heading);
+      }
+      const resolved = href ? resolveLink(href) : undefined;
+      safe = resolved ? markdownLink(resolved) : undefined;
+    } catch {
+      /* Unsupported host link remains text. */
+    }
+    if (!safe) anchor.replaceWith(...anchor.childNodes);
+    else {
+      anchor.href = safe;
+      anchor.rel = 'noopener noreferrer';
+    }
+  }
+  for (const input of fragment.querySelectorAll('input')) {
+    input.type = 'checkbox';
+    input.disabled = true;
+  }
+  return fragment;
+}
