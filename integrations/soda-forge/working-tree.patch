new file mode 100644
index 0000000000000000000000000000000000000000..c6c016b3e48db57b31ed223a93f1f1d1f06fddb7
--- /dev/null
+++ b/internal/factory/execution/observation.go
@@ -0,0 +1,164 @@
+package execution
+
+import (
+	"context"
+	"errors"
+
+	"github.com/levitateos/sodaos/internal/collaboration"
+	"github.com/levitateos/sodaos/internal/project"
+)
+
+var (
+	ErrRunNotObserved     = errors.New("execution run not observed")
+	ErrRunChanged         = errors.New("execution run incarnation changed")
+	ErrCustodyNotObserved = errors.New("execution custody not observed")
+	ErrObservation        = errors.New("invalid execution observation")
+)
+
+// RunAddress names an existing recorded run, not permission to start it. An
+// adapter validates its own workspace namespace before calling its runtime.
+type RunAddress struct {
+	Run       string
+	Workspace string
+}
+
+func (a RunAddress) Validate() error {
+	if !collaboration.ValidText(a.Run, 128) || !collaboration.ValidText(a.Workspace, 128) {
+		return ErrObservation
+	}
+	return nil
+}
+
+// RunObserver reads or retires exactly one identity. Missing observations are
+// typed errors; neither absence nor a transport failure proves retirement.
+type RunObserver interface {
+	InspectRun(context.Context, RunAddress) (RunObservation, error)
+	RetireRun(context.Context, RunAddress) (RunObservation, error)
+}
+
+// RunLauncher consumes semantic inputs with a captured runtime binding. Each
+// adapter owns its transport and returns that runtime's actual observation.
+type RunLauncher interface {
+	LaunchRun(context.Context, LaunchRequest) (RunObservation, error)
+}
+
+// CustodyObserver concerns only this run's acquired credential material.
+// SealCustody acknowledges sealing the identity, not release of credentials;
+// callers must subsequently read and reconcile the actual custody observation.
+type CustodyObserver interface {
+	ReadCustody(context.Context, RunAddress) (CustodyObservation, error)
+	SealCustody(context.Context, RunAddress) error
+}
+
+// RunObservation supplies common execution results plus exactly one runtime's
+// facts. It is not the placement-bound Provenance record: historic runs do not
+// yet have canonical runtime IDs or placement generations. Those cannot be
+// invented by a translator. VerificationChecks is the existing shared manifest
+// receipt, independently validated against the admitted run by its consumer.
+type RunObservation struct {
+	Run                string
+	Workspace          string
+	Role               string
+	Phase              string
+	Output             string
+	Reason             string
+	ExitCode           *int
+	Live               bool
+	Retirement         Retirement
+	Kind               collaboration.RuntimeKind
+	Appliance          *ApplianceRunFacts
+	Native             *NativeProvenance
+	VerificationChecks *project.FactoryVerificationChecksState
+}
+
+// ApplianceRunFacts retains observed boundary/lease facts without fabricating
+// the image required by a complete ApplianceBoundary. That image belongs to
+// the captured admission. Empty invocation fields stay empty on stop tombstones.
+type ApplianceRunFacts struct {
+	Invocation          ApplianceInvocation
+	LeaseID             string
+	CredentialDelivered bool
+	CredentialReturned  bool
+}
+
+type CustodyObservation struct {
+	Run string
+	// Workspace stays unknown unless attested. An appliance broker binding
+	// names the container, not the workspace; never fill this from a request.
+	Workspace string
+	// Sealed means this identity cannot acquire again. A sealed broker row
+	// with retained lease/binding metadata does not prove credential return.
+	Sealed    bool
+	Kind      collaboration.RuntimeKind
+	Appliance *BrokerObservation
+	Native    *NativeCustody
+}
+
+func (o RunObservation) InvocationID() string {
+	if o.Kind == collaboration.Appliance && o.Appliance != nil {
+		return o.Appliance.Invocation.Invocation
+	}
+	if o.Kind == collaboration.Native && o.Native != nil && o.Native.Process != nil {
+		return o.Native.Process.InvocationID
+	}
+	return ""
+}
+
+func (o RunObservation) CredentialDeliveryObserved() bool {
+	if o.Kind == collaboration.Appliance && o.Appliance != nil {
+		return o.Appliance.CredentialDelivered
+	}
+	return o.Kind == collaboration.Native && o.Native != nil && o.Native.Custody.AcquisitionID != "" &&
+		(o.Native.Custody.State == Held || o.Native.Custody.State == Released)
+}
+
+func (o RunObservation) CredentialReturnObserved() bool {
+	if o.Kind == collaboration.Appliance && o.Appliance != nil {
+		return o.Appliance.CredentialReturned
+	}
+	return o.Kind == collaboration.Native && o.Native != nil && o.Native.Custody.State == Released
+}
+
+func (o RunObservation) ValidateFor(a RunAddress) error {
+	if a.Validate() != nil || o.Run != a.Run || o.Workspace != a.Workspace ||
+		!project.ValidFactoryPhase(o.Phase) || (o.Retirement != NotStarted && o.Retirement != Running && o.Retirement != Exited && o.Retirement != Retired && o.Retirement != Uncertain) ||
+		(o.Live && o.Retirement == Retired) {
+		return ErrObservation
+	}
+	switch o.Kind {
+	case collaboration.Appliance:
+		if o.Appliance == nil || o.Native != nil || o.Appliance.Invocation.Project != o.Workspace ||
+			(o.Live && o.Appliance.Invocation.Invocation == "") {
+			return ErrObservation
+		}
+	case collaboration.Native:
+		if o.Native == nil || o.Appliance != nil || !validNative(*o.Native) || (o.Live && o.Native.Process == nil) {
+			return ErrObservation
+		}
+	default:
+		return ErrObservation
+	}
+	return nil
+}
+
+func (o CustodyObservation) ValidateFor(a RunAddress) error {
+	if a.Validate() != nil || o.Run != a.Run || (o.Workspace != "" && o.Workspace != a.Workspace) {
+		return ErrObservation
+	}
+	switch o.Kind {
+	case collaboration.Appliance:
+		if o.Appliance == nil || o.Native != nil || !validAppliance(ApplianceProvenance{Broker: *o.Appliance}, o.Run) {
+			return ErrObservation
+		}
+		if b := o.Appliance.Binding; b != nil && b.ID != a.Run {
+			return ErrObservation
+		}
+	case collaboration.Native:
+		if o.Native == nil || o.Appliance != nil || !validNativeCustody(*o.Native) {
+			return ErrObservation
+		}
+	default:
+		return ErrObservation
+	}
+	return nil
+}
diff --git a/internal/factory/execution/preparation.go b/internal/factory/execution/preparation.go
new file mode 100644
index 0000000000000000000000000000000000000000..bf9349364c24f5dfd9c818cf7636fd7649443b06
--- /dev/null
+++ b/internal/factory/execution/preparation.go
@@ -0,0 +1,186 @@
+package execution
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"reflect"
+
+	"github.com/levitateos/sodaos/internal/collaboration"
+	"github.com/levitateos/sodaos/internal/project"
+)
+
+var (
+	ErrPreparation            = errors.New("invalid execution preparation observation")
+	ErrPreparationNotObserved = errors.New("execution preparation not observed")
+)
+
+type PreparationAddress struct {
+	Workspace string
+	ID        string
+	Native    *NativeWorkspaceRef
+}
+
+func validWorkspaceRef(n NativeWorkspaceRef) bool {
+	return collaboration.ValidID(string(n.Profile)) && collaboration.ValidID(n.InstanceID) && collaboration.ValidText(n.WorktreeID, 128)
+}
+
+func (a PreparationAddress) Validate() error {
+	if !collaboration.ValidText(a.Workspace, 128) || !project.ValidPreparationID(a.ID) || a.Native != nil && !validWorkspaceRef(*a.Native) {
+		return ErrPreparation
+	}
+	return nil
+}
+
+type PreparationObserver interface {
+	InspectWorkspacePreparation(context.Context, PreparationAddress) (PreparationState, error)
+	RetireWorkspacePreparation(context.Context, PreparationAddress) (PreparationState, error)
+}
+
+type StandingPreparationRequest struct {
+	Input  project.Prepare
+	Native *NativeWorkspaceRef
+}
+
+type CandidatePreparationRequest struct {
+	Input  project.FactoryCandidate
+	Native *NativeWorkspaceRef
+}
+
+func (r StandingPreparationRequest) Address() PreparationAddress {
+	return PreparationAddress{Workspace: r.Input.Preparation.Project, ID: r.Input.Preparation.ID, Native: r.Native}
+}
+
+func (r CandidatePreparationRequest) Address() PreparationAddress {
+	return PreparationAddress{Workspace: r.Input.Preparation.Project, ID: r.Input.Preparation.ID, Native: r.Native}
+}
+
+func (r StandingPreparationRequest) Validate() error {
+	if r.Input.Validate() != nil || r.Address().Validate() != nil {
+		return ErrPreparation
+	}
+	return nil
+}
+
+func (r CandidatePreparationRequest) Validate() error {
+	if r.Input.Validate() != nil || r.Address().Validate() != nil {
+		return ErrPreparation
+	}
+	return nil
+}
+
+type PreparationLauncher interface {
+	PrepareWorkspace(context.Context, StandingPreparationRequest) (PreparationState, error)
+	PrepareWorkspaceCandidate(context.Context, CandidatePreparationRequest) (PreparationState, error)
+}
+
+// PreparationState preserves the appliance's retained field shape. Native
+// workspaces supply their captured owner reference and no container identity.
+type PreparationState struct {
+	ID           string                 `json:"id"`
+	Project      string                 `json:"project"`
+	Role         string                 `json:"role"`
+	Phase        string                 `json:"phase"`
+	Container    string                 `json:"container"`
+	SourceCommit string                 `json:"source_commit"`
+	SetupDigest  string                 `json:"setup_digest"`
+	Tools        []project.ResolvedTool `json:"tools,omitempty"`
+	Missing      string                 `json:"missing,omitempty"`
+	SetupExit    *int                   `json:"setup_exit,omitempty"`
+	CheckExit    *int                   `json:"check_exit,omitempty"`
+	Output       string                 `json:"output,omitempty"`
+	Ready        bool                   `json:"ready"`
+	Stopped      bool                   `json:"stopped"`
+	Retirement   string                 `json:"retirement,omitempty"`
+	Native       *NativeWorkspaceRef    `json:"native,omitempty"`
+}
+
+func (s PreparationState) ValidateFor(a PreparationAddress) error {
+	if a.Validate() != nil || s.Project != a.Workspace || s.ID != a.ID ||
+		(s.Phase == "" && !s.Stopped || s.Phase != "" && !project.ValidPreparePhase(s.Phase)) ||
+		(s.Role != "" && !project.ValidFactoryRole(s.Role)) || s.Ready != (s.Phase == project.PrepareReady) || s.Ready && s.Stopped ||
+		(s.SourceCommit != "" && !project.ValidCommit(s.SourceCommit)) || (s.SetupDigest != "" && !validDigest(s.SetupDigest)) ||
+		len(s.Tools) > project.MaxPrepareTools || len(s.Output) > 256<<10 || len(s.Missing) > 4096 {
+		return ErrPreparation
+	}
+	if s.Ready && (s.Role == "" || !project.ValidCommit(s.SourceCommit) || !validDigest(s.SetupDigest)) {
+		return ErrPreparation
+	}
+	for _, exit := range []*int{s.SetupExit, s.CheckExit} {
+		if exit != nil && (*exit < 0 || *exit > 255 || s.Ready && *exit != 0) {
+			return ErrPreparation
+		}
+	}
+	if a.Native == nil {
+		if s.Native != nil || s.Container != "" && !project.ValidContainerID(s.Container) || s.Ready && s.Container == "" {
+			return ErrPreparation
+		}
+	} else if s.Native == nil || s.Container != "" || !validWorkspaceRef(*s.Native) || *s.Native != *a.Native {
+		return ErrPreparation
+	}
+	return nil
+}
+
+func (s PreparationState) RetirementState() Retirement {
+	if s.Stopped && s.Retirement == "confirmed" {
+		return Retired
+	}
+	if s.Phase == project.PrepareRunning && !s.Stopped {
+		return Running
+	}
+	return Uncertain
+}
+
+func (s PreparationState) MarshalJSON() ([]byte, error) {
+	type fields PreparationState
+	raw, err := json.Marshal(fields(s))
+	if err != nil || s.Native == nil {
+		return raw, err
+	}
+	var data map[string]json.RawMessage
+	if err := json.Unmarshal(raw, &data); err != nil {
+		return nil, err
+	}
+	delete(data, "container")
+	return json.Marshal(data)
+}
+
+// PreparationRecord is the canonical durable preparation: approved inputs,
+// captured runtime owner and observed state. Reading it does not authorize setup
+// or role execution.
+type PreparationRecord struct {
+	Preparation project.Preparation `json:"preparation"`
+	State       PreparationState    `json:"state,omitempty"`
+	Native      *NativeWorkspaceRef `json:"native,omitempty"`
+}
+
+func (r PreparationRecord) Address() PreparationAddress {
+	return PreparationAddress{Workspace: r.Preparation.Project, ID: r.Preparation.ID, Native: r.Native}
+}
+
+func (r PreparationRecord) MarshalJSON() ([]byte, error) {
+	if r.Native != nil && reflect.DeepEqual(r.State, PreparationState{}) {
+		return json.Marshal(struct {
+			Preparation project.Preparation `json:"preparation"`
+			Native      *NativeWorkspaceRef `json:"native"`
+		}{r.Preparation, r.Native})
+	}
+	type fields PreparationRecord
+	return json.Marshal(fields(r))
+}
+
+func (r PreparationRecord) Validate() error {
+	if r.Preparation.Validate() != nil || r.Native != nil && !validWorkspaceRef(*r.Native) {
+		return ErrPreparation
+	}
+	if reflect.DeepEqual(r.State, PreparationState{}) {
+		return nil
+	}
+	if r.State.ValidateFor(PreparationAddress{Workspace: r.Preparation.Project, ID: r.Preparation.ID, Native: r.Native}) != nil {
+		return ErrPreparation
+	}
+	if r.State.Role != "" && r.State.Role != r.Preparation.Role || r.State.SourceCommit != "" && r.State.SourceCommit != r.Preparation.SourceCommit || r.State.SetupDigest != "" && r.State.SetupDigest != r.Preparation.SetupDigest {
+		return ErrPreparation
+	}
+	return nil
+}
diff --git a/internal/factory/execution/preparation_context.go b/internal/factory/execution/preparation_context.go
new file mode 100644
index 0000000000000000000000000000000000000000..bc4136b96027073df23455bbae07d68ba685741e
--- /dev/null
+++ b/internal/factory/execution/preparation_context.go
@@ -0,0 +1,49 @@
+package execution
+
+import (
+	"context"
+	"errors"
+
+	"github.com/levitateos/sodaos/internal/project"
+)
+
+var (
+	ErrPreparationContext       = errors.New("invalid workspace preparation context")
+	ErrPreparationContextBounds = errors.New("workspace preparation context exceeds bounds")
+)
+
+// PreparationContextRequest binds transient approved files/diffs to the captured
+// checkout owner. Repository paths are relative selections, never host paths.
+type PreparationContextRequest struct {
+	Input  project.FactoryPreparationContextRequest `json:"input"`
+	Role   string                                   `json:"role"`
+	Native *NativeWorkspaceRef                      `json:"native,omitempty"`
+}
+
+func (r PreparationContextRequest) Address() PreparationAddress {
+	return PreparationAddress{Workspace: r.Input.Project, ID: r.Input.ID, Native: r.Native}
+}
+
+func (r PreparationContextRequest) Validate() error {
+	if r.Input.Validate() != nil || r.Address().Validate() != nil || !project.ValidFactoryRole(r.Role) {
+		return ErrPreparationContext
+	}
+	return nil
+}
+
+type PreparationContext struct {
+	Material project.FactoryPreparationContext `json:"material"`
+	Native   *NativeWorkspaceRef               `json:"native,omitempty"`
+}
+
+func (c PreparationContext) ValidateFor(r PreparationContextRequest) error {
+	if r.Validate() != nil || c.Material.ValidateFor(r.Input, r.Role) != nil ||
+		(r.Native == nil) != (c.Native == nil) || r.Native != nil && *r.Native != *c.Native {
+		return ErrPreparationContext
+	}
+	return nil
+}
+
+type PreparationContextReader interface {
+	ReadWorkspaceContext(context.Context, PreparationContextRequest) (PreparationContext, error)
+}
diff --git a/internal/factory/execution/provenance.go b/internal/factory/execution/provenance.go
new file mode 100644
index 0000000000000000000000000000000000000000..25e435b895827541cb3b07e4c5d813358af49288
--- /dev/null
+++ b/internal/factory/execution/provenance.go
@@ -0,0 +1,286 @@
+// Package execution owns provider-neutral run evidence. Runtime adapters supply
+// observations; these records do not launch processes or claim isolation.
+package execution
+
+import (
+	"errors"
+	"path/filepath"
+	"time"
+
+	"github.com/levitateos/sodaos/internal/collaboration"
+	"github.com/levitateos/sodaos/internal/factory/access"
+)
+
+type (
+	Retirement   string
+	CustodyState string
+)
+
+const (
+	NotStarted       Retirement   = "not_started"
+	Running          Retirement   = "running"
+	Exited           Retirement   = "exited"
+	Retired          Retirement   = "retired"
+	Uncertain        Retirement   = "uncertain"
+	NotAcquired      CustodyState = "not_acquired"
+	Held             CustodyState = "held"
+	Released         CustodyState = "released"
+	CustodyUncertain CustodyState = "uncertain"
+)
+
+var ErrProvenance = errors.New("invalid factory execution provenance")
+
+// Provenance is INTERNAL retained evidence with exactly one runtime variant.
+// PlacementGeneration fences the dispatch; it is not the broker credential or
+// appliance boundary generation. Unknown observations never become empty success.
+type Provenance struct {
+	RunID               string                    `json:"run_id"`
+	Runtime             collaboration.RuntimeID   `json:"runtime"`
+	PlacementGeneration int64                     `json:"placement_generation,string"`
+	Kind                collaboration.RuntimeKind `json:"kind"`
+	Retirement          Retirement                `json:"retirement"`
+	Native              *NativeProvenance         `json:"native"`
+	Appliance           *ApplianceProvenance      `json:"appliance"`
+}
+
+// NativeProvenance describes trusted same-user host execution, with no container,
+// image, systemd unit, isolated UID or broker-return claim. Profile/instance/
+// invocation distinguish process lifetimes; a reused PID alone is not identity.
+// Native selectable-executor qualification remains the separate D3 gate.
+type NativeProvenance struct {
+	TrustMode  string                  `json:"trust_mode"` // only same_user_trusted_host
+	Profile    collaboration.ProfileID `json:"profile"`
+	InstanceID string                  `json:"instance_id"`
+	WorktreeID string                  `json:"worktree_id"`
+	Process    *NativeProcess          `json:"process"`
+	Custody    NativeCustody           `json:"custody"`
+}
+
+// Local executable paths are server-side metadata, never browser instructions.
+// The digest identifies the captured bytes of this invocation across updates.
+type NativeProcess struct {
+	InvocationID     string    `json:"invocation_id"`
+	SystemInstance   string    `json:"system_instance"`
+	StartIdentity    string    `json:"start_identity"`
+	PID              int       `json:"pid"`
+	StartedAt        time.Time `json:"started_at"`
+	Executable       string    `json:"executable"`
+	ExecutableSHA256 string    `json:"executable_sha256"`
+	ExitCode         *int      `json:"exit_code"`
+	ExitSignal       *string   `json:"exit_signal"`
+}
+
+// Released confirms retirement of THIS run's delivered credential material and
+// acquisition. It cannot prove that a same-user child never copied a secret or
+// that the user's global provider login was erased. Unconfirmed cleanup fences.
+type NativeCustody struct {
+	State         CustodyState                `json:"state"`
+	AcquisitionID string                      `json:"acquisition_id"`
+	Connection    access.ProviderConnectionID `json:"connection"`
+	Generation    int64                       `json:"generation,string"`
+}
+
+// Appliance evidence preserves the existing host boundary and broker facts.
+// Boundary can be absent for a pre-launch stop tombstone. Do not fill it from
+// native host process fields or infer successful credential return from exit.
+type ApplianceProvenance struct {
+	Boundary           *ApplianceBoundary `json:"boundary"`
+	Broker             BrokerObservation  `json:"broker"`
+	CredentialReturned bool               `json:"credential_returned"`
+}
+
+type ApplianceBoundary struct {
+	ApplianceInvocation
+	Image string `json:"image"`
+}
+
+// ApplianceInvocation contains only the boundary facts actually returned by
+// run inspection. An image is supplied separately by captured admission.
+type ApplianceInvocation struct {
+	Project    string `json:"project"`
+	Generation int64  `json:"generation,string"`
+	Container  string `json:"container"`
+	Unit       string `json:"unit"`
+	Invocation string `json:"invocation"`
+	UID        int    `json:"uid"`
+	GID        int    `json:"gid"`
+	Login      string `json:"login"`
+}
+
+func (p ApplianceInvocation) ValidateFor(workspace string, generation int64) error {
+	if p.Project != workspace || !collaboration.ValidText(p.Invocation, 128) ||
+		p.Generation < 0 || p.UID < 0 || p.GID < 0 ||
+		(p.Generation > 0 && generation > 0 && p.Generation != generation) ||
+		!optionalText(p.Container, 128) || !optionalText(p.Unit, 256) || !optionalText(p.Login, 128) {
+		return ErrProvenance
+	}
+	return nil
+}
+
+// Retain combines a later observation with already witnessed fields. Empty/zero
+// boundary fields mean unknown, not permission to erase a known process fact.
+func (p ApplianceInvocation) Retain(prior ApplianceInvocation) (ApplianceInvocation, error) {
+	text := [][2]*string{{&p.Project, &prior.Project}, {&p.Container, &prior.Container}, {&p.Unit, &prior.Unit}, {&p.Invocation, &prior.Invocation}, {&p.Login, &prior.Login}}
+	for _, pair := range text {
+		if *pair[0] == "" {
+			*pair[0] = *pair[1]
+		}
+	}
+	if p.Generation == 0 {
+		p.Generation = prior.Generation
+	}
+	if p.UID == 0 {
+		p.UID = prior.UID
+	}
+	if p.GID == 0 {
+		p.GID = prior.GID
+	}
+	if !p.Advances(prior) {
+		return ApplianceInvocation{}, ErrRunChanged
+	}
+	return p, nil
+}
+
+func (p ApplianceInvocation) Advances(prior ApplianceInvocation) bool {
+	for _, pair := range [][2]string{{prior.Project, p.Project}, {prior.Container, p.Container}, {prior.Unit, p.Unit}, {prior.Invocation, p.Invocation}, {prior.Login, p.Login}} {
+		if pair[0] != "" && pair[0] != pair[1] {
+			return false
+		}
+	}
+	return p.Generation >= 0 && p.UID >= 0 && p.GID >= 0 && (prior.Generation == 0 || p.Generation == prior.Generation) && (prior.UID == 0 || p.UID == prior.UID) && (prior.GID == 0 || p.GID == prior.GID)
+}
+
+// BrokerObservation retains the separate credential boundary. A nil binding and
+// empty lease are valid on a confirmed pre-acquisition terminal tombstone; an
+// unreachable broker is represented by uncertain custody, never terminal proof.
+type BrokerObservation struct {
+	ExecutionID string         `json:"execution_id"`
+	State       CustodyState   `json:"state"`
+	Digest      string         `json:"digest"`
+	LeaseID     string         `json:"lease_id"`
+	Binding     *BrokerBinding `json:"binding"`
+}
+
+type BrokerBinding struct {
+	Kind string `json:"kind,omitempty"`
+	// Server-side retained metadata only; never a credential delivery or a
+	// browser path selector. Original broker identity comparisons retain it.
+	CredentialRoot string `json:"credential_root,omitempty"`
+	ID             string `json:"id"`
+	Generation     int64  `json:"generation,string"`
+	Invocation     string `json:"invocation"`
+	// Factory broker "project" is the container boundary, not a workspace.
+	Boundary string `json:"project"`
+	ChildID  string `json:"child_id"`
+	Scope    string `json:"scope"`
+	UID      int    `json:"uid"`
+	GID      int    `json:"gid"`
+	Login    string `json:"login"`
+}
+
+func (p Provenance) Validate() error {
+	if !collaboration.ValidText(p.RunID, 128) || !collaboration.ValidID(string(p.Runtime)) || p.PlacementGeneration <= 0 ||
+		(p.Retirement != NotStarted && p.Retirement != Running && p.Retirement != Exited && p.Retirement != Retired && p.Retirement != Uncertain) {
+		return ErrProvenance
+	}
+	switch p.Kind {
+	case collaboration.Native:
+		if p.Native == nil || p.Appliance != nil || !validNative(*p.Native) ||
+			((p.Retirement == Running || p.Retirement == Exited) && p.Native.Process == nil) {
+			return ErrProvenance
+		}
+	case collaboration.Appliance:
+		if p.Appliance == nil || p.Native != nil || !validAppliance(*p.Appliance, p.RunID) ||
+			((p.Retirement == Running || p.Retirement == Exited) && p.Appliance.Boundary == nil) {
+			return ErrProvenance
+		}
+	default:
+		return ErrProvenance
+	}
+	return nil
+}
+
+// Settled reports recorded retirement AND custody evidence. It does not perform
+// OS/broker inspection or authorize reservation release without reconciliation.
+func (p Provenance) Settled() bool {
+	if p.Validate() != nil || p.Retirement != Retired {
+		return false
+	}
+	if p.Native != nil {
+		return p.Native.Custody.State == Released || p.Native.Custody.State == NotAcquired
+	}
+	a := p.Appliance
+	return a.Broker.State == Released && (a.CredentialReturned || (a.Boundary == nil && a.Broker.Binding == nil && a.Broker.LeaseID == ""))
+}
+
+func validNative(n NativeProvenance) bool {
+	if n.TrustMode != "same_user_trusted_host" || !collaboration.ValidID(string(n.Profile)) ||
+		!collaboration.ValidID(n.InstanceID) || !collaboration.ValidText(n.WorktreeID, 128) || !validCustody(n.Custody.State) {
+		return false
+	}
+	if !validNativeCustody(n.Custody) {
+		return false
+	}
+	if n.Process == nil {
+		return true
+	}
+	p := n.Process
+	return collaboration.ValidID(p.InvocationID) && p.PID > 0 && !p.StartedAt.IsZero() &&
+		collaboration.ValidText(p.SystemInstance, 128) && collaboration.ValidText(p.StartIdentity, 128) &&
+		filepath.IsAbs(p.Executable) && collaboration.ValidText(p.Executable, 4096) && validDigest(p.ExecutableSHA256) &&
+		(p.ExitCode == nil || *p.ExitCode >= 0 && *p.ExitCode <= 255) &&
+		(p.ExitSignal == nil || collaboration.ValidText(*p.ExitSignal, 128)) &&
+		(p.ExitCode == nil || p.ExitSignal == nil)
+}
+
+func validNativeCustody(c NativeCustody) bool {
+	if !validCustody(c.State) {
+		return false
+	}
+	if c.State == NotAcquired {
+		return c.AcquisitionID == "" && c.Connection == "" && c.Generation == 0
+	}
+	return collaboration.ValidText(c.AcquisitionID, 128) && collaboration.ValidText(string(c.Connection), 128) && c.Generation > 0
+}
+
+func validAppliance(a ApplianceProvenance, runID string) bool {
+	b := a.Broker
+	if b.ExecutionID != runID || !validCustody(b.State) || (b.Digest != "" && !validDigest(b.Digest)) ||
+		!optionalText(b.LeaseID, 128) {
+		return false
+	}
+	if b.State == Held && (b.Digest == "" || b.LeaseID == "" || b.Binding == nil) {
+		return false
+	}
+	if b.Binding != nil {
+		v := b.Binding
+		if !collaboration.ValidText(v.ID, 128) || v.Generation <= 0 || !collaboration.ValidText(v.Boundary, 128) ||
+			!optionalText(v.Invocation, 128) || !optionalText(v.ChildID, 128) || !optionalText(v.Scope, 256) ||
+			v.UID < 0 || v.GID < 0 || !optionalText(v.Login, 128) {
+			return false
+		}
+	}
+	if a.Boundary == nil {
+		return true
+	}
+	v := a.Boundary
+	return collaboration.ValidText(v.Project, 128) && v.Generation > 0 && collaboration.ValidText(v.Image, 256) &&
+		collaboration.ValidText(v.Container, 128) && collaboration.ValidText(v.Unit, 256) &&
+		collaboration.ValidText(v.Invocation, 128) && v.UID > 0 && v.GID > 0 && collaboration.ValidText(v.Login, 128)
+}
+
+func validCustody(s CustodyState) bool {
+	return s == NotAcquired || s == Held || s == Released || s == CustodyUncertain
+}
+func optionalText(s string, limit int) bool { return s == "" || collaboration.ValidText(s, limit) }
+func validDigest(s string) bool {
+	if len(s) != 64 {
+		return false
+	}
+	for _, c := range s {
+		if !(c >= 'a' && c <= 'f' || c >= '0' && c <= '9') {
+			return false
+		}
+	}
+	return true
+}
diff --git a/internal/factory/execution/recovery.go b/internal/factory/execution/recovery.go
new file mode 100644
index 0000000000000000000000000000000000000000..ecabcf9cdddb2a40227f594ccd21605dc54f8562
--- /dev/null
+++ b/internal/factory/execution/recovery.go
@@ -0,0 +1,101 @@
+package execution
+
+import (
+	"context"
+	"errors"
+
+	"github.com/levitateos/sodaos/internal/collaboration"
+	"github.com/levitateos/sodaos/internal/project"
+)
+
+var ErrRecovery = errors.New("invalid execution work recovery binding")
+
+type NativeWorkspaceRef struct {
+	Profile    collaboration.ProfileID `json:"profile"`
+	InstanceID string                  `json:"instance_id"`
+	WorktreeID string                  `json:"worktree_id"`
+}
+
+type NativeCheckoutRef struct {
+	Profile    collaboration.ProfileID `json:"profile"`
+	CheckoutID string                  `json:"checkout_id"`
+}
+
+type NativeRecovery struct {
+	Source NativeWorkspaceRef `json:"source"`
+	Target NativeCheckoutRef  `json:"target"`
+}
+
+// RecoveryTarget selects a registered native checkout or an admitted appliance
+// member. It supplies no arbitrary destination path or spending authority.
+type RecoveryTarget struct {
+	Member string
+	Native *NativeCheckoutRef
+}
+
+func (t RecoveryTarget) Key() string {
+	if t.Native != nil {
+		return "native/" + string(t.Native.Profile) + "/" + t.Native.CheckoutID
+	}
+	return t.Member
+}
+
+type WorkRecoveryRequest struct {
+	Address RunAddress
+	Member  string
+	Native  *NativeRecovery
+}
+
+func (r WorkRecoveryRequest) Target() RecoveryTarget {
+	if r.Native != nil {
+		return RecoveryTarget{Native: &r.Native.Target}
+	}
+	return RecoveryTarget{Member: r.Member}
+}
+
+func (r WorkRecoveryRequest) Validate() error {
+	if r.Address.Validate() != nil || !project.ValidFactoryRunID(r.Address.Run) {
+		return ErrRecovery
+	}
+	if r.Native == nil {
+		if !project.ValidID(r.Address.Workspace) || !project.ValidLogin(r.Member) || r.Member == "root" {
+			return ErrRecovery
+		}
+	} else {
+		n := r.Native
+		if r.Member != "" || !collaboration.ValidID(string(n.Source.Profile)) || !collaboration.ValidID(n.Source.InstanceID) || !collaboration.ValidText(n.Source.WorktreeID, 128) || n.Target.Profile != n.Source.Profile || !collaboration.ValidID(n.Target.CheckoutID) {
+			return ErrRecovery
+		}
+	}
+	return nil
+}
+
+func (r WorkRecoveryRequest) Equal(other WorkRecoveryRequest) bool {
+	return r.Address == other.Address && r.Member == other.Member && (r.Native == nil && other.Native == nil || r.Native != nil && other.Native != nil && *r.Native == *other.Native)
+}
+
+// The native result addresses the registered checkout by reference. Appliance
+// destinations retain their fixed member-home path, derived by the host.
+type WorkRecoveryReceipt struct {
+	Request     WorkRecoveryRequest
+	Destination string
+	Reused      bool
+}
+
+func (r WorkRecoveryReceipt) ValidateFor(request WorkRecoveryRequest) error {
+	if request.Validate() != nil || !r.Request.Equal(request) {
+		return ErrRecovery
+	}
+	if request.Native != nil {
+		if r.Destination != "" {
+			return ErrRecovery
+		}
+	} else if r.Destination != project.TakeoverDestination(request.Member, request.Address.Run) {
+		return ErrRecovery
+	}
+	return nil
+}
+
+type WorkRecoverer interface {
+	RecoverWork(context.Context, WorkRecoveryRequest) (WorkRecoveryReceipt, error)
+}
