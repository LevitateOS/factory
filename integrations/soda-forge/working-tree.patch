+		if err != nil {
+			requestDone <- err
+			return
+		}
+		req.Header.Set("Authorization", "Bearer declared-product-client")
+		response, err := heldClient.Do(req)
+		if response != nil {
+			_ = response.Body.Close()
+		}
+		requestDone <- err
+	}()
