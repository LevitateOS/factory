+/* Feed post kit version 2: the byline above the card, a state edge and pill
+   before a one-sentence headline, the Next line, and small steps as one-line
+   comments under the post. Role colour stays on the avatar only. */
+.soda-feed {
+  --soda-feed-attn: var(--soda-page-action);
+  --soda-feed-on-attn: var(--soda-page-on-action);
+  --soda-feed-bad: light-dark(#b3261e, #ff8a80);
+  --soda-feed-bad-bg: light-dark(#fbe5e3, #3b1614);
+  --soda-feed-warn: light-dark(#8a5a00, #ffc46b);
+  --soda-feed-warn-bg: light-dark(#fff2d6, #35270d);
+  --soda-feed-ok: light-dark(#13613d, #7fd4a6);
+  --soda-feed-ok-bg: light-dark(#e3f2e9, #15301f);
+  --soda-feed-neu: light-dark(#3a3a3a, #d6d6d6);
+  --soda-feed-neu-bg: light-dark(#f1eced, #2a2a2a);
+  --soda-feed-line: color-mix(in srgb, var(--soda-page-edge) 55%, var(--soda-page-surface));
+  --soda-feed-faint: color-mix(in srgb, var(--soda-page-muted) 70%, var(--soda-page-surface));
+}
+.soda-feed-list {
+  gap: 24px;
+}
+.soda-feed-post {
+  --soda-feed-edge: var(--soda-feed-line);
+  --soda-feed-tint: var(--soda-page-selected);
+}
+.soda-feed-post .soda-feed-header {
+  gap: 8px;
+  padding: 0 0 6px 2px;
+  align-items: center;
+}
+.soda-feed-post .soda-feed-avatar {
+  flex-basis: 28px;
+  width: 28px;
+  height: 28px;
+  border-radius: 50%;
+  border: 0;
+  background: var(--soda-feed-role-color);
+  color: #fff;
+  font-size: 11px;
+  font-weight: 700;
+  line-height: 1;
+}
+.soda-feed-post .soda-feed-header p {
+  margin: 0;
+  display: flex;
+  flex-wrap: wrap;
+  align-items: baseline;
+  gap: 2px 8px;
+  font-size: 14px;
+  color: var(--soda-page-text);
+}
+.soda-feed-post .soda-feed-header strong {
+  color: var(--soda-page-text);
+  font-weight: 600;
+}
+.soda-feed-by-role {
+  color: var(--soda-page-muted);
+}
+.soda-feed-by-meta {
+  color: var(--soda-page-muted);
+  font-size: 13.5px;
+}
+.soda-feed-by-meta i {
+  font-style: normal;
+  padding: 0 5px;
+  color: var(--soda-feed-faint);
+}
+.soda-feed-by-meta a {
+  color: inherit;
+  text-decoration: underline;
+  text-underline-offset: 2px;
+}
+.soda-feed-post .soda-feed-card {
+  position: relative;
+  overflow: hidden;
+  display: grid;
+  gap: 12px;
+  padding: 14px 16px 14px 20px;
+  border: 1px solid var(--soda-feed-line);
+  border-radius: 10px;
+  background: var(--soda-page-surface);
+}
+.soda-feed-post .soda-feed-card > * {
+  margin: 0;
+}
+.soda-feed-post .soda-feed-card::before {
+  content: '';
+  position: absolute;
+  left: 0;
+  top: 0;
+  bottom: 0;
+  width: 5px;
+  background: var(--soda-feed-state-edge, transparent);
+}
+.soda-feed-card[data-state='needs_you'] {
+  --soda-feed-state-edge: var(--soda-feed-attn);
+  border: 2px solid var(--soda-feed-attn);
+  padding: 13px 15px 13px 19px;
+}
+.soda-feed-card[data-state='problem'] {
+  --soda-feed-state-edge: repeating-linear-gradient(135deg, var(--soda-feed-bad) 0 3px, transparent 3px 6px);
+}
+.soda-feed-card[data-state='waiting'] {
+  --soda-feed-state-edge: repeating-linear-gradient(180deg, var(--soda-feed-warn) 0 7px, transparent 7px 11px);
+}
+.soda-feed-card[data-state='in_progress'] {
+  --soda-feed-state-edge: repeating-linear-gradient(135deg, var(--soda-page-text) 0 2px, transparent 2px 5px);
+}
+.soda-feed-card[data-state='done'] {
+  --soda-feed-state-edge: var(--soda-feed-ok);
+}
+.soda-feed-card[data-state='decided'] {
+  --soda-feed-state-edge: var(--soda-feed-faint);
+}
+/* An ordinary question reads as conversation: the question once, then the reply box. */
+.soda-feed-question {
