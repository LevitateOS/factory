index 0000000000000000000000000000000000000000..9ded46ce2cfd9aaa85a904cce10e4f0f486d6217
--- /dev/null
+++ b/internal/factory/service/repair_funding.go
@@ -0,0 +1,162 @@
+package service
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"time"
+
+	"github.com/levitateos/sodaos/internal/collaboration"
+	"github.com/levitateos/sodaos/internal/factory"
+	"github.com/levitateos/sodaos/internal/store"
+)
+
+type RepairFundingChange struct {
+	CommandID         string `json:"command_id"`
+	ExpectedRevision  int64  `json:"expected_revision"`
+	InvestigatorRuns  int    `json:"investigator_runs"`
+	ProposalJudgments int    `json:"proposal_judgments"`
+	ActiveMinutes     int    `json:"active_minutes"`
+	Effect            string `json:"effect"`
+	Active            bool   `json:"active"`
+}
+
+type RepairFundingView struct {
+	Revision int64                       `json:"revision"`
+	Grant    *factory.RepairGrant        `json:"grant"`
+	Charges  []factory.RepairCharge      `json:"charges"`
+	Episodes []factory.RepairEpisodeView `json:"episodes"`
+}
+
+// RepairFunding uses the existing repair command/charge journal. The admitted
+// canonical sponsor and authenticated host principal remain separate. Neither
+// saving permission nor reading history grants custody or launches work.
+type RepairFunding struct {
+	Store          *store.Store
+	Administration RequestWriteAccess
+}
+
+var (
+	ErrRepairFundingUnavailable = errors.New("repair funding admission is unavailable")
+	ErrRepairFundingAccess      = errors.New("current repository administration is required for repair funding")
+	ErrRepairFundingInvalid     = errors.New("repair funding limits or scope are invalid")
+	ErrRepairFundingCommand     = errors.New("repair funding command identity is invalid")
+	ErrRepairFundingScope       = errors.New("repair funding journal scope differs from its repository")
+	ErrRepairFundingIncrease    = errors.New("repair funding increase must state its effect")
+	ErrRepairFundingSponsor     = errors.New("the recorded repair sponsor is required")
+)
+
+func (s RepairFunding) authorize(ctx context.Context, actor collaboration.ActorID, repository collaboration.RepositoryID) error {
+	if actor < 1 || repository < 1 {
+		return ErrRepairFundingInvalid
+	}
+	if s.Store == nil || s.Administration == nil {
+		return ErrRepairFundingUnavailable
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if err := s.Administration(ctx, actor, int64(repository)); err != nil {
+		return errors.Join(ErrRepairFundingAccess, err)
+	}
+	return ctx.Err()
+}
+
+func (s RepairFunding) Read(ctx context.Context, actor collaboration.ActorID, repository collaboration.RepositoryID) (*RepairFundingView, error) {
+	if err := s.authorize(ctx, actor, repository); err != nil {
+		return nil, err
+	}
+	view := &RepairFundingView{Charges: []factory.RepairCharge{}, Episodes: []factory.RepairEpisodeView{}}
+	grant, err := s.Store.RepairGrantCommand(ctx, int64(repository))
+	if err == nil {
+		if grant.Repository != int64(repository) || grant.Validate() != nil {
+			return nil, ErrRepairFundingScope
+		}
+		view.Grant, view.Revision = &grant, grant.Revision+1
+		charges, err := s.Store.RepairCharges(ctx, int64(repository))
+		if err != nil {
+			return nil, err
+		}
+		view.Charges = append(view.Charges, charges...)
+		view.Episodes, err = s.Store.RepairEpisodeViews(ctx, int64(repository))
+		if err != nil {
+			return nil, err
+		}
+	} else if !errors.Is(err, store.ErrNotFound) {
+		return nil, err
+	}
+	if err := s.authorize(ctx, actor, repository); err != nil {
+		return nil, err
+	}
+	return view, nil
+}
+
+// Apply preserves a captured command's timestamp/head on exact replay. New
+// revisions must explicitly increase limits without resetting prior consumption.
+// The store's transaction remains the final predecessor/CAS/replay owner.
+func (s RepairFunding) Apply(ctx context.Context, actor collaboration.ActorID, principal string, repository collaboration.RepositoryID, in RepairFundingChange) (factory.GrantResult, error) {
+	var empty factory.GrantResult
+	if !factory.ValidID(in.CommandID) {
+		return empty, ErrRepairFundingCommand
+	}
+	if in.ExpectedRevision < 0 || principal == "" || len(principal) > 128 {
+		return empty, ErrRepairFundingInvalid
+	}
+	if err := s.authorize(ctx, actor, repository); err != nil {
+		return empty, err
+	}
+	grant := factory.RepairGrant{ID: in.CommandID, Repository: int64(repository), Sponsor: int64(actor), InvestigatorRuns: in.InvestigatorRuns,
+		ProposalJudgments: in.ProposalJudgments, ActiveMinutes: in.ActiveMinutes, Effect: in.Effect, Active: in.Active, CreatedUnix: time.Now().Unix()}
+	priorCommand, err := s.Store.FactoryCommand(ctx, in.CommandID)
+	if err == nil {
+		var prior factory.RepairGrant
+		if priorCommand.Type != factory.CommandRepairGrant || priorCommand.Target != factory.RepairTarget(int64(repository)) || priorCommand.Principal != principal ||
+			json.Unmarshal([]byte(priorCommand.Payload), &prior) != nil || prior.ID != in.CommandID || prior.Repository != int64(repository) || prior.Sponsor != int64(actor) || prior.Validate() != nil {
+			return empty, store.ErrCommandConflict
+		}
+		grant.CreatedUnix, grant.Predecessor, grant.Revision = prior.CreatedUnix, prior.Predecessor, prior.Revision
+		if in.ExpectedRevision != grant.Revision {
+			return empty, store.ErrCommandConflict
+		}
+	} else if !errors.Is(err, store.ErrNotFound) {
+		return empty, err
+	} else {
+		current, err := s.Store.RepairGrantCommand(ctx, int64(repository))
+		if err == nil {
+			if current.Repository != int64(repository) || current.Validate() != nil {
+				return empty, ErrRepairFundingScope
+			}
+			if in.ExpectedRevision != current.Revision+1 {
+				return empty, store.ErrStaleRevision
+			}
+			if current.Sponsor != int64(actor) {
+				return empty, ErrRepairFundingSponsor
+			}
+			if (grant.InvestigatorRuns > current.InvestigatorRuns || grant.ProposalJudgments > current.ProposalJudgments || grant.ActiveMinutes > current.ActiveMinutes) && grant.Effect == "" {
+				return empty, ErrRepairFundingIncrease
+			}
+			grant.Revision, grant.Predecessor = current.Revision+1, current.ID
+		} else if !errors.Is(err, store.ErrNotFound) {
+			return empty, err
+		} else if in.ExpectedRevision != 0 {
+			return empty, store.ErrStaleRevision
+		}
+	}
+	if grant.Validate() != nil {
+		return empty, ErrRepairFundingInvalid
+	}
+	raw, err := json.Marshal(grant)
+	if err != nil {
+		return empty, err
+	}
+	command := factory.Command{ID: in.CommandID, Type: factory.CommandRepairGrant, Target: factory.RepairTarget(int64(repository)), Principal: principal, Payload: string(raw)}
+	command.Digest = factory.SettingsDigest(command.Type, command.Target, command.Payload)
+	if err := s.authorize(ctx, actor, repository); err != nil {
+		return empty, err
+	}
+	recorded, _, err := s.Store.ApplyRepairGrantCommand(ctx, command, grant, time.Now())
+	if err != nil {
+		return empty, err
+	}
+	return factory.GrantResult{CommandID: recorded.ID, Revision: grant.Revision + 1}, nil
+}
diff --git a/internal/factory/service/repositories.go b/internal/factory/service/repositories.go
new file mode 100644
index 0000000000000000000000000000000000000000..12b0d77c3e4f25b8c89be9731dadc5969a99fcfc
--- /dev/null
+++ b/internal/factory/service/repositories.go
@@ -0,0 +1,82 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"strconv"
+
+	"github.com/levitateos/sodaos/internal/collaboration"
+	"github.com/levitateos/sodaos/internal/store"
+)
+
+var (
+	ErrRepositoryCatalogueInvalid     = errors.New("invalid repository catalogue query")
+	ErrRepositoryCatalogueUnavailable = errors.New("repository catalogue unavailable")
+	ErrRepositoryHidden               = errors.New("repository is not visible to this actor")
+)
+
+// RepositoryVisibility supplies current authority and display metadata for a
+// canonical identity. Only confirmed denial returns ErrRepositoryHidden; unknown
+// access must return its error so an outage cannot masquerade as an empty list.
+type RepositoryVisibility func(context.Context, collaboration.ActorID, collaboration.RepositoryID) (string, error)
+
+type Repositories struct {
+	Store      *store.Store
+	Visibility RepositoryVisibility
+}
+
+type RepositoryQuery struct {
+	After collaboration.RepositoryID
+	Limit int
+}
+
+type RepositoryChoice struct {
+	Repository collaboration.RepositoryID `json:"repository,string"`
+	Name       string                     `json:"name"`
+}
+
+// Complete describes this registered-ledger traversal, not all repositories on
+// a provider. Provider discovery/enrollment belongs to its admitted adapter.
+type RepositoryCatalogue struct {
+	Items     []RepositoryChoice `json:"items"`
+	NextAfter string             `json:"next_after"`
+	Complete  bool               `json:"complete"`
+}
+
+func (s Repositories) Catalogue(ctx context.Context, actor collaboration.ActorID, query RepositoryQuery) (RepositoryCatalogue, error) {
+	if actor < 1 || query.After < 0 || query.Limit < 1 || query.Limit > 100 {
+		return RepositoryCatalogue{}, ErrRepositoryCatalogueInvalid
+	}
+	if s.Store == nil || s.Visibility == nil {
+		return RepositoryCatalogue{}, ErrRepositoryCatalogueUnavailable
+	}
+	refs, err := s.Store.CollaborationRepositoryWindow(ctx, query.After, query.Limit)
+	if err != nil {
+		return RepositoryCatalogue{}, err
+	}
+	page := RepositoryCatalogue{Items: make([]RepositoryChoice, 0, query.Limit), Complete: len(refs) <= query.Limit}
+	if !page.Complete {
+		refs = refs[:query.Limit]
+		page.NextAfter = strconv.FormatInt(int64(refs[len(refs)-1].ID), 10)
+	}
+	for _, ref := range refs {
+		if err := ctx.Err(); err != nil {
+			return RepositoryCatalogue{}, err
+		}
+		name, err := s.Visibility(ctx, actor, ref.ID)
+		if errors.Is(err, ErrRepositoryHidden) {
+			continue
+		}
+		if err != nil {
+			return RepositoryCatalogue{}, err
+		}
+		if !collaboration.ValidText(name, 512) {
+			return RepositoryCatalogue{}, ErrRepositoryCatalogueUnavailable
+		}
+		page.Items = append(page.Items, RepositoryChoice{Repository: ref.ID, Name: name})
+	}
+	if err := ctx.Err(); err != nil {
+		return RepositoryCatalogue{}, err
+	}
+	return page, nil
+}
diff --git a/internal/factory/service/repository_access.go b/internal/factory/service/repository_access.go
new file mode 100644
index 0000000000000000000000000000000000000000..1d56581531d9a56f977e04b2c62700f4a745119d
--- /dev/null
+++ b/internal/factory/service/repository_access.go
@@ -0,0 +1,105 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"strconv"
+	"time"
+
+	"github.com/levitateos/sodaos/internal/collaboration"
+	"github.com/levitateos/sodaos/internal/factory"
+	"github.com/levitateos/sodaos/internal/store"
+)
+
+// RepositoryAccess assembles current settings powers and private usage. Viewer
+// supplies host authority/membership facts; Connections supplies only connection
+// IDs owned by the admitted actor. A failed ownership read withholds all usage.
+// Every save still requires admission at its owning command, independently.
+type RepositoryAccess struct {
+	Store       *store.Store
+	Visibility  WorkVisibility
+	Viewer      func(context.Context, collaboration.ActorID, collaboration.RepositoryID) (RepositoryViewer, error)
+	Connections func(context.Context, collaboration.ActorID, collaboration.RepositoryID) (map[string]bool, error)
+	Preparation func(context.Context, collaboration.ActorID, collaboration.RepositoryID) (*RepositoryPreparation, error)
+	Authority   func(context.Context, collaboration.ActorID, collaboration.RepositoryID) (factory.EffectiveAuthority, error)
+}
+
+var (
+	ErrRepositoryAccessInvalid     = errors.New("repository access scope is invalid")
+	ErrRepositoryAccessUnavailable = errors.New("repository access runtime is unavailable")
+	ErrRepositoryAccessVisibility  = errors.New("current repository access visibility is required")
+	ErrRepositoryAccessViewer      = errors.New("repository viewer authority is unavailable")
+	ErrRepositoryAccessPreparation = errors.New("repository access preparation is unavailable")
+)
+
+func (s RepositoryAccess) Read(ctx context.Context, actor collaboration.ActorID, repository collaboration.RepositoryID) (*RepositoryAccessView, error) {
+	if actor < 1 || repository < 1 {
+		return nil, ErrRepositoryAccessInvalid
+	}
+	if s.Store == nil || s.Visibility == nil || s.Viewer == nil || s.Connections == nil || s.Preparation == nil || s.Authority == nil {
+		return nil, ErrRepositoryAccessUnavailable
+	}
+	authorize := func() error {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		if err := s.Visibility(ctx, actor, repository); err != nil {
+			return errors.Join(ErrRepositoryAccessVisibility, err)
+		}
+		return ctx.Err()
+	}
+	if err := authorize(); err != nil {
+		return nil, err
+	}
+	viewer, err := s.Viewer(ctx, actor, repository)
+	if err != nil {
+		return nil, errors.Join(ErrRepositoryAccessViewer, err)
+	}
+	sponsorships, err := s.Store.Sponsorships(ctx, int64(repository))
+	if err != nil {
+		return nil, err
+	}
+	editable := accessEditableInput{Viewer: viewer}
+	for _, sponsorship := range sponsorships {
+		if sponsorship.Repository != int64(repository) {
+			return nil, ErrWorkJourneyScope
+		}
+		editable.Connections = append(editable.Connections, sponsorship.Connection)
+	}
+	owned, err := s.Connections(ctx, actor, repository)
+	if err == nil {
+		editable.IdentityOK, editable.Owned = true, owned
+	}
+	view := &RepositoryAccessView{Viewer: viewer, Editable: accessEditableDTO(editable),
+		Repository: strconv.FormatInt(int64(repository), 10), ObservedUnix: time.Now().Unix(),
+		RequiredActs: []accessActionView{}, Usage: []accessUsageView{}}
+	view.Effective, err = s.Authority(ctx, actor, repository)
+	if err != nil {
+		return nil, err
+	}
+	view.RequiredActs = accessRequiredActions(view.Effective.Missing)
+	view.Preparation, err = s.Preparation(ctx, actor, repository)
+	if err != nil {
+		return nil, errors.Join(ErrRepositoryAccessPreparation, err)
+	}
+	if view.Preparation != nil && view.Preparation.Project == "" {
+		return nil, ErrRepositoryAccessPreparation
+	}
+	for _, sponsorship := range sponsorships {
+		if !editable.IdentityOK {
+			view.Usage = append(view.Usage, accessUsageView{Connection: sponsorship.Connection, Unit: "minutes", Status: accessUsageIdentityDown})
+			continue
+		}
+		in := accessUsageInput{Connection: sponsorship.Connection, Owned: editable.Owned[sponsorship.Connection], Budget: int64(sponsorship.AllowanceMinutes)}
+		if in.Owned {
+			if total, err := s.Store.UsageTotal(ctx, int64(repository), sponsorship.Connection); err == nil {
+				in.Used, in.UsedOK = total, true
+			}
+		}
+		view.Usage = append(view.Usage, accessUsageDTO(in))
+	}
+	if err := authorize(); err != nil {
+		return nil, err
+	}
+	return view, nil
+}
diff --git a/internal/factory/service/repository_access_view.go b/internal/factory/service/repository_access_view.go
new file mode 100644
index 0000000000000000000000000000000000000000..47bc427f2ceaaff7766dd600e100b18cda418003
--- /dev/null
+++ b/internal/factory/service/repository_access_view.go
@@ -0,0 +1,207 @@
+package service
+
+import "github.com/levitateos/sodaos/internal/factory"
+
+// accessEntryView reports whether the viewer may save one settings
+// section, with the bounded refusal reason when not. The owning PUT
+// APIs revalidate at save time.
+type accessEntryView struct {
+	Reason   string `json:"reason,omitempty"`
+	Editable bool   `json:"editable"`
+}
+
+// accessEditableReasons are the bounded codes behind one editability
+// entry. They mirror the owning PUT admission rules.
+const (
+	accessReasonSession    = "session_changed"
+	accessReasonOwnerAdmin = "owner_or_admin_required"
+	accessReasonOperator   = "operator_required"
+	accessReasonRepoOwner  = "repository_owner_required"
+	accessReasonConnOwner  = "connection_owner_required"
+	accessReasonIdentity   = "identity_unavailable"
+)
+
+// RepositoryViewer renders the viewer's current standing: host-verified
+// repository powers, runtime operator permission, workspace membership
+// and session currency. Each boundary stays separate; no power implies
+// another.
+type RepositoryViewer struct {
+	CodeWrite        bool `json:"code_write"`
+	OwnerOrAdmin     bool `json:"owner_or_admin"`
+	EnvironmentOwner bool `json:"environment_owner"`
+	Operator         bool `json:"operator"`
+	Member           bool `json:"member"`
+	SessionCurrent   bool `json:"session_current"`
+}
+
+// accessConnectionEntryView reports editability for one connection-owned
+// section: sponsorships admit the connection owner.
+type accessConnectionEntryView struct {
+	Connection string `json:"connection"`
+	Reason     string `json:"reason,omitempty"`
+	Editable   bool   `json:"editable"`
+}
+
+// accessEditableView maps every Factory settings section to the viewer's
+// current save power. Values live on the status route; this view carries
+// powers only, never a second copy of the settings.
+type accessEditableView struct {
+	Sponsorships     []accessConnectionEntryView `json:"sponsorships"`
+	Policy           accessEntryView             `json:"policy"`
+	ActivitySettings accessEntryView             `json:"activity_settings"`
+	OperatorGrant    accessEntryView             `json:"operator_grant"`
+	Capacity         accessEntryView             `json:"capacity"`
+	EnvironmentGrant accessEntryView             `json:"environment_grant"`
+}
+
+type accessEditableInput struct {
+	Viewer      RepositoryViewer
+	Connections []string
+	Owned       map[string]bool
+	IdentityOK  bool
+}
+
+func accessEditableDTO(in accessEditableInput) accessEditableView {
+	view := accessEditableView{Sponsorships: []accessConnectionEntryView{}}
+	session := ""
+	if !in.Viewer.SessionCurrent {
+		session = accessReasonSession
+	}
+	gated := func(allowed bool, reason string) accessEntryView {
+		if session != "" {
+			return accessEntryView{Reason: session}
+		}
+		if !allowed {
+			return accessEntryView{Reason: reason}
+		}
+		return accessEntryView{Editable: true}
+	}
+	view.Policy = gated(in.Viewer.OwnerOrAdmin, accessReasonOwnerAdmin)
+	view.ActivitySettings = gated(in.Viewer.OwnerOrAdmin, accessReasonOwnerAdmin)
+	view.OperatorGrant = gated(in.Viewer.Operator, accessReasonOperator)
+	view.Capacity = gated(in.Viewer.Operator, accessReasonOperator)
+	view.EnvironmentGrant = gated(in.Viewer.EnvironmentOwner, accessReasonRepoOwner)
+	for _, connection := range in.Connections {
+		entry := accessConnectionEntryView{Connection: connection}
+		switch {
+		case session != "":
+			entry.Reason = session
+		case !in.IdentityOK:
+			entry.Reason = accessReasonIdentity
+		case !in.Owned[connection]:
+			entry.Reason = accessReasonConnOwner
+		default:
+			entry.Editable = true
+		}
+		view.Sponsorships = append(view.Sponsorships, entry)
+	}
+	return view
+}
+
+// accessResolvers name who can resolve one missing authorization.
+const (
+	accessResolveOwnerAdmin = "owner_or_admin"
+	accessResolveOperator   = "operator"
+	accessResolveConnOwner  = "connection_owner"
+	accessResolveRepoOwner  = "repository_owner"
+	accessResolveMaintainer = "maintainer"
+)
+
+// accessActionView maps one missing authorization to the role that can
+// resolve it and the settings section that owns the fix.
+type accessActionView struct {
+	Code      string `json:"code"`
+	ResolveBy string `json:"resolve_by"`
+	Setting   string `json:"setting"`
+}
+
+// accessRequiredActions renders the required owner actions behind an
+// effective-authority verdict. Unknown codes stay visible with an empty
+// resolver rather than vanishing or guessing.
+func accessRequiredActions(missing []string) []accessActionView {
+	actions := []accessActionView{}
+	for _, code := range missing {
+		action := accessActionView{Code: code}
+		switch code {
+		case factory.MissingPolicy, factory.MissingPolicyDisabled, factory.MissingPolicyPaused:
+			action.ResolveBy, action.Setting = accessResolveOwnerAdmin, "policy"
+		case factory.MissingOperatorGrant, factory.MissingOperatorWithdrawn, factory.MissingCapacity:
+			action.ResolveBy, action.Setting = accessResolveOperator, "operator_grant"
+			if code == factory.MissingCapacity {
+				action.Setting = "capacity"
+			}
+		case factory.MissingSponsorship, factory.MissingSponsorshipGone:
+			action.ResolveBy, action.Setting = accessResolveConnOwner, "sponsorships"
+		case factory.MissingEnvironment, factory.MissingEnvironmentGone:
+			action.ResolveBy, action.Setting = accessResolveRepoOwner, "environment_grant"
+		case factory.MissingPreparation:
+			action.ResolveBy, action.Setting = accessResolveOwnerAdmin, "project"
+		case factory.MissingDispatch:
+			action.ResolveBy, action.Setting = accessResolveMaintainer, "lifecycle"
+		}
+		actions = append(actions, action)
+	}
+	return actions
+}
+
+// accessUsageStatuses name why one connection's usage numbers are
+// withheld instead of rendered.
+const (
+	accessUsageOwnerOnly    = "connection_owner_only"
+	accessUsageUnavailable  = "usage_unavailable"
+	accessUsageIdentityDown = "identity_unavailable"
+)
+
+// accessUsageView renders actual execution usage for one sponsored
+// connection in real minutes against the sponsorship's allowance, or the
+// explicit status withholding it. Allowance and spend belong to the
+// connection owner; other viewers see the withholding status, never zeros
+// that could read as no spend.
+type accessUsageView struct {
+	UsedMinutes   *int   `json:"used_minutes,omitempty"`
+	Connection    string `json:"connection"`
+	Unit          string `json:"unit"`
+	Status        string `json:"status,omitempty"`
+	BudgetMinutes int64  `json:"budget_minutes,omitempty"`
+}
+
+type accessUsageInput struct {
+	Connection string
+	Owned      bool
+	UsedOK     bool
+	Budget     int64
+	Used       int
+}
+
+// accessUsageDTO renders one connection's usage. Values render only for
+// the verified connection owner with the usage read succeeding; every
+// other case names its withholding status.
+func accessUsageDTO(in accessUsageInput) accessUsageView {
+	view := accessUsageView{Connection: in.Connection, Unit: "minutes"}
+	if !in.Owned {
+		view.Status = accessUsageOwnerOnly
+		return view
+	}
+	if !in.UsedOK {
+		view.Status = accessUsageUnavailable
+		return view
+	}
+	used := in.Used
+	view.BudgetMinutes, view.UsedMinutes = in.Budget, &used
+	return view
+}
+
+// RepositoryAccessView is the permission, readiness and usage read for one
+// repository's Factory settings: the viewer's standing and save powers,
+// the effective-authority verdict with required actions, preparation
+// readiness and actual per-connection execution usage.
+type RepositoryAccessView struct {
+	Viewer       RepositoryViewer           `json:"viewer"`
+	Editable     accessEditableView         `json:"editable"`
+	Effective    factory.EffectiveAuthority `json:"effective"`
+	Preparation  *RepositoryPreparation     `json:"preparation"`
+	RequiredActs []accessActionView         `json:"required_actions"`
+	Usage        []accessUsageView          `json:"usage"`
+	Repository   string                     `json:"repository"`
+	ObservedUnix int64                      `json:"observed_unix"`
+}
diff --git a/internal/factory/service/repository_authority.go b/internal/factory/service/repository_authority.go
new file mode 100644
index 0000000000000000000000000000000000000000..bb2146309a69a6634843041fdd1e34907e842545
--- /dev/null
+++ b/internal/factory/service/repository_authority.go
@@ -0,0 +1,93 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"time"
+
+	"github.com/levitateos/sodaos/internal/collaboration"
+	"github.com/levitateos/sodaos/internal/factory/access"
+)
+
+var ErrRepositoryAuthorityUnavailable = errors.New("current repository authority is unavailable")
+
+// RepositoryAuthorization contains current host-admitted evidence and display
+// metadata. It is internal adapter output, never an assertion from browser JSON.
+type RepositoryAuthorization struct {
+	Actor access.AdmittedActor
+	Name  string
+}
+
+// RepositoryAuthority binds one authenticated principal to current repository
+// permission reads. Current must authenticate/revalidate provider or grant truth
+// on every call, including revocation and canonical identity lookup. A stored
+// observation or an unexpired evidence envelope alone cannot implement Current.
+type RepositoryAuthority struct {
+	Host       collaboration.HostID
+	Actor      collaboration.ActorID
+	Source     access.AdmissionSource
+	Connection *collaboration.ConnectionID
+	Runtime    *collaboration.RuntimeID
+	Current    func(context.Context, collaboration.RepositoryID, access.Permission) (RepositoryAuthorization, error)
+	Now        func() time.Time
+}
+
+// Check admits the exact actor, host, repository, permission and principal kind.
+// It returns no partial metadata on errors. Calling it neither creates a grant
+// nor admits execution, publication, provider custody or spending.
+func (a RepositoryAuthority) Check(ctx context.Context, actor collaboration.ActorID, repository collaboration.RepositoryID, permission access.Permission) (RepositoryAuthorization, error) {
+	if err := ctx.Err(); err != nil {
+		return RepositoryAuthorization{}, err
+	}
+	if !collaboration.ValidID(string(a.Host)) || a.Actor < 1 || actor != a.Actor || repository < 1 ||
+		(permission != access.Read && permission != access.Collaborate && permission != access.Configure) {
+		return RepositoryAuthorization{}, access.ErrDenied
+	}
+	if a.Current == nil {
+		return RepositoryAuthorization{}, ErrRepositoryAuthorityUnavailable
+	}
+	current, err := a.Current(ctx, repository, permission)
+	if err != nil {
+		return RepositoryAuthorization{}, err
+	}
+	if err := ctx.Err(); err != nil {
+		return RepositoryAuthorization{}, err
+	}
+	evidence := current.Actor.Evidence()
+	if evidence.Actor != actor || evidence.Source != a.Source ||
+		(evidence.Connection == nil) != (a.Connection == nil) ||
+		(evidence.Runtime == nil) != (a.Runtime == nil) ||
+		a.Connection != nil && *evidence.Connection != *a.Connection ||
+		a.Runtime != nil && *evidence.Runtime != *a.Runtime {
+		return RepositoryAuthorization{}, access.ErrDenied
+	}
+	now := time.Now()
+	if a.Now != nil {
+		now = a.Now()
+	}
+	if err := current.Actor.Require(a.Host, repository, permission, now); err != nil {
+		return RepositoryAuthorization{}, err
+	}
+	return current, nil
+}
+
+// Visibility implements the current-read port shared by catalogue and feed.
+// Only a trusted adapter's explicit ErrRepositoryHidden represents invisibility;
+// missing ports, malformed evidence and unknown access remain errors.
+func (a RepositoryAuthority) Visibility(ctx context.Context, actor collaboration.ActorID, repository collaboration.RepositoryID) (string, error) {
+	current, err := a.Check(ctx, actor, repository, access.Read)
+	if err != nil {
+		return "", err
+	}
+	if !collaboration.ValidText(current.Name, 512) {
+		return "", ErrRepositoryAuthorityUnavailable
+	}
+	return current.Name, nil
+}
+
+// Configure implements the current-administration port for request/policy
+// mutations. Services still recheck it at their existing mutation boundaries.
+func (a RepositoryAuthority) Configure(ctx context.Context, actor collaboration.ActorID, repository int64) error {
+	_, err := a.Check(ctx, actor, collaboration.RepositoryID(repository), access.Configure)
+	return err
+}
diff --git a/internal/factory/service/repository_status.go b/internal/factory/service/repository_status.go
new file mode 100644
index 0000000000000000000000000000000000000000..6c38f60487e8593676666df1969a24b7123e1f91
--- /dev/null
+++ b/internal/factory/service/repository_status.go
@@ -0,0 +1,157 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"strconv"
+
+	"github.com/levitateos/sodaos/internal/collaboration"
+	"github.com/levitateos/sodaos/internal/factory"
+	"github.com/levitateos/sodaos/internal/factory/control"
+	"github.com/levitateos/sodaos/internal/project"
+	"github.com/levitateos/sodaos/internal/store"
+)
+
+type repositoryQueueView struct {
+	Queued int `json:"queued"`
+	Active int `json:"active"`
+}
+
+type RepositoryPreparation struct {
+	Project      string `json:"project"`
+	Requirements string `json:"requirements,omitempty"`
+	Approval     string `json:"approval,omitempty"`
+	Ready        bool   `json:"ready"`
+}
+
+type RepositoryStatusView struct {
+	NativeBindings      []factory.ActorBindingRef    `json:"native_bindings"`
+	Policy              *factory.RepositoryPolicy    `json:"policy"`
+	OperatorGrant       *factory.OperatorGrant       `json:"operator_grant"`
+	Appliance           *factory.Capacity            `json:"capacity"`
+	Sponsorships        []factory.Sponsorship        `json:"sponsorships"`
+	EnvironmentGrant    *project.EnvironmentGrant    `json:"environment_grant"`
+	Preparation         *RepositoryPreparation       `json:"preparation"`
+	Queue               repositoryQueueView          `json:"queue"`
+	Effective           factory.EffectiveAuthority   `json:"effective"`
+	DispatchObservation *control.DispatchObservation `json:"dispatch_observation,omitempty"`
+	Repository          string                       `json:"repository"`
+}
+
+type RepositoryStatus struct {
+	Store       *store.Store
+	Visibility  WorkVisibility
+	Bindings    func(context.Context, collaboration.ActorID, collaboration.RepositoryID) ([]factory.ActorBindingRef, error)
+	Preparation func(context.Context, collaboration.ActorID, collaboration.RepositoryID) (*RepositoryPreparation, error)
+	Authority   func(context.Context, collaboration.ActorID, collaboration.RepositoryID) (factory.EffectiveAuthority, error)
+	// Diagnostic is optional and must check current administration itself.
+	// Unknown administration omits private diagnostics, never enables them.
+	Diagnostic func(context.Context, collaboration.ActorID, collaboration.RepositoryID) (*control.DispatchObservation, error)
+}
+
+var (
+	ErrRepositoryStatusUnavailable = errors.New("repository status is unavailable")
+	ErrRepositoryStatusVisibility  = errors.New("repository status is not visible")
+	ErrRepositoryStatusBindings    = errors.New("repository binding identity is unavailable")
+	ErrRepositoryStatusPreparation = errors.New("repository preparation is unavailable")
+)
+
+// Read assembles current configuration and recorded dispatch facts. Runtime
+// readiness/bindings are supplied explicitly; absent ports cannot imply ready.
+func (s RepositoryStatus) Read(ctx context.Context, actor collaboration.ActorID, repository collaboration.RepositoryID) (*RepositoryStatusView, error) {
+	if actor < 1 || repository < 1 {
+		return nil, ErrWorkReadQuery
+	}
+	if s.Store == nil || s.Visibility == nil || s.Bindings == nil || s.Preparation == nil || s.Authority == nil {
+		return nil, ErrRepositoryStatusUnavailable
+	}
+	visible := func() error {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		if err := s.Visibility(ctx, actor, repository); err != nil {
+			return errors.Join(ErrRepositoryStatusVisibility, err)
+		}
+		return ctx.Err()
+	}
+	if err := visible(); err != nil {
+		return nil, err
+	}
+	view := &RepositoryStatusView{Repository: strconv.FormatInt(int64(repository), 10), NativeBindings: []factory.ActorBindingRef{}, Sponsorships: []factory.Sponsorship{}}
+	bindings, err := s.Bindings(ctx, actor, repository)
+	if err != nil {
+		return nil, errors.Join(ErrRepositoryStatusBindings, err)
+	}
+	for _, binding := range bindings {
+		if err := binding.Validate(); err != nil {
+			return nil, errors.Join(ErrRepositoryStatusBindings, err)
+		}
+		view.NativeBindings = append(view.NativeBindings, binding)
+	}
+	if policy, err := s.Store.RepositoryPolicy(ctx, int64(repository)); err == nil {
+		if policy.Repository != int64(repository) {
+			return nil, ErrWorkJourneyScope
+		}
+		view.Policy = &policy
+	} else if !errors.Is(err, store.ErrNotFound) {
+		return nil, err
+	}
+	if grant, err := s.Store.OperatorGrant(ctx, int64(repository)); err == nil {
+		if grant.Repository != int64(repository) {
+			return nil, ErrWorkJourneyScope
+		}
+		view.OperatorGrant = &grant
+	} else if !errors.Is(err, store.ErrNotFound) {
+		return nil, err
+	}
+	if capacity, err := s.Store.Capacity(ctx); err == nil {
+		view.Appliance = &capacity
+	} else if !errors.Is(err, store.ErrNotFound) {
+		return nil, err
+	}
+	sponsorships, err := s.Store.Sponsorships(ctx, int64(repository))
+	if err != nil {
+		return nil, err
+	}
+	for _, sponsorship := range sponsorships {
+		if sponsorship.Repository != int64(repository) {
+			return nil, ErrWorkJourneyScope
+		}
+		if sponsorship.GrantedBy != int64(actor) {
+			sponsorship.AllowanceMinutes = 0
+		}
+		view.Sponsorships = append(view.Sponsorships, sponsorship)
+	}
+	if grant, err := s.Store.EnvironmentGrant(ctx, int64(repository)); err == nil {
+		if grant.Repository != int64(repository) {
+			return nil, ErrWorkJourneyScope
+		}
+		view.EnvironmentGrant = &grant
+	} else if !errors.Is(err, store.ErrNotFound) {
+		return nil, err
+	}
+	view.Preparation, err = s.Preparation(ctx, actor, repository)
+	if err != nil {
+		return nil, errors.Join(ErrRepositoryStatusPreparation, err)
+	}
+	if view.Preparation != nil && view.Preparation.Project == "" {
+		return nil, ErrRepositoryStatusPreparation
+	}
+	view.Effective, err = s.Authority(ctx, actor, repository)
+	if err != nil {
+		return nil, err
+	}
+	view.Queue.Queued, view.Queue.Active, err = s.Store.RepositoryDispatchCounts(ctx, int64(repository))
+	if err != nil {
+		return nil, err
+	}
+	if s.Diagnostic != nil {
+		if observation, err := s.Diagnostic(ctx, actor, repository); err == nil {
+			view.DispatchObservation = observation
+		}
+	}
+	if err := visible(); err != nil {
+		return nil, err
+	}
+	return view, nil
+}
diff --git a/internal/factory/service/request_commands.go b/internal/factory/service/request_commands.go
new file mode 100644
index 0000000000000000000000000000000000000000..2ee910d65b59d5d6edbfd29c57ce59f58f37eaa9
--- /dev/null
+++ b/internal/factory/service/request_commands.go
@@ -0,0 +1,122 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"time"
+
+	"github.com/levitateos/sodaos/internal/collaboration"
+	"github.com/levitateos/sodaos/internal/factory"
+	"github.com/levitateos/sodaos/internal/store"
+)
+
+// RequestWriteAccess checks current repository authority for this admitted
+// canonical actor. Saved ownership or an earlier successful command is not a
+// replacement for this check, including on immutable revision replay.
+type RequestWriteAccess func(context.Context, collaboration.ActorID, int64) error
+
+var (
+	ErrRequestWriteUnavailable = errors.New("request write authorization is unavailable")
+	ErrRequestWriteAccess      = errors.New("request repository authorization failed")
+	ErrRequestInputInvalid     = errors.New("invalid build request")
+	ErrDepartmentInputInvalid  = errors.New("invalid department")
+)
+
+func (s Requests) authorizeWrite(ctx context.Context, actor collaboration.ActorID, repository int64) error {
+	if s.WriteAccess == nil {
+		return ErrRequestWriteUnavailable
+	}
+	if err := s.WriteAccess(ctx, actor, repository); err != nil {
+		return errors.Join(ErrRequestWriteAccess, err)
+	}
+	return nil
+}
+
+// SaveRevision binds ownership and creation time server-side. Its existing
+// store transaction owns immutable identity replay, head CAS, department
+// ownership and the accepted request's pinned repository.
+func (s Requests) SaveRevision(ctx context.Context, actor collaboration.ActorID, in factory.IntentRevision) (factory.IntentRevision, error) {
+	var empty factory.IntentRevision
+	if actor <= 0 {
+		return empty, ErrRequestNotFound
+	}
+	if s.Store == nil {
+		return empty, ErrRequestUnavailable
+	}
+	in.Owner, in.CreatedUnix = int64(actor), time.Now().Unix()
+	current, readErr := s.Store.IntentRevision(ctx, in.Intent, int64(actor))
+	if readErr != nil && !errors.Is(readErr, store.ErrNotFound) {
+		return empty, readErr
+	}
+	if readErr == nil && current.ID == in.ID {
+		in.CreatedUnix = current.CreatedUnix
+	}
+	if in.Repository > 0 {
+		if err := s.authorizeWrite(ctx, actor, in.Repository); err != nil {
+			return empty, err
+		}
+	}
+	if err := in.Validate(); err != nil {
+		return empty, errors.Join(ErrRequestInputInvalid, err)
+	}
+	if in.Predecessor != "" {
+		if errors.Is(readErr, store.ErrNotFound) {
+			return empty, ErrRequestNotFound
+		}
+		if current.ID != in.Predecessor && current.ID != in.ID {
+			return empty, store.ErrStaleRevision
+		}
+	}
+	if err := s.Store.SaveIntentRevision(ctx, in); err != nil {
+		return empty, err
+	}
+	return in, nil
+}
+
+func (s Requests) CreateDepartment(ctx context.Context, actor collaboration.ActorID, in factory.Department) (factory.Department, error) {
+	var empty factory.Department
+	if actor <= 0 {
+		return empty, ErrRequestNotFound
+	}
+	if s.Store == nil {
+		return empty, ErrRequestUnavailable
+	}
+	in.Owner = int64(actor)
+	if err := in.Validate(); err != nil {
+		return empty, errors.Join(ErrDepartmentInputInvalid, err)
+	}
+	if err := s.Store.CreateDepartment(ctx, in); err != nil {
+		return empty, err
+	}
+	return in, nil
+}
+
+func (s Requests) Departments(ctx context.Context, actor collaboration.ActorID) ([]factory.Department, error) {
+	if actor <= 0 {
+		return nil, ErrRequestNotFound
+	}
+	if s.Store == nil {
+		return nil, ErrRequestUnavailable
+	}
+	return s.Store.Departments(ctx, int64(actor))
+}
+
+func (s Requests) Catalogue(ctx context.Context, actor collaboration.ActorID, filter factory.IntentListFilter) ([]factory.IntentSummary, string, error) {
+	if actor <= 0 {
+		return nil, "", ErrRequestNotFound
+	}
+	if s.Store == nil {
+		return nil, "", ErrRequestUnavailable
+	}
+	if err := filter.Validate(); err != nil {
+		return nil, "", errors.Join(ErrRequestInputInvalid, err)
+	}
+	return s.Store.ListIntentRevisions(ctx, int64(actor), filter)
+}
+
+func (s Requests) History(ctx context.Context, actor collaboration.ActorID, intent string, limit int) ([]factory.IntentRevision, error) {
+	if _, err := s.Revision(ctx, actor, intent); err != nil {
+		return nil, err
+	}
+	return s.Store.IntentHistory(ctx, intent, int64(actor), limit)
+}
diff --git a/internal/factory/service/request_exploration.go b/internal/factory/service/request_exploration.go
new file mode 100644
index 0000000000000000000000000000000000000000..18d636b50e93abe0be5c17b6f65e6ab57372c9e2
--- /dev/null
+++ b/internal/factory/service/request_exploration.go
@@ -0,0 +1,297 @@
+package service
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"time"
+
+	"github.com/levitateos/sodaos/internal/collaboration"
+	"github.com/levitateos/sodaos/internal/factory"
+	"github.com/levitateos/sodaos/internal/factory/control"
+	"github.com/levitateos/sodaos/internal/store"
+)
+
+// RequestExploration owns private exploration and recorded walkthrough advice.
+// Commands use the existing durable judgment producer; reads never wire a chooser.
+type RequestExploration struct {
+	Requests Requests
+	Chooser  control.ProductJudgment
+}
+
+var (
+	ErrExplorationProposalInvalid     = errors.New("invalid derived proposal")
+	ErrExplorationTaskLimit           = errors.New("derived proposal exceeds task limit")
+	ErrPlanningWalkthroughInvalid     = errors.New("saved walkthrough does not match this direction")
+	ErrPlanningWalkthroughUnavailable = errors.New("plan has no completed authored walkthrough")
+)
+
+func intentID() (string, error) {
+	var raw [12]byte
+	if _, err := rand.Read(raw[:]); err != nil {
+		return "", err
+	}
+	return "d" + hex.EncodeToString(raw[:]), nil
+}
+
+// Exploration carries the recorded product advice beside a revision.
+// ExplorationResult keeps the revision fields flat for both frontend hosts.
+type Exploration struct {
+	Content        factory.ProposalContent       `json:"content"`
+	Challenges     []factory.AssumptionChallenge `json:"challenges"`
+	Settled        []string                      `json:"settled"`
+	Recommendation *factory.ConsolidatedProposal `json:"recommendation,omitempty"`
+	Consistency    *factory.ConsistencyReport    `json:"consistency,omitempty"`
+}
+
+type ExplorationResult struct {
+	factory.IntentRevision
+	Exploration Exploration `json:"exploration"`
+}
+
+func attachExploration(proposal factory.IntentRevision, content factory.ProposalContent, challenges []factory.AssumptionChallenge, settled []string, recommendation *factory.ConsolidatedProposal, consistency *factory.ConsistencyReport) ExplorationResult {
+	if challenges == nil {
+		challenges = []factory.AssumptionChallenge{}
+	}
+	if settled == nil {
+		settled = []string{}
+	}
+	return ExplorationResult{IntentRevision: proposal, Exploration: Exploration{Content: content, Challenges: challenges, Settled: settled, Recommendation: recommendation, Consistency: consistency}}
+}
+
+func settledIDs(review factory.AssumptionReview) []string {
+	ids := make([]string, 0, len(review.Settled))
+	for _, settlement := range review.Settled {
+		ids = append(ids, settlement.Idea)
+	}
+	return ids
+}
+
+const designRubric = "Using the full supplied objective and reviewed choices, choose a bounded implementation approach. Respect an explicitly selected approach; choose clarify if a declined or corrected assumption contradicts the objective or material outcomes remain unresolved. Do not impose declined assumptions or invent product capabilities. This advice grants no acceptance, repository authority or spending permission."
+
+func mintExplorationProposal(current factory.IntentRevision) ([]string, factory.IntentRevision, error) {
+	ids := make([]string, 104)
+	for i := range ids {
+		var err error
+		ids[i], err = intentID()
+		if err != nil {
+			return nil, factory.IntentRevision{}, err
+		}
+	}
+	proposal := factory.ProposeIntent(current, ids)
+	proposal.Predecessor = current.ID
+	var err error
+	proposal.ID, err = intentID()
+	if err != nil {
+		return nil, factory.IntentRevision{}, err
+	}
+	proposal.CreatedUnix = time.Now().Unix()
+	return ids, proposal, nil
+}
+
+func validateExploration(current, proposal factory.IntentRevision) error {
+	if err := proposal.Validate(); err != nil {
+		if len(proposal.Tasks) > current.MaxIssues {
+			return fmt.Errorf("%w: The derived proposal carries %d tasks for max_issues %d: %v", ErrExplorationTaskLimit, len(proposal.Tasks), current.MaxIssues, err)
+		}
+		return errors.Join(ErrExplorationProposalInvalid, err)
+	}
+	return nil
+}
+
+func (s RequestExploration) persist(ctx context.Context, current factory.IntentRevision, content factory.ProposalContent, proposal factory.IntentRevision, review factory.AssumptionReview, recommendation *factory.ConsolidatedProposal, consistency *factory.ConsistencyReport) (ExplorationResult, error) {
+	if err := validateExploration(current, proposal); err != nil {
+		return ExplorationResult{}, err
+	}
+	challenges := review.Challenges
+	if challenges == nil {
+		challenges = []factory.AssumptionChallenge{}
+	}
+	saved := factory.SavedReview{
+		Intent: current.Intent, BasisRevision: current.ID, ResultRevision: proposal.ID,
+		Content: content, Challenges: challenges, Settled: settledIDs(review),
+		Recommendation: recommendation, Consistency: consistency, SavedUnix: time.Now().Unix(),
+	}
+	if err := s.Requests.Store.SaveIntentRevisionWithReview(ctx, proposal, saved); err != nil {
+		return ExplorationResult{}, err
+	}
+	return attachExploration(proposal, content, review.Challenges, settledIDs(review), recommendation, consistency), nil
+}
+
+// Explore produces and atomically saves a draft revision and its actual review.
+// Private ownership admits exploration; the result grants no repository effects
+// or execution authority. Acceptance and dispatch retain their separate gates.
+func (s RequestExploration) Explore(ctx context.Context, actor collaboration.ActorID, intent, revision string) (ExplorationResult, error) {
+	var empty ExplorationResult
+	current, err := s.Requests.Revision(ctx, actor, intent)
+	if err != nil {
+		return empty, err
+	}
+	if current.ID != revision || current.State != "draft" {
+		return empty, store.ErrStaleRevision
+	}
+	content, err := factory.ComposeProposalContent(current)
+	if err != nil {
+		return empty, err
+	}
+	ids, proposal, err := mintExplorationProposal(current)
+	if err != nil {
+		return empty, err
+	}
+	coord := &control.Coordinator{Store: s.Requests.Store, Planning: &control.PlanningJudgments{Chooser: s.Chooser}}
+	design := current
+	design.ID, design.Predecessor, design.CreatedUnix, design.Tasks = "", "", 0, nil
+	answer, _, err := coord.AdvisePurpose(ctx, control.PurposeAdvice{
+		Purpose: factory.JudgmentProductApproaches, State: design, Question: designRubric,
+		Options: intentDesignCriteria(), Outcome: "product_design", Candidates: intentDesignCandidates(current),
+		Admit: func(ctx context.Context, snapshot string) (bool, error) {
+			return true, s.Requests.Store.CheckIntentJudgment(ctx, current)
+		},
+	})
+	if err != nil {
+		return empty, fmt.Errorf("design consultation: %w", err)
+	}
+	proposal = applyIntentDesign(current, ids, proposal, answer)
+	if answer.Selected == "clarify" || answer.Confidence < .25 {
+		proposal.Tasks = []factory.IntentTask{}
+		proposal = appendClarifyOnce(proposal, ids[103])
+	}
+	if err := validateExploration(current, proposal); err != nil {
+		return empty, err
+	}
+	review, err := coord.JudgeAssumptions(ctx, current, content, proposal.Ideas)
+	if err != nil {
+		return empty, fmt.Errorf("assumption review: %w", err)
+	}
+	proposal = factory.SettleAssumptions(proposal, review)
+	var recommendation *factory.ConsolidatedProposal
+	if content.Supported {
+		consolidated, err := coord.JudgeConsolidation(ctx, current, content)
+		if err != nil {
+			return empty, fmt.Errorf("consolidation: %w", err)
+		}
+		recommendation = &consolidated
+	}
+	var consistency *factory.ConsistencyReport
+	if recommendation != nil {
+		checked, err := coord.JudgeConsistency(ctx, current, content, *recommendation)
+		if err != nil {
+			return empty, fmt.Errorf("consistency review: %w", err)
+		}
+		consistency = &checked
+	}
+	return s.persist(ctx, current, content, proposal, review, recommendation, consistency)
+}
+
+// clarifyDescription and clarifyConsequence pin the one material product
+// question blocking implementation. Matching reuses these exact texts so
+// the carried-forward clarification keeps a stable identity and answers
+// can settle instead of spawning a duplicate each round.
+const (
+	clarifyDescription = "Describe the first user action and the result that should count as success"
+	clarifyConsequence = "Implementation waits until this material product question is resolved."
+)
+
+// clarifyIdea asks the one material product question blocking implementation.
+// It carries autonomous assumption basis, never human approval.
+func clarifyIdea(id string) factory.ProductIdea {
+	return factory.ProductIdea{ID: id, Description: clarifyDescription, Consequence: clarifyConsequence, Assumption: true, Decision: "pending", Source: "assumption", Provenance: "autonomous", Material: true}
+}
+
+// isClarification reports whether idea is the producer-owned material
+// question, pending or already answered. It matches assumption-source
+// ideas carrying the exact pinned texts; ordinary human ideas never
+// match, so no human decision is coalesced or rewritten.
+func isClarification(idea factory.ProductIdea) bool {
+	return idea.Assumption && idea.Source == "assumption" && idea.Material &&
+		idea.Description == clarifyDescription && idea.Consequence == clarifyConsequence
+}
+
+// appendClarifyOnce reuses the carried-forward producer-owned
+// clarification for the unchanged material question. A pending one keeps
+// its stable identity so challenges and answers settle on it; an
+// answered one preserves the recorded answer. Either way no duplicate is
+// appended.
+func appendClarifyOnce(proposal factory.IntentRevision, id string) factory.IntentRevision {
+	for _, idea := range proposal.Ideas {
+		if isClarification(idea) {
+			return proposal
+		}
+	}
+	proposal.Ideas = append(proposal.Ideas, clarifyIdea(id))
+	return proposal
+}
+
+func intentDesignCriteria() map[string]any {
+	return map[string]any{"complete_first": "One task per reviewed product choice combines implementation and verification outcomes", "incremental": "Two tasks per reviewed product choice separate implementation and dependent verification", "clarify": "No work graph until consequential scope contradictions or missing product outcomes are reviewed"}
+}
+
+func intentDesignCandidates(r factory.IntentRevision) []factory.PriorityCandidate {
+	result := []factory.PriorityCandidate{}
+	for _, approach := range []string{"complete_first", "incremental"} {
+		if r.Approach != "" && r.Approach != approach {
+			continue
+		}
+		result = append(result, factory.PriorityCandidate{ID: approach, Objective: r.Objective, Impact: intentDesignCriteria()[approach].(string)})
+	}
+	return append(result, factory.PriorityCandidate{ID: "clarify", Objective: r.Objective, Risk: intentDesignCriteria()["clarify"].(string)})
+}
+
+func applyIntentDesign(current factory.IntentRevision, ids []string, proposal factory.IntentRevision, answer factory.PriorityAnswer) factory.IntentRevision {
+	if answer.Confidence < .25 || answer.Selected == "clarify" {
+		return proposal
+	}
+	approach := current.Approach
+	if approach == "" {
+		approach = answer.Selected
+	}
+	current.Approach = approach
+	derived := factory.ProposeIntent(current, ids)
+	proposal.Approach, proposal.Tasks = derived.Approach, derived.Tasks
+	return proposal
+}
+
+// ExplorationReceipt names a saved transition, not an in-flight judgment or a
+// process launch. None does not rule out a consultation still finishing.
+type ExplorationReceipt struct {
+	Intent        string             `json:"intent"`
+	BasisRevision string             `json:"basis_revision"`
+	State         string             `json:"state"`
+	Result        *ExplorationResult `json:"result,omitempty"`
+}
+
+// SavedExploration reads the original input's atomically saved proposal/review,
+// even after the head advances. No chooser, funding or dispatch is reachable.
+func (s Requests) SavedExploration(ctx context.Context, actor collaboration.ActorID, intent, basis string) (ExplorationReceipt, error) {
+	var empty ExplorationReceipt
+	selected, err := s.SavedRevision(ctx, actor, intent, basis)
+	if err != nil {
+		return empty, err
+	}
+	if selected.State != "draft" || selected.Validate() != nil {
+		return empty, ErrRequestNotFound
+	}
+	review, err := s.Store.IntentExplorationReview(ctx, intent, basis, int64(actor))
+	receipt := ExplorationReceipt{Intent: intent, BasisRevision: basis, State: "none"}
+	if errors.Is(err, store.ErrNotFound) {
+		return receipt, nil
+	}
+	if err != nil {
+		return empty, err
+	}
+	if err := review.Validate(); err != nil {
+		return empty, err
+	}
+	proposal, err := s.SavedRevision(ctx, actor, intent, review.ResultRevision)
+	if err != nil {
+		return empty, err
+	}
+	if proposal.State != "draft" || proposal.Predecessor != selected.ID || proposal.Repository != selected.Repository || proposal.Validate() != nil {
+		return empty, ErrRequestNotFound
+	}
+	result := attachExploration(proposal, review.Content, review.Challenges, review.Settled, review.Recommendation, review.Consistency)
+	receipt.State, receipt.Result = "recorded", &result
+	return receipt, nil
+}
