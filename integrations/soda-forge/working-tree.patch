+++ b/internal/factory/service/worker_consultations.go
@@ -0,0 +1,186 @@
+package service
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"strings"
+	"time"
+
+	"github.com/levitateos/sodaos/internal/factory"
+	"github.com/levitateos/sodaos/internal/store"
+)
+
+// WorkerSystemOne supplies judgments, never workflow or execution authority.
+type WorkerSystemOne interface {
+	Evaluate(context.Context, string, any, any, any) (map[string]any, error)
+	EvaluateQuestions(context.Context, string, any, map[string]factory.SystemOneWorkerQuestion) (map[string]any, error)
+}
+
+type WorkerConsultationJournal interface {
+	RecordConsultationRequest(context.Context, store.SystemOneConsultation) error
+	RecordConsultationResult(context.Context, string, string, string, map[string]any) error
+}
+
+// WorkerConsultationInput contains content only. Identity comes from the
+// authenticated capability, outside this object and the worker's request body.
+type WorkerConsultationInput struct {
+	State             any                                        `json:"state"`
+	Instructions      any                                        `json:"instructions"`
+	Criteria          any                                        `json:"criteria"`
+	Questions         map[string]factory.SystemOneWorkerQuestion `json:"questions,omitempty"`
+	ConsultationGroup string                                     `json:"consultation_group,omitempty"`
+}
+
+// WorkerConsultations owns bounded question validation, provider dispatch and
+// existing work-discussion recording. Callers supply an already admitted worker.
+// Production supplies the store journal; journal-less callers retain the existing
+// unrecorded advice behavior. No provider call occurs during construction.
+type WorkerConsultations struct {
+	Provider WorkerSystemOne
+	Journal  WorkerConsultationJournal
+	Now      func() time.Time
+}
+
+func (s WorkerConsultations) now() time.Time {
+	if s.Now != nil {
+		return s.Now()
+	}
+	return time.Now()
+}
+
+// Evaluate issues one single/batch consultation. Explicit repeats call the
+// provider again; the conversation snapshot is not a funding/replay receipt.
+func (s WorkerConsultations) Evaluate(ctx context.Context, cap factory.MCPCapability, tool factory.MCPTool, input WorkerConsultationInput) (map[string]any, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if cap.Validate() != nil || cap.State != factory.MCPCapabilityActive || cap.Expired(s.now()) || !factory.MCPToolAdmitted(cap.Profile, tool) {
+		return nil, ErrWorkerBinding
+	}
+	switch tool {
+	case factory.MCPToolSystemOneNoul, factory.MCPToolSystemOneChoice, factory.MCPToolSystemOneScore:
+	default:
+		return nil, errors.New("unsupported System One consultation tool")
+	}
+	if input.ConsultationGroup != "" && !factory.ValidID(input.ConsultationGroup) {
+		return nil, errors.New("consultation group must be a 32-character lowercase hex identity")
+	}
+	raw, err := json.Marshal(input)
+	if err != nil || len(raw) > factory.MCPMaxSubmissionPayload {
+		return nil, errors.New("System One question exceeds 64 KiB")
+	}
+	kind := strings.TrimPrefix(string(tool), "systemone.")
+	var snapshot string
+	var questions map[string]any
+	var call func() (map[string]any, error)
+	if len(input.Questions) > 0 {
+		if input.Instructions != nil || input.Criteria != nil {
+			return nil, errors.New("single question and batch questions are mutually exclusive")
+		}
+		if len(input.Questions) > factory.SystemOneMaxBatchQuestions {
+			return nil, errors.New("System One batch needs 1 to 8 questions")
+		}
+		for _, question := range input.Questions {
+			if err := consultationInstructions(question.Instructions); err != nil {
+				return nil, err
+			}
+		}
+		snapshot, err = factory.SystemOneWorkerBatchSnapshot(cap.ID, tool, input.State, input.Questions)
+		questions = make(map[string]any, len(input.Questions))
+		for id, question := range input.Questions {
+			questions[id] = map[string]any{"instructions": question.Instructions, "criteria": question.Criteria}
+		}
+		call = func() (map[string]any, error) {
+			return s.Provider.EvaluateQuestions(ctx, kind, input.State, input.Questions)
+		}
+	} else {
+		if err := consultationInstructions(input.Instructions); err != nil {
+			return nil, err
+		}
+		if kind == "choice" {
+			criteria, ok := input.Criteria.(map[string]any)
+			if !ok || len(criteria) < 2 || len(criteria) > 255 {
+				return nil, errors.New("choice requires 2–255 alternatives")
+			}
+		}
+		if kind == "score" {
+			levels, ok := input.Criteria.([]any)
+			if !ok || len(levels) < 2 || len(levels) > 10 {
+				return nil, errors.New("score requires 2–10 levels")
+			}
+		}
+		snapshot, err = factory.SystemOneWorkerSnapshot(cap.ID, tool, input.State, input.Instructions, input.Criteria)
+		call = func() (map[string]any, error) {
+			return s.Provider.Evaluate(ctx, kind, input.State, input.Instructions, input.Criteria)
+		}
+	}
+	if err != nil {
+		return nil, errors.New("System One question is not hashable")
+	}
+	group := input.ConsultationGroup
+	if group == "" {
+		group = snapshot
+	}
+	if s.Journal != nil {
+		revision := cap.AcceptedRevision
+		if revision == "" {
+			revision = cap.SourceDigest
+		}
+		err = s.Journal.RecordConsultationRequest(ctx, store.SystemOneConsultation{Repository: cap.Repository, Role: cap.Profile, FeedConsultation: factory.FeedConsultation{Snapshot: snapshot, GroupID: group, Assignment: cap.AssignmentID, SourceRevision: revision, Tool: string(tool), Kind: kind, State: input.State, Instructions: input.Instructions, Criteria: input.Criteria, Questions: questions, Status: store.ConsultationStatusPending}})
+		if err != nil {
+			return nil, err
+		}
+	}
+	if s.Provider == nil {
+		err = errors.New("System One provider is not configured")
+		return nil, errors.Join(err, s.record(ctx, snapshot, nil, err))
+	}
+	answer, err := call()
+	if err != nil {
+		return nil, errors.Join(err, s.record(ctx, snapshot, nil, err))
+	}
+	if err := s.record(ctx, snapshot, answer, nil); err != nil {
+		return nil, err
+	}
+	result := make(map[string]any, len(answer)+1)
+	for key, value := range answer {
+		result[key] = value
+	}
+	result["consultation"] = map[string]any{"post_id": factory.FeedConsultationPostID(snapshot), "work_post": map[string]any{"kind": "record", "id": cap.AssignmentID}, "follow_up": "Reply to this consultation with your interpretation and chosen next action. Use factory.record_decision for a durable decision. JEV output above is advice, not an implemented or authorized change."}
+	return result, nil
+}
+
+func consultationInstructions(value any) error {
+	if value == nil {
+		return errors.New("instructions are required")
+	}
+	if text, ok := value.(string); ok && strings.TrimSpace(text) == "" {
+		return errors.New("instructions are empty")
+	}
+	return nil
+}
+
+func (s WorkerConsultations) record(ctx context.Context, snapshot string, result map[string]any, callErr error) error {
+	if s.Journal == nil {
+		return nil
+	}
+	// A worker disconnect must not erase an actual answer or an uncertain call.
+	writeCtx, cancel := context.WithTimeout(context.WithoutCancel(ctx), 5*time.Second)
+	defer cancel()
+	if callErr != nil {
+		status := store.ConsultationStatusFailed
+		if strings.Contains(callErr.Error(), "not configured") {
+			status = store.ConsultationStatusUnavailable
+		}
+		if errors.Is(callErr, context.DeadlineExceeded) || errors.Is(callErr, context.Canceled) || strings.Contains(callErr.Error(), "request failed") {
+			status = store.ConsultationStatusUncertain
+		}
+		return s.Journal.RecordConsultationResult(writeCtx, snapshot, "", status, nil)
+	}
+	model := ""
+	if result != nil {
+		model, _ = result["model"].(string)
+	}
+	return s.Journal.RecordConsultationResult(writeCtx, snapshot, model, store.ConsultationStatusReturned, result)
+}
diff --git a/internal/factory/service/worker_context.go b/internal/factory/service/worker_context.go
new file mode 100644
index 0000000000000000000000000000000000000000..cfd9c0de1aba717f5fc46d012d797ab2d6e3e383
--- /dev/null
+++ b/internal/factory/service/worker_context.go
@@ -0,0 +1,259 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"time"
+
+	"github.com/levitateos/sodaos/internal/factory"
+	"github.com/levitateos/sodaos/internal/factory/control"
+)
+
+// WorkerTerminalSource reads the existing proposal journal without settling it.
+type WorkerTerminalSource interface {
+	TerminalMCPProposal(context.Context, string) (factory.MCPWorkStatus, bool, error)
+}
+
+// WorkerContext reads already authenticated/admitted worker context. Transport
+// owns per-call capability admission/rate slots; sources supply canonical records.
+// Loading or projecting context never judges, dispatches or changes a journal.
+type WorkerContext struct {
+	Terminal    WorkerTerminalSource
+	Assignments WorkerAssignmentSource
+	Runs        WorkerRunSource
+	Priority    WorkerPriorityJudgmentSource
+	Current     WorkerCurrentContextSource
+	Now         func() time.Time
+}
+
+// WorkerContextRead is internal application input, not a response containing raw
+// assignment/prompt data. Projection exposes only the existing worker contract.
+type WorkerContextRead struct {
+	Capability   factory.MCPCapability
+	Terminal     factory.MCPWorkStatus
+	Frozen       bool
+	Assignment   factory.Assignment
+	Parent       factory.Assignment
+	ParentLoaded bool
+}
+
+func (s WorkerContext) now() time.Time {
+	if s.Now != nil {
+		return s.Now()
+	}
+	return time.Now()
+}
+
+// Load retains the existing private-parent visibility and incomplete lineage.
+func (s WorkerContext) Load(ctx context.Context, capability factory.MCPCapability) (WorkerContextRead, error) {
+	read := WorkerContextRead{Capability: capability}
+	if s.Terminal == nil || s.Assignments == nil {
+		return WorkerContextRead{}, errors.New("worker context sources unavailable")
+	}
+	var err error
+	read.Terminal, read.Frozen, err = s.Terminal.TerminalMCPProposal(ctx, capability.AssignmentID)
+	if err != nil {
+		return WorkerContextRead{}, err
+	}
+	read.Assignment, err = s.Assignments.Assignment(ctx, capability.AssignmentID)
+	if err != nil {
+		return WorkerContextRead{}, err
+	}
+	if read.Assignment.ParentAssignment != "" {
+		if parent, err := s.Assignments.Assignment(ctx, read.Assignment.ParentAssignment); err == nil && factory.ContextParentVisible(read.Assignment, parent) {
+			read.Parent, read.ParentLoaded = parent, true
+		}
+	}
+	if err := ctx.Err(); err != nil {
+		return WorkerContextRead{}, err
+	}
+	return read, nil
+}
+
+// WorkerAssignmentSource loads the recorded assignment behind a
+// capability for current-context projection. *store.Store implements
+// it; tests stub it.
+type WorkerAssignmentSource interface {
+	Assignment(ctx context.Context, id string) (factory.Assignment, error)
+}
+
+// WorkerPriorityJudgmentSource reads the prepared context choice.
+// *store.Store implements it; tests stub it.
+type WorkerPriorityJudgmentSource interface {
+	PriorityJudgment(context.Context, string) (factory.PriorityReceipt, error)
+}
+
+// WorkerRunSource loads recorded run rows behind an assignment
+// for bounded evidence projection. *store.Store implements it;
+// tests stub it.
+type WorkerRunSource interface {
+	FactoryRun(ctx context.Context, id string) (factory.Run, error)
+}
+
+type WorkerCurrentContextSource interface {
+	FactoryCurrentContext(context.Context, factory.MCPCapability, time.Time) (factory.CurrentContext, error)
+}
+
+// Foreground is read-only. The classifier's recorded choice picks
+// the foregrounded history; a missing, failed or unsure choice serves current
+// context rather than holding the worker.
+func (s WorkerContext) Foreground(ctx context.Context, read WorkerContextRead) (string, string, string) {
+	attemptEligible, lineageEligible := factory.BundleEligibility(read.Assignment, read.ParentLoaded)
+	if resolution := read.Capability.ContextCurrentResolution; resolution != nil {
+		source := s.Current
+		if source == nil {
+			return factory.ContextBundleSnapshotHold, "required_current_unavailable", read.Capability.ContextSelectionSnapshot
+		}
+		current, err := source.FactoryCurrentContext(ctx, read.Capability, s.now())
+		if err != nil || current.Evidence.Availability != "complete" {
+			return factory.ContextBundleSnapshotHold, "required_current_unavailable", read.Capability.ContextSelectionSnapshot
+		}
+		digest, err := factory.CurrentRequiredSemanticDigest(current.Role)
+		if err != nil || resolution.ValidateFor(read.Capability) != nil || digest != resolution.RequiredDigest {
+			return factory.ContextBundleSnapshotHold, "context_selection_stale", read.Capability.ContextSelectionSnapshot
+		}
+		return factory.ContextBundleCurrent, "", read.Capability.ContextSelectionSnapshot
+	}
+	priority := s.Priority
+	if priority == nil {
+		priority, _ = s.Terminal.(WorkerPriorityJudgmentSource)
+	}
+	fingerprint := read.Capability.ContextSelectionSnapshot
+	if priority == nil || !factory.ValidDigest(fingerprint) {
+		return factory.ContextBundleCurrent, "", ""
+	}
+	receipt, err := priority.PriorityJudgment(ctx, fingerprint)
+	if err != nil {
+		return factory.ContextBundleCurrent, "", ""
+	}
+	bundle, reason := control.ContextBundleFromReceipt(receipt, read.Capability, read.Assignment, attemptEligible, lineageEligible)
+	if bundle == factory.ContextBundleSnapshotHold || reason != "" {
+		return factory.ContextBundleCurrent, "", fingerprint
+	}
+	return bundle, "", fingerprint
+}
+
+// Projection renders one read's projection with its eligible
+// attempt and lineage sections.
+func (read WorkerContextRead) Projection(foregrounded string) map[string]any {
+	attemptEligible, lineageEligible := factory.BundleEligibility(read.Assignment, read.ParentLoaded)
+	capability, assignment := read.Capability, read.Assignment
+	serveAttempt := attemptEligible && (foregrounded == factory.ContextBundleAttempt || foregrounded == factory.ContextBundleLineage)
+	serveLineage := lineageEligible && foregrounded == factory.ContextBundleLineage
+	bundle := factory.ContextBundleCurrent
+	body := map[string]any{
+		"assignment":            capability.AssignmentID,
+		"run":                   capability.RunID,
+		"project":               capability.Project,
+		"identity_source":       "authenticated_worker_context",
+		"prompt_sha":            assignment.PromptSHA,
+		"source_commit":         assignment.SourceCommit,
+		"preparation":           assignment.Preparation,
+		"profile":               string(capability.Profile),
+		"phase":                 factory.MCPPhaseOf(capability.Profile),
+		"subject":               capability.Subject,
+		"repository":            capability.Repository,
+		"generation":            capability.Generation,
+		"capability":            capability.State,
+		"deadline":              capability.DeadlineUnix,
+		"terminal":              read.Frozen,
+		"limits":                map[string]any{"page_bytes": factory.MCPMaxPageBytes, "page_refs": factory.MCPMaxPageRefs, "result_bytes": factory.MCPMaxResultPayloadBytes},
+		"source_digest":         capability.SourceDigest,
+		"scope_digest":          capability.ScopeDigest(),
+		"replies_tool":          string(factory.MCPToolInbox),
+		"discussion_guidance":   "Read factory.inbox before finishing. A recorded role invitation grants only its exact discussion context and one useful reply through factory.reply with parent_id set to the invited post ID. It does not expand your assignment, execution authority or budget. Skip redundant contributions, explain concrete relevant evidence, and preserve the source identity. Do not invite other roles recursively.",
+		"work_post":             map[string]any{"kind": "record", "id": assignment.ID},
+		"library_tools":         []string{"factory.search_library", "factory.read_library_item"},
+		"library_guidance":      factory.LibraryReadGuidance,
+		"consultation_guidance": "System One questions and actual results are automatically recorded in your work post. Never include credentials or private key material. For substantive decisions prepare three independent, counterbalanced questions using the same facts and alternatives before reading any answer, then make three separate calls with the same consultation_group identity. A questions batch is one call and must not be described as three independent calls. Compare the results, then reply to the returned consultation.post_id with your interpretation, decision and next action, or use factory.record_decision with that parent_id for durable decisions. Your explanation must remain distinct from JEV's actual answer. Judgments do not replace native checks or authorization. Read your inbox and effective project decisions/knowledge through the library tools before adopting a change; preserve cited item IDs/revisions and source revision.",
+	}
+	if assignment.Issue > 0 {
+		body["issue"] = assignment.Issue
+	}
+	if assignment.ActorID > 0 {
+		body["actor_id"] = assignment.ActorID
+	}
+	if serveAttempt {
+		body["attempt"] = map[string]any{"run_history": factory.AttemptContinuity(assignment)}
+		bundle = factory.ContextBundleAttempt
+	}
+	if serveLineage {
+		lineage := map[string]any{"parent_assignment": assignment.ParentAssignment}
+		if read.Parent.Outcome != "" {
+			lineage["parent_outcome"] = string(read.Parent.Outcome)
+		}
+		if read.Parent.Reason != "" {
+			lineage["parent_reason"] = read.Parent.Reason
+		}
+		body["lineage"] = lineage
+		bundle = factory.ContextBundleLineage
+	} else if assignment.ParentAssignment != "" {
+		body["lineage_incomplete"] = true
+	}
+	body["bundle"] = bundle
+	if read.Frozen {
+		body["terminal_submission"] = read.Terminal.SubmissionID
+		body["terminal_state"] = read.Terminal.State
+	}
+	if assignment.Outcome != "" {
+		body["outcome"] = string(assignment.Outcome)
+	}
+	if assignment.Reason != "" {
+		body["reason"] = assignment.Reason
+	}
+	return body
+}
+
+// Evidence projects the admitted assignment's bounded run history. Missing
+// sources and rows are errors; future collections remain explicitly incomplete.
+func (s WorkerContext) Evidence(ctx context.Context, capability factory.MCPCapability) (map[string]any, error) {
+	if s.Assignments == nil {
+		return nil, errors.New("worker assignment source unavailable")
+	}
+	// Bounded run projection over the recorded assignment's own
+	// attempt: opaque run identities with role and outcome only —
+	// never summaries, admissions, identity bindings or prompt-derived
+	// content. A missing assignment refuses instead of serving
+	// unscoped rows, and an unresolvable recorded run refuses rather
+	// than silently dropping it. Plan/review/inventory pages plus
+	// pagination arrive with FW40, so evidence stays honestly
+	// incomplete.
+	assignment, err := s.Assignments.Assignment(ctx, capability.AssignmentID)
+	if err != nil {
+		return nil, err
+	}
+	history := assignment.RunHistory
+	truncated := false
+	if len(history) > factory.MCPMaxPageRefs {
+		history = history[:factory.MCPMaxPageRefs]
+		truncated = true
+	}
+	runs := make([]any, 0, len(history))
+	for _, id := range history {
+		if s.Runs == nil {
+			return nil, errors.New("evidence run source unwired")
+		}
+		run, err := s.Runs.FactoryRun(ctx, id)
+		if err != nil {
+			return nil, err
+		}
+		projected := map[string]any{"id": run.ID, "role": run.Role}
+		if run.Outcome != "" {
+			projected["outcome"] = string(run.Outcome)
+		}
+		runs = append(runs, projected)
+	}
+	body := map[string]any{
+		"assignment": capability.AssignmentID,
+		"runs":       runs,
+		"complete":   false,
+		"reason":     "plan/review/inventory pages plus pagination arrive with FW40",
+	}
+	if truncated {
+		body["runs_truncated"] = true
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	return body, nil
+}
diff --git a/internal/factory/service/worker_inputs.go b/internal/factory/service/worker_inputs.go
new file mode 100644
index 0000000000000000000000000000000000000000..b2a010d83f84c6c331629256d9bd4cd1be43c20b
--- /dev/null
+++ b/internal/factory/service/worker_inputs.go
@@ -0,0 +1,87 @@
+package service
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"time"
+
+	"github.com/levitateos/sodaos/internal/factory"
+)
+
+// WorkerInputs reads required work facts for an already admitted worker. It
+// joins existing verification observations without a judgment or workflow write.
+// Transport owns capability admission and wire rendering.
+type WorkerInputs struct {
+	Source       WorkerCurrentContextSource
+	Verification func(context.Context, factory.MCPCapability) (map[string]any, error)
+	Now          func() time.Time
+}
+
+func (s WorkerInputs) Read(ctx context.Context, cap factory.MCPCapability) (factory.CurrentContext, error) {
+	if err := ctx.Err(); err != nil {
+		return factory.CurrentContext{}, err
+	}
+	if s.Source == nil {
+		return factory.CurrentContext{Version: "context-current-v1", Role: factory.CurrentRoleContext{Kind: cap.Profile}, Evidence: factory.CurrentContextEvidence{RequiredStreams: []string{"required_current"}, Availability: "unknown", MissingReasons: []string{"required_current_source_unwired"}}}, nil
+	}
+	now := time.Now()
+	if s.Now != nil {
+		now = s.Now()
+	}
+	current, err := s.Source.FactoryCurrentContext(ctx, cap, now)
+	if err != nil {
+		return factory.CurrentContext{}, err
+	}
+	if cap.Profile == factory.MCPProfileTestPilot {
+		if err := s.joinVerification(ctx, cap, &current); err != nil {
+			return factory.CurrentContext{}, err
+		}
+	}
+	if err := ctx.Err(); err != nil {
+		return factory.CurrentContext{}, err
+	}
+	return current, nil
+}
+
+func (s WorkerInputs) joinVerification(ctx context.Context, cap factory.MCPCapability, current *factory.CurrentContext) error {
+	missing := func() {
+		current.Evidence.Availability = "incomplete"
+		current.Evidence.MissingReasons = append(current.Evidence.MissingReasons, "current_native_verification_unavailable")
+	}
+	if current.Role.Delivery == nil || s.Verification == nil {
+		missing()
+		return nil
+	}
+	body, err := s.Verification(ctx, cap)
+	if err != nil {
+		return err
+	}
+	if body["available"] != true {
+		missing()
+		return nil
+	}
+	raw, err := json.Marshal(body["evidence"])
+	if err != nil {
+		return err
+	}
+	var evidence factory.CurrentVerificationEvidence
+	if json.Unmarshal(raw, &evidence) != nil || evidence.ValidateFor(*current.Role.Delivery) != nil {
+		return errors.New("current native verification is malformed")
+	}
+	if e := evidence.Execution; e != nil && (e.Run != cap.RunID || e.Project != cap.Project) {
+		return errors.New("current native verification belongs to another worker")
+	}
+	current.Role.Verification = &evidence
+	missingReasons := []string{}
+	for _, reason := range current.Evidence.MissingReasons {
+		if reason != "current_native_verification_unavailable" {
+			missingReasons = append(missingReasons, reason)
+		}
+	}
+	current.Evidence.MissingReasons = missingReasons
+	if len(missingReasons) == 0 {
+		current.Evidence.Availability = "complete"
+	}
+	return nil
+}
diff --git a/internal/factory/service/worker_results.go b/internal/factory/service/worker_results.go
new file mode 100644
index 0000000000000000000000000000000000000000..7d96f12ddfd0990b0291b7320fcaaf089aa7b972
