+	rebound := connection
+	rebound.Profile = otherProfile.ID
+	if err := s.PutCollaborationConnection(ctx, rebound); !errors.Is(err, collaboration.ErrIdentityConflict) {
+		t.Fatalf("connection moved profiles: %v", err)
