+++ b/internal/github/README.md
@@ -0,0 +1,271 @@
+# GitHub collaboration adapter
+
+This package owns the GitHub REST client and its later collaboration adapters.
+The current client uses go-github v93.0.0 (BSD-3-Clause), selected from official
+release metadata on 2026-11-02, with the supported `2026-03-10` REST API version.
+SDK types stay in this provider package and its adapter consumers; the Factory
+engine and Store retain their provider-neutral contracts.
+
+`New` requires an explicit trusted native `http.RoundTripper`. It accepts no
+token string, token file or environment credential. Native composition must
+freshly bind/admit the selected connection through the existing Rust credential
+custody and honor the request context. A stored credential alone is not a
+verified account or Factory execution authority. Native transport is wired below;
+login, account binding and the production desktop connection remain consumers.
+
+The client makes only GETs to `https://api.github.com`, with no redirects,
+cookies or alternate origins. Reads have an eight-second deadline and an 8 MiB
+whole-response limit. Invalid or null successful JSON refuses. Failures expose
+typed authentication, visibility, permission, rate-limit, moved-resource and
+availability states, HTTP status and retry/reset facts without raw provider
+prose, token-bearing URL errors or bodies. No mutation or retry loop is present.
+
+`AuthenticatedUser` reads `/user`; it never treats a public username lookup as
+sign-in. The connected repository catalogue refuses failed authentication;
+`PublicRepositories` is a distinct explicit public lookup. Pages expose numeric
+continuations and bounded limits, not arbitrary provider Link URLs. They are
+observations of a live list, not a globally atomic catalogue. Repository locators
+resolve to actual remote IDs; mutable owner/name labels are not identity keys.
+
+`IssueList` and `Issue` accept a stable remote repository ID, resolve its current
+name and make a bounded SDK read. Lists default to open, also support closed/all,
+sort by creation and expose the next provider page. GitHub includes PR wrappers:
+these are filtered from lists without scanning more pages. An empty filtered
+page may still have a continuation. Detail refuses a PR wrapper. Actual remote
+issue IDs remain distinct from repository-scoped display numbers. Full raw
+Markdown, nullable author/lock/timestamps, assignees and labels are preserved;
+no action capabilities are inferred. The final repository lookup must still
+match the selected stable ID before any issue data returns. Rename, name reuse,
+visibility failure and cancelled/expired reads refuse rather than return an
+unverified page. The whole list/detail operation shares an eight-second budget.
+
+IssueRecord/IssuePage contain provider-local facts, not canonical product IDs.
+Canonical repository/participant mapping belongs to the connected consumer;
+reading public provider facts does not authenticate or admit a product account.
+
+`Discussion` reads one ordinary issue or PR comment page for an explicit parent
+kind/number and stable repository ID. It verifies the parent using the matching
+issue/pull endpoint before and after I/O, and rechecks repository identity and
+visibility before returning bodies. A PR uses its actual pull ID, not the ID of
+its issue wrapper. Wrong-kind or missing parents refuse before comment reads.
+Comment URLs must belong to the selected parent and ordinary-comment endpoint;
+review comments, submissions and lifecycle events remain separate. Full raw
+Markdown, comment IDs, nullable authors/timestamps and observed minimization
+reasons are retained. Empty pages still name the verified parent. Paging shares
+the same bounded limits and whole-operation eight-second deadline; no scan or
+atomic-history claim is made. DiscussionPage also contains provider-local facts
+which need canonical registry mapping in the connected consumer.
+
+`PullList` and `Pull` read PR pages and any-state detail from the actual pull
+endpoint. Stable repository lookup/recheck, bounded paging and the shared
+eight-second operation deadline apply. Full raw descriptions, actual pull IDs,
+authors/assignees/labels and dates are retained. The closed filter includes both
+merged and unmerged PRs; observed merge facts distinguish their record states.
+Draft, merged, mergeability and rebaseability fields retain null when GitHub
+omits them or has not computed a result. No retry loop or merge capability is
+inferred from these facts.
+
+Base/head references preserve their reported branch name, repository ID/name
+and validated full commit ID. A deleted or unavailable fork stays null, while
+surviving branch/commit facts remain visible. These are observations of the PR
+payload; immutable diff pairs and current target-tip/protection facts must be
+resolved by the file/capability readers. PullRecord/PullPage also require the
+connected consumer's canonical identity mapping before becoming product records.
+
+`PullDiff` resolves a PR's merge-base/head identity before file or anchored-review
+reads. It captures the actual pull ID, PR-payload base SHA, head SHA and target
+branch label, compares those full commits, then rechecks the PR and repository
+under one eight-second budget. A requested full pair must match the observed
+merge-base/head; mismatches or changed PR state return ErrDiffChanged. Discovery
+accepts two empty commit selectors. Half-pairs, branch names and malformed IDs
+refuse. A missing head/base commit makes the scope unavailable.
+
+PullDiffScope keeps the captured `pull_base` separate from the comparison's
+verified `base` (merge base). Closed PR history is preserved; current target-tip
+and protection observations belong to their consumers. Compare metadata uses
+page two with one commit, which avoids the first page's limited file array.
+The file reader below enforces its own immutable-pair paging, patch
+completeness and provider ceilings. Real public discovery and matching/mismatched
+requested pairs are qualified, alongside production-native refusal for both
+empty and saved full-pair descriptors. Successful authenticated/private scope,
+canonical mapping and file/UI integration remain with their consumers.
+
+`PullFiles` produces one provider-local file page, with a limit of 1–10. Only
+page one permits empty-pair discovery. Continuations require the verified full
+merge-base/head pair and retain the same limit. Each read captures and rechecks
+the actual PR ID, base/head, base branch and changed-file count around the files
+endpoint, then rechecks repository identity/visibility. A changed requested or
+observed pair refuses. GitHub's [3000-file ceiling](https://docs.github.com/en/rest/pulls/pulls#list-pull-requests-files)
+returns ErrFilesTooLarge before file I/O; missing totals are unavailable. Page
+length and numeric continuation must agree with the captured total, so a limited
+prefix cannot silently appear complete. The reads share one eight-second budget.
+These are bracketed live observations; the provider offers no atomic snapshot
+or conditional-pair selector for this endpoint.
+
+File records preserve old/new paths, status and nullable addition/deletion
+counts. Removed files map to deleted; renames/copies require the actual previous
+filename. Paths are display/anchor data, never local filesystem access or URLs.
+`patch` is GitHub's hunk fragment, without standalone file headers. Canonical
+mapping and shared-renderer input construction belong to the connected consumer.
+
+Patches are bounded to 16 KiB per file, cut at a UTF-8 boundary and marked
+truncated. Smaller fragments use Sourcegraph go-diff v0.9.0 (MIT, selected from
+official Go proxy release metadata on 2026-11-02) for hunk syntax, then verify
+each declared hunk span and the provider's full addition/deletion totals before
+marking complete. A short hunk or omitted changes remain truncated. Unparseable
+or unverifiable fragments are unavailable. Missing patches also stay unavailable:
+GitHub does not distinguish binary files from omitted large text here. Neither
+an extension nor zero statistics is treated as proof of binary content. File
+records remain provider-local. Real public observations qualify missing patches
+for independently inspected PNG and 306 KB UTF-8 text bytes, actual previous/new
+rename paths, and early refusal of a 13,846-file PR. A real 20,951-byte provider
+fragment is qualified as a valid UTF-8 16,384-byte original prefix marked
+truncated, on a page pinned to the independently verified merge-base/head.
+Authenticated/private/canonical/UI consumption remains downstream.
+
+`PullReviews` and `PullReview` read review submissions through the SDK's
+[dedicated review endpoints](https://docs.github.com/en/rest/pulls/reviews).
+Lists are chronological live provider pages, bounded to 1–50; detail takes the
+actual positive 64-bit review ID, separate from the PR number. Both verify the
+actual PR before/after I/O and recheck the selected stable repository before
+returning bodies. Every review's parent URL must match that PR. Empty pages still
+identify their verified parent; missing, foreign-parent and ordinary-issue
+selectors refuse. The whole operation shares an eight-second budget.
+
+ReviewRecord retains full raw Markdown, actual review/author IDs, nullable
+author/commit/submission facts and the original provider state. Known states map
+to pending/approved/changes_requested/commented/dismissed; future or missing
+states remain unknown. Pending records cannot claim a submitted timestamp.
+Reported commits are historical review facts, with no substituted current head
+or latest-head approval. Ordinary issue/PR comments and inline threads remain
+separate. Real public paging/detail/empty/refusal checks and three submitted
+states are qualified; authenticated pending/private, null/deleted-author edge
+cases, canonical mapping and UI integration remain in the full provider gate.
+
+`PullReviewComments` and `PullReviewComment` read inline review comments as live
+pages/detail, separately from ordinary discussions and review submissions. They
+verify the actual PR before/after I/O and recheck stable repository visibility
+under one eight-second budget. Detail lookup uses the repository-wide comment
+endpoint, so its returned PR URL must also match the selected parent; a comment
+from another PR refuses rather than appearing under the requested subject.
+
+Comment/review/reply IDs, full raw Markdown and diff excerpts, author/association,
+nullable paths, commits, line ranges/sides, legacy positions, subject type and
+dates remain provider evidence. A reply's parent may be outside its current page
+and can be fetched by detail. Original commit is a review commit, not an immutable
+diff base. Null current lines do not establish resolution or a complete immutable
+anchor; GraphQL thread identity/resolution and verified diff-pair translation
+remain consumers. No thread is fabricated from the REST reply links. See the
+[review-comment endpoint](https://docs.github.com/en/rest/pulls/comments#list-review-comments-on-a-pull-request).
+
+`PullCommitStatuses` reads one live legacy commit-status history page (1–50)
+for a captured PR head. Discovery accepts an empty head only on page one;
+continuations require the full captured commit ID. It verifies the actual PR
+before/after the status read and rechecks stable repository identity, under one
+eight-second budget. Changed/requested heads refuse with ErrChecksChanged.
+
+Status IDs, contexts, creator IDs, nullable raw state/description/target URL and
+timestamps remain provider observations. Known pending/success/failure/error
+states retain their spelling; unknown/null states remain unknown. The endpoint
+returns newest-first history, so repeated contexts and earlier updates are
+preserved. Page numbers are not an atomic history snapshot. Empty status history
+does not establish success, and this reader does not combine contexts/check runs
+or infer branch requirements, current merge gates or write authority. See the
+[provider endpoint](https://docs.github.com/en/rest/commits/statuses#list-commit-statuses-for-a-reference).
+
+`PullCheckRuns` reads one live check-run page (1–50) for a captured PR head.
+Only page one accepts empty-head discovery; later pages require the captured
+full commit ID. The PR's actual ID/head and stable repository visibility are
+rechecked before returning. Requested or observed head changes return
+ErrChecksChanged. Every reported check run must name the captured SHA and its
+actual repository check-run URL. The operation shares one eight-second budget.
+
+Records retain actual check-run IDs, names, nullable raw status/conclusion,
+timestamps, details URL, app identity and output title/summary/text/count facts.
+Known states/conclusions normalize explicitly; missing/future values stay unknown.
+Check-run IDs are not Actions job or workflow-run IDs. No action, requiredness,
+combined CI verdict or merge authority is inferred. Annotation bodies are not
+fetched and provider URLs are not followed. Output/URLs remain untrusted data for
+the canonical presentation consumer.
+
+The SDK request selects `filter=all` within the provider's available window.
+`total` describes that window, not an all-time history. GitHub
+[limits this endpoint to the 1000 most recent check suites](https://docs.github.com/en/rest/checks/runs#list-check-runs-for-a-git-reference)
+when there are more; exhausting its pages alone cannot prove complete CI history
+or a satisfied merge gate. The canonical gate consumer must account for this
+limit, separate commit statuses, branch requirements, app/context selection and
+live changes to checks on the same head. Real public discovery/pinned continuation
+is qualified; broader state/race/private/gate/UI qualification remains downstream.
+
+`NewNativeReadHandler` is mounted only by the native executable's private host,
+behind its peer/key/instance and application admission/drain gates. Rust's typed
+`github_read` port lends one credential with `with_token_operation`, verifies
+fresh scope after I/O and cancels Unix HTTP on future drop. Its per-request
+sensitive header is removed before dispatch and is not persisted. The Go handler
+has a six-second context, always verifies `/user` against the captured account,
+then optionally reads one bounded repository page or a stable repository ID.
+Typed `issues`/`issue` selectors read a page or detail through the same current
+account check and return the provider-local issue observations described above.
+Typed `pulls`/`pull` selectors do the same for PR metadata and nullable facts.
+Typed `pull_diff` resolves or verifies the commit pair through the same native
+account gate. Changed pairs return HTTP 409/github_diff_changed. Rust validates
+the returned parent, repository, full commit identities and any requested pair.
+Typed `pull_files` reads one bounded page behind the same account/credential
+gate. Go shares the producer's query validation and returns HTTP
+413/github_files_too_large for the provider ceiling. Rust checks the nested diff
+repository/PR/pair and the requested page/limit, total, item count and numeric
+continuation before returning success. Discovery and pinned descriptors are
+qualified through real isolated OS custody/native PG/Go/GitHub authentication
+refusal. A generated invalid token never qualifies successful file access;
+that remains part of the authenticated provider gate.
+Typed `pull_reviews`/`pull_review` read submission pages or an actual review ID
+behind the same account/credential gate. Go validates review selectors and Rust
+checks returned repository, PR kind/number, page cardinality and any requested
+detail ID. Real isolated native keyring/PG/Go/GitHub 401 qualification covers
+both descriptors, including a review ID larger than 32 bits. It proves refusal
+and custody, not a successful authenticated review read.
+Typed `pull_check_runs` carries page/limit and optional full head through that
+same account/credential boundary. Rust checks the returned repository, PR
+kind/number, full head/requested pin, bounded item count and each item's head.
+Changed check heads return HTTP 409/github_checks_changed. Real isolated native
+OS custody/PG/backend/GitHub 401 qualifies discovery and a saved real full-head
+continuation descriptor, without qualifying successful authenticated CI access.
+Typed `issue_comments`/`pull_comments` selectors use the same admission and
+current-account verification. Malformed state/page/number descriptors refuse
+before provider I/O. Rust checks kind, account, connection, selected resource
+repository and discussion parent kind/number on success.
+Only provider-local read facts or sanitized failures return. The
+borrowed transport/header exists only for that call; no SDK token source or
+background retry worker is installed. This is not a public HTTP proxy or a
+webview token command, and it does not admit Factory work.
+
+The native RPC's separate `verify` operation accepts a new unpersisted token,
+with no claimed account, connection, repository or page. It reads only `/user`
+and returns the actual remote account ID/login. Rust's `github_verify` consumes
+that native token, checks the response and current runtime, then returns an
+opaque `Account`/`Token` pair to native login code for OS custody. Refusals return
+only HTTP status; neither token nor raw response reaches the browser. This
+bootstrap does not create a saved account or admit Factory work. The other read
+operations still require a stored connection and matching actual account.
+Successful OAuth verification/storage and canonical binding remain pending;
+never store a guessed placeholder account to bootstrap the existing-account port.
+
+T06-GITHUB still owns public-client/device login, remotely verified account
+binding, normalized issue/PR/review/check/capability adapters, authenticated
+private paging and revocation. It needs a Factory-owned OAuth app public client
+ID with device flow enabled; no client secret or shared app key belongs in the
+desktop. The owner has no registration yet. Registration does not require first
+moving Factory to a public repository. No connected-plugin, GitHub CLI or
+personal account credentials are silently borrowed by this package.
+
+The first live component observation made seven read-only requests to actual
+GitHub without credentials: public repository resolution and stable-ID lookup,
+two public pages, real 404 and 401 responses. Invalid selectors and cancelled
+contexts made no I/O. Evidence is recorded in the canonical implementation
+backlog; those public observations do not qualify authenticated login/private
+reads. No synthetic server or public-data fallback completes that gate.
+The native transport observation additionally uses the production executable,
+real isolated keyring/PG/Go and actual GitHub 401 replies with generated invalid
+tokens. A diagnostic composition uses the same host/handler/SDK and observes
+headers/pauses before real HTTPS to prove rotation, withdrawal and cancellation.
+It does not replace GitHub responses or qualify an authenticated account.
diff --git a/internal/github/check_runs.go b/internal/github/check_runs.go
new file mode 100644
index 0000000000000000000000000000000000000000..6fa89dee83b59a7f2a52e3d2255d8a084e7ebd28
--- /dev/null
+++ b/internal/github/check_runs.go
@@ -0,0 +1,145 @@
+package github
+
+import (
+	"context"
+	"strconv"
+	"time"
+
+	sdk "github.com/google/go-github/v93/github"
+	"github.com/levitateos/sodaos/internal/collaboration"
+)
+
+// Provider-local check-run observations. A check-run ID is not an Actions job
+// or workflow-run ID. Status requirements and merge authority are separate.
+type CheckRunRecord struct {
+	ExternalID         string       `json:"external_id"`
+	Name               string       `json:"name"`
+	Head               string       `json:"head"`
+	ProviderStatus     *string      `json:"provider_status"`
+	ProviderConclusion *string      `json:"provider_conclusion"`
+	State              string       `json:"state"`
+	Conclusion         string       `json:"conclusion"`
+	DetailsURL         *string      `json:"details_url"`
+	StartedAt          *time.Time   `json:"started_at"`
+	CompletedAt        *time.Time   `json:"completed_at"`
+	App                *CheckApp    `json:"app"`
+	Output             *CheckOutput `json:"output"`
+}
+type CheckApp struct {
+	ExternalID string  `json:"external_id"`
+	Slug       *string `json:"slug"`
+	Name       *string `json:"name"`
+}
+type CheckOutput struct {
+	Title            *string `json:"title"`
+	Summary          *string `json:"summary"`
+	Text             *string `json:"text"`
+	AnnotationsCount *int    `json:"annotations_count"`
+}
+type CheckRunPage struct {
+	Repository string            `json:"repository"`
+	Name       string            `json:"name"`
+	Pull       DiscussionSubject `json:"pull"`
+	Head       string            `json:"head"`
+	Items      []CheckRunRecord  `json:"items"`
+	Total      *int              `json:"total"` // Provider window, not an all-time history count.
+	NextPage   int               `json:"next_page"`
+}
+
+func validCheckHeadQuery(page, limit int, head string) bool {
+	return pageQuery(page, limit) && (head == "" && page == 1 || collaboration.ValidCommitID(collaboration.CommitID(head)))
+}
+
+// PullCheckRuns reads one live provider page for a captured current PR head.
+// Continuations require that full head; checks can still change on that head.
+func (c *Client) PullCheckRuns(ctx context.Context, repository int64, number, page, limit int, head string) (CheckRunPage, error) {
+	if repository < 1 || number < 1 || !validCheckHeadQuery(page, limit, head) {
+		return CheckRunPage{}, ErrInvalidRequest
+	}
+	ctx, cancel := context.WithTimeout(ctx, timeout)
+	defer cancel()
+	owner, name, err := c.issueLocator(ctx, repository)
+	if err != nil {
+		return CheckRunPage{}, err
+	}
+	before, err := c.checkHead(ctx, repository, owner, name, number)
+	if err != nil {
+		return CheckRunPage{}, err
+	}
+	if head != "" && head != before.Head {
+		return CheckRunPage{}, ErrChecksChanged
+	}
+	filter := "all"
+	checks, response, err := c.sdk.Checks.ListCheckRunsForRef(ctx, owner, name, before.Head, &sdk.ListCheckRunsOptions{Filter: &filter, ListOptions: sdk.ListOptions{Page: page, PerPage: limit}})
+	info, err := result(ctx, response, err)
+	if err != nil {
+		return CheckRunPage{}, err
+	}
+	if checks == nil || checks.CheckRuns == nil || len(checks.CheckRuns) > limit || checks.Total != nil && *checks.Total < 0 || info.NextPage != 0 && (len(checks.CheckRuns) == 0 || info.NextPage <= page || info.NextPage > 1_000_000) {
+		return CheckRunPage{}, ErrInvalidResponse
+	}
+	r := CheckRunPage{Repository: strconv.FormatInt(repository, 10), Name: owner + "/" + name, Pull: before.Pull, Head: before.Head, Items: make([]CheckRunRecord, 0, len(checks.CheckRuns)), Total: checks.Total, NextPage: info.NextPage}
+	seen := map[int64]bool{}
+	for _, check := range checks.CheckRuns {
+		if check == nil || check.GetID() < 1 || seen[check.GetID()] || check.GetName() == "" || check.GetHeadSHA() != before.Head || check.GetURL() != "https://api.github.com/repos/"+owner+"/"+name+"/check-runs/"+strconv.FormatInt(check.GetID(), 10) {
+			return CheckRunPage{}, ErrInvalidResponse
+		}
+		seen[check.GetID()] = true
+		record := CheckRunRecord{ExternalID: strconv.FormatInt(check.GetID(), 10), Name: check.GetName(), Head: before.Head, ProviderStatus: check.Status, ProviderConclusion: check.Conclusion, State: "unknown", Conclusion: "unknown", DetailsURL: check.DetailsURL, StartedAt: issueTime(check.StartedAt), CompletedAt: issueTime(check.CompletedAt)}
+		switch check.GetStatus() {
+		case "queued", "waiting", "requested", "pending":
+			record.State = "pending"
+		case "in_progress":
+			record.State = "running"
+		case "completed":
+			record.State = "completed"
+		}
+		switch check.GetConclusion() {
+		case "success", "failure", "neutral", "skipped", "cancelled", "timed_out", "action_required", "stale":
+			record.Conclusion = check.GetConclusion()
+		}
+		if app := check.App; app != nil {
+			if app.GetID() < 1 {
+				return CheckRunPage{}, ErrInvalidResponse
+			}
+			record.App = &CheckApp{ExternalID: strconv.FormatInt(app.GetID(), 10), Slug: app.Slug, Name: app.Name}
+		}
+		if output := check.Output; output != nil {
+			if output.AnnotationsCount != nil && *output.AnnotationsCount < 0 {
+				return CheckRunPage{}, ErrInvalidResponse
+			}
+			record.Output = &CheckOutput{Title: output.Title, Summary: output.Summary, Text: output.Text, AnnotationsCount: output.AnnotationsCount}
+		}
+		r.Items = append(r.Items, record)
+	}
+	after, err := c.checkHead(ctx, repository, owner, name, number)
+	if err != nil {
+		return CheckRunPage{}, err
+	}
+	if after != before {
+		return CheckRunPage{}, ErrChecksChanged
+	}
+	if err := c.checkIssueLocator(ctx, repository, owner, name); err != nil {
+		return CheckRunPage{}, err
+	}
+	return r, nil
+}
+
+type checkHead struct {
+	Pull DiscussionSubject
+	Head string
+}
+
+func (c *Client) checkHead(ctx context.Context, repository int64, owner, name string, number int) (checkHead, error) {
+	pull, response, err := c.sdk.PullRequests.Get(ctx, owner, name, number)
+	if _, err := result(ctx, response, err); err != nil {
+		return checkHead{}, err
+	}
+	if !validPull(pull, repository, owner, name) || pull.GetNumber() != number {
+		return checkHead{}, ErrInvalidResponse
+	}
+	if pull.Head == nil || !collaboration.ValidCommitID(collaboration.CommitID(pull.Head.GetSHA())) {
+		return checkHead{}, ErrUnavailable
+	}
+	return checkHead{Pull: DiscussionSubject{Kind: "pull", ExternalID: strconv.FormatInt(pull.GetID(), 10), Number: number}, Head: pull.Head.GetSHA()}, nil
+}
diff --git a/internal/github/client.go b/internal/github/client.go
new file mode 100644
index 0000000000000000000000000000000000000000..791a1b56dccd19ed264c9b52ce2216e1870d61b5
--- /dev/null
+++ b/internal/github/client.go
@@ -0,0 +1,286 @@
+// Package github owns GitHub REST translation. Credentials remain in native
+// custody; reading a GitHub record grants no Factory execution authority.
+package github
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"strconv"
+	"strings"
+	"time"
+
+	sdk "github.com/google/go-github/v93/github"
+)
+
+const APIVersion = "2026-03-10"
+const timeout = 8 * time.Second
+const responseLimit = 8 << 20
+
+var (
+	ErrInvalidRequest   = errors.New("invalid GitHub read request")
+	ErrCredentials      = errors.New("GitHub sign-in is required")
+	ErrNotVisible       = errors.New("GitHub resource is not visible")
+	ErrForbidden        = errors.New("GitHub permission is unavailable")
+	ErrRateLimited      = errors.New("GitHub rate limit reached")
+	ErrRedirect         = errors.New("GitHub resource moved; resolve its stable identity")
+	ErrUnavailable      = errors.New("GitHub is unavailable")
+	ErrInvalidResponse  = errors.New("GitHub returned an invalid read response")
+	ErrResponseTooLarge = errors.New("GitHub read response exceeds the limit")
+	ErrDiffChanged      = errors.New("GitHub pull diff changed")
+	ErrFilesTooLarge    = errors.New("GitHub pull exceeds the file listing limit")
+	ErrChecksChanged    = errors.New("GitHub pull check head changed")
+)
+
+// Failure retains status/retry facts without provider prose, bodies or URL errors.
+type Failure struct {
+	Kind       error
+	Status     int
+	RetryAfter time.Duration
+	Reset      time.Time
+}
+
+func (e *Failure) Error() string { return e.Kind.Error() }
+func (e *Failure) Unwrap() error { return e.Kind }
+
+// PageInfo describes one provider page, not an atomic repository catalogue.
+// NextPage is a number, never an arbitrary Link URL passed to credential custody.
+type PageInfo struct {
+	NextPage   int
+	LastPage   int
+	Remaining  int
+	Reset      time.Time
+	ETag       string
+	APIVersion string
+}
+
+type Client struct{ sdk *sdk.Client }
+
+// New requires a trusted native transport. There is no default credential,
+// token argument, environment lookup or implicit anonymous fallback. The native
+// consumer must freshly admit its connection and honor request cancellation.
+// This client is not exposed as a generic webview HTTP bridge.
+func New(native http.RoundTripper) (*Client, error) {
+	if native == nil {
+		return nil, ErrCredentials
+	}
+	client, err := sdk.NewClient(sdk.WithHTTPClient(&http.Client{
+		Transport: readTransport{native}, Timeout: timeout,
+		CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse },
+	}), sdk.WithUserAgent("soda-factory"))
+	if err != nil {
+		return nil, ErrUnavailable
+	}
+	return &Client{sdk: client}, nil
+}
+
+type readTransport struct{ native http.RoundTripper }
+
+func (t readTransport) RoundTrip(request *http.Request) (*http.Response, error) {
+	u := request.URL
+	if request.Method != http.MethodGet || request.Body != nil && request.Body != http.NoBody || u == nil || u.Scheme != "https" || u.Host != "api.github.com" || u.User != nil || u.Fragment != "" || u.Opaque != "" || u.RawPath != "" || !strings.HasPrefix(u.Path, "/") {
+		return nil, ErrInvalidRequest
+	}
+	if err := request.Context().Err(); err != nil {
+		return nil, err
+	}
+	request = request.Clone(request.Context())
+	request.Header.Set("X-GitHub-Api-Version", APIVersion)
+	request.Header.Set("Accept", "application/vnd.github+json")
+	response, err := t.native.RoundTrip(request)
+	if err != nil {
+		return nil, err
+	}
+	if response == nil || response.Body == nil {
+		return nil, ErrInvalidResponse
+	}
+	defer response.Body.Close()
+	body, err := io.ReadAll(io.LimitReader(response.Body, responseLimit+1))
+	if err != nil {
+		return nil, ErrUnavailable
+	}
+	if len(body) > responseLimit {
+		return nil, ErrResponseTooLarge
+	}
+	if response.StatusCode >= 200 && response.StatusCode < 300 && (!json.Valid(body) || bytes.Equal(bytes.TrimSpace(body), []byte("null"))) {
+		return nil, ErrInvalidResponse
+	}
+	if err := request.Context().Err(); err != nil {
+		return nil, err
+	}
+	response.Body = io.NopCloser(bytes.NewReader(body))
+	return response, nil
+}
+
+func result(ctx context.Context, response *sdk.Response, err error) (PageInfo, error) {
+	info := PageInfo{}
+	if response != nil {
+		info = PageInfo{NextPage: response.NextPage, LastPage: response.LastPage, Remaining: response.Rate.Remaining, Reset: response.Rate.Reset.Time, ETag: response.Header.Get("ETag"), APIVersion: response.Header.Get("X-GitHub-Api-Version-Selected")}
+	}
+	if err == nil {
+		return info, nil
+	}
+	if ctx.Err() != nil {
+		return info, ctx.Err()
+	}
+	for _, kind := range []error{ErrInvalidRequest, ErrInvalidResponse, ErrResponseTooLarge} {
+		if errors.Is(err, kind) {
+			return info, kind
+		}
+	}
+	failure := &Failure{Kind: ErrUnavailable, Reset: info.Reset}
+	if response != nil {
+		failure.Status = response.StatusCode
+		if seconds, parseErr := strconv.ParseUint(response.Header.Get("Retry-After"), 10, 32); parseErr == nil {
+			failure.RetryAfter = time.Duration(seconds) * time.Second
+		}
+		switch response.StatusCode {
+		case http.StatusUnauthorized:
+			failure.Kind = ErrCredentials
+		case http.StatusNotFound:
+			failure.Kind = ErrNotVisible
+		case http.StatusForbidden:
+			failure.Kind = ErrForbidden
+		case http.StatusTooManyRequests:
+			failure.Kind = ErrRateLimited
+		case http.StatusMovedPermanently, http.StatusFound, http.StatusTemporaryRedirect, http.StatusPermanentRedirect:
+			failure.Kind = ErrRedirect
+		case http.StatusBadRequest, http.StatusUnprocessableEntity:
+			failure.Kind = ErrInvalidRequest
+		default:
+			if response.StatusCode >= 200 && response.StatusCode < 300 {
+				failure.Kind = ErrInvalidResponse
+			}
+		}
+	}
+	var primary *sdk.RateLimitError
+	var secondary *sdk.AbuseRateLimitError
+	if errors.As(err, &primary) {
+		failure.Kind, failure.Reset = ErrRateLimited, primary.Rate.Reset.Time
+		if primary.Response != nil {
+			failure.Status = primary.Response.StatusCode
+		}
+	}
+	if errors.As(err, &secondary) {
+		failure.Kind = ErrRateLimited
+		if secondary.RetryAfter != nil {
+			failure.RetryAfter = *secondary.RetryAfter
+		}
+		if secondary.Response != nil {
+			failure.Status = secondary.Response.StatusCode
+		}
+	}
+	return info, failure
+}
+
+// AuthenticatedUser observes /user, never a supplied username or public profile.
+// Only a successful native credential-backed result can later bind an account.
+func (c *Client) AuthenticatedUser(ctx context.Context) (*sdk.User, PageInfo, error) {
+	ctx, cancel := context.WithTimeout(ctx, timeout)
+	defer cancel()
+	user, response, err := c.sdk.Users.Get(ctx, "")
+	info, err := result(ctx, response, err)
+	if err != nil {
+		return nil, info, err
+	}
+	if user == nil || user.GetID() < 1 || user.GetLogin() == "" {
+		return nil, info, ErrInvalidResponse
+	}
+	return user, info, nil
+}
+
+func (c *Client) RepositoryByID(ctx context.Context, id int64) (*sdk.Repository, PageInfo, error) {
+	if id < 1 {
+		return nil, PageInfo{}, ErrInvalidRequest
+	}
+	ctx, cancel := context.WithTimeout(ctx, timeout)
+	defer cancel()
+	repo, response, err := c.sdk.Repositories.GetByID(ctx, id)
+	info, err := result(ctx, response, err)
+	if err != nil {
+		return nil, info, err
+	}
+	if !validRepository(repo) || repo.GetID() != id {
+		return nil, info, ErrInvalidResponse
+	}
+	return repo, info, nil
+}
+
+// Repository resolves an entered locator; callers retain the returned ID as
+// identity. A mutable owner/name is never a substitute for that identity.
+func (c *Client) Repository(ctx context.Context, owner, name string) (*sdk.Repository, PageInfo, error) {
+	if !segment(owner) || !segment(name) {
+		return nil, PageInfo{}, ErrInvalidRequest
+	}
+	ctx, cancel := context.WithTimeout(ctx, timeout)
+	defer cancel()
+	repo, response, err := c.sdk.Repositories.Get(ctx, owner, name)
+	info, err := result(ctx, response, err)
+	if err != nil {
+		return nil, info, err
+	}
+	if !validRepository(repo) {
+		return nil, info, ErrInvalidResponse
+	}
+	return repo, info, nil
+}
+
+// Repositories is the connected account's catalogue. It never falls back to a
+// public user's catalogue after authentication or permission failure.
+func (c *Client) Repositories(ctx context.Context, page, limit int) ([]*sdk.Repository, PageInfo, error) {
+	if !pageQuery(page, limit) {
+		return nil, PageInfo{}, ErrInvalidRequest
+	}
+	ctx, cancel := context.WithTimeout(ctx, timeout)
+	defer cancel()
+	repos, response, err := c.sdk.Repositories.ListByAuthenticatedUser(ctx, &sdk.RepositoryListByAuthenticatedUserOptions{Visibility: "all", Affiliation: "owner,collaborator,organization_member", Sort: "created", Direction: "asc", ListOptions: sdk.ListOptions{Page: page, PerPage: limit}})
+	return repositoryPage(ctx, repos, response, err, limit)
+}
+
+// PublicRepositories is an explicit public lookup, never account admission.
+func (c *Client) PublicRepositories(ctx context.Context, owner string, page, limit int) ([]*sdk.Repository, PageInfo, error) {
+	if !segment(owner) || !pageQuery(page, limit) {
+		return nil, PageInfo{}, ErrInvalidRequest
+	}
+	ctx, cancel := context.WithTimeout(ctx, timeout)
+	defer cancel()
+	repos, response, err := c.sdk.Repositories.ListByUser(ctx, owner, &sdk.RepositoryListByUserOptions{Sort: "created", Direction: "asc", ListOptions: sdk.ListOptions{Page: page, PerPage: limit}})
+	return repositoryPage(ctx, repos, response, err, limit)
+}
+func repositoryPage(ctx context.Context, repos []*sdk.Repository, response *sdk.Response, err error, limit int) ([]*sdk.Repository, PageInfo, error) {
+	info, err := result(ctx, response, err)
+	if err != nil {
+		return nil, info, err
+	}
+	if repos == nil || len(repos) > limit {
+		return nil, info, ErrInvalidResponse
+	}
+	seen := map[int64]bool{}
+	for _, repo := range repos {
+		if !validRepository(repo) || seen[repo.GetID()] {
+			return nil, info, ErrInvalidResponse
+		}
+		seen[repo.GetID()] = true
+	}
+	return repos, info, nil
+}
+func validRepository(repo *sdk.Repository) bool {
+	return repo != nil && repo.GetID() > 0 && repo.GetFullName() != "" && repo.GetOwner().GetID() > 0
+}
+func pageQuery(page, limit int) bool {
+	return page > 0 && page <= 1_000_000 && limit > 0 && limit <= 50
+}
+func segment(value string) bool {
+	if value == "" || len(value) > 100 || value == "." || value == ".." {
+		return false
+	}
+	for _, c := range value {
+		if !(c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '-' || c == '_' || c == '.') {
+			return false
+		}
+	}
+	return true
+}
diff --git a/internal/github/commit_statuses.go b/internal/github/commit_statuses.go
new file mode 100644
index 0000000000000000000000000000000000000000..d446a38b69c4612e951dc1d05baeb98b6b6cd35c
--- /dev/null
+++ b/internal/github/commit_statuses.go
@@ -0,0 +1,95 @@
+package github
+
+import (
+	"context"
+	"strconv"
+	"time"
+
+	sdk "github.com/google/go-github/v93/github"
+)
+
+// Commit statuses are legacy status observations, not check runs or required
+// gates. Repeated contexts retain each actual status ID in provider history order.
+type CommitStatusRecord struct {
+	ExternalID    string      `json:"external_id"`
+	Head          string      `json:"head"`
+	Context       *string     `json:"context"`
+	ProviderState *string     `json:"provider_state"`
+	State         string      `json:"state"`
+	Description   *string     `json:"description"`
+	TargetURL     *string     `json:"target_url"`
+	Creator       *IssueActor `json:"creator"`
+	CreatedAt     *time.Time  `json:"created_at"`
+	UpdatedAt     *time.Time  `json:"updated_at"`
+}
+
+type CommitStatusPage struct {
+	Repository string               `json:"repository"`
+	Name       string               `json:"name"`
+	Pull       DiscussionSubject    `json:"pull"`
+	Head       string               `json:"head"`
+	Items      []CommitStatusRecord `json:"items"`
+	NextPage   int                  `json:"next_page"`
+}
+
+// PullCommitStatuses reads one newest-first history page, not latest-per-context
+// aggregation. Continuations require the captured full PR head. New statuses may
+// still arrive for that head; this is not an atomic history or a merge decision.
+func (c *Client) PullCommitStatuses(ctx context.Context, repository int64, number, page, limit int, head string) (CommitStatusPage, error) {
+	if repository < 1 || number < 1 || !validCheckHeadQuery(page, limit, head) {
+		return CommitStatusPage{}, ErrInvalidRequest
+	}
+	ctx, cancel := context.WithTimeout(ctx, timeout)
+	defer cancel()
+	owner, name, err := c.issueLocator(ctx, repository)
+	if err != nil {
+		return CommitStatusPage{}, err
+	}
+	before, err := c.checkHead(ctx, repository, owner, name, number)
+	if err != nil {
+		return CommitStatusPage{}, err
+	}
+	if head != "" && head != before.Head {
+		return CommitStatusPage{}, ErrChecksChanged
+	}
+	statuses, response, err := c.sdk.Repositories.ListStatuses(ctx, owner, name, before.Head, &sdk.ListOptions{Page: page, PerPage: limit})
+	info, err := result(ctx, response, err)
+	if err != nil {
+		return CommitStatusPage{}, err
+	}
+	if statuses == nil || len(statuses) > limit || info.NextPage != 0 && (len(statuses) == 0 || info.NextPage <= page || info.NextPage > 1_000_000) {
+		return CommitStatusPage{}, ErrInvalidResponse
+	}
+	r := CommitStatusPage{Repository: strconv.FormatInt(repository, 10), Name: owner + "/" + name, Pull: before.Pull, Head: before.Head, Items: make([]CommitStatusRecord, 0, len(statuses)), NextPage: info.NextPage}
+	seen := map[int64]bool{}
+	for _, status := range statuses {
+		if status == nil || status.GetID() < 1 || seen[status.GetID()] || status.GetURL() != "https://api.github.com/repos/"+owner+"/"+name+"/statuses/"+before.Head {
+			return CommitStatusPage{}, ErrInvalidResponse
+		}
+		seen[status.GetID()] = true
+		record := CommitStatusRecord{ExternalID: strconv.FormatInt(status.GetID(), 10), Head: before.Head, Context: status.Context, ProviderState: status.State, State: "unknown", Description: status.Description, TargetURL: status.TargetURL, CreatedAt: issueTime(status.CreatedAt), UpdatedAt: issueTime(status.UpdatedAt)}
+		switch status.GetState() {
+		case "pending", "success", "failure", "error":
+			record.State = status.GetState()
+		}
+		if status.Creator != nil {
+			actor, err := issueActor(status.Creator)
+			if err != nil {
+				return CommitStatusPage{}, err
+			}
+			record.Creator = &actor
+		}
+		r.Items = append(r.Items, record)
+	}
+	after, err := c.checkHead(ctx, repository, owner, name, number)
+	if err != nil {
+		return CommitStatusPage{}, err
+	}
+	if after != before {
+		return CommitStatusPage{}, ErrChecksChanged
+	}
+	if err := c.checkIssueLocator(ctx, repository, owner, name); err != nil {
+		return CommitStatusPage{}, err
+	}
+	return r, nil
+}
diff --git a/internal/github/discussions.go b/internal/github/discussions.go
new file mode 100644
index 0000000000000000000000000000000000000000..50aa7747e74abcab53fdb7f9eb51769f439fae79
--- /dev/null
+++ b/internal/github/discussions.go
@@ -0,0 +1,121 @@
+package github
+
+import (
+	"context"
+	"strconv"
+	"time"
+
+	sdk "github.com/google/go-github/v93/github"
+)
+
+// Ordinary discussion only. Review submissions, inline threads and lifecycle
+// events belong to separate readers. Identities here are provider-local facts.
+type DiscussionSubject struct {
+	Kind       string `json:"kind"`
+	ExternalID string `json:"external_id"`
+	Number     int    `json:"number"`
+}
+type CommentRecord struct {
+	ExternalID      string      `json:"external_id"`
+	Author          *IssueActor `json:"author"`
+	Body            string      `json:"body"`
+	CreatedAt       *time.Time  `json:"created_at"`
+	UpdatedAt       *time.Time  `json:"updated_at"`
+	MinimizedReason *string     `json:"minimized_reason"`
+}
+type DiscussionPage struct {
+	Repository string            `json:"repository"`
+	Name       string            `json:"name"`
+	Subject    DiscussionSubject `json:"subject"`
+	Items      []CommentRecord   `json:"items"`
+	NextPage   int               `json:"next_page"`
+}
+
+// Discussion reads exactly one page of ordinary comments, including for a closed
+// parent. Parent IDs come from the matching issue/pull endpoint, not route
+// numbers or a PR's issue-wrapper ID. Post-I/O parent/repository checks must
+// succeed before any body returns. The whole operation shares one deadline.
+func (c *Client) Discussion(ctx context.Context, repository int64, kind string, number, page, limit int) (DiscussionPage, error) {
+	if repository < 1 || number < 1 || kind != "issue" && kind != "pull" || !pageQuery(page, limit) {
+		return DiscussionPage{}, ErrInvalidRequest
+	}
+	ctx, cancel := context.WithTimeout(ctx, timeout)
+	defer cancel()
+	owner, name, err := c.issueLocator(ctx, repository)
+	if err != nil {
+		return DiscussionPage{}, err
+	}
+	subject, err := c.discussionSubject(ctx, repository, owner, name, kind, number)
+	if err != nil {
+		return DiscussionPage{}, err
+	}
+	sort, direction := "created", "asc"
+	comments, response, err := c.sdk.Issues.ListComments(ctx, owner, name, number, &sdk.IssueListCommentsOptions{
+		Sort: &sort, Direction: &direction, ListOptions: sdk.ListOptions{Page: page, PerPage: limit},
+	})
+	info, err := result(ctx, response, err)
+	if err != nil {
+		return DiscussionPage{}, err
+	}
+	if comments == nil || len(comments) > limit || info.NextPage != 0 && (info.NextPage <= page || info.NextPage > 1_000_000) {
+		return DiscussionPage{}, ErrInvalidResponse
+	}
+	result := DiscussionPage{Repository: strconv.FormatInt(repository, 10), Name: owner + "/" + name, Subject: subject, Items: make([]CommentRecord, 0, len(comments)), NextPage: info.NextPage}
+	parentURL := "https://api.github.com/repos/" + owner + "/" + name + "/issues/" + strconv.Itoa(number)
+	seen := map[int64]bool{}
+	for _, comment := range comments {
+		if comment == nil || comment.GetID() < 1 || seen[comment.GetID()] || comment.GetIssueURL() != parentURL ||
+			comment.GetURL() != "https://api.github.com/repos/"+owner+"/"+name+"/issues/comments/"+strconv.FormatInt(comment.GetID(), 10) {
+			return DiscussionPage{}, ErrInvalidResponse
+		}
+		seen[comment.GetID()] = true
+		record := CommentRecord{ExternalID: strconv.FormatInt(comment.GetID(), 10), Body: comment.GetBody(), CreatedAt: issueTime(comment.CreatedAt), UpdatedAt: issueTime(comment.UpdatedAt)}
+		if comment.User != nil {
+			author, err := issueActor(comment.User)
+			if err != nil {
+				return DiscussionPage{}, err
+			}
+			record.Author = &author
+		}
+		if comment.Minimized != nil {
+			record.MinimizedReason = comment.Minimized.Reason
+		}
+		result.Items = append(result.Items, record)
+	}
+	after, err := c.discussionSubject(ctx, repository, owner, name, kind, number)
+	if err != nil {
+		return DiscussionPage{}, err
+	}
+	if after != subject {
+		return DiscussionPage{}, ErrNotVisible
+	}
+	if err := c.checkIssueLocator(ctx, repository, owner, name); err != nil {
+		return DiscussionPage{}, err
+	}
+	return result, nil
+}
+
+func (c *Client) discussionSubject(ctx context.Context, repository int64, owner, name, kind string, number int) (DiscussionSubject, error) {
+	if kind == "issue" {
+		issue, response, err := c.sdk.Issues.Get(ctx, owner, name, number)
+		if _, err := result(ctx, response, err); err != nil {
+			return DiscussionSubject{}, err
+		}
+		if !validIssue(issue, owner, name) || issue.GetNumber() != number {
+			return DiscussionSubject{}, ErrInvalidResponse
+		}
+		if issue.IsPullRequest() {
+			return DiscussionSubject{}, ErrNotVisible
+		}
+		return DiscussionSubject{Kind: kind, ExternalID: strconv.FormatInt(issue.GetID(), 10), Number: number}, nil
+	}
+	pull, response, err := c.sdk.PullRequests.Get(ctx, owner, name, number)
+	if _, err := result(ctx, response, err); err != nil {
+		return DiscussionSubject{}, err
+	}
+	if pull == nil || pull.GetID() < 1 || pull.GetNumber() != number || pull.Base == nil || pull.Base.Repo == nil || pull.Base.Repo.GetID() != repository ||
+		pull.GetURL() != "https://api.github.com/repos/"+owner+"/"+name+"/pulls/"+strconv.Itoa(number) {
+		return DiscussionSubject{}, ErrInvalidResponse
+	}
+	return DiscussionSubject{Kind: kind, ExternalID: strconv.FormatInt(pull.GetID(), 10), Number: number}, nil
+}
diff --git a/internal/github/issues.go b/internal/github/issues.go
new file mode 100644
index 0000000000000000000000000000000000000000..5baad0676859dea4729bbc8e8d61c930f6b62af6
--- /dev/null
+++ b/internal/github/issues.go
@@ -0,0 +1,188 @@
+package github
+
+import (
+	"context"
+	"strconv"
+	"strings"
+	"time"
+
+	sdk "github.com/google/go-github/v93/github"
+)
+
+// These are provider-local observations. The connection consumer maps remote
+// identities through the canonical registry before producing product records.
+// No permissions, execution grants or mutation preconditions are inferred.
+type IssueActor struct {
+	ExternalID string `json:"external_id"`
+	Login      string `json:"login"`
+}
+type IssueLabel struct {
+	ExternalID string `json:"external_id"`
+	Name       string `json:"name"`
+	Color      string `json:"color"`
+}
+type IssueRecord struct {
+	ExternalID string       `json:"external_id"`
+	Number     int          `json:"number"`
+	Title      string       `json:"title"`
+	Body       string       `json:"body"`
+	State      string       `json:"state"`
+	Locked     *bool        `json:"locked"`
+	Author     *IssueActor  `json:"author"`
+	Assignees  []IssueActor `json:"assignees"`
+	Labels     []IssueLabel `json:"labels"`
+	CreatedAt  *time.Time   `json:"created_at"`
+	UpdatedAt  *time.Time   `json:"updated_at"`
+	ClosedAt   *time.Time   `json:"closed_at"`
+}
+type IssuePage struct {
+	Repository string        `json:"repository"`
+	Name       string        `json:"name"`
+	Items      []IssueRecord `json:"items"`
+	NextPage   int           `json:"next_page"`
+}
+
+// IssueList makes one provider page, not a scan to fill a UI page. GitHub mixes
+// PRs into this endpoint; filtering may leave an empty page with a continuation.
+// Stable ID lookup plus a final locator check refuse name reuse/rename and loss
+// of repository visibility instead of releasing another repository's issues.
+func (c *Client) IssueList(ctx context.Context, repository int64, page, limit int, state string) (IssuePage, error) {
+	if repository < 1 || !pageQuery(page, limit) || state != "" && state != "open" && state != "closed" && state != "all" {
+		return IssuePage{}, ErrInvalidRequest
+	}
+	if state == "" {
+		state = "open"
+	}
+	ctx, cancel := context.WithTimeout(ctx, timeout)
+	defer cancel()
+	owner, name, err := c.issueLocator(ctx, repository)
+	if err != nil {
+		return IssuePage{}, err
+	}
+	issues, response, err := c.sdk.Issues.ListByRepo(ctx, owner, name, &sdk.IssueListByRepoOptions{
+		State: state, Sort: "created", Direction: "asc", ListOptions: sdk.ListOptions{Page: page, PerPage: limit},
+	})
+	info, err := result(ctx, response, err)
+	if err != nil {
+		return IssuePage{}, err
+	}
+	if issues == nil || len(issues) > limit || info.NextPage != 0 && (info.NextPage <= page || info.NextPage > 1_000_000) {
+		return IssuePage{}, ErrInvalidResponse
+	}
+	result := IssuePage{Repository: strconv.FormatInt(repository, 10), Name: owner + "/" + name, Items: make([]IssueRecord, 0, len(issues)), NextPage: info.NextPage}
+	seen := map[int64]bool{}
+	numbers := map[int]bool{}
+	for _, issue := range issues {
+		if !validIssue(issue, owner, name) || seen[issue.GetID()] || numbers[issue.GetNumber()] || state != "all" && issue.GetState() != state {
+			return IssuePage{}, ErrInvalidResponse
+		}
+		seen[issue.GetID()], numbers[issue.GetNumber()] = true, true
+		if issue.IsPullRequest() {
+			continue
+		}
+		record, err := issueRecord(issue)
+		if err != nil {
+			return IssuePage{}, err
+		}
+		result.Items = append(result.Items, record)
+	}
+	if err := c.checkIssueLocator(ctx, repository, owner, name); err != nil {
+		return IssuePage{}, err
+	}
+	return result, nil
+}
+
+// Issue reads any-state detail. A PR's issue wrapper is not a normal issue and
+// refuses; PR IDs must come from the separate pull endpoint/adapter.
+func (c *Client) Issue(ctx context.Context, repository int64, number int) (IssuePage, error) {
+	if repository < 1 || number < 1 {
+		return IssuePage{}, ErrInvalidRequest
+	}
+	ctx, cancel := context.WithTimeout(ctx, timeout)
+	defer cancel()
+	owner, name, err := c.issueLocator(ctx, repository)
+	if err != nil {
+		return IssuePage{}, err
+	}
+	issue, response, err := c.sdk.Issues.Get(ctx, owner, name, number)
+	if _, err := result(ctx, response, err); err != nil {
+		return IssuePage{}, err
+	}
+	if !validIssue(issue, owner, name) || issue.GetNumber() != number {
+		return IssuePage{}, ErrInvalidResponse
+	}
+	if issue.IsPullRequest() {
+		return IssuePage{}, ErrNotVisible
+	}
+	record, err := issueRecord(issue)
+	if err != nil {
+		return IssuePage{}, err
+	}
+	if err := c.checkIssueLocator(ctx, repository, owner, name); err != nil {
+		return IssuePage{}, err
+	}
+	return IssuePage{Repository: strconv.FormatInt(repository, 10), Name: owner + "/" + name, Items: []IssueRecord{record}}, nil
+}
+
+func (c *Client) issueLocator(ctx context.Context, repository int64) (string, string, error) {
+	repo, _, err := c.RepositoryByID(ctx, repository)
+	if err != nil {
+		return "", "", err
+	}
+	owner, name, ok := strings.Cut(repo.GetFullName(), "/")
+	if !ok || !segment(owner) || !segment(name) {
+		return "", "", ErrInvalidResponse
+	}
+	return owner, name, nil
+}
+func (c *Client) checkIssueLocator(ctx context.Context, repository int64, owner, name string) error {
+	repo, _, err := c.Repository(ctx, owner, name)
+	if err != nil {
+		return err
+	}
+	if repo.GetID() != repository {
+		return ErrNotVisible
+	}
+	return ctx.Err()
+}
+func validIssue(issue *sdk.Issue, owner, name string) bool {
+	return issue != nil && issue.GetID() > 0 && issue.GetNumber() > 0 && issue.Title != nil &&
+		(issue.GetState() == "open" || issue.GetState() == "closed") &&
+		issue.GetRepositoryURL() == "https://api.github.com/repos/"+owner+"/"+name
+}
+func issueRecord(issue *sdk.Issue) (IssueRecord, error) {
+	record := IssueRecord{ExternalID: strconv.FormatInt(issue.GetID(), 10), Number: issue.GetNumber(), Title: issue.GetTitle(), Body: issue.GetBody(), State: issue.GetState(), Locked: issue.Locked, Assignees: []IssueActor{}, Labels: []IssueLabel{}, CreatedAt: issueTime(issue.CreatedAt), UpdatedAt: issueTime(issue.UpdatedAt), ClosedAt: issueTime(issue.ClosedAt)}
+	if issue.User != nil {
+		author, err := issueActor(issue.User)
+		if err != nil {
+			return IssueRecord{}, err
+		}
+		record.Author = &author
+	}
+	for _, user := range issue.Assignees {
+		actor, err := issueActor(user)
+		if err != nil {
+			return IssueRecord{}, err
+		}
+		record.Assignees = append(record.Assignees, actor)
+	}
+	for _, label := range issue.Labels {
+		if label == nil || label.GetID() < 1 || label.GetName() == "" {
+			return IssueRecord{}, ErrInvalidResponse
+		}
+		record.Labels = append(record.Labels, IssueLabel{ExternalID: strconv.FormatInt(label.GetID(), 10), Name: label.GetName(), Color: label.GetColor()})
+	}
+	return record, nil
+}
+func issueActor(user *sdk.User) (IssueActor, error) {
+	if user == nil || user.GetID() < 1 || user.GetLogin() == "" {
+		return IssueActor{}, ErrInvalidResponse
+	}
+	return IssueActor{ExternalID: strconv.FormatInt(user.GetID(), 10), Login: user.GetLogin()}, nil
+}
+func issueTime(value *sdk.Timestamp) *time.Time {
+	if value == nil {
+		return nil
+	}
+	return &value.Time
+}
diff --git a/internal/github/native.go b/internal/github/native.go
new file mode 100644
index 0000000000000000000000000000000000000000..4c1921eb55abb84af07726d16d4ea79ac625f06a
--- /dev/null
+++ b/internal/github/native.go
@@ -0,0 +1,328 @@
+package github
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"strconv"
+	"time"
+
+	"github.com/levitateos/sodaos/internal/collaboration"
+	"github.com/levitateos/sodaos/internal/strictjson"
+)
+
+const NativeCredentialHeader = "X-Soda-GitHub-Credential"
+
+type nativeRead struct {
+	Kind       string `json:"kind"`
+	Account    string `json:"account"`
+	Connection string `json:"connection"`
+	Repository string `json:"repository,omitempty"`
+	Page       int    `json:"page,omitempty"`
+	Limit      int    `json:"limit,omitempty"`
+	State      string `json:"state,omitempty"`
+	Number     int    `json:"number,omitempty"`
+	Base       string `json:"base,omitempty"`
+	Head       string `json:"head,omitempty"`
+	ReviewID   string `json:"review_id,omitempty"`
+	CommentID  string `json:"comment_id,omitempty"`
+}
+
+// NewNativeReadHandler belongs behind the native host's peer/key/instance and
+// admission lifetime gates. It neither binds a Factory account nor stores a
+// credential. The native host supplies the token for this one bounded read.
+func NewNativeReadHandler(network http.RoundTripper) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Cache-Control", "no-store")
+		w.Header().Set("Content-Type", "application/json; charset=utf-8")
+		fail := func(status int, code string) {
+			w.WriteHeader(status)
+			_ = json.NewEncoder(w).Encode(map[string]string{"error": code})
+		}
+		if network == nil {
+			fail(503, "github_unavailable")
+			return
+		}
+		if r.Method != http.MethodPost || r.URL.Path != "/api/native/github/read" || r.URL.RawQuery != "" || r.URL.ForceQuery || r.URL.RawPath != "" {
+			fail(400, "invalid_native_read")
+			return
+		}
+		values := r.Header.Values(NativeCredentialHeader)
+		if len(values) != 1 || len(values[0]) < 1 || len(values[0]) > 8192 {
+			fail(401, "credential_required")
+			return
+		}
+		for _, b := range []byte(values[0]) {
+			if b < 33 || b > 126 {
+				fail(401, "credential_required")
+				return
+			}
+		}
+		token := []byte(values[0])
+		r.Header.Del(NativeCredentialHeader)
+		defer clear(token)
+		var query nativeRead
+		if strictjson.Decode(http.MaxBytesReader(w, r.Body, 4096), &query) != nil {
+			fail(400, "invalid_native_read")
+			return
+		}
+		discussion := query.Kind == "issue_comments" || query.Kind == "pull_comments"
+		files := query.Kind == "pull_files"
+		reviews := query.Kind == "pull_reviews" || query.Kind == "pull_review" || query.Kind == "pull_review_comments" || query.Kind == "pull_review_comment"
+		checks := query.Kind == "pull_check_runs" || query.Kind == "pull_commit_statuses"
+		numbered := query.Kind == "issue" || query.Kind == "pull" || query.Kind == "pull_diff" || files || reviews || checks || discussion
+		paged := query.Kind == "issues" || query.Kind == "pulls" || files || query.Kind == "pull_reviews" || query.Kind == "pull_review_comments" || checks || discussion
+		stateful := query.Kind == "issues" || query.Kind == "pulls"
+		if !stateful && query.State != "" || !numbered && query.Number != 0 {
+			fail(400, "invalid_native_read")
+			return
+		}
+		var review int64
+		if query.Kind == "pull_review" {
+			parsed, parseErr := strconv.ParseInt(query.ReviewID, 10, 64)
+			if parseErr != nil || parsed < 1 || strconv.FormatInt(parsed, 10) != query.ReviewID {
+				fail(400, "invalid_native_read")
+				return
+			}
+			review = parsed
+		} else if query.ReviewID != "" {
+			fail(400, "invalid_native_read")
+			return
+		}
+		var comment int64
+		if query.Kind == "pull_review_comment" {
+			parsed, parseErr := strconv.ParseInt(query.CommentID, 10, 64)
+			if parseErr != nil || parsed < 1 || strconv.FormatInt(parsed, 10) != query.CommentID {
+				fail(400, "invalid_native_read")
+				return
+			}
+			comment = parsed
+		} else if query.CommentID != "" {
+			fail(400, "invalid_native_read")
+			return
+		}
+		if query.Kind == "pull_diff" && !validDiffPair(query.Base, query.Head) || files && !validFilesQuery(query.Page, query.Limit, query.Base, query.Head) || checks && (query.Base != "" || !validCheckHeadQuery(query.Page, query.Limit, query.Head)) || query.Kind != "pull_diff" && !files && !checks && (query.Base != "" || query.Head != "") {
+			fail(400, "invalid_native_read")
+			return
+		}
+		var account int64
+		var err error
+		if query.Kind != "verify" {
+			account, err = strconv.ParseInt(query.Account, 10, 64)
+			if err != nil || account < 1 || strconv.FormatInt(account, 10) != query.Account || !collaboration.ValidID(query.Connection) {
+				fail(400, "invalid_account")
+				return
+			}
+		}
+		var repository int64
+		switch query.Kind {
+		case "verify":
+			// Bootstrap observes /user with an unpersisted native token. It must
+			// not accept a claimed account/connection or read a repository.
+			if query.Account != "" || query.Connection != "" || query.Repository != "" || query.Page != 0 || query.Limit != 0 {
+				fail(400, "invalid_native_read")
+				return
+			}
+		case "identity":
+			if query.Repository != "" || query.Page != 0 || query.Limit != 0 {
+				fail(400, "invalid_native_read")
+				return
+			}
+		case "repositories":
+			if query.Repository != "" || !pageQuery(query.Page, query.Limit) {
+				fail(400, "invalid_native_read")
+				return
+			}
+		case "repository", "issues", "issue", "pulls", "pull", "pull_diff", "pull_files", "pull_reviews", "pull_review", "pull_review_comments", "pull_review_comment", "pull_check_runs", "pull_commit_statuses", "issue_comments", "pull_comments":
+			repository, err = strconv.ParseInt(query.Repository, 10, 64)
+			if err != nil || repository < 1 || strconv.FormatInt(repository, 10) != query.Repository ||
+				paged && !pageQuery(query.Page, query.Limit) || !paged && (query.Page != 0 || query.Limit != 0) || numbered && query.Number < 1 ||
+				stateful && query.State != "" && query.State != "open" && query.State != "closed" && query.State != "all" {
+				fail(400, "invalid_native_read")
+				return
+			}
+		default:
+			fail(400, "invalid_native_read")
+			return
+		}
+		ctx, cancel := context.WithTimeout(r.Context(), 6*time.Second)
+		defer cancel()
+		client, err := New(borrowedTransport{network: network, token: token})
+		if err != nil {
+			fail(503, "github_unavailable")
+			return
+		}
+		providerError := func(err error) {
+			status, code := 503, "github_unavailable"
+			switch {
+			case errors.Is(err, ErrCredentials):
+				status, code = 401, "github_sign_in_required"
+			case errors.Is(err, ErrNotVisible):
+				status, code = 404, "github_not_visible"
+			case errors.Is(err, ErrForbidden):
+				status, code = 403, "github_forbidden"
+			case errors.Is(err, ErrRateLimited):
+				status, code = 429, "github_rate_limited"
+			case errors.Is(err, ErrRedirect):
+				status, code = 409, "github_resource_moved"
+			case errors.Is(err, ErrDiffChanged):
+				status, code = 409, "github_diff_changed"
+			case errors.Is(err, ErrFilesTooLarge):
+				status, code = 413, "github_files_too_large"
+			case errors.Is(err, ErrChecksChanged):
+				status, code = 409, "github_checks_changed"
+			case errors.Is(err, ErrInvalidRequest):
+				status, code = 400, "invalid_native_read"
+			case errors.Is(err, context.DeadlineExceeded):
+				status, code = 504, "github_deadline"
+			}
+			fail(status, code)
+		}
+		user, _, err := client.AuthenticatedUser(ctx)
+		if err != nil {
+			providerError(err)
+			return
+		}
+		if query.Kind != "verify" && user.GetID() != account {
+			fail(409, "github_account_changed")
+			return
+		}
+		result := map[string]any{"kind": query.Kind, "account": map[string]string{"external_id": strconv.FormatInt(user.GetID(), 10), "login": user.GetLogin()}}
+		if query.Kind != "verify" {
+			result["connection"] = query.Connection
+		}
+		snapshot := func(id int64, name string, private bool, branch string) map[string]any {
+			return map[string]any{"external_id": strconv.FormatInt(id, 10), "name": name, "private": private, "default_branch": branch}
+		}
+		switch query.Kind {
+		case "repositories":
+			repos, page, err := client.Repositories(ctx, query.Page, query.Limit)
+			if err != nil {
+				providerError(err)
+				return
+			}
+			items := make([]map[string]any, 0, len(repos))
+			for _, repo := range repos {
+				items = append(items, snapshot(repo.GetID(), repo.GetFullName(), repo.GetPrivate(), repo.GetDefaultBranch()))
+			}
+			result["items"], result["next_page"] = items, page.NextPage
+		case "repository":
+			repo, _, err := client.RepositoryByID(ctx, repository)
+			if err != nil {
+				providerError(err)
+				return
+			}
+			result["repository"] = snapshot(repo.GetID(), repo.GetFullName(), repo.GetPrivate(), repo.GetDefaultBranch())
+		case "issues", "issue":
+			var issues IssuePage
+			if query.Kind == "issues" {
+				issues, err = client.IssueList(ctx, repository, query.Page, query.Limit, query.State)
+			} else {
+				issues, err = client.Issue(ctx, repository, query.Number)
+			}
+			if err != nil {
+				providerError(err)
+				return
+			}
+			result["issues"] = issues
+		case "pulls", "pull":
+			var pulls PullPage
+			if query.Kind == "pulls" {
+				pulls, err = client.PullList(ctx, repository, query.Page, query.Limit, query.State)
+			} else {
+				pulls, err = client.Pull(ctx, repository, query.Number)
+			}
+			if err != nil {
+				providerError(err)
+				return
+			}
+			result["pulls"] = pulls
+		case "pull_diff":
+			diff, err := client.PullDiff(ctx, repository, query.Number, query.Base, query.Head)
+			if err != nil {
+				providerError(err)
+				return
+			}
+			result["diff"] = diff
+		case "pull_files":
+			files, err := client.PullFiles(ctx, repository, query.Number, query.Page, query.Limit, query.Base, query.Head)
+			if err != nil {
+				providerError(err)
+				return
+			}
+			result["files"] = files
+		case "pull_reviews", "pull_review":
+			var reviews ReviewPage
+			if query.Kind == "pull_reviews" {
+				reviews, err = client.PullReviews(ctx, repository, query.Number, query.Page, query.Limit)
+			} else {
+				reviews, err = client.PullReview(ctx, repository, query.Number, review)
+			}
+			if err != nil {
+				providerError(err)
+				return
+			}
+			result["reviews"] = reviews
+		case "pull_check_runs":
+			checks, err := client.PullCheckRuns(ctx, repository, query.Number, query.Page, query.Limit, query.Head)
+			if err != nil {
+				providerError(err)
+				return
+			}
+			result["checks"] = checks
+		case "pull_review_comments", "pull_review_comment":
+			var comments ReviewCommentPage
+			var err error
+			if query.Kind == "pull_review_comment" {
+				comments, err = client.PullReviewComment(ctx, repository, query.Number, comment)
+			} else {
+				comments, err = client.PullReviewComments(ctx, repository, query.Number, query.Page, query.Limit)
+			}
+			if err != nil {
+				providerError(err)
+				return
+			}
+			result["review_comments"] = comments
+		case "pull_commit_statuses":
+			statuses, err := client.PullCommitStatuses(ctx, repository, query.Number, query.Page, query.Limit, query.Head)
+			if err != nil {
+				providerError(err)
+				return
+			}
+			result["statuses"] = statuses
+		case "issue_comments", "pull_comments":
+			kind := "issue"
+			if query.Kind == "pull_comments" {
+				kind = "pull"
+			}
+			discussion, err := client.Discussion(ctx, repository, kind, query.Number, query.Page, query.Limit)
+			if err != nil {
+				providerError(err)
+				return
+			}
+			result["discussion"] = discussion
+		}
+		if ctx.Err() != nil {
+			providerError(ctx.Err())
+			return
+		}
+		_ = json.NewEncoder(w).Encode(result)
+	})
+}
+
+// The borrowed header lives only in this request's native call. No SDK client,
+// token source, retry worker, environment or backend configuration retains it.
+type borrowedTransport struct {
+	network http.RoundTripper
+	token   []byte
+}
+
+func (t borrowedTransport) RoundTrip(r *http.Request) (*http.Response, error) {
+	if r.Context().Err() != nil {
+		return nil, r.Context().Err()
+	}
+	r = r.Clone(r.Context())
+	r.Header.Set("Authorization", "Bearer "+string(t.token))
+	return t.network.RoundTrip(r)
+}
diff --git a/internal/github/pull_diff.go b/internal/github/pull_diff.go
new file mode 100644
index 0000000000000000000000000000000000000000..bbadea494f63afcd2949f544447351d28ddc7a3a
--- /dev/null
+++ b/internal/github/pull_diff.go
@@ -0,0 +1,121 @@
+package github
+
+import (
+	"context"
+	"strconv"
+
+	sdk "github.com/google/go-github/v93/github"
+	"github.com/levitateos/sodaos/internal/collaboration"
+)
+
+// Provider-local PR diff identity. PullBase is the captured PR-payload base;
+// Base is the verified merge base with Head. Current target-branch tip/protection
+// facts and canonical identity mapping belong to their consuming readers.
+type PullDiffScope struct {
+	Repository string            `json:"repository"`
+	Name       string            `json:"name"`
+	Pull       DiscussionSubject `json:"pull"`
+	Base       string            `json:"base"`
+	Head       string            `json:"head"`
+	PullBase   string            `json:"pull_base"`
+	BaseBranch string            `json:"base_branch"`
+}
+
+// PullDiff resolves the actual merge base of a PR's captured base and head.
+// A supplied full pair must still match; it cannot substitute a historical or
+// arbitrary comparison. Both discovery and pinned reads recheck the live PR and
+// repository before returning. The whole operation shares one finite budget.
+func (c *Client) PullDiff(ctx context.Context, repository int64, number int, base, head string) (PullDiffScope, error) {
+	if repository < 1 || number < 1 || !validDiffPair(base, head) {
+		return PullDiffScope{}, ErrInvalidRequest
+	}
+	ctx, cancel := context.WithTimeout(ctx, timeout)
+	defer cancel()
+	owner, name, err := c.issueLocator(ctx, repository)
+	if err != nil {
+		return PullDiffScope{}, err
+	}
+	before, err := c.pullDiffState(ctx, repository, owner, name, number)
+	if err != nil {
+		return PullDiffScope{}, err
+	}
+	if head != "" && head != before.Head {
+		return PullDiffScope{}, ErrDiffChanged
+	}
+	scope, err := c.resolvePullDiff(ctx, owner, name, number, before, base)
+	if err != nil {
+		return PullDiffScope{}, err
+	}
+	after, err := c.pullDiffState(ctx, repository, owner, name, number)
+	if err != nil {
+		return PullDiffScope{}, err
+	}
+	if after != before {
+		return PullDiffScope{}, ErrDiffChanged
+	}
+	if err := c.checkIssueLocator(ctx, repository, owner, name); err != nil {
+		return PullDiffScope{}, err
+	}
+	return scope, nil
+}
+
+func (c *Client) resolvePullDiff(ctx context.Context, owner, name string, number int, before pullDiffState, base string) (PullDiffScope, error) {
+	// Compare metadata includes merge_base_commit on paged responses. Files
+	// appear only on page one, so page two avoids fetching unrelated patches or
+	// confusing the comparison's 300-file ceiling with a PR file catalogue.
+	comparison, response, err := c.sdk.Repositories.CompareCommits(ctx, owner, name, before.Base, before.Head, &sdk.ListOptions{Page: 2, PerPage: 1})
+	if _, err := result(ctx, response, err); err != nil {
+		return PullDiffScope{}, err
+	}
+	if comparison == nil || comparison.BaseCommit == nil || comparison.BaseCommit.GetSHA() != before.Base || comparison.MergeBaseCommit == nil ||
+		!collaboration.ValidCommitID(collaboration.CommitID(comparison.MergeBaseCommit.GetSHA())) {
+		return PullDiffScope{}, ErrInvalidResponse
+	}
+	mergeBase := comparison.MergeBaseCommit.GetSHA()
+	if base != "" && base != mergeBase {
+		return PullDiffScope{}, ErrDiffChanged
+	}
+	return PullDiffScope{Repository: before.Repository, Name: owner + "/" + name,
+		Pull: DiscussionSubject{Kind: "pull", ExternalID: before.Pull, Number: number},
+		Base: mergeBase, Head: before.Head, PullBase: before.Base, BaseBranch: before.Branch}, nil
+}
+
+type pullDiffState struct {
+	Repository string
+	Pull       string
+	Base       string
+	Head       string
+	Branch     string
+}
+
+func (c *Client) pullDiffState(ctx context.Context, repository int64, owner, name string, number int) (pullDiffState, error) {
+	pull, err := c.readDiffPull(ctx, repository, owner, name, number)
+	if err != nil {
+		return pullDiffState{}, err
+	}
+	return diffState(repository, pull), nil
+}
+
+func (c *Client) readDiffPull(ctx context.Context, repository int64, owner, name string, number int) (*sdk.PullRequest, error) {
+	pull, response, err := c.sdk.PullRequests.Get(ctx, owner, name, number)
+	if _, err := result(ctx, response, err); err != nil {
+		return nil, err
+	}
+	if !validPull(pull, repository, owner, name) || pull.GetNumber() != number {
+		return nil, ErrInvalidResponse
+	}
+	if pull.Head == nil || pull.Base.GetRef() == "" ||
+		!collaboration.ValidCommitID(collaboration.CommitID(pull.Base.GetSHA())) ||
+		!collaboration.ValidCommitID(collaboration.CommitID(pull.Head.GetSHA())) {
+		return nil, ErrUnavailable
+	}
+	return pull, nil
+}
+
+func diffState(repository int64, pull *sdk.PullRequest) pullDiffState {
+	return pullDiffState{Repository: strconv.FormatInt(repository, 10), Pull: strconv.FormatInt(pull.GetID(), 10), Base: pull.Base.GetSHA(), Head: pull.Head.GetSHA(), Branch: pull.Base.GetRef()}
+}
+
+func validDiffPair(base, head string) bool {
+	return base == "" && head == "" || collaboration.ValidCommitID(collaboration.CommitID(base)) && collaboration.ValidCommitID(collaboration.CommitID(head))
+}
diff --git a/internal/github/pull_files.go b/internal/github/pull_files.go
new file mode 100644
index 0000000000000000000000000000000000000000..880af8e2df13b65f6d7f52bf7871241fbc8e5486
--- /dev/null
+++ b/internal/github/pull_files.go
@@ -0,0 +1,208 @@
+package github
+
+import (
+	"bytes"
+	"context"
+	"strings"
+	"unicode/utf8"
+
+	sdk "github.com/google/go-github/v93/github"
+	"github.com/sourcegraph/go-diff/diff"
+)
+
+const pullFileLimit = 3000 // GitHub's PR files endpoint ceiling, not CompareCommits' ceiling.
+const pullPatchLimit = 16 << 10
+
+// Provider-local file facts. Patch contains GitHub's hunk fragment, not a
+// standalone diff with file headers. Paths are display/anchor data, never URLs
+// to follow or local filesystem paths. Canonical mapping belongs to the consumer.
+type PullFile struct {
+	OldPath    string  `json:"old_path"`
+	NewPath    string  `json:"new_path"`
+	Change     string  `json:"change"`
+	PatchState string  `json:"patch_state"`
+	Patch      *string `json:"patch"`
+	Additions  *int    `json:"additions"`
+	Deletions  *int    `json:"deletions"`
+}
+
+type PullFilePage struct {
+	Diff     PullDiffScope `json:"diff"`
+	Items    []PullFile    `json:"items"`
+	Page     int           `json:"page"`
+	Limit    int           `json:"limit"`
+	Total    int           `json:"total"`
+	NextPage int           `json:"next_page"`
+}
+
+// PullFiles reads exactly one bounded page of the current PR diff. Discovery is
+// allowed only on page one; later pages must supply the captured merge-base/head
+// pair. The consumer must retain the same limit when following NextPage.
+func (c *Client) PullFiles(ctx context.Context, repository int64, number, page, limit int, base, head string) (PullFilePage, error) {
+	if repository < 1 || number < 1 || !validFilesQuery(page, limit, base, head) {
+		return PullFilePage{}, ErrInvalidRequest
+	}
+	ctx, cancel := context.WithTimeout(ctx, timeout)
+	defer cancel()
+	owner, name, err := c.issueLocator(ctx, repository)
+	if err != nil {
+		return PullFilePage{}, err
+	}
+	pull, err := c.readDiffPull(ctx, repository, owner, name, number)
+	if err != nil {
+		return PullFilePage{}, err
+	}
+	before := diffState(repository, pull)
+	if head != "" && head != before.Head {
+		return PullFilePage{}, ErrDiffChanged
+	}
+	if pull.ChangedFiles == nil || *pull.ChangedFiles < 0 {
+		return PullFilePage{}, ErrUnavailable
+	}
+	total := *pull.ChangedFiles
+	if total > pullFileLimit {
+		return PullFilePage{}, ErrFilesTooLarge
+	}
+	offset := (page - 1) * limit
+	if offset >= total && !(page == 1 && total == 0) {
+		return PullFilePage{}, ErrInvalidRequest
+	}
+	scope, err := c.resolvePullDiff(ctx, owner, name, number, before, base)
+	if err != nil {
+		return PullFilePage{}, err
+	}
+	files, response, err := c.sdk.PullRequests.ListFiles(ctx, owner, name, number, &sdk.ListOptions{Page: page, PerPage: limit})
+	info, err := result(ctx, response, err)
+	if err != nil {
+		return PullFilePage{}, err
+	}
+	// The live endpoint has no conditional-pair selector. Bracket its response
+	// with the PR identity, full commits, base branch and changed-file count.
+	after, err := c.readDiffPull(ctx, repository, owner, name, number)
+	if err != nil {
+		return PullFilePage{}, err
+	}
+	if diffState(repository, after) != before || after.ChangedFiles == nil || *after.ChangedFiles != total {
+		return PullFilePage{}, ErrDiffChanged
+	}
+	if err := c.checkIssueLocator(ctx, repository, owner, name); err != nil {
+		return PullFilePage{}, err
+	}
+	want := min(limit, total-offset)
+	next := 0
+	if offset+want < total {
+		next = page + 1
+	}
+	if len(files) != want || info.NextPage != next || info.LastPage != 0 && info.LastPage != (total+limit-1)/limit {
+		return PullFilePage{}, ErrInvalidResponse
+	}
+	result := PullFilePage{Diff: scope, Items: make([]PullFile, 0, len(files)), Page: page, Limit: limit, Total: total, NextPage: next}
+	seen := make(map[string]bool, len(files))
+	for _, file := range files {
+		record, err := pullFile(file)
+		if err != nil {
+			return PullFilePage{}, err
+		}
+		if seen[file.GetFilename()] {
+			return PullFilePage{}, ErrInvalidResponse
+		}
+		seen[file.GetFilename()] = true
+		result.Items = append(result.Items, record)
+	}
+	if err := ctx.Err(); err != nil {
+		return PullFilePage{}, err
+	}
+	return result, nil
+}
+
+func validFilesQuery(page, limit int, base, head string) bool {
+	return page >= 1 && page <= pullFileLimit && limit >= 1 && limit <= 10 && validDiffPair(base, head) && (page == 1 || base != "")
+}
+
+func pullFile(file *sdk.CommitFile) (PullFile, error) {
+	if file == nil || !filePath(file.GetFilename()) || file.Additions != nil && *file.Additions < 0 || file.Deletions != nil && *file.Deletions < 0 {
+		return PullFile{}, ErrInvalidResponse
+	}
+	record := PullFile{Change: file.GetStatus(), Additions: file.Additions, Deletions: file.Deletions}
+	switch record.Change {
+	case "added":
+		record.NewPath = file.GetFilename()
+	case "removed":
+		record.Change, record.OldPath = "deleted", file.GetFilename()
+	case "renamed", "copied":
+		if !filePath(file.GetPreviousFilename()) {
+			return PullFile{}, ErrInvalidResponse
+		}
+		record.OldPath, record.NewPath = file.GetPreviousFilename(), file.GetFilename()
+	case "modified":
+		record.OldPath, record.NewPath = file.GetFilename(), file.GetFilename()
+	default:
+		record.Change, record.NewPath = "unknown", file.GetFilename()
+	}
+	record.PatchState, record.Patch = pullPatch(file)
+	return record, nil
+}
+
+func filePath(path string) bool {
+	return path != "" && len(path) <= 4096 && utf8.ValidString(path) && !strings.ContainsRune(path, 0)
+}
+
+func pullPatch(file *sdk.CommitFile) (string, *string) {
+	// GitHub omits patches for both binary and large/unavailable text files.
+	// Neither zero statistics nor an extension establishes that a file is binary.
+	if file.Patch == nil || *file.Patch == "" || !utf8.ValidString(*file.Patch) {
+		return "unavailable", nil
+	}
+	patch := *file.Patch
+	if len(patch) > pullPatchLimit {
+		end := pullPatchLimit
+		for !utf8.RuneStart(patch[end]) {
+			end--
+		}
+		patch = patch[:end]
+		return "truncated", &patch
+	}
+	// The mature parser handles hunk syntax and no-newline markers. Parsing
+	// alone accepts a short final hunk, so also check each declared span and the
+	// provider's full additions/deletions (which catches entirely omitted hunks).
+	hunks, err := diff.ParseHunksOptions([]byte(patch), diff.ParseOptions{KeepCR: true})
+	if err != nil || len(hunks) == 0 || file.Additions == nil || file.Deletions == nil {
+		return "unavailable", nil
+	}
+	added, deleted, short := 0, 0, false
+	for _, hunk := range hunks {
+		if hunk.OrigStartLine < 0 || hunk.NewStartLine < 0 || hunk.OrigLines < 0 || hunk.NewLines < 0 {
+			return "unavailable", nil
+		}
+		oldLines, newLines := 0, 0
+		for _, line := range bytes.Split(hunk.Body, []byte{'\n'}) {
+			if len(line) == 0 {
+				continue
+			}
+			switch line[0] {
+			case '+':
+				added++
+				newLines++
+			case '-':
+				deleted++
+				oldLines++
+			case ' ':
+				oldLines++
+				newLines++
+			default:
+				return "unavailable", nil
+			}
+		}
+		if oldLines > int(hunk.OrigLines) || newLines > int(hunk.NewLines) {
+			return "unavailable", nil
+		}
+		short = short || oldLines < int(hunk.OrigLines) || newLines < int(hunk.NewLines)
+	}
+	if added > *file.Additions || deleted > *file.Deletions {
+		return "unavailable", nil
+	}
+	if short || added < *file.Additions || deleted < *file.Deletions {
+		return "truncated", &patch
+	}
+	return "complete", &patch
+}
diff --git a/internal/github/pulls.go b/internal/github/pulls.go
new file mode 100644
index 0000000000000000000000000000000000000000..654ff48331227781d18825b1503f3452a1d99d85
--- /dev/null
+++ b/internal/github/pulls.go
@@ -0,0 +1,183 @@
+package github
+
+import (
+	"context"
+	"strconv"
+	"time"
+
+	sdk "github.com/google/go-github/v93/github"
+	"github.com/levitateos/sodaos/internal/collaboration"
+)
+
+// Provider-local references, not canonical identities or execution authority.
+// A deleted/unavailable head repository stays nil even if its ref/SHA survives.
+type PullRepository struct {
+	ExternalID string `json:"external_id"`
+	Name       string `json:"name"`
+}
+type PullBranch struct {
+	Repository *PullRepository `json:"repository"`
+	Name       string          `json:"name"`
+	Commit     *string         `json:"commit"`
+}
+type PullRecord struct {
+	ExternalID     string       `json:"external_id"`
+	Number         int          `json:"number"`
+	Title          string       `json:"title"`
+	Body           string       `json:"body"`
+	State          string       `json:"state"`
+	Draft          *bool        `json:"draft"`
+	Locked         *bool        `json:"locked"`
+	Author         *IssueActor  `json:"author"`
+	Assignees      []IssueActor `json:"assignees"`
+	Labels         []IssueLabel `json:"labels"`
+	Base           *PullBranch  `json:"base"`
+	Head           *PullBranch  `json:"head"`
+	CreatedAt      *time.Time   `json:"created_at"`
+	UpdatedAt      *time.Time   `json:"updated_at"`
+	ClosedAt       *time.Time   `json:"closed_at"`
+	MergedAt       *time.Time   `json:"merged_at"`
+	Merged         *bool        `json:"merged"`
+	Mergeable      *bool        `json:"mergeable"`
+	MergeableState *string      `json:"mergeable_state"`
+	Rebaseable     *bool        `json:"rebaseable"`
+}
+type PullPage struct {
+	Repository string       `json:"repository"`
+	Name       string       `json:"name"`
+	Items      []PullRecord `json:"items"`
+	NextPage   int          `json:"next_page"`
+}
+
+// PullList reads one provider page. List responses omit detail-only fields;
+// nil mergeability/merged facts remain unknown, never false or merge permission.
+func (c *Client) PullList(ctx context.Context, repository int64, page, limit int, state string) (PullPage, error) {
+	if repository < 1 || !pageQuery(page, limit) || state != "" && state != "open" && state != "closed" && state != "all" {
+		return PullPage{}, ErrInvalidRequest
+	}
+	if state == "" {
+		state = "open"
+	}
+	ctx, cancel := context.WithTimeout(ctx, timeout)
+	defer cancel()
+	owner, name, err := c.issueLocator(ctx, repository)
+	if err != nil {
+		return PullPage{}, err
+	}
+	pulls, response, err := c.sdk.PullRequests.List(ctx, owner, name, &sdk.PullRequestListOptions{
+		State: state, Sort: "created", Direction: "asc", ListOptions: sdk.ListOptions{Page: page, PerPage: limit},
+	})
+	info, err := result(ctx, response, err)
+	if err != nil {
+		return PullPage{}, err
+	}
+	if pulls == nil || len(pulls) > limit || info.NextPage != 0 && (info.NextPage <= page || info.NextPage > 1_000_000) {
+		return PullPage{}, ErrInvalidResponse
+	}
+	pageResult := PullPage{Repository: strconv.FormatInt(repository, 10), Name: owner + "/" + name, Items: make([]PullRecord, 0, len(pulls)), NextPage: info.NextPage}
+	seen := map[int64]bool{}
+	numbers := map[int]bool{}
+	for _, pull := range pulls {
+		if !validPull(pull, repository, owner, name) || seen[pull.GetID()] || numbers[pull.GetNumber()] || state != "all" && pull.GetState() != state {
+			return PullPage{}, ErrInvalidResponse
+		}
+		seen[pull.GetID()], numbers[pull.GetNumber()] = true, true
+		record, err := pullRecord(pull)
+		if err != nil {
+			return PullPage{}, err
+		}
+		pageResult.Items = append(pageResult.Items, record)
+	}
+	if err := c.checkIssueLocator(ctx, repository, owner, name); err != nil {
+		return PullPage{}, err
+	}
+	return pageResult, nil
+}
+
+// Pull reads any-state detail, without retrying unknown mergeability. Branch
+// SHAs describe this response, not an immutable diff pair or mutation admission.
+func (c *Client) Pull(ctx context.Context, repository int64, number int) (PullPage, error) {
+	if repository < 1 || number < 1 {
+		return PullPage{}, ErrInvalidRequest
+	}
+	ctx, cancel := context.WithTimeout(ctx, timeout)
+	defer cancel()
+	owner, name, err := c.issueLocator(ctx, repository)
+	if err != nil {
+		return PullPage{}, err
+	}
+	pull, response, err := c.sdk.PullRequests.Get(ctx, owner, name, number)
+	if _, err := result(ctx, response, err); err != nil {
+		return PullPage{}, err
+	}
+	if !validPull(pull, repository, owner, name) || pull.GetNumber() != number {
+		return PullPage{}, ErrInvalidResponse
+	}
+	record, err := pullRecord(pull)
+	if err != nil {
+		return PullPage{}, err
+	}
+	if err := c.checkIssueLocator(ctx, repository, owner, name); err != nil {
+		return PullPage{}, err
+	}
+	return PullPage{Repository: strconv.FormatInt(repository, 10), Name: owner + "/" + name, Items: []PullRecord{record}}, nil
+}
+
+func validPull(pull *sdk.PullRequest, repository int64, owner, name string) bool {
+	return pull != nil && pull.GetID() > 0 && pull.GetNumber() > 0 && pull.Title != nil &&
+		(pull.GetState() == "open" || pull.GetState() == "closed") && pull.Base != nil && pull.Base.Repo != nil && pull.Base.Repo.GetID() == repository &&
+		pull.GetURL() == "https://api.github.com/repos/"+owner+"/"+name+"/pulls/"+strconv.Itoa(pull.GetNumber())
+}
+func pullRecord(pull *sdk.PullRequest) (PullRecord, error) {
+	record := PullRecord{ExternalID: strconv.FormatInt(pull.GetID(), 10), Number: pull.GetNumber(), Title: pull.GetTitle(), Body: pull.GetBody(), State: pull.GetState(), Draft: pull.Draft, Locked: pull.Locked, Assignees: []IssueActor{}, Labels: []IssueLabel{}, CreatedAt: issueTime(pull.CreatedAt), UpdatedAt: issueTime(pull.UpdatedAt), ClosedAt: issueTime(pull.ClosedAt), MergedAt: issueTime(pull.MergedAt), Merged: pull.Merged, Mergeable: pull.Mergeable, MergeableState: pull.MergeableState, Rebaseable: pull.Rebaseable}
+	if pull.GetMerged() || pull.MergedAt != nil {
+		if record.State != "closed" || pull.Merged != nil && !pull.GetMerged() {
+			return PullRecord{}, ErrInvalidResponse
+		}
+		record.State = "merged"
+	}
+	var err error
+	if record.Base, err = pullBranch(pull.Base); err != nil {
+		return PullRecord{}, err
+	}
+	if record.Head, err = pullBranch(pull.Head); err != nil {
+		return PullRecord{}, err
+	}
+	if pull.User != nil {
+		author, err := issueActor(pull.User)
+		if err != nil {
+			return PullRecord{}, err
+		}
+		record.Author = &author
+	}
+	for _, user := range pull.Assignees {
+		actor, err := issueActor(user)
+		if err != nil {
+			return PullRecord{}, err
+		}
+		record.Assignees = append(record.Assignees, actor)
+	}
+	for _, label := range pull.Labels {
+		if label == nil || label.GetID() < 1 || label.GetName() == "" {
+			return PullRecord{}, ErrInvalidResponse
+		}
+		record.Labels = append(record.Labels, IssueLabel{ExternalID: strconv.FormatInt(label.GetID(), 10), Name: label.GetName(), Color: label.GetColor()})
+	}
+	return record, nil
+}
+func pullBranch(branch *sdk.PullRequestBranch) (*PullBranch, error) {
+	if branch == nil {
+		return nil, nil
+	}
+	if branch.SHA != nil && !collaboration.ValidCommitID(collaboration.CommitID(*branch.SHA)) {
+		return nil, ErrInvalidResponse
+	}
+	record := &PullBranch{Name: branch.GetRef(), Commit: branch.SHA}
+	if branch.Repo != nil {
+		if branch.Repo.GetID() < 1 || branch.Repo.GetFullName() == "" {
+			return nil, ErrInvalidResponse
+		}
+		record.Repository = &PullRepository{ExternalID: strconv.FormatInt(branch.Repo.GetID(), 10), Name: branch.Repo.GetFullName()}
+	}
+	return record, nil
+}
diff --git a/internal/github/review_comments.go b/internal/github/review_comments.go
new file mode 100644
index 0000000000000000000000000000000000000000..8050a6ebbce143ff2c48a4ef348f28e5343df7ac
