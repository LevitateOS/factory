+)
+
+// RecordedPlanGenerator adopts the reviewed recorded plan through the existing
+// funded choice, source/preparation currency and conditional graph workflow.
+type RecordedPlanGenerator interface {
+	GenerateAcceptedIntentFromRecordedPlan(context.Context, string, string, int64) (factory.IntentGeneration, *control.DispatchWait, error)
+}
+
+var _ RecordedPlanGenerator = (*control.Coordinator)(nil)
+
+// RequestPlanning owns admitted planning/generation commands. Hosts wire only
+// available capabilities and supply current authority through Requests. The
+// service neither detaches cancellation nor starts a worker on construction.
+type RequestPlanning struct {
+	Requests  Requests
+	Planner   PostPlanTransport
+	Generator RecordedPlanGenerator
+}
+
+var (
+	ErrRequestNotDraft           = errors.New("only draft direction starts a planning run")
+	ErrRequestNotAccepted        = errors.New("review the product direction before generating work")
+	ErrPlanningOperationInvalid  = errors.New("unknown planning operation")
+	ErrPlanningUnavailable       = errors.New("no enrolled model account can answer the staged prompt")
+	ErrPlanningInputsUnavailable = errors.New("draft planning inputs are unavailable")
+	ErrGraphUnavailable          = errors.New("native issue creation needs an enrolled graph actor")
+)
+
+// PlanningLaunch names the durable admitted assignment/run. A false
+// LaunchConfirmed means this response does not confirm a native start;
+// the recorded status remains authoritative during recovery.
+type PlanningLaunch struct {
+	AssignmentID    string `json:"assignment_id"`
+	RunID           string `json:"run_id"`
+	RevisionID      string `json:"revision_id"`
+	LaunchConfirmed *bool  `json:"launch_confirmed,omitempty"`
+}
+
+type PlanningResult struct {
+	Launch *PlanningLaunch
+	Waits  []control.DispatchWait
+}
+
+func (s RequestPlanning) Plan(ctx context.Context, actor collaboration.ActorID, intent, revision, operation string) (PlanningResult, error) {
+	var empty PlanningResult
+	current, err := s.Requests.Revision(ctx, actor, intent)
+	if err != nil {
+		return empty, err
+	}
+	if current.ID != revision {
+		return empty, store.ErrStaleRevision
+	}
+	if current.State != "draft" {
+		return empty, ErrRequestNotDraft
+	}
+	if err := s.Requests.authorizeWrite(ctx, actor, current.Repository); err != nil {
+		return empty, err
+	}
+	if !factory.ValidIntentPlanningOperation(operation) {
+		return empty, ErrPlanningOperationInvalid
+	}
+	if s.Planner == nil {
+		return empty, ErrPlanningUnavailable
+	}
+	// A fresh coordinator may see the protected session as busy before it
+	// reaches dispatch. Reuse the captured attempt first instead of preparing
+	// new inputs or hiding the funded identity behind a repository-full wait.
+	if attempt, err := s.Requests.Store.IntentPlanAttempt(ctx, current.Intent, current.ID); err == nil {
+		if attempt.Validate() != nil || attempt.Subject.Intent == nil || attempt.Subject.Intent.OwnerID != int64(actor) || attempt.Subject.Intent.IntentID != current.Intent || attempt.Subject.Intent.RevisionID != current.ID || attempt.Subject.Intent.ScopeDigest != current.Digest() || attempt.PlanningContext == nil || attempt.PlanningContext.Operation != operation {
+			return empty, store.ErrCommandConflict
+		}
+		confirmed := false
+		return PlanningResult{Launch: &PlanningLaunch{AssignmentID: attempt.ID, RunID: attempt.Run, RevisionID: current.ID, LaunchConfirmed: &confirmed}}, nil
+	} else if !errors.Is(err, store.ErrNotFound) {
+		return empty, err
+	}
+	plan, prep, wait, err := s.Planner.AssembleIntentPlanningInput(ctx, current, operation)
+	if err != nil {
+		return empty, errors.Join(ErrPlanningInputsUnavailable, err)
+	}
+	if wait != nil {
+		return PlanningResult{Waits: []control.DispatchWait{*wait}}, nil
+	}
+	report := s.Planner.DispatchIntentPlan(ctx, current.Intent, int64(actor), operation, plan, prep.SourceCommit, prep.ID)
+	if len(report.Errors) != 0 {
+		failure := report.Errors[0]
+		if failure.Reason == control.DispatchErrPromptBound {
+			return empty, errors.Join(control.ErrIntentPlanningPromptBound, errors.New(failure.Detail))
+		}
+		if failure.Reason == control.DispatchErrHost || failure.Reason == control.DispatchErrFence {
+			a, readErr := s.Requests.Store.IntentPlanAttempt(ctx, current.Intent, current.ID)
+			if readErr == nil && a.Validate() == nil && a.Subject.Intent != nil && a.Subject.Intent.OwnerID == int64(actor) && a.Subject.Intent.IntentID == current.Intent && a.Subject.Intent.RevisionID == current.ID && a.Subject.Intent.ScopeDigest == current.Digest() && a.SourceCommit == prep.SourceCommit && a.Preparation == prep.ID && a.PlanningContext != nil && a.PlanningContext.Operation == operation {
+				confirmed := false
+				return PlanningResult{Launch: &PlanningLaunch{AssignmentID: a.ID, RunID: a.Run, RevisionID: current.ID, LaunchConfirmed: &confirmed}}, nil
+			}
+		}
+		return empty, errors.New(failure.Detail)
+	}
+	if len(report.Launched) != 1 {
+		return PlanningResult{Waits: report.Waits}, nil
+	}
+	return PlanningResult{Launch: &PlanningLaunch{AssignmentID: report.Launched[0].AssignmentID, RunID: report.Launched[0].RunID, RevisionID: current.ID}}, nil
+}
+
+func (s RequestPlanning) Generate(ctx context.Context, actor collaboration.ActorID, intent, revision string) (factory.IntentGeneration, *control.DispatchWait, error) {
+	var empty factory.IntentGeneration
+	if !project.ValidDecisionID(revision) {
+		return empty, nil, ErrRequestInputInvalid
+	}
+	current, err := s.Requests.Revision(ctx, actor, intent)
+	if err != nil {
+		if errors.Is(err, ErrRequestNotFound) {
+			return empty, nil, err
+		}
+		return empty, nil, errors.Join(ErrRequestUnavailable, err)
+	}
+	if current.ID != revision {
+		return empty, nil, store.ErrStaleRevision
+	}
+	if current.State != "accepted" {
+		return empty, nil, ErrRequestNotAccepted
+	}
+	if err := s.Requests.authorizeWrite(ctx, actor, current.Repository); err != nil {
+		return empty, nil, err
+	}
+	if s.Generator == nil {
+		return empty, nil, ErrGraphUnavailable
+	}
+	return s.Generator.GenerateAcceptedIntentFromRecordedPlan(ctx, current.Intent, revision, int64(actor))
+}
diff --git a/internal/factory/service/request_progress.go b/internal/factory/service/request_progress.go
new file mode 100644
index 0000000000000000000000000000000000000000..8a03e7ccca98a5887baca9809351660f2827149c
--- /dev/null
+++ b/internal/factory/service/request_progress.go
@@ -0,0 +1,223 @@
+package service
+
+import (
+	"context"
+	"errors"
+
+	"github.com/levitateos/sodaos/internal/collaboration"
+	"github.com/levitateos/sodaos/internal/factory"
+	"github.com/levitateos/sodaos/internal/factory/control"
+	"github.com/levitateos/sodaos/internal/store"
+)
+
+// PlanningStatus is the minimal scoped draft-planning status for
+// one current revision: pending while the run is outstanding, the
+// reported shape once it settles, and none before the first attempt.
+// Copy stays about planning results, never source hashes.
+type PlanningStatus struct {
+	Revision     string                   `json:"revision"`
+	State        string                   `json:"state"`
+	AssignmentID string                   `json:"assignment_id,omitempty"`
+	RunID        string                   `json:"run_id,omitempty"`
+	Summary      string                   `json:"summary,omitempty"`
+	Candidates   int                      `json:"candidates,omitempty"`
+	Attention    string                   `json:"attention,omitempty"`
+	Walkthroughs *factory.ProposalContent `json:"walkthroughs,omitempty"`
+	Review       *Exploration             `json:"review,omitempty"`
+}
+
+func renderIntentPlanOutcome(a factory.Assignment) PlanningStatus {
+	view := PlanningStatus{AssignmentID: a.ID, RunID: a.Run}
+	switch {
+	case a.Stage != factory.AssignmentFinished || a.Result == nil:
+		view.State = "pending"
+	case a.Outcome == factory.Failed:
+		view.State, view.Summary = "failed", a.Result.Summary
+	case a.Outcome == factory.Cancelled:
+		view.State, view.Summary = "cancelled", a.Result.Summary
+	case a.Result.Reported && a.Result.PhaseResult != nil && a.Result.PhaseResult.Status == "completed":
+		view.State, view.Summary = "completed", a.Result.Summary
+		if out := a.Result.PhaseResult.Output; out != nil && out.Decomposition != nil {
+			view.Candidates = len(out.Decomposition.Candidates)
+			view.Walkthroughs = out.Decomposition.Walkthroughs
+		}
+	default:
+		view.State, view.Summary = "attention", a.Result.Summary
+		if out := a.Result.PhaseResult; out != nil && out.Output != nil && out.Output.Decomposition != nil {
+			view.Attention = out.Output.Decomposition.Attention
+		}
+	}
+	return view
+}
+
+func (s RequestExploration) planningHead(ctx context.Context, actor collaboration.ActorID, intent string) (factory.IntentRevision, error) {
+	head, err := s.Requests.Revision(ctx, actor, intent)
+	if err != nil {
+		return factory.IntentRevision{}, err
+	}
+	if head.State != "draft" {
+		return factory.IntentRevision{}, ErrRequestNotDraft
+	}
+	return head, nil
+}
+
+// PlanningReceipt is a recorded attempt, not confirmation of a native start.
+// Operation is absent only when this private draft has no recorded attempt.
+type PlanningReceipt struct {
+	Intent    string `json:"intent"`
+	Operation string `json:"operation,omitempty"`
+	PlanningStatus
+}
+
+// SavedPlanning reads one draft revision's recorded attempt independently of
+// the head. It neither wires a chooser nor attempts review, funding or launch.
+func (s Requests) SavedPlanning(ctx context.Context, actor collaboration.ActorID, intent, revision string) (PlanningReceipt, error) {
+	var empty PlanningReceipt
+	selected, err := s.SavedRevision(ctx, actor, intent, revision)
+	if err != nil {
+		return empty, err
+	}
+	if selected.State != "draft" {
+		return empty, ErrRequestNotFound
+	}
+	attempt, err := s.Store.IntentPlanAttempt(ctx, selected.Intent, selected.ID)
+	if errors.Is(err, store.ErrNotFound) {
+		return PlanningReceipt{Intent: selected.Intent, PlanningStatus: PlanningStatus{Revision: selected.ID, State: "none"}}, nil
+	}
+	if err != nil {
+		return empty, err
+	}
+	if attempt.Validate() != nil || attempt.Subject.Intent == nil || attempt.Subject.Intent.OwnerID != int64(actor) || attempt.Subject.Intent.IntentID != selected.Intent || attempt.Subject.Intent.RevisionID != selected.ID || attempt.Subject.Intent.ScopeDigest != selected.Digest() || attempt.PlanningContext == nil || !factory.ValidIntentPlanningOperation(attempt.PlanningContext.Operation) {
+		return empty, ErrRequestNotFound
+	}
+	view := renderIntentPlanOutcome(attempt)
+	view.Revision = selected.ID
+	if view.Walkthroughs != nil {
+		if err := factory.ValidatePlanningWalkthroughs(selected, *view.Walkthroughs); err != nil {
+			return empty, errors.Join(ErrPlanningWalkthroughInvalid, err)
+		}
+	}
+	return PlanningReceipt{Intent: selected.Intent, Operation: attempt.PlanningContext.Operation, PlanningStatus: view}, nil
+}
+
+func (s RequestExploration) Status(ctx context.Context, actor collaboration.ActorID, intent string) (PlanningStatus, error) {
+	var empty PlanningStatus
+	head, err := s.planningHead(ctx, actor, intent)
+	if err != nil {
+		return empty, err
+	}
+	attempt, err := s.Requests.Store.IntentPlanAttempt(ctx, head.Intent, head.ID)
+	if errors.Is(err, store.ErrNotFound) {
+		return PlanningStatus{Revision: head.ID, State: "none"}, nil
+	}
+	if err != nil {
+		return empty, err
+	}
+	if attempt.Subject.Intent == nil || attempt.Subject.Intent.OwnerID != head.Owner {
+		return empty, ErrRequestNotFound
+	}
+	view := renderIntentPlanOutcome(attempt)
+	view.Revision = head.ID
+	if view.Walkthroughs != nil {
+		if err := factory.ValidatePlanningWalkthroughs(head, *view.Walkthroughs); err != nil {
+			return empty, errors.Join(ErrPlanningWalkthroughInvalid, err)
+		}
+		// No chooser is reachable from a status read, even if the command
+		// instance has one. Missing advice remains absent without reserving credit.
+		replay := &control.Coordinator{Store: s.Requests.Store}
+		view.Review, _ = walkthroughAdvice(ctx, replay, head, *view.Walkthroughs)
+	}
+	return view, nil
+}
+
+func walkthroughAdvice(ctx context.Context, coord *control.Coordinator, head factory.IntentRevision, content factory.ProposalContent) (*Exploration, error) {
+	recommendation, err := coord.JudgeConsolidation(ctx, head, content)
+	if err != nil {
+		return nil, err
+	}
+	consistency, err := coord.JudgeConsistency(ctx, head, content, recommendation)
+	if err != nil {
+		return nil, err
+	}
+	return &Exploration{Content: content, Challenges: []factory.AssumptionChallenge{}, Settled: []string{}, Recommendation: &recommendation, Consistency: &consistency}, nil
+}
+
+// ReviewWalkthrough records advice about this exact completed planner result
+// without advancing the draft head or adopting any native work.
+func (s RequestExploration) ReviewWalkthrough(ctx context.Context, actor collaboration.ActorID, intent, revision string) (*Exploration, error) {
+	head, err := s.planningHead(ctx, actor, intent)
+	if err != nil {
+		return nil, err
+	}
+	if head.ID != revision {
+		return nil, store.ErrStaleRevision
+	}
+	if err := s.Requests.authorizeWrite(ctx, actor, head.Repository); err != nil {
+		return nil, err
+	}
+	attempt, err := s.Requests.Store.IntentPlanAttempt(ctx, head.Intent, head.ID)
+	if err != nil {
+		return nil, err
+	}
+	if attempt.Subject.Intent == nil || attempt.Subject.Intent.OwnerID != head.Owner {
+		return nil, ErrRequestNotFound
+	}
+	view := renderIntentPlanOutcome(attempt)
+	if view.State != "completed" || view.Walkthroughs == nil {
+		return nil, ErrPlanningWalkthroughUnavailable
+	}
+	if err := factory.ValidatePlanningWalkthroughs(head, *view.Walkthroughs); err != nil {
+		return nil, errors.Join(ErrPlanningWalkthroughInvalid, err)
+	}
+	coord := &control.Coordinator{Store: s.Requests.Store, Planning: &control.PlanningJudgments{Chooser: s.Chooser}}
+	review, err := walkthroughAdvice(ctx, coord, head, *view.Walkthroughs)
+	if err != nil {
+		return nil, err
+	}
+	current, err := s.Requests.Revision(ctx, actor, head.Intent)
+	if err != nil {
+		return nil, err
+	}
+	if current.ID != head.ID {
+		return nil, store.ErrStaleRevision
+	}
+	return review, nil
+}
+
+func (s Requests) Generation(ctx context.Context, actor collaboration.ActorID, intent string) (*factory.IntentGeneration, string, error) {
+	head, err := s.Revision(ctx, actor, intent)
+	if err != nil {
+		return nil, "", err
+	}
+	generation, err := s.Store.IntentGeneration(ctx, head.ID)
+	if errors.Is(err, store.ErrNotFound) {
+		return nil, head.ID, nil
+	}
+	if err != nil {
+		return nil, "", err
+	}
+	return &generation, head.ID, nil
+}
+
+// SavedGeneration reads recorded work creation for the selected immutable
+// acceptance, independently of the current head. It never drives graph work.
+func (s Requests) SavedGeneration(ctx context.Context, actor collaboration.ActorID, intent, revision string) (*factory.IntentGeneration, error) {
+	selected, err := s.SavedRevision(ctx, actor, intent, revision)
+	if err != nil {
+		return nil, err
+	}
+	if selected.State != "accepted" {
+		return nil, ErrRequestNotFound
+	}
+	generation, err := s.Store.IntentGeneration(ctx, selected.ID)
+	if errors.Is(err, store.ErrNotFound) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	if generation.IntentID != selected.Intent || generation.RevisionID != selected.ID {
+		return nil, ErrRequestNotFound
+	}
+	return &generation, nil
+}
diff --git a/internal/factory/service/request_verification.go b/internal/factory/service/request_verification.go
