-	comment := input.SourcePost
-	state := map[string]any{
-		"repository": comment.Record.Repository, "issue": comment.Record.Issue,
-		"parent_id": comment.Record.ParentID, "body": comment.Body,
-	}
-	if comment.Source != nil {
