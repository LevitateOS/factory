diff --git a/frontend/factory/work/context-record.ts b/frontend/factory/work/context-record.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4c22600fc82f69f935d5074cb847e98e4f2b60c1
--- /dev/null
+++ b/frontend/factory/work/context-record.ts
@@ -0,0 +1,107 @@
+import {check, id} from '../api/models.js';
+import {factoryRunID} from '../api/run-response.js';
+import {inspectStored, writeStored} from '../shared/drafts.js';
+
+export interface ContextChoiceAddress {
+  readonly scope: string;
+  readonly repository: string;
+  /** Empty only for a direct run with no issue binding. */
+  readonly issue: string;
+}
+/** The backend's semantic replay identity; no extra client command ID. */
+export interface PendingContextChoice {
+  readonly run: string;
+  readonly fingerprint: string;
+  readonly scope_digest: string;
+  readonly required_digest: string;
+}
+const limit = 32;
+function key(address: ContextChoiceAddress): string {
+  check(
+    typeof address.scope === 'string' &&
+      address.scope.length > 0 &&
+      address.scope.length <= 1024 &&
+      !/[\u0000-\u0020\u007f]/.test(address.scope) &&
+      id(address.repository) &&
+      (address.issue === '' || id(address.issue))
+  );
+  return `soda-work-context:v1:${encodeURIComponent(address.scope)}:${address.repository}:${address.issue}`;
+}
+function valid(value: unknown): value is PendingContextChoice {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) return false;
+  const row = value as Record<string, unknown>;
+  return (
+    Object.keys(row).length === 4 &&
+    factoryRunID(row.run) &&
+    [row.fingerprint, row.scope_digest, row.required_digest].every(
+      (value) => typeof value === 'string' && /^[0-9a-f]{64}$/.test(value)
+    )
+  );
+}
+export function sameContextChoice(a: PendingContextChoice, b: PendingContextChoice): boolean {
+  return (
+    a.run === b.run &&
+    a.fingerprint === b.fingerprint &&
+    a.scope_digest === b.scope_digest &&
+    a.required_digest === b.required_digest
+  );
+}
+/** Unknown, foreign and unavailable bytes are preserved, never treated as absence. */
+export function readContextChoices(address: ContextChoiceAddress): {
+  choices: readonly PendingContextChoice[];
+  blocked: boolean;
+  durable: boolean;
+} {
+  const stored = inspectStored(key(address));
+  if (stored.value === '') return {choices: [], blocked: false, durable: stored.durable};
+  if (stored.value !== undefined && stored.value.length <= 32768) {
+    try {
+      const row: unknown = JSON.parse(stored.value);
+      if (row && typeof row === 'object' && !Array.isArray(row)) {
+        const data = row as Record<string, unknown>;
+        if (
+          Object.keys(data).length === 4 &&
+          data.scope === address.scope &&
+          data.repository === address.repository &&
+          data.issue === address.issue &&
+          Array.isArray(data.choices) &&
+          data.choices.length > 0 &&
+          data.choices.length <= limit &&
+          data.choices.every(valid) &&
+          data.choices.every(
+            (choice, index, choices) => !choices.slice(0, index).some((previous) => sameContextChoice(previous, choice))
+          )
+        )
+          return {choices: data.choices, blocked: false, durable: stored.durable};
+      }
+    } catch {
+      /* Preserve original bytes. */
+    }
+  }
+  return {choices: [], blocked: true, durable: stored.durable};
+}
+export function retainContextChoice(
+  address: ContextChoiceAddress,
+  choice: PendingContextChoice
+): 'saved' | 'unavailable' | 'conflict' | 'full' {
+  check(valid(choice));
+  const current = readContextChoices(address);
+  if (current.blocked) return 'conflict';
+  const existing = current.choices.some((row) => sameContextChoice(row, choice));
+  if (existing && current.durable) return 'saved';
+  if (!existing && current.choices.length >= limit) return 'full';
+  const choices = existing ? current.choices : [...current.choices, choice];
+  return writeStored(key(address), JSON.stringify({...address, choices})) ? 'saved' : 'unavailable';
+}
+/** Merge removal of just the confirmed tuple; retain other unknown choices. */
+export function settleContextChoice(
+  address: ContextChoiceAddress,
+  choice: PendingContextChoice
+): 'settled' | 'unavailable' | 'conflict' {
+  const current = readContextChoices(address);
+  if (current.blocked || !current.choices.some((row) => sameContextChoice(row, choice))) return 'conflict';
+  const choices = current.choices.filter((row) => !sameContextChoice(row, choice));
+  return writeStored(key(address), choices.length ? JSON.stringify({...address, choices}) : '')
+    ? 'settled'
+    : 'unavailable';
+}
diff --git a/frontend/spaces/soda-factory-issue-host.ts b/frontend/spaces/soda-factory-issue-host.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9eb738d8b7001ebe44b551f192cf1bacbff7017d
--- /dev/null
+++ b/frontend/spaces/soda-factory-issue-host.ts
@@ -0,0 +1,137 @@
+// Fountain's identity and navigation join for the shared issue views. Product
+// components consume these ports without importing the native mount contract.
+import type {FactoryTransport} from '../factory/api/transport.js';
+import type {IssueListContext} from '../factory/issues/issues.js';
+import type {IssueDetailContext} from '../factory/issues/detail.js';
+import {check, id} from '../factory/api/models.js';
+import {markdownLink} from '../factory/shared/markdown.js';
+import {nativeAppSubUrl} from './soda-native-paths.js';
+import {fountainRepositoryNavigation} from './soda-factory-feed-host.js';
+
+export interface FountainIssueHostOptions {
+  /** Captured, authenticated place binding, not a repository name used as ID. */
+  readonly host: string;
+  readonly actor: string;
+  readonly repository: string;
+  readonly nativeRepository: string;
+  readonly name: string;
+  readonly prefix: string;
+  readonly origin: string;
+  /** The current host router owns the destination and fragment/history behavior. */
+  issuePath(number: string): string;
+  navigate(path: string, signal: AbortSignal): void | Promise<void>;
+  openExternal(url: string, signal: AbortSignal): void | Promise<void>;
+}
+
+/** Recheck live native navigation against the captured canonical place before
+ * supplying any read keys. The signal belongs to that place's whole lifetime. */
+export async function fountainIssueContexts(
+  transport: FactoryTransport,
+  options: FountainIssueHostOptions,
+  signal: AbortSignal
+): Promise<{
+  list: IssueListContext;
+  detail(number: string): IssueDetailContext;
+}> {
+  signal.throwIfAborted();
+  const generation = transport.generation;
+  check(!!generation && /^[a-f0-9]{32}$/.test(options.host));
+  check(id(options.actor) && id(options.repository) && id(options.nativeRepository));
+  check(typeof options.navigate === 'function' && typeof options.openExternal === 'function');
+  check(typeof options.issuePath === 'function');
+  // Copy the binding and ports; mutating a caller's object cannot rebind an
+  // admitted context while its reads or navigation are outstanding.
+  const {host, actor, repository, nativeRepository, name, prefix, origin, issuePath, navigate, openExternal} = options;
+  const base = new URL(origin);
+  check(['http:', 'https:'].includes(base.protocol) && base.origin === origin);
+  nativeAppSubUrl({appSubUrl: prefix});
+  const current = await fountainRepositoryNavigation(transport, repository, signal);
+  signal.throwIfAborted();
+  check(
+    current.host === host &&
+      current.actor === actor &&
+      current.native === nativeRepository &&
+      current.name === name &&
+      transport.generation === generation
+  );
+  const repositoryPath = `${prefix}/${current.name.split('/').map(encodeURIComponent).join('/')}`;
+  const repositoryURL = new URL(repositoryPath + '/', base);
+  const scope = `fountain:${host}:${actor}`;
+  const live = () => {
+    signal.throwIfAborted();
+    check(transport.generation === generation);
+  };
+  const issueURL = (number: string) => {
+    live();
+    check(id(number));
+    const path = issuePath(number);
+    check(typeof path === 'string' && path.startsWith(repositoryPath + '/') && !/[\\\u0000-\u0020\u007f]/.test(path));
+    const url = new URL(path, base);
+    check(url.origin === origin && !url.username && !url.password && !url.search && !url.hash);
+    check(url.pathname.startsWith(repositoryPath + '/'));
+    return url;
+  };
+  const open = async (url: string, opening: AbortSignal) => {
+    const lifetime = AbortSignal.any([signal, opening]);
+    lifetime.throwIfAborted();
+    live();
+    const safe = markdownLink(url);
+    check(safe !== undefined);
+    const target = new URL(safe);
+    // The native mount's navigate port admits same-origin paths only. External
+    // web/mail destinations have a separate browser/desktop opener.
+    if (target.origin === origin) await navigate(target.pathname + target.search + target.hash, lifetime);
+    else await openExternal(target.href, lifetime);
+    lifetime.throwIfAborted();
+    live();
+  };
+  // Both a component's own read lifetime and the host place must still be live.
+  // Consumers composing a frame/journey use this same transport for every child.
+  const scopedTransport: FactoryTransport = {
+    get generation() {
+      return transport.generation;
+    },
+    get assetBase() {
+      return transport.assetBase;
+    },
+    async request(path, init = {}) {
+      live();
+      const response = await transport.request(path, {
+        ...init,
+        signal: init.signal ? AbortSignal.any([signal, init.signal]) : signal,
+      });
+      live();
+      return response;
+    },
+  };
+  const shared = {transport: scopedTransport, host, actor, repository, scope};
+  return {
+    list: {
+      ...shared,
+      async openIssue(ref, opening) {
+        opening.throwIfAborted();
+        live();
+        check(ref.kind === 'issue' && ref.repository === repository && id(ref.number));
+        check(typeof ref.external_id === 'string' && !!ref.external_id.trim());
+        await open(issueURL(ref.number).href, opening);
+      },
+    },
+    detail(number) {
+      const page = issueURL(number);
+      return {
+        ...shared,
+        issue: number,
+        resolveLink(href) {
+          live();
+          if (!href || /[\\\u0000-\u001f\u007f]/.test(href)) return;
+          // Match native issue/comment Markdown's repository-relative base
+          // (modules/markup/markdown/transform_link.go), not a guessed branch.
+          // Explicit src/branch/... links retain their exact recorded branch.
+          const target = new URL(href, href.startsWith('#') || href.startsWith('?') ? page : repositoryURL);
+          return markdownLink(target.href);
+        },
+        openLink: open,
+      };
+    },
+  };
+}
diff --git a/frontend/spaces/soda-place-issues.ts b/frontend/spaces/soda-place-issues.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7fd65cdc2ccf11e9960bdbabe6225512ff6e6cb8
--- /dev/null
+++ b/frontend/spaces/soda-place-issues.ts
@@ -0,0 +1,247 @@
+// Native-header Fountain composition over the same production issue components
+// used by the standalone application frame.
+import {html, render} from 'lit';
+import {ifDefined} from 'lit/directives/if-defined.js';
+import {SodaFactoryIssues} from '../factory/issues/issues.js';
+import {SodaFactoryIssueCreate} from '../factory/issues/create.js';
+import {mountIssueScreen} from '../factory/issues/screen.js';
+import {fountainIssueContexts} from './soda-factory-issue-host.js';
+import {fountainAcceptanceLinks, fountainWorkLinks, nativeIssueLink, nativePullLink} from './soda-factory-links.js';
+import {fountainCommandScope} from './soda-factory-feed-host.js';
+import {withFactoryRepository} from './soda-place-view.js';
+import type {WorkPlace} from './soda-places.js';
+import '../factory/work/acceptance.js';
+import '../factory/work/context-resolution.js';
+import '../factory/work/completion-retry.js';
+
+export const mountIssuesPlace = withFactoryRepository((host, context, initial) => {
+  if (initial.place !== 'issues' && initial.place !== 'pulls') throw Error('Invalid issue destination');
+  let place: WorkPlace = initial;
+  let active = true;
+  let disposed = false;
+  let lifetime = new AbortController();
+  let release: (() => void) | undefined;
+  let controls: HTMLElement | undefined;
+  let available = false;
+  let content = document.createElement('div');
+  let ports: Awaited<ReturnType<typeof fountainIssueContexts>> | undefined;
+  // Native link helpers validate decoded paths; the place router owns encoding.
+  const repositoryPath = `${context.prefix}/${context.slug}`;
+  const scroll = () => {
+    if (!active || disposed) return;
+    const target = place.fragment?.slice(1) || (place.tab === 'factory' ? 'factory' : '');
+    if (!target) return;
+    let fragment: string;
+    try {
+      fragment = decodeURIComponent(target);
+    } catch {
+      return;
+    }
+    [...host.querySelectorAll<HTMLElement>('[id]')].find((element) => element.id === fragment)?.scrollIntoView();
+  };
+  const drawControls = () => {
+    if (!controls) return;
+    const issue = place.item;
+    const live =
+      available && active && ports && issue && issue !== 'new'
+        ? {transport: ports.list.transport, repository: context.factoryRepository, issue}
+        : undefined;
+    const commandScope = (signal: AbortSignal) => fountainCommandScope(ports!.list.transport, signal);
+    render(
+      live
+        ? html`<details class="soda-issue-factory-controls" ?open=${place.tab === 'factory'} id="factory">
+            <summary>Factory controls</summary>
+            <soda-factory-requirements-acceptance
+              .context=${{...live, links: fountainAcceptanceLinks(repositoryPath), commandScope}}
+            ></soda-factory-requirements-acceptance>
+            <soda-factory-context-resolution .context=${{...live, commandScope}}></soda-factory-context-resolution>
+            <soda-factory-completion-retry .context=${{...live, commandScope}}></soda-factory-completion-retry>
+          </details>`
+        : html``,
+      controls
+    );
+  };
+  const stop = () => {
+    lifetime.abort();
+    available = false;
+    release?.();
+    release = undefined;
+    if (controls) render(html``, controls);
+    controls = undefined;
+    ports = undefined;
+    render(html``, content);
+    content.remove();
+  };
+  const load = () => {
+    stop();
+    if (!active || disposed) return;
+    content = document.createElement('div');
+    host.append(content);
+    lifetime = new AbortController();
+    const signal = lifetime.signal;
+    const current = () => !disposed && active && lifetime.signal === signal && !signal.aborted;
+    const native =
+      place.place === 'pulls'
+        ? place.item && place.item !== 'new'
+          ? nativePullLink(repositoryPath, place.item)
+          : `${repositoryPath}/${place.item === 'new' ? 'compare' : 'pulls'}`
+        : `${repositoryPath}/issues/new`;
+    if (place.place === 'pulls') {
+      render(
+        html`<section aria-label="Pull requests">
+          <h2>Pull requests</h2>
+          <p role="status">The shared pull request view is not available yet.</p>
+          <a href=${ifDefined(native)}>Open in Fountain</a>
+        </section>`,
+        content
+      );
+      return;
+    }
+    render(html`<p role="status">Loading repository information…</p>`, content);
+    void fountainIssueContexts(
+      context.transport,
+      {
+        host: context.factoryHost,
+        actor: context.factoryActor,
+        repository: context.factoryRepository,
+        nativeRepository: context.repository,
+        name: context.slug,
+        prefix: context.prefix,
+        origin: location.origin,
+        issuePath: (number) => context.places.issues(number),
+        navigate(path, opening) {
+          opening.throwIfAborted();
+          context.navigate(path);
+        },
+        openExternal(url, opening) {
+          opening.throwIfAborted();
+          window.open(url, '_blank', 'noopener,noreferrer');
+        },
+      },
+      signal
+    )
+      .then(
+        (admitted) => {
+          if (!current()) return;
+          ports = admitted;
+          render(html``, content);
+          const navigation = document.createElement('nav');
+          navigation.setAttribute('aria-label', 'Issue navigation');
+          render(
+            html`<a href=${context.places.issues()}>Issues</a>${
+                place.item && place.item !== 'new'
+                  ? html` <a href=${context.places.issues(place.item)}>Conversation</a>
+                      <a href=${context.places.factoryStatus(place.item)}>Factory</a>
+                      <a href=${ifDefined(nativeIssueLink(repositoryPath, place.item))}>Open in Fountain</a>`
+                  : html` <a href=${context.places.issues('new')}>New issue</a>`
+              }`,
+            navigation
+          );
+          content.append(navigation);
+          if (place.item === 'new') {
+            const form = new SodaFactoryIssueCreate();
+            form.context = {
+              transport: admitted.list.transport,
+              host: context.factoryHost,
+              actor: context.factoryActor,
+              repository: context.factoryRepository,
+              scope: admitted.list.scope,
+              commandScope: (signal) => fountainCommandScope(admitted.list.transport, signal),
+              openIssue: (issue, opening) => admitted.list.openIssue(issue, opening),
+            };
+            release = () => {
+              form.context = undefined;
+              form.remove();
+            };
+            content.append(form);
+            return;
+          }
+          if (!place.item) {
+            const list = new SodaFactoryIssues();
+            list.context = admitted.list;
+            release = () => {
+              list.context = undefined;
+              list.remove();
+            };
+            content.append(list);
+            return;
+          }
+          controls = document.createElement('div');
+          const screen = mountIssueScreen(
+            admitted.detail(place.item),
+            {
+              transport: admitted.list.transport,
+              repository: context.factoryRepository,
+              issue: place.item,
+              links: fountainWorkLinks(repositoryPath),
+            },
+            signal,
+            current,
+            (value) => {
+              available = value;
+              drawControls();
+              if (value)
+                requestAnimationFrame(() => {
+                  if (current()) scroll();
+                });
+            },
+            {
+              transport: admitted.list.transport,
+              host: context.factoryHost,
+              actor: context.factoryActor,
+              repository: context.factoryRepository,
+              issue: place.item,
+              scope: admitted.list.scope,
+              commandScope: (signal) => fountainCommandScope(admitted.list.transport, signal),
+            },
+            {
+              transport: admitted.list.transport,
+              host: context.factoryHost,
+              actor: context.factoryActor,
+              repository: context.factoryRepository,
+              issue: place.item,
+              scope: admitted.list.scope,
+              commandScope: (signal) => fountainCommandScope(admitted.list.transport, signal),
+            }
+          );
+          release = screen.dispose;
+          content.append(screen.element, controls);
+        },
+        () => {
+          if (current())
+            render(html`<p role="status">Repository information is unavailable. Refresh to try again.</p>`, content);
+        }
+      )
+      .catch(() => {
+        if (current()) {
+          stop();
+          content = document.createElement('div');
+          host.append(content);
+          render(html`<p role="status">This issue view could not load.</p>`, content);
+        }
+      });
+  };
+  load();
+  return {
+    update(next) {
+      if (next.place !== 'issues' && next.place !== 'pulls') return;
+      const same = next.place === place.place && next.item === place.item;
+      place = next;
+      if (same) {
+        const panel = controls?.querySelector('details');
+        if (panel) panel.open = place.tab === 'factory';
+        scroll();
+      } else load();
+    },
+    setActive(value) {
+      if (active === value) return;
+      active = value;
+      if (value) load();
+      else stop();
+    },
+    dispose() {
+      disposed = true;
+      stop();
+    },
+  };
+});
diff --git a/frontend/storybook/app-fixtures.ts b/frontend/storybook/app-fixtures.ts
