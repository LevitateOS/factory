+.soda-feed-ic {
+  width: 16px;
+  height: 16px;
+  flex: none;
+}
+/* The headline and pill now lead the card. The section's own caption and
+   title stay for screen readers only, so the post keeps its heading. */
+.soda-feed-card > section[data-feed-family] > .soda-feed-headline,
+.soda-feed-card .soda-feed-communication > .soda-feed-component-caption,
