+)
+
+var _ factoryservice.CollaborationDiscussionSource = HumanReads{}
+
+func (s HumanReads) ReadIssueComments(ctx context.Context, actor collaboration.ActorID, repo collaboration.RepositoryID, number int64, q factoryservice.DiscussionQuery) (collaboration.Page[collaboration.IssueComment], error) {
+	var empty collaboration.Page[collaboration.IssueComment]
+	native, comments, observation, err := s.discussion(ctx, actor, repo, number, "issue", q)
+	if err != nil {
+		return empty, err
+	}
+	page := collaboration.Page[collaboration.IssueComment]{Observation: observation, Items: []collaboration.IssueComment{}, Next: native.NextCursor, Complete: native.NextCursor == ""}
+	ref := collaboration.IssueRef{Kind: collaboration.SubjectIssue, Repository: repo, ExternalID: native.SubjectID, Number: number}
+	for _, comment := range comments {
+		page.Items = append(page.Items, collaboration.IssueComment{Issue: ref, Comment: comment})
+	}
+	return page, nil
+}
+func (s HumanReads) ReadPullComments(ctx context.Context, actor collaboration.ActorID, repo collaboration.RepositoryID, number int64, q factoryservice.DiscussionQuery) (collaboration.Page[collaboration.PullComment], error) {
+	var empty collaboration.Page[collaboration.PullComment]
+	native, comments, observation, err := s.discussion(ctx, actor, repo, number, "pull", q)
+	if err != nil {
+		return empty, err
+	}
+	page := collaboration.Page[collaboration.PullComment]{Observation: observation, Items: []collaboration.PullComment{}, Next: native.NextCursor, Complete: native.NextCursor == ""}
+	ref := collaboration.PullRef{Kind: collaboration.SubjectPull, Repository: repo, ExternalID: native.SubjectID, Number: number}
+	for _, comment := range comments {
+		page.Items = append(page.Items, collaboration.PullComment{Pull: ref, Comment: comment})
+	}
+	return page, nil
+}
+func (s HumanReads) discussion(ctx context.Context, actor collaboration.ActorID, repo collaboration.RepositoryID, number int64, kind string, q factoryservice.DiscussionQuery) (extensions.RepositoryCommentPage, []collaboration.Comment, collaboration.Observation, error) {
+	var empty extensions.RepositoryCommentPage
+	var unknown collaboration.Observation
+	fail := func(err error) (extensions.RepositoryCommentPage, []collaboration.Comment, collaboration.Observation, error) {
+		return empty, nil, unknown, discussionError(err)
+	}
+	if actor < 1 || repo < 1 || number < 1 || q.Validate() != nil {
+		return fail(factoryservice.ErrDiscussionQuery)
+	}
+	if q.Cursor != "" {
+		if _, err := originalCreationID(q.Cursor); err != nil {
+			return fail(factoryservice.ErrDiscussionQuery)
+		}
+	}
+	ctx, cancel := context.WithTimeout(ctx, 8*time.Second)
+	defer cancel()
+	nativeRepo, nativeActor, err := s.scope(ctx, actor, repo)
+	if err != nil {
+		return fail(err)
+	}
+	native, err := s.Authority.RepositoryComments(ctx, nativeRepo, extensions.RepositoryCommentsRequest{Subject: kind, Index: strconv.FormatInt(number, 10), Cursor: q.Cursor, Limit: q.Limit})
+	if err != nil {
+		return fail(err)
+	}
+	observation := collaboration.Observation{State: collaboration.ReadAvailable, Revision: issueReadRevision(native), ObservedAt: time.Now().UTC()}
+	comments := make([]collaboration.Comment, 0, len(native.Items))
+	for _, item := range native.Items {
+		comment := collaboration.Comment{ExternalID: item.ID, Observation: collaboration.Observation{State: collaboration.ReadAvailable, Revision: issueReadRevision(item), ObservedAt: observation.ObservedAt}, Body: item.Body, CreatedAt: item.CreatedAt, UpdatedAt: item.UpdatedAt}
+		if item.Author != nil {
+			author, err := s.actor(ctx, *item.Author)
+			if err != nil {
+				return fail(err)
+			}
+			comment.Author = &author
+		}
+		comments = append(comments, comment)
+	}
+	after, err := s.Authority.Native().CurrentActor(ctx)
+	if err != nil {
+		return fail(err)
+	}
+	if after.ID != nativeActor {
+		return fail(factoryservice.ErrDiscussionMissing)
+	}
+	return native, comments, observation, nil
+}
+func discussionError(err error) error {
+	if errors.Is(err, store.ErrNotFound) || errors.Is(err, extensions.ErrRepositoryNotVisible) {
+		return factoryservice.ErrDiscussionMissing
+	}
+	return err
+}
diff --git a/internal/forgejo/collaboration_issues.go b/internal/forgejo/collaboration_issues.go
new file mode 100644
index 0000000000000000000000000000000000000000..6feea1c6027b0bd41635f1292d80ecc3b8c288a1
--- /dev/null
+++ b/internal/forgejo/collaboration_issues.go
@@ -0,0 +1,124 @@
+package forgejo
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"strconv"
+	"time"
+
+	extensions "forgejo.org/extension-sdk"
+	"github.com/levitateos/sodaos/internal/collaboration"
+	factoryservice "github.com/levitateos/sodaos/internal/factory/service"
+	"github.com/levitateos/sodaos/internal/store"
+)
+
+// HumanReads uses this request's live human admission, never an automation PAT.
+// Canonical keys resolve on the adopted host before any native read.
+type HumanReads struct {
+	Authority  extensions.Authority
+	Identities *FountainIdentities
+}
+
+var _ factoryservice.CollaborationIssueSource = HumanReads{}
+
+func (s HumanReads) ReadIssues(ctx context.Context, actor collaboration.ActorID, repository collaboration.RepositoryID, query factoryservice.CollaborationIssueQuery) (collaboration.Page[collaboration.Issue], error) {
+	var empty collaboration.Page[collaboration.Issue]
+	if query.Validate() != nil || actor < 1 || repository < 1 {
+		return empty, factoryservice.ErrCollaborationIssueQuery
+	}
+	if query.Cursor != "" {
+		if _, err := originalCreationID(query.Cursor); err != nil {
+			return empty, factoryservice.ErrCollaborationIssueQuery
+		}
+	}
+	if s.Identities == nil {
+		return empty, factoryservice.ErrCollaborationIssueUnavailable
+	}
+	ctx, cancel := context.WithTimeout(ctx, 8*time.Second)
+	defer cancel()
+	nativeRepository, nativeActor, err := s.scope(ctx, actor, repository)
+	if err != nil {
+		return empty, humanIssueError(err)
+	}
+	number := ""
+	if query.Number > 0 {
+		number = strconv.FormatInt(query.Number, 10)
+	}
+	page, err := s.Authority.RepositoryIssues(ctx, nativeRepository, query.Cursor, number, query.Limit, true, query.State)
+	if err != nil {
+		return empty, humanIssueError(err)
+	}
+	if page.RepositoryID != nativeRepository {
+		return empty, ErrInvalidResponse
+	}
+	observed := time.Now().UTC()
+	result := collaboration.Page[collaboration.Issue]{Observation: collaboration.Observation{State: collaboration.ReadAvailable, Revision: issueReadRevision(page), ObservedAt: observed}, Items: make([]collaboration.Issue, 0, len(page.Items)), Next: page.NextCursor, Complete: page.NextCursor == ""}
+	for _, native := range page.Items {
+		index, err := originalCreationID(native.Index)
+		if err != nil || !native.BodyComplete {
+			return empty, ErrInvalidResponse
+		}
+		if _, err = originalCreationID(native.ID); err != nil {
+			return empty, ErrInvalidResponse
+		}
+		item := collaboration.Issue{Ref: collaboration.IssueRef{Kind: collaboration.SubjectIssue, Repository: repository, ExternalID: native.ID, Number: index}, Observation: collaboration.Observation{State: collaboration.ReadAvailable, Revision: issueReadRevision(native), ObservedAt: observed}, Title: native.Title, Body: native.Body, State: "open", Assignees: []collaboration.ActorRef{}, Labels: []collaboration.Label{}, CreatedAt: native.CreatedAt, UpdatedAt: native.UpdatedAt, ClosedAt: native.ClosedAt}
+		if native.Closed {
+			item.State = "closed"
+		}
+		if native.Author != nil {
+			author, err := s.actor(ctx, *native.Author)
+			if err != nil {
+				return empty, err
+			}
+			item.Author = &author
+		}
+		for _, nativeActor := range native.Assignees {
+			actor, err := s.actor(ctx, nativeActor)
+			if err != nil {
+				return empty, err
+			}
+			item.Assignees = append(item.Assignees, actor)
+		}
+		for _, label := range native.Labels {
+			if _, err := originalCreationID(label.ID); err != nil {
+				return empty, ErrInvalidResponse
+			}
+			item.Labels = append(item.Labels, collaboration.Label{ExternalID: label.ID, Name: label.Name, Color: label.Color})
+		}
+		// Action facts use the separate current actor/resource capability read.
+		result.Items = append(result.Items, item)
+	}
+	after, err := s.Authority.Native().CurrentActor(ctx)
+	if err != nil {
+		return empty, humanIssueError(err)
+	}
+	if after.ID != nativeActor {
+		return empty, factoryservice.ErrCollaborationIssueMissing
+	}
+	return result, nil
+}
+func (s HumanReads) actor(ctx context.Context, native extensions.RepositoryIssueActor) (collaboration.ActorRef, error) {
+	if _, err := originalCreationID(native.ID); err != nil {
+		return collaboration.ActorRef{}, ErrInvalidResponse
+	}
+	if !collaboration.ValidText(native.Username, 255) {
+		return collaboration.ActorRef{}, ErrInvalidResponse
+	}
+	return s.Identities.registry.ObserveCollaborationActor(ctx, s.Identities.host, native.ID, native.Username)
+}
+func issueReadRevision(value any) collaboration.Revision {
+	// This version describes the returned resource/page, not an atomic snapshot or
+	// a native mutation precondition. Native guarded effects use their own proof.
+	body, _ := json.Marshal(value)
+	sum := sha256.Sum256(body)
+	return collaboration.Revision("fountain-read:" + hex.EncodeToString(sum[:]))
+}
+func humanIssueError(err error) error {
+	if errors.Is(err, store.ErrNotFound) || errors.Is(err, extensions.ErrRepositoryNotVisible) {
+		return factoryservice.ErrCollaborationIssueMissing
+	}
+	return err
+}
