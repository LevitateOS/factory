+package store
+
+import (
+	"context"
+
+	"github.com/levitateos/sodaos/internal/collaboration"
+)
+
+// FountainLedgerHost returns the explicitly adopted appliance namespace. An
+// empty native profile or unadopted retained ledger has no such association.
+func (s *Store) FountainLedgerHost(ctx context.Context) (collaboration.Host, error) {
+	var host collaboration.Host
+	err := s.db.QueryRowContext(ctx, `SELECT h.id,h.provider,h.api_base FROM collaboration_ledger l JOIN collaboration_hosts h ON h.id=l.fountain_host AND h.provider='fountain' WHERE l.singleton AND l.adopted`).Scan(&host.ID, &host.Provider, &host.APIBase)
+	return host, err
+}
+
+// These are lookups of existing observations, never allocations, permission
+// checks or credential selection. Both directions require the provider host;
+// numeric equality, repository names and account logins cannot select it.
+func (s *Store) CollaborationRepositoryOnHost(ctx context.Context, host collaboration.HostID, id collaboration.RepositoryID) (collaboration.RepositoryRef, error) {
+	var ref collaboration.RepositoryRef
+	if !collaboration.ValidID(string(host)) || id < 1 {
+		return ref, collaboration.ErrIdentityConflict
+	}
+	err := s.db.QueryRowContext(ctx, `SELECT id,host,external_id,name FROM collaboration_repositories WHERE host=$1 AND id=$2`, host, id).Scan(&ref.ID, &ref.Host, &ref.ExternalID, &ref.Name)
+	return ref, err
+}
+
+func (s *Store) CollaborationRepositoryByExternalID(ctx context.Context, host collaboration.HostID, externalID string) (collaboration.RepositoryRef, error) {
+	var ref collaboration.RepositoryRef
+	if !collaboration.ValidID(string(host)) || !collaboration.ValidText(externalID, 512) {
+		return ref, collaboration.ErrIdentityConflict
+	}
+	err := s.db.QueryRowContext(ctx, `SELECT id,host,external_id,name FROM collaboration_repositories WHERE host=$1 AND external_id=$2`, host, externalID).Scan(&ref.ID, &ref.Host, &ref.ExternalID, &ref.Name)
+	return ref, err
+}
+
+func (s *Store) CollaborationActorOnHost(ctx context.Context, host collaboration.HostID, id collaboration.ActorID) (collaboration.ActorRef, error) {
+	var ref collaboration.ActorRef
+	if !collaboration.ValidID(string(host)) || id < 1 {
+		return ref, collaboration.ErrIdentityConflict
+	}
+	err := s.db.QueryRowContext(ctx, `SELECT id,host,external_id,login FROM collaboration_actors WHERE host=$1 AND id=$2`, host, id).Scan(&ref.ID, &ref.Host, &ref.ExternalID, &ref.Login)
+	return ref, err
+}
+
+func (s *Store) CollaborationActorByExternalID(ctx context.Context, host collaboration.HostID, externalID string) (collaboration.ActorRef, error) {
+	var ref collaboration.ActorRef
+	if !collaboration.ValidID(string(host)) || !collaboration.ValidText(externalID, 512) {
+		return ref, collaboration.ErrIdentityConflict
+	}
+	err := s.db.QueryRowContext(ctx, `SELECT id,host,external_id,login FROM collaboration_actors WHERE host=$1 AND external_id=$2`, host, externalID).Scan(&ref.ID, &ref.Host, &ref.ExternalID, &ref.Login)
+	return ref, err
+}
+
+func (s *Store) CollaborationTeamOnHost(ctx context.Context, host collaboration.HostID, id collaboration.TeamID) (collaboration.TeamRef, error) {
+	var ref collaboration.TeamRef
+	if !collaboration.ValidID(string(host)) || id < 1 {
+		return ref, collaboration.ErrIdentityConflict
+	}
+	err := s.db.QueryRowContext(ctx, `SELECT id,host,external_id,name FROM collaboration_teams WHERE host=$1 AND id=$2`, host, id).Scan(&ref.ID, &ref.Host, &ref.ExternalID, &ref.Name)
+	return ref, err
+}
+
+func (s *Store) CollaborationTeamByExternalID(ctx context.Context, host collaboration.HostID, externalID string) (collaboration.TeamRef, error) {
+	var ref collaboration.TeamRef
+	if !collaboration.ValidID(string(host)) || !collaboration.ValidText(externalID, 512) {
+		return ref, collaboration.ErrIdentityConflict
+	}
+	err := s.db.QueryRowContext(ctx, `SELECT id,host,external_id,name FROM collaboration_teams WHERE host=$1 AND external_id=$2`, host, externalID).Scan(&ref.ID, &ref.Host, &ref.ExternalID, &ref.Name)
+	return ref, err
+}
+
+// Native Projects belong to the explicitly adopted appliance's namespace. Their
+// repository_id and owner_id stay native IDs, even when a new observation gets
+// a different local surrogate. Compare the native key as text: other providers'
+// opaque IDs must never be coerced into native numbers or matched by name.
+const nativeProjectCollaborationJoin = ` FROM projects p
+ JOIN collaboration_ledger l ON l.singleton AND l.adopted
+ JOIN collaboration_hosts h ON h.id=l.fountain_host AND h.provider='fountain'
+ JOIN collaboration_repositories r ON r.host=h.id AND r.external_id=p.repository_id::text`
+
+const nativeProjectCollaborationColumns = `p.id,p.name,p.repository_id,p.owner_id,p.repository,p.ip,p.ready,p.creation_profile`
+
+// NativeProjectForCollaborationRepository resolves an existing association. A
+// missing/unadopted/foreign mapping returns ErrNotFound; it does not prove remote
+// absence, deny provider access, or authorize execution on the returned Project.
+func (s *Store) NativeProjectForCollaborationRepository(ctx context.Context, repository collaboration.RepositoryID) (Project, error) {
+	if repository < 1 {
+		return Project{}, collaboration.ErrIdentityConflict
+	}
+	return scanProject(s.db.QueryRowContext(ctx, `SELECT `+nativeProjectCollaborationColumns+nativeProjectCollaborationJoin+` WHERE r.id=$1`, repository))
+}
+
+func (s *Store) CollaborationRepositoryForNativeProject(ctx context.Context, projectID string) (collaboration.RepositoryRef, error) {
+	var ref collaboration.RepositoryRef
+	if !collaboration.ValidText(projectID, 128) {
+		return ref, collaboration.ErrIdentityConflict
+	}
+	err := s.db.QueryRowContext(ctx, `SELECT r.id,r.host,r.external_id,r.name`+nativeProjectCollaborationJoin+` WHERE p.id=$1`, projectID).Scan(&ref.ID, &ref.Host, &ref.ExternalID, &ref.Name)
+	return ref, err
+}
diff --git a/internal/store/collaboration_retained.go b/internal/store/collaboration_retained.go
new file mode 100644
index 0000000000000000000000000000000000000000..c85ed3c1ed1f6051b6a0c0b84d6c7d7b944ddd1d
--- /dev/null
+++ b/internal/store/collaboration_retained.go
@@ -0,0 +1,212 @@
+package store
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"fmt"
+	"strconv"
+	"strings"
+
+	"github.com/levitateos/sodaos/internal/collaboration"
+)
+
+type (
+	retainedCollaborationColumn struct{ table, name string }
+	retainedCollaborationRefs   struct{ repositories, actors map[int64]string }
+)
+
+func quoteCollaborationIdentifier(value string) string {
+	return `"` + strings.ReplaceAll(value, `"`, `""`) + `"`
+}
+
+func retainedCollaborationColumns(ctx context.Context, tx *sql.Tx) ([]retainedCollaborationColumn, error) {
+	rows, err := tx.QueryContext(ctx, `SELECT c.table_name,c.column_name,c.data_type
+ FROM information_schema.columns c JOIN information_schema.tables t ON t.table_schema=c.table_schema AND t.table_name=c.table_name
+ WHERE c.table_schema='public' AND t.table_type='BASE TABLE' AND left(c.table_name,14)<>'collaboration_'
+ ORDER BY c.table_name,c.ordinal_position`)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	var columns []retainedCollaborationColumn
+	for rows.Next() {
+		var table, name, kind string
+		if err := rows.Scan(&table, &name, &kind); err != nil {
+			return nil, err
+		}
+		if retainedIdentityKind(name) != "" || table == "users" && name == "id" || kind == "jsonb" || kind == "json" || table == "factory_commands" && (name == "target" || name == "payload" || name == "outcome") {
+			columns = append(columns, retainedCollaborationColumn{table, name})
+		}
+	}
+	return columns, rows.Err()
+}
+
+func lockRetainedCollaborationTables(ctx context.Context, tx *sql.Tx, columns []retainedCollaborationColumn) error {
+	previous := ""
+	for _, column := range columns {
+		if column.table == previous {
+			continue
+		}
+		previous = column.table
+		// Composition calls this before reopening dispatch. The lock also keeps
+		// the captured inventory stable against an in-flight legacy writer.
+		if _, err := tx.ExecContext(ctx, `LOCK TABLE public.`+quoteCollaborationIdentifier(column.table)+` IN SHARE MODE`); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func readRetainedCollaborationRefs(ctx context.Context, tx *sql.Tx, columns []retainedCollaborationColumn) (retainedCollaborationRefs, error) {
+	refs := retainedCollaborationRefs{repositories: map[int64]string{}, actors: map[int64]string{}}
+	for _, column := range columns {
+		name := column.name
+		if column.table == "users" && name == "id" {
+			name = "actor_id"
+		}
+		quoted := quoteCollaborationIdentifier(column.name)
+		rows, err := tx.QueryContext(ctx, `SELECT to_jsonb(`+quoted+`)::text FROM public.`+quoteCollaborationIdentifier(column.table)+` WHERE `+quoted+` IS NOT NULL`)
+		if err != nil {
+			return refs, err
+		}
+		for rows.Next() {
+			var raw string
+			if err := rows.Scan(&raw); err != nil {
+				rows.Close()
+				return refs, err
+			}
+			var value any
+			decoder := json.NewDecoder(strings.NewReader(raw))
+			decoder.UseNumber()
+			if err := decoder.Decode(&value); err != nil {
+				rows.Close()
+				return refs, fmt.Errorf("read retained identity metadata in %s.%s: %w", column.table, column.name, err)
+			}
+			if column.table == "factory_commands" && (name == "payload" || name == "outcome") {
+				text, _ := value.(string)
+				if strings.TrimSpace(text) == "" {
+					continue
+				}
+				if !json.Valid([]byte(text)) && !strings.HasPrefix(strings.TrimSpace(text), "{") && !strings.HasPrefix(strings.TrimSpace(text), "[") {
+					continue
+				}
+				decoder = json.NewDecoder(strings.NewReader(text))
+				decoder.UseNumber()
+				if err := decoder.Decode(&value); err != nil {
+					rows.Close()
+					return refs, fmt.Errorf("%w: retained command JSON is unreadable", collaboration.ErrIdentityConflict)
+				}
+			}
+			refs.collect(name, value)
+		}
+		err = rows.Err()
+		rows.Close()
+		if err != nil {
+			return refs, err
+		}
+	}
+	// Labels are optional historical metadata. Import never changes their source
+	// rows, infers a permission or asserts that a remote resource still exists.
+	for _, q := range []struct {
+		query string
+		dest  map[int64]string
+	}{
+		{`SELECT id,login FROM users`, refs.actors}, {`SELECT repository_id,repository FROM projects`, refs.repositories},
+	} {
+		rows, err := tx.QueryContext(ctx, q.query)
+		if err != nil {
+			return refs, err
+		}
+		for rows.Next() {
+			var id int64
+			var label string
+			if err := rows.Scan(&id, &label); err != nil {
+				rows.Close()
+				return refs, err
+			}
+			if id > 0 && collaboration.ValidText(label, 512) {
+				q.dest[id] = label
+			}
+		}
+		err = rows.Err()
+		rows.Close()
+		if err != nil {
+			return refs, err
+		}
+	}
+	return refs, nil
+}
+
+func retainedIdentityKind(field string) string {
+	field = strings.ToLower(field)
+	if field == "repository" || field == "repository_id" || field == "repositories" || field == "repositoryid" || strings.HasSuffix(field, "_repository") || strings.HasSuffix(field, "_repository_id") {
+		return "repository"
+	}
+	switch field {
+	case "actor", "actor_id", "actors", "actorid", "user", "users", "user_id", "owner", "owners", "owner_id", "author", "authors", "author_id", "subscriber", "subscriber_id", "administrator", "administrator_id", "creator_id", "poster_id", "reviewer_id", "withdrawer", "principal", "decision_owner", "environment_administrator", "environment_owner", "project_administrator":
+		return "actor"
+	}
+	for _, suffix := range []string{"_actor", "_actor_id", "_actors", "_author", "_author_id", "_user_id", "_owner_id"} {
+		if strings.HasSuffix(field, suffix) {
+			return "actor"
+		}
+	}
+	return ""
+}
+
+func (refs retainedCollaborationRefs) collect(field string, value any) {
+	kind := retainedIdentityKind(field)
+	if field == "target" {
+		if text, ok := value.(string); ok {
+			parts := strings.Split(text, "/")
+			if len(parts) >= 2 && parts[0] == "repository" {
+				refs.add("repository", parts[1])
+			}
+		}
+	}
+	switch value := value.(type) {
+	case map[string]any:
+		if kind != "" {
+			refs.add(kind, value["id"])
+		}
+		for key, child := range value {
+			if kind != "" && (field == "repositories" || field == "actors" || field == "users") {
+				refs.add(kind, key)
+			}
+			refs.collect(key, child)
+		}
+	case []any:
+		for _, child := range value {
+			refs.collect(field, child)
+		}
+	default:
+		if kind != "" {
+			refs.add(kind, value)
+		}
+	}
+}
+
+func (refs retainedCollaborationRefs) add(kind string, value any) {
+	var text string
+	switch value := value.(type) {
+	case string:
+		text = value
+	case json.Number:
+		text = value.String()
+	default:
+		return
+	}
+	if kind == "actor" {
+		text = strings.TrimPrefix(text, "native:")
+	}
+	id, err := strconv.ParseInt(text, 10, 64)
+	if err != nil || id < 1 {
+		return
+	}
+	if kind == "repository" {
+		refs.repositories[id] = "repository " + strconv.FormatInt(id, 10)
+	} else {
+		refs.actors[id] = "actor " + strconv.FormatInt(id, 10)
+	}
+}
diff --git a/internal/store/collaboration_schema.go b/internal/store/collaboration_schema.go
new file mode 100644
index 0000000000000000000000000000000000000000..711c44ba03184dc72f36c5c48b17f1c698a8350f
--- /dev/null
+++ b/internal/store/collaboration_schema.go
@@ -0,0 +1,199 @@
+package store
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"fmt"
+	"strings"
+)
+
+// Additive registry owned by the canonical Go store, like its library/artifact
+// tables. No workflow rows are renumbered and no provider instance is guessed.
+const collaborationTeamsDDL = `CREATE TABLE collaboration_teams(id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY CHECK(id>0), host TEXT NOT NULL REFERENCES collaboration_hosts(id), external_id TEXT NOT NULL CHECK(char_length(external_id) BETWEEN 1 AND 512), name TEXT NOT NULL, UNIQUE(host,external_id), UNIQUE(id,host))`
+
+var collaborationDDL = []string{
+	`CREATE TABLE collaboration_hosts(id TEXT PRIMARY KEY CHECK(id ~ '^[a-f0-9]{32}$'), provider TEXT NOT NULL CHECK(provider IN ('fountain','github')), api_base TEXT NOT NULL, UNIQUE(provider,api_base))`,
+	`CREATE TABLE collaboration_profiles(id TEXT PRIMARY KEY CHECK(id ~ '^[a-f0-9]{32}$'), name TEXT NOT NULL)`,
+	`CREATE TABLE collaboration_ledger(singleton BOOLEAN PRIMARY KEY CHECK(singleton), adopted BOOLEAN NOT NULL, fountain_host TEXT REFERENCES collaboration_hosts(id))`,
+	`CREATE TABLE collaboration_repositories(id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY CHECK(id>0), host TEXT NOT NULL REFERENCES collaboration_hosts(id), external_id TEXT NOT NULL CHECK(char_length(external_id) BETWEEN 1 AND 512), name TEXT NOT NULL, UNIQUE(host,external_id), UNIQUE(id,host))`,
+	`CREATE TABLE collaboration_actors(id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY CHECK(id>0), host TEXT NOT NULL REFERENCES collaboration_hosts(id), external_id TEXT NOT NULL CHECK(char_length(external_id) BETWEEN 1 AND 512), login TEXT NOT NULL, UNIQUE(host,external_id), UNIQUE(id,host))`,
+	collaborationTeamsDDL,
+	`CREATE TABLE collaboration_connections(id TEXT PRIMARY KEY CHECK(id ~ '^[a-f0-9]{32}$'), profile TEXT NOT NULL REFERENCES collaboration_profiles(id), host TEXT NOT NULL REFERENCES collaboration_hosts(id), actor BIGINT NOT NULL, FOREIGN KEY(actor,host) REFERENCES collaboration_actors(id,host), UNIQUE(id,host))`,
+	`CREATE TABLE collaboration_repository_connections(repository BIGINT NOT NULL, connection TEXT NOT NULL, host TEXT NOT NULL, PRIMARY KEY(repository,connection), FOREIGN KEY(repository,host) REFERENCES collaboration_repositories(id,host), FOREIGN KEY(connection,host) REFERENCES collaboration_connections(id,host))`,
+	`CREATE TABLE collaboration_runtimes(id TEXT PRIMARY KEY CHECK(id ~ '^[a-f0-9]{32}$'), profile TEXT NOT NULL REFERENCES collaboration_profiles(id), kind TEXT NOT NULL CHECK(kind IN ('native','appliance')), name TEXT NOT NULL)`,
+	`CREATE FUNCTION soda_collaboration_identity() RETURNS trigger LANGUAGE plpgsql AS $$
+DECLARE field TEXT;
+BEGIN
+ IF TG_OP='DELETE' THEN RAISE EXCEPTION 'collaboration identities retain history'; END IF;
+ FOREACH field IN ARRAY TG_ARGV LOOP
+  IF to_jsonb(NEW)->field IS DISTINCT FROM to_jsonb(OLD)->field THEN
+   RAISE EXCEPTION 'collaboration identity cannot be rebound';
+  END IF;
+ END LOOP;
+ RETURN NEW;
+END $$`,
+	`CREATE FUNCTION soda_collaboration_allocation() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+ IF NOT COALESCE((SELECT adopted FROM collaboration_ledger WHERE singleton FOR SHARE),false) THEN
+  RAISE EXCEPTION 'retained Fountain ledger is not adopted' USING ERRCODE='23514',CONSTRAINT='collaboration_ledger_unbound';
+ END IF;
+ RETURN NEW;
+END $$`,
+}
+
+var collaborationIdentityFields = map[string]string{
+	"hosts": "'id','provider'", "profiles": "'id'", "repositories": "'id','host','external_id'",
+	"actors": "'id','host','external_id'", "connections": "'id','profile','host','actor'",
+	"teams":    "'id','host','external_id'",
+	"runtimes": "'id','profile','kind'",
+}
+
+func initializeCollaborationSchema(ctx context.Context, db *sql.DB) error {
+	tx, err := db.BeginTx(ctx, nil)
+	if err != nil {
+		return err
+	}
+	defer tx.Rollback()
+	// The existing schema marker serializes additive initialization across
+	// processes, including a fresh profile opened by more than one component.
+	var version int
+	if err := tx.QueryRowContext(ctx, `SELECT version FROM schema_version FOR UPDATE`).Scan(&version); err != nil {
+		return err
+	}
+	var present bool
+	if err := tx.QueryRowContext(ctx, `SELECT to_regclass('public.collaboration_hosts') IS NOT NULL`).Scan(&present); err != nil {
+		return err
+	}
+	if !present {
+		for _, ddl := range collaborationDDL {
+			if _, err := tx.ExecContext(ctx, ddl); err != nil {
+				return fmt.Errorf("create collaboration registry: %w", err)
+			}
+		}
+		// Opening a Store never selects the namespace for historic numbers.
+		// Native composition explicitly initializes an empty ledger; retained
+		// Fountain composition must use the adoption producer in T01-LEDGER.
+		if _, err := tx.ExecContext(ctx, `INSERT INTO collaboration_ledger(singleton,adopted) VALUES(true,false)`); err != nil {
+			return err
+		}
+		for table, fields := range collaborationIdentityFields {
+			if _, err := tx.ExecContext(ctx, `CREATE TRIGGER collaboration_`+table+`_identity BEFORE UPDATE OR DELETE ON collaboration_`+table+` FOR EACH ROW EXECUTE FUNCTION soda_collaboration_identity(`+fields+`)`); err != nil {
+				return err
+			}
+		}
+		for _, table := range []string{"repositories", "actors", "teams"} {
+			if _, err := tx.ExecContext(ctx, `CREATE TRIGGER collaboration_`+table+`_allocation BEFORE INSERT ON collaboration_`+table+` FOR EACH ROW EXECUTE FUNCTION soda_collaboration_allocation()`); err != nil {
+				return err
+			}
+		}
+	}
+	// Existing registries predate canonical teams. Add this identity space under
+	// the same schema-marker lock without changing existing IDs or core workflow
+	// format. An existing but incomplete/unguarded table must fail verification.
+	if present {
+		var teams bool
+		if err := tx.QueryRowContext(ctx, `SELECT to_regclass('public.collaboration_teams') IS NOT NULL`).Scan(&teams); err != nil {
+			return err
+		}
+		if !teams {
+			for _, ddl := range []string{
+				collaborationTeamsDDL,
+				`CREATE TRIGGER collaboration_teams_identity BEFORE UPDATE OR DELETE ON collaboration_teams FOR EACH ROW EXECUTE FUNCTION soda_collaboration_identity('id','host','external_id')`,
+				`CREATE TRIGGER collaboration_teams_allocation BEFORE INSERT ON collaboration_teams FOR EACH ROW EXECUTE FUNCTION soda_collaboration_allocation()`,
+			} {
+				if _, err := tx.ExecContext(ctx, ddl); err != nil {
+					return fmt.Errorf("add collaboration team registry: %w", err)
+				}
+			}
+		}
+	}
+	if err := verifyCollaborationSchema(ctx, tx); err != nil {
+		return err
+	}
+	return tx.Commit()
+}
+
+func emptyCollaborationLedger(ctx context.Context, tx *sql.Tx) (bool, error) {
+	// The readiness budget is a seeded global scheduler counter, with no remote
+	// repository/actor identity. Its initial row is present even in an empty DB.
+	rows, err := tx.QueryContext(ctx, `SELECT tablename FROM pg_tables WHERE schemaname='public' AND tablename NOT IN ('schema_version','factory_readiness_budget') AND left(tablename,14)<>'collaboration_' ORDER BY tablename`)
+	if err != nil {
+		return false, err
+	}
+	var tables []string
+	for rows.Next() {
+		var name string
+		if err := rows.Scan(&name); err != nil {
+			rows.Close()
+			return false, err
+		}
+		tables = append(tables, name)
+	}
+	err = rows.Err()
+	rows.Close()
+	if err != nil {
+		return false, err
+	}
+	for _, table := range tables {
+		var present bool
+		if err := tx.QueryRowContext(ctx, `SELECT EXISTS(SELECT 1 FROM public."`+strings.ReplaceAll(table, `"`, `""`)+`" LIMIT 1)`).Scan(&present); err != nil {
+			return false, err
+		}
+		if present {
+			return false, nil
+		}
+	}
+	return true, nil
+}
+
+func verifyCollaborationSchema(ctx context.Context, tx *sql.Tx) error {
+	for _, query := range []string{
+		`SELECT id,provider,api_base FROM collaboration_hosts LIMIT 0`, `SELECT id,name FROM collaboration_profiles LIMIT 0`,
+		`SELECT id,host,external_id,name FROM collaboration_repositories LIMIT 0`, `SELECT id,host,external_id,login FROM collaboration_actors LIMIT 0`,
+		`SELECT id,host,external_id,name FROM collaboration_teams LIMIT 0`,
+		`SELECT id,profile,host,actor FROM collaboration_connections LIMIT 0`, `SELECT repository,connection,host FROM collaboration_repository_connections LIMIT 0`,
+		`SELECT id,profile,kind,name FROM collaboration_runtimes LIMIT 0`,
+	} {
+		rows, err := tx.QueryContext(ctx, query)
+		if err != nil {
+			return errors.New("collaboration registry is incomplete")
+		}
+		if err = rows.Close(); err != nil {
+			return err
+		}
+	}
+	var adopted bool
+	var host sql.NullString
+	if err := tx.QueryRowContext(ctx, `SELECT adopted,fountain_host FROM collaboration_ledger WHERE singleton`).Scan(&adopted, &host); err != nil {
+		return errors.New("collaboration ledger binding is absent")
+	}
+	for table := range collaborationIdentityFields {
+		if err := verifyCollaborationTrigger(ctx, tx, "collaboration_"+table+"_identity", "collaboration_"+table, "soda_collaboration_identity", 27); err != nil {
+			return err
+		}
+	}
+	for _, table := range []string{"repositories", "actors", "teams"} {
+		if err := verifyCollaborationTrigger(ctx, tx, "collaboration_"+table+"_allocation", "collaboration_"+table, "soda_collaboration_allocation", 7); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// pg_trigger has one row per trigger; information_schema.triggers has one row
+// per event and therefore counts an UPDATE OR DELETE guard twice.
+func verifyCollaborationTrigger(ctx context.Context, tx *sql.Tx, name, table, function string, events int) error {
+	var count int
+	if err := tx.QueryRowContext(ctx, `SELECT count(*) FROM pg_trigger t
+ JOIN pg_class c ON c.oid=t.tgrelid JOIN pg_namespace n ON n.oid=c.relnamespace
+ JOIN pg_proc p ON p.oid=t.tgfoid
+ WHERE n.nspname='public' AND c.relname=$1 AND t.tgname=$2 AND p.proname=$3
+ AND t.tgtype=$4 AND t.tgenabled IN ('O','A') AND NOT t.tgisinternal`, table, name, function, events).Scan(&count); err != nil {
+		return err
+	}
+	if count != 1 {
+		return errors.New("collaboration registry guard is absent or disabled")
+	}
+	return nil
+}
