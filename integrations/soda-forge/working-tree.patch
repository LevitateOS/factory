+	if _, err := apply(cancelled); !errors.Is(err, context.Canceled) {
+		t.Fatal("late custody cancellation saved", err)
+	}
+	cancelInCustody = nil
+	for _, missing := range []string{"store", "writer", "visibility", "custody"} {
+		unavailable := application
