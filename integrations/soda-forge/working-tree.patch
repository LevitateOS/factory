new file mode 100644
index 0000000000000000000000000000000000000000..bf1c4ce70ce3b340f2da9b3b73daeb9743088ad1
--- /dev/null
+++ b/internal/factory/runtime/README.md
@@ -0,0 +1,86 @@
+# Factory runtime boundaries
+
+`placement.go` owns retained runtime selection. Rust owns native process/storage
+lifetime; this package does not launch an OS process or grant execution authority.
+
+`LoadNative` consumes the private inputs produced by
+`NativePostgres.backend_config` in [desktop-runtime](../../../lib/desktop-runtime/README.md).
+Pass the absolute `backend.json` path in the owned profile. Its bounded, single
+JSON object contains only `profile_id`, matched to retained `profile.id`.
+The loader derives `backend.sock` in that same profile and reads `backend.dsn`
+and `backend.key`; it accepts no configured appliance URLs, operator IDs, broker
+paths or arbitrary external secret paths.
+
+On Linux, the profile must be canonical, owned and private. Inputs must be owned
+private regular files, opened without following symlinks and with bounded reads.
+The database input must select the profile's authenticated PostgreSQL Unix socket,
+factory user, postgres database and port 5432, without TLS or fallback targets.
+The IPC input is 32 random bytes encoded as 64 hex characters. Errors omit input
+contents; database/key values are not exported JSON fields and normal string
+formatting is redacted. `IPCKey` returns a private copy. These secrets never
+belong in a webview or logs.
+
+Loading performs no database connection, listener creation, account/provider
+enrollment, namespace adoption, coordinator ownership or work dispatch. Process
+composition must explicitly consume these inputs and supply current account and
+resource admission to shared services. Non-Linux native file admission currently
+refuses; macOS qualification remains deferred.
+
+`RunNative(ctx, path, connector)` owns the Go network/store lifetime from those inputs. It
+claims only `backend.lock` for one network process, opens the canonical store
+under a bounded cancellable startup context, and serves authenticated readiness
+on `backend.sock` (`0600`) with no TCP listener. Before serving, shared
+`Application.Recover` traverses all pages of owned pending assessments. Only proved
+released producers become unavailable, preserving their receipts without replay
+or invitation; live and unowned historical claims remain untouched. Store opening
+and recovery share the ten-second startup budget. A signal cancels actual schema
+or recovery SQL waits, and malformed/unknown recovery errors prevent readiness
+without exposing retained contents. It does not claim a coordinator ledger,
+reconcile unobserved runs or start work. `store.OpenContext` uses the same
+schema owner as `Open`; cancellation also ends actual SQL admission waits.
+
+Private IPC requires a current-user kernel peer and the exact per-start Bearer
+capability. Browser Origin/Fetch headers refuse. `GET /healthz` checks the live
+store and returns only readiness plus profile and process-instance IDs, with
+no-store; it makes no execution-readiness claim. The Rust bridge retains the
+capability and owns account/resource admission. The native application mounts
+shared product routes behind this private channel, independently of readiness.
+Without a current connector binding, those routes return unavailable; IPC
+capability never becomes a provider login or an empty successful feed/account.
+
+Native executable composition can supply a provider-owned handler for the fixed
+`/api/native/github/read` RPC. The existing peer/key gate additionally checks its
+captured process-instance header. The same coordinator admission/drain gate owns
+that request lifetime. Provider HTTP and token handling stay outside this runtime
+package; no provider SDK enters the engine/store closure. This read RPC does not
+install a product account resolver or turn process readiness into account access.
+
+`NewNativeApplication` constructs the same `service.Application` used by the
+appliance once. A trusted `NativeProductBinding` resolves current account and
+service ports on each request, receiving that same application/coordinator.
+The coordinator's existing HTTP admission gate encloses both binding and product
+handling. `StopAdmission` refuses before account lookup, and `Close` joins admitted
+bindings/handlers even if HTTP has already disconnected them. This lifetime gate
+does not require or start a background runtime, confer account permission or
+acquire a coordinator ledger lock.
+The returned product must use the owned store. Missing/error/mismatched bindings
+refuse without exposing account/provider error details. The binding must use
+current credential/connection truth and give resource callbacks the same bound
+account/generation; registered rows alone are not login evidence. No binding is
+decoded from browser JSON. Connector/account storage and actual login remain
+their later consumers; the executable currently has no configured resolver.
+
+Duplicate processes refuse before store startup. Stale socket removal requires
+exclusive profile use, an owned socket inode and confirmed connection refusal;
+live listeners, other resources and uncertain outcomes refuse. Shutdown removes
+only the inode it bound and preserves a replacement path. Parent cancellation or
+listener failure stops product admission, drains/closes HTTP, then joins admitted
+application work before closing the store and releasing network/profile ownership.
+Forced HTTP closure cannot release Store while a handler is still settling; its
+existing operation bounds remain in force.
+Neither application construction nor serving reads starts its coordinator or
+drives pending posts. Explicit startup recovery does not infer native execution
+facts or settle unobserved runs; those records remain unchanged until an admitted
+runtime supplies observation/retirement/custody ports. Rust still owns PostgreSQL and
+backend-child supervision, including preparing a
+new bootstrap capability before each managed start.
diff --git a/internal/factory/runtime/native_application.go b/internal/factory/runtime/native_application.go
new file mode 100644
index 0000000000000000000000000000000000000000..df4fd2ca91d1d6ca2f7609755b0153e02656e412
--- /dev/null
+++ b/internal/factory/runtime/native_application.go
@@ -0,0 +1,58 @@
+package runtime
+
+import (
+	"context"
+	"net/http"
+
+	factoryhttpapi "github.com/levitateos/sodaos/internal/factory/httpapi"
+	factoryservice "github.com/levitateos/sodaos/internal/factory/service"
+)
+
+// NativeProductBinding is a trusted account/connector port, not JSON admission.
+// It resolves current profile/account truth on each request and returns service
+// ports bound to that account. IPC capability alone never supplies an actor.
+type NativeProductBinding func(context.Context, factoryservice.Application) (factoryhttpapi.Product, error)
+
+type NativeApplication struct {
+	application factoryservice.Application
+	bind        NativeProductBinding
+	handler     http.Handler
+}
+
+// NewNativeApplication uses the same service owner as the appliance host.
+// Construction neither starts its coordinator nor drives/reconciles retained work.
+func NewNativeApplication(ports factoryservice.ApplicationPorts, bind NativeProductBinding) *NativeApplication {
+	a := &NativeApplication{application: factoryservice.NewApplication(ports), bind: bind}
+	// Binding can itself perform account/provider I/O. It belongs inside the
+	// same lifetime gate as product work, even before background runtime starts.
+	a.handler = a.application.Coordinator.AdmitHTTP(http.HandlerFunc(a.serveHTTP))
+	return a
+}
+
+func (a *NativeApplication) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	a.handler.ServeHTTP(w, r)
+}
+
+// Recover is explicit startup recovery over the canonical application/store.
+// It starts no coordinator, workflow, provider call or native execution.
+func (a *NativeApplication) Recover(ctx context.Context) error { return a.application.Recover(ctx) }
+
+// StopAdmission refuses new product work before the host retires its listeners.
+func (a *NativeApplication) StopAdmission() { a.application.StopAdmission() }
+
+// Close drains admitted bindings/product handlers before the host closes Store.
+// It does not close Store or start/reconcile the background runtime.
+func (a *NativeApplication) Close() error { return a.application.Close() }
+
+func (a *NativeApplication) serveHTTP(w http.ResponseWriter, r *http.Request) {
+	product := factoryhttpapi.Product{Store: a.application.Store}
+	if a.bind != nil && r.Context().Err() == nil {
+		bound, err := a.bind(r.Context(), a.application)
+		if err == nil && bound.Store == a.application.Store {
+			product = bound
+		}
+	}
+	// Missing/unknown account binding retains the canonical unavailable response
+	// from shared HTTP. It never becomes an empty successful account or feed.
+	product.Handler().ServeHTTP(w, r)
+}
diff --git a/internal/factory/runtime/native_config.go b/internal/factory/runtime/native_config.go
new file mode 100644
index 0000000000000000000000000000000000000000..25095f8dbfe82f262891201477c19747f978838a
--- /dev/null
+++ b/internal/factory/runtime/native_config.go
@@ -0,0 +1,76 @@
+package runtime
+
+import (
+	"bytes"
+	"encoding/hex"
+	"errors"
+	"path/filepath"
+	"strings"
+
+	"github.com/jackc/pgx/v5"
+	"github.com/levitateos/sodaos/internal/collaboration"
+	"github.com/levitateos/sodaos/internal/strictjson"
+)
+
+// NativeConfig consumes private inputs written by the owned Rust lifecycle.
+// It neither provisions storage nor admits an account, repository or runtime.
+// Secrets are private process inputs, never webview state or log fields.
+type NativeConfig struct {
+	Profile   collaboration.ProfileID
+	Directory string
+	Socket    string
+	dsn       string
+	ipcKey    []byte
+}
+
+func (c NativeConfig) DatabaseDSN() string { return c.dsn }
+func (c NativeConfig) IPCKey() []byte      { return bytes.Clone(c.ipcKey) }
+func (c NativeConfig) String() string      { return "Factory native bootstrap" }
+
+// LoadNative validates the fixed private profile layout. Parsing never opens a
+// database/listener, registers a provider or claims a coordinator ledger.
+func LoadNative(path string) (NativeConfig, error) {
+	var empty NativeConfig
+	if !filepath.IsAbs(path) || filepath.Clean(path) != path || filepath.Base(path) != "backend.json" {
+		return empty, errors.New("native bootstrap requires its absolute profile configuration path")
+	}
+	root := filepath.Dir(path)
+	if err := nativePrivateDirectory(root); err != nil {
+		return empty, err
+	}
+	raw, err := nativePrivateInput(path, 65536)
+	if err != nil {
+		return empty, err
+	}
+	var manifest struct {
+		Profile collaboration.ProfileID `json:"profile_id"`
+	}
+	if strictjson.Decode(bytes.NewReader(raw), &manifest) != nil || !collaboration.ValidID(string(manifest.Profile)) {
+		return empty, errors.New("native bootstrap configuration is invalid")
+	}
+	identity, err := nativePrivateInput(filepath.Join(root, "profile.id"), 32)
+	if err != nil || string(identity) != string(manifest.Profile) {
+		return empty, errors.New("native bootstrap profile identity differs from its owned profile")
+	}
+	rawDSN, err := nativePrivateInput(filepath.Join(root, "backend.dsn"), 65536)
+	if err != nil {
+		return empty, err
+	}
+	dsn := string(rawDSN)
+	if dsn == "" || strings.ContainsAny(dsn, "\r\n\x00") {
+		return empty, errors.New("native database input is invalid")
+	}
+	database, err := pgx.ParseConfig(dsn)
+	if err != nil || database.Host != filepath.Join(root, "socket") || database.Port != 5432 || database.User != "factory" || database.Password == "" || database.Database != "postgres" || database.TLSConfig != nil || len(database.Fallbacks) != 0 {
+		return empty, errors.New("native database must use the owned profile's authenticated Unix socket")
+	}
+	rawKey, err := nativePrivateInput(filepath.Join(root, "backend.key"), 64)
+	if err != nil {
+		return empty, err
+	}
+	key, err := hex.DecodeString(string(rawKey))
+	if err != nil || len(rawKey) != 64 || len(key) != 32 {
+		return empty, errors.New("native IPC capability input is invalid")
+	}
+	return NativeConfig{Profile: manifest.Profile, Directory: root, Socket: filepath.Join(root, "backend.sock"), dsn: dsn, ipcKey: key}, nil
+}
diff --git a/internal/factory/runtime/native_config_linux.go b/internal/factory/runtime/native_config_linux.go
new file mode 100644
index 0000000000000000000000000000000000000000..96ca493e75c382d03061d172957824abe7c8470c
--- /dev/null
+++ b/internal/factory/runtime/native_config_linux.go
@@ -0,0 +1,46 @@
+package runtime
+
+import (
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+	"syscall"
+)
+
+func nativePrivateDirectory(path string) error {
+	info, err := os.Lstat(path)
+	if err != nil || !info.IsDir() || info.Mode().Perm()&0o077 != 0 {
+		return errors.New("native bootstrap directory must be owned and private")
+	}
+	stat, ok := info.Sys().(*syscall.Stat_t)
+	if !ok || stat.Uid != uint32(os.Geteuid()) {
+		return errors.New("native bootstrap directory must belong to the current user")
+	}
+	resolved, err := filepath.EvalSymlinks(path)
+	if err != nil || resolved != path {
+		return errors.New("native bootstrap directory cannot use symlink components")
+	}
+	return nil
+}
+
+func nativePrivateInput(path string, limit int64) ([]byte, error) {
+	f, err := os.OpenFile(path, os.O_RDONLY|syscall.O_NOFOLLOW|syscall.O_NONBLOCK, 0)
+	if err != nil {
+		return nil, errors.New("cannot open private native bootstrap input")
+	}
+	defer f.Close()
+	info, err := f.Stat()
+	if err != nil || !info.Mode().IsRegular() || info.Mode().Perm()&0o077 != 0 {
+		return nil, errors.New("native bootstrap input must be an owned private regular file")
+	}
+	stat, ok := info.Sys().(*syscall.Stat_t)
+	if !ok || stat.Uid != uint32(os.Geteuid()) {
+		return nil, errors.New("native bootstrap input must belong to the current user")
+	}
+	raw, err := io.ReadAll(io.LimitReader(f, limit+1))
+	if err != nil || int64(len(raw)) > limit {
+		return nil, errors.New("native bootstrap input exceeds its bound or cannot be read")
+	}
+	return raw, nil
+}
