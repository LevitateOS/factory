+customElements.define('soda-factory-direction-revision', SodaFactoryDirectionRevision);
+
+async function readDirectionRevision(
+  context: DirectionRevisionContext,
+  signal: AbortSignal
+): Promise<{revision?: IntentRevision; state: SourceState}> {
