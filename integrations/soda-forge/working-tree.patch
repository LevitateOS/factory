@@ -0,0 +1,227 @@
+package collaboration
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+)
+
+// OperationKind names a semantic effect, not an HTTP endpoint. Support is
+// discovered at admission; a known spelling does not imply provider support.
+type OperationKind string
+
+const (
+	MutateGraph          OperationKind = "issue.graph.mutate"
+	PublishRef           OperationKind = "git.ref.publish"
+	OpenPull             OperationKind = "pull_request.create"
+	SubmitReview         OperationKind = "pull_request.review.submit"
+	CreateReviewComment  OperationKind = "pull_request.review.comment.create"
+	ResolveReviewThread  OperationKind = "pull_request.review.thread.resolve"
+	Merge                OperationKind = "pull_request.merge"
+	ApplyIssueLifecycle  OperationKind = "issue.lifecycle.apply"
+	RequestReview        OperationKind = "pull_request.review.request"
+	PublishComment       OperationKind = "issue.comment.publish"
+	CreateComment        OperationKind = "discussion.comment.create"
+	EditDiscussion       OperationKind = "discussion.edit"
+	OpenIssue            OperationKind = "issue.create"
+	ApplyDiscussionLock  OperationKind = "discussion.lock.apply"
+	ApplyDiscussionState OperationKind = "discussion.state.apply"
+)
+
+type Atomicity string
+
+const (
+	Atomic  Atomicity = "atomic"
+	Ordered Atomicity = "ordered"
+)
+
+// MutationConditions are REQUIRED guarantees, not best-effort read checks.
+// Adapters refuse unsupported guards before sending effects. In particular,
+// reading a head and then calling an unguarded write is not a conditional write.
+// AuthorizationRevision refers to the application's admitted authority; it is
+// not a token, browser capability, execution grant or standing spending policy.
+type MutationConditions struct {
+	AuthorizationRevision string              `json:"authorization_revision"`
+	RepositoryRevision    *Revision           `json:"repository_revision"`
+	Resources             []ResourceCondition `json:"resources"`
+	NotAfter              int64               `json:"not_after"` // Unix seconds; checked afresh at dispatch
+}
+
+type ResourceCondition struct {
+	Kind       string    `json:"kind"`        // issue, pull, ref, thread
+	ExternalID string    `json:"external_id"` // opaque resource ID or exact ref name
+	Revision   *Revision `json:"revision"`
+	Exists     *bool     `json:"exists"`
+	Head       *CommitID `json:"head"`
+	Base       *CommitID `json:"base"`
+}
+
+// OperationIntent is persisted by the existing owning journal BEFORE dispatch.
+// IDs and payload never change on retry. Connection selection and credentials
+// remain outside intent identity. Payload is the bounded, typed kind-specific
+// semantic JSON, not an arbitrary provider request or browser-controlled URL.
+// Atomicity is required: ordered effects must never satisfy an atomic intent.
+// Authority pins the adapter's operation namespace (Fountain installation, or
+// the local effect journal for a provider without remote operation receipts).
+// It is neither repository identity nor evidence of remote atomicity.
+type OperationIntent struct {
+	OperationID string             `json:"operation_id"`
+	Authority   string             `json:"authority"`
+	Host        HostID             `json:"host"`
+	Repository  RepositoryID       `json:"repository,string"`
+	Actor       ActorID            `json:"actor,string"`
+	Kind        OperationKind      `json:"kind"`
+	Atomicity   Atomicity          `json:"atomicity"`
+	Conditions  MutationConditions `json:"conditions"`
+	Payload     json.RawMessage    `json:"payload"`
+}
+
+// OperationBinding is the immutable identity echoed by an admitted outcome.
+// IntentDigest is the owning application's captured digest. A provider's digest
+// over its translated envelope is separate and MUST NOT replace it.
+type OperationBinding struct {
+	Repository   RepositoryID  `json:"repository,string"`
+	Actor        ActorID       `json:"actor,string"`
+	Kind         OperationKind `json:"kind"`
+	Atomicity    Atomicity     `json:"atomicity"`
+	IntentDigest string        `json:"intent_digest"`
+}
+
+type (
+	EffectState       string
+	CancellationState string
+	CompletionState   string
+)
+
+const (
+	EffectPending               EffectState       = "pending"
+	EffectNotCommitted          EffectState       = "not_committed"
+	EffectCommitted             EffectState       = "committed"
+	EffectIndeterminate         EffectState       = "indeterminate"
+	EffectPartial               EffectState       = "partial"
+	CancellationNone            CancellationState = "none"
+	CancellationPending         CancellationState = "pending"
+	CancellationCancelled       CancellationState = "cancelled"
+	CancellationTooLate         CancellationState = "too_late"
+	CancellationIndeterminate   CancellationState = "indeterminate"
+	CompletionPending           CompletionState   = "pending"
+	CompletionComplete          CompletionState   = "complete"
+	CompletionNeedsIntervention CompletionState   = "needs_intervention"
+)
+
+// ProviderReceipt retains original provider evidence, not a synthesized success.
+// Authority binds the provider installation/receipt namespace; Reference is its
+// operation or request identity. Raw receipt bytes stay server-side and must be
+// credential-free. Markers/search/readback are observations, not durable receipts
+// of an attributable write. Translators retain them separately as observations.
+type ProviderReceipt struct {
+	Authority    string          `json:"authority"`
+	Reference    string          `json:"reference"`
+	IntentDigest string          `json:"intent_digest"`
+	Payload      json.RawMessage `json:"payload"`
+}
+
+// EffectCheckpoint is a stable, preassigned step in an ordered plan (e.g. issue
+// creation, branch publication, PR creation). Save each outcome before advancing.
+// Partial is only an aggregate state; an individual step stays unresolved if its
+// response was lost. Observed objects do not establish causal write ownership.
+type EffectCheckpoint struct {
+	ID      string           `json:"id"`
+	Effect  EffectState      `json:"effect"`
+	Reason  string           `json:"reason"`
+	Receipt *ProviderReceipt `json:"receipt"`
+}
+
+// OperationRecord is data stored within existing Factory journals, not a second
+// journal. Binding is nil only for a pre-submit cancellation tombstone; never
+// fabricate actor/repository/kind/digest fields when the provider did not know
+// them. Cancellation cannot erase already committed or uncertain effects.
+type OperationRecord struct {
+	Host         HostID             `json:"host"`
+	Authority    string             `json:"authority"`
+	OperationID  string             `json:"operation_id"`
+	Binding      *OperationBinding  `json:"binding"`
+	Effect       EffectState        `json:"effect"`
+	Cancellation CancellationState  `json:"cancellation"`
+	Completion   CompletionState    `json:"completion"`
+	Reason       string             `json:"reason"`
+	Receipt      *ProviderReceipt   `json:"receipt"`
+	Checkpoints  []EffectCheckpoint `json:"checkpoints"`
+}
+
+type LookupState string
+
+const (
+	LookupFound       LookupState = "found"
+	LookupNotObserved LookupState = "not_observed"
+	LookupUnavailable LookupState = "unavailable"
+	LookupUnknown     LookupState = "unknown"
+)
+
+// NotObserved is an observation, never proof that an earlier request cannot
+// arrive or that resubmitting a non-idempotent write is safe. Unavailable differs
+// from absent. No retry authorization can be derived from these fields alone.
+type OperationLookup struct {
+	Authority   string           `json:"authority"`
+	Host        HostID           `json:"host"`
+	OperationID string           `json:"operation_id"`
+	State       LookupState      `json:"state"`
+	Record      *OperationRecord `json:"record"`
+	Reason      string           `json:"reason"`
+}
+
+var ErrInvalidEffect = errors.New("invalid collaboration effect contract")
+
+// Validate checks shape and internal consistency, not permission, freshness,
+// receipt authenticity, kind-specific payload semantics or retry eligibility.
+func (i OperationIntent) Validate() error {
+	if !validOperationScope(i.Host, i.Authority, i.OperationID) || i.Repository <= 0 || i.Actor <= 0 ||
+		!ValidText(string(i.Kind), 128) || !validAtomicity(i.Atomicity) ||
+		!ValidText(i.Conditions.AuthorizationRevision, 256) || i.Conditions.NotAfter <= 0 ||
+		!validOptionalRevision(i.Conditions.RepositoryRevision) || len(i.Conditions.Resources) > 64 ||
+		!validEffectJSON(i.Payload, 48<<10) {
+		return ErrInvalidEffect
+	}
+	seen := map[string]bool{}
+	for _, c := range i.Conditions.Resources {
+		key := c.Kind + "\x00" + c.ExternalID
+		if (c.Kind != "issue" && c.Kind != "pull" && c.Kind != "ref" && c.Kind != "thread") ||
+			!ValidText(c.ExternalID, 1024) || seen[key] || !validOptionalRevision(c.Revision) ||
+			(c.Revision == nil && c.Exists == nil && c.Head == nil && c.Base == nil) ||
+			(c.Head != nil && !ValidCommitID(*c.Head)) || (c.Base != nil && !ValidCommitID(*c.Base)) {
+			return ErrInvalidEffect
+		}
+		seen[key] = true
+	}
+	return nil
+}
+
+func validOperationScope(host HostID, authority, operation string) bool {
+	return ValidID(string(host)) && ValidText(authority, 256) && ValidText(operation, 256)
+}
+
+func validAtomicity(a Atomicity) bool { return a == Atomic || a == Ordered }
+
+func validOptionalRevision(r *Revision) bool { return r == nil || ValidText(string(*r), 256) }
+
+func validEffectJSON(raw json.RawMessage, limit int) bool {
+	trimmed := bytes.TrimSpace(raw)
+	return len(raw) <= limit && len(trimmed) > 1 && trimmed[0] == '{' && json.Valid(trimmed)
+}
+
+// ValidCommitID accepts a full lowercase SHA-1 or SHA-256 Git object identity.
+func ValidCommitID(c CommitID) bool {
+	return (len(c) == 40 || len(c) == 64) && lowercaseHex(string(c))
+}
+
+func lowercaseHex(s string) bool {
+	if s == "" {
+		return false
+	}
+	for _, c := range s {
+		if !(c >= '0' && c <= '9' || c >= 'a' && c <= 'f') {
+			return false
+		}
+	}
+	return true
+}
diff --git a/internal/collaboration/effects.md b/internal/collaboration/effects.md
new file mode 100644
index 0000000000000000000000000000000000000000..4baae5540705f0186c0ab60d1a8f2ed7cf8d1792
--- /dev/null
+++ b/internal/collaboration/effects.md
@@ -0,0 +1,130 @@
+# Operation and graph contracts
+
+`effects.go`, `effect_outcomes.go`, `graph.go` and `graph_receipt.go` define the
+server-side effect handoff. They import no provider SDK, host implementation,
+HTTP session or credential package. They create no journal and expose no provider
+receipts to the Lit client. Existing Factory journals retain persistence ownership.
+
+## Intent and conditional writes
+
+`OperationIntent` captures the host, adapter operation namespace, operation ID,
+local repository/actor, semantic kind, required atomicity, conditions and bounded
+semantic JSON. Persist the exact intent before dispatch. Credentials and connection
+selection stay outside it. Reconnection cannot rewrite its actor or scope.
+
+`Authority` retains the operation namespace alongside HostID: Fountain's admitted
+installation identity, or the local effect journal for a provider without remote
+operation receipts. It remains on lookups and pre-submit cancellation tombstones.
+A replacement installation cannot answer an older operation merely because its
+configured host locator is the same. A local namespace implies no remote guarantee.
+
+Conditions retain the admitted authorization revision, optional repository
+revision, exact resource revision/existence/head/base requirements and deadline.
+They are required guarantees. Refuse a guard the adapter cannot enforce: a read
+followed by an unguarded write does not implement compare-and-swap. Authorization
+and deadline require fresh dispatch checks. These records grant no execution,
+spending or automation. Common validation checks shape, not permission or freshness;
+kind-specific validation/admission remains mandatory. Graph payloads additionally
+require `GraphIntent.Validate`.
+
+`atomic` requires all changes to commit together. `ordered` permits individual
+effects and partial results. An ordered result cannot satisfy an atomic intent.
+Fountain's existing atomic graph must retain its guarantee. GitHub's separate
+writes cannot impersonate it.
+
+## Outcomes and recovery
+
+Effect, cancellation and completion remain separate. A committed effect may still
+await application adoption. Cancellation does not reverse a committed write.
+An unbound pre-submit tombstone has no invented actor/repository/kind/digest and
+cannot pass submitted-intent binding validation.
+
+| Effect | Meaning |
+| --- | --- |
+| `pending` | No settled outcome yet; processing may still be in progress. |
+| `not_committed` | An attributable outcome establishes that this effect did not commit. |
+| `committed` | An attributable outcome establishes that this effect committed. |
+| `indeterminate` | The effect may have committed; its outcome is unresolved. |
+| `partial` | Some ordered steps committed; another step has a different outcome. |
+
+Assign stable checkpoint IDs before sending and save each result before advancing.
+A lost response stays indeterminate. Aggregate validation checks all steps:
+committed plus pending/refused/uncertain steps is partial. Pending, partial and
+indeterminate effects cannot report completed work. Atomic results cannot be partial.
+
+Lookup distinguishes found, not observed, unavailable and unknown, binding host,
+authority and operation ID. Absence does not prove an earlier request cannot arrive
+or that a non-idempotent write is safe to resubmit. Unavailability must not become
+an invented committed record. No helper here authorizes retries.
+
+`ProviderReceipt` retains the provider namespace, reference, translated-envelope
+digest and credential-free receipt JSON. Search, markers and ordinary readback are
+observations, not durable receipts of an attributable write. Do not fabricate one
+for GitHub. A local outcome can have no remote receipt; its owning adapter/journal
+must establish the classification with actual evidence. Validation checks
+consistency, not authenticity or journal transitions.
+
+Keep three digest roles separate:
+
+- Existing `factory.IntentGeneration.IntentDigest` binds the accepted product
+  revision through `IntentRevision.Digest`; its store guard is unchanged.
+- `OperationBinding.IntentDigest` binds captured application operation inputs.
+  The owner supplies the expected digest to `ValidateAgainst`.
+- `ProviderReceipt.IntentDigest` retains the provider's translated-envelope digest.
+
+The journal still checks immutable bindings and its existing transaction/CAS
+guards before saving an observation. These definitions implement no dispatcher,
+checkpoint transition policy or replay controller.
+
+## Graphs and receipts
+
+Creates use request-local keys. Existing issues use neutral `IssueRef` records
+with opaque external IDs, repository, issue discriminator and display number.
+Edits retain exact expected title/body/content revision. Fountain's content version
+zero becomes explicit opaque revision `"0"`.
+
+Dependencies retain direction and exact add/remove preconditions. A ref selects
+one existing issue or one new key. Validation rejects ambiguous/cross-repository/
+inconsistent refs, duplicate edits/edges, self edges and removals involving new
+keys. Bounds retain the current Factory's 64 changes, 255-byte titles, 64-KiB
+bodies and 48-KiB payload. This is not a cycle check against the remote graph.
+
+`GraphReceipt.ValidateAgainst` binds repository/actor, every created key and edited
+issue, explicit content revisions and every changed edge to the saved graph. It
+rejects missing/duplicate results, wrong identities and new IDs that alias existing
+refs. Untouched/delivered history has no receipt entry. The engine still checks
+current accepted scope, delivered-binding provenance and fresh issue observations
+before adoption.
+
+## Evidence and handoff
+
+T01-EFFECTS passed Go compilation and the source guard. An external diagnostic
+used the actual checked-out Fountain SDK validator and JSON types, retaining exact
+edit text and zero content version and translating a graph receipt into neutral
+records. It exercised receipt binding, ambiguous refs, atomic/ordered separation,
+partial/uncertain effects, cancellation tombstones, lookup scope and string IDs
+above `2^53`.
+
+The same diagnostic used existing `Store.SaveIntentRevision`,
+`BeginIntentGeneration`, `RecordIntentGeneration` and `IntentGeneration` APIs on
+private native PostgreSQL. It retained a neutral envelope/checkpoints in their
+JSON fields, kept the legacy generation pending for partial effects, rejected a
+changed immutable actor and reopened the store. Clean native restart, checkpoint
+update, forced-crash/WAL recovery and final shutdown passed. The first attempt
+correctly hit the accepted-product-digest guard; the diagnostic was fixed to supply
+that digest separately. No production guard was weakened.
+
+Logs: `/home/vince/factory-effect-contract-go.log`,
+`/home/vince/factory-effect-contract-source-guard.log` and
+`/home/vince/factory-effect-native-journal-final.log`. Diagnostic:
+`/home/vince/factory-effect-probe/`. Retained disposable profile:
+`/home/vince/fpg-effects-final-20261031`. No unit tests were added.
+
+This proves contract/SDK serialization and existing-store retention, not provider
+writes, engine replay or connected journeys. The running coordinator still uses
+its current SDK contracts. T02 owns actual Fountain translation and engine/store
+cutover, native/local ID mapping and preservation of admission/adoption/state
+guards. T10/T11 own real mutations, per-step persistence/reconciliation and supported
+retry semantics. The [T01-RUNTIME producer](../factory/access/README.md) now
+defines admission, native/appliance provenance, placement and policy contracts;
+their production consumers still require the named later slices.
diff --git a/internal/collaboration/graph.go b/internal/collaboration/graph.go
new file mode 100644
index 0000000000000000000000000000000000000000..ed0ddae6dc0d8e76a181365ea591c053871adeee
--- /dev/null
+++ b/internal/collaboration/graph.go
@@ -0,0 +1,180 @@
+package collaboration
+
+import (
+	"encoding/json"
+	"errors"
+	"strings"
+	"unicode/utf8"
+)
+
+// GraphIntent is the semantic payload of MutateGraph. Repository, actor,
+// authority, deadline and required atomicity belong to OperationIntent. No
+// provider-native authorization envelope enters this payload. Unsupported graph
+// edits/edges/atomicity must be refused, never simulated with weaker writes.
+type GraphIntent struct {
+	Creates      []GraphCreate     `json:"creates"`
+	Edits        []GraphEdit       `json:"edits"`
+	Dependencies []GraphDependency `json:"dependencies"`
+}
+
+type GraphCreate struct {
+	Key   string `json:"key"`
+	Title string `json:"title"`
+	Body  string `json:"body"`
+}
+
+type IssueContent struct {
+	Title    string   `json:"title"`
+	Body     string   `json:"body"`
+	Revision Revision `json:"revision"`
+}
+
+type GraphEdit struct {
+	Issue    IssueRef     `json:"issue"`
+	Expected IssueContent `json:"expected"`
+	Title    string       `json:"title"`
+	Body     string       `json:"body"`
+}
+
+// GraphRef selects exactly one existing issue or request-local creation key.
+type GraphRef struct {
+	Issue *IssueRef `json:"issue"`
+	Key   string    `json:"key"`
+}
+
+// Adds require edge absence; removes require presence. Removing an edge involving
+// a request-local creation is invalid. Direction: Issue depends on Prerequisite.
+type GraphDependency struct {
+	Issue        GraphRef `json:"issue"`
+	Prerequisite GraphRef `json:"prerequisite"`
+	Remove       bool     `json:"remove"`
+}
+
+// GraphReceipt maps request keys and edited issues to provider identities.
+// Untouched/delivered issues have no entry. Content revisions are opaque and
+// retain provider zero versions explicitly (e.g. "0"), never invented increments.
+type GraphReceipt struct {
+	Repository   RepositoryID             `json:"repository,string"`
+	Actor        ActorID                  `json:"actor,string"`
+	Issues       []GraphIssueReceipt      `json:"issues"`
+	Dependencies []GraphDependencyReceipt `json:"dependencies"`
+}
+
+type GraphIssueReceipt struct {
+	Key             string   `json:"key"`
+	Issue           IssueRef `json:"issue"`
+	ContentRevision Revision `json:"content_revision"`
+}
+
+type GraphDependencyReceipt struct {
+	Issue        IssueRef `json:"issue"`
+	Prerequisite IssueRef `json:"prerequisite"`
+	Removed      bool     `json:"removed"`
+}
+
+var ErrInvalidGraph = errors.New("invalid collaboration graph contract")
+
+// Validate applies the current Factory graph bounds and repository scope. It
+// does not admit the actor, validate acyclicity against a remote graph, or claim
+// the provider can implement the requested transaction and conditional writes.
+func (g GraphIntent) Validate(repository RepositoryID) error {
+	if err := g.ValidateShape(repository); err != nil {
+		return err
+	}
+	raw, err := json.Marshal(g)
+	if err != nil || len(raw) > 48<<10 {
+		return ErrInvalidGraph
+	}
+	return nil
+}
+
+// ValidateShape checks semantic scope, references and text bounds. Adapters
+// use it before enforcing the byte bound on their actual provider encoding;
+// expanded neutral references must not reduce an existing provider wire limit.
+func (g GraphIntent) ValidateShape(repository RepositoryID) error {
+	n := len(g.Creates) + len(g.Edits) + len(g.Dependencies)
+	if repository <= 0 || n == 0 || n > 64 {
+		return ErrInvalidGraph
+	}
+	keys := map[string]bool{}
+	for _, c := range g.Creates {
+		if !validGraphKey(c.Key) || keys[c.Key] || !validIssueText(c.Title, c.Body) {
+			return ErrInvalidGraph
+		}
+		keys[c.Key] = true
+	}
+	edits := map[string]bool{}
+	refs := map[string]IssueRef{}
+	numbers := map[int64]string{}
+	observe := func(i IssueRef) bool {
+		if !validGraphIssue(i, repository) {
+			return false
+		}
+		if previous, ok := refs[i.ExternalID]; ok && previous != i {
+			return false
+		}
+		if previous, ok := numbers[i.Number]; ok && previous != i.ExternalID {
+			return false
+		}
+		refs[i.ExternalID], numbers[i.Number] = i, i.ExternalID
+		return true
+	}
+	for _, e := range g.Edits {
+		if !observe(e.Issue) || edits[e.Issue.ExternalID] ||
+			!ValidText(string(e.Expected.Revision), 256) || !validIssueText(e.Title, e.Body) ||
+			!validStoredIssueText(e.Expected.Title, e.Expected.Body) {
+			return ErrInvalidGraph
+		}
+		edits[e.Issue.ExternalID] = true
+	}
+	edges := map[string]bool{}
+	for _, e := range g.Dependencies {
+		if (e.Issue.Issue != nil && !observe(*e.Issue.Issue)) ||
+			(e.Prerequisite.Issue != nil && !observe(*e.Prerequisite.Issue)) {
+			return ErrInvalidGraph
+		}
+		a, b := graphRefKey(e.Issue, repository, keys), graphRefKey(e.Prerequisite, repository, keys)
+		edge := a + "\x00" + b
+		if a == "" || b == "" || a == b || edges[edge] ||
+			(e.Remove && (e.Issue.Key != "" || e.Prerequisite.Key != "")) {
+			return ErrInvalidGraph
+		}
+		edges[edge] = true
+	}
+	return nil
+}
+
+func graphRefKey(r GraphRef, repository RepositoryID, keys map[string]bool) string {
+	if r.Issue != nil && r.Key == "" && validGraphIssue(*r.Issue, repository) {
+		return "id:" + r.Issue.ExternalID
+	}
+	if r.Issue == nil && keys[r.Key] {
+		return "key:" + r.Key
+	}
+	return ""
+}
+
+func validGraphIssue(i IssueRef, repository RepositoryID) bool {
+	return i.Kind == SubjectIssue && i.Repository == repository && i.Number > 0 && ValidText(i.ExternalID, 1024)
+}
+
+func validGraphKey(s string) bool {
+	if s == "" || len(s) > 64 {
+		return false
+	}
+	for _, c := range s {
+		if !(c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '-' || c == '_') {
+			return false
+		}
+	}
+	return true
+}
+
+func validStoredIssueText(title, body string) bool {
+	return len(title) <= 255 && len(body) <= 64<<10 && utf8.ValidString(title) && utf8.ValidString(body) &&
+		!strings.ContainsRune(title, 0) && !strings.ContainsRune(body, 0)
+}
+
+func validIssueText(title, body string) bool {
+	return title != "" && strings.TrimSpace(title) == title && validStoredIssueText(title, body)
+}
diff --git a/internal/collaboration/graph_receipt.go b/internal/collaboration/graph_receipt.go
new file mode 100644
index 0000000000000000000000000000000000000000..40d73336f7818a6f05cd0228fbe49ee077642a18
--- /dev/null
+++ b/internal/collaboration/graph_receipt.go
@@ -0,0 +1,79 @@
+package collaboration
+
+// ValidateAgainst checks a translated, committed graph receipt against the
+// exact saved intent. It is not proof of provider authenticity or adoption into
+// a task acceptance: the owning engine must still check current accepted scope,
+// delivered bindings and fresh native issue observations before adoption.
+func (r GraphReceipt) ValidateAgainst(g GraphIntent, repository RepositoryID, actor ActorID) error {
+	if g.Validate(repository) != nil || actor <= 0 || r.Actor != actor || r.Repository != repository ||
+		len(r.Issues) != len(g.Creates)+len(g.Edits) || len(r.Dependencies) != len(g.Dependencies) {
+		return ErrInvalidGraph
+	}
+	creates := map[string]bool{}
+	for _, c := range g.Creates {
+		creates[c.Key] = true
+	}
+	edits := map[string]IssueRef{}
+	existing := map[string]bool{}
+	existingNumbers := map[int64]bool{}
+	observe := func(i IssueRef) { existing[i.ExternalID], existingNumbers[i.Number] = true, true }
+	for _, e := range g.Edits {
+		edits[e.Issue.ExternalID] = e.Issue
+		observe(e.Issue)
+	}
+	for _, d := range g.Dependencies {
+		if d.Issue.Issue != nil {
+			observe(*d.Issue.Issue)
+		}
+		if d.Prerequisite.Issue != nil {
+			observe(*d.Prerequisite.Issue)
+		}
+	}
+	created := map[string]IssueRef{}
+	seen := map[string]bool{}
+	numbers := map[int64]bool{}
+	for _, i := range r.Issues {
+		if !validGraphIssue(i.Issue, repository) || !ValidText(string(i.ContentRevision), 256) ||
+			seen[i.Issue.ExternalID] || numbers[i.Issue.Number] {
+			return ErrInvalidGraph
+		}
+		seen[i.Issue.ExternalID], numbers[i.Issue.Number] = true, true
+		if i.Key != "" {
+			if !creates[i.Key] || created[i.Key].ExternalID != "" || existing[i.Issue.ExternalID] || existingNumbers[i.Issue.Number] {
+				return ErrInvalidGraph
+			}
+			created[i.Key] = i.Issue
+		} else if edits[i.Issue.ExternalID] != i.Issue {
+			return ErrInvalidGraph
+		}
+	}
+	if len(created) != len(creates) {
+		return ErrInvalidGraph
+	}
+	expected := map[[2]string]bool{}
+	resolve := func(ref GraphRef) IssueRef {
+		if ref.Issue != nil {
+			return *ref.Issue
+		}
+		return created[ref.Key]
+	}
+	refs := map[string]IssueRef{}
+	for _, d := range g.Dependencies {
+		a, b := resolve(d.Issue), resolve(d.Prerequisite)
+		expected[[2]string{a.ExternalID, b.ExternalID}] = d.Remove
+		refs[a.ExternalID], refs[b.ExternalID] = a, b
+	}
+	for _, d := range r.Dependencies {
+		key := [2]string{d.Issue.ExternalID, d.Prerequisite.ExternalID}
+		removed, ok := expected[key]
+		if !ok || removed != d.Removed || d.Issue != refs[d.Issue.ExternalID] ||
+			d.Prerequisite != refs[d.Prerequisite.ExternalID] {
+			return ErrInvalidGraph
+		}
+		delete(expected, key)
+	}
+	if len(expected) != 0 {
+		return ErrInvalidGraph
+	}
+	return nil
+}
diff --git a/internal/collaboration/identity.go b/internal/collaboration/identity.go
new file mode 100644
index 0000000000000000000000000000000000000000..134e9900c9f3363ad10cb11d7d9764de2ca927f3
--- /dev/null
+++ b/internal/collaboration/identity.go
@@ -0,0 +1,146 @@
+// Package collaboration owns provider-neutral collaboration records. An identity
+// observation is not a permission, execution grant or credential.
+package collaboration
+
+import (
+	"crypto/rand"
+	"encoding/hex"
+	"errors"
+	"net"
+	"net/url"
+	"strconv"
+	"strings"
+	"unicode"
+	"unicode/utf8"
+)
+
+type HostID string
+type ProfileID string
+type RuntimeID string
+type ConnectionID string
+type RepositoryID int64
+type ActorID int64
+type TeamID int64
+type Provider string
+type RuntimeKind string
+
+const (
+	Fountain  Provider    = "fountain"
+	GitHub    Provider    = "github"
+	Native    RuntimeKind = "native"
+	Appliance RuntimeKind = "appliance"
+)
+
+var (
+	ErrIdentityConflict = errors.New("collaboration identity cannot be rebound")
+	ErrUnboundLedger    = errors.New("retained Fountain ledger must be adopted before identity allocation")
+)
+
+type Host struct {
+	ID       HostID   `json:"id"`
+	Provider Provider `json:"provider"`
+	APIBase  string   `json:"api_base"`
+}
+
+type Profile struct {
+	ID   ProfileID `json:"id"`
+	Name string    `json:"name"`
+}
+
+// ID is a local ledger surrogate; ExternalID is opaque and scoped to Host.
+// Name is presentation metadata, never an identity key.
+type RepositoryRef struct {
+	ID         RepositoryID `json:"id,string"`
+	Host       HostID       `json:"host"`
+	ExternalID string       `json:"external_id"`
+	Name       string       `json:"name"`
+}
+
+type ActorRef struct {
+	ID         ActorID `json:"id,string"`
+	Host       HostID  `json:"host"`
+	ExternalID string  `json:"external_id"`
+	Login      string  `json:"login"`
+}
+
+// Teams have their own canonical identity space. ExternalID is opaque and scoped
+// to Host; a team is never a negative actor or a login/organization slug key.
+// Observing identity and display metadata grants no membership or permission.
+type TeamRef struct {
+	ID         TeamID `json:"id,string"`
+	Host       HostID `json:"host"`
+	ExternalID string `json:"external_id"`
+	Name       string `json:"name"`
+}
+
+// Connection identifies an account binding, not the token kept by native custody.
+// A different account gets a different connection. Refresh keeps this identity.
+type ConnectionRef struct {
+	ID      ConnectionID `json:"id"`
+	Profile ProfileID    `json:"profile"`
+	Host    HostID       `json:"host"`
+	Actor   ActorID      `json:"actor,string"`
+}
+
+type RuntimeRef struct {
+	ID      RuntimeID   `json:"id"`
+	Profile ProfileID   `json:"profile"`
+	Kind    RuntimeKind `json:"kind"`
+	Name    string      `json:"name"`
+}
+
+func NewID() string {
+	var raw [16]byte
+	if _, err := rand.Read(raw[:]); err != nil {
+		panic(err)
+	}
+	return hex.EncodeToString(raw[:])
+}
+
+func ValidID(id string) bool {
+	if len(id) != 32 {
+		return false
+	}
+	for _, c := range id {
+		if !(c >= '0' && c <= '9' || c >= 'a' && c <= 'f') {
+			return false
+		}
+	}
+	return true
+}
+
+func ValidText(text string, limit int) bool {
+	return utf8.ValidString(text) && strings.TrimSpace(text) != "" &&
+		utf8.RuneCountInString(text) <= limit && !strings.ContainsFunc(text, unicode.IsControl)
+}
+
+// CanonicalAPIBase normalizes the configured instance locator. HostID remains
+// stable when this locator changes. A URL never identifies a repository/account.
+func CanonicalAPIBase(raw string) (string, error) {
+	u, err := url.Parse(raw)
+	if err != nil || !ValidText(raw, 2048) || u.Hostname() == "" || u.User != nil ||
+		u.RawQuery != "" || u.ForceQuery || u.Fragment != "" || u.Opaque != "" ||
+		(u.Scheme != "https" && u.Scheme != "http") {
+		return "", errors.New("invalid collaboration API base")
+	}
+	if port := u.Port(); port != "" {
+		n, err := strconv.Atoi(port)
+		if err != nil || n < 1 || n > 65535 {
+			return "", errors.New("invalid collaboration API port")
+		}
+	}
+	host := strings.ToLower(u.Hostname())
+	port := u.Port()
+	if port == "443" && u.Scheme == "https" || port == "80" && u.Scheme == "http" {
+		port = ""
+	}
+	if port != "" {
+		host = net.JoinHostPort(host, port)
+	} else if strings.Contains(host, ":") {
+		host = "[" + host + "]"
+	}
+	u.Host = host
+	u.Path = strings.TrimRight(u.Path, "/")
+	u.RawPath = strings.TrimRight(u.RawPath, "/")
+	return u.String(), nil
+}
