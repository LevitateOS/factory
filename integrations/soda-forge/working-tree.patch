-// postIssueOperationID binds one native operation to one comment:
-// repeated intake for the same source resolves the existing effect.
-func postIssueOperationID(comment string) string {
-	// Native operation identities survive the feed vocabulary change so an
-	// uncertain historical write resolves instead of creating a second issue.
-	return "commentissue-" + comment
-}
-
-// postIssueAuthRevision binds the authorizing intake: the comment
-// ID plus the exact source revision the draft was authored against.
-func postIssueAuthRevision(comment string, revision int64) string {
-	return "comment/" + comment + "/r" + strconv.FormatInt(revision, 10)
-}
-
-// postIssueBody renders the native issue body: the recorded draft
-// plus a bounded Soda footer preserving the source-comment link and
-// the work metadata native creation validates.
-func postIssueBody(draft factory.IssueDraft) string {
-	var footer strings.Builder
-	footer.WriteString("\n\n---\nSoda-Comment: " + draft.SourcePost + " r" + strconv.FormatInt(draft.Revision, 10) + "\n")
-	footer.WriteString("Objective: " + draft.Objective + "\n")
-	footer.WriteString("Acceptance: " + draft.Acceptance + "\n")
-	footer.WriteString("Work-Metadata: " + draft.Metadata + "\n")
-	body := draft.Body + footer.String()
-	if len(body) > 16384+4096 {
-		body = body[:16384+4096]
-	}
-	return body
-}
