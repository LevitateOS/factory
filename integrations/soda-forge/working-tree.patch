+		t.Fatal("revoked selected grant replacement", result, err)
+	}
+	stored, err = db.Sponsorship(ctx, int64(repository), connection)
+	if err != nil || stored.GrantID != "newest" || stored.ActorID != 10 || stored.Revision != 3 {
