+				var kind string
+				if err := s.db.QueryRowContext(ctx, `SELECT data_type FROM information_schema.columns WHERE table_schema='public' AND table_name=$1 AND column_name=$2`, group.table, column).Scan(&kind); err != nil || kind != "bigint" {
