+	in.ExpectedRevision = 3
+	before := snapshot()
+	for _, failure := range []error{factoryservice.ErrSponsorshipOwnerRequired, factoryservice.ErrSponsorshipConnectionMissing, errors.New("declared unknown broker read")} {
