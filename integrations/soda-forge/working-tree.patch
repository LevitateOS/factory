@@ -0,0 +1,91 @@
+package execution
+
+import (
+	"errors"
+
+	"github.com/levitateos/sodaos/internal/collaboration"
+	"github.com/levitateos/sodaos/internal/project"
+)
+
+var ErrLaunch = errors.New("execution launch lacks its captured runtime binding")
+
+type ApplianceLaunch struct {
+	Profile project.Profile `json:"profile"`
+	Tool    ApplianceTool   `json:"tool"`
+}
+
+// NativeLaunch captures placement and executable identity for a new launch.
+// An unplaced NativeRecord cannot synthesize these fields or gain authority by
+// being observed. The admitting store/gateway owns the placement exclusion gate.
+type NativeLaunch struct {
+	Workspace           NativeWorkspaceRef      `json:"workspace"`
+	Tool                NativeTool              `json:"tool"`
+	Runtime             collaboration.RuntimeID `json:"runtime"`
+	PlacementGeneration int64                   `json:"placement_generation,string"`
+}
+
+func (n NativeLaunch) Validate() error {
+	if !validWorkspaceRef(n.Workspace) || n.Tool.Validate() != nil || !collaboration.ValidID(string(n.Runtime)) || n.PlacementGeneration <= 0 {
+		return ErrLaunch
+	}
+	return nil
+}
+
+func (n NativeLaunch) MatchesRecord(record NativeRecord) bool {
+	p := record.Provenance
+	return n.Validate() == nil && record.Validate() == nil && n.Tool == record.Tool && n.Workspace.Profile == p.Profile && n.Workspace.InstanceID == p.InstanceID && n.Workspace.WorktreeID == p.WorktreeID
+}
+
+// LaunchRequest reuses the semantic prompt/manifest contract. Runtime-specific
+// captured inputs stay in exactly one variant; no OS identity is a default.
+type LaunchRequest struct {
+	Input     project.FactoryLaunch     `json:"input"`
+	Kind      collaboration.RuntimeKind `json:"kind"`
+	Appliance *ApplianceLaunch          `json:"appliance,omitempty"`
+	Native    *NativeLaunch             `json:"native,omitempty"`
+}
+
+func (r LaunchRequest) Address() RunAddress {
+	return RunAddress{Run: r.Input.Run.ID, Workspace: r.Input.Run.Project}
+}
+
+func (r LaunchRequest) Validate() error {
+	if r.Input.Validate() != nil || r.Address().Validate() != nil {
+		return ErrLaunch
+	}
+	var family, version, digest string
+	switch r.Kind {
+	case collaboration.Appliance:
+		if r.Appliance == nil || r.Native != nil || r.Appliance.Profile.Validate() != nil || r.Appliance.Tool.Validate() != nil {
+			return ErrLaunch
+		}
+		family, version, digest = r.Appliance.Tool.Harness, r.Appliance.Tool.Version, r.Appliance.Tool.SHA256
+	case collaboration.Native:
+		if r.Native == nil || r.Appliance != nil || r.Native.Validate() != nil {
+			return ErrLaunch
+		}
+		family, version, digest = r.Native.Tool.Harness, r.Native.Tool.Version, r.Native.Tool.SHA256
+	default:
+		return ErrLaunch
+	}
+	if r.Input.Run.Harness != family || r.Input.Run.HarnessVers != version || r.Input.HarnessSHA256 != digest {
+		return ErrLaunch
+	}
+	return nil
+}
+
+func (r LaunchRequest) MatchesObservation(o RunObservation) bool {
+	if r.Validate() != nil || o.ValidateFor(r.Address()) != nil || o.Kind != r.Kind || o.Role != r.Input.Run.Role && (o.Role != "" || o.Live) {
+		return false
+	}
+	if r.Native != nil {
+		n := o.Native
+		if n == nil || n.Profile != r.Native.Workspace.Profile || n.InstanceID != r.Native.Workspace.InstanceID || n.WorktreeID != r.Native.Workspace.WorktreeID {
+			return false
+		}
+		if p := n.Process; p != nil && (p.Executable != r.Native.Tool.Executable || p.ExecutableSHA256 != r.Native.Tool.SHA256) {
+			return false
+		}
+	}
+	return true
+}
diff --git a/internal/factory/execution/native_record.go b/internal/factory/execution/native_record.go
new file mode 100644
index 0000000000000000000000000000000000000000..10802937edb875ed3b673d4638a60d06fd74ccf9
--- /dev/null
+++ b/internal/factory/execution/native_record.go
@@ -0,0 +1,90 @@
+package execution
+
+import (
+	"path/filepath"
+	"reflect"
+	"time"
+
+	"github.com/levitateos/sodaos/internal/collaboration"
+	"github.com/levitateos/sodaos/internal/project"
+)
+
+// NativeTool is captured executable identity, not an appliance image or a
+// mutable current-tool selector. Updates apply only to future admissions.
+type NativeTool struct {
+	Harness    string `json:"harness"`
+	Version    string `json:"version"`
+	SHA256     string `json:"sha256"`
+	Executable string `json:"executable"`
+}
+
+func (t NativeTool) Validate() error {
+	if !project.ValidHarnessFamily(t.Harness) || !project.ValidHarnessVersion(t.Version) || !validDigest(t.SHA256) || !filepath.IsAbs(t.Executable) || !collaboration.ValidText(t.Executable, 4096) {
+		return ErrProvenance
+	}
+	return nil
+}
+
+// NativeRecord is retained run evidence before repository placement is bound.
+// It supplies no invented runtime ID/generation and grants no dispatch authority.
+// Sealed means this identity cannot acquire again; process retirement and
+// retirement of this run's credential material remain separate facts.
+type NativeRecord struct {
+	Tool       NativeTool       `json:"tool"`
+	Provenance NativeProvenance `json:"provenance"`
+	Retirement Retirement       `json:"retirement"`
+	Sealed     bool             `json:"sealed"`
+}
+
+func (r NativeRecord) Validate() error {
+	if r.Tool.Validate() != nil || !validNative(r.Provenance) ||
+		(r.Retirement != NotStarted && r.Retirement != Running && r.Retirement != Exited && r.Retirement != Retired && r.Retirement != Uncertain) {
+		return ErrProvenance
+	}
+	p := r.Provenance.Process
+	if (r.Retirement == Running || r.Retirement == Exited) && p == nil || r.Retirement == NotStarted && p != nil {
+		return ErrProvenance
+	}
+	if p != nil && (p.Executable != r.Tool.Executable || p.ExecutableSHA256 != r.Tool.SHA256) {
+		return ErrProvenance
+	}
+	return nil
+}
+
+func (r NativeRecord) Settled() bool {
+	return r.Validate() == nil && r.Retirement == Retired && r.Sealed &&
+		(r.Provenance.Custody.State == Released || r.Provenance.Custody.State == NotAcquired)
+}
+
+// Advances prevents observations from replacing captured tool/process/custody
+// identities. Unknown cleanup can resolve, but confirmed exit, release, seal and
+// retirement cannot be erased by a stale observer or a recycled PID.
+func (r NativeRecord) Advances(prior NativeRecord) bool {
+	if r.Validate() != nil || prior.Validate() != nil || r.Tool != prior.Tool ||
+		r.Provenance.Profile != prior.Provenance.Profile || r.Provenance.InstanceID != prior.Provenance.InstanceID ||
+		r.Provenance.WorktreeID != prior.Provenance.WorktreeID || r.Provenance.TrustMode != prior.Provenance.TrustMode ||
+		(prior.Sealed && !r.Sealed) || (prior.Retirement == Retired && r.Retirement != Retired) ||
+		(prior.Retirement == Exited && (r.Retirement == Running || r.Retirement == NotStarted)) {
+		return false
+	}
+	old, next := prior.Provenance.Process, r.Provenance.Process
+	if old != nil {
+		if next == nil {
+			return false
+		}
+		a, b := *old, *next
+		a.ExitCode, a.ExitSignal, b.ExitCode, b.ExitSignal = nil, nil, nil, nil
+		a.StartedAt, b.StartedAt = time.Time{}, time.Time{}
+		if a != b || !old.StartedAt.Equal(next.StartedAt) || old.ExitCode != nil && !reflect.DeepEqual(old.ExitCode, next.ExitCode) || old.ExitSignal != nil && !reflect.DeepEqual(old.ExitSignal, next.ExitSignal) {
+			return false
+		}
+	} else if prior.Retirement == Retired && next != nil {
+		return false
+	}
+	c, n := prior.Provenance.Custody, r.Provenance.Custody
+	if c.AcquisitionID != "" && (c.AcquisitionID != n.AcquisitionID || c.Connection != n.Connection || c.Generation != n.Generation) ||
+		(c.State == Released && n.State != Released) || prior.Settled() && !reflect.DeepEqual(c, n) {
+		return false
+	}
+	return true
+}
