+                "complete file list retained cursor",
+            )?;
+            return Ok((diff, files, first_cursor));
+        }
+        let next = page["files"]["next"]
+            .as_str()
+            .ok_or("file continuation missing")?;
+        require(
+            !next.is_empty() && next != cursor,
+            "file continuation did not advance",
+        )?;
