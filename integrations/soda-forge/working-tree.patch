+
+func (s Requests) departments(w http.ResponseWriter, r *http.Request) {
+	if r.Method == http.MethodGet {
+		result, err := s.Service.Departments(r.Context(), s.Actor)
+		if err != nil {
+			CommandError(w, err)
+			return
+		}
+		if s.current(w, r) {
+			writeJSON(w, 200, result)
+		}
+		return
+	}
+	if !s.current(w, r) {
+		return
+	}
+	var d factory.Department
+	if !decodeObject(w, r, &d) {
+		return
+	}
+	if !s.current(w, r) {
+		return
+	}
+	result, err := s.Service.CreateDepartment(r.Context(), s.Actor, d)
+	if errors.Is(err, factoryservice.ErrDepartmentInputInvalid) {
+		writeError(w, 400, "invalid_department", err.Error())
+		return
+	}
+	if err != nil {
+		CommandError(w, err)
+		return
+	}
+	if s.current(w, r) {
+		writeJSON(w, 201, result)
+	}
+}
+
+func (s Requests) revision(w http.ResponseWriter, r *http.Request) {
+	result, err := s.Service.Revision(r.Context(), s.Actor, r.PathValue("intentID"))
+	if err != nil {
+		RequestReadError(w, err)
+		return
+	}
+	if s.current(w, r) {
+		writeJSON(w, 200, result)
+	}
+}
+
+// savedRevision confirms only the exact persisted input requested by the owner.
+// Current account admission is checked both by the route and before disclosure.
+func (s Requests) savedRevision(w http.ResponseWriter, r *http.Request) {
+	if r.URL.RawQuery != "" || r.URL.ForceQuery {
+		writeError(w, 400, "invalid_revision", "No query parameters are accepted.")
+		return
+	}
+	result, err := s.Service.SavedRevision(r.Context(), s.Actor, r.PathValue("intentID"), r.PathValue("revisionID"))
+	if err != nil {
+		RequestReadError(w, err)
+		return
+	}
+	if s.current(w, r) {
+		writeJSON(w, 200, result)
+	}
+}
+
+func (s Requests) catalogue(w http.ResponseWriter, r *http.Request) {
+	q := r.URL.Query()
+	limit := 20
+	if raw := q.Get("limit"); raw != "" {
+		n, err := strconv.Atoi(raw)
+		if err != nil {
+			writeError(w, 400, "invalid_list", "Invalid list limit.")
+			return
+		}
+		limit = n
+	}
+	var repository int64
+	if raw := q.Get("repository"); raw != "" {
+		n, err := strconv.ParseInt(raw, 10, 64)
+		if err != nil || n < 0 {
+			writeError(w, 400, "invalid_list", "Invalid repository filter.")
+			return
+		}
+		repository = n
+	}
+	f := factory.IntentListFilter{Cursor: q.Get("cursor"), State: q.Get("state"), Repository: repository, Department: q.Get("department"), Limit: limit}
+	if err := f.Validate(); err != nil {
+		writeError(w, 400, "invalid_list", err.Error())
+		return
+	}
+	result, next, err := s.Service.Catalogue(r.Context(), s.Actor, f)
+	if err != nil {
+		CommandError(w, err)
+		return
+	}
+	out := map[string]any{"intents": result}
+	if next != "" {
+		out["next_cursor"] = next
+	}
+	if s.current(w, r) {
+		writeJSON(w, 200, out)
+	}
+}
+
+func (s Requests) history(w http.ResponseWriter, r *http.Request) {
+	intent := r.PathValue("intentID")
+	if !project.ValidDecisionID(intent) {
+		writeError(w, 404, "not_found", "Build request not found.")
+		return
+	}
+	limit := 20
+	if raw := r.URL.Query().Get("limit"); raw != "" {
+		n, err := strconv.Atoi(raw)
+		if err != nil {
+			writeError(w, 400, "invalid_history", "Invalid history limit.")
+			return
+		}
+		limit = n
+	}
+	result, err := s.Service.History(r.Context(), s.Actor, intent, limit)
+	if err != nil {
+		RequestReadError(w, err)
+		return
+	}
+	if s.current(w, r) {
+		writeJSON(w, 200, map[string]any{"intent": intent, "revisions": result})
+	}
+}
+
+func (s Requests) review(w http.ResponseWriter, r *http.Request) {
+	read, err := s.Service.Review(r.Context(), s.Actor, r.PathValue("intentID"), r.URL.Query().Get("revision"))
+	switch {
+	case errors.Is(err, factoryservice.ErrRequestNotFound):
+		writeError(w, 404, "not_found", "Build request not found.")
+		return
+	case errors.Is(err, factoryservice.ErrRequestRevisionInvalid):
+		writeError(w, 400, "invalid_revision", "Invalid review revision.")
+		return
+	case err != nil:
+		CommandError(w, err)
+		return
+	}
+	if s.current(w, r) {
+		writeJSON(w, 200, read)
+	}
+}
+
+func (s Requests) saveRevision(w http.ResponseWriter, r *http.Request) {
+	if !s.current(w, r) {
+		return
+	}
+	var in factory.IntentRevision
+	if !decodeObject(w, r, &in) {
+		return
+	}
+	requests := s.Service
+	admitted := s.Actor
+	if !s.current(w, r) {
+		return
+	}
+	result, err := requests.SaveRevision(r.Context(), admitted, in)
+	switch {
+	case errors.Is(err, factoryservice.ErrRequestInputInvalid):
+		writeError(w, 400, "invalid_intent", err.Error())
+		return
+	case errors.Is(err, factoryservice.ErrRequestWriteAccess):
+		s.authorityError(w, err)
+		return
+	case errors.Is(err, store.ErrStaleRevision):
+		writeError(w, 412, "stale_revision", "The reviewed build request changed.")
+		return
+	case err != nil:
+		RequestReadError(w, err)
+		return
+	}
+	if s.current(w, r) {
+		writeJSON(w, 201, result)
+	}
+}
+
+// overview reads the admitted owner's stored request facts.
+// GET never judges, provisions or dispatches.
+func (s Requests) overview(w http.ResponseWriter, r *http.Request) {
+	if r.URL.RawQuery != "" || r.URL.ForceQuery {
+		writeError(w, 400, "invalid_request", "No query parameters are accepted.")
+		return
+	}
+	view, err := s.Service.Overview(r.Context(), s.Actor, r.PathValue("intentID"))
+	if err != nil {
+		if errors.Is(err, factoryservice.ErrRequestNotFound) {
+			writeError(w, 404, "not_found", "Build request not found.")
+		} else {
+			writeError(w, 503, "store_unavailable", "Could not read build request overview.")
+		}
+		return
+	}
+	if s.current(w, r) {
+		writeJSON(w, 200, view)
+	}
+}
+
+// Opening the exact proposal saves a draft only. Ordinary planning, acceptance
+// and generation retain their later authority.
+func (s Requests) reviewPost(w http.ResponseWriter, r *http.Request) {
+	if !s.current(w, r) {
+		return
+	}
+	var in struct {
+		Revision int64 `json:"revision"`
+	}
+	if !decodeObject(w, r, &in) {
+		return
+	}
+	if !s.current(w, r) {
+		return
+	}
+	result, err := s.Posts.ReviewProduct(r.Context(), s.Actor, r.PathValue("id"), in.Revision)
+	if err != nil {
+		switch {
+		case errors.Is(err, factoryservice.ErrPostProductNotFound), errors.Is(err, factoryservice.ErrPostNotFound):
+			writeError(w, 404, "product_change_not_found", "Product change is not available.")
+		case errors.Is(err, factoryservice.ErrRequestWriteAccess):
+			s.authorityError(w, err)
+		case errors.Is(err, factoryservice.ErrPostVisibility):
+			s.visibilityError(w, err)
+		case errors.Is(err, store.ErrStaleRevision):
+			writeError(w, 412, "stale_revision", "The comment or accepted product changed. Refresh before reviewing.")
+		default:
+			CommandError(w, err)
+		}
+		return
+	}
+	if s.current(w, r) {
+		writeJSON(w, 200, result)
+	}
+}
+
+// savedExploration confirms only the atomic transition from the private input.
+func (s Requests) savedExploration(w http.ResponseWriter, r *http.Request) {
+	if r.URL.RawQuery != "" || r.URL.ForceQuery {
+		writeError(w, 400, "invalid_request", "No query parameters are accepted.")
+		return
+	}
+	result, err := s.Service.SavedExploration(r.Context(), s.Actor, r.PathValue("intentID"), r.PathValue("revisionID"))
+	if err != nil {
+		RequestReadError(w, err)
+		return
+	}
+	if s.current(w, r) {
+		writeJSON(w, 200, result)
+	}
+}
diff --git a/internal/factory/httpapi/requests.go b/internal/factory/httpapi/requests.go
new file mode 100644
index 0000000000000000000000000000000000000000..d8e24be3717cf27ef38123c2384de670e789cd04
--- /dev/null
+++ b/internal/factory/httpapi/requests.go
@@ -0,0 +1,107 @@
+package httpapi
+
+import (
+	"net/http"
+
+	"github.com/levitateos/sodaos/internal/collaboration"
+	factoryservice "github.com/levitateos/sodaos/internal/factory/service"
+)
+
+// Requests serves owner-private direction, product review and admitted planning.
+// Hosts supply authenticated identity and current admission; service ports keep
+// write authority and source journals. No body/query selects this principal.
+type Requests struct {
+	Service     factoryservice.Requests
+	Posts       factoryservice.Posts
+	Planning    factoryservice.RequestPlanning
+	Exploration factoryservice.RequestExploration
+	Host        collaboration.HostID
+	Actor       collaboration.ActorID
+	// Principal is host-supplied audit attribution for allowance commands.
+	Principal string
+	Current   func(http.ResponseWriter, *http.Request) bool
+	// Error presenters retain host-specific authority failures without importing
+	// its SDK/session. Missing presenters return bounded unavailable responses.
+	AuthorityError  func(http.ResponseWriter, error)
+	VisibilityError func(http.ResponseWriter, error)
+}
+
+// Handler constructs no listener, model client, work driver or session.
+func (s Requests) Handler() http.Handler {
+	mux := http.NewServeMux()
+	register := func(method, path string, serve http.HandlerFunc) {
+		mux.HandleFunc(method+" "+path, func(w http.ResponseWriter, r *http.Request) {
+			if r.Method != method {
+				w.Header().Set("Allow", method)
+				writeError(w, 405, "method_not_allowed", "HTTP method not supported.")
+				return
+			}
+			if s.current(w, r) {
+				if method == http.MethodPost {
+					switch path {
+					case "/api/factory/intents/{intentID}/plan", "/api/factory/intents/{intentID}/generate":
+						if s.Planning.Requests.Store == nil || s.Planning.Requests.Store != s.Service.Store {
+							writeError(w, 503, "planning_unavailable", "Planning command transport is unavailable.")
+							return
+						}
+					case "/api/factory/intents/{intentID}/explore", "/api/factory/intents/{intentID}/plan/review":
+						if s.Exploration.Requests.Store == nil || s.Exploration.Requests.Store != s.Service.Store {
+							writeError(w, 503, "planning_unavailable", "Exploration command transport is unavailable.")
+							return
+						}
+					}
+				}
+				serve(w, r)
+			}
+		})
+	}
+	register(http.MethodGet, "/api/factory/departments", s.departments)
+	register(http.MethodPost, "/api/factory/departments", s.departments)
+	register(http.MethodGet, "/api/factory/intents", s.catalogue)
+	register(http.MethodPost, "/api/factory/intents", s.saveRevision)
+	register(http.MethodGet, "/api/factory/intents/{intentID}", s.revision)
+	register(http.MethodGet, "/api/factory/intents/{intentID}/revisions/{revisionID}", s.savedRevision)
+	register(http.MethodGet, "/api/factory/intents/{intentID}/revisions/{revisionID}/generation", s.savedGeneration)
+	register(http.MethodGet, "/api/factory/intents/{intentID}/revisions/{revisionID}/plan", s.savedPlanning)
+	register(http.MethodGet, "/api/factory/intents/{intentID}/revisions/{revisionID}/exploration", s.savedExploration)
+	register(http.MethodGet, "/api/factory/intents/{intentID}/history", s.history)
+	register(http.MethodGet, "/api/factory/intents/{intentID}/revisions", s.scopeHistory)
+	register(http.MethodGet, "/api/factory/intents/{intentID}/review", s.review)
+	register(http.MethodGet, "/api/factory/intents/{intentID}/overview", s.overview)
+	register(http.MethodGet, "/api/factory/intents/{intentID}/generation", s.generation)
+	register(http.MethodGet, "/api/factory/intents/{intentID}/verification-allowance", s.verificationAllowance)
+	register(http.MethodPost, "/api/factory/intents/{intentID}/verification-allowance", s.verificationAllowance)
+	register(http.MethodGet, "/api/factory/intents/{intentID}/plan", s.planStatus)
+	register(http.MethodPost, "/api/factory/intents/{intentID}/plan", s.plan)
+	register(http.MethodPost, "/api/factory/intents/{intentID}/generate", s.generate)
+	register(http.MethodPost, "/api/factory/intents/{intentID}/plan/review", s.reviewPlan)
+	register(http.MethodPost, "/api/factory/intents/{intentID}/explore", s.explore)
+	register(http.MethodPost, "/api/factory/feed/posts/{id}/review", func(w http.ResponseWriter, r *http.Request) {
+		if s.Posts.Store == nil || s.Posts.Store != s.Service.Store {
+			writeError(w, 503, "store_unavailable", "Product review transport is unavailable.")
+			return
+		}
+		s.reviewPost(w, r)
+	})
+	return mux
+}
+
+func (s Requests) current(w http.ResponseWriter, r *http.Request) bool {
+	return currentAccount(w, r, s.Host, s.Actor, s.Current)
+}
+
+func (s Requests) authorityError(w http.ResponseWriter, err error) {
+	if s.AuthorityError != nil {
+		s.AuthorityError(w, err)
+		return
+	}
+	writeError(w, 503, "authority_unavailable", "Current repository administration is unavailable.")
+}
+
+func (s Requests) visibilityError(w http.ResponseWriter, err error) {
+	if s.VisibilityError != nil {
+		s.VisibilityError(w, err)
+		return
+	}
+	writeError(w, 503, "authority_unavailable", "Current repository visibility is unavailable.")
+}
diff --git a/internal/factory/httpapi/run_errors.go b/internal/factory/httpapi/run_errors.go
new file mode 100644
index 0000000000000000000000000000000000000000..af537c0e06ad74fb9ffdde54816c4b8f57a4b7a1
--- /dev/null
+++ b/internal/factory/httpapi/run_errors.go
@@ -0,0 +1,76 @@
+package httpapi
+
+import (
+	"errors"
+	"net/http"
+
+	"github.com/levitateos/sodaos/internal/factory"
+	"github.com/levitateos/sodaos/internal/factory/control"
+	factoryservice "github.com/levitateos/sodaos/internal/factory/service"
+	"github.com/levitateos/sodaos/internal/store"
+)
+
+func (s Runs) statusError(w http.ResponseWriter, err error) {
+	if s.hostError(w, err) {
+		return
+	}
+	switch {
+	case errors.Is(err, factoryservice.ErrRunStatusAccess):
+		s.authorityError(w, err)
+	case errors.Is(err, factory.ErrNotFound):
+		writeError(w, 404, "not_found", "Factory run not found.")
+	case errors.Is(err, factoryservice.ErrRunStatusScope):
+		writeError(w, 409, "view_conflict", "Run binding names another repository; refresh the inventory.")
+	case errors.Is(err, factoryservice.ErrRunStatusContext):
+		writeError(w, 503, "context_unavailable", "Could not read the saved context hold.")
+	case errors.Is(err, factoryservice.ErrRunStatusObservation):
+		writeError(w, 503, "host_unavailable", "Run observation is unavailable.")
+	case errors.Is(err, factoryservice.ErrRunStatusAuthority):
+		writeError(w, 503, "authority_unavailable", "Could not read current verification authority.")
+	default:
+		writeError(w, 503, "store_unavailable", "Could not read run status.")
+	}
+}
+
+func (s Runs) interventionError(w http.ResponseWriter, err error) {
+	if s.hostError(w, err) {
+		return
+	}
+	switch {
+	case errors.Is(err, factoryservice.ErrInterventionAccess):
+		s.authorityError(w, err)
+	case errors.Is(err, factoryservice.ErrInterventionAction):
+		writeError(w, 400, "invalid_action", "Choose an available Factory intervention.")
+	case errors.Is(err, factoryservice.ErrInterventionCommand):
+		writeError(w, 400, "invalid_command", "Retries require a client-generated command identity.")
+	case errors.Is(err, factoryservice.ErrInterventionPayload):
+		writeError(w, 400, "invalid_request", "The action requires its exact saved context or completion scope; pause and resume do not use command IDs.")
+	case errors.Is(err, factoryservice.ErrInterventionRecoveryTarget):
+		writeError(w, 403, "membership_required", "Join the project before taking over its work.")
+	default:
+		lifecycleControlError(w, err)
+	}
+}
+
+// Unknown runs remain private; pending or unconfirmed work never becomes success.
+func lifecycleControlError(w http.ResponseWriter, err error) {
+	var pending control.ErrPendingRuns
+	switch {
+	case errors.Is(err, factory.ErrNotFound):
+		writeError(w, 404, "not_found", "Factory run not found.")
+	case errors.As(err, &pending):
+		writeJSON(w, 409, map[string]any{"error": "pending_runs", "runs": pending.Runs, "message": "Recorded runs are not settled; stop or reconcile them first."})
+	case errors.Is(err, control.ErrTakeoverFailed):
+		writeError(w, 502, "takeover_unconfirmed", "Takeover was not confirmed; refresh and retry.")
+	case errors.Is(err, store.ErrTakeoverConflict):
+		writeError(w, 409, "takeover_conflict", "Takeover identity reused for different content.")
+	case errors.Is(err, store.ErrExplicitRetryIneligible):
+		writeError(w, 409, "retry_ineligible", "The prior attempt is not eligible for retry; refresh its settlement and current inputs.")
+	case errors.Is(err, store.ErrContextResolutionIneligible):
+		writeError(w, 409, "context_resolution_ineligible", "The held current context changed or cannot be selected; refresh this run.")
+	case errors.Is(err, store.ErrCompletionRetryIneligible):
+		writeError(w, 409, "completion_retry_ineligible", "The completion cycle changed or its prior work has not settled; refresh its details.")
+	default:
+		CommandError(w, err)
+	}
+}
diff --git a/internal/factory/httpapi/runs.go b/internal/factory/httpapi/runs.go
new file mode 100644
index 0000000000000000000000000000000000000000..0ca3a0b3ba513cd8dad29136fc97451c463bb07a
--- /dev/null
+++ b/internal/factory/httpapi/runs.go
@@ -0,0 +1,143 @@
+package httpapi
+
+import (
+	"net/http"
+
+	"github.com/levitateos/sodaos/internal/collaboration"
+	factoryservice "github.com/levitateos/sodaos/internal/factory/service"
+	"github.com/levitateos/sodaos/internal/store"
+)
+
+// Runs serves recorded status and explicit interventions. Hosts bind the actor
+// and command principal independently and retain current channel/account and
+// execution/recovery authority. Construction starts no runtime or work.
+type Runs struct {
+	Store           *store.Store
+	Status          factoryservice.RunStatus
+	Commands        factoryservice.Interventions
+	Host            collaboration.HostID
+	Actor           collaboration.ActorID
+	Principal       string
+	Visibility      factoryservice.WorkVisibility
+	Current         func(http.ResponseWriter, *http.Request) bool
+	AuthorityError  func(http.ResponseWriter, error)
+	VisibilityError func(http.ResponseWriter, error)
+	HostError       func(http.ResponseWriter, error) bool
+}
+
+func (s Runs) Handler() http.Handler {
+	mux := http.NewServeMux()
+	register := func(method, path string, serve http.HandlerFunc) {
+		mux.HandleFunc(method+" "+path, func(w http.ResponseWriter, r *http.Request) {
+			if r.Method != method {
+				w.Header().Set("Allow", method)
+				writeError(w, 405, "method_not_allowed", "HTTP method not supported.")
+				return
+			}
+			if !s.current(w, r) {
+				return
+			}
+			selected := s.Commands.Store
+			if method == http.MethodGet {
+				selected = s.Status.Store
+			} else if s.Principal == "" {
+				writeError(w, 503, "authority_unavailable", "Factory command authority is unavailable.")
+				return
+			}
+			if s.Store == nil || selected != s.Store {
+				writeError(w, 503, "store_unavailable", "Factory run storage is unavailable.")
+				return
+			}
+			serve(w, r)
+		})
+	}
+	register(http.MethodGet, "/api/factory/runs/{runID}", s.status)
+	register(http.MethodPost, "/api/repositories/{repositoryID}/factory/actions", s.repositoryAction)
+	register(http.MethodPost, "/api/factory/runs/{runID}/actions", s.runAction)
+	return mux
+}
+
+func (s Runs) current(w http.ResponseWriter, r *http.Request) bool {
+	return currentAccount(w, r, s.Host, s.Actor, s.Current)
+}
+
+func (s Runs) status(w http.ResponseWriter, r *http.Request) {
+	if r.URL.RawQuery != "" || r.URL.ForceQuery {
+		writeError(w, 400, "invalid_request", "No query parameters are accepted.")
+		return
+	}
+	view, err := s.Status.Read(r.Context(), s.Actor, r.PathValue("runID"))
+	if err != nil {
+		s.statusError(w, err)
+		return
+	}
+	if s.current(w, r) {
+		writeJSON(w, 200, view)
+	}
+}
+
+func (s Runs) repositoryAction(w http.ResponseWriter, r *http.Request) {
+	id, valid := positiveID(r.PathValue("repositoryID"))
+	if !valid {
+		writeError(w, 404, "not_found", "Repository not found.")
+		return
+	}
+	repository := collaboration.RepositoryID(id)
+	if s.Visibility == nil {
+		s.visibilityError(w, factoryservice.ErrInterventionUnavailable)
+		return
+	}
+	if err := s.Visibility(r.Context(), s.Actor, repository); err != nil {
+		if !s.hostError(w, err) {
+			s.visibilityError(w, err)
+		}
+		return
+	}
+	var in factoryservice.RepositoryCommand
+	if !decodeObject(w, r, &in) || !s.current(w, r) {
+		return
+	}
+	result, err := s.Commands.Repository(r.Context(), s.Actor, s.Principal, repository, in)
+	if err != nil {
+		s.interventionError(w, err)
+		return
+	}
+	if s.current(w, r) {
+		writeJSON(w, 200, result)
+	}
+}
+
+func (s Runs) runAction(w http.ResponseWriter, r *http.Request) {
+	var in factoryservice.RunCommand
+	if !decodeObject(w, r, &in) || !s.current(w, r) {
+		return
+	}
+	result, err := s.Commands.Run(r.Context(), s.Actor, s.Principal, r.PathValue("runID"), in)
+	if err != nil {
+		s.interventionError(w, err)
+		return
+	}
+	if s.current(w, r) {
+		writeJSON(w, 200, result)
+	}
+}
+
+func (s Runs) hostError(w http.ResponseWriter, err error) bool {
+	return s.HostError != nil && s.HostError(w, err)
+}
+
+func (s Runs) authorityError(w http.ResponseWriter, err error) {
+	if s.AuthorityError != nil {
+		s.AuthorityError(w, err)
+		return
+	}
+	writeError(w, 503, "authority_unavailable", "Current execution authority is unavailable.")
+}
+
+func (s Runs) visibilityError(w http.ResponseWriter, err error) {
+	if s.VisibilityError != nil {
+		s.VisibilityError(w, err)
+		return
+	}
+	writeError(w, 503, "authority_unavailable", "Current repository visibility is unavailable.")
+}
diff --git a/internal/factory/httpapi/work.go b/internal/factory/httpapi/work.go
new file mode 100644
index 0000000000000000000000000000000000000000..893762495e08a1d78a8addecb6d4a10a74d8c5f0
--- /dev/null
+++ b/internal/factory/httpapi/work.go
@@ -0,0 +1,90 @@
+package httpapi
+
+import (
+	"net/http"
+	"strconv"
+
+	"github.com/levitateos/sodaos/internal/collaboration"
+	factoryservice "github.com/levitateos/sodaos/internal/factory/service"
+)
+
+// Work serves recorded issue/journey, assignment and priority facts for a bound
+// principal. Services own current resource visibility and factual projections;
+// hosts retain account/channel admission and sanitized provider error rendering.
+type Work struct {
+	Reads           factoryservice.WorkReads
+	Issues          factoryservice.Issues
+	Host            collaboration.HostID
+	Actor           collaboration.ActorID
+	Current         func(http.ResponseWriter, *http.Request) bool
+	VisibilityError func(http.ResponseWriter, error)
+	StatusError     func(http.ResponseWriter, error)
+}
+
+// Handler starts no listener, runtime, workflow, provider client or model call.
+func (s Work) Handler() http.Handler {
+	mux := http.NewServeMux()
+	register := func(path string, serve http.HandlerFunc) {
+		mux.HandleFunc("GET "+path, func(w http.ResponseWriter, r *http.Request) {
+			if r.Method != http.MethodGet {
+				w.Header().Set("Allow", http.MethodGet)
+				writeError(w, 405, "method_not_allowed", "HTTP method not supported.")
+				return
+			}
+			if s.current(w, r) {
+				if s.Reads.Store != nil && s.Issues.Store != nil && s.Reads.Store != s.Issues.Store {
+					writeError(w, 503, "store_unavailable", "Recorded work is unavailable.")
+					return
+				}
+				serve(w, r)
+			}
+		})
+	}
+	base := "/api/repositories/{repositoryID}/factory/issues/{issueID}"
+	register(base, s.issue)
+	register(base+"/assignment", s.assignment)
+	register(base+"/plan", s.priority)
+	return mux
+}
+
+func (s Work) current(w http.ResponseWriter, r *http.Request) bool {
+	return currentAccount(w, r, s.Host, s.Actor, s.Current)
+}
+
+func (s Work) scope(w http.ResponseWriter, r *http.Request) (collaboration.RepositoryID, int64, bool) {
+	repository, ok := positiveID(r.PathValue("repositoryID"))
+	if !ok {
+		writeError(w, 404, "not_found", "Repository not found.")
+		return 0, 0, false
+	}
+	issue, ok := positiveID(r.PathValue("issueID"))
+	if !ok {
+		writeError(w, 404, "not_found", "Factory issue not found.")
+		return 0, 0, false
+	}
+	return collaboration.RepositoryID(repository), issue, true
+}
+
+func positiveID(value string) (int64, bool) {
+	if len(value) == 0 || len(value) > 19 {
+		return 0, false
+	}
+	id, err := strconv.ParseInt(value, 10, 64)
+	return id, err == nil && id > 0 && strconv.FormatInt(id, 10) == value
+}
+
+func (s Work) visibilityError(w http.ResponseWriter, err error) {
+	if s.VisibilityError != nil {
+		s.VisibilityError(w, err)
+		return
+	}
+	writeError(w, 503, "authority_unavailable", "Current repository visibility is unavailable.")
+}
+
+func (s Work) statusError(w http.ResponseWriter, err error) {
+	if s.StatusError != nil {
+		s.StatusError(w, err)
+		return
+	}
+	writeError(w, 503, "issue_status_unavailable", "Current issue acceptance evidence is unavailable.")
+}
diff --git a/internal/factory/httpapi/work_reads.go b/internal/factory/httpapi/work_reads.go
new file mode 100644
index 0000000000000000000000000000000000000000..03c261702981c8eaeb577a3b6a33a957433a662f
--- /dev/null
+++ b/internal/factory/httpapi/work_reads.go
@@ -0,0 +1,124 @@
+package httpapi
+
+import (
+	"errors"
+	"net/http"
+	"net/url"
+	"strconv"
+
+	"github.com/levitateos/sodaos/internal/factory"
+	factoryservice "github.com/levitateos/sodaos/internal/factory/service"
+	"github.com/levitateos/sodaos/internal/store"
+)
+
+func (s Work) issue(w http.ResponseWriter, r *http.Request) {
+	if r.URL.RawQuery != "" || r.URL.ForceQuery {
+		writeError(w, 400, "invalid_request", "No query parameters are accepted.")
+		return
+	}
+	repository, issue, ok := s.scope(w, r)
+	if !ok {
+		return
+	}
+	view, err := s.Issues.Read(r.Context(), s.Actor, repository, issue)
+	if err != nil {
+		switch {
+		case errors.Is(err, factoryservice.ErrIssueVisibility):
+			s.visibilityError(w, err)
+		case errors.Is(err, factoryservice.ErrIssueStatus):
+			s.statusError(w, err)
+		default:
+			writeError(w, 503, "store_unavailable", "Could not read issue work.")
+		}
+		return
+	}
+	if s.current(w, r) {
+		writeJSON(w, 200, view)
+	}
+}
+
+func (s Work) assignment(w http.ResponseWriter, r *http.Request) {
+	if r.URL.RawQuery != "" || r.URL.ForceQuery {
+		writeError(w, 400, "invalid_request", "No query parameters are accepted.")
+		return
+	}
+	repository, issue, ok := s.scope(w, r)
+	if !ok {
+		return
+	}
+	view, err := s.Reads.Assignment(r.Context(), s.Actor, repository, issue)
+	if err != nil {
+		s.recordedReadError(w, err)
+		return
+	}
+	if s.current(w, r) {
+		writeJSON(w, 200, view)
+	}
+}
+
+func parsePlanComparisonQuery(raw string) (store.PriorityComparisonCursor, int, bool) {
+	var cursor store.PriorityComparisonCursor
+	if len(raw) > 2048 {
+		return cursor, 0, false
+	}
+	values, err := url.ParseQuery(raw)
+	if err != nil {
+		return cursor, 0, false
+	}
+	for key := range values {
+		if key != "limit" && key != "before_unix" && key != "before_snapshot" {
+			return cursor, 0, false
+		}
+	}
+	limit := store.DefaultPriorityComparisons
+	if raw := values.Get("limit"); raw != "" {
+		parsed, err := strconv.Atoi(raw)
+		if err != nil || parsed < 1 || parsed > store.MaxPriorityComparisons {
+			return cursor, 0, false
+		}
+		limit = parsed
+	}
+	beforeUnix := values.Get("before_unix")
+	beforeSnapshot := values.Get("before_snapshot")
+	if beforeUnix == "" && beforeSnapshot == "" {
+		return cursor, limit, true
+	}
+	parsed, err := strconv.ParseInt(beforeUnix, 10, 64)
+	if err != nil || parsed <= 0 || !factory.ValidDigest(beforeSnapshot) {
+		return cursor, 0, false
+	}
+	return store.PriorityComparisonCursor{BeforeUnix: parsed, BeforeSnapshot: beforeSnapshot}, limit, true
+}
+
+func (s Work) priority(w http.ResponseWriter, r *http.Request) {
+	cursor, limit, ok := parsePlanComparisonQuery(r.URL.RawQuery)
+	if r.URL.ForceQuery || !ok {
+		writeError(w, 400, "invalid_request", "Use limit 1..20 with an optional before_unix/before_snapshot cursor pair.")
+		return
+	}
+	repository, issue, ok := s.scope(w, r)
+	if !ok {
+		return
+	}
+	view, err := s.Reads.Priority(r.Context(), s.Actor, repository, issue, cursor, limit)
+	if err != nil {
+		s.recordedReadError(w, err)
+		return
+	}
+	if s.current(w, r) {
+		writeJSON(w, 200, view)
+	}
+}
+
+func (s Work) recordedReadError(w http.ResponseWriter, err error) {
+	switch {
+	case errors.Is(err, factoryservice.ErrWorkReadVisibility):
+		s.visibilityError(w, err)
+	case errors.Is(err, store.ErrNotFound):
+		writeError(w, 404, "not_found", "No dispatch assignment recorded this issue.")
+	case errors.Is(err, factoryservice.ErrWorkReadQuery):
+		writeError(w, 400, "invalid_request", "Recorded work query is invalid.")
+	default:
+		writeError(w, 503, "store_unavailable", "Could not read recorded work.")
+	}
+}
diff --git a/internal/factory/httpapi/worker.go b/internal/factory/httpapi/worker.go
new file mode 100644
index 0000000000000000000000000000000000000000..dccb31ff1a516fb966ff4e073c266b2de9a03f10
--- /dev/null
+++ b/internal/factory/httpapi/worker.go
@@ -0,0 +1,100 @@
+// Package httpapi owns Factory HTTP transport boundaries. Hosts supply current
+// admission and protocol construction without HTTP session impersonation.
+package httpapi
+
+import (
+	"context"
+	"crypto/subtle"
+	"net/http"
+	"strings"
+	"time"
+
+	"github.com/levitateos/sodaos/internal/factory"
+)
+
+// WorkerRoute is the fixed Factory-only MCP route. Listener/socket ownership
+// belongs to the host; a worker cannot select it in its tool arguments.
+const WorkerRoute = "/mcp"
+
+type CapabilitySource interface {
+	GetMCPCapability(context.Context, string) (factory.MCPCapability, error)
+}
+
+// Workers authenticates each request before current runtime/work admission.
+// Admit must supply the host's current admission; active recorded state alone
+// is not an implementation of that port. Protocol receives only its admitted
+// capability. Model SDK, credential staging and listener policy stay outside.
+type Workers struct {
+	Capabilities CapabilitySource
+	Admit        func(context.Context, factory.MCPCapability) (factory.MCPCapability, error)
+	Protocol     func(context.Context, factory.MCPCapability) (http.Handler, error)
+	Now          func() time.Time
+}
+
+func (s Workers) now() time.Time {
+	if s.Now != nil {
+		return s.Now()
+	}
+	return time.Now()
+}
+
+// Handler retains a private copy of the persistent HMAC key. Rotation and run
+// retirement belong to the host/store; request bodies never supply identity.
+func (s Workers) Handler(key []byte) http.Handler {
+	key = append([]byte(nil), key...)
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != WorkerRoute {
+			http.NotFound(w, r)
+			return
+		}
+		if r.Method != http.MethodPost {
+			w.Header().Set("Allow", http.MethodPost)
+			http.Error(w, "method not allowed", http.StatusMethodNotAllowed)
+			return
+		}
+		if r.Header.Get("Origin") != "" {
+			http.Error(w, "origin refused", http.StatusForbidden)
+			return
+		}
+		if s.Capabilities == nil || s.Admit == nil || s.Protocol == nil {
+			http.Error(w, "factory MCP unavailable", http.StatusServiceUnavailable)
+			return
+		}
+		id := r.Header.Get("X-Soda-Factory-Capability")
+		provided, bearer := strings.CutPrefix(r.Header.Get("Authorization"), "Bearer ")
+		if len(key) < 32 || !factory.ValidID(id) || !bearer {
+			http.Error(w, "worker authentication required", http.StatusUnauthorized)
+			return
+		}
+		capability, err := s.Capabilities.GetMCPCapability(r.Context(), id)
+		secret, keyErr := factory.DeriveMCPCapabilitySecret(key, capability)
+		if err != nil || keyErr != nil || capability.ID != id || capability.Validate() != nil || subtle.ConstantTimeCompare([]byte(secret), []byte(provided)) != 1 {
+			http.Error(w, "worker authentication refused", http.StatusUnauthorized)
+			return
+		}
+		admitted, err := s.Admit(r.Context(), capability)
+		if err != nil || r.Context().Err() != nil || admitted.Validate() != nil || admitted.ScopeDigest() != capability.ScopeDigest() || admitted.State != factory.MCPCapabilityActive || admitted.Expired(s.now()) {
+			http.Error(w, "worker context is not active", http.StatusForbidden)
+			return
+		}
+		protocol, err := s.Protocol(r.Context(), admitted)
+		if err != nil || protocol == nil {
+			http.Error(w, "factory MCP unavailable", http.StatusServiceUnavailable)
+			return
+		}
+		if r.Context().Err() != nil {
+			http.Error(w, "worker context is not active", http.StatusForbidden)
+			return
+		}
+		r.Body = http.MaxBytesReader(w, r.Body, factory.MCPMaxSubmissionPayload+8192)
+		protocol.ServeHTTP(w, r)
+	})
+}
+
+// Unavailable returns a generic transport error without exposing configuration,
+// credential-file paths or details from an underlying admission failure.
+func Unavailable() http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		http.Error(w, "factory MCP unavailable", http.StatusServiceUnavailable)
+	})
+}
