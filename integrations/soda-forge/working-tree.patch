@@ -0,0 +1,116 @@
+package service
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"strconv"
+	"time"
+
+	"github.com/levitateos/sodaos/internal/collaboration"
+	"github.com/levitateos/sodaos/internal/factory"
+	"github.com/levitateos/sodaos/internal/store"
+)
+
+// IssueIntakeRequest names the exact current source for a trusted issuer. It
+// contains no provider bearer, session, expiry or execution/spending authority.
+type IssueIntakeRequest struct {
+	Source     string
+	Revision   int64
+	Actor      collaboration.ActorID
+	Repository collaboration.RepositoryID
+	Digest     string
+}
+
+// IssueIntakeCapture records provider-issued post authority in the existing
+// intake journal. The host authenticates issuance and decodes the same proof;
+// neither caller JSON nor stored metadata can issue authority by itself.
+type IssueIntakeCapture struct {
+	Posts     Posts
+	Effects   *CapturedIssueEffects
+	Authorize func(context.Context, IssueIntakeRequest) (factory.IssueIntakeScope, json.RawMessage, error)
+}
+
+func (s IssueIntakeCapture) source(ctx context.Context, actor collaboration.ActorID, id string, revision int64) (IssueIntakeRequest, error) {
+	var empty IssueIntakeRequest
+	if err := ctx.Err(); err != nil {
+		return empty, err
+	}
+	post, err := s.Posts.Store.FeedPost(ctx, id)
+	if err != nil {
+		return empty, err
+	}
+	if post.Record.ID != id || post.Record.Revision != revision || post.Record.Author != strconv.FormatInt(int64(actor), 10) || post.Record.Deleted || post.Record.Revoked {
+		return empty, ErrCapturedIssueSource
+	}
+	if err := s.Posts.visible(ctx, actor, post.Record.Repository); err != nil {
+		return empty, err
+	}
+	captured, err := s.Posts.Store.PostUsesIssueMaker(ctx, id, revision)
+	if err != nil {
+		return empty, err
+	}
+	if !captured {
+		return empty, ErrCapturedIssueSource
+	}
+	return IssueIntakeRequest{Source: id, Revision: revision, Actor: actor, Repository: collaboration.RepositoryID(post.Record.Repository), Digest: factory.MCPInputDigest([]byte(post.Body))}, ctx.Err()
+}
+
+// Capture reuses a still-valid retained proof or issues one for this exact
+// source. Unknown reads/decoding never imply absence or trigger new issuance.
+// Proof bytes stay server-side; no issue mutation or worker/model is launched.
+func (s IssueIntakeCapture) Capture(ctx context.Context, actor collaboration.ActorID, id string, revision int64) error {
+	if s.Posts.Store == nil || s.Posts.Visibility == nil || s.Effects == nil || s.Effects.Store != s.Posts.Store || s.Effects.Decode == nil {
+		return ErrCapturedIssueUnavailable
+	}
+	if actor <= 0 || !factory.ValidID(id) || revision < 0 {
+		return ErrCapturedIssueSource
+	}
+	request, err := s.source(ctx, actor, id, revision)
+	if err != nil {
+		return err
+	}
+	if _, _, err := s.Effects.Grant(ctx, id, revision); err == nil {
+		// Current permission may have changed during the retained proof read.
+		if err := s.Posts.visible(ctx, actor, int64(request.Repository)); err != nil {
+			return err
+		}
+		return ctx.Err()
+	} else if !errors.Is(err, store.ErrNotFound) && !errors.Is(err, ErrCapturedIssueAuthority) {
+		return err
+	}
+	if s.Authorize == nil {
+		return ErrCapturedIssueUnavailable
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	issued, proof, err := s.Authorize(ctx, request)
+	if err != nil {
+		return err
+	}
+	if issued.Validate() != nil || issued.Source != request.Source || issued.Revision != request.Revision || issued.Actor != request.Actor || issued.Repository != request.Repository || issued.Digest != request.Digest || issued.Expires <= time.Now().Unix() || len(proof) == 0 || len(proof) > 8192 || !json.Valid(proof) {
+		return ErrCapturedIssueAuthority
+	}
+	decoded, err := s.Effects.Decode(ctx, bytes.Clone(proof))
+	if err != nil {
+		return err
+	}
+	if decoded != issued {
+		return ErrCapturedIssueAuthority
+	}
+	// Issuance can outlive a source edit, withdrawal or account switch. Re-read
+	// the exact source and current resource permission before the store's CAS.
+	current, err := s.source(ctx, actor, id, revision)
+	if err != nil {
+		return err
+	}
+	if current != request {
+		return ErrCapturedIssueSource
+	}
+	if issued.Expires <= time.Now().Unix() {
+		return ErrCapturedIssueAuthority
+	}
+	return s.Posts.Store.SaveIssueIntakeGrant(ctx, id, revision, issued, proof)
+}
diff --git a/internal/factory/service/issue_maker.go b/internal/factory/service/issue_maker.go
new file mode 100644
index 0000000000000000000000000000000000000000..0106060bb9f377142fc9bed47a58bc70657038a2
--- /dev/null
+++ b/internal/factory/service/issue_maker.go
@@ -0,0 +1,176 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strconv"
+	"strings"
+	"time"
+	"unicode/utf8"
+
+	"github.com/levitateos/sodaos/internal/factory"
+	"github.com/levitateos/sodaos/internal/store"
+)
+
+// IssueMakerEffects supplies current request-scoped authority and conditional
+// issue effects. Implementations own provider proofs, receipts and native IDs.
+type IssueMakerEffects interface {
+	PostIssueCreator
+	AuthorizeIssueMaker(context.Context, factory.IssueMakerScope) error
+	RefineIssueMaker(context.Context, factory.IssueMakerScope, factory.IssueDraft) error
+}
+
+// IssueMaker captures the original request before funded AI refinement.
+// Construction starts no work. Drive resumes the existing intake and journals.
+type IssueMaker struct {
+	Store     *store.Store
+	Effects   IssueMakerEffects
+	Transport PostPlanTransport
+}
+
+// Issue Maker captures first, then refines. Native creation is not held behind
+// a model launch, source preparation or a product decomposition result.
+func originalRequestIssue(comment store.FeedPostDetail) factory.IssueDraft {
+	objective := comment.Body
+	if len(objective) > 2048 {
+		objective = "Implement the original request preserved in this issue."
+	}
+	title := PostDraftTitle(comment.Body)
+	for len(title) > 255 || !utf8.ValidString(title) {
+		title = title[:len(title)-1]
+	}
+	return factory.IssueDraft{
+		SourcePost: comment.Record.ID, Revision: comment.Record.Revision, Title: title,
+		Body:      comment.Body,
+		Objective: objective, Acceptance: "Pending refinement from the original request.", Metadata: `{"source":"feed_comment","role":"issue_maker","refinement":"pending"}`,
+	}
+}
+
+func (s *IssueMaker) Drive(ctx context.Context, pipe factory.PostIntake, comment store.FeedPostDetail) (factory.PostResponse, error) {
+	progress, err := s.Store.StartPostIssueMaker(ctx, comment)
+	if err != nil {
+		return factory.PostResponse{}, err
+	}
+	save := func(state, detail string) error {
+		progress.State, progress.Detail = state, detail
+		return s.Store.SaveIssueMakerProgress(ctx, progress)
+	}
+	if pipe.Effect != factory.PostEffectVerified {
+		if s.Effects == nil {
+			return PostResponse(pipe), save("waiting", "Issue Maker is waiting for repository issue-write access. No issue has been created yet.")
+		}
+		if err := save("creating", "Recording your original request as an issue. AI refinement follows afterward."); err != nil {
+			return factory.PostResponse{}, err
+		}
+		if pipe.AdmitPostDraft() {
+			draft := originalRequestIssue(comment)
+			if err = s.Store.RecordPostDraft(ctx, draft); err != nil {
+				if errors.Is(err, store.ErrInvalidPostDraft) {
+					if saveErr := save("failed", err.Error()); saveErr != nil {
+						return factory.PostResponse{}, saveErr
+					}
+					return PostResponse(pipe), err
+				}
+				return factory.PostResponse{}, err
+			}
+			next := pipe
+			next.Draft = factory.PostDraftApplied
+			if err = s.Store.AdvancePostIntake(ctx, pipe, next); err != nil {
+				return factory.PostResponse{}, err
+			}
+			pipe = next
+		}
+		creator := s.Effects
+		if _, err = DrivePostEffect(ctx, s.Store, creator, pipe, comment); err != nil {
+			return factory.PostResponse{}, err
+		}
+		pipe, err = s.Store.PostIntake(ctx, pipe.SourcePost)
+		if err != nil {
+			return factory.PostResponse{}, err
+		}
+		if pipe.Effect != factory.PostEffectVerified {
+			next := pipe
+			next.Effect = factory.PostEffectFailed
+			if err = s.Store.AdvancePostIntake(ctx, pipe, next); err == nil {
+				pipe = next
+			}
+			state := "waiting"
+			if pipe.Attempts >= factory.PostAttemptLimit {
+				state = "failed"
+			}
+			return PostResponse(pipe), save(state, "Issue Maker could not confirm native issue creation. Restore issue-write access and retry the original request; the recorded operation is reconciled before another creation.")
+		}
+	}
+	if progress.Scope.Issue == 0 {
+		draft, err := s.Store.PostDraft(ctx, pipe.SourcePost, pipe.Revision)
+		if err != nil {
+			return factory.PostResponse{}, err
+		}
+		if err = s.Store.RecordIssueMakerIssue(ctx, progress.Scope, "request", 0, pipe.Issue, draft.Title, PostIssueBody(draft)); err != nil {
+			return factory.PostResponse{}, err
+		}
+		progress, err = s.Store.PostIssueMaker(ctx, pipe.SourcePost, pipe.Revision)
+		if err != nil {
+			return factory.PostResponse{}, err
+		}
+		// Return after the first durable receipt so it is visible before any
+		// preparation or model call is attempted on the next service pass.
+		return PostResponse(pipe), save("queued", fmt.Sprintf("Issue #%d is created. Issue Maker is queued to refine it; no AI run has started yet.", pipe.Issue))
+	}
+	if progress.State == "completed" || progress.State == "failed" {
+		return PostResponse(pipe), nil
+	}
+	if s.Effects == nil {
+		return PostResponse(pipe), save("waiting", "The issue exists. Issue Maker is waiting for repository issue-write access.")
+	}
+	if err := s.Effects.AuthorizeIssueMaker(ctx, progress.Scope); err != nil {
+		return PostResponse(pipe), save("failed", "The issue exists. Its request-scoped write authorization expired before refinement; submit a follow-up request to continue.")
+	}
+	if s.Transport == nil {
+		return PostResponse(pipe), save("waiting", "The initial issue exists. AI refinement is waiting for an available model account.")
+	}
+	drafter := &IntentPostDrafter{Store: s.Store, Transport: s.Transport, IssueMaker: &progress.Scope}
+	draft, err := drafter.DraftPostIssue(ctx, comment)
+	if err != nil {
+		var pending *PostDraftPending
+		if errors.As(err, &pending) {
+			state := pending.Progress.State
+			progress.Run = pending.Progress.Run
+			detail := strings.ReplaceAll(pending.Progress.Detail, "Product Lead", "Issue Maker")
+			if err := save(state, fmt.Sprintf("Issue #%d exists. %s", pipe.Issue, detail)); err != nil {
+				return factory.PostResponse{}, err
+			}
+			return PostResponse(pipe), s.Store.NotePostAuthoring(ctx, pipe.SourcePost, pipe.Revision, pending.Progress, time.Now().Unix())
+		}
+		if ctx.Err() != nil {
+			return PostResponse(pipe), ctx.Err()
+		}
+		return PostResponse(pipe), save("failed", fmt.Sprintf("Issue #%d exists, but refinement failed: %s", pipe.Issue, store.TruncateFeedSummary(err.Error())))
+	}
+	if err = draft.Validate(); err != nil {
+		return PostResponse(pipe), save("failed", "The issue exists, but Issue Maker returned invalid refinement.")
+	}
+	if err = s.Effects.RefineIssueMaker(ctx, progress.Scope, draft); err != nil {
+		// The provider may have committed before losing its reply. Keep this
+		// exact operation eligible for recovery through the existing journal.
+		return PostResponse(pipe), save("unknown", "The issue exists. Its refinement could not be confirmed; the recorded operation will be checked again: "+store.TruncateFeedSummary(err.Error()))
+	}
+	return PostResponse(pipe), save("completed", "Issue Maker finished. Each issue it created is listed in a comment below.")
+}
+
+// PostIssueBody renders the issue body: the recorded draft
+// plus a bounded Soda footer preserving the source-comment link and
+// the work metadata native creation validates.
+func PostIssueBody(draft factory.IssueDraft) string {
+	var footer strings.Builder
+	footer.WriteString("\n\n---\nSoda-Comment: " + draft.SourcePost + " r" + strconv.FormatInt(draft.Revision, 10) + "\n")
+	footer.WriteString("Objective: " + draft.Objective + "\n")
+	footer.WriteString("Acceptance: " + draft.Acceptance + "\n")
+	footer.WriteString("Work-Metadata: " + draft.Metadata + "\n")
+	body := draft.Body + footer.String()
+	if len(body) > 16384+4096 {
+		body = body[:16384+4096]
+	}
+	return body
+}
diff --git a/internal/factory/service/issue_view.go b/internal/factory/service/issue_view.go
new file mode 100644
index 0000000000000000000000000000000000000000..28c227bf5397b02d1e04dac869f43458bbb07662
--- /dev/null
+++ b/internal/factory/service/issue_view.go
@@ -0,0 +1,293 @@
+package service
+
+import (
+	"strconv"
+
+	"github.com/levitateos/sodaos/internal/factory"
+	"github.com/levitateos/sodaos/internal/factory/control"
+)
+
+type IssueView struct {
+	Status       control.AcceptanceValidity `json:"status"`
+	Attempt      *workAttemptView           `json:"attempt,omitempty"`
+	Publication  *workPublicationView       `json:"publication,omitempty"`
+	Closure      workClosureView            `json:"closure"`
+	Capabilities WorkCapabilities           `json:"capabilities"`
+	Requested    *WorkRequested             `json:"requested,omitempty"`
+	Links        *IssueLinks                `json:"links,omitempty"`
+	Repository   string                     `json:"repository"`
+	Issue        string                     `json:"issue"`
+	Journey      *IssueJourney              `json:"journey"`
+	Readiness    *readinessView             `json:"readiness,omitempty"`
+	Checks       *checksView                `json:"checks,omitempty"`
+	Merge        *mergeView                 `json:"merge,omitempty"`
+	ObservedUnix int64                      `json:"observed_unix"`
+}
+
+// readinessView is the durable readiness verdict for one native issue:
+// its classification, primary reason, structured blockers, assessed
+// acceptance and record revision. It carries IDs and codes only.
+type readinessView struct {
+	Blockers   []factory.Blocker `json:"blockers,omitempty"`
+	Acceptance string            `json:"acceptance,omitempty"`
+	Readiness  string            `json:"readiness"`
+	Reason     string            `json:"reason"`
+	Revision   int64             `json:"revision"`
+	Assessed   int64             `json:"assessed_unix"`
+}
+
+// checkResultView renders one required check's verdict: its latest
+// observed native state on the exact head and whether it passes.
+type checkResultView struct {
+	Context string `json:"context"`
+	State   string `json:"state,omitempty"`
+	Passed  bool   `json:"passed"`
+}
+
+// checksView is the latest check assessment for one native PR: whether
+// the exact head and verified base satisfy every configured required
+// check, with the per-check results behind the verdict. It carries IDs,
+// commits, codes and observed states only. Stale marks an assessment
+// whose head is outside the publication's known candidate history.
+type checksView struct {
+	Results    []checkResultView `json:"results"`
+	Resolution string            `json:"resolution"`
+	HeadOID    string            `json:"head_oid"`
+	BaseOID    string            `json:"base_oid"`
+	Verdict    string            `json:"verdict"`
+	Reason     string            `json:"reason"`
+	PRNumber   string            `json:"pr_number"`
+	PRID       string            `json:"pr_id"`
+	Policy     int64             `json:"policy_revision"`
+	NativeRev  int64             `json:"native_revision"`
+	Revision   int64             `json:"revision"`
+	Assessed   int64             `json:"assessed_unix"`
+	Stale      bool              `json:"stale,omitempty"`
+}
+
+// checksViewDTO renders one recorded assessment. Absence of a record
+// leaves the issue without a verdict, never a guessed pass.
+func checksViewDTO(a factory.CheckAssessment) *checksView {
+	view := &checksView{
+		Resolution: factory.CheckResolution(a.Reason),
+		HeadOID:    a.HeadOID, BaseOID: a.BaseOID,
+		Verdict: a.Verdict, Reason: a.Reason,
+		PRNumber: strconv.FormatInt(a.PRNumber, 10), PRID: strconv.FormatInt(a.PRID, 10),
+		Policy: a.PolicyRevision, NativeRev: a.NativeRev, Revision: a.Revision, Assessed: a.AssessedUnix,
+	}
+	for _, result := range a.Results {
+		view.Results = append(view.Results, checkResultView{Context: result.Context, State: result.State, Passed: result.Passed})
+	}
+	return view
+}
+
+// mergeView is the latest merge for one repository issue: its stage,
+// bounded reason, exact PR linkage and confirmed completion stamps. It
+// carries IDs, commits and codes only. Stale marks an open merge whose
+// head is outside the publication's known candidate history; terminal
+// merges stand on the head they finished with.
+type mergeView struct {
+	Resolution string `json:"resolution"`
+	HeadOID    string `json:"head_oid"`
+	BaseOID    string `json:"base_oid"`
+	Commit     string `json:"merged_commit,omitempty"`
+	Stage      string `json:"stage"`
+	Reason     string `json:"reason,omitempty"`
+	PRNumber   string `json:"pr_number"`
+	PRID       string `json:"pr_id"`
+	Revision   int64  `json:"revision"`
+	Finished   int64  `json:"finished_unix,omitempty"`
+	Stale      bool   `json:"stale,omitempty"`
+}
+
+// mergeViewDTO renders one recorded merge. Absence of a record leaves
+// the issue without a merge verdict, never a guessed completion.
+func mergeViewDTO(m factory.Merge) *mergeView {
+	return &mergeView{
+		Resolution: factory.MergeResolution(m.Reason),
+		HeadOID:    m.HeadOID, BaseOID: m.BaseOID, Commit: m.MergedCommit,
+		Stage: m.Stage, Reason: m.Reason,
+		PRNumber: strconv.FormatInt(m.PRNumber, 10), PRID: strconv.FormatInt(m.PRID, 10),
+		Revision: m.Revision, Finished: m.FinishedUnix,
+	}
+}
+
+// workAttemptView is the latest publication-line dispatch attempt for one
+// native issue: its role, stage and run binding. Prompt bytes and held
+// capacity stay on the assignment route; this view carries identity and
+// stage only. Absence of a record means no attempt was dispatched yet.
+type workAttemptView struct {
+	Outcome      factory.Outcome `json:"outcome,omitempty"`
+	ID           string          `json:"id"`
+	Role         string          `json:"role"`
+	Stage        string          `json:"stage"`
+	Reason       string          `json:"reason,omitempty"`
+	Run          string          `json:"run"`
+	Attempts     int             `json:"attempts"`
+	CreatedUnix  int64           `json:"created_unix"`
+	FinishedUnix int64           `json:"finished_unix,omitempty"`
+}
+
+func workAttemptDTO(a factory.Assignment) *workAttemptView {
+	return &workAttemptView{
+		Outcome: a.Outcome,
+		ID:      a.ID, Role: a.Role, Stage: a.Stage, Reason: a.Reason, Run: a.Run,
+		Attempts: a.Attempts, CreatedUnix: a.CreatedUnix, FinishedUnix: a.FinishedUnix,
+	}
+}
+
+// workCorrectionView renders one native branch correction: the candidate
+// it published and its operation effect. Receipt bytes stay out; the
+// candidate commit identifies the corrected content.
+type workCorrectionView struct {
+	Candidate   string `json:"candidate,omitempty"`
+	Effect      string `json:"effect,omitempty"`
+	Completion  string `json:"completion,omitempty"`
+	Reason      string `json:"reason,omitempty"`
+	UpdatedUnix int64  `json:"updated_unix"`
+}
+
+// workReviewView renders one independent review run: the exact head it
+// judged, its disposition and its native outcome. Review prose stays on
+// the native PR; this view carries the disposition and effect only.
+type workReviewView struct {
+	Run        string `json:"run"`
+	HeadOID    string `json:"head_oid"`
+	Event      string `json:"event"`
+	Effect     string `json:"effect,omitempty"`
+	Completion string `json:"completion,omitempty"`
+	Reason     string `json:"reason,omitempty"`
+}
+
+// maxWorkHistoryEntries bounds the rendered correction and review tails.
+// Totals carry the full recorded counts; only the most recent entries
+// render inline.
+const maxWorkHistoryEntries = 20
+
+// workPublicationView renders one attempt's publication: the exact linked
+// PR once creation commits, the candidate and base it binds, and the
+// bounded correction and review history behind it.
+type workPublicationView struct {
+	PublicationOperations
+	Corrections      []workCorrectionView `json:"corrections,omitempty"`
+	Reviews          []workReviewView     `json:"reviews,omitempty"`
+	Candidate        string               `json:"candidate"`
+	BaseSHA          string               `json:"base_sha"`
+	TargetBranch     string               `json:"target_branch"`
+	ID               string               `json:"id"`
+	Run              string               `json:"run"`
+	CorrectionsTotal int                  `json:"corrections_total"`
+	ReviewsTotal     int                  `json:"reviews_total"`
+	CreatedUnix      int64                `json:"created_unix"`
+	FinishedUnix     int64                `json:"finished_unix,omitempty"`
+}
+
+func workPublicationDTO(p factory.Publication) *workPublicationView {
+	view := &workPublicationView{
+		PublicationOperations: *PublicationOperationsView(p),
+		Candidate:             p.Candidate, BaseSHA: p.BaseSHA, TargetBranch: p.TargetBranch,
+		ID: p.ID, Run: p.Run,
+		CorrectionsTotal: len(p.Corrections), ReviewsTotal: len(p.ReviewOperations),
+		CreatedUnix: p.CreatedUnix, FinishedUnix: p.FinishedUnix,
+	}
+	corrections := p.Corrections
+	if len(corrections) > maxWorkHistoryEntries {
+		corrections = corrections[len(corrections)-maxWorkHistoryEntries:]
+	}
+	for _, correction := range corrections {
+		entry := workCorrectionView{
+			Effect: correction.Effect, Completion: correction.Completion,
+			Reason: correction.Reason, UpdatedUnix: correction.UpdatedUnix,
+		}
+		if correction.Work != nil {
+			entry.Candidate = correction.Work.Candidate
+		}
+		view.Corrections = append(view.Corrections, entry)
+	}
+	reviews := p.ReviewOperations
+	if len(reviews) > maxWorkHistoryEntries {
+		reviews = reviews[len(reviews)-maxWorkHistoryEntries:]
+	}
+	for _, review := range reviews {
+		view.Reviews = append(view.Reviews, workReviewView{
+			Run: review.RunID, HeadOID: review.Work.HeadOID, Event: review.Work.Event,
+			Effect: review.Outcome.Effect, Completion: review.Outcome.Completion,
+			Reason: review.Outcome.Reason,
+		})
+	}
+	return view
+}
+
+// workCandidateHistory collects the publication's known candidate commits:
+// its initial candidate plus every committed correction. Review, check
+// and merge evidence names the head it judged; heads outside this set
+// are superseded.
+func workCandidateHistory(p factory.Publication) map[string]bool {
+	history := map[string]bool{}
+	if p.Publish.Work != nil {
+		history[p.Publish.Work.Candidate] = true
+	} else if p.Candidate != "" {
+		history[p.Candidate] = true
+	}
+	for _, correction := range p.Corrections {
+		if correction.Effect == factory.OpEffectCommitted && correction.Work != nil && correction.Work.Candidate != "" {
+			history[correction.Work.Candidate] = true
+		}
+	}
+	delete(history, "")
+	return history
+}
+
+// workClosureStates name the original-issue closure facts. Pending means
+// a PR exists but original closure is unconfirmed; confirmed means the
+// merge recorded the closing occurrence and its timestamp.
+const (
+	workClosureNone      = "none"
+	workClosurePending   = "pending"
+	workClosureConfirmed = "confirmed"
+)
+
+type workClosureView struct {
+	Occurrence string `json:"occurrence,omitempty"`
+	State      string `json:"state"`
+	ClosedUnix int64  `json:"closed_unix,omitempty"`
+}
+
+func workClosureDTO(publication *factory.Publication, merged *factory.Merge) workClosureView {
+	if merged != nil && merged.Stage == factory.MergeMerged && merged.OriginalClosedUnix > 0 && merged.OriginalClosingOccurrence != "" {
+		return workClosureView{Occurrence: merged.OriginalClosingOccurrence, State: workClosureConfirmed, ClosedUnix: merged.OriginalClosedUnix}
+	}
+	if publication != nil && publication.PRNumber > 0 {
+		return workClosureView{State: workClosurePending}
+	}
+	if merged != nil && merged.PRNumber > 0 {
+		return workClosureView{State: workClosurePending}
+	}
+	return workClosureView{State: workClosureNone}
+}
+
+// IssueLinks carries validated host links for the issue and its recorded PR.
+// Missing current navigation metadata leaves links absent.
+type IssueLinks struct {
+	Issue string `json:"issue_url"`
+	Pull  string `json:"pull_url,omitempty"`
+}
+
+// applyWorkStaleness marks check and open-merge evidence whose head is
+// outside the publication's known candidate history. Terminal merges
+// stand on the head they finished with and are never marked stale.
+func applyWorkStaleness(view *IssueView, publication *factory.Publication, merged *factory.Merge) {
+	if publication == nil {
+		return
+	}
+	history := workCandidateHistory(*publication)
+	if len(history) == 0 {
+		return
+	}
+	if view.Checks != nil && !history[view.Checks.HeadOID] {
+		view.Checks.Stale = true
+	}
+	if view.Merge != nil && merged != nil && merged.Stage == factory.MergeOpen && !history[view.Merge.HeadOID] {
+		view.Merge.Stale = true
+	}
+}
diff --git a/internal/factory/service/issues.go b/internal/factory/service/issues.go
new file mode 100644
index 0000000000000000000000000000000000000000..002c047ee1306f64323b237b2ef5a85772dd235f
--- /dev/null
+++ b/internal/factory/service/issues.go
@@ -0,0 +1,150 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"strconv"
+	"time"
+
+	"github.com/levitateos/sodaos/internal/collaboration"
+	"github.com/levitateos/sodaos/internal/factory"
+	"github.com/levitateos/sodaos/internal/factory/control"
+	"github.com/levitateos/sodaos/internal/store"
+)
+
+// IssueStatusReader brackets current provider acceptance evidence. It reads
+// only; it cannot infer acceptance or grant authority from a browser command.
+type IssueStatusReader func(context.Context, collaboration.ActorID, collaboration.RepositoryID, int64) (control.AcceptanceValidity, error)
+
+// IssueNavigation supplies validated host URLs for the recorded issue/PR.
+// Missing navigation leaves links absent rather than guessing provider paths.
+type IssueNavigation func(context.Context, collaboration.ActorID, collaboration.RepositoryID, int64, int64) (*IssueLinks, error)
+
+type Issues struct {
+	Store      *store.Store
+	Visibility WorkVisibility
+	Status     IssueStatusReader
+	Authority  WorkControlAccess
+	Membership WorkRuntimeMembership
+	Navigation IssueNavigation
+}
+
+var (
+	ErrIssueUnavailable = errors.New("issue-work read service is unavailable")
+	ErrIssueVisibility  = errors.New("issue-work is not visible")
+	ErrIssueStatus      = errors.New("current issue acceptance evidence is unavailable")
+)
+
+// Read assembles the complete work response around one recorded owner and
+// publication. No provider mutation, judgment, funding or dispatch is performed.
+func (s Issues) Read(ctx context.Context, actor collaboration.ActorID, repository collaboration.RepositoryID, issue int64) (*IssueView, error) {
+	if actor < 1 || repository < 1 || issue < 1 {
+		return nil, ErrWorkJourneyInvalid
+	}
+	if s.Store == nil || s.Visibility == nil || s.Status == nil || s.Authority == nil || s.Membership == nil {
+		return nil, ErrIssueUnavailable
+	}
+	visible := func() error {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		if err := s.Visibility(ctx, actor, repository); err != nil {
+			return errors.Join(ErrIssueVisibility, err)
+		}
+		return ctx.Err()
+	}
+	if err := visible(); err != nil {
+		return nil, err
+	}
+	status, err := s.Status(ctx, actor, repository, issue)
+	if err != nil {
+		return nil, errors.Join(ErrIssueStatus, err)
+	}
+	index := strconv.FormatInt(issue, 10)
+	if status.Acceptance != nil && (status.Acceptance.Repository != int64(repository) || status.Acceptance.IssueIndex != index) {
+		return nil, ErrWorkJourneyScope
+	}
+	view := &IssueView{Status: status, Repository: strconv.FormatInt(int64(repository), 10), Issue: index}
+	acceptance := ""
+	if recorded, err := s.Store.IssueControl(ctx, int64(repository), issue); err == nil {
+		if recorded.Repository != int64(repository) || recorded.Issue != issue {
+			return nil, ErrWorkJourneyScope
+		}
+		acceptance = recorded.Acceptance
+		view.Readiness = &readinessView{Blockers: recorded.Blockers, Acceptance: recorded.Acceptance, Readiness: recorded.Readiness, Reason: recorded.Reason, Revision: recorded.Revision, Assessed: recorded.AssessedUnix}
+	} else if !errors.Is(err, store.ErrNotFound) {
+		return nil, err
+	}
+
+	var merged *factory.Merge
+	if recorded, err := s.Store.MergeForIssue(ctx, int64(repository), issue); err == nil {
+		if recorded.Repository != int64(repository) || recorded.Issue != issue {
+			return nil, ErrWorkJourneyScope
+		}
+		merged = &recorded
+		view.Merge = mergeViewDTO(recorded)
+	} else if !errors.Is(err, store.ErrNotFound) {
+		return nil, err
+	}
+	var owner *factory.Assignment
+	if recorded, err := s.Store.LatestIssueAssignment(ctx, int64(repository), issue); err == nil {
+		if recorded.Repository != int64(repository) || recorded.Issue != issue {
+			return nil, ErrWorkJourneyScope
+		}
+		owner = &recorded
+		view.Attempt = workAttemptDTO(recorded)
+	} else if !errors.Is(err, store.ErrNotFound) {
+		return nil, err
+	}
+	var publication *factory.Publication
+	if owner != nil {
+		if recorded, err := s.Store.PublicationByAssignment(ctx, owner.ID); err == nil {
+			if recorded.Repository != int64(repository) || recorded.Issue != issue || recorded.AssignmentID != owner.ID {
+				return nil, ErrWorkJourneyScope
+			}
+			publication = &recorded
+			view.Publication = workPublicationDTO(recorded)
+		} else if !errors.Is(err, store.ErrNotFound) {
+			return nil, err
+		}
+	}
+	// Check assessments are keyed by repository/PR, not issue number.
+	pr, prID := int64(0), int64(0)
+	if publication != nil {
+		pr, prID = publication.PRNumber, publication.PRID
+	} else if merged != nil {
+		pr, prID = merged.PRNumber, merged.PRID
+	}
+	if pr > 0 {
+		if recorded, err := s.Store.CheckAssessment(ctx, int64(repository), pr); err == nil {
+			if recorded.Repository != int64(repository) || recorded.PRNumber != pr || prID > 0 && recorded.PRID != prID {
+				return nil, ErrWorkJourneyScope
+			}
+			view.Checks = checksViewDTO(recorded)
+		} else if !errors.Is(err, store.ErrNotFound) {
+			return nil, err
+		}
+	}
+	applyWorkStaleness(view, publication, merged)
+	view.Journey, err = (WorkJourneys{Store: s.Store}).assemble(ctx, int64(repository), issue, index, owner, publication, time.Now().Unix())
+	if err != nil {
+		return nil, err
+	}
+	view.Closure = workClosureDTO(publication, merged)
+	controls, err := (WorkControls{Store: s.Store, Authority: s.Authority, Membership: s.Membership}).project(ctx, actor, repository, issue, owner, acceptance)
+	if err != nil {
+		return nil, err
+	}
+	view.Capabilities, view.Requested = controls.Capabilities, controls.Requested
+	if s.Navigation != nil {
+		view.Links, err = s.Navigation(ctx, actor, repository, issue, pr)
+		if err != nil {
+			return nil, err
+		}
+	}
+	if err := visible(); err != nil {
+		return nil, err
+	}
+	view.ObservedUnix = time.Now().Unix()
+	return view, nil
+}
diff --git a/internal/factory/service/library.go b/internal/factory/service/library.go
new file mode 100644
index 0000000000000000000000000000000000000000..d7223d39ed48f06ade32ea3c5aaafc4b6292d738
--- /dev/null
+++ b/internal/factory/service/library.go
@@ -0,0 +1,151 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"strconv"
+
+	"github.com/levitateos/sodaos/internal/collaboration"
+	"github.com/levitateos/sodaos/internal/factory"
+	"github.com/levitateos/sodaos/internal/store"
+)
+
+// LibrarySource reads the existing projection/revision journal. It neither
+// admits a caller nor mutates knowledge, decisions, tasks or grants.
+type LibrarySource interface {
+	LibrarySearch(context.Context, int64, string, string, string, bool, bool) (factory.LibraryPage, error)
+	LibraryRead(context.Context, int64, string, bool) (factory.LibraryRead, error)
+}
+
+type Library struct {
+	Source     LibrarySource
+	Visibility WorkVisibility
+}
+
+var (
+	ErrLibraryUnavailable = errors.New("project library is unavailable")
+	ErrLibraryVisibility  = errors.New("current project library visibility is required")
+	ErrLibraryNotFound    = errors.New("project library item is unavailable")
+	ErrLibraryScope       = errors.New("library observation does not match its requested scope")
+)
+
+// Browser scope is a string without rewriting retained domain/store JSON.
+type LibraryItemView struct {
+	factory.LibraryItem
+	Repository string `json:"repository"`
+}
+
+type LibraryPageView struct {
+	Items      []LibraryItemView `json:"items"`
+	NextCursor string            `json:"next_cursor,omitempty"`
+	Complete   bool              `json:"complete"`
+}
+
+type LibraryRevisionView struct {
+	Item   LibraryItemView `json:"item"`
+	Reason string          `json:"reason"`
+	Actor  string          `json:"actor"`
+}
+
+type LibraryReadView struct {
+	Item    LibraryItemView       `json:"item"`
+	History []LibraryRevisionView `json:"history"`
+}
+
+func (s Library) visible(ctx context.Context, actor collaboration.ActorID, repository collaboration.RepositoryID) error {
+	if actor < 1 || repository < 1 {
+		return factory.ErrLibraryQuery
+	}
+	if s.Source == nil || s.Visibility == nil {
+		return ErrLibraryUnavailable
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if err := s.Visibility(ctx, actor, repository); err != nil {
+		return errors.Join(ErrLibraryVisibility, err)
+	}
+	return ctx.Err()
+}
+
+func libraryItemView(item factory.LibraryItem, repository collaboration.RepositoryID) (LibraryItemView, error) {
+	if item.Repository != int64(repository) || !factory.ValidID(item.ID) || item.Revision < 1 || (item.Kind != "knowledge" && item.Kind != "decision") {
+		return LibraryItemView{}, ErrLibraryScope
+	}
+	return LibraryItemView{LibraryItem: item, Repository: strconv.FormatInt(int64(repository), 10)}, nil
+}
+
+func (s Library) Search(ctx context.Context, actor collaboration.ActorID, repository collaboration.RepositoryID, query factory.LibraryQuery) (LibraryPageView, error) {
+	var empty LibraryPageView
+	if err := query.Validate(int64(repository)); err != nil {
+		return empty, err
+	}
+	if err := s.visible(ctx, actor, repository); err != nil {
+		return empty, err
+	}
+	page, err := s.Source.LibrarySearch(ctx, int64(repository), query.Query, query.Kind, query.Cursor, query.History, query.CurrentOnly)
+	if err != nil {
+		return empty, err
+	}
+	if len(page.Items) > 50 || (page.Complete && page.NextCursor != "") || (!page.Complete && (len(page.Items) == 0 || page.NextCursor != page.Items[len(page.Items)-1].ID)) {
+		return empty, ErrLibraryScope
+	}
+	out := LibraryPageView{Items: []LibraryItemView{}, NextCursor: page.NextCursor, Complete: page.Complete}
+	previous := query.Cursor
+	for _, item := range page.Items {
+		if item.ID <= previous || (query.Kind != "" && item.Kind != query.Kind) || (!query.History && item.Removed) || (query.CurrentOnly && (item.Removed || item.State == "superseded" || item.State == "retracted")) {
+			return empty, ErrLibraryScope
+		}
+		view, err := libraryItemView(item, repository)
+		if err != nil {
+			return empty, err
+		}
+		out.Items = append(out.Items, view)
+		previous = item.ID
+	}
+	if err := s.visible(ctx, actor, repository); err != nil {
+		return empty, err
+	}
+	return out, nil
+}
+
+func (s Library) Read(ctx context.Context, actor collaboration.ActorID, repository collaboration.RepositoryID, id string, history bool) (LibraryReadView, error) {
+	var empty LibraryReadView
+	if !factory.ValidID(id) {
+		return empty, ErrLibraryNotFound
+	}
+	if err := s.visible(ctx, actor, repository); err != nil {
+		return empty, err
+	}
+	recorded, err := s.Source.LibraryRead(ctx, int64(repository), id, history)
+	if errors.Is(err, store.ErrNotFound) {
+		return empty, ErrLibraryNotFound
+	}
+	if err != nil {
+		return empty, err
+	}
+	if recorded.Item.ID != id || (!history && recorded.Item.Removed) || len(recorded.History) > 20 {
+		return empty, ErrLibraryScope
+	}
+	item, err := libraryItemView(recorded.Item, repository)
+	if err != nil {
+		return empty, err
+	}
+	out := LibraryReadView{Item: item, History: []LibraryRevisionView{}}
+	previous := int64(0)
+	for index, revision := range recorded.History {
+		if revision.Item.ID != id || revision.Item.Revision > recorded.Item.Revision || (index > 0 && revision.Item.Revision >= previous) {
+			return empty, ErrLibraryScope
+		}
+		view, err := libraryItemView(revision.Item, repository)
+		if err != nil {
+			return empty, err
+		}
+		out.History = append(out.History, LibraryRevisionView{Item: view, Reason: revision.Reason, Actor: revision.Actor})
+		previous = revision.Item.Revision
+	}
+	if err := s.visible(ctx, actor, repository); err != nil {
+		return empty, err
+	}
+	return out, nil
+}
diff --git a/internal/factory/service/policies.go b/internal/factory/service/policies.go
new file mode 100644
index 0000000000000000000000000000000000000000..daca6d59e728af2592635f16ae18055590f9863b
--- /dev/null
+++ b/internal/factory/service/policies.go
@@ -0,0 +1,135 @@
+package service
+
+import (
+	"context"
+	"errors"
+
+	"github.com/levitateos/sodaos/internal/collaboration"
+	"github.com/levitateos/sodaos/internal/factory"
+)
+
+// PolicyActor names an existing operation binding. Operation kind is selected
+// by its policy slot, never supplied by the command body.
+type PolicyActor struct {
+	TokenID int64 `json:"token_id,string"`
+	ActorID int64 `json:"actor_id,string"`
+}
+
+type PolicyChange struct {
+	AttemptLimits       *factory.AttemptLimits           `json:"attempt_limits"`
+	Roles               map[string]factory.RoleSelection `json:"roles"`
+	PublishActor        PolicyActor                      `json:"publish_actor"`
+	CreateActor         PolicyActor                      `json:"create_actor"`
+	ReviewActor         PolicyActor                      `json:"review_actor"`
+	ResolveActor        *PolicyActor                     `json:"resolve_actor,omitempty"`
+	MergeActor          PolicyActor                      `json:"merge_actor"`
+	TargetBranch        string                           `json:"target_branch"`
+	MergeMethod         string                           `json:"merge_method"`
+	RequiredChecks      []string                         `json:"required_checks"`
+	ExpectedRevision    int64                            `json:"expected_revision"`
+	ReassessmentMinutes int                              `json:"reassessment_minutes"`
+	IntentMinutes       int                              `json:"intent_minutes"`
+	Enabled             bool                             `json:"enabled"`
+	Paused              bool                             `json:"paused"`
+}
+
+// PolicyWriter retains the existing transactional grant/CAS and withdrawal
+// owner. Applying a policy does not itself enroll accounts or dispatch work.
+type PolicyWriter interface {
+	ApplyPolicy(context.Context, string, factory.RepositoryPolicy) (factory.GrantResult, error)
+}
+
+// PolicyBindingAccess checks that this canonical actor binding belongs to the
+// admitted provider/runtime scope. It does not enroll or replace credentials.
+type PolicyBindingAccess func(context.Context, collaboration.ActorID, collaboration.RepositoryID, factory.ActorBindingRef) error
+
+type Policies struct {
+	Writer        PolicyWriter
+	WriteAccess   RequestWriteAccess
+	BindingAccess PolicyBindingAccess
+}
+
+var (
+	ErrPolicyUnavailable        = errors.New("policy admission is unavailable")
+	ErrPolicyInvalid            = errors.New("repository policy is invalid")
+	ErrPolicyBindingInvalid     = errors.New("policy actor binding is invalid")
+	ErrPolicyBindingUnavailable = errors.New("policy actor scope is unavailable")
+	ErrPolicyResolverActor      = errors.New("resolver must use the independent reviewer account")
+	ErrPolicyAccess             = errors.New("current repository policy authority is required")
+)
+
+func (s Policies) Apply(ctx context.Context, actor collaboration.ActorID, principal string, repository collaboration.RepositoryID, in PolicyChange) (factory.GrantResult, error) {
+	var empty factory.GrantResult
+	if actor < 1 || repository < 1 {
+		return empty, ErrPolicyInvalid
+	}
+	if s.Writer == nil || s.WriteAccess == nil || s.BindingAccess == nil {
+		return empty, ErrPolicyUnavailable
+	}
+	authorize := func() error {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		if err := s.WriteAccess(ctx, actor, int64(repository)); err != nil {
+			return errors.Join(ErrPolicyAccess, err)
+		}
+		return ctx.Err()
+	}
+	if err := authorize(); err != nil {
+		return empty, err
+	}
+	bind := func(a PolicyActor, kind string) (factory.ActorBindingRef, error) {
+		ref := factory.ActorBindingRef{TokenID: a.TokenID, ActorID: a.ActorID, Kind: kind}
+		if err := ref.Validate(); err != nil {
+			return factory.ActorBindingRef{}, errors.Join(ErrPolicyBindingInvalid, err)
+		}
+		if err := s.BindingAccess(ctx, actor, repository, ref); err != nil {
+			return factory.ActorBindingRef{}, err
+		}
+		return ref, nil
+	}
+	publish, err := bind(in.PublishActor, factory.OpRefPublish)
+	if err != nil {
+		return empty, err
+	}
+	create, err := bind(in.CreateActor, factory.OpPRCreate)
+	if err != nil {
+		return empty, err
+	}
+	review, err := bind(in.ReviewActor, factory.OpReviewSubmit)
+	if err != nil {
+		return empty, err
+	}
+	merge, err := bind(in.MergeActor, factory.OpMerge)
+	if err != nil {
+		return empty, err
+	}
+	var resolve factory.ActorBindingRef
+	if in.ResolveActor != nil {
+		resolve, err = bind(*in.ResolveActor, factory.OpThreadResolve)
+		if err != nil {
+			return empty, err
+		}
+		if resolve.ActorID != review.ActorID {
+			return empty, ErrPolicyResolverActor
+		}
+	}
+	policy := factory.RepositoryPolicy{
+		Repository: int64(repository), Revision: in.ExpectedRevision, GrantedBy: int64(actor),
+		Enabled: in.Enabled, Paused: in.Paused, TargetBranch: in.TargetBranch, Roles: in.Roles,
+		Checks: in.RequiredChecks, MergeMethod: in.MergeMethod,
+		Publish: publish, Create: create, Review: review, Resolve: resolve, Merge: merge,
+		AttemptLimits:       factory.EffectiveAttemptLimits(in.AttemptLimits),
+		ReassessmentMinutes: factory.EffectiveReassessmentMinutes(in.ReassessmentMinutes),
+		// Zero remains explicitly unfunded; omission cannot invent intent credit.
+		IntentMinutes: in.IntentMinutes,
+	}
+	if err := policy.Validate(); err != nil {
+		return empty, errors.Join(ErrPolicyInvalid, err)
+	}
+	// Identity/binding reads can outlive current administration or cancellation.
+	if err := authorize(); err != nil {
+		return empty, err
+	}
+	return s.Writer.ApplyPolicy(ctx, principal, policy)
+}
