@@ -0,0 +1,56 @@
+package service
+
+import (
+	"context"
+	"time"
+
+	"github.com/levitateos/sodaos/internal/collaboration"
+	"github.com/levitateos/sodaos/internal/factory"
+	"github.com/levitateos/sodaos/internal/store"
+)
+
+// VerificationAllowance reads only the admitted request owner's allowance.
+// Bound reads retain the same current repository administration requirement as
+// increases. Neither stored ownership nor a saved grant replaces this check.
+func (s Requests) VerificationAllowance(ctx context.Context, actor collaboration.ActorID, intent string) (factory.AppVerificationAllowance, error) {
+	var empty factory.AppVerificationAllowance
+	if actor < 1 {
+		return empty, store.ErrNotFound
+	}
+	if s.Store == nil {
+		return empty, ErrRequestUnavailable
+	}
+	view, err := s.Store.AppVerificationAllowance(ctx, intent, int64(actor), time.Now())
+	if err != nil {
+		return empty, err
+	}
+	if view.Repository > 0 {
+		if err := s.authorizeWrite(ctx, actor, view.Repository); err != nil {
+			return empty, err
+		}
+	}
+	return view, nil
+}
+
+// IncreaseVerificationAllowance uses the existing command journal/CAS. The
+// admitted principal is audit attribution supplied by the host separately from
+// canonical ownership; it is never derived from a browser command body.
+func (s Requests) IncreaseVerificationAllowance(ctx context.Context, actor collaboration.ActorID, intent, principal string, change factory.AppVerificationAllowanceChange) (factory.AppVerificationAllowance, error) {
+	var empty factory.AppVerificationAllowance
+	if actor < 1 {
+		return empty, store.ErrNotFound
+	}
+	if s.Store == nil {
+		return empty, ErrRequestUnavailable
+	}
+	repository, err := s.Store.AppVerificationAllowanceScope(ctx, intent, int64(actor))
+	if err != nil {
+		return empty, err
+	}
+	if repository > 0 {
+		if err := s.authorizeWrite(ctx, actor, repository); err != nil {
+			return empty, err
+		}
+	}
+	return s.Store.IncreaseAppVerificationAllowance(ctx, intent, int64(actor), repository, principal, change, time.Now())
+}
diff --git a/internal/factory/service/requests.go b/internal/factory/service/requests.go
new file mode 100644
index 0000000000000000000000000000000000000000..b4e3ad50e5eef4fe4e6b72733e7553da3182905f
--- /dev/null
+++ b/internal/factory/service/requests.go
@@ -0,0 +1,404 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strconv"
+	"time"
+
+	"github.com/levitateos/sodaos/internal/collaboration"
+	"github.com/levitateos/sodaos/internal/factory"
+	"github.com/levitateos/sodaos/internal/project"
+	"github.com/levitateos/sodaos/internal/store"
+)
+
+// RequestDirection renders the effective direction of one build
+// request: the owner's objective, the delivery approach, the explicit
+// authorized outcome subset and the decision/source counts behind it.
+// Idea bodies stay on the revision read; the overview carries direction
+// and counts only.
+type RequestDirection struct {
+	IdeasByDecision   map[string]int `json:"ideas_by_decision"`
+	IdeasBySource     map[string]int `json:"ideas_by_source"`
+	EffectiveOutcomes []string       `json:"effective_outcomes"`
+	Objective         string         `json:"objective"`
+	Approach          string         `json:"approach,omitempty"`
+	IdeasTotal        int            `json:"ideas_total"`
+	TasksTotal        int            `json:"tasks_total"`
+	Unresolved        int            `json:"unresolved_assumptions"`
+}
+
+func requestDirectionDTO(r factory.IntentRevision) RequestDirection {
+	view := RequestDirection{
+		IdeasByDecision: map[string]int{}, IdeasBySource: map[string]int{},
+		EffectiveOutcomes: append([]string(nil), factory.ResolvedScope(r)...),
+		Objective:         r.Objective, Approach: r.Approach,
+		IdeasTotal: len(r.Ideas), TasksTotal: len(r.Tasks),
+	}
+	if view.EffectiveOutcomes == nil {
+		view.EffectiveOutcomes = []string{}
+	}
+	for _, idea := range r.Ideas {
+		view.IdeasByDecision[idea.Decision]++
+		source := idea.Source
+		if source == "" {
+			// H-I v2: empty source is unclassified unfinished draft
+			// input and infers no authorship.
+			source = "unclassified"
+		}
+		view.IdeasBySource[source]++
+	}
+	view.Unresolved = len(requestUnresolvedAssumptions(r.Ideas))
+	return view
+}
+
+// requestUnresolvedAssumptions returns the IDs of consequential
+// assumptions still awaiting the owner: material assumptions with no
+// recorded decision. Independent authorized work need not wait for
+// them; their dependents stay pending.
+func requestUnresolvedAssumptions(ideas []factory.ProductIdea) []string {
+	unresolved := []string{}
+	for _, idea := range ideas {
+		if idea.Assumption && idea.Material && idea.Decision == "pending" {
+			unresolved = append(unresolved, idea.ID)
+		}
+	}
+	return unresolved
+}
+
+// RequestContext renders the request's exact bound context: the
+// canonical repository and the private department label. Repository "0"
+// means unbound; the draft stays owner-private either way.
+type RequestContext struct {
+	Department string `json:"department,omitempty"`
+	Repository string `json:"repository"`
+}
+
+// RequestMapping renders one task's exact native mapping: the bound
+// native issue and its acceptance. IDs only; native content stays
+// behind native authorization.
+type RequestMapping struct {
+	TaskKey        string `json:"task_key"`
+	IssueID        string `json:"issue_id"`
+	IssueIndex     string `json:"issue_index"`
+	AcceptanceID   string `json:"acceptance_id"`
+	CreatedUnix    int64  `json:"created_unix"`
+	ContentVersion int    `json:"content_version"`
+	Effective      bool   `json:"effective"`
+}
+
+func requestMappingDTO(b factory.IntentTaskBinding, tasks map[string]factory.IntentTask, effective map[string]bool) RequestMapping {
+	view := RequestMapping{
+		TaskKey: b.TaskKey,
+		IssueID: strconv.FormatInt(b.IssueID, 10), IssueIndex: strconv.FormatInt(b.IssueIndex, 10),
+		AcceptanceID: b.AcceptanceID, CreatedUnix: b.CreatedUnix, ContentVersion: b.ContentVersion,
+		Effective: requestMappingEffective(tasks[b.TaskKey], effective),
+	}
+	return view
+}
+
+// requestMappingEffective reports whether one mapped task stays within
+// the revision's explicit authorized outcome subset. An empty subset
+// means legacy unscoped review input and leaves mappings effective.
+func requestMappingEffective(task factory.IntentTask, effective map[string]bool) bool {
+	if len(effective) == 0 {
+		return true
+	}
+	for _, id := range task.IdeaIDs {
+		if !effective[id] {
+			return false
+		}
+	}
+	return true
+}
+
+// requestWorkStates name one mapped work item's evidenced state.
+// Delivered needs verified merge and confirmed original closure;
+// attention names failed, fenced or cancelled work.
+const (
+	requestWorkDelivered = "delivered"
+	requestWorkWorking   = "working"
+	requestWorkWaiting   = "waiting"
+	requestWorkAttention = "attention"
+)
+
+type requestWorkInput struct {
+	AssignmentOutcome   factory.Outcome
+	MergeStage          string
+	HasAssignment       bool
+	HasMerge            bool
+	MergeClosureChecked bool
+}
+
+// requestWorkState derives one work item's state from its recorded
+// attempt and merge facts. It reports evidence only; product-outcome
+// completion is tracked separately and never inferred from closure.
+func requestWorkState(in requestWorkInput) string {
+	if in.HasMerge && in.MergeStage == factory.MergeMerged && in.MergeClosureChecked {
+		return requestWorkDelivered
+	}
+	if in.HasMerge && (in.MergeStage == factory.MergeFailed || in.MergeStage == factory.MergeWithdrawn || in.MergeStage == factory.MergeFenced) {
+		return requestWorkAttention
+	}
+	if in.HasAssignment && (in.AssignmentOutcome == factory.Failed || in.AssignmentOutcome == factory.Cancelled || in.AssignmentOutcome == factory.NeedsHuman) {
+		return requestWorkAttention
+	}
+	if in.HasAssignment || in.HasMerge {
+		return requestWorkWorking
+	}
+	return requestWorkWaiting
+}
+
+// RequestCounts renders evidenced work-item counts plus the
+// separate product-outcome evidence tally. Counts come from recorded
+// facts; several delivered work items may satisfy only part of one
+// accepted product outcome, so no percentage is ever computed.
+type RequestCounts struct {
+	ByState           map[string]int `json:"by_state"`
+	OutcomesTotal     int            `json:"outcomes_total"`
+	OutcomesEvidenced int            `json:"outcomes_evidenced"`
+	Total             int            `json:"total"`
+}
+
+// requestAttentionCodes name what needs the owner on one request.
+const (
+	requestAttentionGeneration = "generation_refused"
+	requestAttentionWork       = "work_attention"
+	requestAttentionAssumption = "unresolved_assumption"
+)
+
+// RequestAttention names one item needing the owner: the code and
+// the affected native issue or product idea where one exists.
+type RequestAttention struct {
+	Code  string `json:"code"`
+	Issue string `json:"issue,omitempty"`
+	Idea  string `json:"idea,omitempty"`
+}
+
+// requestGenerationStates name the native-graph generation facts. The
+// recorded state renders verbatim; not_requested means no generation
+// record exists for the current revision.
+const RequestGenerationAbsent = "not_requested"
+
+type RequestGeneration struct {
+	State string `json:"state"`
+}
+
+// requestSetupStates name the environment setup facts for one request.
+const (
+	RequestSetupUnassigned = "repository_unassigned"
+	RequestSetupMissing    = "project_missing"
+	RequestSetupPreparing  = "preparing"
+	RequestSetupReady      = "ready"
+)
+
+type RequestSetup struct {
+	Project string `json:"project,omitempty"`
+	State   string `json:"state"`
+}
+
+// RequestOverview is the bounded request overview for one
+// owner-private build request: direction, context, native mappings,
+// evidenced work-item counts, attention, generation and setup state.
+// Draft ownership and native repository visibility stay distinct:
+// the read is owner-private, while mappings carry IDs that native
+// authorization still governs.
+type RequestOverview struct {
+	Direction    RequestDirection   `json:"direction"`
+	Context      RequestContext     `json:"context"`
+	Generation   RequestGeneration  `json:"generation"`
+	Setup        RequestSetup       `json:"setup"`
+	WorkItems    RequestCounts      `json:"work_items"`
+	Mappings     []RequestMapping   `json:"mappings"`
+	Attention    []RequestAttention `json:"attention"`
+	Intent       string             `json:"intent"`
+	Revision     string             `json:"revision"`
+	State        string             `json:"state"`
+	ObservedUnix int64              `json:"observed_unix"`
+}
+
+// RequestSetupReader supplies runtime setup facts for a canonical repository.
+// It must not provision environments or dispatch work while serving a read.
+type RequestSetupReader func(context.Context, int64) (RequestSetup, error)
+
+// Requests owns owner-private request reads and saves over the durable store.
+// Hosts supply an admitted canonical actor and current WriteAccess for bound
+// saves and bound verification allowance access. Setup is a read-only runtime
+// port; missing setup cannot be represented as an unprepared or ready environment.
+type Requests struct {
+	Store       *store.Store
+	Setup       RequestSetupReader
+	WriteAccess RequestWriteAccess
+}
+
+var (
+	ErrRequestNotFound         = errors.New("build request not found")
+	ErrRequestUnavailable      = errors.New("request service is unavailable")
+	ErrRequestSetupUnavailable = errors.New("request setup is unavailable")
+	ErrRequestRevisionInvalid  = errors.New("invalid review revision")
+)
+
+// Revision returns the current head only for its admitted canonical owner.
+func (s Requests) Revision(ctx context.Context, actor collaboration.ActorID, intent string) (factory.IntentRevision, error) {
+	if actor <= 0 || !project.ValidDecisionID(intent) {
+		return factory.IntentRevision{}, ErrRequestNotFound
+	}
+	if s.Store == nil {
+		return factory.IntentRevision{}, ErrRequestUnavailable
+	}
+	head, err := s.Store.IntentRevision(ctx, intent, int64(actor))
+	if errors.Is(err, store.ErrNotFound) {
+		return factory.IntentRevision{}, ErrRequestNotFound
+	}
+	return head, err
+}
+
+// SavedRevision reads the exact owner-bound record of an earlier save. A later
+// head does not invalidate that receipt, and the read grants no write authority.
+func (s Requests) SavedRevision(ctx context.Context, actor collaboration.ActorID, intent, revision string) (factory.IntentRevision, error) {
+	var empty factory.IntentRevision
+	if actor <= 0 || !project.ValidDecisionID(intent) || !project.ValidDecisionID(revision) {
+		return empty, ErrRequestNotFound
+	}
+	if s.Store == nil {
+		return empty, ErrRequestUnavailable
+	}
+	result, err := s.Store.SavedIntentRevision(ctx, intent, revision, int64(actor))
+	if errors.Is(err, store.ErrNotFound) {
+		return empty, ErrRequestNotFound
+	}
+	return result, err
+}
+
+// Overview reads recorded facts only. Work delivery and verified product
+// outcomes remain distinct; repository visibility does not grant draft access.
+func (s Requests) Overview(ctx context.Context, actor collaboration.ActorID, intent string) (RequestOverview, error) {
+	var empty RequestOverview
+	revision, err := s.Revision(ctx, actor, intent)
+	if err != nil {
+		return empty, err
+	}
+	view := RequestOverview{
+		Direction:  requestDirectionDTO(revision),
+		Context:    RequestContext{Department: revision.Department, Repository: strconv.FormatInt(revision.Repository, 10)},
+		Generation: RequestGeneration{State: RequestGenerationAbsent},
+		WorkItems:  RequestCounts{ByState: map[string]int{}},
+		Mappings:   []RequestMapping{}, Attention: []RequestAttention{},
+		Intent: revision.Intent, Revision: revision.ID, State: revision.State,
+		ObservedUnix: time.Now().Unix(),
+	}
+	view.WorkItems.OutcomesTotal = len(factory.ResolvedScope(revision))
+	view.WorkItems.OutcomesEvidenced, err = s.Store.VerifiedApplicationOutcomeCount(ctx, revision)
+	if err != nil {
+		return empty, fmt.Errorf("read application verification evidence: %w", err)
+	}
+	if generation, err := s.Store.IntentGeneration(ctx, revision.ID); err == nil {
+		view.Generation.State = generation.State
+		if generation.State == "refused" {
+			view.Attention = append(view.Attention, RequestAttention{Code: requestAttentionGeneration})
+		}
+	} else if !errors.Is(err, store.ErrNotFound) {
+		return empty, fmt.Errorf("read request generation: %w", err)
+	}
+	bindings, err := s.Store.IntentTaskBindings(ctx, revision.ID)
+	if err != nil {
+		return empty, fmt.Errorf("read request mappings: %w", err)
+	}
+	tasks := make(map[string]factory.IntentTask, len(revision.Tasks))
+	for _, task := range revision.Tasks {
+		tasks[task.Key] = task
+	}
+	effective := make(map[string]bool, len(factory.ResolvedScope(revision)))
+	for _, id := range factory.ResolvedScope(revision) {
+		effective[id] = true
+	}
+	for _, id := range requestUnresolvedAssumptions(revision.Ideas) {
+		view.Attention = append(view.Attention, RequestAttention{Code: requestAttentionAssumption, Idea: id})
+	}
+	for _, binding := range bindings {
+		view.Mappings = append(view.Mappings, requestMappingDTO(binding, tasks, effective))
+		state, err := s.WorkItemState(ctx, revision.Repository, binding)
+		if err != nil {
+			return empty, err
+		}
+		view.WorkItems.ByState[state]++
+		view.WorkItems.Total++
+		if state == requestWorkAttention {
+			view.Attention = append(view.Attention, RequestAttention{Code: requestAttentionWork, Issue: strconv.FormatInt(binding.IssueIndex, 10)})
+		}
+	}
+	if revision.Repository <= 0 {
+		view.Setup = RequestSetup{State: RequestSetupUnassigned}
+	} else {
+		if s.Setup == nil {
+			return empty, ErrRequestSetupUnavailable
+		}
+		view.Setup, err = s.Setup(ctx, revision.Repository)
+		if err != nil {
+			return empty, fmt.Errorf("read request setup: %w", err)
+		}
+		switch view.Setup.State {
+		case RequestSetupMissing, RequestSetupPreparing, RequestSetupReady:
+		default:
+			return empty, ErrRequestSetupUnavailable
+		}
+	}
+	return view, nil
+}
+
+// WorkItemState projects an already admitted revision mapping. It does not
+// authorize repository access or expose native issue content.
+func (s Requests) WorkItemState(ctx context.Context, repository int64, binding factory.IntentTaskBinding) (string, error) {
+	if s.Store == nil {
+		return "", ErrRequestUnavailable
+	}
+	var in requestWorkInput
+	if assignment, err := s.Store.LatestIssueAssignment(ctx, repository, binding.IssueIndex); err == nil {
+		in.HasAssignment, in.AssignmentOutcome = true, assignment.Outcome
+	} else if !errors.Is(err, store.ErrNotFound) {
+		return "", fmt.Errorf("read work attempt: %w", err)
+	}
+	if merge, err := s.Store.MergeForIssue(ctx, repository, binding.IssueIndex); err == nil {
+		in.HasMerge, in.MergeStage = true, merge.Stage
+		in.MergeClosureChecked = merge.Stage == factory.MergeMerged && merge.OriginalClosedUnix > 0 && merge.OriginalClosingOccurrence != ""
+	} else if !errors.Is(err, store.ErrNotFound) {
+		return "", fmt.Errorf("read work merge: %w", err)
+	}
+	return requestWorkState(in), nil
+}
+
+// Review reports the saved current/stale/missing review without invoking a
+// judge. Both the request head and any review must belong to the same owner.
+func (s Requests) Review(ctx context.Context, actor collaboration.ActorID, intent, target string) (factory.SavedReviewRead, error) {
+	var empty factory.SavedReviewRead
+	head, err := s.Revision(ctx, actor, intent)
+	if err != nil {
+		return empty, err
+	}
+	if target == "" {
+		target = head.ID
+	}
+	if !project.ValidDecisionID(target) {
+		return empty, ErrRequestRevisionInvalid
+	}
+	var read factory.SavedReviewRead
+	review, err := s.Store.IntentReview(ctx, target, int64(actor))
+	switch {
+	case errors.Is(err, store.ErrNotFound):
+		read = factory.SavedReviewRead{Intent: intent, HeadRevision: head.ID, Status: factory.ReviewMissing}
+	case err != nil:
+		return empty, err
+	case review.Intent != intent:
+		return empty, ErrRequestNotFound
+	default:
+		if err := review.Validate(); err != nil {
+			return empty, err
+		}
+		read = factory.SavedReviewRead{Intent: intent, HeadRevision: head.ID, Status: factory.ClassifyReview(head.ID, target, true), Review: &review}
+	}
+	if err := read.Validate(); err != nil {
+		return empty, err
+	}
+	return read, nil
+}
diff --git a/internal/factory/service/run_output.go b/internal/factory/service/run_output.go
new file mode 100644
index 0000000000000000000000000000000000000000..b51221248abbef2f0889208f2f414d7daa64b37e
--- /dev/null
+++ b/internal/factory/service/run_output.go
@@ -0,0 +1,224 @@
+package service
+
+import (
+	"context"
+	"encoding/base64"
+	"errors"
+
+	"github.com/levitateos/sodaos/internal/collaboration"
+	"github.com/levitateos/sodaos/internal/factory"
+	"github.com/levitateos/sodaos/internal/project"
+	"github.com/levitateos/sodaos/internal/store"
+)
+
+// RunOutput supplies a read-only runtime port over the existing bounded output
+// record. Project in that record is an opaque workspace address. Native sources
+// supply their own output owner and no appliance container/unit facts.
+type RunOutput struct {
+	Store  *store.Store
+	Scope  func(context.Context, collaboration.ActorID, factory.Run) (collaboration.RepositoryID, error)
+	Access func(context.Context, collaboration.ActorID, collaboration.RepositoryID, factory.Run) error
+	Source func(context.Context, collaboration.ActorID, factory.Run, int64, int) (project.FactoryOutputState, error)
+}
+
+var (
+	ErrRunOutputUnavailable = errors.New("run output runtime is unavailable")
+	ErrRunOutputAccess      = errors.New("current run output authority is required")
+	ErrRunOutputMissing     = errors.New("run output is not observed")
+	ErrRunOutputChanged     = errors.New("run output scope or incarnation changed")
+	ErrRunOutputInvalid     = errors.New("run output slice is invalid")
+	ErrRunOutputCursor      = errors.New("run output cursor is invalid")
+)
+
+type OutputAttachment struct {
+	owner                        RunOutput
+	actor                        collaboration.ActorID
+	repository                   collaboration.RepositoryID
+	runID, workspace, invocation string
+	kind                         collaboration.RuntimeKind
+}
+
+// RunID is the immutable run selected when opening this attachment. Transport
+// uses it to refuse a handshake naming another run before any output read.
+func (a *OutputAttachment) RunID() string { return a.runID }
+
+func (s RunOutput) Open(ctx context.Context, actor collaboration.ActorID, runID string) (*OutputAttachment, error) {
+	if actor < 1 || !factory.ValidID(runID) {
+		return nil, factory.ErrNotFound
+	}
+	if s.Store == nil || s.Scope == nil || s.Access == nil || s.Source == nil {
+		return nil, ErrRunOutputUnavailable
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	run, err := s.Store.FactoryRun(ctx, runID)
+	if errors.Is(err, store.ErrNotFound) {
+		return nil, factory.ErrNotFound
+	}
+	if err != nil {
+		return nil, err
+	}
+	if run.ID != runID {
+		return nil, ErrRunOutputChanged
+	}
+	repository, err := s.Scope(ctx, actor, run)
+	if err != nil {
+		return nil, err
+	}
+	if repository < 1 {
+		return nil, ErrRunOutputUnavailable
+	}
+	attachment := &OutputAttachment{owner: s, actor: actor, repository: repository, runID: runID, workspace: run.ProjectID, kind: run.RuntimeKind(), invocation: run.InvocationID()}
+	if _, err := attachment.current(ctx); err != nil {
+		return nil, err
+	}
+	return attachment, nil
+}
+
+// Check performs current scope/admission only; transport heartbeats never launch
+// or resume work. An attachment is owned by one sequential reader.
+func (a *OutputAttachment) Check(ctx context.Context) error {
+	_, err := a.current(ctx)
+	return err
+}
+
+func (a *OutputAttachment) current(ctx context.Context) (factory.Run, error) {
+	var empty factory.Run
+	if err := ctx.Err(); err != nil {
+		return empty, err
+	}
+	run, err := a.owner.Store.FactoryRun(ctx, a.runID)
+	if errors.Is(err, store.ErrNotFound) {
+		return empty, ErrRunOutputMissing
+	}
+	if err != nil {
+		return empty, err
+	}
+	if run.ID != a.runID || run.ProjectID != a.workspace || run.RuntimeKind() != a.kind {
+		return empty, ErrRunOutputChanged
+	}
+	if invocation := run.InvocationID(); invocation != "" && a.invocation != "" && invocation != a.invocation {
+		return empty, ErrRunOutputChanged
+	}
+	repository, err := a.owner.Scope(ctx, a.actor, run)
+	if err != nil {
+		return empty, err
+	}
+	if repository != a.repository {
+		return empty, ErrRunOutputChanged
+	}
+	if err := a.owner.Access(ctx, a.actor, repository, run); err != nil {
+		return empty, errors.Join(ErrRunOutputAccess, err)
+	}
+	if binding, err := a.owner.Store.FactoryRunView(ctx, a.runID); err == nil {
+		if binding.RunID != a.runID || binding.Repository != int64(repository) {
+			return empty, ErrRunOutputChanged
+		}
+	} else if !errors.Is(err, store.ErrNotFound) {
+		return empty, err
+	}
+	if err := ctx.Err(); err != nil {
+		return empty, err
+	}
+	return run, nil
+}
+
+type RunOutputStatus struct {
+	Type       string `json:"type"`
+	RunID      string `json:"run_id"`
+	Phase      string `json:"phase"`
+	Container  string `json:"container"`
+	Unit       string `json:"unit"`
+	Invocation string `json:"invocation"`
+	Reason     string `json:"reason"`
+	Live       bool   `json:"live"`
+	Terminal   bool   `json:"terminal"`
+	ExitCode   *int   `json:"exit_code"`
+}
+
+func (a RunOutputStatus) Same(b RunOutputStatus) bool {
+	if a.ExitCode == nil || b.ExitCode == nil {
+		if a.ExitCode != b.ExitCode {
+			return false
+		}
+	} else if *a.ExitCode != *b.ExitCode {
+		return false
+	}
+	a.ExitCode, b.ExitCode = nil, nil
+	return a == b
+}
+
+type RunOutputFrame struct {
+	Type      string `json:"type"`
+	Data      string `json:"data"`
+	Cursor    int64  `json:"cursor"`
+	Next      int64  `json:"next"`
+	Gap       bool   `json:"gap"`
+	Truncated bool   `json:"truncated"`
+}
+
+type RunOutputClosed struct {
+	Type   string `json:"type"`
+	Reason string `json:"reason"`
+}
+
+type RunOutputSlice struct {
+	Status RunOutputStatus
+	Output *RunOutputFrame
+	Next   int64
+	Done   bool
+}
+
+func (a *OutputAttachment) Read(ctx context.Context, cursor int64) (*RunOutputSlice, error) {
+	if cursor < 0 || cursor > project.MaxFactoryOutputOffset {
+		return nil, ErrRunOutputCursor
+	}
+	run, err := a.current(ctx)
+	if err != nil {
+		return nil, err
+	}
+	out, err := a.owner.Source(ctx, a.actor, run, cursor, project.MaxFactoryOutputRead)
+	if err != nil {
+		return nil, err
+	}
+	if out.ID != a.runID || out.Project != a.workspace || a.kind == collaboration.Native && (out.Container != "" || out.Unit != "") {
+		return nil, ErrRunOutputChanged
+	}
+	expected := a.invocation
+	if invocation := run.InvocationID(); invocation != "" {
+		expected = invocation
+	}
+	if expected != "" && out.Invocation != expected {
+		return nil, ErrRunOutputChanged
+	}
+	if !project.ValidFactoryPhase(out.Phase) || out.Live && out.Terminal || len(out.Container) > 512 || len(out.Unit) > 512 || len(out.Invocation) > 128 || len(out.Reason) > 4096 ||
+		out.Total < 0 || out.Total > project.MaxFactoryOutputOffset || out.Offset < 0 || out.Next < out.Offset || out.Next > out.Total ||
+		(out.Offset != cursor && !out.Gap && !out.Truncated) || len(out.Data) > base64.StdEncoding.EncodedLen(project.MaxFactoryOutputRead) {
+		return nil, ErrRunOutputInvalid
+	}
+	data, err := base64.StdEncoding.DecodeString(out.Data)
+	if err != nil || len(data) > project.MaxFactoryOutputRead || out.Next-out.Offset != int64(len(data)) {
+		return nil, ErrRunOutputInvalid
+	}
+	// No bytes or status from a slow source escape after authority changes.
+	latest, err := a.current(ctx)
+	if err != nil {
+		return nil, err
+	}
+	if invocation := latest.InvocationID(); invocation != "" && invocation != out.Invocation {
+		return nil, ErrRunOutputChanged
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	a.invocation = out.Invocation
+	view := &RunOutputSlice{Status: RunOutputStatus{Type: "status", RunID: a.runID, Phase: out.Phase, Container: out.Container, Unit: out.Unit, Invocation: out.Invocation, Reason: out.Reason, Live: out.Live, Terminal: out.Terminal, ExitCode: out.ExitCode},
+		Next: out.Next, Done: out.Terminal && out.Next >= out.Total}
+	if len(data) != 0 || out.Gap || out.Truncated {
+		// Canonical base64 also bounds JSON escaping when a producer includes
+		// ignored CR/LF bytes in its encoding. Raw bytes and cursors stay exact.
+		view.Output = &RunOutputFrame{Type: "output", Data: base64.StdEncoding.EncodeToString(data), Cursor: out.Offset, Next: out.Next, Gap: out.Gap, Truncated: out.Truncated}
+	}
+	return view, nil
+}
diff --git a/internal/factory/service/run_status.go b/internal/factory/service/run_status.go
new file mode 100644
index 0000000000000000000000000000000000000000..4166d8baedd35ccd19550f34cea4089d73e3e3cd
--- /dev/null
+++ b/internal/factory/service/run_status.go
@@ -0,0 +1,162 @@
+package service
+
+import (
+	"context"
+	"errors"
+
+	"github.com/levitateos/sodaos/internal/collaboration"
+	"github.com/levitateos/sodaos/internal/factory"
+	"github.com/levitateos/sodaos/internal/factory/control"
+	"github.com/levitateos/sodaos/internal/factory/execution"
+	"github.com/levitateos/sodaos/internal/project"
+	"github.com/levitateos/sodaos/internal/store"
+)
+
+// RunAvailability retains the coordinator's current retry/repair admission
+// reader. It cannot launch or retire work and supplies no replacement journal.
+type RunAvailability interface {
+	DeliveryRetryAvailable(context.Context, string) (bool, error)
+	DeliveryRepairAvailable(context.Context, string) (bool, error)
+	EffectiveAuthority(context.Context, int64) (factory.EffectiveAuthority, error)
+}
+
+type RunStatus struct {
+	Store         *store.Store
+	WriteAccess   WorkVisibility
+	RunRepository func(context.Context, collaboration.ActorID, factory.Run) (collaboration.RepositoryID, error)
+	Inspect       func(context.Context, collaboration.ActorID, factory.Run) (execution.RunObservation, error)
+	Availability  RunAvailability
+}
+
+var (
+	ErrRunStatusUnavailable = errors.New("run status runtime is unavailable")
+	ErrRunStatusAccess      = errors.New("current run execution authority is required")
+	ErrRunStatusScope       = errors.New("run display binding differs from its runtime repository")
+	ErrRunStatusContext     = errors.New("saved run context is unavailable")
+	ErrRunStatusObservation = errors.New("run observation is unavailable")
+	ErrRunStatusAuthority   = errors.New("current run authority is unavailable")
+)
+
+func (s RunStatus) Read(ctx context.Context, actor collaboration.ActorID, runID string) (*RunStatusView, error) {
+	if actor < 1 || !factory.ValidID(runID) {
+		return nil, factory.ErrNotFound
+	}
+	if s.Store == nil || s.WriteAccess == nil || s.RunRepository == nil || s.Inspect == nil {
+		return nil, ErrRunStatusUnavailable
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	run, err := s.Store.FactoryRun(ctx, runID)
+	if errors.Is(err, store.ErrNotFound) {
+		return nil, factory.ErrNotFound
+	}
+	if err != nil {
+		return nil, err
+	}
+	if run.ID != runID {
+		return nil, ErrRunStatusScope
+	}
+	repository, err := s.RunRepository(ctx, actor, run)
+	if err != nil {
+		return nil, err
+	}
+	if repository < 1 {
+		return nil, ErrRunStatusUnavailable
+	}
+	authorize := func() error {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		if err := s.WriteAccess(ctx, actor, repository); err != nil {
+			return errors.Join(ErrRunStatusAccess, err)
+		}
+		return ctx.Err()
+	}
+	if err := authorize(); err != nil {
+		return nil, err
+	}
+	status := &RunStatusView{Run: factoryRunRecordDTO(run)}
+	if run.ContextPending && !run.Reconciled && run.Outcome == "" {
+		status.ContextSelection, err = control.ContextSelectionStatus(ctx, s.Store, run)
+		if err != nil {
+			return nil, errors.Join(ErrRunStatusContext, err)
+		}
+	}
+	if binding, err := s.Store.FactoryRunView(ctx, runID); err == nil {
+		if binding.RunID != runID || binding.Repository != int64(repository) {
+			return nil, ErrRunStatusScope
+		}
+		status.View = factoryRunBindingDTO(binding)
+	} else if !errors.Is(err, store.ErrNotFound) {
+		return nil, err
+	}
+	observation, err := s.Inspect(ctx, actor, run)
+	if err == nil {
+		if observation.ValidateFor(execution.RunAddress{Run: runID, Workspace: run.ProjectID}) != nil || observation.Kind != run.RuntimeKind() {
+			return nil, ErrRunStatusObservation
+		}
+		if run.Native != nil {
+			next := *run.Native
+			next.Provenance, next.Retirement = *observation.Native, observation.Retirement
+			if !next.Advances(*run.Native) {
+				return nil, errors.Join(ErrRunStatusObservation, execution.ErrRunChanged)
+			}
+		}
+		status.State = factoryRunLiveDTO(observation)
+	} else if !errors.Is(err, execution.ErrRunNotObserved) {
+		return nil, errors.Join(ErrRunStatusObservation, err)
+	}
+	if status.View != nil && status.View.Issue == "" {
+		if err := s.delivery(ctx, actor, repository, run, status); err != nil {
+			return nil, err
+		}
+	}
+	if err := authorize(); err != nil {
+		return nil, err
+	}
+	return status, nil
+}
+
+func (s RunStatus) delivery(ctx context.Context, actor collaboration.ActorID, repository collaboration.RepositoryID, run factory.Run, status *RunStatusView) error {
+	assignment, err := s.Store.AssignmentByRun(ctx, run.ID)
+	if errors.Is(err, store.ErrNotFound) {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	if assignment.ID != status.View.Attempt || assignment.Run != run.ID || assignment.ProjectID != run.ProjectID || assignment.Repository != int64(repository) || assignment.Issue != 0 || assignment.Phase != project.ExecutionVerify || assignment.Role != project.RoleReviewer || assignment.Subject.Kind != factory.SubjectDelivery || assignment.Subject.Delivery == nil {
+		return nil
+	}
+	if s.Availability == nil {
+		return ErrRunStatusUnavailable
+	}
+	available, err := s.Availability.DeliveryRetryAvailable(ctx, run.ID)
+	if err != nil {
+		return err
+	}
+	if available {
+		effective, err := s.Availability.EffectiveAuthority(ctx, int64(repository))
+		if err != nil {
+			return errors.Join(ErrRunStatusAuthority, err)
+		}
+		available = effective.Effective || len(effective.Missing) == 1 && effective.Missing[0] == factory.MissingDispatch
+	}
+	settled := run.Reconciled && (status.State == nil || !status.State.Live && status.State.Terminal)
+	status.VerificationRetry = &WorkCapability{Available: available && settled}
+	status.DeliveryRepair = &factoryDeliveryRepairView{}
+	if _, err := s.Store.IntentRevision(ctx, assignment.Subject.Delivery.IntentID, int64(actor)); errors.Is(err, store.ErrNotFound) {
+		return nil
+	} else if err != nil {
+		return err
+	}
+	record, err := s.Store.DeliveryRepairRecord(ctx, int64(repository), run.ID)
+	if err == nil {
+		status.DeliveryRepair.Progress, err = deliveryRepairProgressDTO(record, assignment)
+	} else if errors.Is(err, store.ErrNotFound) {
+		status.DeliveryRepair.Available, err = s.Availability.DeliveryRepairAvailable(ctx, run.ID)
+		status.DeliveryRepair.Available = status.DeliveryRepair.Available && settled
+	}
+	return err
+}
diff --git a/internal/factory/service/run_status_view.go b/internal/factory/service/run_status_view.go
new file mode 100644
index 0000000000000000000000000000000000000000..9254f6dc9f27865aa86857e36a6e841b6c35272e
--- /dev/null
+++ b/internal/factory/service/run_status_view.go
@@ -0,0 +1,155 @@
+package service
+
+import (
+	"errors"
+	"github.com/levitateos/sodaos/internal/factory"
+	"github.com/levitateos/sodaos/internal/factory/control"
+	"github.com/levitateos/sodaos/internal/factory/execution"
+	"github.com/levitateos/sodaos/internal/project"
+	"github.com/levitateos/sodaos/internal/store"
+	"math"
+	"strconv"
+	"time"
+)
+
+// factoryRunOutputExcerpt bounds the final-output excerpt carried by the run
+// status read. Live bytes stream through the output route; an ended run
+// exposes its outcome, never a replayable transcript.
+const factoryRunOutputExcerpt = 16 * 1024
+
+// factoryRunRecord carries the recorded run facts a viewer may see. Broker
+// lease internals stay out; live process identity comes from host state.
+type factoryRunRecord struct {
+	Started    time.Time       `json:"started"`
+	Deadline   time.Time       `json:"deadline"`
+	Outcome    factory.Outcome `json:"outcome,omitempty"`
+	ID         string          `json:"id"`
+	ProjectID  string          `json:"project_id"`
+	Role       string          `json:"role"`
+	Harness    string          `json:"harness"`
+	Model      string          `json:"model"`
+	InputSHA   string          `json:"input_sha"`
+	Summary    string          `json:"summary,omitempty"`
+	Reconciled bool            `json:"reconciled"`
+}
+
+func factoryRunRecordDTO(r factory.Run) factoryRunRecord {
+	return factoryRunRecord{
+		Started: r.Started, Deadline: r.Deadline, Outcome: r.Outcome,
+		ID: r.ID, ProjectID: r.ProjectID, Role: r.Role, Harness: r.Harness,
+		Model: r.Model, InputSHA: r.InputSHA, Summary: r.Summary, Reconciled: r.Reconciled,
+	}
+}
+
+// factoryRunBindingDTO renders the display binding with canonical IDs in
+// decimal-string form. An unbound run renders no binding, never a guess.
+type factoryRunBinding struct {
+	Repository string `json:"repository"`
+	Issue      string `json:"issue,omitempty"`
+	Attempt    string `json:"attempt,omitempty"`
+}
+
+func factoryRunBindingDTO(v factory.RunView) *factoryRunBinding {
+	binding := &factoryRunBinding{Repository: strconv.FormatInt(v.Repository, 10)}
+	if v.Issue > 0 {
+		binding.Issue = strconv.FormatInt(v.Issue, 10)
+	}
+	if v.Attempt != "" {
+		binding.Attempt = v.Attempt
+	}
+	return binding
+}
+
+// factoryRunLive carries the observed host state for one run: its phase and
+// exact process binding plus a bounded final-output excerpt.
+type factoryRunLive struct {
+	ExitCode        *int   `json:"exit_code,omitempty"`
+	Live            bool   `json:"live"`
+	Terminal        bool   `json:"terminal"`
+	OutputTruncated bool   `json:"output_truncated"`
+	Phase           string `json:"phase"`
+	Container       string `json:"container,omitempty"`
+	Unit            string `json:"unit,omitempty"`
+	Invocation      string `json:"invocation,omitempty"`
+	Reason          string `json:"reason,omitempty"`
+	Retirement      string `json:"retirement,omitempty"`
+	Output          string `json:"output,omitempty"`
+}
+
+// factoryHostTerminal reports whether a host phase is settled. Uncertain
+// runs stay open: retirement or credential return is still unconfirmed.
+func factoryHostTerminal(phase string) bool {
+	switch phase {
+	case project.FactoryCompleted, project.FactoryFailed, project.FactoryStopped:
+		return true
+	default:
+		return false
+	}
+}
+
+func factoryRunLiveDTO(out execution.RunObservation) *factoryRunLive {
+	live := &factoryRunLive{ExitCode: out.ExitCode, Live: out.Live, Terminal: factoryHostTerminal(out.Phase),
+		Phase: out.Phase, Invocation: out.InvocationID(), Reason: out.Reason, Retirement: string(out.Retirement)}
+	if out.Retirement == execution.Retired {
+		live.Retirement = "confirmed"
+	}
+	if out.Appliance != nil {
+		live.Container, live.Unit = out.Appliance.Invocation.Container, out.Appliance.Invocation.Unit
+	}
+	if len(out.Output) > factoryRunOutputExcerpt {
+		live.Output, live.OutputTruncated = out.Output[:factoryRunOutputExcerpt], true
+	} else {
+		live.Output = out.Output
+	}
+	return live
+}
+
+type RunStatusView struct {
+	Run               factoryRunRecord              `json:"run"`
+	View              *factoryRunBinding            `json:"view,omitempty"`
+	State             *factoryRunLive               `json:"state,omitempty"`
+	ContextSelection  *control.ContextSelectionView `json:"context_selection,omitempty"`
+	VerificationRetry *WorkCapability               `json:"verification_retry,omitempty"`
+	DeliveryRepair    *factoryDeliveryRepairView    `json:"delivery_repair,omitempty"`
+}
+
+type factoryDeliveryRepairView struct {
+	Available bool                           `json:"available"`
+	Progress  *factoryDeliveryRepairProgress `json:"progress,omitempty"`
+}
+
+// Only bounded lifecycle/cause facts leave the private repair journal. Its
+// collector inputs, native source material and adoption packets stay private.
+type factoryDeliveryRepairProgress struct {
+	CauseID      string                         `json:"cause_id"`
+	CycleID      string                         `json:"cycle_id"`
+	FailedRun    string                         `json:"failed_run"`
+	SourceCommit string                         `json:"source_commit"`
+	State        string                         `json:"state"`
+	Reason       string                         `json:"reason,omitempty"`
+	RunID        string                         `json:"run_id,omitempty"`
+	Failures     []factory.CheckFailure         `json:"failures"`
+	FailureCount int                            `json:"failure_count"`
+	Judgment     *factoryDeliveryRepairJudgment `json:"judgment,omitempty"`
+}
+
+type factoryDeliveryRepairJudgment struct {
+	Option      string  `json:"option"`
+	Probability float64 `json:"accept_probability"`
+	Confidence  float64 `json:"confidence"`
+}
+
+func deliveryRepairProgressDTO(record store.DeliveryRepairRecord, assignment factory.Assignment) (*factoryDeliveryRepairProgress, error) {
+	cause, cycle := record.Cause, record.Cycle
+	if assignment.Subject.Delivery == nil || cause.FailedAssignmentID != assignment.ID || cause.FailedVerificationRunID != assignment.Run || cause.Repository != assignment.Repository || cause.ProjectID != assignment.ProjectID || cause.Delivery != *assignment.Subject.Delivery {
+		return nil, errors.New("repair progress differs from its failed verification")
+	}
+	view := &factoryDeliveryRepairProgress{CauseID: factory.DeliveryRepairCauseID(assignment.Run), CycleID: cycle.ID, FailedRun: assignment.Run, SourceCommit: cause.Delivery.SourceCommit, State: cycle.State, Reason: cycle.Reason, RunID: cycle.RunID, Failures: cause.Report.Failures[:min(8, len(cause.Report.Failures))], FailureCount: len(cause.Report.Failures)}
+	if cycle.ProposalOption != "" {
+		if cycle.ProposalOption != factory.ReassessmentOptionAccept && cycle.ProposalOption != factory.ReassessmentOptionNeedsAttention || math.IsNaN(cycle.ProposalProbability) || math.IsInf(cycle.ProposalProbability, 0) || cycle.ProposalProbability < 0 || cycle.ProposalProbability > 1 || math.IsNaN(cycle.ProposalConfidence) || math.IsInf(cycle.ProposalConfidence, 0) || cycle.ProposalConfidence < 0 || cycle.ProposalConfidence > 1 {
+			return nil, errors.New("repair progress has an invalid judgment")
+		}
+		view.Judgment = &factoryDeliveryRepairJudgment{Option: cycle.ProposalOption, Probability: cycle.ProposalProbability, Confidence: cycle.ProposalConfidence}
+	}
+	return view, nil
+}
diff --git a/internal/factory/service/runtime_grants.go b/internal/factory/service/runtime_grants.go
new file mode 100644
index 0000000000000000000000000000000000000000..367a4afc7169b68d33f4369539112c53579a3406
--- /dev/null
+++ b/internal/factory/service/runtime_grants.go
@@ -0,0 +1,123 @@
+package service
+
+import (
+	"context"
+	"errors"
+
+	"github.com/levitateos/sodaos/internal/collaboration"
+	"github.com/levitateos/sodaos/internal/factory"
+	"github.com/levitateos/sodaos/internal/project"
+)
+
+// RuntimeGrantWriter retains the existing transactional revisions, dispatch
+// withdrawal and publication/merge cancellation owner. Saving permission does
+// not provision an environment or start work.
+type RuntimeGrantWriter interface {
+	ApplyCapacity(context.Context, string, factory.Capacity) (factory.GrantResult, error)
+	ApplyOperatorGrant(context.Context, string, factory.OperatorGrant) (factory.GrantResult, error)
+	ApplyEnvironmentGrant(context.Context, string, project.EnvironmentGrant) (factory.GrantResult, error)
+}
+
+type CapacityChange struct {
+	ExpectedRevision  int64 `json:"expected_revision"`
+	MaxConcurrentRuns int   `json:"max_concurrent_runs"`
+}
+
+type OperatorGrantChange struct {
+	ExpectedRevision int64 `json:"expected_revision"`
+	Active           bool  `json:"active"`
+}
+
+type EnvironmentGrantChange struct {
+	Profile          *project.Profile `json:"profile"`
+	Project          string           `json:"project,omitempty"`
+	ExpectedRevision int64            `json:"expected_revision"`
+	Active           bool             `json:"active"`
+}
+
+// RuntimeGrants separates admitted canonical attribution from the host's
+// authenticated principal. Neither is selected by a command body. OperatorAccess
+// checks current host administration; EnvironmentAccess checks current repository
+// environment ownership. An operator grant additionally requires Visibility.
+type RuntimeGrants struct {
+	Writer            RuntimeGrantWriter
+	OperatorAccess    func(context.Context, collaboration.ActorID) error
+	Visibility        WorkVisibility
+	EnvironmentAccess WorkVisibility
+}
+
+var (
+	ErrRuntimeGrantUnavailable   = errors.New("runtime grant admission is unavailable")
+	ErrRuntimeGrantAccess        = errors.New("current runtime grant authority is required")
+	ErrRuntimeCapacityInvalid    = errors.New("runtime capacity is invalid")
+	ErrRuntimeOperatorInvalid    = errors.New("runtime operator grant is invalid")
+	ErrRuntimeEnvironmentInvalid = errors.New("runtime environment grant is invalid")
+)
+
+func (s RuntimeGrants) ApplyCapacity(ctx context.Context, actor collaboration.ActorID, principal string, in CapacityChange) (factory.GrantResult, error) {
+	var empty factory.GrantResult
+	capacity := factory.Capacity{Revision: in.ExpectedRevision, UpdatedBy: int64(actor), MaxConcurrentRuns: in.MaxConcurrentRuns}
+	if principal == "" || capacity.Validate() != nil {
+		return empty, ErrRuntimeCapacityInvalid
+	}
+	if s.Writer == nil || s.OperatorAccess == nil {
+		return empty, ErrRuntimeGrantUnavailable
+	}
+	if err := ctx.Err(); err != nil {
+		return empty, err
+	}
+	if err := s.OperatorAccess(ctx, actor); err != nil {
+		return empty, errors.Join(ErrRuntimeGrantAccess, err)
+	}
+	if err := ctx.Err(); err != nil {
+		return empty, err
+	}
+	return s.Writer.ApplyCapacity(ctx, principal, capacity)
+}
+
+func (s RuntimeGrants) ApplyOperatorGrant(ctx context.Context, actor collaboration.ActorID, principal string, repository collaboration.RepositoryID, in OperatorGrantChange) (factory.GrantResult, error) {
+	var empty factory.GrantResult
+	grant := factory.OperatorGrant{Repository: int64(repository), Revision: in.ExpectedRevision, GrantedBy: int64(actor), Active: in.Active}
+	if principal == "" || grant.Validate() != nil {
+		return empty, ErrRuntimeOperatorInvalid
+	}
+	if s.Writer == nil || s.OperatorAccess == nil || s.Visibility == nil {
+		return empty, ErrRuntimeGrantUnavailable
+	}
+	if err := ctx.Err(); err != nil {
+		return empty, err
+	}
+	if err := s.Visibility(ctx, actor, repository); err != nil {
+		return empty, errors.Join(ErrRuntimeGrantAccess, err)
+	}
+	// Visibility can require a provider round trip. Check the host's current
+	// operator permission after it, immediately before the transactional writer.
+	if err := s.OperatorAccess(ctx, actor); err != nil {
+		return empty, errors.Join(ErrRuntimeGrantAccess, err)
+	}
+	if err := ctx.Err(); err != nil {
+		return empty, err
+	}
+	return s.Writer.ApplyOperatorGrant(ctx, principal, grant)
+}
+
+func (s RuntimeGrants) ApplyEnvironmentGrant(ctx context.Context, actor collaboration.ActorID, principal string, repository collaboration.RepositoryID, in EnvironmentGrantChange) (factory.GrantResult, error) {
+	var empty factory.GrantResult
+	grant := project.EnvironmentGrant{Repository: int64(repository), Revision: in.ExpectedRevision, Owner: int64(actor), Profile: in.Profile, Project: in.Project, Active: in.Active}
+	if principal == "" || grant.Validate() != nil {
+		return empty, ErrRuntimeEnvironmentInvalid
+	}
+	if s.Writer == nil || s.EnvironmentAccess == nil {
+		return empty, ErrRuntimeGrantUnavailable
+	}
+	if err := ctx.Err(); err != nil {
+		return empty, err
+	}
+	if err := s.EnvironmentAccess(ctx, actor, repository); err != nil {
+		return empty, errors.Join(ErrRuntimeGrantAccess, err)
+	}
+	if err := ctx.Err(); err != nil {
+		return empty, err
+	}
+	return s.Writer.ApplyEnvironmentGrant(ctx, principal, grant)
+}
diff --git a/internal/factory/service/sponsorships.go b/internal/factory/service/sponsorships.go
new file mode 100644
index 0000000000000000000000000000000000000000..b6ecc44d522ffbe743bd91cdbcfda0fecdfd9f14
--- /dev/null
+++ b/internal/factory/service/sponsorships.go
@@ -0,0 +1,122 @@
+package service
+
+import (
+	"context"
+	"errors"
+
+	"github.com/levitateos/sodaos/internal/collaboration"
+	"github.com/levitateos/sodaos/internal/factory"
+	"github.com/levitateos/sodaos/internal/identity"
+	"github.com/levitateos/sodaos/internal/project"
+	"github.com/levitateos/sodaos/internal/store"
+)
+
+type SponsorshipChange struct {
+	ExpectedRevision int64    `json:"expected_revision"`
+	Roles            []string `json:"roles"`
+	AllowanceMinutes int      `json:"allowance_minutes"`
+	Active           bool     `json:"active"`
+}
+
+// SponsorshipCustody contains nonsecret broker facts for one currently owned
+// connection and this repository's runtime. Grant.UserID is the broker's execution
+// actor, not the canonical sponsor. Project retains the existing opaque runtime
+// reference; the host alone resolves its native binding and connection ownership.
+type SponsorshipCustody struct {
+	Repository collaboration.RepositoryID
+	Connection string
+	Project    string
+	Generation int64
+	Grants     []identity.Grant
+}
+
+type SponsorshipWriter interface {
+	ApplySponsorship(context.Context, string, factory.Sponsorship) (factory.GrantResult, error)
+}
+
+type Sponsorships struct {
+	Store      *store.Store
+	Writer     SponsorshipWriter
+	Visibility WorkVisibility
+	Custody    func(context.Context, collaboration.ActorID, collaboration.RepositoryID, string) (SponsorshipCustody, error)
+}
+
+var (
+	ErrSponsorshipInvalid           = errors.New("sponsorship is invalid")
+	ErrSponsorshipUnavailable       = errors.New("sponsorship admission is unavailable")
+	ErrSponsorshipAccess            = errors.New("current sponsorship visibility is required")
+	ErrSponsorshipBrokerUnavailable = errors.New("sponsorship custody is unavailable")
+	ErrSponsorshipConnectionMissing = errors.New("sponsorship connection was not found")
+	ErrSponsorshipOwnerRequired     = errors.New("current connection ownership is required")
+	ErrSponsorshipGrantUnavailable  = errors.New("sponsorship requires a live runtime grant")
+)
+
+func (s Sponsorships) Apply(ctx context.Context, actor collaboration.ActorID, principal string, repository collaboration.RepositoryID, connection string, in SponsorshipChange) (factory.GrantResult, error) {
+	var empty factory.GrantResult
+	if actor < 1 || repository < 1 || principal == "" || connection == "" || len(connection) > 128 || in.ExpectedRevision < 0 {
+		return empty, ErrSponsorshipInvalid
+	}
+	if s.Store == nil || s.Writer == nil || s.Visibility == nil || s.Custody == nil {
+		return empty, ErrSponsorshipUnavailable
+	}
+	authorize := func() error {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		if err := s.Visibility(ctx, actor, repository); err != nil {
+			return errors.Join(ErrSponsorshipAccess, err)
+		}
+		return ctx.Err()
+	}
+	if err := authorize(); err != nil {
+		return empty, err
+	}
+	previous := ""
+	stored, err := s.Store.Sponsorship(ctx, int64(repository), connection)
+	if err == nil {
+		if stored.Repository != int64(repository) || stored.Connection != connection {
+			return empty, ErrSponsorshipUnavailable
+		}
+		previous = stored.GrantID
+	} else if !errors.Is(err, store.ErrNotFound) {
+		// Unknown continuity cannot be treated as absence and select a new grant.
+		return empty, err
+	}
+	custody, err := s.Custody(ctx, actor, repository, connection)
+	if err != nil {
+		return empty, err
+	}
+	if custody.Repository != repository || custody.Connection != connection || custody.Generation < 1 || !project.ValidID(custody.Project) {
+		return empty, ErrSponsorshipBrokerUnavailable
+	}
+	var selected identity.Grant
+	for _, grant := range custody.Grants {
+		if grant.ConnectionID != connection || grant.ProjectID != custody.Project || grant.Revoked || grant.UserID < 1 || grant.Revision < 0 || grant.ID == "" || len(grant.ID) > 128 {
+			continue
+		}
+		if grant.ID == previous {
+			selected = grant
+			break
+		}
+		if selected.ID == "" || grant.Revision > selected.Revision {
+			selected = grant
+		}
+	}
+	if selected.ID == "" {
+		return empty, ErrSponsorshipGrantUnavailable
+	}
+	sponsorship := factory.Sponsorship{
+		Repository: int64(repository), Revision: in.ExpectedRevision, GrantedBy: int64(actor),
+		Connection: connection, Roles: in.Roles, AllowanceMinutes: in.AllowanceMinutes, Active: in.Active,
+		GrantID: selected.ID, Generation: custody.Generation, ActorID: selected.UserID, ProjectID: selected.ProjectID,
+	}
+	if err := sponsorship.Validate(); err != nil {
+		return empty, errors.Join(ErrSponsorshipInvalid, err)
+	}
+	// Broker reads can outlive visibility or caller cancellation. Neither a
+	// recorded sponsorship nor its previous grant bypasses current admission.
+	if err := authorize(); err != nil {
+		return empty, err
+	}
+	return s.Writer.ApplySponsorship(ctx, principal, sponsorship)
+}
diff --git a/internal/factory/service/work_capabilities_view.go b/internal/factory/service/work_capabilities_view.go
new file mode 100644
index 0000000000000000000000000000000000000000..83fa2aa9a7b207ebfdc195bf9e34e89562ff16cf
--- /dev/null
+++ b/internal/factory/service/work_capabilities_view.go
@@ -0,0 +1,153 @@
+package service
+
+// workCapabilityReasons are the bounded codes behind one action
+// capability. Authority codes describe the viewer; state codes describe
+// the recorded work. Admission revalidates at act time.
+const (
+	WorkWriteRequired        = "repository_write_required"
+	WorkNotVisible           = "repository_not_visible"
+	WorkAuthorityUnavailable = "native_authority_unavailable"
+	workCapSession           = "session_changed"
+	workCapNoRun             = "no_run"
+	workCapUnsettled         = "run_unsettled"
+	workCapSettled           = "run_settled"
+	workCapRetryQueued       = "retry_queued"
+	workCapMembership        = "membership_required"
+	workCapDispatchOpen      = "dispatch_open"
+	workCapDispatchShut      = "dispatch_closed"
+)
+
+type WorkCapability struct {
+	Reason    string `json:"reason,omitempty"`
+	Available bool   `json:"available"`
+}
+
+// WorkCapabilities reports the viewer's current intervention powers
+// for one issue: read-only watch, run stop/retry/takeover and repository
+// pause/resume. Each entry carries its refusal reason when unavailable;
+// the owning lifecycle APIs remain authoritative at act time.
+type WorkCapabilities struct {
+	Watch    WorkCapability `json:"watch"`
+	Stop     WorkCapability `json:"stop"`
+	Retry    WorkCapability `json:"retry"`
+	Takeover WorkCapability `json:"takeover"`
+	Pause    WorkCapability `json:"pause"`
+	Resume   WorkCapability `json:"resume"`
+}
+
+type workCapabilityInput struct {
+	AuthorityReason string
+	HasRun          bool
+	RunSettled      bool
+	RetryQueued     bool
+	Member          bool
+	DispatchOpen    bool
+	SessionCurrent  bool
+}
+
+func workCapabilityGates(in workCapabilityInput) (mutating, attempt string) {
+	mutating = in.AuthorityReason
+	if mutating == "" && !in.SessionCurrent {
+		mutating = workCapSession
+	}
+	attempt = mutating
+	if attempt == "" {
+		switch {
+		case !in.HasRun:
+			attempt = workCapNoRun
+		case !in.RunSettled:
+			attempt = workCapUnsettled
+		}
+	}
+	return mutating, attempt
+}
+
+func workStopCapability(in workCapabilityInput, mutating string) WorkCapability {
+	view := WorkCapability{Available: mutating == "" && in.HasRun && !in.RunSettled}
+	switch {
+	case mutating != "":
+		view.Reason = mutating
+	case !in.HasRun:
+		view.Reason = workCapNoRun
+	case in.RunSettled:
+		view.Reason = workCapSettled
+	}
+	return view
+}
+
+func workRetryCapability(in workCapabilityInput, attempt string) WorkCapability {
+	view := WorkCapability{Available: attempt == "" && !in.RetryQueued}
+	switch {
+	case attempt != "":
+		view.Reason = attempt
+	case in.RetryQueued:
+		view.Reason = workCapRetryQueued
+	}
+	return view
+}
+
+func workTakeoverCapability(in workCapabilityInput, attempt string) WorkCapability {
+	view := WorkCapability{Available: attempt == "" && in.Member}
+	switch {
+	case attempt != "":
+		view.Reason = attempt
+	case !in.Member:
+		view.Reason = workCapMembership
+	}
+	return view
+}
+
+func workPauseCapability(in workCapabilityInput, mutating string) WorkCapability {
+	view := WorkCapability{Available: mutating == "" && in.DispatchOpen}
+	switch {
+	case mutating != "":
+		view.Reason = mutating
+	case !in.DispatchOpen:
+		view.Reason = workCapDispatchShut
+	}
+	return view
+}
+
+func workResumeCapability(in workCapabilityInput, mutating string) WorkCapability {
+	view := WorkCapability{Available: mutating == "" && !in.DispatchOpen}
+	switch {
+	case mutating != "":
+		view.Reason = mutating
+	case in.DispatchOpen:
+		view.Reason = workCapDispatchOpen
+	}
+	return view
+}
+
+func workCapabilitiesDTO(in workCapabilityInput) WorkCapabilities {
+	view := WorkCapabilities{}
+	view.Watch = WorkCapability{Available: in.AuthorityReason == "" || in.AuthorityReason == WorkWriteRequired}
+	if !view.Watch.Available {
+		view.Watch.Reason = in.AuthorityReason
+	}
+	if !in.SessionCurrent {
+		view.Watch = WorkCapability{Reason: workCapSession}
+	}
+	mutating, attempt := workCapabilityGates(in)
+	view.Stop = workStopCapability(in, mutating)
+	view.Retry = workRetryCapability(in, attempt)
+	view.Takeover = workTakeoverCapability(in, attempt)
+	view.Pause = workPauseCapability(in, mutating)
+	view.Resume = workResumeCapability(in, mutating)
+	return view
+}
+
+// workRetryRequestView renders a queued explicit retry: the requested
+// control, distinct from the confirmed attempt outcome it follows.
+type workRetryRequestView struct {
+	CommandID string `json:"command_id"`
+	Reason    string `json:"reason"`
+	Prior     string `json:"prior_run"`
+	Queued    bool   `json:"queued"`
+}
+
+// WorkRequested carries requested controls that are not confirmed
+// effects. Empty means no control request is outstanding.
+type WorkRequested struct {
+	Retry *workRetryRequestView `json:"retry,omitempty"`
+}
diff --git a/internal/factory/service/work_controls.go b/internal/factory/service/work_controls.go
new file mode 100644
index 0000000000000000000000000000000000000000..b2b5efbfdbd1b8e6a18f8522ac7afafe6a051ffc
--- /dev/null
+++ b/internal/factory/service/work_controls.go
@@ -0,0 +1,133 @@
+package service
+
+import (
+	"context"
+	"errors"
+
+	"github.com/levitateos/sodaos/internal/collaboration"
+	"github.com/levitateos/sodaos/internal/factory"
+	"github.com/levitateos/sodaos/internal/store"
+)
+
+// WorkAuthority describes current execution authority, separately from read
+// visibility. Write-required may still permit watching the admitted repository.
+type WorkAuthority struct {
+	Reason         string
+	SessionCurrent bool
+}
+
+type WorkControlAccess func(context.Context, collaboration.ActorID, collaboration.RepositoryID) (WorkAuthority, error)
+type WorkRuntimeMembership func(context.Context, collaboration.ActorID, collaboration.RepositoryID, string) (bool, error)
+
+type WorkControls struct {
+	Store      *store.Store
+	Visibility WorkVisibility
+	Authority  WorkControlAccess
+	Membership WorkRuntimeMembership
+}
+
+type WorkControlView struct {
+	Capabilities WorkCapabilities `json:"capabilities"`
+	Requested    *WorkRequested   `json:"requested,omitempty"`
+}
+
+var (
+	ErrWorkControlUnavailable = errors.New("work control capabilities are unavailable")
+	ErrWorkControlVisibility  = errors.New("work controls are not visible")
+)
+
+// Read projects possible controls, never authority to execute them. The actual
+// lifecycle command rechecks its own current admission when a human acts.
+func (s WorkControls) Read(ctx context.Context, actor collaboration.ActorID, repository collaboration.RepositoryID, issue int64) (WorkControlView, error) {
+	var empty WorkControlView
+	if actor < 1 || repository < 1 || issue < 1 {
+		return empty, ErrWorkJourneyInvalid
+	}
+	if s.Store == nil || s.Visibility == nil || s.Authority == nil || s.Membership == nil {
+		return empty, ErrWorkControlUnavailable
+	}
+	visible := func() error {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		if err := s.Visibility(ctx, actor, repository); err != nil {
+			return errors.Join(ErrWorkControlVisibility, err)
+		}
+		return ctx.Err()
+	}
+	if err := visible(); err != nil {
+		return empty, err
+	}
+	acceptance := ""
+	if recorded, err := s.Store.IssueControl(ctx, int64(repository), issue); err == nil {
+		if recorded.Repository != int64(repository) || recorded.Issue != issue {
+			return empty, ErrWorkJourneyScope
+		}
+		acceptance = recorded.Acceptance
+	} else if !errors.Is(err, store.ErrNotFound) {
+		return empty, err
+	}
+	var owner *factory.Assignment
+	if recorded, err := s.Store.LatestIssueAssignment(ctx, int64(repository), issue); err == nil {
+		if recorded.Repository != int64(repository) || recorded.Issue != issue {
+			return empty, ErrWorkJourneyScope
+		}
+		owner = &recorded
+	} else if !errors.Is(err, store.ErrNotFound) {
+		return empty, err
+	}
+	view, err := s.project(ctx, actor, repository, issue, owner, acceptance)
+	if err != nil {
+		return empty, err
+	}
+	if err := visible(); err != nil {
+		return empty, err
+	}
+	return view, nil
+}
+
+// project uses the composite issue read's already scoped recorded owner.
+func (s WorkControls) project(ctx context.Context, actor collaboration.ActorID, repository collaboration.RepositoryID, issue int64, attempt *factory.Assignment, acceptance string) (WorkControlView, error) {
+	var empty WorkControlView
+	in := workCapabilityInput{}
+	var requested *WorkRequested
+	var err error
+	if attempt != nil {
+		if run, err := s.Store.FactoryRun(ctx, attempt.Run); err == nil {
+			in.HasRun, in.RunSettled = true, run.Reconciled
+		} else if !errors.Is(err, store.ErrNotFound) {
+			return empty, err
+		}
+		if acceptance != "" {
+			if decision, err := s.Store.PendingExplicitRetry(ctx, int64(repository), issue, acceptance); err == nil {
+				in.RetryQueued = true
+				requested = &WorkRequested{Retry: &workRetryRequestView{CommandID: decision.CommandID, Reason: decision.Reason, Prior: decision.Prior, Queued: decision.Queued}}
+			} else if !errors.Is(err, store.ErrNotFound) && !errors.Is(err, store.ErrExplicitRetryIneligible) {
+				return empty, err
+			}
+		}
+		in.Member, err = s.Membership(ctx, actor, repository, attempt.ProjectID)
+		if err != nil {
+			return empty, err
+		}
+	}
+	open, _, _, err := s.Store.DispatchState(ctx, int64(repository))
+	if err != nil {
+		return empty, err
+	}
+	in.DispatchOpen = open
+	authority, err := s.Authority(ctx, actor, repository)
+	if err != nil {
+		return empty, err
+	}
+	switch authority.Reason {
+	case "", WorkWriteRequired, WorkNotVisible, WorkAuthorityUnavailable:
+	default:
+		return empty, ErrWorkControlUnavailable
+	}
+	in.AuthorityReason, in.SessionCurrent = authority.Reason, authority.SessionCurrent
+	if err := ctx.Err(); err != nil {
+		return empty, err
+	}
+	return WorkControlView{Capabilities: workCapabilitiesDTO(in), Requested: requested}, nil
+}
diff --git a/internal/factory/service/work_journey_read.go b/internal/factory/service/work_journey_read.go
new file mode 100644
index 0000000000000000000000000000000000000000..a451f5b1c423a593f117f237b759072ade5332a2
--- /dev/null
+++ b/internal/factory/service/work_journey_read.go
@@ -0,0 +1,657 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"strconv"
+
+	"github.com/levitateos/sodaos/internal/factory"
+	"github.com/levitateos/sodaos/internal/factory/control"
+	"github.com/levitateos/sodaos/internal/project"
+	"github.com/levitateos/sodaos/internal/store"
+)
+
+// journeyChainPageLimit reuses the assignment paging window behind one
+// acceptance; journeyChainMaxPages bounds how many windows one issue
+// read follows. A cut chain reports chain_page_bound with its resume
+// cursor instead of rendering a partial head as the whole lineage.
+const (
+	journeyChainPageLimit = 256
+	journeyChainMaxPages  = 4
+)
+
+// assemble renders the one recorded journey subsection for
+// the existing issue read from real persisted records only. It binds
+// the repository and issue, the current acceptance head, the selected
+// owner assignment acceptance, and the actual attempt root (the latest
+// row may be a child; the journey never implicitly re-roots). It reads
+// only and spends nothing: no judgment, provision or dispatch.
+//
+// Storage failures return an error for the existing 503 pattern, except
+// a missing attempt, which renders explicit available/complete=false.
+// Rows that decode but fail their journey DTO name their incomplete
+// reason instead of dropping silently; backing that was never recorded
+// (no plan, no PR, pending funded calls) leaves its section empty.
+func (s WorkJourneys) assemble(ctx context.Context, repository, index int64, issue string, owner *factory.Assignment, publication *factory.Publication, observedUnix int64) (*IssueJourney, error) {
+	view := &IssueJourney{
+		Phases:        []journeyPhaseView{},
+		Tasks:         []journeyTaskView{},
+		Commits:       []journeyCommitView{},
+		Findings:      []journeyFindingView{},
+		Corrections:   []journeyCorrectionView{},
+		Judgments:     []journeyJudgmentView{},
+		Gates:         []journeyGateView{},
+		Adoptions:     []journeyAdoptionView{},
+		Delivered:     []journeyDeliveredTaskView{},
+		Verifications: []journeyVerifiedAppView{},
+		Repository:    strconv.FormatInt(repository, 10), Issue: issue,
+		ObservedUnix: observedUnix,
+	}
+	head, err := s.Store.AcceptanceHead(ctx, repository, index)
+	if err != nil {
+		if !errors.Is(err, store.ErrNotFound) {
+			return nil, err
+		}
+		head = ""
+	}
+	latest, err := s.Store.LatestIssueAttempt(ctx, repository, index)
+	if err != nil && !errors.Is(err, store.ErrNotFound) {
+		return nil, err
+	}
+	if owner == nil {
+		if err == nil {
+			return nil, errors.New("journey attempt lacks its root assignment")
+		}
+		view.Lineage.Head = head
+		view.Reasons = addJourneyReason(view.Reasons, journeyReasonNoAttempt)
+		return view, nil
+	}
+	view.Available = true
+	view.Lineage.Head, view.Lineage.Acceptance = head, owner.Acceptance
+	view.Lineage.AttemptRoot, view.Lineage.RootAssignment = owner.AttemptRoot, owner.ID
+	view.Lineage.Run, view.Lineage.SourceCommit = owner.Run, owner.SourceCommit
+	view.Lineage.RunHistory = append([]string(nil), owner.RunHistory...)
+	view.Lineage.Stale = head != "" && head != owner.Acceptance
+	if err == nil {
+		view.Lineage.LatestAssignment, view.Lineage.LatestRun = latest.ID, latest.Run
+		if latest.Acceptance != owner.Acceptance {
+			view.Reasons = addJourneyReason(view.Reasons, journeyReasonLatestAcceptanceMismatch)
+		}
+	}
+	if publication != nil {
+		applyJourneyPublicationLineage(&view.Lineage, publication)
+	}
+	if err := s.journeyPhaseSection(ctx, view, repository, index, owner); err != nil {
+		return nil, err
+	}
+	if err := s.journeyTaskSection(ctx, view, owner.AttemptRoot, issue); err != nil {
+		return nil, err
+	}
+	applyJourneyPublicationSections(view, publication)
+	if err := s.journeyCycleSections(ctx, view, repository, index); err != nil {
+		return nil, err
+	}
+	if err := s.journeyEvidenceSections(ctx, view, repository, index, owner, publication); err != nil {
+		return nil, err
+	}
+	view.Complete = len(view.Reasons) == 0
+	return view, nil
+}
+
+// journeyEvidenceSections closes the four evidence joins from canonical
+// records. Adoptions render from the intent task bindings that adopted
+// this native issue (intent + revision with the exact task binding,
+// state adopted: a binding is recorded only after native readback
+// confirmed the issue). Delivered-task evidence renders the canonical
+// completion behind each adoption binding. Verified applications render
+// the F10 trusted check behind each adopted revision. Delivery proof
+// renders from the publication's journaled delivery acceptances:
+// a clean-review acceptance is its own evidence and renders no funded
+// judgment; a Jev acceptance renders its funded delivery judgment only
+// when the recorded receipt joins on the exact publication, attempt
+// root, round and tuple. A section without rendered proof keeps its
+// unavailable reason, so the full merged journey never reports
+// complete on missing evidence. Delivered and verified evidence is only
+// expected once an adoption exists.
+func (s WorkJourneys) journeyEvidenceSections(ctx context.Context, view *IssueJourney, repository, index int64, owner *factory.Assignment, publication *factory.Publication) error {
+	recorded, err := s.journeyAdoptionSection(ctx, view, repository, index)
+	if err != nil {
+		return err
+	}
+	if err := s.journeyDeliveredSection(ctx, view, repository, recorded); err != nil {
+		return err
+	}
+	if err := s.journeyVerifiedSection(ctx, view, repository, recorded); err != nil {
+		return err
+	}
+	return s.journeyDeliverySection(ctx, view, owner, publication)
+}
+
+func (s WorkJourneys) journeyAdoptionSection(ctx context.Context, view *IssueJourney, repository, index int64) ([]store.JourneyAdoption, error) {
+	recorded, truncated, err := s.Store.JourneyAdoptions(ctx, repository, index, maxJourneyAdoptions)
+	if err != nil {
+		return nil, err
+	}
+	adoptions := make([]journeyAdoptionView, 0, len(recorded))
+	invalid := false
+	for _, adoption := range recorded {
+		rendered, err := journeyAdoptionDTO(adoption.Intent, adoption.Revision, journeyAdoptionAdopted,
+			adoption.Binding.TaskKey, strconv.FormatInt(adoption.Binding.IssueIndex, 10), adoption.Binding.AcceptanceID)
+		if err != nil {
+			invalid = true
+			continue
+		}
+		adoptions = append(adoptions, rendered)
+	}
+	if invalid {
+		view.Reasons = addJourneyReason(view.Reasons, journeyReasonAdoptionsInvalidRow)
+	}
+	if truncated {
+		view.Reasons = addJourneyReason(view.Reasons, journeyReasonAdoptionsTruncated)
+	}
+	if len(adoptions) == 0 {
+		view.Reasons = addJourneyReason(view.Reasons, journeyReasonAdoptionsUnavailable)
+	}
+	view.Adoptions = nonNilJourney(adoptions, []journeyAdoptionView{})
+	return recorded, nil
+}
+
+// journeyDeliveredSection renders the delivered-task evidence behind
+// the recorded adoptions: the canonical completion event for each
+// adoption binding's native issue and acceptance. Rows render in
+// adoption order; an unchanged task that rebinds a successor revision
+// with the same issue and acceptance yields one completion, not one
+// row per historical binding: delivered evidence deduplicates by the
+// exact task, issue, acceptance and completion identity while the
+// adoption section keeps both bindings visible as history. When an
+// adoption has no recorded completion the section keeps its
+// unavailable reason instead of passing a partial chain as the whole
+// lineage. With no adoptions there is no adopted task to deliver, so
+// the section stays empty without a reason.
+func (s WorkJourneys) journeyDeliveredSection(ctx context.Context, view *IssueJourney, repository int64, recorded []store.JourneyAdoption) error {
+	if len(recorded) == 0 {
+		return nil
+	}
+	delivered := make([]journeyDeliveredTaskView, 0, len(recorded))
+	seen := make(map[string]bool, len(recorded))
+	invalid := false
+	missing := false
+	for _, adoption := range recorded {
+		event, err := s.Store.JourneyDeliveredCompletion(ctx, repository, adoption.Binding.IssueIndex, adoption.Binding.AcceptanceID)
+		if err != nil {
+			if errors.Is(err, store.ErrNotFound) {
+				missing = true
+				continue
+			}
+			return err
+		}
+		rendered, err := journeyDeliveredTaskDTO(adoption.Binding.TaskKey,
+			strconv.FormatInt(adoption.Binding.IssueIndex, 10), adoption.Binding.AcceptanceID,
+			event.ID, event.PublicationID, event.Generation)
+		if err != nil {
+			invalid = true
+			continue
+		}
+		key := adoption.Binding.TaskKey + "\x00" + strconv.FormatInt(adoption.Binding.IssueIndex, 10) + "\x00" + adoption.Binding.AcceptanceID + "\x00" + event.ID
+		if seen[key] {
+			continue
+		}
+		seen[key] = true
+		delivered = append(delivered, rendered)
+	}
+	if invalid {
+		view.Reasons = addJourneyReason(view.Reasons, journeyReasonDeliveriesInvalidRow)
+	}
+	if missing || len(delivered) == 0 {
+		view.Reasons = addJourneyReason(view.Reasons, journeyReasonDeliveriesUnavailable)
+	}
+	view.Delivered = nonNilJourney(delivered, []journeyDeliveredTaskView{})
+	return nil
+}
+
+// journeyVerifiedSection renders the verified application revision
+// behind each adopted intent revision: the exact revision whose
+// trusted application check passed, once per revision in adoption
+// order. When an adopted revision has no recorded F10 verification
+// the section keeps its unavailable reason instead of reporting the
+// chain verified on worker claims. With no adoptions there is no
+// adopted revision to verify, so the section stays empty without
+// a reason.
+func (s WorkJourneys) journeyVerifiedSection(ctx context.Context, view *IssueJourney, repository int64, recorded []store.JourneyAdoption) error {
+	if len(recorded) == 0 {
+		return nil
+	}
+	seen := make(map[string]bool, len(recorded))
+	verifications := make([]journeyVerifiedAppView, 0, len(recorded))
+	invalid := false
+	missing := false
+	for _, adoption := range recorded {
+		if seen[adoption.Revision] {
+			continue
+		}
+		seen[adoption.Revision] = true
+		verified, err := s.Store.JourneyVerifiedApp(ctx, repository, adoption.Intent, adoption.Revision)
+		if err != nil {
+			if errors.Is(err, store.ErrNotFound) {
+				missing = true
+				continue
+			}
+			return err
+		}
+		rendered, err := journeyVerifiedAppDTO(verified.Intent, verified.Revision, verified.SourceCommit, verified.Manifest)
+		if err != nil {
+			invalid = true
+			continue
+		}
+		verifications = append(verifications, rendered)
+	}
+	if invalid {
+		view.Reasons = addJourneyReason(view.Reasons, journeyReasonVerificationsInvalidRow)
+	}
+	if missing || len(verifications) == 0 {
+		view.Reasons = addJourneyReason(view.Reasons, journeyReasonVerificationsUnavailable)
+	}
+	view.Verifications = nonNilJourney(verifications, []journeyVerifiedAppView{})
+	return nil
+}
+
+func (s WorkJourneys) journeyDeliverySection(ctx context.Context, view *IssueJourney, owner *factory.Assignment, publication *factory.Publication) error {
+	if publication == nil || len(publication.DeliveryAcceptances) == 0 {
+		view.Reasons = addJourneyReason(view.Reasons, journeyReasonDeliveryUnavailable)
+		return nil
+	}
+	var receipts []factory.DeliveryReceipt
+	receiptsTruncated := false
+	for _, acceptance := range publication.DeliveryAcceptances {
+		if acceptance.Kind != factory.AcceptanceJevAcceptance {
+			continue
+		}
+		var err error
+		receipts, receiptsTruncated, err = s.Store.DeliveryJudgmentsForPublication(
+			ctx, publication.ID, owner.AttemptRoot, maxJourneyJudgments)
+		if err != nil {
+			return err
+		}
+		break
+	}
+	if receiptsTruncated {
+		view.Reasons = addJourneyReason(view.Reasons, journeyReasonJudgmentsTruncated)
+	}
+	linked, unlinked := false, false
+	deliveries := make([]journeyJudgmentView, 0, len(publication.DeliveryAcceptances))
+	for _, acceptance := range publication.DeliveryAcceptances {
+		if acceptance.Validate() != nil || acceptance.PublicationID != publication.ID ||
+			acceptance.AttemptRoot != owner.AttemptRoot {
+			unlinked = true
+			continue
+		}
+		if acceptance.Kind == factory.AcceptanceCleanReview {
+			linked = true
+			continue
+		}
+		rendered, ok := journeyDeliveryJudgment(acceptance, receipts)
+		if !ok {
+			unlinked = true
+			continue
+		}
+		deliveries = append(deliveries, rendered)
+		linked = true
+	}
+	if len(deliveries) > 0 {
+		// Delivery precedes completion reassessment in the loop, so its
+		// judgments render before the cycle judgments.
+		view.Judgments = append(deliveries, view.Judgments...)
+		if len(view.Judgments) > maxJourneyJudgments {
+			view.Judgments = view.Judgments[len(view.Judgments)-maxJourneyJudgments:]
+			view.Reasons = addJourneyReason(view.Reasons, journeyReasonJudgmentsTruncated)
+		}
+	}
+	if !linked || unlinked {
+		view.Reasons = addJourneyReason(view.Reasons, journeyReasonDeliveryUnavailable)
+	}
+	return nil
+}
+
+// journeyDeliveryJudgment renders the funded delivery judgment behind
+// one Jev delivery acceptance: the unique decided receipt over the
+// acceptance's exact round and tuple whose effective action is ready.
+// A missing, undecided or mismatched receipt renders nothing, never a
+// fabricated judgment from the acceptance alone.
+func journeyDeliveryJudgment(acceptance factory.DeliveryAcceptance, receipts []factory.DeliveryReceipt) (journeyJudgmentView, bool) {
+	for _, receipt := range receipts {
+		if receipt.Outcome != factory.DeliveryOutcomeDecided ||
+			receipt.Decision.Effective != factory.DeliveryEffectiveReady ||
+			receipt.Input.Round != acceptance.Round ||
+			receipt.Input.Head != acceptance.Tuple.Head ||
+			receipt.Input.Base != acceptance.Tuple.Base {
+			continue
+		}
+		answer := receipt.Decision.Answer
+		rendered, err := journeyJudgmentDTO(journeyJudgmentDelivery, answer.Selected, answer.Model,
+			answer.Confidence, answer.Probability, false, "", nil)
+		if err != nil {
+			return journeyJudgmentView{}, false
+		}
+		return rendered, true
+	}
+	return journeyJudgmentView{}, false
+}
+
+// applyJourneyPublicationLineage binds the recorded candidate, the
+// recorded historical head/base tuple and the native operation refs.
+// Recorded bases render as history; the read never re-resolves them.
+func applyJourneyPublicationLineage(lineage *journeyLineageView, publication *factory.Publication) {
+	lineage.Candidate = publication.Candidate
+	lineage.PublishOp, lineage.PRCreateOp = publication.Publish.OperationID, publication.PRCreate.OperationID
+	if publication.PRNumber > 0 {
+		lineage.PRNumber = strconv.FormatInt(publication.PRNumber, 10)
+	}
+	if publication.PRID > 0 {
+		lineage.PRID = strconv.FormatInt(publication.PRID, 10)
+	}
+	if publication.Tuple != nil {
+		lineage.TupleHead, lineage.TupleBase, lineage.TupleDiffBase = publication.Tuple.Head, publication.Tuple.Base, publication.Tuple.DiffBase
+	}
+}
+
+// journeyPhaseSection renders the CURRENT state of the selected owner
+// attempt lineage: exactly one state per canonical phase, each bound to
+// the newest recorded assignment carrying that phase under the
+// selected AttemptRoot, in stable canonical order. A newer retry storm
+// on one phase cannot displace another phase, a sibling AttemptRoot
+// sharing the acceptance cannot leak in, and no old capped prefix ever
+// stands in for current state. Unknown or empty phases and ref-less
+// contributing rows name phases_invalid_row instead of dropping
+// silently and never fabricate a phase. A cut group read names
+// phases_truncated. Unreadable storage returns its error for the
+// existing 503 pattern.
+func (s WorkJourneys) journeyPhaseSection(ctx context.Context, view *IssueJourney, repository, index int64, owner *factory.Assignment) error {
+	trail, next, pageBound, err := s.journeyChain(ctx, repository, index, owner.Acceptance)
+	if err != nil {
+		return err
+	}
+	view.Lineage.ChainCursors = trail
+	if pageBound {
+		view.Lineage.NextCursor = next
+		view.Reasons = addJourneyReason(view.Reasons, journeyReasonChainPageBound)
+	}
+	groups, truncated, err := s.Store.LatestPhaseAttempts(ctx, repository, index, owner.Acceptance, owner.AttemptRoot)
+	if err != nil {
+		return err
+	}
+	if truncated {
+		view.Reasons = addJourneyReason(view.Reasons, journeyReasonPhasesTruncated)
+	}
+	current := make(map[string]factory.Assignment, len(journeyCanonicalPhases))
+	for _, group := range groups {
+		assignment := group.Assignment
+		if !project.ValidExecutionPhase(assignment.Phase) {
+			view.Reasons = addJourneyReason(view.Reasons, journeyReasonPhasesInvalidRow)
+			continue
+		}
+		current[assignment.Phase] = assignment
+	}
+	phases := make([]journeyPhaseView, 0, len(journeyCanonicalPhases))
+	for _, phase := range journeyCanonicalPhases {
+		assignment, ok := current[phase]
+		if !ok {
+			continue
+		}
+		rendered, err := journeyPhaseEntryDTO(phase, journeyAssignmentState(assignment),
+			assignment.ID, assignment.Run, assignment.AttemptRoot)
+		if err != nil {
+			view.Reasons = addJourneyReason(view.Reasons, journeyReasonPhasesInvalidRow)
+			continue
+		}
+		phases = append(phases, rendered)
+	}
+	view.Phases = nonNilJourney(phases, []journeyPhaseView{})
+	return nil
+}
+
+// journeyChain pages one acceptance lineage oldest-first through the
+// stable seq keyset until the window stops advancing. It returns the
+// page cursor trail, the resume cursor and whether the page bound cut
+// the read. The trail is retained lineage history behind the rendered
+// window; the phase section itself always reads current-per-phase, so
+// a cut here never passes old head rows as current.
+func (s WorkJourneys) journeyChain(ctx context.Context, repository, index int64, acceptance string) ([]string, string, bool, error) {
+	var trail []string
+	after := ""
+	for page := 0; ; page++ {
+		if page == journeyChainMaxPages {
+			return trail, after, true, nil
+		}
+		got, next, err := s.Store.AcceptanceAssignmentsAfter(ctx, repository, index, acceptance, after, journeyChainPageLimit)
+		if err != nil {
+			return nil, "", false, err
+		}
+		// The trail holds every advanced cursor, so a cut names the
+		// newest cursor reached as its resume ref.
+		advanced := next != "" && next != after
+		if advanced {
+			after = next
+			trail = append(trail, after)
+		}
+		if len(got) < journeyChainPageLimit || !advanced {
+			return trail, after, false, nil
+		}
+	}
+}
+
+// journeyTaskSection renders the admitted plan's tasks with their
+// receipt states. A missing head, revision or receipt set means no
+// plan was recorded and leaves the section empty; malformed task rows
+// name their reason. Only the tail window renders past the cap.
+func (s WorkJourneys) journeyTaskSection(ctx context.Context, view *IssueJourney, attemptRoot, issue string) error {
+	headID, _, err := s.Store.PlanHead(ctx, attemptRoot)
+	if err != nil {
+		if errors.Is(err, store.ErrNotFound) {
+			return nil
+		}
+		return err
+	}
+	plan, err := s.Store.InvestigationPlan(ctx, attemptRoot, headID)
+	if err != nil {
+		if errors.Is(err, store.ErrNotFound) {
+			return nil
+		}
+		return err
+	}
+	receipts, err := s.Store.PlanTaskReceipts(ctx, attemptRoot, headID)
+	if err != nil {
+		if errors.Is(err, store.ErrNotFound) {
+			receipts = nil
+		} else {
+			return err
+		}
+	}
+	byTask := make(map[string]store.PlanTaskReceipt, len(receipts))
+	for _, receipt := range receipts {
+		byTask[receipt.TaskID] = receipt
+	}
+	tasks := make([]journeyTaskView, 0, len(plan.Tasks))
+	invalid := false
+	for _, task := range plan.Tasks {
+		state := journeyPending
+		if receipt, ok := byTask[task.ID]; ok {
+			switch receipt.State {
+			case store.PlanTaskCompleted:
+				state = journeyComplete
+			case store.PlanTaskFailed, store.PlanTaskCancelled:
+				state = journeyAttention
+			case store.PlanTaskRunning, store.PlanTaskOutputReady:
+				state = journeyActive
+			}
+		}
+		lane := task.Lane
+		if lane != journeyLaneA && lane != journeyLaneB && lane != journeyLaneC {
+			lane = journeyLaneUnassigned
+		}
+		rendered, err := journeyTaskDTO(task.ID, lane, issue, state)
+		if err != nil {
+			invalid = true
+			continue
+		}
+		tasks = append(tasks, rendered)
+	}
+	if invalid {
+		view.Reasons = addJourneyReason(view.Reasons, journeyReasonTasksInvalidRow)
+	}
+	if len(tasks) > maxJourneyTasks {
+		tasks = tasks[len(tasks)-maxJourneyTasks:]
+		view.Reasons = addJourneyReason(view.Reasons, journeyReasonTasksTruncated)
+	}
+	view.Tasks = nonNilJourney(tasks, []journeyTaskView{})
+	return nil
+}
+
+// applyJourneyPublicationSections renders the publication candidate,
+// its correction operations and its journaled correction findings from
+// the passed record. The candidate commit binds with the RECORDED
+// creation base; the read never calls that base live-fresh. A linked
+// PR that fails its DTO is malformed history, while no linked PR yet
+// means nothing was recorded. Unsubmitted operations carry no
+// observations and stay out.
+func applyJourneyPublicationSections(view *IssueJourney, publication *factory.Publication) {
+	if publication == nil {
+		return
+	}
+	if publication.PRNumber > 0 {
+		commit, err := journeyCommitDTO(publication.Candidate, publication.PRCreate.BaseOID,
+			strconv.FormatInt(publication.PRNumber, 10), strconv.FormatInt(publication.PRID, 10))
+		if err != nil {
+			view.Reasons = addJourneyReason(view.Reasons, journeyReasonCommitsInvalidRow)
+		} else {
+			view.Commits = []journeyCommitView{commit}
+		}
+	}
+	corrections := make([]journeyCorrectionView, 0, len(publication.Corrections))
+	invalidCorrection := false
+	for _, op := range publication.Corrections {
+		if op.Work == nil && op.Effect == "" && op.Completion == "" && op.Reason == "" {
+			continue
+		}
+		candidate := ""
+		if op.Work != nil {
+			candidate = op.Work.Candidate
+		}
+		correction, err := journeyCorrectionDTO(candidate, op.Effect, op.Completion, op.Reason)
+		if err != nil {
+			invalidCorrection = true
+			continue
+		}
+		corrections = append(corrections, correction)
+	}
+	if invalidCorrection {
+		view.Reasons = addJourneyReason(view.Reasons, journeyReasonCorrectionsInvalidRow)
+	}
+	if len(corrections) > maxJourneyCorrections {
+		corrections = corrections[len(corrections)-maxJourneyCorrections:]
+		view.Reasons = addJourneyReason(view.Reasons, journeyReasonCorrectionsTruncated)
+	}
+	view.Corrections = nonNilJourney(corrections, []journeyCorrectionView{})
+	findings := make([]journeyFindingView, 0)
+	invalidFinding := false
+	for _, journal := range publication.CorrectionJournals {
+		for _, finding := range journal.Report.Findings {
+			rendered, err := journeyFindingDTO(finding)
+			if err != nil {
+				invalidFinding = true
+				continue
+			}
+			findings = append(findings, rendered)
+		}
+	}
+	if invalidFinding {
+		view.Reasons = addJourneyReason(view.Reasons, journeyReasonFindingsInvalidRow)
+	}
+	if len(findings) > maxJourneyFindings {
+		findings = findings[len(findings)-maxJourneyFindings:]
+		view.Reasons = addJourneyReason(view.Reasons, journeyReasonFindingsTruncated)
+	}
+	view.Findings = nonNilJourney(findings, []journeyFindingView{})
+}
+
+// journeyCycleSections renders funded reassessment decisions and D13
+// gate cycles from one bounded per-issue read, so every section shares
+// the same lineage. Cycles awaiting their funded receipt hold without
+// a judgment; malformed rows and cap cuts name their reasons.
+func (s WorkJourneys) journeyCycleSections(ctx context.Context, view *IssueJourney, repository, index int64) error {
+	cycles, truncated, err := s.Store.JourneyReassignmentCycles(ctx, repository, index, maxJourneyJudgments)
+	if err != nil {
+		return err
+	}
+	judgments := make([]journeyJudgmentView, 0, len(cycles))
+	invalidJudgment := false
+	for _, record := range cycles {
+		if record.EvidenceFingerprint == "" {
+			continue
+		}
+		fingerprint, err := control.DecisionFingerprintFromRecord(record)
+		if err != nil {
+			invalidJudgment = true
+			continue
+		}
+		receipt, err := s.Store.PriorityJudgment(ctx, fingerprint)
+		if err != nil {
+			if errors.Is(err, store.ErrNotFound) {
+				continue
+			}
+			return err
+		}
+		if len(receipt.Calls) != 1 {
+			continue
+		}
+		answer := receipt.Calls[0].Answer
+		probability, ok := answer.Probabilities[answer.Selected]
+		if !ok {
+			invalidJudgment = true
+			continue
+		}
+		wait := record.Cycle.State == factory.ReassessmentAttention
+		rendered, err := journeyJudgmentDTO(journeyJudgmentReassessDecision, answer.Selected, answer.Model,
+			answer.Confidence, probability, wait, record.WaitReason, &record.Cycle)
+		if err != nil {
+			invalidJudgment = true
+			continue
+		}
+		judgments = append(judgments, rendered)
+	}
+	if invalidJudgment {
+		view.Reasons = addJourneyReason(view.Reasons, journeyReasonJudgmentsInvalidRow)
+	}
+	if truncated || len(judgments) > maxJourneyJudgments {
+		if len(judgments) > maxJourneyJudgments {
+			judgments = judgments[len(judgments)-maxJourneyJudgments:]
+		}
+		view.Reasons = addJourneyReason(view.Reasons, journeyReasonJudgmentsTruncated)
+	}
+	view.Judgments = nonNilJourney(judgments, []journeyJudgmentView{})
+	gates := make([]journeyGateView, 0, len(cycles))
+	unrenderable := false
+	for _, record := range cycles {
+		rendered, err := journeyGateDTO(factory.ReassessmentView{
+			CompletionID: record.Completion.ID, CycleID: record.Cycle.CycleID,
+			State: record.Cycle.State, Decision: record.Cycle.Decision, Proposal: record.Cycle.Proposal,
+			Repository: repository, Generation: record.Cycle.Generation, WaitReason: record.WaitReason,
+			InventoryDigest: record.InventoryDigest, Retryable: record.Cycle.State == factory.ReassessmentAttention,
+		})
+		if err != nil {
+			unrenderable = true
+			continue
+		}
+		gates = append(gates, rendered)
+	}
+	if unrenderable {
+		view.Reasons = addJourneyReason(view.Reasons, journeyReasonGatesUnrenderable)
+	}
+	if truncated || len(gates) > maxJourneyGates {
+		if len(gates) > maxJourneyGates {
+			gates = gates[len(gates)-maxJourneyGates:]
+		}
+		view.Reasons = addJourneyReason(view.Reasons, journeyReasonGatesTruncated)
+	}
+	view.Gates = nonNilJourney(gates, []journeyGateView{})
+	return nil
+}
