+	visible, denyAt = true, 2
+	if _, err := apply(ctx); !errors.Is(err, denied) {
+		t.Fatal("late visibility revocation saved sponsorship", err)
+	}
+	denyAt = 0
+	cancelled, cancel := context.WithCancel(ctx)
