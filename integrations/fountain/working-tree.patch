@@ -0,0 +1,37 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package forgejo_migrations
+
+import (
+	"fmt"
+
+	"code.forgejo.org/xorm/xorm"
+	"code.forgejo.org/xorm/xorm/schemas"
+)
+
+func init() {
+	registerMigration(&Migration{
+		Description: "widen native operation completion for needs_intervention",
+		Upgrade:     widenNativeOperationCompletion,
+	})
+}
+
+func widenNativeOperationCompletion(x *xorm.Engine) error {
+	// SyncWithOptions does not widen PostgreSQL VARCHAR columns. Keep the
+	// original ledger and reservation intact while allowing the longer status.
+	var query string
+	switch x.Dialect().URI().DBType {
+	case schemas.POSTGRES:
+		query = "ALTER TABLE `operation` ALTER COLUMN `completion` TYPE VARCHAR(32)"
+	case schemas.MYSQL:
+		query = "ALTER TABLE `operation` MODIFY `completion` VARCHAR(32) NOT NULL DEFAULT ''"
+	case schemas.SQLITE:
+		// SQLite does not enforce the declared VARCHAR length.
+		return nil
+	default:
+		return fmt.Errorf("unsupported native operation database: %s", x.Dialect().URI().DBType)
+	}
+	_, err := x.Exec(query)
+	return err
+}
diff --git a/models/issues/comment_anchor.go b/models/issues/comment_anchor.go
new file mode 100644
index 0000000000000000000000000000000000000000..578e29ada7d9523967487763c765a9e9dc0a833a
--- /dev/null
+++ b/models/issues/comment_anchor.go
@@ -0,0 +1,64 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: MIT
+
+package issues
+
+import (
+	"errors"
+	"path"
+	"strings"
+	"unicode/utf8"
+)
+
+// CodeCommentAnchor is the immutable context originally selected by the human
+// or conditional writer. Path belongs to Side in that exact diff. A reader may
+// recover the other side's rename path from these immutable trees; it must never
+// replace this context with today's PR base/head or the mutable blame location.
+// Nil on a retained/migrated comment means this context was not recorded.
+type CodeCommentAnchor struct {
+	Base      string `json:"base"`
+	Head      string `json:"head"`
+	Path      string `json:"path"`
+	Side      string `json:"side"`
+	Scope     string `json:"scope"`
+	StartLine int64  `json:"start_line"`
+	EndLine   int64  `json:"end_line"`
+}
+
+func (a CodeCommentAnchor) Validate() error {
+	if !validFullOID(a.Base) || !validFullOID(a.Head) || a.Base != strings.ToLower(a.Base) || a.Head != strings.ToLower(a.Head) || a.Path == "" || len(a.Path) > 4096 || !utf8.ValidString(a.Path) || strings.ContainsRune(a.Path, 0) || strings.HasPrefix(a.Path, "/") || path.Clean(a.Path) != a.Path || a.Path == "." || a.Path == ".." || strings.HasPrefix(a.Path, "../") || a.Side != "old" && a.Side != "new" {
+		return errors.New("invalid original code comment anchor")
+	}
+	switch a.Scope {
+	case "file":
+		if a.StartLine != 0 || a.EndLine != 0 {
+			return errors.New("invalid file comment range")
+		}
+	case "lines":
+		if a.StartLine < 1 || a.EndLine < a.StartLine {
+			return errors.New("invalid code comment range")
+		}
+	default:
+		return errors.New("invalid code comment scope")
+	}
+	return nil
+}
+
+// Copy keeps the caller from sharing mutable pointer storage with a persisted
+// comment or the root whose context a reply inherits.
+func (a *CodeCommentAnchor) Copy() *CodeCommentAnchor {
+	if a == nil {
+		return nil
+	}
+	copy := *a
+	return &copy
+}
+
+// Equal compares exact recorded context, keeping absent context distinct from
+// every recorded value, including malformed retained values.
+func (a *CodeCommentAnchor) Equal(b *CodeCommentAnchor) bool {
+	if a == nil || b == nil {
+		return a == b
+	}
+	return *a == *b
+}
diff --git a/models/issues/review_human_inline.go b/models/issues/review_human_inline.go
new file mode 100644
index 0000000000000000000000000000000000000000..9c7d4e199f97797d233cf98e5232d424d6b13e71
--- /dev/null
+++ b/models/issues/review_human_inline.go
@@ -0,0 +1,109 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: MIT
+
+package issues
+
+import (
+	"context"
+	"strings"
+	"unicode/utf8"
+
+	"forgejo.org/models/db"
+)
+
+const MaxPreparedHumanInlineBodyBytes = 64 << 10
+
+// PreparedHumanInlineTarget separates captured conditions from trusted Git
+// evidence freshly read by the internal caller under native ownership. Neither
+// Current* proof nor ownership can come from a browser or SDK JSON payload.
+// The caller owns live session/deadline/revision and exact receipt admission.
+type PreparedHumanInlineTarget struct {
+	Review                                               PreparedHumanReviewTarget
+	Anchor                                               CodeCommentAnchor
+	EntryOID, EntryKind, DiffDigest                      string
+	CurrentAnchor                                        CodeCommentAnchor
+	CurrentEntryOID, CurrentEntryKind, CurrentDiffDigest string
+}
+type PreparedHumanInlineResult struct {
+	Review  *Review
+	Inline  *Comment
+	History *Comment // nil for a pending draft; finalization creates native review history
+}
+
+func validPreparedInlineDigest(s string) bool {
+	if len(s) != 64 {
+		return false
+	}
+	for _, r := range s {
+		if !(r >= '0' && r <= '9' || r >= 'a' && r <= 'f') {
+			return false
+		}
+	}
+	return true
+}
+
+// CreatePreparedHumanInlineComment joins the caller's transaction and composes
+// only native SQL. Draft creation/continuation preserves the summary and every
+// older inline's original context. Immediate publication explicitly consumes the
+// own pending review, preserving its summary, through ordinary native SubmitReview.
+// It performs no Git/blame I/O, notifications, replay or attachment handling.
+func CreatePreparedHumanInlineComment(ctx context.Context, content string, draft bool, want PreparedHumanInlineTarget) (*PreparedHumanInlineResult, error) {
+	if err := validatePreparedHumanReviewTarget(ctx, want.Review); err != nil {
+		return nil, err
+	}
+	refuse := func(reason string) (*PreparedHumanInlineResult, error) {
+		return nil, ErrExactReviewRefused{Reason: reason}
+	}
+	a := want.Anchor
+	if a.Validate() != nil || a.EndLine > 9007199254740991 || a.Base != want.Review.MergeBaseOID || a.Head != want.Review.HeadOID || !validFullOID(want.EntryOID) || want.EntryOID != strings.ToLower(want.EntryOID) || !validPreparedInlineDigest(want.DiffDigest) || want.EntryKind != "blob" && (want.EntryKind != "commit" || a.Scope != "file") {
+		return refuse("invalid human inline target")
+	}
+	if a != want.CurrentAnchor || want.EntryOID != want.CurrentEntryOID || want.EntryKind != want.CurrentEntryKind || want.DiffDigest != want.CurrentDiffDigest {
+		return refuse("inline proof changed")
+	}
+	if len(content) > MaxPreparedHumanInlineBodyBytes || !utf8.ValidString(content) || strings.ContainsRune(content, 0) {
+		return refuse("invalid human inline body")
+	}
+	if strings.TrimSpace(content) == "" {
+		return nil, ContentEmptyErr{}
+	}
+	ctx, committer, err := db.TxContext(ctx)
+	if err != nil {
+		return nil, err
+	}
+	defer committer.Close()
+	actor, issue, review, err := loadPreparedHumanReview(ctx, want.Review)
+	if err != nil {
+		return nil, err
+	}
+	if review == nil {
+		review, err = CreateReview(ctx, CreateReviewOptions{Type: ReviewTypePending, Issue: issue, Reviewer: actor, CommitID: want.Review.HeadOID})
+		if err != nil {
+			return nil, err
+		}
+	}
+	line := a.EndLine
+	commit := a.Head
+	if a.Side == "old" {
+		line = -line
+		commit = a.Base
+	}
+	inline, err := CreateComment(ctx, &CreateCommentOptions{Type: CommentTypeCode, Doer: actor, Repo: issue.Repo, Issue: issue, Content: content, TreePath: a.Path, LineNum: line, OriginalAnchor: a.Copy(), CommitSHA: commit, ReviewID: review.ID})
+	if err != nil {
+		return nil, err
+	}
+	result := &PreparedHumanInlineResult{Review: review, Inline: inline}
+	if !draft {
+		result.Review, result.History, err = SubmitReview(ctx, actor, issue, ReviewTypeComment, review.Content, want.Review.HeadOID, false, nil)
+		if err != nil {
+			return nil, err
+		}
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if err := committer.Commit(); err != nil {
+		return nil, err
+	}
+	return result, nil
+}
diff --git a/models/issues/review_human_primary.go b/models/issues/review_human_primary.go
new file mode 100644
index 0000000000000000000000000000000000000000..7853a873a64eddc3a21dcab39abcce1aeb41bc8f
--- /dev/null
+++ b/models/issues/review_human_primary.go
@@ -0,0 +1,200 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: MIT
+
+package issues
+
+import (
+	"context"
+	"strings"
+	"unicode/utf8"
+
+	"forgejo.org/models/db"
+	nativeoperation_model "forgejo.org/models/nativeoperation"
+	access_model "forgejo.org/models/perm/access"
+	"forgejo.org/models/unit"
+	user_model "forgejo.org/models/user"
+	execcontext "forgejo.org/modules/nativeoperation"
+)
+
+const MaxPreparedHumanReviewBodyBytes = 64 << 10
+
+// PreparedHumanReviewTarget pins native SQL facts and the exact candidate.
+// Current*OID is trusted Git evidence read by the caller under its held native
+// ownership, never browser input. The caller owns live request/session admission,
+// native revision claim and the operation receipt in its enclosing transaction.
+// This primary performs no Git I/O, notification or operation replay.
+type PreparedHumanReviewTarget struct {
+	RepositoryID, ReviewerID, PullID, IssueID, Index    int64
+	BaseBranch                                          string
+	IsClosed, HasMerged, IsAuthor                       bool
+	HeadOID, BaseOID, MergeBaseOID                      string
+	CurrentHeadOID, CurrentBaseOID, CurrentMergeBaseOID string
+	PendingReviewID                                     int64
+	PendingCommitID                                     string
+}
+
+// SubmitPreparedHumanReview joins the caller's transaction. Drafts create/update
+// only the current human's pending row; final events use the ordinary native
+// SubmitReview primary, retaining its approval/request/team/code-comment rules.
+// Review/history and the caller's receipt can therefore commit or roll back
+// together. New inline comment creation remains its own producer; existing own
+// draft comments are submitted with their original immutable context.
+func SubmitPreparedHumanReview(ctx context.Context, reviewType ReviewType, content string, want PreparedHumanReviewTarget) (*Review, *Comment, error) {
+	if err := validatePreparedHumanReviewTarget(ctx, want); err != nil {
+		return nil, nil, err
+	}
+	refuse := func(reason string) (*Review, *Comment, error) { return nil, nil, ErrExactReviewRefused{Reason: reason} }
+	if len(content) > MaxPreparedHumanReviewBodyBytes || !utf8.ValidString(content) || strings.ContainsRune(content, 0) {
+		return refuse("invalid human review body")
+	}
+	switch reviewType {
+	case ReviewTypeReject:
+		if strings.TrimSpace(content) == "" {
+			return nil, nil, ContentEmptyErr{}
+		}
+	case ReviewTypePending, ReviewTypeApprove, ReviewTypeComment:
+	default:
+		return refuse("invalid human review event")
+	}
+	ctx, committer, err := db.TxContext(ctx)
+	if err != nil {
+		return nil, nil, err
+	}
+	defer committer.Close()
+	actor, issue, pending, err := loadPreparedHumanReview(ctx, want)
+	if err != nil {
+		return nil, nil, err
+	}
+	if want.IsAuthor && (reviewType == ReviewTypeApprove || reviewType == ReviewTypeReject) {
+		return refuse("cannot review your own pull request")
+	}
+	var review *Review
+	var comment *Comment
+	if reviewType == ReviewTypePending {
+		if pending == nil {
+			if strings.TrimSpace(content) == "" {
+				return nil, nil, ContentEmptyErr{}
+			}
+			review, err = CreateReview(ctx, CreateReviewOptions{Type: ReviewTypePending, Issue: issue, Reviewer: actor, Content: content, CommitID: want.HeadOID})
+		} else {
+			// Body-only draft editing preserves original commit and inline context.
+			pending.Content = content
+			_, err = db.GetEngine(ctx).ID(pending.ID).Cols("content").Update(pending)
+			review = pending
+		}
+	} else {
+		review, comment, err = SubmitReview(ctx, actor, issue, reviewType, content, want.HeadOID, false, nil)
+	}
+	if err != nil {
+		return nil, nil, err
+	}
+	if ctx.Err() != nil {
+		return nil, nil, ctx.Err()
+	}
+	if err := committer.Commit(); err != nil {
+		return nil, nil, err
+	}
+	return review, comment, nil
+}
+
+// Shared preparation checks used by human review and inline SQL primaries.
+func validatePreparedHumanReviewTarget(ctx context.Context, want PreparedHumanReviewTarget) error {
+	held, err := nativeoperation_model.ReadReservation(ctx)
+	if err != nil {
+		return err
+	}
+	execution := execcontext.FromContext(ctx)
+	if execution == nil || held.Owner == "" || execution.Owner != held.Owner || execution.Generation != held.Generation {
+		return nativeoperation_model.ErrBusy
+	}
+	refuse := func(reason string) error { return ErrExactReviewRefused{Reason: reason} }
+	if want.RepositoryID <= 0 || want.ReviewerID <= 0 || want.PullID <= 0 || want.IssueID <= 0 || want.Index <= 0 || want.BaseBranch == "" || want.PendingReviewID < 0 || want.PendingReviewID == 0 && want.PendingCommitID != "" {
+		return refuse("invalid human review target")
+	}
+	for _, oid := range []string{want.HeadOID, want.BaseOID, want.MergeBaseOID, want.CurrentHeadOID, want.CurrentBaseOID, want.CurrentMergeBaseOID} {
+		if !validFullOID(oid) || oid != strings.ToLower(oid) {
+			return refuse("invalid object id")
+		}
+	}
+	if want.HeadOID != want.CurrentHeadOID {
+		return refuse("head changed")
+	}
+	if want.BaseOID != want.CurrentBaseOID {
+		return refuse("base changed")
+	}
+	if want.MergeBaseOID != want.CurrentMergeBaseOID {
+		return refuse("merge base changed")
+	}
+	return nil
+}
+
+// Caller already owns a joined transaction and exact native ownership.
+func loadPreparedHumanReview(ctx context.Context, want PreparedHumanReviewTarget) (*user_model.User, *Issue, *Review, error) {
+	refuse := func(reason string) (*user_model.User, *Issue, *Review, error) {
+		return nil, nil, nil, ErrExactReviewRefused{Reason: reason}
+	}
+	actor, err := user_model.GetUserByID(ctx, want.ReviewerID)
+	if err != nil {
+		return nil, nil, nil, err
+	}
+	if !actor.IsAccessAllowed(ctx) {
+		return refuse("reviewer is inactive")
+	}
+	issue, err := GetIssueByID(ctx, want.IssueID)
+	if err != nil {
+		return nil, nil, nil, err
+	}
+	if issue.RepoID != want.RepositoryID || issue.Index != want.Index || !issue.IsPull || issue.IsClosed != want.IsClosed || issue.IsPoster(actor.ID) != want.IsAuthor {
+		return refuse("human review parent changed")
+	}
+	if err := issue.LoadPullRequest(ctx); err != nil {
+		return nil, nil, nil, err
+	}
+	pr := issue.PullRequest
+	if pr == nil || pr.ID != want.PullID || pr.IssueID != issue.ID || pr.BaseRepoID != want.RepositoryID || pr.Index != want.Index || pr.BaseBranch != want.BaseBranch || pr.HasMerged != want.HasMerged {
+		return refuse("human review pull changed")
+	}
+	if err := issue.LoadRepo(ctx); err != nil {
+		return nil, nil, nil, err
+	}
+	repo := issue.Repo
+	if err := repo.LoadOwner(ctx); err != nil {
+		return nil, nil, nil, err
+	}
+	if repo.IsArchived || !repo.AllowsPulls(ctx) {
+		return refuse("review workflow unavailable")
+	}
+	permission, err := access_model.GetUserRepoPermission(ctx, repo, actor)
+	if err != nil {
+		return nil, nil, nil, err
+	}
+	for _, kind := range []unit.Type{unit.TypeCode, unit.TypePullRequests} {
+		if kind.UnitGlobalDisabled() || !repo.UnitEnabled(ctx, kind) || !permission.CanRead(kind) {
+			return refuse("reviewer cannot read this pull request")
+		}
+	}
+	if user_model.IsBlockedMultiple(ctx, []int64{repo.OwnerID, issue.PosterID}, actor.ID) {
+		return refuse("reviewer is blocked")
+	}
+	pending, err := GetCurrentReview(ctx, actor, issue)
+	if err != nil && !IsErrReviewNotExist(err) {
+		return nil, nil, nil, err
+	}
+	if pending == nil && want.PendingReviewID != 0 || pending != nil && (pending.ID != want.PendingReviewID || pending.CommitID != want.PendingCommitID) {
+		return refuse("pending draft changed")
+	}
+	if pending != nil {
+		if pending.ReviewerID != actor.ID || pending.ReviewerTeamID != 0 || pending.OriginalAuthorID != 0 || pending.Official || pending.Dismissed {
+			return refuse("pending draft identity differs")
+		}
+		if err := pending.LoadCodeComments(ctx); err != nil {
+			return nil, nil, nil, err
+		}
+		for _, comment := range pending.CodeComments.SortedList() {
+			if comment.IssueID != issue.ID || comment.ReviewID != pending.ID || comment.PosterID != actor.ID || comment.OriginalAuthorID != 0 {
+				return refuse("pending draft comment identity differs")
+			}
+		}
+	}
+	return actor, issue, pending, nil
+}
