+		!validReviewSubmitPayloadRef("refs/heads/"+p.BaseBranch) || !ValidPullDiffCommit(p.HeadOID) || !ValidPullDiffCommit(p.BaseOID) || !ValidPullDiffCommit(p.MergeBaseOID) || p.NativeRevision < 0 || p.HasMerged && !p.IsClosed {
+		return false
