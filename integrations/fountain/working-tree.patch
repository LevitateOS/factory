new file mode 100644
index 0000000000000000000000000000000000000000..e24a93a1f3de06eec51347418fbb5afadbc41df5
--- /dev/null
+++ b/routers/web/extensions/callback_thread_snapshot.go
@@ -0,0 +1,105 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: MIT
+
+package extensions
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"reflect"
+
+	extension "forgejo.org/extension-sdk"
+	issues_model "forgejo.org/models/issues"
+	repo_model "forgejo.org/models/repo"
+	nativeoperation_service "forgejo.org/services/nativeoperation"
+)
+
+type threadSnapshotFacts struct {
+	Snapshot extension.RepositoryThreadSnapshot
+	Review   reviewSnapshotFacts
+}
+
+func readThreadSnapshot(ctx context.Context, admission *callbackAdmission, repository string, q extension.RepositoryThreadSnapshotRequest) (*threadSnapshotFacts, int) {
+	// Reuse the existing native PR/Git/reader owner, including the base repository's
+	// hidden PR ref. Resolution uses its own native policy, never review-event policy.
+	parent, status := readReviewSnapshot(ctx, admission, repository, extension.RepositoryReviewSnapshotRequest{Index: q.Index})
+	if status != http.StatusOK {
+		return nil, status
+	}
+	user, status := resolveCurrentUser(ctx, admission)
+	if status != http.StatusOK {
+		return nil, status
+	}
+	issue, err := issues_model.GetIssueByID(ctx, mustParsePositiveID(parent.Snapshot.IssueID))
+	if err != nil {
+		return nil, http.StatusServiceUnavailable
+	}
+	if issue.RepoID != mustParsePositiveID(repository) || !issue.IsPull {
+		return nil, http.StatusConflict
+	}
+	evidence, err := nativeoperation_service.ReadHumanThreadEvidence(ctx, issue, user, mustParsePositiveID(q.ThreadID))
+	if err != nil {
+		switch {
+		case errors.Is(err, nativeoperation_service.ErrHumanThreadMissing):
+			return nil, http.StatusNotFound
+		case errors.Is(err, nativeoperation_service.ErrHumanThreadTarget):
+			return nil, http.StatusUnprocessableEntity
+		case errors.Is(err, nativeoperation_service.ErrHumanThreadChanged):
+			return nil, http.StatusConflict
+		case errors.Is(err, nativeoperation_service.ErrHumanThreadTooLarge):
+			return nil, http.StatusRequestEntityTooLarge
+		default:
+			return nil, http.StatusServiceUnavailable
+		}
+	}
+	allowed, err := issues_model.CanMarkConversation(ctx, issue, user)
+	if err != nil {
+		return nil, http.StatusServiceUnavailable
+	}
+	resolve, unresolve := capabilityFact("denied", "thread_author_writer_or_official_reviewer_required"), capabilityFact("denied", "thread_author_writer_or_official_reviewer_required")
+	if allowed {
+		resolve, unresolve = capabilityFact("allowed", "thread_resolve"), capabilityFact("allowed", "thread_unresolve")
+	}
+	repo, err := repo_model.GetRepositoryByID(ctx, issue.RepoID)
+	if err != nil {
+		return nil, http.StatusServiceUnavailable
+	}
+	if repo.IsArchived {
+		resolve, unresolve = capabilityFact("denied", "repository_archived"), capabilityFact("denied", "repository_archived")
+	}
+	return &threadSnapshotFacts{Snapshot: extension.RepositoryThreadSnapshot{Review: parent.Snapshot, Thread: evidence, ResolveAction: resolve, UnresolveAction: unresolve}, Review: *parent}, http.StatusOK
+}
+
+func resolveThreadSnapshot(ctx context.Context, admission *callbackAdmission, request extension.CallbackRequest) (*extension.RepositoryThreadSnapshot, int) {
+	before, err := nativeoperation_service.Default().ReadNativeRevision(ctx)
+	if err != nil || !before.Idle {
+		return nil, http.StatusServiceUnavailable
+	}
+	first, status := readThreadSnapshot(ctx, admission, request.RepositoryID, *request.ThreadSnapshot)
+	if status != http.StatusOK {
+		return nil, status
+	}
+	second, status := readThreadSnapshot(ctx, admission, request.RepositoryID, *request.ThreadSnapshot)
+	if status == http.StatusNotFound || status == http.StatusUnprocessableEntity {
+		return nil, http.StatusConflict
+	}
+	if status != http.StatusOK {
+		return nil, status
+	}
+	// Recheck the live human after complete conversation hydration as well as
+	// inside each PR read. Preparation must not release evidence to a changed
+	// session merely because its native revision stayed idle.
+	if _, status := resolveCurrentUser(ctx, admission); status != http.StatusOK {
+		return nil, status
+	}
+	after, err := nativeoperation_service.Default().ReadNativeRevision(ctx)
+	if err != nil {
+		return nil, http.StatusServiceUnavailable
+	}
+	if !after.Idle || after.Revision != before.Revision || !reflect.DeepEqual(first, second) {
+		return nil, http.StatusConflict
+	}
+	first.Snapshot.Review.NativeRevision = before.Revision
+	return &first.Snapshot, http.StatusOK
+}
diff --git a/routers/web/extensions/callback_threads.go b/routers/web/extensions/callback_threads.go
new file mode 100644
index 0000000000000000000000000000000000000000..2f7f183164e987e53b33e2e990fd2577c670d6ba
--- /dev/null
+++ b/routers/web/extensions/callback_threads.go
@@ -0,0 +1,317 @@
+package extensions
+
+import (
+	"context"
+	"net/http"
+	"sort"
+	"strconv"
+	"time"
+	"unicode/utf8"
+
+	extension "forgejo.org/extension-sdk"
+	"forgejo.org/models/db"
+	issues_model "forgejo.org/models/issues"
+	repo_model "forgejo.org/models/repo"
+	user_model "forgejo.org/models/user"
+	"forgejo.org/modules/git"
+)
+
+// Grouping uses the native immutable-context/(created,id) owner. Fetch thin
+// metadata, never every prose body, before bounded windows.
+func threadCatalogue(ctx context.Context, issueID int64) ([]issues_model.CodeThread, int) {
+	var rows issues_model.CommentList
+	err := db.GetEngine(ctx).Where("issue_id = ? AND type = ?", issueID, issues_model.CommentTypeCode).
+		Cols("id", "type", "issue_id", "review_id", "tree_path", "line", "created_unix", "resolve_doer_id", "invalidated", "commit_sha", "original_anchor").
+		Asc("created_unix").Asc("id").Limit(10001).Find(&rows)
+	if err != nil {
+		return nil, http.StatusServiceUnavailable
+	}
+	if len(rows) > 10000 {
+		return nil, http.StatusRequestEntityTooLarge
+	}
+	groups := issues_model.GroupCodeThreads(rows)
+	sort.Slice(groups, func(i, j int) bool { return groups[i].Root().ID < groups[j].Root().ID })
+	return groups, http.StatusOK
+}
+
+// Compare every grouping/display fact, including absent original context and
+// native root ordering. Prose hydration may not move a row into another group.
+func sameThreadMetadata(a, b *issues_model.Comment) bool {
+	return a != nil && b != nil && a.ID == b.ID && a.Type == b.Type && a.IssueID == b.IssueID &&
+		a.ReviewID == b.ReviewID && a.TreePath == b.TreePath && a.Line == b.Line &&
+		a.CreatedUnix == b.CreatedUnix && a.OriginalAnchor.Equal(b.OriginalAnchor) &&
+		a.ResolveDoerID == b.ResolveDoerID && a.Invalidated == b.Invalidated && a.CommitSHA == b.CommitSHA
+}
+
+type threadGit struct {
+	ctx        context.Context
+	repo       *git.Repository
+	model      *repo_model.Repository
+	base, head string
+	files      map[string][]nativePullFile
+	failed     map[string]bool
+}
+
+func (g *threadGit) anchor(a *issues_model.CodeCommentAnchor) *extension.RepositoryThreadAnchor {
+	if a == nil || a.Validate() != nil || g.repo == nil {
+		return nil
+	}
+	key := a.Base + "." + a.Head
+	if g.failed[key] {
+		return nil
+	}
+	files, ok := g.files[key]
+	if !ok {
+		out := &pullDiffBuffer{limit: 2 * 1024 * 1024}
+		if err := pullDiffCommand(g.ctx, g.repo, a.Base, a.Head, out, "raw"); err != nil || out.exceeded {
+			g.failed[key] = true
+			return nil
+		}
+		var valid bool
+		files, valid = pullFileRecords(out.Bytes())
+		if !valid {
+			g.failed[key] = true
+			return nil
+		}
+		g.files[key] = files
+	}
+	old, new := "", ""
+	for _, f := range files {
+		if a.Side == "old" && f.old == a.Path || a.Side == "new" && f.new == a.Path {
+			old, new = f.old, f.new
+			break
+		}
+	}
+	if old == "" && new == "" {
+		before, e1 := g.repo.GetCommit(a.Base)
+		after, e2 := g.repo.GetCommit(a.Head)
+		if e1 != nil || e2 != nil {
+			return nil
+		}
+		if _, err := before.GetTreeEntryByPath(a.Path); err == nil {
+			old = a.Path
+		}
+		if _, err := after.GetTreeEntryByPath(a.Path); err == nil {
+			new = a.Path
+		}
+	}
+	result := &extension.RepositoryThreadAnchor{Base: a.Base, Head: a.Head, OldPath: old, NewPath: new, Side: a.Side, Scope: a.Scope, StartLine: a.StartLine, EndLine: a.EndLine}
+	if !extension.ValidRepositoryThreadAnchor(result) {
+		return nil
+	}
+	return result
+}
+func (g *threadGit) placement(root *issues_model.Comment) (*extension.RepositoryThreadAnchor, *bool) {
+	if root.Invalidated {
+		value := true
+		return nil, &value
+	}
+	if g.repo == nil || !extension.ValidPullDiffCommit(g.head) || root.Line == 0 || root.UnsignedLine() > 9007199254740991 {
+		return nil, nil
+	}
+	// Native relocation is a display fact and never overwrites OriginalAnchor.
+	if a := root.OriginalAnchor; a != nil && a.Scope == "lines" && a.StartLine != a.EndLine {
+		return nil, nil
+	}
+	blame, err := root.ResolveCurrentLine(g.ctx, g.model, g.head)
+	if err != nil || blame == nil {
+		return nil, nil
+	}
+	if blame.CommitID != g.head {
+		value := true
+		return nil, &value
+	}
+	value := false
+	side := "new"
+	if root.Line < 0 {
+		side = "old"
+	}
+	a := &issues_model.CodeCommentAnchor{Base: g.base, Head: g.head, Path: blame.FilePath, Side: side, Scope: "lines", StartLine: int64(blame.LineNumber), EndLine: int64(blame.LineNumber)}
+	return g.anchor(a), &value
+}
+func resolveRepositoryThreads(ctx context.Context, admission *callbackAdmission, request extension.CallbackRequest) (*extension.RepositoryThreadPage, int) {
+	q := *request.Threads
+	issue, pullID, status := discussionParent(ctx, admission, request.RepositoryID, extension.RepositoryCommentsRequest{Subject: "pull", Index: q.Index, Limit: 1})
+	if status != http.StatusOK {
+		return nil, status
+	}
+	if issue.PullRequest == nil || issue.PullRequest.IssueID != issue.ID || issue.PullRequest.BaseRepoID != issue.RepoID || issue.PullRequest.Index != issue.Index {
+		return nil, http.StatusServiceUnavailable
+	}
+	user, status := resolveCurrentUser(ctx, admission)
+	if status != http.StatusOK {
+		return nil, status
+	}
+	groups, status := threadCatalogue(ctx, issue.ID)
+	if status != http.StatusOK {
+		return nil, status
+	}
+	ids := []int64{}
+	for _, t := range groups {
+		ids = append(ids, t.Root().ReviewID)
+	}
+	visible := map[int64]*issues_model.Review{}
+	if len(ids) > 0 {
+		if err := db.GetEngine(ctx).Where(readableReviewCondition(issue.ID, user)).In("id", ids).Find(&visible); err != nil {
+			return nil, http.StatusServiceUnavailable
+		}
+	}
+	kept := []issues_model.CodeThread{}
+	for _, t := range groups {
+		root := t.Root()
+		if visible[root.ReviewID] == nil {
+			continue
+		}
+		if q.ThreadID != "" {
+			if strconv.FormatInt(root.ID, 10) == q.ThreadID {
+				kept = append(kept, t)
+			}
+		} else if q.Cursor == "" || root.ID > mustParsePositiveID(q.Cursor) {
+			kept = append(kept, t)
+		}
+	}
+	if q.ThreadID != "" && len(kept) != 1 {
+		return nil, http.StatusNotFound
+	}
+	page := &extension.RepositoryThreadPage{RepositoryID: request.RepositoryID, PullID: pullID, Index: q.Index, Items: []extension.RepositoryThread{}}
+	if q.ThreadID == "" && len(kept) > q.Limit {
+		kept = kept[:q.Limit]
+		page.NextCursor = strconv.FormatInt(kept[len(kept)-1].Root().ID, 10)
+	}
+	repository, err := repo_model.GetRepositoryByID(ctx, issue.RepoID)
+	if err != nil {
+		return nil, http.StatusServiceUnavailable
+	}
+	g := threadGit{ctx: ctx, model: repository, base: issue.PullRequest.MergeBase, files: map[string][]nativePullFile{}, failed: map[string]bool{}}
+	g.repo, _ = git.OpenRepository(ctx, repository.RepoPath())
+	if g.repo != nil {
+		defer g.repo.Close()
+		g.head, _ = g.repo.GetRefCommitID(issue.PullRequest.GetGitRefName())
+	}
+	reviewIDs := []int64{}
+	for _, t := range kept {
+		root := t.Root()
+		// Old-side relocation needs the root's stored hunk excerpt. Catalogue
+		// metadata deliberately omits prose/patches; hydrate only selected roots.
+		liveRoot, err := issues_model.GetCommentByID(ctx, root.ID)
+		if err != nil || !sameThreadMetadata(liveRoot, root) {
+			return nil, http.StatusNotFound
+		}
+		root = liveRoot
+		reviewIDs = append(reviewIDs, root.ReviewID)
+		item := extension.RepositoryThread{ID: strconv.FormatInt(root.ID, 10), ReviewID: strconv.FormatInt(root.ReviewID, 10), Anchor: g.anchor(root.OriginalAnchor), Resolved: root.ResolveDoerID != 0, Comments: []extension.RepositoryThreadComment{}}
+		line := root.Line
+		side := "new"
+		if line < 0 {
+			line = -line
+			side = "old"
+		}
+		if line > 0 && line <= 9007199254740991 && root.TreePath != "" && len(root.TreePath) <= 4096 && utf8.ValidString(root.TreePath) {
+			location := &extension.RepositoryThreadLocation{Path: root.TreePath, Side: side, Line: line}
+			if extension.ValidPullDiffCommit(root.CommitSHA) {
+				location.Commit = root.CommitSHA
+			}
+			item.RecordedLocation = location
+		}
+		item.CurrentAnchor, item.Outdated = g.placement(root)
+		start, limit := 0, 10
+		if q.ThreadID != "" {
+			limit = q.Limit
+			if q.Cursor != "" {
+				found := false
+				for i, c := range t {
+					if strconv.FormatInt(c.ID, 10) == q.Cursor {
+						start = i + 1
+						found = true
+						break
+					}
+				}
+				if !found {
+					return nil, http.StatusBadRequest
+				}
+			}
+		}
+		end := min(start+limit, len(t))
+		for _, meta := range t[start:end] {
+			c, err := issues_model.GetCommentByID(ctx, meta.ID)
+			if err != nil || !sameThreadMetadata(c, meta) {
+				return nil, http.StatusNotFound
+			}
+			if err := c.LoadPoster(ctx); err != nil && !user_model.IsErrUserNotExist(err) {
+				return nil, http.StatusServiceUnavailable
+			}
+			comment := extension.RepositoryDiscussionComment{ID: strconv.FormatInt(c.ID, 10), Body: c.Content}
+			if c.Poster != nil && c.Poster.ID > 0 {
+				comment.Author = &extension.RepositoryIssueActor{ID: strconv.FormatInt(c.Poster.ID, 10), Username: c.Poster.Name}
+			}
+			if c.CreatedUnix > 0 {
+				v := time.Unix(int64(c.CreatedUnix), 0).UTC()
+				comment.CreatedAt = &v
+			}
+			if c.UpdatedUnix > 0 {
+				v := time.Unix(int64(c.UpdatedUnix), 0).UTC()
+				comment.UpdatedAt = &v
+			}
+			item.Comments = append(item.Comments, extension.RepositoryThreadComment{Comment: comment, Anchor: g.anchor(c.OriginalAnchor)})
+		}
+		if end < len(t) {
+			item.CommentsNext = strconv.FormatInt(t[end-1].ID, 10)
+		}
+		page.Items = append(page.Items, item)
+	}
+	after, afterID, status := discussionParent(ctx, admission, request.RepositoryID, extension.RepositoryCommentsRequest{Subject: "pull", Index: q.Index, Limit: 1})
+	if status != http.StatusOK {
+		return nil, status
+	}
+	if afterID != pullID || after.ID != issue.ID {
+		return nil, http.StatusServiceUnavailable
+	}
+	current, status := resolveCurrentUser(ctx, admission)
+	if status != http.StatusOK {
+		return nil, status
+	}
+	if len(reviewIDs) > 0 {
+		seen := map[int64]bool{}
+		unique := []int64{}
+		for _, id := range reviewIDs {
+			if !seen[id] {
+				seen[id] = true
+				unique = append(unique, id)
+			}
+		}
+		count, err := db.GetEngine(ctx).Where(readableReviewCondition(after.ID, current)).In("id", unique).Count(new(issues_model.Review))
+		if err != nil {
+			return nil, http.StatusServiceUnavailable
+		}
+		if count != int64(len(unique)) {
+			return nil, http.StatusNotFound
+		}
+	}
+	if len(kept) > 0 {
+		// Re-group complete thin metadata, including replies outside this
+		// prose window. A new context can separate an old unknown reply or
+		// replace the root even without changing any selected comment row.
+		live, status := threadCatalogue(ctx, issue.ID)
+		if status != http.StatusOK {
+			return nil, status
+		}
+		for _, before := range kept {
+			after := issues_model.FindCodeThread(live, before.Root().ID)
+			if len(before) != len(after) {
+				return nil, http.StatusConflict
+			}
+			for i, member := range before {
+				if !sameThreadMetadata(member, after[i]) {
+					return nil, http.StatusConflict
+				}
+			}
+		}
+	}
+	if g.repo != nil {
+		head, _ := g.repo.GetRefCommitID(after.PullRequest.GetGitRefName())
+		if head != g.head || after.PullRequest.MergeBase != g.base {
+			return nil, http.StatusConflict
+		}
+	}
+	return page, http.StatusOK
+}
diff --git a/sdk/issue_intake.go b/sdk/issue_intake.go
new file mode 100644
index 0000000000000000000000000000000000000000..c643dc7042a6fb7ef8f630fc4a5016ea7195e7b9
--- /dev/null
+++ b/sdk/issue_intake.go
@@ -0,0 +1,78 @@
+package extensions
+
+import (
+	"context"
+	"errors"
+	"regexp"
+)
+
+const OperationIssueIntakeAuthorize = "repository.issue_intake.authorize"
+const BackgroundIssueIntakePath = "/v1/background/issue-intake"
+
+// IssueIntakeClaims authorizes only bounded issue intake for one submitted
+// request. It carries no implementation, Git, pull request or deployment grant.
+type IssueIntakeClaims struct {
+	Installation string `json:"installation"`
+	Actor        string `json:"actor"`
+	Repository   string `json:"repository"`
+	Source       string `json:"source"`
+	Revision     int64  `json:"revision"`
+	Digest       string `json:"digest"`
+	Expires      int64  `json:"expires"`
+}
+type IssueIntakeGrant struct {
+	Token  string            `json:"token"`
+	Claims IssueIntakeClaims `json:"claims"`
+}
+type IssueIntakeAuthorizationRequest struct {
+	Source   string `json:"source"`
+	Revision int64  `json:"revision"`
+	Digest   string `json:"digest"`
+}
+type IssueIntakeMutation struct {
+	Grant              string `json:"grant,omitempty"`
+	Action             string `json:"action"`
+	Slot               int    `json:"slot"`
+	Step               int    `json:"step"`
+	Title              string `json:"title"`
+	Body               string `json:"body"`
+	ExpectedTitle      string `json:"expected_title,omitempty"`
+	ExpectedBodyDigest string `json:"expected_body_digest,omitempty"`
+}
+type IssueIntakeReceipt struct {
+	Index      int64  `json:"index"`
+	IssueID    int64  `json:"issue_id"`
+	Slot       int    `json:"slot"`
+	Title      string `json:"title"`
+	BodyDigest string `json:"body_digest"`
+}
+
+// IssueIntakeAuthorization is host-recorded provenance inside the existing
+// conditional issue ledger. The signed bearer token is never recorded there.
+type IssueIntakeAuthorization struct {
+	Claims      IssueIntakeClaims `json:"claims"`
+	RequestHash string            `json:"request_hash"`
+	Slot        int               `json:"slot"`
+	Step        int               `json:"step"`
+}
+
+var intakeSource = regexp.MustCompile(`^[a-f0-9]{32}$`)
+var intakeDigest = regexp.MustCompile(`^[a-f0-9]{64}$`)
+
+func ValidIssueIntakeRequest(request IssueIntakeAuthorizationRequest) bool {
+	return intakeSource.MatchString(request.Source) && request.Revision >= 0 && intakeDigest.MatchString(request.Digest)
+}
+func ValidIssueIntakeMutation(request IssueIntakeMutation) bool {
+	return (request.Action == "create" || request.Action == "refine") && request.Slot >= 0 && request.Slot < 16 && request.Step >= 0 && request.Step < 32 && len(request.Title) > 0 && len(request.Title) <= 255 && len(request.Body) > 0 && len(request.Body) <= 20*1024 && (request.Action != "refine" || len(request.ExpectedTitle) > 0 && intakeDigest.MatchString(request.ExpectedBodyDigest))
+}
+
+func (a Authority) AuthorizeIssueIntake(ctx context.Context, repository string, request IssueIntakeAuthorizationRequest) (IssueIntakeGrant, error) {
+	if !decimalID(repository) || !ValidIssueIntakeRequest(request) {
+		return IssueIntakeGrant{}, errors.New("invalid issue intake authorization")
+	}
+	response, err := a.nativeClient().call(ctx, CallbackRequest{Operation: OperationIssueIntakeAuthorize, RepositoryID: repository, IssueIntake: &request})
+	if err != nil {
+		return IssueIntakeGrant{}, err
+	}
+	return *response.IssueIntake, nil
+}
diff --git a/sdk/native_capabilities.go b/sdk/native_capabilities.go
new file mode 100644
index 0000000000000000000000000000000000000000..857032681adef8c2405d9145b660ff6eb0519030
--- /dev/null
+++ b/sdk/native_capabilities.go
@@ -0,0 +1,68 @@
+package extensions
+
+import (
+	"context"
+	"errors"
+)
+
+var (
+	ErrRepositoryCapabilitiesQuery   = errors.New("invalid capability query")
+	ErrRepositoryCapabilitiesChanged = errors.New("capabilities changed during read")
+)
+
+type RepositoryCapabilitiesRequest struct {
+	Subject string `json:"subject"` // repository, issue, pull
+	Index   string `json:"index"`
+}
+
+func ValidRepositoryCapabilitiesRequest(q RepositoryCapabilitiesRequest) bool {
+	return q.Subject == "repository" && q.Index == "" || (q.Subject == "issue" || q.Subject == "pull") && positivePullID(q.Index)
+}
+
+type RepositoryActionCapability struct {
+	State  string `json:"state"`
+	Reason string `json:"reason"`
+}
+type RepositoryCapabilities struct {
+	Head         string                                `json:"head"`
+	Base         string                                `json:"base"`
+	RepositoryID string                                `json:"repository_id"`
+	ActorID      string                                `json:"actor_id"`
+	Subject      string                                `json:"subject"`
+	Index        string                                `json:"index"`
+	ResourceID   string                                `json:"resource_id"`
+	Actions      map[string]RepositoryActionCapability `json:"actions"`
+}
+
+var repositoryCapabilityActions = []string{"issues.read", "issue.create", "issue.edit", "issue.comment", "pulls.read", "pull.create", "pull.edit", "pull.comment", "pull.review", "pull.review.comment", "pull.review.approve", "pull.review.request_changes", "thread.resolve", "pull.merge", "checks.read", "checks.jobs.read"}
+
+func validRepositoryCapabilities(p *RepositoryCapabilities, repo string, q RepositoryCapabilitiesRequest, actor string) bool {
+	if p == nil || p.RepositoryID != repo || p.ActorID != actor || p.Subject != q.Subject || p.Index != q.Index || q.Subject == "repository" && p.ResourceID != "" || q.Subject != "repository" && !positivePullID(p.ResourceID) || len(p.Actions) != len(repositoryCapabilityActions) {
+		return false
+	}
+	if q.Subject != "pull" && (p.Head != "" || p.Base != "") || p.Head != "" && !ValidPullDiffCommit(p.Head) || p.Base != "" && !ValidPullDiffCommit(p.Base) {
+		return false
+	}
+	for _, action := range repositoryCapabilityActions {
+		fact, ok := p.Actions[action]
+		if !ok || len(fact.Reason) > 256 {
+			return false
+		}
+		switch fact.State {
+		case "allowed", "denied", "unsupported", "unavailable", "unknown":
+		default:
+			return false
+		}
+	}
+	return true
+}
+func (a Authority) RepositoryCapabilities(ctx context.Context, repo string, q RepositoryCapabilitiesRequest) (RepositoryCapabilities, error) {
+	if !positivePullID(repo) || !ValidRepositoryCapabilitiesRequest(q) {
+		return RepositoryCapabilities{}, ErrRepositoryCapabilitiesQuery
+	}
+	r, err := a.nativeClient().call(ctx, CallbackRequest{Operation: OperationRepositoryCapabilities, RepositoryID: repo, Capabilities: &q})
+	if err != nil {
+		return RepositoryCapabilities{}, err
+	}
+	return *r.Capabilities, nil
+}
diff --git a/sdk/native_catalog.go b/sdk/native_catalog.go
new file mode 100644
index 0000000000000000000000000000000000000000..06e13fa9685c34d71475b39d05a6b0fb586e3010
--- /dev/null
+++ b/sdk/native_catalog.go
@@ -0,0 +1,54 @@
+package extensions
+
+import (
+	"context"
+	"errors"
+	"strconv"
+	"unicode/utf8"
+)
+
+var (
+	ErrRepositoryCatalogQuery   = errors.New("invalid repository catalogue query")
+	ErrRepositoryCatalogChanged = errors.New("repository catalogue changed during read")
+)
+
+type RepositoryCatalogRequest struct {
+	Query  string `json:"query"`
+	Cursor string `json:"cursor"`
+	Limit  int    `json:"limit"`
+}
+
+func ValidRepositoryCatalogRequest(q RepositoryCatalogRequest) bool {
+	return q.Limit >= 1 && q.Limit <= 50 && len(q.Query) <= 256 && utf8.ValidString(q.Query) && len(q.Cursor) <= 4096 && utf8.ValidString(q.Cursor)
+}
+
+func validRepositoryCatalog(p *RepositoryPage, q RepositoryCatalogRequest) bool {
+	if p == nil || p.Items == nil || len(p.Items) > q.Limit || len(p.NextCursor) > 4096 {
+		return false
+	}
+	last := int64(0)
+	for _, r := range p.Items {
+		id, err := strconv.ParseInt(r.ID, 10, 64)
+		if err != nil || !positivePullID(r.ID) || id <= last || r.Owner == "" || r.Name == "" || len(r.Owner) > 255 || len(r.Name) > 255 || !utf8.ValidString(r.Owner) || !utf8.ValidString(r.Name) {
+			return false
+		}
+		switch r.Permission {
+		case "read", "write", "admin":
+		default:
+			return false
+		}
+		last = id
+	}
+	return true
+}
+
+func (a Authority) ReadableRepositories(ctx context.Context, q RepositoryCatalogRequest) (RepositoryPage, error) {
+	if !ValidRepositoryCatalogRequest(q) {
+		return RepositoryPage{}, ErrRepositoryCatalogQuery
+	}
+	r, err := a.nativeClient().call(ctx, CallbackRequest{Operation: OperationReadableRepositories, Catalog: &q})
+	if err != nil {
+		return RepositoryPage{}, err
+	}
+	return *r.Page, nil
+}
