+			return false
+		}
+	case HumanReviewEventComment, ReviewSubmitEventApproved, ReviewSubmitEventRequestChanges:
+		if receipt.CommentID <= 0 || receipt.Stale {
+			return false
+		}
+	default:
+		return false
+	}
+	if q := request.HumanReview; q != nil {
+		return ValidHumanReviewReceipt(receipt, *q)
+	}
+	return true
+}
