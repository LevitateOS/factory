+		return false
+	}
+	for _, action := range []RepositoryActionCapability{p.CloseAction, p.ReopenAction} {
+		if action.State != "allowed" && action.State != "denied" || len(action.Reason) > 256 {
+			return false
+		}
+	}
+	return (!p.IsClosed || p.CloseAction.State != "allowed") && (p.IsClosed || p.ReopenAction.State != "allowed") && (!p.HasMerged || p.CloseAction.State != "allowed" && p.ReopenAction.State != "allowed")
+}
+
+func (a Authority) RepositoryStateSnapshot(ctx context.Context, repository string, q RepositoryStateSnapshotRequest) (RepositoryStateSnapshot, error) {
+	if !positivePullID(repository) || !ValidRepositoryStateSnapshotRequest(q) {
+		return RepositoryStateSnapshot{}, ErrStateSnapshotQuery
+	}
+	r, err := a.nativeClient().call(ctx, CallbackRequest{Operation: OperationRepositoryStateSnapshot, RepositoryID: repository, StateSnapshot: &q})
+	if err != nil {
+		return RepositoryStateSnapshot{}, err
+	}
+	return *r.StateSnapshot, nil
+}
diff --git a/sdk/native_thread_snapshot.go b/sdk/native_thread_snapshot.go
new file mode 100644
index 0000000000000000000000000000000000000000..eb9425b0d944cace2945c33cd7cfe8c33fd0ef76
--- /dev/null
+++ b/sdk/native_thread_snapshot.go
@@ -0,0 +1,91 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: MIT
+
+package extensions
+
+import (
+	"context"
+	"errors"
+)
+
+const OperationRepositoryThreadSnapshot = "repository.thread.snapshot"
+const MaxThreadSnapshotMembers = 1000
+
+// MaxThreadSnapshotBodyBytes bounds selected comment prose and retained patches.
+const MaxThreadSnapshotBodyBytes = 2 << 20
+
+var (
+	ErrThreadSnapshotQuery       = errors.New("invalid thread preparation query")
+	ErrThreadSnapshotChanged     = errors.New("thread preparation changed")
+	ErrThreadSnapshotTarget      = errors.New("thread preparation requires an exact native root")
+	ErrThreadSnapshotAdmission   = errors.New("current thread preparation admission required")
+	ErrThreadSnapshotUnavailable = errors.New("thread preparation unavailable")
+	ErrThreadSnapshotTooLarge    = errors.New("complete thread exceeds preparation bounds")
+)
+
+type RepositoryThreadSnapshotRequest struct {
+	Index    string `json:"index"`
+	ThreadID string `json:"thread_id"`
+}
+
+func ValidRepositoryThreadSnapshotRequest(q RepositoryThreadSnapshotRequest) bool {
+	return positivePullID(q.Index) && positivePullID(q.ThreadID)
+}
+
+// HumanThreadEvidence binds the entire native conversation in grouping order.
+// OriginalAnchor is nil for retained unknown context; it is never reconstructed
+// from current blame. Digest shares the conditional-resolution codec; the extra
+// evidence digest also pins exact resolver IDs, review/author/time/commit facts.
+// No prose, other humans' draft data or private source identity is disclosed.
+type HumanThreadEvidence struct {
+	RootCommentID      string                  `json:"root_comment_id"`
+	ReviewID           string                  `json:"review_id"`
+	OriginalAnchor     *RepositoryInlineAnchor `json:"original_anchor"`
+	ConversationDigest string                  `json:"conversation_digest"`
+	EvidenceDigest     string                  `json:"evidence_digest"`
+	MemberCount        int                     `json:"member_count"`
+	ResolverID         string                  `json:"resolver_id,omitempty"`
+	Resolved           bool                    `json:"resolved"`
+}
+
+// Preparation grants no mutation authority. A writer must hold native ownership
+// and repeat current admission, policy, Git and full conversation proofs before
+// committing either resolve or unresolve against this exact root.
+type RepositoryThreadSnapshot struct {
+	Review          RepositoryReviewSnapshot   `json:"review"`
+	Thread          HumanThreadEvidence        `json:"thread"`
+	ResolveAction   RepositoryActionCapability `json:"resolve_action"`
+	UnresolveAction RepositoryActionCapability `json:"unresolve_action"`
+}
+
+// ValidRepositoryThreadSnapshot checks structural scope and evidence, never authority.
+func ValidRepositoryThreadSnapshot(p *RepositoryThreadSnapshot, repository, actor string, q RepositoryThreadSnapshotRequest) bool {
+	if p == nil || !ValidRepositoryThreadSnapshotRequest(q) || !validRepositoryReviewSnapshot(&p.Review, repository, actor, RepositoryReviewSnapshotRequest{Index: q.Index}) {
+		return false
+	}
+	t := p.Thread
+	if t.RootCommentID != q.ThreadID || !validHumanThreadEvidence(t) {
+		return false
+	}
+	for _, action := range []RepositoryActionCapability{p.ResolveAction, p.UnresolveAction} {
+		if action.State != "allowed" && action.State != "denied" || len(action.Reason) > 256 {
+			return false
+		}
+	}
+	return true
+}
+
+func (a Authority) RepositoryThreadSnapshot(ctx context.Context, repository string, q RepositoryThreadSnapshotRequest) (RepositoryThreadSnapshot, error) {
+	if !positivePullID(repository) || !ValidRepositoryThreadSnapshotRequest(q) {
+		return RepositoryThreadSnapshot{}, ErrThreadSnapshotQuery
+	}
+	r, err := a.nativeClient().call(ctx, CallbackRequest{Operation: OperationRepositoryThreadSnapshot, RepositoryID: repository, ThreadSnapshot: &q})
+	if err != nil {
+		return RepositoryThreadSnapshot{}, err
+	}
+	return *r.ThreadSnapshot, nil
+}
+
+func validHumanThreadEvidence(t HumanThreadEvidence) bool {
+	return !(!positivePullID(t.RootCommentID) || !positivePullID(t.ReviewID) || t.MemberCount < 1 || t.MemberCount > MaxThreadSnapshotMembers || !validHumanReviewDigest(t.ConversationDigest) || !validHumanReviewDigest(t.EvidenceDigest) || t.OriginalAnchor != nil && !ValidRepositoryInlineAnchor(*t.OriginalAnchor) || t.Resolved != (t.ResolverID != "") || t.ResolverID != "" && !positivePullID(t.ResolverID))
+}
diff --git a/sdk/native_threads.go b/sdk/native_threads.go
new file mode 100644
index 0000000000000000000000000000000000000000..6dbb22a6c1d998ef3fa58d6875771d99a5832596
--- /dev/null
+++ b/sdk/native_threads.go
@@ -0,0 +1,130 @@
+package extensions
+
+import (
+	"context"
+	"errors"
+	"strconv"
+	"unicode/utf8"
+)
+
+var (
+	ErrThreadQuery     = errors.New("invalid thread query")
+	ErrThreadChanged   = errors.New("thread placement changed")
+	ErrThreadsTooLarge = errors.New("thread catalogue exceeds read limit")
+)
+
+// Without ThreadID, Cursor pages roots; with it, Cursor pages that root's replies.
+type RepositoryThreadsRequest struct {
+	Index    string `json:"index"`
+	ThreadID string `json:"thread_id,omitempty"`
+	Cursor   string `json:"cursor,omitempty"`
+	Limit    int    `json:"limit"`
+}
+
+func ValidRepositoryThreadsRequest(q RepositoryThreadsRequest) bool {
+	return positivePullID(q.Index) && (q.ThreadID == "" || positivePullID(q.ThreadID)) && (q.Cursor == "" || positivePullID(q.Cursor)) && q.Limit > 0 && q.Limit <= 20
+}
+
+type RepositoryThreadAnchor struct {
+	Base      string `json:"base"`
+	Head      string `json:"head"`
+	OldPath   string `json:"old_path"`
+	NewPath   string `json:"new_path"`
+	Side      string `json:"side"`
+	Scope     string `json:"scope"`
+	StartLine int64  `json:"start_line"`
+	EndLine   int64  `json:"end_line"`
+}
+type RepositoryThreadLocation struct {
+	Commit string `json:"commit"`
+	Path   string `json:"path"`
+	Side   string `json:"side"`
+	Line   int64  `json:"line"`
+}
+type RepositoryThreadComment struct {
+	Comment RepositoryDiscussionComment `json:"comment"`
+	Anchor  *RepositoryThreadAnchor     `json:"anchor"`
+}
+type RepositoryThread struct {
+	ID               string                    `json:"id"`
+	ReviewID         string                    `json:"review_id"`
+	Anchor           *RepositoryThreadAnchor   `json:"anchor"`
+	RecordedLocation *RepositoryThreadLocation `json:"recorded_location"`
+	CurrentAnchor    *RepositoryThreadAnchor   `json:"current_anchor"`
+	Outdated         *bool                     `json:"outdated"`
+	Resolved         bool                      `json:"resolved"`
+	Comments         []RepositoryThreadComment `json:"comments"`
+	CommentsNext     string                    `json:"comments_next,omitempty"`
+}
+type RepositoryThreadPage struct {
+	RepositoryID string             `json:"repository_id"`
+	PullID       string             `json:"pull_id"`
+	Index        string             `json:"index"`
+	Items        []RepositoryThread `json:"items"`
+	NextCursor   string             `json:"next_cursor,omitempty"`
+}
+
+func ValidRepositoryThreadAnchor(a *RepositoryThreadAnchor) bool {
+	if a == nil {
+		return true
+	}
+	if !ValidPullDiffCommit(a.Base) || !ValidPullDiffCommit(a.Head) || a.Side != "old" && a.Side != "new" || a.OldPath == "" && a.NewPath == "" || len(a.OldPath) > 4096 || len(a.NewPath) > 4096 || !utf8.ValidString(a.OldPath) || !utf8.ValidString(a.NewPath) || a.Side == "old" && a.OldPath == "" || a.Side == "new" && a.NewPath == "" {
+		return false
+	}
+	return a.Scope == "file" && a.StartLine == 0 && a.EndLine == 0 || a.Scope == "lines" && a.StartLine > 0 && a.EndLine >= a.StartLine && a.EndLine <= 9007199254740991
+}
+func ValidRepositoryThreadPage(p *RepositoryThreadPage, repo string, q RepositoryThreadsRequest) bool {
+	if p == nil || p.RepositoryID != repo || !positivePullID(p.PullID) || p.Index != q.Index || p.Items == nil || q.ThreadID == "" && len(p.Items) > q.Limit || q.ThreadID != "" && (len(p.Items) != 1 || p.Items[0].ID != q.ThreadID || p.NextCursor != "") {
+		return false
+	}
+	last := ""
+	bound := int64(0)
+	if q.ThreadID == "" {
+		bound, _ = strconv.ParseInt(q.Cursor, 10, 64)
+	}
+	for _, t := range p.Items {
+		if !positivePullID(t.ID) || !positivePullID(t.ReviewID) || !ValidRepositoryThreadAnchor(t.Anchor) || !ValidRepositoryThreadAnchor(t.CurrentAnchor) || t.Comments == nil {
+			return false
+		}
+		id, _ := strconv.ParseInt(t.ID, 10, 64)
+		if id <= bound {
+			return false
+		}
+		bound, last = id, t.ID
+		if l := t.RecordedLocation; l != nil {
+			if l.Path == "" || len(l.Path) > 4096 || !utf8.ValidString(l.Path) || l.Side != "old" && l.Side != "new" || l.Line < 1 || l.Line > 9007199254740991 || l.Commit != "" && !ValidPullDiffCommit(l.Commit) {
+				return false
+			}
+		}
+		limit := 10
+		if q.ThreadID != "" {
+			limit = q.Limit
+		}
+		if len(t.Comments) > limit {
+			return false
+		}
+		seen := map[string]bool{}
+		tail := ""
+		for _, c := range t.Comments {
+			if !positivePullID(c.Comment.ID) || seen[c.Comment.ID] || !ValidRepositoryThreadAnchor(c.Anchor) {
+				return false
+			}
+			seen[c.Comment.ID] = true
+			tail = c.Comment.ID
+		}
+		if t.CommentsNext != "" && (tail == "" || tail != t.CommentsNext) {
+			return false
+		}
+	}
+	return p.NextCursor == "" || last != "" && p.NextCursor == last
+}
+func (a Authority) RepositoryThreads(ctx context.Context, repo string, q RepositoryThreadsRequest) (RepositoryThreadPage, error) {
+	if !positivePullID(repo) || !ValidRepositoryThreadsRequest(q) {
+		return RepositoryThreadPage{}, ErrThreadQuery
+	}
+	r, err := a.nativeClient().call(ctx, CallbackRequest{Operation: OperationRepositoryThreads, RepositoryID: repo, Threads: &q})
+	if err != nil {
+		return RepositoryThreadPage{}, err
+	}
+	return *r.Threads, nil
+}
diff --git a/services/nativeoperation/human_comment.go b/services/nativeoperation/human_comment.go
new file mode 100644
index 0000000000000000000000000000000000000000..1d4472209b838f82bff3ac1cc20ab6c33b6ae2c3
--- /dev/null
+++ b/services/nativeoperation/human_comment.go
@@ -0,0 +1,202 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package nativeoperation
+
+import (
+	"context"
+	"encoding/json" //nolint:depguard // Persisted native intent and receipt.
+	"errors"
+	"strconv"
+	"time"
+
+	sdk "forgejo.org/extension-sdk"
+	extensionauth_model "forgejo.org/models/extensionauth"
+	issues_model "forgejo.org/models/issues"
+	nativeoperation_model "forgejo.org/models/nativeoperation"
+	access_model "forgejo.org/models/perm/access"
+	repo_model "forgejo.org/models/repo"
+	"forgejo.org/models/unit"
+	user_model "forgejo.org/models/user"
+	execcontext "forgejo.org/modules/nativeoperation"
+	notify_service "forgejo.org/services/notify"
+
+	"github.com/google/uuid"
+)
+
+const CrashPointHumanCommentBeforePrimary = "human-comment-before-primary"
+const CrashPointHumanCommentAfterPrimary = "human-comment-after-primary"
+
+// HumanCommentAdmission is supplied by trusted native request composition. It
+// must revalidate the current human/session, installation and request lifetime
+// for this exact request; a retained snapshot or background token cannot do so.
+// It runs both before replay/claim and inside the primary SQL transaction.
+type HumanCommentAdmission func(context.Context) error
+
+func nativeCommentID(value string) int64 {
+	id, err := strconv.ParseInt(value, 10, 64)
+	if err != nil || id < 1 || strconv.FormatInt(id, 10) != value {
+		return 0
+	}
+	return id
+}
+
+func humanCommentIntent(q sdk.HumanCommentRequest) (*ValidIntent, error) {
+	p := q.Expected
+	if !sdk.ValidHumanCommentRequest(q) {
+		return nil, ErrInvalidIntent
+	}
+	intent := &ValidIntent{OperationID: q.OperationID, ActorID: nativeCommentID(p.ActorID), RepositoryID: nativeCommentID(p.RepositoryID),
+		Kind: nativeoperation_model.KindHumanComment, AuthRevision: sdk.HumanCommentAuthorizationRevision, ExpectedNativeRevision: p.NativeRevision, NotAfter: q.NotAfter}
+	var err error
+	intent.Canonical, intent.Digest, err = sdk.CanonicalHumanCommentIntent(q)
+	return intent, err
+}
+
+// SubmitHumanComment uses the existing conditional journal, with no background
+// credential or enrollment. The native caller derives installation/actor from
+// its live admission. This service is not a public route or a background kind.
+func (s *Service) SubmitHumanComment(ctx context.Context, installation string, q sdk.HumanCommentRequest, admit HumanCommentAdmission) (sdk.OperationRecord, error) {
+	installationID, err := uuid.Parse(installation)
+	if err != nil || installationID.String() != installation || admit == nil {
+		return sdk.OperationRecord{}, ErrInvalidIntent
+	}
+	intent, err := humanCommentIntent(q)
+	if err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	if ctx.Err() != nil {
+		return sdk.OperationRecord{}, ctx.Err()
+	}
+	if err := admit(ctx); err != nil {
+		return sdk.OperationRecord{}, ErrAuthorityLost
+	}
+	existing, err := nativeoperation_model.LookupOperation(ctx, installation, q.OperationID)
+	if err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	if existing != nil {
+		return s.reconcileExisting(existing, intent)
+	}
+	if q.NotAfter <= s.clock() || q.NotAfter > s.clock()+int64(MaxOperationLifetime/time.Second) {
+		return sdk.OperationRecord{}, ErrInvalidIntent
+	}
+	scope := Scope{Kind: nativeoperation_model.OwnerConditional, RepositoryID: intent.RepositoryID, IssueID: nativeCommentID(q.Expected.IssueID)}
+	return s.claimConditionalSubmit(ctx, extensionauth_model.SubmissionDecision{ActorID: intent.ActorID}, installation, intent, scope,
+		func(ctx context.Context, op *nativeoperation_model.Operation, _ *ValidIntent, execution *execcontext.Execution) (sdk.OperationRecord, terminalResult, error) {
+			return s.executeHumanComment(ctx, op, q, admit, execution)
+		})
+}
+
+// Recheck live DB facts under the held owner, independently of the snapshot's
+// action flag. The admission callback separately checks the live request human.
+func humanCommentParent(ctx context.Context, q sdk.HumanCommentRequest, admit HumanCommentAdmission) (*issues_model.Issue, *user_model.User, error) {
+	if ctx.Err() != nil || admit(ctx) != nil {
+		return nil, nil, ErrAuthorityLost
+	}
+	p := q.Expected
+	actor, err := user_model.GetUserByID(ctx, nativeCommentID(p.ActorID))
+	if err != nil || !actor.IsAccessAllowed(ctx) {
+		return nil, nil, ErrAuthorityLost
+	}
+	repo, err := repo_model.GetRepositoryByID(ctx, nativeCommentID(p.RepositoryID))
+	if err != nil || repo.IsArchived {
+		return nil, nil, ErrAuthorityLost
+	}
+	issue, err := issues_model.GetIssueByID(ctx, nativeCommentID(p.IssueID))
+	if err != nil || issue.RepoID != repo.ID || issue.Index != nativeCommentID(p.Index) || issue.IsPull != (p.Subject == "pull") {
+		return nil, nil, ErrAuthorityLost
+	}
+	if user_model.IsBlockedMultiple(ctx, []int64{repo.OwnerID, issue.PosterID}, actor.ID) {
+		return nil, nil, ErrAuthorityLost
+	}
+	if issue.IsPull {
+		if err := issue.LoadPullRequest(ctx); err != nil || issue.PullRequest == nil || issue.PullRequest.ID != nativeCommentID(p.SubjectID) {
+			return nil, nil, ErrAuthorityLost
+		}
+	}
+	kind := unit.TypeIssues
+	if issue.IsPull {
+		kind = unit.TypePullRequests
+	}
+	permission, err := access_model.GetUserRepoPermission(ctx, repo, actor)
+	if err != nil || kind.UnitGlobalDisabled() || !repo.UnitEnabled(ctx, kind) || !permission.CanRead(kind) ||
+		issue.IsLocked && !permission.CanWriteIssuesOrPulls(issue.IsPull) && !actor.IsAdmin {
+		return nil, nil, ErrAuthorityLost
+	}
+	issue.Repo = repo
+	return issue, actor, nil
+}
+
+func (s *Service) executeHumanComment(ctx context.Context, op *nativeoperation_model.Operation, q sdk.HumanCommentRequest, admit HumanCommentAdmission, execution *execcontext.Execution) (sdk.OperationRecord, terminalResult, error) {
+	owned := execcontext.NewContext(ctx, execution)
+	release := context.WithoutCancel(ctx)
+	refuse := func(reason string) (sdk.OperationRecord, terminalResult, error) {
+		record, err := nativeoperation_model.SetTerminal(release, op.InstallationID, op.OperationID, nativeoperation_model.TerminalOutcome{
+			EffectState: nativeoperation_model.EffectNotCommitted, Reason: reason, Cancellation: nativeoperation_model.CancellationNone}, execution.Owner)
+		if err != nil {
+			return sdk.OperationRecord{}, terminalResult{}, err
+		}
+		return ToRecord(record), terminalResult{}, err
+	}
+	if err := TestCrashBarrier(CrashPointHumanCommentBeforePrimary); err != nil {
+		return sdk.OperationRecord{}, terminalResult{}, err
+	}
+	var issue *issues_model.Issue
+	var actor *user_model.User
+	var comment *issues_model.Comment
+	committed, err := nativeoperation_model.CommitHumanCommentPrimary(owned, op.InstallationID, op.OperationID, execution.Owner, s.clock(), func(tx context.Context) (string, error) {
+		var err error
+		issue, actor, err = humanCommentParent(tx, q, admit)
+		if err != nil {
+			return "", err
+		}
+		if s.clock() >= op.NotAfter {
+			return "", nativeoperation_model.ErrOperationExpired
+		}
+		if err := tx.Err(); err != nil {
+			return "", ErrAuthorityLost
+		}
+		comment, err = issues_model.CreateComment(tx, &issues_model.CreateCommentOptions{Type: issues_model.CommentTypeComment, Doer: actor, Repo: issue.Repo, Issue: issue, Content: q.Body})
+		if err != nil {
+			return "", err
+		}
+		raw, err := json.Marshal(sdk.HumanCommentReceipt{RepositoryID: op.RepositoryID, ActorID: op.ActorID, Subject: q.Expected.Subject,
+			SubjectID: nativeCommentID(q.Expected.SubjectID), IssueID: issue.ID, Index: issue.Index, CommentID: comment.ID})
+		return string(raw), err
+	})
+	if err != nil {
+		switch {
+		case errors.Is(err, ErrAuthorityLost):
+			return refuse(nativeoperation_model.ReasonAuthorityLost)
+		case errors.Is(err, nativeoperation_model.ErrOperationExpired):
+			return refuse(nativeoperation_model.ReasonExpiredBeforeAdmission)
+		case errors.Is(err, nativeoperation_model.ErrAdmissionLost):
+			current, readErr := nativeoperation_model.LookupOperation(release, op.InstallationID, op.OperationID)
+			if readErr != nil {
+				return sdk.OperationRecord{}, terminalResult{}, readErr
+			}
+			if current != nil && current.Revoked {
+				return refuse(nativeoperation_model.ReasonCancelledBeforeAdmission)
+			}
+		}
+		// Unknown SQL/commit errors retain the fence; never retry an uncertain
+		// primary or overwrite a receipt which may have committed.
+		return sdk.OperationRecord{}, terminalResult{}, err
+	}
+	if err := TestCrashBarrier(CrashPointHumanCommentAfterPrimary); err != nil {
+		return sdk.OperationRecord{}, terminalResult{}, err
+	}
+	completion := nativeoperation_model.CompletionComplete
+	mentions, err := issues_model.FindAndUpdateIssueMentions(owned, issue, actor, comment.Content)
+	if err != nil {
+		completion = nativeoperation_model.CompletionNeedsIntervention
+	} else {
+		notify_service.CreateIssueComment(owned, actor, issue.Repo, issue, comment, mentions)
+	}
+	record, err := nativeoperation_model.SetCompletionAndRelease(release, committed.InstallationID, committed.OperationID, execution.Owner, execution.Generation, completion)
+	if err != nil {
+		return sdk.OperationRecord{}, terminalResult{}, err
+	}
+	return ToRecord(record), terminalResult{}, err
+}
diff --git a/services/nativeoperation/human_comment_recovery.go b/services/nativeoperation/human_comment_recovery.go
new file mode 100644
index 0000000000000000000000000000000000000000..bee8a414df184cd2e3e932914902feb46694dcf4
--- /dev/null
+++ b/services/nativeoperation/human_comment_recovery.go
@@ -0,0 +1,71 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package nativeoperation
+
+import (
+	"context"
+	"encoding/json" //nolint:depguard // Persisted native intent and receipt.
+
+	sdk "forgejo.org/extension-sdk"
+	issues_model "forgejo.org/models/issues"
+	nativeoperation_model "forgejo.org/models/nativeoperation"
+)
+
+// SQL comment and receipt commit together. Offline recovery never republishes
+// the body, adopts a similar comment, or retries possibly delivered notifications.
+func (s *Service) recoverHumanComment(ctx context.Context, a *RecoveryAssessment, r *nativeoperation_model.Reservation, scope Scope, op *nativeoperation_model.Operation) (RecoveryAssessment, error) {
+	var saved struct {
+		Payload sdk.HumanCommentRequest `json:"payload"`
+	}
+	if json.Unmarshal([]byte(op.Intent), &saved) != nil {
+		return fenced(a, ReasonRecoveryMissingEvidence, "human comment intent is missing")
+	}
+	q := saved.Payload
+	intent, err := humanCommentIntent(q)
+	if err != nil || intent.Canonical != op.Intent || intent.Digest != op.IntentDigest || intent.ActorID != op.ActorID || intent.RepositoryID != op.RepositoryID ||
+		intent.OperationID != op.OperationID || scope.RepositoryID != op.RepositoryID || scope.IssueID != nativeCommentID(q.Expected.IssueID) || op.TokenID != 0 || op.CredentialFingerprint != "" {
+		return fenced(a, ReasonRecoveryUncertainEffect, "human comment scope and intent differ")
+	}
+	if !op.Admitted && op.EffectState == nativeoperation_model.EffectPending {
+		if _, err := nativeoperation_model.SetTerminal(ctx, op.InstallationID, op.OperationID, nativeoperation_model.TerminalOutcome{
+			EffectState: nativeoperation_model.EffectNotCommitted, Reason: nativeoperation_model.ReasonRecoveredNoEffect, Cancellation: nativeoperation_model.CancellationNone}, ""); err != nil {
+			return RecoveryAssessment{}, err
+		}
+		return s.releaseRecovered(ctx, a, r, nativeoperation_model.EffectNotCommitted)
+	}
+	if !op.Admitted || op.EffectState != nativeoperation_model.EffectCommitted {
+		return fenced(a, ReasonRecoveryUncertainEffect, "human comment has no atomic committed receipt")
+	}
+	var receipt sdk.HumanCommentReceipt
+	if json.Unmarshal([]byte(op.Receipt), &receipt) != nil || receipt.CommentID < 1 || receipt.RepositoryID != op.RepositoryID || receipt.ActorID != op.ActorID ||
+		receipt.IssueID != scope.IssueID || receipt.Index != nativeCommentID(q.Expected.Index) || receipt.Subject != q.Expected.Subject || receipt.SubjectID != nativeCommentID(q.Expected.SubjectID) {
+		return fenced(a, ReasonRecoveryUncertainEffect, "human comment receipt differs from intent")
+	}
+	comment, err := issues_model.GetCommentByID(ctx, receipt.CommentID)
+	if err != nil {
+		return fenced(a, ReasonRecoveryMissingEvidence, "recorded human comment cannot be read")
+	}
+	if comment.IssueID != receipt.IssueID || comment.PosterID != receipt.ActorID || comment.Type != issues_model.CommentTypeComment || comment.Content != q.Body {
+		return fenced(a, ReasonRecoveryUncertainEffect, "recorded human comment differs from native evidence")
+	}
+	issue, err := issues_model.GetIssueByID(ctx, receipt.IssueID)
+	if err != nil || issue.RepoID != receipt.RepositoryID || issue.Index != receipt.Index || issue.IsPull != (receipt.Subject == "pull") {
+		return fenced(a, ReasonRecoveryMissingEvidence, "recorded human comment parent differs")
+	}
+	if issue.IsPull {
+		if err := issue.LoadPullRequest(ctx); err != nil || issue.PullRequest == nil || issue.PullRequest.ID != receipt.SubjectID {
+			return fenced(a, ReasonRecoveryUncertainEffect, "recorded pull comment parent differs")
+		}
+	}
+	if op.Completion == nativeoperation_model.CompletionComplete || op.Completion == nativeoperation_model.CompletionNeedsIntervention {
+		return s.releaseRecovered(ctx, a, r, nativeoperation_model.EffectCommitted)
+	}
+	if _, err := nativeoperation_model.SetCompletionAndRelease(ctx, op.InstallationID, op.OperationID, r.Owner, r.Generation, nativeoperation_model.CompletionNeedsIntervention); err != nil {
+		return RecoveryAssessment{}, err
+	}
+	a.Verdict, a.Effect = RecoveryReleased, nativeoperation_model.EffectCommitted
+	a.Checks = append(a.Checks, "atomic human comment receipt matches native row; notification completion requires intervention")
+	s.retireStaleCapabilities()
+	return *a, nil
+}
diff --git a/services/nativeoperation/human_edit.go b/services/nativeoperation/human_edit.go
new file mode 100644
index 0000000000000000000000000000000000000000..26ac9b438a1bde0b4a2236aeafb7acfb1f36c786
--- /dev/null
+++ b/services/nativeoperation/human_edit.go
@@ -0,0 +1,225 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package nativeoperation
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json" //nolint:depguard // Persisted native intent and receipt.
+	"errors"
+	"time"
+
+	sdk "forgejo.org/extension-sdk"
+	"forgejo.org/models/db"
+	extensionauth_model "forgejo.org/models/extensionauth"
+	issues_model "forgejo.org/models/issues"
+	nativeoperation_model "forgejo.org/models/nativeoperation"
+	access_model "forgejo.org/models/perm/access"
+	repo_model "forgejo.org/models/repo"
+	"forgejo.org/models/unit"
+	user_model "forgejo.org/models/user"
+	execcontext "forgejo.org/modules/nativeoperation"
+	issue_service "forgejo.org/services/issue"
+	notify_service "forgejo.org/services/notify"
+
+	"github.com/google/uuid"
+)
+
+const CrashPointHumanEditBeforePrimary = "human-edit-before-primary"
+const CrashPointHumanEditAfterPrimary = "human-edit-after-primary"
+
+// HumanEditAdmission revalidates this request's current human, installation and
+// lifetime before claim/replay and again inside the primary SQL transaction.
+type HumanEditAdmission func(context.Context) error
+
+var errHumanEditChanged = errors.New("original issue edit facts changed")
+
+func editBodyDigest(body string) string {
+	sum := sha256.Sum256([]byte(body))
+	return hex.EncodeToString(sum[:])
+}
+
+func humanEditIntent(q sdk.HumanEditRequest) (*ValidIntent, error) {
+	if !sdk.ValidHumanEditRequest(q) {
+		return nil, ErrInvalidIntent
+	}
+	intent := &ValidIntent{OperationID: q.OperationID, ActorID: nativeCommentID(q.Expected.ActorID), RepositoryID: nativeCommentID(q.Expected.RepositoryID),
+		Kind: nativeoperation_model.KindHumanEdit, AuthRevision: sdk.HumanEditAuthorizationRevision, ExpectedNativeRevision: q.Expected.NativeRevision, NotAfter: q.NotAfter}
+	var err error
+	intent.Canonical, intent.Digest, err = sdk.CanonicalHumanEditIntent(q)
+	return intent, err
+}
+
+// SubmitHumanEdit uses the existing native journal and reservation, without a
+// background credential or enrollment. Only requested fields are authorized.
+func (s *Service) SubmitHumanEdit(ctx context.Context, installation string, q sdk.HumanEditRequest, admit HumanEditAdmission) (sdk.OperationRecord, error) {
+	id, err := uuid.Parse(installation)
+	if err != nil || id.String() != installation || admit == nil {
+		return sdk.OperationRecord{}, ErrInvalidIntent
+	}
+	intent, err := humanEditIntent(q)
+	if err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	if err := ctx.Err(); err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	if admit(ctx) != nil {
+		return sdk.OperationRecord{}, ErrAuthorityLost
+	}
+	existing, err := nativeoperation_model.LookupOperation(ctx, installation, q.OperationID)
+	if err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	if existing != nil {
+		return s.reconcileExisting(existing, intent)
+	}
+	if q.NotAfter <= s.clock() || q.NotAfter > s.clock()+int64(MaxOperationLifetime/time.Second) {
+		return sdk.OperationRecord{}, ErrInvalidIntent
+	}
+	scope := Scope{Kind: nativeoperation_model.OwnerConditional, RepositoryID: intent.RepositoryID, IssueID: nativeCommentID(q.Expected.IssueID)}
+	return s.claimConditionalSubmit(ctx, extensionauth_model.SubmissionDecision{ActorID: intent.ActorID}, installation, intent, scope,
+		func(ctx context.Context, op *nativeoperation_model.Operation, _ *ValidIntent, execution *execcontext.Execution) (sdk.OperationRecord, terminalResult, error) {
+			return s.executeHumanEdit(ctx, op, q, admit, execution)
+		})
+}
+
+func humanEditParent(ctx context.Context, q sdk.HumanEditRequest, admit HumanEditAdmission) (*issues_model.Issue, *user_model.User, error) {
+	if ctx.Err() != nil || admit(ctx) != nil {
+		return nil, nil, ErrAuthorityLost
+	}
+	p := q.Expected
+	actor, err := user_model.GetUserByID(ctx, nativeCommentID(p.ActorID))
+	if err != nil || !actor.IsAccessAllowed(ctx) {
+		return nil, nil, ErrAuthorityLost
+	}
+	repo, err := repo_model.GetRepositoryByID(ctx, nativeCommentID(p.RepositoryID))
+	if err != nil || repo.IsArchived {
+		return nil, nil, ErrAuthorityLost
+	}
+	issue, err := issues_model.GetIssueByID(ctx, nativeCommentID(p.IssueID))
+	if err != nil || issue.RepoID != repo.ID || issue.Index != nativeCommentID(p.Index) || issue.IsPull != (p.Subject == "pull") {
+		return nil, nil, ErrAuthorityLost
+	}
+	if issue.IsPull {
+		if err := issue.LoadPullRequest(ctx); err != nil || issue.PullRequest == nil || issue.PullRequest.ID != nativeCommentID(p.SubjectID) {
+			return nil, nil, ErrAuthorityLost
+		}
+	}
+	kind := unit.TypeIssues
+	if issue.IsPull {
+		kind = unit.TypePullRequests
+	}
+	permission, err := access_model.GetUserRepoPermission(ctx, repo, actor)
+	if err != nil || kind.UnitGlobalDisabled() || !repo.UnitEnabled(ctx, kind) || !permission.CanRead(kind) {
+		return nil, nil, ErrAuthorityLost
+	}
+	writer := permission.CanWriteIssuesOrPulls(issue.IsPull)
+	if q.Title != nil && (!issue.IsPoster(actor.ID) && !writer || user_model.IsBlockedMultiple(ctx, []int64{repo.OwnerID, issue.PosterID}, actor.ID)) ||
+		q.Body != nil && issue.PosterID != actor.ID && !writer {
+		return nil, nil, ErrAuthorityLost
+	}
+	if issue.Title != p.Title || editBodyDigest(issue.Content) != p.BodyDigest || int64(issue.ContentVersion) != p.ContentVersion {
+		return nil, nil, errHumanEditChanged
+	}
+	issue.Repo = repo
+	return issue, actor, nil
+}
+
+func (s *Service) executeHumanEdit(ctx context.Context, op *nativeoperation_model.Operation, q sdk.HumanEditRequest, admit HumanEditAdmission, execution *execcontext.Execution) (sdk.OperationRecord, terminalResult, error) {
+	owned, release := execcontext.NewContext(ctx, execution), context.WithoutCancel(ctx)
+	refuse := func(reason string) (sdk.OperationRecord, terminalResult, error) {
+		r, err := nativeoperation_model.SetTerminal(release, op.InstallationID, op.OperationID, nativeoperation_model.TerminalOutcome{EffectState: nativeoperation_model.EffectNotCommitted, Reason: reason, Cancellation: nativeoperation_model.CancellationNone}, execution.Owner)
+		if err != nil {
+			return sdk.OperationRecord{}, terminalResult{}, err
+		}
+		return ToRecord(r), terminalResult{}, err
+	}
+	if err := TestCrashBarrier(CrashPointHumanEditBeforePrimary); err != nil {
+		return sdk.OperationRecord{}, terminalResult{}, err
+	}
+	var issue *issues_model.Issue
+	var actor *user_model.User
+	var oldTitle, oldBody string
+	var titleChanged, bodyChanged bool
+	committed, err := nativeoperation_model.CommitHumanEditPrimary(owned, op.InstallationID, op.OperationID, execution.Owner, s.clock(), func(tx context.Context) (string, error) {
+		var err error
+		issue, actor, err = humanEditParent(tx, q, admit)
+		if err != nil {
+			return "", err
+		}
+		if s.clock() >= op.NotAfter {
+			return "", nativeoperation_model.ErrOperationExpired
+		}
+		oldTitle, oldBody = issue.Title, issue.Content
+		titleChanged, bodyChanged = q.Title != nil && *q.Title != oldTitle, q.Body != nil && *q.Body != oldBody
+		var titleCommentID int64
+		if titleChanged {
+			if err := issues_model.IfNeededCreateShadowCopyForIssue(tx, issue); err != nil {
+				return "", err
+			}
+			issue.Title = *q.Title
+			if err := issues_model.ChangeIssueTitle(tx, issue, actor, oldTitle); err != nil {
+				return "", err
+			}
+			var comment issues_model.Comment
+			found, err := db.GetEngine(tx).Where("issue_id=? AND type=? AND poster_id=? AND old_title=? AND new_title=?", issue.ID, issues_model.CommentTypeChangeTitle, actor.ID, oldTitle, issue.Title).Desc("id").Get(&comment)
+			if err != nil {
+				return "", err
+			}
+			if !found {
+				return "", errors.New("native title history missing")
+			}
+			titleCommentID = comment.ID
+		}
+		if bodyChanged {
+			if err := issues_model.ChangeIssueContent(tx, issue, actor, *q.Body, issue.ContentVersion); err != nil {
+				return "", err
+			}
+		}
+		if err := tx.Err(); err != nil {
+			return "", ErrAuthorityLost
+		}
+		raw, err := json.Marshal(sdk.HumanEditReceipt{RepositoryID: op.RepositoryID, ActorID: op.ActorID, Subject: q.Expected.Subject, SubjectID: nativeCommentID(q.Expected.SubjectID), IssueID: issue.ID, Index: issue.Index,
+			Title: issue.Title, BodyDigest: editBodyDigest(issue.Content), ContentVersion: int64(issue.ContentVersion), TitleCommentID: titleCommentID})
+		return string(raw), err
+	})
+	if err != nil {
+		switch {
+		case errors.Is(err, ErrAuthorityLost):
+			return refuse(nativeoperation_model.ReasonAuthorityLost)
+		case errors.Is(err, errHumanEditChanged), errors.Is(err, issues_model.ErrIssueAlreadyChanged):
+			return refuse(nativeoperation_model.ReasonStaleConversation)
+		case errors.Is(err, nativeoperation_model.ErrOperationExpired):
+			return refuse(nativeoperation_model.ReasonExpiredBeforeAdmission)
+		case errors.Is(err, nativeoperation_model.ErrAdmissionLost):
+			current, readErr := nativeoperation_model.LookupOperation(release, op.InstallationID, op.OperationID)
+			if readErr != nil {
+				return sdk.OperationRecord{}, terminalResult{}, readErr
+			}
+			if current != nil && current.Revoked {
+				return refuse(nativeoperation_model.ReasonCancelledBeforeAdmission)
+			}
+		}
+		return sdk.OperationRecord{}, terminalResult{}, err // Uncertain SQL errors retain the fence.
+	}
+	if err := TestCrashBarrier(CrashPointHumanEditAfterPrimary); err != nil {
+		return sdk.OperationRecord{}, terminalResult{}, err
+	}
+	completion := nativeoperation_model.CompletionComplete
+	if titleChanged {
+		if err := issue_service.CompleteTitleChange(owned, issue, actor, oldTitle); err != nil {
+			completion = nativeoperation_model.CompletionNeedsIntervention
+		}
+	}
+	if bodyChanged {
+		notify_service.IssueChangeContent(owned, actor, issue, oldBody)
+	}
+	r, err := nativeoperation_model.SetCompletionAndRelease(release, committed.InstallationID, committed.OperationID, execution.Owner, execution.Generation, completion)
+	if err != nil {
+		return sdk.OperationRecord{}, terminalResult{}, err
+	}
+	return ToRecord(r), terminalResult{}, err
+}
diff --git a/services/nativeoperation/human_edit_recovery.go b/services/nativeoperation/human_edit_recovery.go
new file mode 100644
index 0000000000000000000000000000000000000000..a60e105d4cf3d3a01e2cd9ab008d29a119027d44
--- /dev/null
+++ b/services/nativeoperation/human_edit_recovery.go
@@ -0,0 +1,84 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package nativeoperation
+
+import (
+	"context"
+	"encoding/json" //nolint:depguard // Persisted native intent and receipt.
+
+	sdk "forgejo.org/extension-sdk"
+	issues_model "forgejo.org/models/issues"
+	nativeoperation_model "forgejo.org/models/nativeoperation"
+)
+
+// Offline recovery proves the exact atomic effect; it never reapplies an edit
+// or repeats notifications/code-owner requests whose delivery is uncertain.
+func (s *Service) recoverHumanEdit(ctx context.Context, a *RecoveryAssessment, r *nativeoperation_model.Reservation, scope Scope, op *nativeoperation_model.Operation) (RecoveryAssessment, error) {
+	var saved struct {
+		Payload sdk.HumanEditRequest `json:"payload"`
+	}
+	if json.Unmarshal([]byte(op.Intent), &saved) != nil {
+		return fenced(a, ReasonRecoveryMissingEvidence, "human edit intent is missing")
+	}
+	q := saved.Payload
+	intent, err := humanEditIntent(q)
+	if err != nil || intent.Canonical != op.Intent || intent.Digest != op.IntentDigest || intent.ActorID != op.ActorID || intent.RepositoryID != op.RepositoryID ||
+		intent.OperationID != op.OperationID || scope.RepositoryID != op.RepositoryID || scope.IssueID != nativeCommentID(q.Expected.IssueID) || op.TokenID != 0 || op.CredentialFingerprint != "" {
+		return fenced(a, ReasonRecoveryUncertainEffect, "human edit scope and intent differ")
+	}
+	if !op.Admitted && op.EffectState == nativeoperation_model.EffectPending {
+		if _, err := nativeoperation_model.SetTerminal(ctx, op.InstallationID, op.OperationID, nativeoperation_model.TerminalOutcome{
+			EffectState: nativeoperation_model.EffectNotCommitted, Reason: nativeoperation_model.ReasonRecoveredNoEffect, Cancellation: nativeoperation_model.CancellationNone}, ""); err != nil {
+			return RecoveryAssessment{}, err
+		}
+		return s.releaseRecovered(ctx, a, r, nativeoperation_model.EffectNotCommitted)
+	}
+	if !op.Admitted || op.EffectState != nativeoperation_model.EffectCommitted {
+		return fenced(a, ReasonRecoveryUncertainEffect, "human edit has no atomic committed receipt")
+	}
+	title, digest, version := q.Expected.Title, q.Expected.BodyDigest, q.Expected.ContentVersion
+	titleChanged := q.Title != nil && *q.Title != title
+	if q.Title != nil {
+		title = *q.Title
+	}
+	if q.Body != nil {
+		nextDigest := editBodyDigest(*q.Body)
+		if nextDigest != digest {
+			version++
+		}
+		digest = nextDigest
+	}
+	var receipt sdk.HumanEditReceipt
+	if json.Unmarshal([]byte(op.Receipt), &receipt) != nil || receipt.RepositoryID != op.RepositoryID || receipt.ActorID != op.ActorID ||
+		receipt.IssueID != scope.IssueID || receipt.Index != nativeCommentID(q.Expected.Index) || receipt.Subject != q.Expected.Subject || receipt.SubjectID != nativeCommentID(q.Expected.SubjectID) ||
+		receipt.Title != title || receipt.BodyDigest != digest || receipt.ContentVersion != version || titleChanged && receipt.TitleCommentID < 1 || !titleChanged && receipt.TitleCommentID != 0 {
+		return fenced(a, ReasonRecoveryUncertainEffect, "human edit receipt differs from intent")
+	}
+	issue, err := issues_model.GetIssueByID(ctx, receipt.IssueID)
+	if err != nil || issue.RepoID != receipt.RepositoryID || issue.Index != receipt.Index || issue.IsPull != (receipt.Subject == "pull") ||
+		issue.Title != title || editBodyDigest(issue.Content) != digest || int64(issue.ContentVersion) != version {
+		return fenced(a, ReasonRecoveryMissingEvidence, "recorded human edit parent or content differs")
+	}
+	if issue.IsPull {
+		if err := issue.LoadPullRequest(ctx); err != nil || issue.PullRequest == nil || issue.PullRequest.ID != receipt.SubjectID {
+			return fenced(a, ReasonRecoveryUncertainEffect, "recorded human edit pull differs")
+		}
+	}
+	if titleChanged {
+		comment, err := issues_model.GetCommentByID(ctx, receipt.TitleCommentID)
+		if err != nil || comment.IssueID != issue.ID || comment.PosterID != op.ActorID || comment.Type != issues_model.CommentTypeChangeTitle || comment.OldTitle != q.Expected.Title || comment.NewTitle != title {
+			return fenced(a, ReasonRecoveryMissingEvidence, "recorded native title history differs")
+		}
+	}
+	if op.Completion == nativeoperation_model.CompletionComplete || op.Completion == nativeoperation_model.CompletionNeedsIntervention {
+		return s.releaseRecovered(ctx, a, r, nativeoperation_model.EffectCommitted)
+	}
+	if _, err := nativeoperation_model.SetCompletionAndRelease(ctx, op.InstallationID, op.OperationID, r.Owner, r.Generation, nativeoperation_model.CompletionNeedsIntervention); err != nil {
+		return RecoveryAssessment{}, err
+	}
+	a.Verdict, a.Effect = RecoveryReleased, nativeoperation_model.EffectCommitted
+	a.Checks = append(a.Checks, "atomic human edit receipt matches native content/history; completion requires intervention")
+	s.retireStaleCapabilities()
+	return *a, nil
+}
diff --git a/services/nativeoperation/human_inline.go b/services/nativeoperation/human_inline.go
new file mode 100644
index 0000000000000000000000000000000000000000..ebf9bb0d22a17f9a0205b92dc04e7c1d36207624
--- /dev/null
+++ b/services/nativeoperation/human_inline.go
@@ -0,0 +1,204 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package nativeoperation
+
+import (
+	"context"
+	"encoding/json" //nolint:depguard // Exact persisted intent and native receipt.
+	"errors"
+	"time"
+
+	sdk "forgejo.org/extension-sdk"
+	extensionauth_model "forgejo.org/models/extensionauth"
+	issues_model "forgejo.org/models/issues"
+	nativeoperation_model "forgejo.org/models/nativeoperation"
+	user_model "forgejo.org/models/user"
+	"forgejo.org/modules/git"
+	execcontext "forgejo.org/modules/nativeoperation"
+	pull_service "forgejo.org/services/pull"
+
+	"github.com/google/uuid"
+)
+
+const CrashPointHumanInlineBeforePrimary = "human-inline-before-primary"
+const CrashPointHumanInlineAfterPrimary = "human-inline-after-primary"
+
+func humanInlineIntent(q sdk.HumanInlineRequest) (*ValidIntent, error) {
+	if !sdk.ValidHumanInlineRequest(q) {
+		return nil, ErrInvalidIntent
+	}
+	p := q.Expected.Review
+	intent := &ValidIntent{OperationID: q.OperationID, ActorID: nativeCommentID(p.ActorID), RepositoryID: nativeCommentID(p.RepositoryID), Kind: nativeoperation_model.KindHumanInline, AuthRevision: sdk.HumanInlineAuthorizationRevision, ExpectedNativeRevision: p.NativeRevision, NotAfter: q.NotAfter}
+	var err error
+	intent.Canonical, intent.Digest, err = sdk.CanonicalHumanInlineIntent(q)
+	return intent, err
+}
+
+// SubmitHumanInline composes fresh held Git proof, prepared native SQL and an
+// exact journal receipt. The caller supplies current human request admission;
+// no background binding or credential can authorize this operation.
+func (s *Service) SubmitHumanInline(ctx context.Context, installation string, q sdk.HumanInlineRequest, admit HumanReviewAdmission) (sdk.OperationRecord, error) {
+	id, err := uuid.Parse(installation)
+	if err != nil || id.String() != installation || admit == nil {
+		return sdk.OperationRecord{}, ErrInvalidIntent
+	}
+	intent, err := humanInlineIntent(q)
+	if err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	if err := ctx.Err(); err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	if admit(ctx) != nil {
+		return sdk.OperationRecord{}, ErrAuthorityLost
+	}
+	existing, err := nativeoperation_model.LookupOperation(ctx, installation, q.OperationID)
+	if err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	if existing != nil {
+		return s.reconcileExisting(existing, intent)
+	}
+	if q.NotAfter <= s.clock() || q.NotAfter > s.clock()+int64(MaxOperationLifetime/time.Second) {
+		return sdk.OperationRecord{}, ErrInvalidIntent
+	}
+	scope := Scope{Kind: nativeoperation_model.OwnerConditional, RepositoryID: intent.RepositoryID, IssueID: nativeCommentID(q.Expected.Review.IssueID)}
+	return s.claimConditionalSubmit(ctx, extensionauth_model.SubmissionDecision{ActorID: intent.ActorID}, installation, intent, scope, func(ctx context.Context, op *nativeoperation_model.Operation, _ *ValidIntent, execution *execcontext.Execution) (sdk.OperationRecord, terminalResult, error) {
+		return s.executeHumanInline(ctx, op, q, admit, execution)
+	})
+}
+
+func (s *Service) executeHumanInline(ctx context.Context, op *nativeoperation_model.Operation, q sdk.HumanInlineRequest, admit HumanReviewAdmission, execution *execcontext.Execution) (sdk.OperationRecord, terminalResult, error) {
+	owned, release := execcontext.NewContext(ctx, execution), context.WithoutCancel(ctx)
+	refuse := func(reason string) (sdk.OperationRecord, terminalResult, error) {
+		r, err := nativeoperation_model.SetTerminal(release, op.InstallationID, op.OperationID, nativeoperation_model.TerminalOutcome{EffectState: nativeoperation_model.EffectNotCommitted, Reason: reason, Cancellation: nativeoperation_model.CancellationNone}, execution.Owner)
+		if err != nil {
+			return sdk.OperationRecord{}, terminalResult{}, err
+		}
+		return ToRecord(r), terminalResult{}, nil
+	}
+	if err := TestCrashBarrier(CrashPointHumanInlineBeforePrimary); err != nil {
+		return sdk.OperationRecord{}, terminalResult{}, err
+	}
+	var result *issues_model.PreparedHumanInlineResult
+	var actor *user_model.User
+	committed, err := nativeoperation_model.CommitHumanInlinePrimary(owned, op.InstallationID, op.OperationID, execution.Owner, s.clock(), func(tx context.Context) (string, error) {
+		if tx.Err() != nil || admit(tx) != nil {
+			return "", ErrAuthorityLost
+		}
+		if s.clock() >= op.NotAfter {
+			return "", nativeoperation_model.ErrOperationExpired
+		}
+		p := q.Expected.Review
+		issue, err := issues_model.GetIssueByID(tx, nativeCommentID(p.IssueID))
+		if err != nil || issue.RepoID != op.RepositoryID || issue.Index != nativeCommentID(p.Index) || !issue.IsPull {
+			return "", ErrAuthorityLost
+		}
+		if err := issue.LoadPullRequest(tx); err != nil || issue.PullRequest == nil {
+			return "", ErrAuthorityLost
+		}
+		if err := issue.LoadRepo(tx); err != nil {
+			return "", err
+		}
+		actor, err = user_model.GetUserByID(tx, op.ActorID)
+		if err != nil || !actor.IsAccessAllowed(tx) {
+			return "", ErrAuthorityLost
+		}
+		native, err := git.OpenRepository(tx, issue.Repo.RepoPath())
+		if err != nil {
+			return "", err
+		}
+		defer native.Close()
+		head, err := native.GetRefCommitID(issue.PullRequest.GetGitRefName())
+		if err != nil {
+			return "", issues_model.ErrExactReviewRefused{Reason: "head changed"}
+		}
+		base, err := native.GetRefCommitID(git.BranchPrefix + p.BaseBranch)
+		if err != nil {
+			return "", issues_model.ErrExactReviewRefused{Reason: "base changed"}
+		}
+		mergeBase, err := native.GetMergeBaseSimple(base, head)
+		if err != nil {
+			return "", issues_model.ErrExactReviewRefused{Reason: "merge base changed"}
+		}
+		a := q.Expected.Anchor
+		anchor := issues_model.CodeCommentAnchor{Base: a.Base, Head: a.Head, Path: a.Path, Side: a.Side, Scope: a.Scope, StartLine: a.StartLine, EndLine: a.EndLine}
+		proof, err := ProveHumanInlineAnchor(tx, native, anchor)
+		if err != nil {
+			return "", err
+		}
+		want := issues_model.PreparedHumanInlineTarget{Review: issues_model.PreparedHumanReviewTarget{RepositoryID: op.RepositoryID, ReviewerID: op.ActorID, PullID: nativeCommentID(p.PullID), IssueID: issue.ID, Index: issue.Index, BaseBranch: p.BaseBranch, IsClosed: p.IsClosed, HasMerged: p.HasMerged, IsAuthor: p.IsAuthor, HeadOID: p.HeadOID, BaseOID: p.BaseOID, MergeBaseOID: p.MergeBaseOID, CurrentHeadOID: head, CurrentBaseOID: base, CurrentMergeBaseOID: mergeBase, PendingReviewID: nativeCommentID(p.PendingReviewID), PendingCommitID: p.PendingCommitID}, Anchor: anchor, EntryOID: q.Expected.EntryOID, EntryKind: q.Expected.EntryKind, DiffDigest: q.Expected.DiffDigest, CurrentAnchor: anchor, CurrentEntryOID: proof.EntryOID, CurrentEntryKind: proof.EntryKind, CurrentDiffDigest: proof.DiffDigest}
+		result, err = issues_model.CreatePreparedHumanInlineComment(tx, q.Body, q.Draft, want)
+		if err != nil {
+			return "", err
+		}
+		count, digest, err := humanReviewCommentsEvidence(tx, result.Review)
+		if err != nil {
+			return "", err
+		}
+		r := sdk.HumanInlineReceipt{RepositoryID: op.RepositoryID, ActorID: op.ActorID, PullID: want.Review.PullID, IssueID: issue.ID, Index: issue.Index, ReviewID: result.Review.ID, CommentID: result.Inline.ID, Draft: q.Draft, CommitID: result.Review.CommitID, Official: result.Review.Official, Stale: result.Review.Stale, BodyDigest: sdk.HumanReviewBodyDigest(q.Body), ReviewDigest: sdk.HumanReviewBodyDigest(result.Review.Content), Anchor: a, EntryOID: q.Expected.EntryOID, EntryKind: q.Expected.EntryKind, DiffDigest: q.Expected.DiffDigest, CommentsCount: count, CommentsDigest: digest}
+		if result.History != nil {
+			r.HistoryID = result.History.ID
+		}
+		if !sdk.ValidHumanInlineReceipt(r, q) {
+			return "", errors.New("native human inline receipt differs")
+		}
+		if tx.Err() != nil {
+			return "", ErrAuthorityLost
+		}
+		raw, err := json.Marshal(r)
+		return string(raw), err
+	})
+	if err != nil {
+		var deterministic issues_model.ErrExactReviewRefused
+		switch {
+		case errors.Is(err, ErrAuthorityLost):
+			return refuse(nativeoperation_model.ReasonAuthorityLost)
+		case errors.As(err, &deterministic):
+			reason := nativeoperation_model.ReasonNativeRefused
+			switch deterministic.Reason {
+			case "head changed":
+				reason = nativeoperation_model.ReasonStaleHead
+			case "base changed", "merge base changed":
+				reason = nativeoperation_model.ReasonStaleBaseOrResult
+			case "pending draft changed":
+				reason = nativeoperation_model.ReasonPendingReviewExists
+			case "reviewer is inactive", "reviewer cannot read this pull request", "reviewer is blocked", "review workflow unavailable":
+				reason = nativeoperation_model.ReasonAuthorityLost
+			case "human review parent changed", "human review pull changed":
+				reason = nativeoperation_model.ReasonPRMismatch
+			}
+			return refuse(reason)
+		case issues_model.IsContentEmptyErr(err):
+			return refuse(nativeoperation_model.ReasonNativeRefused)
+		case errors.Is(err, nativeoperation_model.ErrOperationExpired):
+			return refuse(nativeoperation_model.ReasonExpiredBeforeAdmission)
+		case errors.Is(err, nativeoperation_model.ErrAdmissionLost):
+			current, e := nativeoperation_model.LookupOperation(release, op.InstallationID, op.OperationID)
+			if e != nil {
+				return sdk.OperationRecord{}, terminalResult{}, e
+			}
+			if current != nil && current.Revoked {
+				return refuse(nativeoperation_model.ReasonCancelledBeforeAdmission)
+			}
+		}
+		return sdk.OperationRecord{}, terminalResult{}, err
+	}
+	if err := TestCrashBarrier(CrashPointHumanInlineAfterPrimary); err != nil {
+		return sdk.OperationRecord{}, terminalResult{}, err
+	}
+	completion := nativeoperation_model.CompletionComplete
+	if !q.Draft {
+		if owned.Err() != nil {
+			completion = nativeoperation_model.CompletionNeedsIntervention
+		} else if err := pull_service.CompleteReviewSubmission(owned, actor, result.Review.Issue, result.Review, result.History); err != nil {
+			completion = nativeoperation_model.CompletionNeedsIntervention
+		}
+	}
+	r, err := nativeoperation_model.SetCompletionAndRelease(release, committed.InstallationID, committed.OperationID, execution.Owner, execution.Generation, completion)
+	if err != nil {
+		return sdk.OperationRecord{}, terminalResult{}, err
+	}
+	return ToRecord(r), terminalResult{}, nil
+}
diff --git a/services/nativeoperation/human_inline_anchor.go b/services/nativeoperation/human_inline_anchor.go
new file mode 100644
index 0000000000000000000000000000000000000000..d0619214a20dc65893e493e3c7d1dcda5e568c57
--- /dev/null
+++ b/services/nativeoperation/human_inline_anchor.go
@@ -0,0 +1,114 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package nativeoperation
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"io"
+
+	issues_model "forgejo.org/models/issues"
+	"forgejo.org/modules/git"
+)
+
+const MaxHumanInlineDiffBytes = 4 << 20
+
+var ErrHumanInlineDiffTooLarge = errors.New("inline diff proof exceeds limit")
+
+type HumanInlineProof struct{ EntryOID, EntryKind, DiffDigest string }
+
+type humanInlineBuffer struct {
+	buffer   bytes.Buffer
+	exceeded bool
+}
+
+func (b *humanInlineBuffer) Len() int      { return b.buffer.Len() }
+func (b *humanInlineBuffer) Bytes() []byte { return b.buffer.Bytes() }
+
+func (b *humanInlineBuffer) Write(p []byte) (int, error) {
+	if len(p) > MaxHumanInlineDiffBytes-b.Len() {
+		b.exceeded = true
+		return 0, ErrHumanInlineDiffTooLarge
+	}
+	return b.buffer.Write(p)
+}
+
+// ProveHumanInlineAnchor reads immutable Git objects only. Callers own live PR,
+// native revision, principal and permission checks. File anchors need only bounded
+// raw change metadata, so large/binary files do not require a full text patch.
+// Line ranges must be wholly covered by actual hunks on their selected side.
+func ProveHumanInlineAnchor(ctx context.Context, repository *git.Repository, a issues_model.CodeCommentAnchor) (HumanInlineProof, error) {
+	var proof HumanInlineProof
+	refuse := func() (HumanInlineProof, error) {
+		return proof, issues_model.ErrExactReviewRefused{Reason: "invalid inline anchor"}
+	}
+	if a.Validate() != nil || a.EndLine > 9007199254740991 {
+		return refuse()
+	}
+	commit := a.Head
+	if a.Side == "old" {
+		commit = a.Base
+	}
+	tree, err := repository.GetCommit(commit)
+	if err != nil {
+		return proof, err
+	}
+	entry, err := tree.GetTreeEntryByPath(a.Path)
+	if git.IsErrNotExist(err) {
+		return refuse()
+	}
+	if err != nil {
+		return proof, err
+	}
+	if entry.IsDir() || a.Scope == "lines" && entry.IsSubmodule() {
+		return refuse()
+	}
+	output := &humanInlineBuffer{}
+	cmd := git.NewCommand(ctx, "--literal-pathspecs", "diff", "--no-color", "--no-ext-diff", "--no-textconv", "--no-renames", "--no-relative", "--ignore-submodules=none", "--submodule=short", "--diff-algorithm=histogram")
+	if a.Scope == "file" {
+		cmd.AddArguments("--raw", "-z", "--no-abbrev")
+	} else {
+		cmd.AddArguments("--patch", "--src-prefix=a/", "--dst-prefix=b/", "--unified=3")
+	}
+	err = cmd.AddDynamicArguments(a.Base, a.Head).AddDashesAndList(a.Path).Run(&git.RunOpts{Dir: repository.Path, Stdout: output})
+	if output.exceeded {
+		return proof, ErrHumanInlineDiffTooLarge
+	}
+	if err != nil {
+		if errors.Is(err, ErrHumanInlineDiffTooLarge) || output.Len() >= MaxHumanInlineDiffBytes {
+			return proof, ErrHumanInlineDiffTooLarge
+		}
+		return proof, err
+	}
+	if output.Len() == 0 {
+		return refuse()
+	}
+	if a.Scope == "lines" {
+		lines := parseReviewFileDiff(output.Bytes())
+		if lines.binary || !lines.hasHunks {
+			return refuse()
+		}
+		covered := lines.newLines
+		if a.Side == "old" {
+			covered = lines.oldLines
+		}
+		var count int64
+		for line := range covered {
+			if line >= a.StartLine && line <= a.EndLine {
+				count++
+			}
+		}
+		if count != a.EndLine-a.StartLine+1 {
+			return refuse()
+		}
+	}
+	sum := sha256.Sum256(output.Bytes())
+	proof = HumanInlineProof{EntryOID: entry.ID.String(), EntryKind: entry.Type(), DiffDigest: hex.EncodeToString(sum[:])}
+	return proof, nil
+}
+
+var _ io.Writer = (*humanInlineBuffer)(nil)
diff --git a/services/nativeoperation/human_inline_recovery.go b/services/nativeoperation/human_inline_recovery.go
new file mode 100644
index 0000000000000000000000000000000000000000..1caa7f7e7077c967939f1f3697a0ffd10c20290f
--- /dev/null
+++ b/services/nativeoperation/human_inline_recovery.go
@@ -0,0 +1,94 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package nativeoperation
+
+import (
+	"context"
+	"encoding/json" //nolint:depguard // Persisted exact native intent and receipt.
+
+	sdk "forgejo.org/extension-sdk"
+	issues_model "forgejo.org/models/issues"
+	nativeoperation_model "forgejo.org/models/nativeoperation"
+)
+
+// Recovery attributes exact SQL evidence under the stopped writer's fence. It
+// never creates another inline, retargets context or retries notifications.
+func (s *Service) recoverHumanInline(ctx context.Context, a *RecoveryAssessment, reservation *nativeoperation_model.Reservation, scope Scope, op *nativeoperation_model.Operation) (RecoveryAssessment, error) {
+	var saved struct {
+		Payload sdk.HumanInlineRequest `json:"payload"`
+	}
+	if json.Unmarshal([]byte(op.Intent), &saved) != nil {
+		return fenced(a, ReasonRecoveryMissingEvidence, "human inline intent is missing")
+	}
+	q := saved.Payload
+	intent, err := humanInlineIntent(q)
+	if err != nil || intent.Canonical != op.Intent || intent.Digest != op.IntentDigest || intent.OperationID != op.OperationID || intent.ActorID != op.ActorID || intent.RepositoryID != op.RepositoryID || intent.AuthRevision != op.AuthRevision || intent.ExpectedNativeRevision != op.ExpectedNativeRevision || intent.NotAfter != op.NotAfter || scope.RepositoryID != op.RepositoryID || scope.IssueID != nativeCommentID(q.Expected.Review.IssueID) || op.TokenID != 0 || op.CredentialFingerprint != "" {
+		return fenced(a, ReasonRecoveryUncertainEffect, "human inline scope and intent differ")
+	}
+	if !op.Admitted && op.EffectState == nativeoperation_model.EffectPending {
+		if _, err := nativeoperation_model.SetTerminal(ctx, op.InstallationID, op.OperationID, nativeoperation_model.TerminalOutcome{EffectState: nativeoperation_model.EffectNotCommitted, Reason: nativeoperation_model.ReasonRecoveredNoEffect, Cancellation: nativeoperation_model.CancellationNone}, ""); err != nil {
+			return RecoveryAssessment{}, err
+		}
+		return s.releaseRecovered(ctx, a, reservation, nativeoperation_model.EffectNotCommitted)
+	}
+	if !op.Admitted || op.EffectState != nativeoperation_model.EffectCommitted {
+		return fenced(a, ReasonRecoveryUncertainEffect, "human inline has no atomic committed receipt")
+	}
+	var receipt sdk.HumanInlineReceipt
+	if json.Unmarshal([]byte(op.Receipt), &receipt) != nil || !sdk.ValidHumanInlineReceipt(receipt, q) {
+		return fenced(a, ReasonRecoveryUncertainEffect, "human inline receipt differs from intent")
+	}
+	issue, err := issues_model.GetIssueByID(ctx, receipt.IssueID)
+	if err != nil || issue.RepoID != receipt.RepositoryID || issue.Index != receipt.Index || !issue.IsPull {
+		return fenced(a, ReasonRecoveryMissingEvidence, "human inline parent differs")
+	}
+	if err := issue.LoadPullRequest(ctx); err != nil || issue.PullRequest == nil || issue.PullRequest.ID != receipt.PullID || issue.PullRequest.BaseRepoID != receipt.RepositoryID {
+		return fenced(a, ReasonRecoveryUncertainEffect, "human inline pull identity differs")
+	}
+	typ := issues_model.ReviewTypeComment
+	if q.Draft {
+		typ = issues_model.ReviewTypePending
+	}
+	review, err := issues_model.GetReviewByID(ctx, receipt.ReviewID)
+	if err != nil || review.IssueID != receipt.IssueID || review.ReviewerID != receipt.ActorID || review.ReviewerTeamID != 0 || review.OriginalAuthorID != 0 || review.Type != typ || sdk.HumanReviewBodyDigest(review.Content) != receipt.ReviewDigest || review.CommitID != receipt.CommitID || review.Official != receipt.Official || review.Stale != receipt.Stale || review.Dismissed {
+		return fenced(a, ReasonRecoveryMissingEvidence, "human inline review differs")
+	}
+	inline, err := issues_model.GetCommentByID(ctx, receipt.CommentID)
+	anchor := receipt.Anchor
+	expected := &issues_model.CodeCommentAnchor{Base: anchor.Base, Head: anchor.Head, Path: anchor.Path, Side: anchor.Side, Scope: anchor.Scope, StartLine: anchor.StartLine, EndLine: anchor.EndLine}
+	line, commit := anchor.EndLine, anchor.Head
+	if anchor.Side == "old" {
+		line, commit = -line, anchor.Base
+	}
+	if err != nil || inline.Type != issues_model.CommentTypeCode || inline.IssueID != receipt.IssueID || inline.ReviewID != receipt.ReviewID || inline.PosterID != receipt.ActorID || inline.OriginalAuthorID != 0 || inline.Content != q.Body || inline.TreePath != anchor.Path || inline.Line != line || inline.CommitSHA != commit || !inline.OriginalAnchor.Equal(expected) || inline.Invalidated || inline.Patch != "" {
+		return fenced(a, ReasonRecoveryMissingEvidence, "human inline row or original context differs")
+	}
+	count, digest, err := humanReviewCommentsEvidence(ctx, review)
+	if err != nil || count != receipt.CommentsCount || digest != receipt.CommentsDigest {
+		return fenced(a, ReasonRecoveryMissingEvidence, "human inline complete draft evidence differs")
+	}
+	if !q.Draft {
+		history, err := issues_model.GetCommentByID(ctx, receipt.HistoryID)
+		if err != nil || history.Type != issues_model.CommentTypeReview || history.IssueID != receipt.IssueID || history.ReviewID != receipt.ReviewID || history.PosterID != receipt.ActorID || history.OriginalAuthorID != 0 || history.Content != review.Content {
+			return fenced(a, ReasonRecoveryMissingEvidence, "human inline review history differs")
+		}
+	}
+	if op.Completion == nativeoperation_model.CompletionComplete || op.Completion == nativeoperation_model.CompletionNeedsIntervention {
+		return s.releaseRecovered(ctx, a, reservation, nativeoperation_model.EffectCommitted)
+	}
+	if op.Completion != nativeoperation_model.CompletionPending && op.Completion != "" {
+		return fenced(a, ReasonRecoveryUncertainEffect, "human inline completion differs")
+	}
+	completion := nativeoperation_model.CompletionNeedsIntervention
+	if q.Draft {
+		completion = nativeoperation_model.CompletionComplete
+	}
+	if _, err := nativeoperation_model.SetCompletionAndRelease(ctx, op.InstallationID, op.OperationID, reservation.Owner, reservation.Generation, completion); err != nil {
+		return RecoveryAssessment{}, err
+	}
+	a.Verdict, a.Effect = RecoveryReleased, nativeoperation_model.EffectCommitted
+	a.Checks = append(a.Checks, "atomic inline/review/history and full original draft evidence match; uncertain final completion is not replayed")
+	s.retireStaleCapabilities()
+	return *a, nil
+}
diff --git a/services/nativeoperation/human_issue_create.go b/services/nativeoperation/human_issue_create.go
new file mode 100644
index 0000000000000000000000000000000000000000..5187ae66df4ee327380084873e1a09cc2ad5c36e
--- /dev/null
+++ b/services/nativeoperation/human_issue_create.go
@@ -0,0 +1,171 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package nativeoperation
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json" //nolint:depguard // Persisted native intent and receipt.
+	"errors"
+	"time"
+
+	sdk "forgejo.org/extension-sdk"
+	extensionauth_model "forgejo.org/models/extensionauth"
+	issues_model "forgejo.org/models/issues"
+	nativeoperation_model "forgejo.org/models/nativeoperation"
+	access_model "forgejo.org/models/perm/access"
+	repo_model "forgejo.org/models/repo"
+	"forgejo.org/models/unit"
+	user_model "forgejo.org/models/user"
+	execcontext "forgejo.org/modules/nativeoperation"
+	notify_service "forgejo.org/services/notify"
+
+	"github.com/google/uuid"
+)
+
+const CrashPointHumanIssueCreateBeforePrimary = "human-issue-create-before-primary"
+const CrashPointHumanIssueCreateAfterPrimary = "human-issue-create-after-primary"
+
+// HumanIssueCreateAdmission revalidates the current human/session, installation
+// and exact request lifetime before replay/claim and inside the SQL transaction.
+// Only trusted native request composition supplies it; preparation is not authority.
+type HumanIssueCreateAdmission func(context.Context) error
+
+func humanIssueCreateIntent(q sdk.HumanIssueCreateRequest) (*ValidIntent, error) {
+	if !sdk.ValidHumanIssueCreateRequest(q) {
+		return nil, ErrInvalidIntent
+	}
+	intent := &ValidIntent{OperationID: q.OperationID, ActorID: nativeCommentID(q.Expected.ActorID), RepositoryID: nativeCommentID(q.Expected.RepositoryID),
+		Kind: nativeoperation_model.KindHumanIssueCreate, AuthRevision: sdk.HumanIssueCreateAuthorizationRevision, ExpectedNativeRevision: q.Expected.NativeRevision, NotAfter: q.NotAfter}
+	var err error
+	intent.Canonical, intent.Digest, err = sdk.CanonicalHumanIssueCreateIntent(q)
+	return intent, err
+}
+
+// SubmitHumanIssueCreate creates an ordinary issue using the existing native
+// journal and conditional owner. It requires no background token/enrollment and
+// exposes no public route. Index allocation belongs to the primary transaction.
+func (s *Service) SubmitHumanIssueCreate(ctx context.Context, installation string, q sdk.HumanIssueCreateRequest, admit HumanIssueCreateAdmission) (sdk.OperationRecord, error) {
+	installationID, err := uuid.Parse(installation)
+	if err != nil || installationID.String() != installation || admit == nil {
+		return sdk.OperationRecord{}, ErrInvalidIntent
+	}
+	intent, err := humanIssueCreateIntent(q)
+	if err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	if ctx.Err() != nil {
+		return sdk.OperationRecord{}, ctx.Err()
+	}
+	if err := admit(ctx); err != nil {
+		return sdk.OperationRecord{}, ErrAuthorityLost
+	}
+	existing, err := nativeoperation_model.LookupOperation(ctx, installation, q.OperationID)
+	if err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	if existing != nil {
+		return s.reconcileExisting(existing, intent)
+	}
+	if q.NotAfter <= s.clock() || q.NotAfter > s.clock()+int64(MaxOperationLifetime/time.Second) {
+		return sdk.OperationRecord{}, ErrInvalidIntent
+	}
+	scope := Scope{Kind: nativeoperation_model.OwnerConditional, RepositoryID: intent.RepositoryID}
+	return s.claimConditionalSubmit(ctx, extensionauth_model.SubmissionDecision{ActorID: intent.ActorID}, installation, intent, scope,
+		func(ctx context.Context, op *nativeoperation_model.Operation, _ *ValidIntent, execution *execcontext.Execution) (sdk.OperationRecord, terminalResult, error) {
+			return s.executeHumanIssueCreate(ctx, op, q, admit, execution)
+		})
+}
+
+func humanIssueCreateTarget(ctx context.Context, q sdk.HumanIssueCreateRequest, admit HumanIssueCreateAdmission) (*repo_model.Repository, *user_model.User, error) {
+	if ctx.Err() != nil || admit(ctx) != nil {
+		return nil, nil, ErrAuthorityLost
+	}
+	actor, err := user_model.GetUserByID(ctx, nativeCommentID(q.Expected.ActorID))
+	if err != nil || !actor.IsAccessAllowed(ctx) {
+		return nil, nil, ErrAuthorityLost
+	}
+	repo, err := repo_model.GetRepositoryByID(ctx, nativeCommentID(q.Expected.RepositoryID))
+	if err != nil || repo.IsArchived || user_model.IsBlocked(ctx, repo.OwnerID, actor.ID) {
+		return nil, nil, ErrAuthorityLost
+	}
+	permission, err := access_model.GetUserRepoPermission(ctx, repo, actor)
+	if err != nil || unit.TypeIssues.UnitGlobalDisabled() || !repo.UnitEnabled(ctx, unit.TypeIssues) || !permission.CanRead(unit.TypeIssues) {
+		return nil, nil, ErrAuthorityLost
+	}
+	return repo, actor, nil
+}
+
+func (s *Service) executeHumanIssueCreate(ctx context.Context, op *nativeoperation_model.Operation, q sdk.HumanIssueCreateRequest, admit HumanIssueCreateAdmission, execution *execcontext.Execution) (sdk.OperationRecord, terminalResult, error) {
+	owned := execcontext.NewContext(ctx, execution)
+	release := context.WithoutCancel(ctx)
+	refuse := func(reason string) (sdk.OperationRecord, terminalResult, error) {
+		record, err := nativeoperation_model.SetTerminal(release, op.InstallationID, op.OperationID, nativeoperation_model.TerminalOutcome{
+			EffectState: nativeoperation_model.EffectNotCommitted, Reason: reason, Cancellation: nativeoperation_model.CancellationNone}, execution.Owner)
+		if err != nil {
+			return sdk.OperationRecord{}, terminalResult{}, err
+		}
+		return ToRecord(record), terminalResult{}, nil
+	}
+	if err := TestCrashBarrier(CrashPointHumanIssueCreateBeforePrimary); err != nil {
+		return sdk.OperationRecord{}, terminalResult{}, err
+	}
+	var issue *issues_model.Issue
+	var actor *user_model.User
+	committed, err := nativeoperation_model.CommitHumanIssueCreatePrimary(owned, op.InstallationID, op.OperationID, execution.Owner, s.clock(), func(tx context.Context) (string, error) {
+		repo, current, err := humanIssueCreateTarget(tx, q, admit)
+		if err != nil {
+			return "", err
+		}
+		if s.clock() >= op.NotAfter {
+			return "", nativeoperation_model.ErrOperationExpired
+		}
+		if tx.Err() != nil {
+			return "", ErrAuthorityLost
+		}
+		actor = current
+		issue = &issues_model.Issue{RepoID: repo.ID, Repo: repo, PosterID: actor.ID, Poster: actor, Title: q.Title, Content: q.Body}
+		if err := issues_model.NewIssue(tx, repo, issue, nil, nil); err != nil {
+			return "", err
+		}
+		sum := sha256.Sum256([]byte(issue.Content))
+		raw, err := json.Marshal(sdk.HumanIssueCreateReceipt{RepositoryID: repo.ID, ActorID: actor.ID, IssueID: issue.ID, Index: issue.Index,
+			Title: issue.Title, BodyDigest: hex.EncodeToString(sum[:]), ContentVersion: int64(issue.ContentVersion)})
+		return string(raw), err
+	})
+	if err != nil {
+		switch {
+		case errors.Is(err, ErrAuthorityLost):
+			return refuse(nativeoperation_model.ReasonAuthorityLost)
+		case errors.Is(err, nativeoperation_model.ErrOperationExpired):
+			return refuse(nativeoperation_model.ReasonExpiredBeforeAdmission)
+		case errors.Is(err, nativeoperation_model.ErrAdmissionLost):
+			current, readErr := nativeoperation_model.LookupOperation(release, op.InstallationID, op.OperationID)
+			if readErr != nil {
+				return sdk.OperationRecord{}, terminalResult{}, readErr
+			}
+			if current != nil && current.Revoked {
+				return refuse(nativeoperation_model.ReasonCancelledBeforeAdmission)
+			}
+		}
+		// An unknown SQL/commit result keeps the reservation for offline recovery.
+		return sdk.OperationRecord{}, terminalResult{}, err
+	}
+	if err := TestCrashBarrier(CrashPointHumanIssueCreateAfterPrimary); err != nil {
+		return sdk.OperationRecord{}, terminalResult{}, err
+	}
+	completion := nativeoperation_model.CompletionComplete
+	mentions, err := issues_model.FindAndUpdateIssueMentions(owned, issue, actor, issue.Content)
+	if err != nil {
+		completion = nativeoperation_model.CompletionNeedsIntervention
+	} else {
+		notify_service.NewIssue(owned, issue, mentions)
+	}
+	record, err := nativeoperation_model.SetCompletionAndRelease(release, committed.InstallationID, committed.OperationID, execution.Owner, execution.Generation, completion)
+	if err != nil {
+		return sdk.OperationRecord{}, terminalResult{}, err
+	}
+	return ToRecord(record), terminalResult{}, nil
+}
diff --git a/services/nativeoperation/human_issue_create_recovery.go b/services/nativeoperation/human_issue_create_recovery.go
