diff --git a/modules/repository/branch_sync.go b/modules/repository/branch_sync.go
new file mode 100644
index 0000000000000000000000000000000000000000..6fc73d1c0572fb374d54454cd8e338ca82a1adca
--- /dev/null
+++ b/modules/repository/branch_sync.go
@@ -0,0 +1,129 @@
+// Copyright 2020 The Gitea Authors. All rights reserved.
+// SPDX-License-Identifier: MIT
+
+package repository
+
+import (
+	"context"
+	"fmt"
+
+	"forgejo.org/models/db"
+	git_model "forgejo.org/models/git"
+	nativeoperation_model "forgejo.org/models/nativeoperation"
+	"forgejo.org/modules/cache"
+	"forgejo.org/modules/git"
+	execcontext "forgejo.org/modules/nativeoperation"
+	"forgejo.org/modules/optional"
+	"forgejo.org/modules/timeutil"
+)
+
+var syncBranchLock = cache.MutexMap{}
+
+// SyncBranchesToDB runs the existing native branch-catalog sync under held
+// ownership. A fresh catalog is bootstrapped with SyncRepoBranches. Callers own
+// authorization and the outer mutation reservation.
+func SyncBranchesToDB(ctx context.Context, repoID, pusherID int64, branchNames []string, getBranchCommit func(branchName string) (*git.Commit, error)) error {
+	held, err := nativeoperation_model.ReadReservation(ctx)
+	if err != nil {
+		return err
+	}
+	x := execcontext.FromContext(ctx)
+	if x == nil || held.Owner == "" || x.Owner != held.Owner || x.Generation != held.Generation {
+		return nativeoperation_model.ErrWrongOwner
+	}
+	// Implementation notes: hook post-receive will be executing this function in small batches (see `hookBatchSize`),
+	// not with all branches that are received at once. Also, concurrent execution will happen, even for the same
+	// branches, when pushes are executed quickly; the git repository is the source-of-truth for the current state as
+	// all in-memory data may be outdated by concurrent modifications.
+	return db.WithTx(ctx, func(ctx context.Context) error {
+		branches, err := git_model.GetBranches(ctx, repoID, branchNames, true)
+		if err != nil {
+			return fmt.Errorf("git_model.GetBranches: %v", err)
+		}
+
+		if len(branches) == 0 {
+			// if user haven't visit UI but directly push to a branch after upgrading from 1.20 -> 1.21,
+			// we cannot simply insert the branch but need to check we have branches or not
+			hasBranch, err := db.Exist[git_model.Branch](ctx, git_model.FindBranchOptions{
+				RepoID:          repoID,
+				IsDeletedBranch: optional.Some(false),
+			}.ToConds())
+			if err != nil {
+				return err
+			}
+			if !hasBranch {
+				if _, err = SyncRepoBranches(ctx, repoID, pusherID); err != nil {
+					return fmt.Errorf("repo_module.SyncRepoBranches %d failed: %v", repoID, err)
+				}
+				return nil
+			}
+		}
+
+		branchMap := make(map[string]*git_model.Branch, len(branches))
+		for _, branch := range branches {
+			branchMap[branch.Name] = branch
+		}
+
+		for _, branchName := range branchNames {
+			err := syncSingleBranch(ctx, repoID, pusherID, branchName, getBranchCommit, branchMap)
+			if err != nil {
+				return err
+			}
+		}
+
+		return nil
+	})
+}
+
+// Sync branchName's state from the git repo to the DB.
+func syncSingleBranch(
+	ctx context.Context,
+	repoID, pusherID int64,
+	branchName string,
+	getBranchCommit func(branchName string) (*git.Commit, error),
+	branchMap map[string]*git_model.Branch,
+) error {
+	// Multiple invocations to syncSingleBranch can occur concurrently for the same branch if pushes occur in close
+	// succession to each other; by locking here, and by reading the git repo's state of the branch (rather than being
+	// provided the state from the post-receive hook), we guarantee that the branch table will reach the current state
+	// even with concurrent requests (excluding error states).
+	defer syncBranchLock.Lock(fmt.Sprintf("%d/%s", repoID, branchName))()
+
+	commit, err := getBranchCommit(branchName)
+	if git.IsErrNotExist(err) {
+		// Branch has been removed from the repo since this SyncBranchesToDB was invoked; no update is required here
+		// because when the branch was deleted then post-receive-hook would have updated the record directly via
+		// git_model.AddDeletedBranch.
+		return nil
+	} else if err != nil {
+		return fmt.Errorf("get commit of %d:%s failed: %v", repoID, branchName, err)
+	}
+
+	branch, exist := branchMap[branchName]
+	if exist && branch.CommitID == commit.ID.String() && !branch.IsDeleted {
+		// Already up-to-date.
+		return nil
+	}
+
+	if exist {
+		if rowCount, err := git_model.UpdateBranch(ctx, repoID, pusherID, branchName, commit); err != nil {
+			return fmt.Errorf("git_model.UpdateBranch %d:%s failed: %v", repoID, branchName, err)
+		} else if rowCount != 1 {
+			return fmt.Errorf("git_model.UpdateBranch %d:%s failed: %d records updated", repoID, branchName, rowCount)
+		}
+		return nil
+	}
+
+	if err := db.Insert(ctx, &git_model.Branch{
+		RepoID:        repoID,
+		Name:          branchName,
+		CommitID:      commit.ID.String(),
+		CommitMessage: commit.Summary(),
+		PusherID:      pusherID,
+		CommitTime:    timeutil.TimeStamp(commit.Committer.When.Unix()),
+	}); err != nil {
+		return fmt.Errorf("inserting new branch %d:%s: %w", repoID, branchName, err)
+	}
+
+	return nil
+}
diff --git a/routers/web/extensions/callback_capabilities.go b/routers/web/extensions/callback_capabilities.go
new file mode 100644
index 0000000000000000000000000000000000000000..970a4260d4226d3eb73a6a568ef31c72548b679d
--- /dev/null
+++ b/routers/web/extensions/callback_capabilities.go
@@ -0,0 +1,138 @@
+package extensions
+
+import (
+	"context"
+	"net/http"
+	"strconv"
+
+	extension "forgejo.org/extension-sdk"
+	issues_model "forgejo.org/models/issues"
+	access_model "forgejo.org/models/perm/access"
+	repo_model "forgejo.org/models/repo"
+	"forgejo.org/models/unit"
+	"forgejo.org/modules/setting"
+)
+
+func capabilityFact(state, reason string) extension.RepositoryActionCapability {
+	return extension.RepositoryActionCapability{State: state, Reason: reason}
+}
+
+func readRepositoryCapabilities(ctx context.Context, admission *callbackAdmission, repository string, q extension.RepositoryCapabilitiesRequest) (*extension.RepositoryCapabilities, int) {
+	if _, status := resolveRepository(ctx, admission, repository); status != http.StatusOK {
+		return nil, status
+	}
+	user, status := resolveCurrentUser(ctx, admission)
+	if status != http.StatusOK {
+		return nil, status
+	}
+	repo, err := repo_model.GetRepositoryByID(ctx, mustParsePositiveID(repository))
+	if err != nil {
+		return nil, http.StatusServiceUnavailable
+	}
+	permission, err := access_model.GetUserRepoPermission(ctx, repo, user)
+	if err != nil {
+		return nil, http.StatusServiceUnavailable
+	}
+	unitRead := func(kind unit.Type) extension.RepositoryActionCapability {
+		if kind.UnitGlobalDisabled() || !repo.UnitEnabled(ctx, kind) {
+			return capabilityFact("unsupported", "unit_disabled")
+		}
+		if !permission.CanRead(kind) {
+			return capabilityFact("denied", "unit_read_denied")
+		}
+		return capabilityFact("allowed", "unit_read")
+	}
+	issues, pulls, jobs := unitRead(unit.TypeIssues), unitRead(unit.TypePullRequests), unitRead(unit.TypeActions)
+	if !setting.Actions.Enabled {
+		jobs = capabilityFact("unsupported", "actions_disabled")
+	}
+	if issues.State == "unsupported" && repo.UnitEnabled(ctx, unit.TypeExternalTracker) {
+		issues.Reason = "external_issues"
+	}
+	mutable := func(read extension.RepositoryActionCapability, need string) extension.RepositoryActionCapability {
+		if read.State != "allowed" {
+			return read
+		}
+		if repo.IsArchived {
+			return capabilityFact("denied", "repository_archived")
+		}
+		return capabilityFact("unknown", need)
+	}
+	create := mutable(issues, "issue_input_required")
+	if create.State == "unknown" {
+		create = capabilityFact("allowed", "issue_create")
+	}
+	createPull := mutable(pulls, "comparison_required")
+	if createPull.State == "unknown" && !repo.CanEnablePulls() {
+		createPull = capabilityFact("unsupported", "pull_creation_unavailable")
+	}
+	checks := pulls
+	if checks.State == "allowed" {
+		checks = capabilityFact("unknown", "pull_required")
+	}
+	if jobs.State == "allowed" {
+		jobs = checks
+	}
+	r := &extension.RepositoryCapabilities{RepositoryID: repository, ActorID: strconv.FormatInt(user.ID, 10), Subject: q.Subject, Index: q.Index, Actions: map[string]extension.RepositoryActionCapability{
+		"issues.read": issues, "issue.create": create, "issue.edit": mutable(issues, "issue_required"), "issue.comment": mutable(issues, "issue_required"),
+		"pulls.read": pulls, "pull.create": createPull, "pull.comment": mutable(pulls, "pull_required"), "pull.review": mutable(pulls, "pull_required"), "thread.resolve": mutable(pulls, "pull_required"), "pull.merge": mutable(pulls, "pull_required"), "checks.read": checks, "checks.jobs.read": jobs,
+	}}
+	for _, action := range []string{"pull.edit", "pull.review.comment", "pull.review.approve", "pull.review.request_changes"} {
+		r.Actions[action] = mutable(pulls, "pull_required")
+	}
+	if q.Subject == "issue" {
+		// Check the requested unit before resolving its resource. Code access
+		// alone does not permit disclosure of an internal issue identity.
+		if issues.State != "allowed" {
+			return nil, http.StatusNotFound
+		}
+		issue, err := issues_model.GetIssueByIndex(ctx, repo.ID, mustParsePositiveID(q.Index))
+		if issues_model.IsErrIssueNotExist(err) || err == nil && issue.IsPull {
+			return nil, http.StatusNotFound
+		}
+		if err != nil {
+			return nil, http.StatusServiceUnavailable
+		}
+		r.ResourceID = strconv.FormatInt(issue.ID, 10)
+		edit, comment := capabilityFact("denied", "issue_edit_denied"), capabilityFact("allowed", "issue_comment")
+		if issue.IsPoster(user.ID) || permission.CanWriteIssuesOrPulls(false) {
+			edit = capabilityFact("allowed", "issue_author_or_writer")
+		}
+		if issue.IsLocked && !permission.CanWriteIssuesOrPulls(false) && !user.IsAdmin {
+			comment = capabilityFact("denied", "issue_locked")
+		}
+		if repo.IsArchived {
+			edit, comment = capabilityFact("denied", "repository_archived"), capabilityFact("denied", "repository_archived")
+		}
+		r.Actions["issue.edit"], r.Actions["issue.comment"] = edit, comment
+		for _, action := range []string{"pull.edit", "pull.comment", "pull.review", "pull.review.comment", "pull.review.approve", "pull.review.request_changes", "thread.resolve", "pull.merge", "checks.read", "checks.jobs.read"} {
+			r.Actions[action] = capabilityFact("unsupported", "issue_scope")
+		}
+	}
+	if q.Subject == "pull" {
+		if pulls.State != "allowed" {
+			return nil, http.StatusNotFound
+		}
+		return readPullCapabilities(ctx, repo, user, permission, q, r)
+	}
+	return r, http.StatusOK
+}
+
+func resolveRepositoryCapabilities(ctx context.Context, admission *callbackAdmission, request extension.CallbackRequest) (*extension.RepositoryCapabilities, int) {
+	q := *request.Capabilities
+	before, status := readRepositoryCapabilities(ctx, admission, request.RepositoryID, q)
+	if status != http.StatusOK {
+		return nil, status
+	}
+	after, status := readRepositoryCapabilities(ctx, admission, request.RepositoryID, q)
+	if status == http.StatusNotFound {
+		return nil, http.StatusConflict
+	}
+	if status != http.StatusOK {
+		return nil, status
+	}
+	if checksFingerprint(before) != checksFingerprint(after) {
+		return nil, http.StatusConflict
+	}
+	return before, http.StatusOK
+}
diff --git a/routers/web/extensions/callback_catalog.go b/routers/web/extensions/callback_catalog.go
new file mode 100644
index 0000000000000000000000000000000000000000..5f0b4a87eb7f658c8422348624cc2e36c1c6c2fd
--- /dev/null
+++ b/routers/web/extensions/callback_catalog.go
@@ -0,0 +1,105 @@
+package extensions
+
+import (
+	"bytes"
+	"context"
+	"encoding/base64"
+	"encoding/json" //nolint:depguard // Private native cursor requires strict standard JSON decoding.
+	"io"
+	"net/http"
+	"strconv"
+	"strings"
+
+	extension "forgejo.org/extension-sdk"
+	"forgejo.org/models/db"
+	repo_model "forgejo.org/models/repo"
+	"forgejo.org/models/unit"
+	"xorm.io/builder"
+)
+
+type readableCatalogCursor struct {
+	Instance string `json:"instance"`
+	Actor    string `json:"actor"`
+	Query    string `json:"query"`
+	After    string `json:"after"`
+}
+
+func readableRepositoryCatalog(ctx context.Context, admission *callbackAdmission, q extension.RepositoryCatalogRequest) (*extension.RepositoryPage, int) {
+	user, status := resolveCurrentUser(ctx, admission)
+	if status != http.StatusOK {
+		return nil, status
+	}
+	after := int64(0)
+	if q.Cursor != "" {
+		data, err := base64.RawURLEncoding.DecodeString(q.Cursor)
+		if err != nil {
+			return nil, http.StatusBadRequest
+		}
+		var c readableCatalogCursor
+		d := json.NewDecoder(bytes.NewReader(data))
+		d.DisallowUnknownFields()
+		if d.Decode(&c) != nil || d.Decode(new(any)) != io.EOF || c.Instance != admission.instanceID || c.Actor != strconv.FormatInt(user.ID, 10) || c.Query != q.Query || mustParsePositiveID(c.After) == 0 {
+			return nil, http.StatusBadRequest
+		}
+		after = mustParsePositiveID(c.After)
+	}
+	// Native access predicates include owned, collaboration, organisation-team
+	// and public visibility. Administrators retain native all-repository access.
+	condition := builder.NewCond()
+	if !user.IsAdmin {
+		condition = repo_model.AccessibleRepositoryCondition(user, unit.TypeCode)
+	}
+	condition = condition.And(builder.Gt{"repository.id": after}).And(builder.In("repository.id", builder.Select("repo_id").From("repo_unit").Where(builder.Eq{"type": unit.TypeCode})))
+	if query := strings.ToLower(strings.TrimSpace(q.Query)); query != "" {
+		if owner, name, found := strings.Cut(query, "/"); found {
+			condition = condition.And(builder.Like{"repository.owner_name", owner}, builder.Like{"repository.lower_name", name})
+		} else {
+			condition = condition.And(builder.Like{"repository.lower_name", query})
+		}
+	}
+	var rows []*repo_model.Repository
+	if err := db.GetEngine(ctx).Where(condition).Cols("id").Asc("id").Limit(q.Limit + 1).Find(&rows); err != nil {
+		return nil, http.StatusServiceUnavailable
+	}
+	result := &extension.RepositoryPage{Items: []extension.Repository{}}
+	more := len(rows) > q.Limit
+	if more {
+		rows = rows[:q.Limit]
+	}
+	for _, row := range rows {
+		repository, status := resolveRepository(ctx, admission, strconv.FormatInt(row.ID, 10))
+		if status == http.StatusNotFound {
+			continue
+		}
+		if status != http.StatusOK {
+			return nil, status
+		}
+		result.Items = append(result.Items, *repository)
+	}
+	// Re-resolve selected resources after assembly: no cached unit/permission
+	// view may disclose a repository after its current access is withdrawn.
+	for _, item := range result.Items {
+		after, status := resolveRepository(ctx, admission, item.ID)
+		if status == http.StatusNotFound || status == http.StatusOK && *after != item {
+			return nil, http.StatusConflict
+		}
+		if status != http.StatusOK {
+			return nil, status
+		}
+	}
+	current, status := resolveCurrentUser(ctx, admission)
+	if status != http.StatusOK {
+		return nil, status
+	}
+	if current.IsAdmin != user.IsAdmin || current.IsRestricted != user.IsRestricted {
+		return nil, http.StatusConflict
+	}
+	if more {
+		data, err := json.Marshal(readableCatalogCursor{Instance: admission.instanceID, Actor: strconv.FormatInt(user.ID, 10), Query: q.Query, After: strconv.FormatInt(rows[len(rows)-1].ID, 10)})
+		if err != nil {
+			return nil, http.StatusServiceUnavailable
+		}
+		result.NextCursor = base64.RawURLEncoding.EncodeToString(data)
+	}
+	return result, http.StatusOK
+}
diff --git a/routers/web/extensions/callback_check_jobs.go b/routers/web/extensions/callback_check_jobs.go
new file mode 100644
index 0000000000000000000000000000000000000000..4b220921f15eeb5c361d16dee0ab518c331b7aa5
--- /dev/null
+++ b/routers/web/extensions/callback_check_jobs.go
@@ -0,0 +1,116 @@
+package extensions
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"strconv"
+	"strings"
+	"time"
+
+	extension "forgejo.org/extension-sdk"
+	actions_model "forgejo.org/models/actions"
+	"forgejo.org/models/db"
+	issues_model "forgejo.org/models/issues"
+	access_model "forgejo.org/models/perm/access"
+	repo_model "forgejo.org/models/repo"
+	"forgejo.org/models/unit"
+	"forgejo.org/modules/setting"
+	"forgejo.org/modules/timeutil"
+	"xorm.io/builder"
+)
+
+func readableCheckJobs(ctx context.Context, admission *callbackAdmission, repoID int64) int {
+	if !setting.Actions.Enabled || unit.TypeActions.UnitGlobalDisabled() {
+		return http.StatusNotFound
+	}
+	user, status := resolveCurrentUser(ctx, admission)
+	if status != http.StatusOK {
+		return status
+	}
+	repo, err := repo_model.GetRepositoryByID(ctx, repoID)
+	if err != nil {
+		return http.StatusServiceUnavailable
+	}
+	permission, err := access_model.GetUserRepoPermission(ctx, repo, user)
+	if err != nil {
+		return http.StatusServiceUnavailable
+	}
+	if !permission.CanRead(unit.TypeActions) {
+		return http.StatusNotFound
+	}
+	return http.StatusOK
+}
+
+func checkJobState(s actions_model.Status) string {
+	if value := s.String(); value != "" {
+		return value
+	}
+	return strconv.Itoa(int(s))
+}
+func checkJobTime(t timeutil.TimeStamp) *string {
+	if t <= 0 {
+		return nil
+	}
+	value := t.AsTime().UTC().Format(time.RFC3339)
+	return &value
+}
+
+func readCheckJobsSnapshot(ctx context.Context, pr *issues_model.PullRequest, head string) (*extension.RepositoryChecks, int) {
+	// Read commit-bound runs, keeping distinct reruns rather than conflating
+	// identically named jobs from different workflows/runs. PR-specific runs
+	// must belong to this PR; commit-wide runs can be relevant to any PR at it.
+	var runs []*actions_model.ActionRun
+	if err := db.GetEngine(ctx).Where(builder.Eq{"repo_id": pr.BaseRepoID, "commit_sha": head}).
+		And(builder.Or(builder.Eq{"pull_request_id": 0}, builder.Eq{"pull_request_id": pr.ID})).
+		Cols("id", "repo_id", "index", "workflow_id", "workflow_directory", "ref", "commit_sha", "workflow_source_commit", "event", "trigger_event", "status", "need_approval", "pull_request_id").Asc("id").Limit(1001).Find(&runs); err != nil {
+		return nil, http.StatusServiceUnavailable
+	}
+	if len(runs) > 1000 {
+		return nil, http.StatusRequestEntityTooLarge
+	}
+	r := &extension.RepositoryChecks{Kind: "job", RepositoryID: strconv.FormatInt(pr.BaseRepoID, 10), PullID: strconv.FormatInt(pr.ID, 10), Index: strconv.FormatInt(pr.Index, 10), Head: head, Items: []extension.RepositoryCommitCheck{}, MissingRequired: []string{}, InvalidRequired: []string{}, StatusGate: "unknown"}
+	runMap := map[int64]*actions_model.ActionRun{}
+	runIDs := []int64{}
+	for _, run := range runs {
+		if strings.HasPrefix(run.Ref, "refs/pull/") && run.Ref != pr.GetGitRefName() {
+			continue
+		}
+		runMap[run.ID] = run
+		runIDs = append(runIDs, run.ID)
+	}
+	if len(runIDs) > 0 {
+		// Include all jobs in admitted runs to retain the native job route index.
+		// Payloads/logs/tasks are not selected or exported.
+		var jobs []*actions_model.ActionRunJob
+		if err := db.GetEngine(ctx).In("run_id", runIDs).Cols("id", "run_id", "repo_id", "commit_sha", "name", "job_id", "attempt", "status", "started", "stopped").Asc("id").Limit(1001).Find(&jobs); err != nil {
+			return nil, http.StatusServiceUnavailable
+		}
+		if len(jobs) > 1000 {
+			return nil, http.StatusRequestEntityTooLarge
+		}
+		repo, err := repo_model.GetRepositoryByID(ctx, pr.BaseRepoID)
+		if err != nil {
+			return nil, http.StatusServiceUnavailable
+		}
+		indices := map[int64]int{}
+		for _, job := range jobs {
+			run := runMap[job.RunID]
+			index := indices[job.RunID]
+			indices[job.RunID]++
+			if run == nil || job.RepoID != pr.BaseRepoID || job.CommitSHA != head {
+				continue
+			}
+			run.Repo = repo
+			workflowCommit := head
+			if ok, source := run.WorkflowSourceCommit.Get(); ok {
+				workflowCommit = source
+			}
+			attempt := max(job.Attempt, 1)
+			detail := fmt.Sprintf("%s/jobs/%d/attempt/%d", run.Link(), index, attempt)
+			r.Items = append(r.Items, extension.RepositoryCommitCheck{ID: strconv.FormatInt(job.ID, 10), Name: job.Name, State: checkJobState(job.Status), DetailsURL: detail, Job: &extension.RepositoryCheckJob{RunID: strconv.FormatInt(run.ID, 10), RunNumber: strconv.FormatInt(run.Index, 10), Workflow: run.WorkflowPath(), Ref: run.Ref, Event: string(run.Event), TriggerEvent: run.TriggerEvent, RunState: checkJobState(run.Status), NeedApproval: run.NeedApproval, WorkflowCommit: workflowCommit, JobID: job.JobID, Attempt: strconv.FormatInt(job.Attempt, 10), StartedAt: checkJobTime(job.Started), StoppedAt: checkJobTime(job.Stopped)}})
+		}
+	}
+	r.Revision = checksFingerprint(r)
+	return r, http.StatusOK
+}
diff --git a/routers/web/extensions/callback_checks.go b/routers/web/extensions/callback_checks.go
new file mode 100644
index 0000000000000000000000000000000000000000..01c0a999e353489dc08359cbcfa904886f882959
--- /dev/null
+++ b/routers/web/extensions/callback_checks.go
@@ -0,0 +1,211 @@
+package extensions
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json" //nolint:depguard // Native protocol fingerprints require standard-library semantics.
+	"net/http"
+	"sort"
+	"strconv"
+	"strings"
+
+	extension "forgejo.org/extension-sdk"
+	"forgejo.org/models/db"
+	git_model "forgejo.org/models/git"
+	issues_model "forgejo.org/models/issues"
+	repo_model "forgejo.org/models/repo"
+	"forgejo.org/modules/git"
+	pull_service "forgejo.org/services/pull"
+	"github.com/gobwas/glob"
+)
+
+func protectionRead(ctx context.Context, pr *issues_model.PullRequest) (*extension.RepositoryProtection, int) {
+	if pr.BaseBranch == "" {
+		return nil, http.StatusOK
+	}
+	p, err := git_model.GetFirstMatchProtectedBranchRule(ctx, pr.BaseRepoID, pr.BaseBranch)
+	if err != nil {
+		return nil, http.StatusServiceUnavailable
+	}
+	r := &extension.RepositoryProtection{Branch: pr.BaseBranch, RequiredContexts: []string{}}
+	if p == nil {
+		return r, http.StatusOK
+	}
+	if p.RequiredApprovals < 0 || p.RequiredApprovals > 9007199254740991 {
+		return nil, http.StatusServiceUnavailable
+	}
+	r.Protected = true
+	r.StatusChecks = p.EnableStatusCheck
+	r.RequiredContexts = append(r.RequiredContexts, p.StatusCheckContexts...)
+	r.RequiredApprovals = p.RequiredApprovals
+	r.BlockRejected = p.BlockOnRejectedReviews
+	r.BlockReviewRequests = p.BlockOnOfficialReviewRequests
+	r.RequireUpToDate = p.BlockOnOutdatedBranch
+	r.RequireSigned = p.RequireSignedCommits
+	r.DismissStale = p.DismissStaleApprovals
+	r.IgnoreStale = p.IgnoreStaleApprovals
+	r.ApplyToAdmins = p.ApplyToAdmins
+	r.ProtectedFiles = p.ProtectedFilePatterns
+	r.UnprotectedFiles = p.UnprotectedFilePatterns
+	return r, http.StatusOK
+}
+func checksFingerprint(v any) string {
+	data, _ := json.Marshal(v)
+	sum := sha256.Sum256(data)
+	return hex.EncodeToString(sum[:])
+}
+func readChecksSnapshot(ctx context.Context, pr *issues_model.PullRequest, head, kind string) (*extension.RepositoryChecks, int) {
+	if kind == "job" {
+		return readCheckJobsSnapshot(ctx, pr, head)
+	}
+	protection, status := protectionRead(ctx, pr)
+	if status != http.StatusOK {
+		return nil, status
+	}
+	statuses, count, err := git_model.GetLatestCommitStatus(ctx, pr.BaseRepoID, head, db.ListOptions{Page: 1, PageSize: 1001})
+	if err != nil {
+		return nil, http.StatusServiceUnavailable
+	}
+	if count > 1000 || len(statuses) > 1000 {
+		return nil, http.StatusRequestEntityTooLarge
+	}
+	sort.Slice(statuses, func(i, j int) bool { return statuses[i].ID < statuses[j].ID })
+	r := &extension.RepositoryChecks{RepositoryID: strconv.FormatInt(pr.BaseRepoID, 10), PullID: strconv.FormatInt(pr.ID, 10), Index: strconv.FormatInt(pr.Index, 10), Head: head, Protection: protection, MissingRequired: []string{}, InvalidRequired: []string{}, StatusGate: "unknown", Items: []extension.RepositoryCommitCheck{}}
+	r.Kind = "status"
+	matchers := map[string]glob.Glob{}
+	if protection != nil {
+		r.StatusGate = "not_required"
+		if protection.StatusChecks {
+			for _, pattern := range protection.RequiredContexts {
+				g, err := glob.Compile(pattern)
+				if err != nil {
+					r.InvalidRequired = append(r.InvalidRequired, pattern)
+				} else {
+					matchers[pattern] = g
+				}
+				found := false
+				for _, s := range statuses {
+					if s.Context == pattern || g != nil && g.Match(s.Context) {
+						found = true
+						break
+					}
+				}
+				if !found {
+					r.MissingRequired = append(r.MissingRequired, pattern)
+				}
+			}
+			r.StatusGate = string(pull_service.MergeRequiredContextsCommitStatus(statuses, protection.RequiredContexts))
+			switch r.StatusGate {
+			case "pending", "success", "failure", "error", "warning":
+			default:
+				r.StatusGate = "unknown"
+			}
+		}
+	}
+	for _, s := range statuses {
+		if s.RepoID != pr.BaseRepoID || s.SHA != head {
+			return nil, http.StatusServiceUnavailable
+		}
+		var required *bool
+		if protection != nil {
+			value := false
+			if protection.StatusChecks {
+				for _, pattern := range protection.RequiredContexts {
+					if s.Context == pattern || matchers[pattern] != nil && matchers[pattern].Match(s.Context) {
+						value = true
+						break
+					}
+				}
+			}
+			required = &value
+		}
+		r.Items = append(r.Items, extension.RepositoryCommitCheck{ID: strconv.FormatInt(s.ID, 10), Name: s.Context, State: string(s.State), Description: s.Description, DetailsURL: s.TargetURL, Required: required})
+	}
+	r.Revision = checksFingerprint(r)
+	return r, http.StatusOK
+}
+func resolveRepositoryChecks(ctx context.Context, admission *callbackAdmission, request extension.CallbackRequest) (*extension.RepositoryChecks, int) {
+	q := *request.Checks
+	pr, status := pullFilesParent(ctx, admission, request.RepositoryID, q.Index)
+	if status != http.StatusOK {
+		return nil, status
+	}
+	if q.Kind == "job" {
+		if status := readableCheckJobs(ctx, admission, pr.BaseRepoID); status != http.StatusOK {
+			return nil, status
+		}
+	}
+	repo, err := repo_model.GetRepositoryByID(ctx, pr.BaseRepoID)
+	if err != nil {
+		return nil, http.StatusServiceUnavailable
+	}
+	native, err := git.OpenRepository(ctx, repo.RepoPath())
+	if err != nil {
+		return nil, http.StatusServiceUnavailable
+	}
+	defer native.Close()
+	head, err := native.GetRefCommitID(pr.GetGitRefName())
+	if err != nil || !extension.ValidPullDiffCommit(head) {
+		return nil, http.StatusServiceUnavailable
+	}
+	commit, err := native.GetCommit(head)
+	if err != nil || commit.ID.String() != head {
+		return nil, http.StatusServiceUnavailable
+	}
+	if q.Head != "" && q.Head != head {
+		return nil, http.StatusConflict
+	}
+	snapshot, status := readChecksSnapshot(ctx, pr, head, q.Kind)
+	if status != http.StatusOK {
+		return nil, status
+	}
+	offset := 0
+	if q.Cursor != "" {
+		parts := strings.Split(q.Cursor, ".")
+		if len(parts) != 5 {
+			return nil, http.StatusBadRequest
+		}
+		offset, err = strconv.Atoi(parts[4])
+		if err != nil || offset < 1 || strconv.Itoa(offset) != parts[4] || parts[0] != request.RepositoryID || parts[1] != snapshot.PullID {
+			return nil, http.StatusBadRequest
+		}
+		if parts[2] != head || parts[3] != snapshot.Revision {
+			return nil, http.StatusConflict
+		}
+		if offset >= len(snapshot.Items) {
+			return nil, http.StatusBadRequest
+		}
+	}
+	end := min(offset+q.Limit, len(snapshot.Items))
+	page := *snapshot
+	page.Items = snapshot.Items[offset:end]
+	if end < len(snapshot.Items) {
+		page.NextCursor = strings.Join([]string{request.RepositoryID, snapshot.PullID, head, snapshot.Revision, strconv.Itoa(end)}, ".")
+	}
+	// Re-read actual native scope, head and rule/status view after all I/O.
+	after, status := pullFilesParent(ctx, admission, request.RepositoryID, q.Index)
+	if status != http.StatusOK {
+		return nil, status
+	}
+	afterHead, err := native.GetRefCommitID(after.GetGitRefName())
+	if err != nil {
+		return nil, http.StatusServiceUnavailable
+	}
+	if after.ID != pr.ID || afterHead != head || after.BaseBranch != pr.BaseBranch {
+		return nil, http.StatusConflict
+	}
+	if q.Kind == "job" {
+		if status := readableCheckJobs(ctx, admission, after.BaseRepoID); status != http.StatusOK {
+			return nil, status
+		}
+	}
+	current, status := readChecksSnapshot(ctx, after, head, q.Kind)
+	if status != http.StatusOK {
+		return nil, status
+	}
+	if current.Revision != snapshot.Revision {
+		return nil, http.StatusConflict
+	}
+	return &page, http.StatusOK
+}
diff --git a/routers/web/extensions/callback_comment_snapshot.go b/routers/web/extensions/callback_comment_snapshot.go
new file mode 100644
index 0000000000000000000000000000000000000000..37511cca9d4bbb1bba00f964081a33e7117a97cb
--- /dev/null
+++ b/routers/web/extensions/callback_comment_snapshot.go
@@ -0,0 +1,77 @@
+package extensions
+
+import (
+	"context"
+	"net/http"
+	"strconv"
+
+	extension "forgejo.org/extension-sdk"
+	access_model "forgejo.org/models/perm/access"
+	repo_model "forgejo.org/models/repo"
+	"forgejo.org/models/unit"
+	nativeoperation_service "forgejo.org/services/nativeoperation"
+)
+
+// Bracket current human/parent facts with the native writer revision. An idle
+// revision is a future CAS precondition, never a durable permission grant.
+func resolveCommentSnapshot(ctx context.Context, admission *callbackAdmission, request extension.CallbackRequest) (*extension.RepositoryCommentSnapshot, int) {
+	before, err := nativeoperation_service.Default().ReadNativeRevision(ctx)
+	if err != nil || !before.Idle {
+		return nil, http.StatusServiceUnavailable
+	}
+	first, status := readCommentSnapshot(ctx, admission, request.RepositoryID, *request.CommentSnapshot)
+	if status != http.StatusOK {
+		return nil, status
+	}
+	second, status := readCommentSnapshot(ctx, admission, request.RepositoryID, *request.CommentSnapshot)
+	if status == http.StatusNotFound {
+		return nil, http.StatusConflict
+	}
+	if status != http.StatusOK {
+		return nil, status
+	}
+	after, err := nativeoperation_service.Default().ReadNativeRevision(ctx)
+	if err != nil {
+		return nil, http.StatusServiceUnavailable
+	}
+	if !after.Idle || after.Revision != before.Revision || *first != *second {
+		return nil, http.StatusConflict
+	}
+	first.NativeRevision = before.Revision
+	return first, http.StatusOK
+}
+
+func readCommentSnapshot(ctx context.Context, admission *callbackAdmission, repository string, q extension.RepositoryCommentSnapshotRequest) (*extension.RepositoryCommentSnapshot, int) {
+	issue, subjectID, status := discussionParent(ctx, admission, repository, extension.RepositoryCommentsRequest{Subject: q.Subject, Index: q.Index})
+	if status != http.StatusOK {
+		return nil, status
+	}
+	user, status := resolveCurrentUser(ctx, admission)
+	if status != http.StatusOK {
+		return nil, status
+	}
+	repo, err := repo_model.GetRepositoryByID(ctx, issue.RepoID)
+	if err != nil {
+		return nil, http.StatusServiceUnavailable
+	}
+	permission, err := access_model.GetUserRepoPermission(ctx, repo, user)
+	if err != nil {
+		return nil, http.StatusServiceUnavailable
+	}
+	kind := unit.TypeIssues
+	if issue.IsPull {
+		kind = unit.TypePullRequests
+	}
+	if kind.UnitGlobalDisabled() || !repo.UnitEnabled(ctx, kind) || !permission.CanRead(kind) {
+		return nil, http.StatusNotFound
+	}
+	action := capabilityFact("allowed", q.Subject+"_comment")
+	if issue.IsLocked && !permission.CanWriteIssuesOrPulls(issue.IsPull) && !user.IsAdmin {
+		action = capabilityFact("denied", q.Subject+"_locked")
+	}
+	if repo.IsArchived {
+		action = capabilityFact("denied", "repository_archived")
+	}
+	return &extension.RepositoryCommentSnapshot{RepositoryID: repository, ActorID: strconv.FormatInt(user.ID, 10),
+		Subject: q.Subject, SubjectID: subjectID, IssueID: strconv.FormatInt(issue.ID, 10), Index: q.Index, Action: action}, http.StatusOK
+}
diff --git a/routers/web/extensions/callback_comments.go b/routers/web/extensions/callback_comments.go
new file mode 100644
index 0000000000000000000000000000000000000000..5012b161f1204e4b4d0ef0a84c09b0c65816fb81
--- /dev/null
+++ b/routers/web/extensions/callback_comments.go
@@ -0,0 +1,118 @@
+package extensions
+
+import (
+	"context"
+	"net/http"
+	"strconv"
+	"time"
+
+	extension "forgejo.org/extension-sdk"
+	"forgejo.org/models/db"
+	issues_model "forgejo.org/models/issues"
+	access_model "forgejo.org/models/perm/access"
+	repo_model "forgejo.org/models/repo"
+	"forgejo.org/models/unit"
+	user_model "forgejo.org/models/user"
+	"xorm.io/builder"
+)
+
+// Load the current parent and its own unit permission for each bracket side.
+// PR discussion is not authorized merely by access to ordinary repository issues.
+func discussionParent(ctx context.Context, admission *callbackAdmission, repository string, q extension.RepositoryCommentsRequest) (*issues_model.Issue, string, int) {
+	if _, status := resolveRepository(ctx, admission, repository); status != http.StatusOK {
+		return nil, "", status
+	}
+	return issueOrPullParent(ctx, admission, repository, q)
+}
+
+// Metadata editing needs the subject's own issue/PR unit, independently of
+// source-code access. Code-dependent callers retain discussionParent's gate.
+func issueOrPullParent(ctx context.Context, admission *callbackAdmission, repository string, q extension.RepositoryCommentsRequest) (*issues_model.Issue, string, int) {
+	user, status := resolveCurrentUser(ctx, admission)
+	if status != http.StatusOK {
+		return nil, "", status
+	}
+	repo, err := repo_model.GetRepositoryByID(ctx, mustParsePositiveID(repository))
+	if repo_model.IsErrRepoNotExist(err) {
+		return nil, "", http.StatusNotFound
+	}
+	if err != nil {
+		return nil, "", http.StatusServiceUnavailable
+	}
+	issue, err := issues_model.GetIssueByIndex(ctx, repo.ID, mustParsePositiveID(q.Index))
+	if issues_model.IsErrIssueNotExist(err) || err == nil && issue.IsPull != (q.Subject == "pull") {
+		return nil, "", http.StatusNotFound
+	}
+	if err != nil {
+		return nil, "", http.StatusServiceUnavailable
+	}
+	permission, err := access_model.GetUserRepoPermission(ctx, repo, user)
+	if err != nil {
+		return nil, "", http.StatusServiceUnavailable
+	}
+	kind := unit.TypeIssues
+	if issue.IsPull {
+		kind = unit.TypePullRequests
+	}
+	if !permission.CanRead(kind) {
+		return nil, "", http.StatusNotFound
+	}
+	id := issue.ID
+	if issue.IsPull {
+		if err := issue.LoadPullRequest(ctx); err != nil || issue.PullRequest == nil {
+			return nil, "", http.StatusServiceUnavailable
+		}
+		id = issue.PullRequest.ID
+	}
+	if id < 1 {
+		return nil, "", http.StatusServiceUnavailable
+	}
+	return issue, strconv.FormatInt(id, 10), http.StatusOK
+}
+func resolveRepositoryComments(ctx context.Context, admission *callbackAdmission, request extension.CallbackRequest) (*extension.RepositoryCommentPage, int) {
+	q := *request.Comments
+	issue, id, status := discussionParent(ctx, admission, request.RepositoryID, q)
+	if status != http.StatusOK {
+		return nil, status
+	}
+	bound := int64(0)
+	if q.Cursor != "" {
+		bound = mustParsePositiveID(q.Cursor)
+	}
+	var comments []*issues_model.Comment
+	err := db.GetEngine(ctx).Where(builder.Eq{"issue_id": issue.ID, "type": issues_model.CommentTypeComment}).And(builder.Gt{"id": bound}).Asc("id").Limit(q.Limit + 1).Find(&comments)
+	if err != nil {
+		return nil, http.StatusServiceUnavailable
+	}
+	page := &extension.RepositoryCommentPage{RepositoryID: request.RepositoryID, Subject: q.Subject, SubjectID: id, Index: q.Index, Items: []extension.RepositoryDiscussionComment{}}
+	if len(comments) > q.Limit {
+		comments = comments[:q.Limit]
+		page.NextCursor = strconv.FormatInt(comments[len(comments)-1].ID, 10)
+	}
+	for _, comment := range comments {
+		if err := comment.LoadPoster(ctx); err != nil && !user_model.IsErrUserNotExist(err) {
+			return nil, http.StatusServiceUnavailable
+		}
+		item := extension.RepositoryDiscussionComment{ID: strconv.FormatInt(comment.ID, 10), Body: comment.Content}
+		if comment.Poster != nil && comment.Poster.ID > 0 {
+			item.Author = &extension.RepositoryIssueActor{ID: strconv.FormatInt(comment.Poster.ID, 10), Username: comment.Poster.Name}
+		}
+		if comment.CreatedUnix > 0 {
+			value := time.Unix(int64(comment.CreatedUnix), 0).UTC()
+			item.CreatedAt = &value
+		}
+		if comment.UpdatedUnix > 0 {
+			value := time.Unix(int64(comment.UpdatedUnix), 0).UTC()
+			item.UpdatedAt = &value
+		}
+		page.Items = append(page.Items, item)
+	}
+	_, after, status := discussionParent(ctx, admission, request.RepositoryID, q)
+	if status != http.StatusOK {
+		return nil, status
+	}
+	if after != id {
+		return nil, http.StatusServiceUnavailable
+	}
+	return page, http.StatusOK
+}
