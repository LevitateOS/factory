--- /dev/null
+++ b/services/nativeoperation/human_primary.go
@@ -0,0 +1,40 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package nativeoperation
+
+import (
+	"context"
+	"errors"
+
+	nativeoperation_model "forgejo.org/models/nativeoperation"
+	execcontext "forgejo.org/modules/nativeoperation"
+)
+
+func requireHumanPrimaryOwner(ctx context.Context, revision int64) error {
+	held, err := nativeoperation_model.ReadReservation(ctx)
+	if err != nil {
+		return err
+	}
+	execution := execcontext.FromContext(ctx)
+	if execution == nil || held.Owner == "" || execution.Owner != held.Owner || execution.Generation != held.Generation {
+		return nativeoperation_model.ErrBusy
+	}
+	if held.Revision < 1 || revision != held.Revision-1 {
+		return nativeoperation_model.ErrStaleRevision
+	}
+	return nil
+}
+
+func admitHumanPrimary(ctx context.Context, admit HumanReviewAdmission) error {
+	if ctx.Err() != nil {
+		return ErrAuthorityLost
+	}
+	if err := admit(ctx); err != nil {
+		if errors.Is(err, nativeoperation_model.ErrOperationExpired) {
+			return err
+		}
+		return ErrAuthorityLost
+	}
+	return nil
+}
diff --git a/services/nativeoperation/human_pull_create.go b/services/nativeoperation/human_pull_create.go
new file mode 100644
index 0000000000000000000000000000000000000000..3ab8e80869222eb80b1cafa01ba06f071ee2e095
--- /dev/null
+++ b/services/nativeoperation/human_pull_create.go
@@ -0,0 +1,371 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package nativeoperation
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"time"
+
+	sdk "forgejo.org/extension-sdk"
+	"forgejo.org/models/db"
+	extensionauth_model "forgejo.org/models/extensionauth"
+	issues_model "forgejo.org/models/issues"
+	nativeoperation_model "forgejo.org/models/nativeoperation"
+	access_model "forgejo.org/models/perm/access"
+	repo_model "forgejo.org/models/repo"
+	"forgejo.org/models/unit"
+	user_model "forgejo.org/models/user"
+	"forgejo.org/modules/git"
+	execcontext "forgejo.org/modules/nativeoperation"
+	pull_service "forgejo.org/services/pull"
+
+	"github.com/google/uuid"
+)
+
+var errHumanPullCreateChanged = errors.New("human pull creation preparation changed")
+var errHumanPullCreateComparison = errors.New("native human pull comparison refused")
+
+func humanPullCreateIntent(q sdk.HumanPullCreateRequest) (*ValidIntent, error) {
+	if !sdk.ValidHumanPullCreateRequest(q) {
+		return nil, ErrInvalidIntent
+	}
+	p := q.Expected
+	v := &ValidIntent{OperationID: q.OperationID, ActorID: nativeCommentID(p.ActorID), RepositoryID: nativeCommentID(p.RepositoryID), Kind: nativeoperation_model.KindHumanPullCreate, AuthRevision: sdk.HumanPullCreateAuthorizationRevision, ExpectedNativeRevision: p.NativeRevision, NotAfter: q.NotAfter}
+	var err error
+	v.Canonical, v.Digest, err = sdk.CanonicalHumanPullCreateIntent(q)
+	return v, err
+}
+
+func humanPullCreateScope(q sdk.HumanPullCreateRequest) Scope {
+	p := q.Expected
+	return Scope{Kind: nativeoperation_model.OwnerConditional, RepositoryID: nativeCommentID(p.RepositoryID), HeadRepositoryID: nativeCommentID(p.HeadRepositoryID), Ref: git.BranchPrefix + p.BaseBranch, OldOID: p.BaseOID, HeadRef: git.BranchPrefix + p.HeadBranch, HeadOID: p.HeadOID}
+}
+
+func humanPullCreateOperation(installation string, v *ValidIntent) *nativeoperation_model.Operation {
+	return &nativeoperation_model.Operation{InstallationID: installation, OperationID: v.OperationID, Kind: v.Kind, ActorID: v.ActorID, RepositoryID: v.RepositoryID, AuthRevision: v.AuthRevision, ExpectedNativeRevision: v.ExpectedNativeRevision, NotAfter: v.NotAfter, Intent: v.Canonical, IntentDigest: v.Digest}
+}
+
+// No Git runs here: these current policy reads also run inside primary SQL.
+// Explicit maintainer delegation follows native SetAllowEdits: the PR's author
+// must currently be able to write source Code before delegating that access.
+func humanPullCreateParticipants(ctx context.Context, q sdk.HumanPullCreateRequest, admit HumanReviewAdmission) (*repo_model.Repository, *repo_model.Repository, *user_model.User, error) {
+	if ctx.Err() != nil || admit(ctx) != nil {
+		return nil, nil, nil, ErrAuthorityLost
+	}
+	p := q.Expected
+	if err := requireHumanPrimaryOwner(ctx, p.NativeRevision); err != nil {
+		return nil, nil, nil, err
+	}
+	actor, err := user_model.GetUserByID(ctx, nativeCommentID(p.ActorID))
+	if err != nil || !actor.IsAccessAllowed(ctx) {
+		return nil, nil, nil, ErrAuthorityLost
+	}
+	base, err := repo_model.GetRepositoryByID(ctx, nativeCommentID(p.RepositoryID))
+	if err != nil || base.IsArchived || !base.AllowsPulls(ctx) || user_model.IsBlocked(ctx, base.OwnerID, actor.ID) {
+		return nil, nil, nil, ErrAuthorityLost
+	}
+	head, err := repo_model.GetRepositoryByID(ctx, nativeCommentID(p.HeadRepositoryID))
+	if err != nil {
+		return nil, nil, nil, ErrAuthorityLost
+	}
+	basePermission, err := access_model.GetUserRepoPermission(ctx, base, actor)
+	if err != nil {
+		return nil, nil, nil, err
+	}
+	for _, kind := range []unit.Type{unit.TypeCode, unit.TypePullRequests} {
+		if kind.UnitGlobalDisabled() || !base.UnitEnabled(ctx, kind) || !basePermission.CanRead(kind) {
+			return nil, nil, nil, ErrAuthorityLost
+		}
+	}
+	headPermission, err := access_model.GetUserRepoPermission(ctx, head, actor)
+	if err != nil {
+		return nil, nil, nil, err
+	}
+	if !head.UnitEnabled(ctx, unit.TypeCode) || !headPermission.CanRead(unit.TypeCode) || q.AllowMaintainerEdit && !headPermission.CanWrite(unit.TypeCode) {
+		return nil, nil, nil, ErrAuthorityLost
+	}
+	if base.ObjectFormatName != head.ObjectFormatName {
+		return nil, nil, nil, errHumanPullCreateChanged
+	}
+	return base, head, actor, nil
+}
+
+// Ref reads and native comparison belong outside primary SQL. The held native
+// owner fences participating ref writers through the transaction; this kind has
+// no Git write admission. The separate completion consumer will bind its own
+// derived ref to the committed receipt before any such write.
+func checkHumanPullCreateSource(ctx context.Context, q sdk.HumanPullCreateRequest, admit HumanReviewAdmission) (*repo_model.Repository, *repo_model.Repository, *user_model.User, error) {
+	if db.InTransaction(ctx) {
+		return nil, nil, nil, ErrInvalidIntent
+	}
+	base, head, actor, err := humanPullCreateParticipants(ctx, q, admit)
+	if err != nil {
+		return nil, nil, nil, err
+	}
+	for _, item := range []struct {
+		repo        *repo_model.Repository
+		branch, oid string
+	}{{base, q.Expected.BaseBranch, q.Expected.BaseOID}, {head, q.Expected.HeadBranch, q.Expected.HeadOID}} {
+		native, err := git.OpenRepository(ctx, item.repo.RepoPath())
+		if err != nil {
+			return nil, nil, nil, err
+		}
+		oid, err := native.GetRefCommitID(git.BranchPrefix + item.branch)
+		native.Close()
+		if err != nil || oid != item.oid {
+			return nil, nil, nil, errHumanPullCreateChanged
+		}
+	}
+	if err := humanPullCreateDuplicate(ctx, q); err != nil {
+		return nil, nil, nil, err
+	}
+	return base, head, actor, nil
+}
+
+func humanPullCreateDuplicate(ctx context.Context, q sdk.HumanPullCreateRequest) error {
+	p := q.Expected
+	_, err := issues_model.GetUnmergedPullRequest(ctx, nativeCommentID(p.HeadRepositoryID), nativeCommentID(p.RepositoryID), p.HeadBranch, p.BaseBranch, issues_model.PullRequestFlowGithub)
+	if err == nil {
+		return errPRCreateDuplicate
+	}
+	if !issues_model.IsErrPullRequestNotExist(err) {
+		return err
+	}
+	return nil
+}
+
+func (s *Service) checkHumanPullCreateCapture(ctx context.Context, installation string, v *ValidIntent, scope string) error {
+	if ctx.Err() != nil {
+		return ErrAuthorityLost
+	}
+	if s.clock() >= v.NotAfter {
+		return nativeoperation_model.ErrOperationExpired
+	}
+	op, err := nativeoperation_model.LookupOperation(ctx, installation, v.OperationID)
+	if err != nil {
+		return err
+	}
+	if !humanMergeCaptureMatches(op, v) || op.Admitted || op.EffectState != nativeoperation_model.EffectPending || op.Receipt != "" || op.Completion != "" || op.Revoked {
+		return nativeoperation_model.ErrAdmissionLost
+	}
+	held, err := nativeoperation_model.ReadReservation(ctx)
+	if err != nil {
+		return err
+	}
+	x := execcontext.FromContext(ctx)
+	if x == nil || held.Owner != conditionalOwner(installation, v.OperationID) || x.Owner != held.Owner || x.Generation != held.Generation || held.Scope != scope || held.OwnerKind != nativeoperation_model.OwnerConditional {
+		return nativeoperation_model.ErrWrongOwner
+	}
+	proof, err := execcontext.ReadCapabilityFile(x.CapabilityPath)
+	if err != nil || !execcontext.VerifyProof(held.Verifier, proof) {
+		return nativeoperation_model.ErrWrongOwner
+	}
+	return requireHumanPrimaryOwner(ctx, v.ExpectedNativeRevision)
+}
+
+// SubmitHumanPullCreatePrimary captures one human request and commits native
+// issue/index/PR plus receipt atomically. It leaves its exact owner held and
+// completion pending. It never establishes derived refs, notifies, or resumes
+// existing writing. Finishing/recovery and public transport are separate owners.
+func (s *Service) SubmitHumanPullCreatePrimary(ctx context.Context, installation string, q sdk.HumanPullCreateRequest, admit HumanReviewAdmission) (sdk.OperationRecord, error) {
+	return s.submitHumanPullCreate(ctx, installation, q, admit, false)
+}
+
+const (
+	CrashPointHumanPullCreateBeforePrimary = "human-pull-create-before-primary"
+	CrashPointHumanPullCreateInPrimary     = "human-pull-create-in-primary"
+	CrashPointHumanPullCreateAfterPrimary  = "human-pull-create-after-primary"
+	CrashPointHumanPullCreateAfterRef      = "human-pull-create-after-ref"
+	CrashPointHumanPullCreateAfterFinish   = "human-pull-create-after-finish"
+	CrashPointHumanPullCreateAfterRelease  = "human-pull-create-after-release"
+)
+
+// SubmitHumanPullCreate composes one captured human creation, exact derived ref,
+// one-shot native finishing and atomic release. Existing operations return saved
+// truth without resuming any writer. Post-commit completion survives request
+// loss; current human admission is still required to receive the result.
+func (s *Service) SubmitHumanPullCreate(ctx context.Context, installation string, q sdk.HumanPullCreateRequest, admit HumanReviewAdmission) (sdk.OperationRecord, error) {
+	return s.submitHumanPullCreate(ctx, installation, q, admit, true)
+}
+
+func (s *Service) submitHumanPullCreate(ctx context.Context, installation string, q sdk.HumanPullCreateRequest, admit HumanReviewAdmission, complete bool) (sdk.OperationRecord, error) {
+	id, err := uuid.Parse(installation)
+	if err != nil || id.String() != installation || admit == nil || db.InTransaction(ctx) {
+		return sdk.OperationRecord{}, ErrInvalidIntent
+	}
+	v, err := humanPullCreateIntent(q)
+	if err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	if ctx.Err() != nil {
+		return sdk.OperationRecord{}, ctx.Err()
+	}
+	if admit(ctx) != nil {
+		return sdk.OperationRecord{}, ErrAuthorityLost
+	}
+	finish := func(r sdk.OperationRecord, err error) (sdk.OperationRecord, error) {
+		if err == nil || errors.Is(err, ErrCancelledBeforeSubmit) {
+			if ctx.Err() != nil || admit(ctx) != nil {
+				return sdk.OperationRecord{}, ErrAuthorityLost
+			}
+		}
+		return r, err
+	}
+	existing, err := nativeoperation_model.LookupOperation(ctx, installation, q.OperationID)
+	if err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	if existing != nil {
+		r, e := s.reconcileExisting(existing, v)
+		return finish(r, e)
+	}
+	if q.NotAfter <= s.clock() || q.NotAfter > s.clock()+int64(MaxOperationLifetime/time.Second) {
+		return sdk.OperationRecord{}, ErrInvalidIntent
+	}
+	scope := humanPullCreateScope(q)
+	rawScope, err := encodeScope(scope)
+	if err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	r, err := s.claimConditionalSubmit(ctx, extensionauth_model.SubmissionDecision{ActorID: v.ActorID}, installation, v, scope, func(ctx context.Context, _ *nativeoperation_model.Operation, _ *ValidIntent, x *execcontext.Execution) (sdk.OperationRecord, terminalResult, error) {
+		owned, settle := execcontext.NewContext(ctx, x), context.WithoutCancel(ctx)
+		refuse := func(reason string) (sdk.OperationRecord, terminalResult, error) {
+			r, err := nativeoperation_model.RefuseHumanPullCreate(settle, humanPullCreateOperation(installation, v), x.Owner, x.Generation, rawScope, reason)
+			if err != nil {
+				return sdk.OperationRecord{}, terminalResult{}, err
+			}
+			return ToRecord(r), terminalResult{}, nil
+		}
+		perform := func() (*nativeoperation_model.Operation, error) {
+			if complete {
+				if err := TestCrashBarrier(CrashPointHumanPullCreateBeforePrimary); err != nil {
+					return nil, err
+				}
+			}
+			if err := s.checkHumanPullCreateCapture(owned, installation, v, rawScope); err != nil {
+				return nil, err
+			}
+			base, head, actor, err := checkHumanPullCreateSource(owned, q, admit)
+			if err != nil {
+				return nil, err
+			}
+			pull := &issues_model.PullRequest{HeadRepoID: head.ID, BaseRepoID: base.ID, HeadBranch: q.Expected.HeadBranch, BaseBranch: q.Expected.BaseBranch, HeadRepo: head, BaseRepo: base, Type: issues_model.PullRequestGitea, Flow: issues_model.PullRequestFlowGithub}
+			if err := pull_service.PreparePullRequestComparison(owned, pull); err != nil {
+				return nil, fmt.Errorf("%w: %v", errHumanPullCreateComparison, err)
+			}
+			if pull.HeadCommitID != q.Expected.HeadOID || !sdk.ValidPullDiffCommit(pull.MergeBase) {
+				return nil, errHumanPullCreateChanged
+			}
+			base, head, actor, err = checkHumanPullCreateSource(owned, q, admit)
+			if err != nil {
+				return nil, err
+			}
+			pull.BaseRepo, pull.HeadRepo = base, head
+			if err := s.checkHumanPullCreateCapture(owned, installation, v, rawScope); err != nil {
+				return nil, err
+			}
+			return nativeoperation_model.CommitHumanPullCreatePrimary(owned, humanPullCreateOperation(installation, v), x.Owner, x.Generation, rawScope, s.clock(), func(tx context.Context) (string, error) {
+				if err := s.checkHumanPullCreateCapture(tx, installation, v, rawScope); err != nil {
+					return "", err
+				}
+				base, _, current, err := humanPullCreateParticipants(tx, q, admit)
+				if err != nil {
+					return "", err
+				}
+				if err := humanPullCreateDuplicate(tx, q); err != nil {
+					return "", err
+				}
+				issue := &issues_model.Issue{RepoID: base.ID, Repo: base, PosterID: current.ID, Poster: current, IsPull: true, Title: q.Title, Content: q.Body}
+				if err := issues_model.NewPullRequest(tx, base, issue, nil, nil, pull); err != nil {
+					return "", err
+				}
+				pull.Issue, issue.PullRequest = issue, pull
+				if q.AllowMaintainerEdit {
+					if err := pull_service.SetAllowEdits(tx, current, pull, true); err != nil {
+						return "", err
+					}
+				}
+				if _, _, _, err := humanPullCreateParticipants(tx, q, admit); err != nil {
+					return "", err
+				}
+				if err := s.checkHumanPullCreateCapture(tx, installation, v, rawScope); err != nil {
+					return "", err
+				}
+				body := sha256.Sum256([]byte(issue.Content))
+				receipt := sdk.HumanPullCreateReceipt{RepositoryID: base.ID, HeadRepositoryID: head.ID, ActorID: actor.ID, PullID: pull.ID, IssueID: issue.ID, Index: pull.Index, BaseBranch: pull.BaseBranch, HeadBranch: pull.HeadBranch, BaseOID: q.Expected.BaseOID, HeadOID: pull.HeadCommitID, MergeBaseOID: pull.MergeBase, Title: issue.Title, BodyDigest: hex.EncodeToString(body[:]), ContentVersion: int64(issue.ContentVersion), AllowMaintainerEdit: pull.AllowMaintainerEdit, IntentDigest: v.Digest}
+				if !sdk.ValidHumanPullCreateReceipt(receipt, q) {
+					return "", errors.New("native human pull creation receipt differs")
+				}
+				raw, err := json.Marshal(receipt)
+				if err == nil && complete {
+					err = TestCrashBarrier(CrashPointHumanPullCreateInPrimary)
+				}
+				return string(raw), err
+			})
+		}
+		committed, err := perform()
+		if err != nil {
+			switch {
+			case errors.Is(err, ErrAuthorityLost), errors.Is(err, pull_service.ErrUserHasNoPermissionForAction):
+				return refuse(nativeoperation_model.ReasonAuthorityLost)
+			case errors.Is(err, errHumanPullCreateChanged):
+				return refuse(nativeoperation_model.ReasonStaleBaseOrResult)
+			case errors.Is(err, errPRCreateDuplicate):
+				return refuse(nativeoperation_model.ReasonDuplicatePullRequest)
+			case errors.Is(err, errHumanPullCreateComparison):
+				return refuse(nativeoperation_model.ReasonNativeRefused)
+			case errors.Is(err, nativeoperation_model.ErrOperationExpired):
+				return refuse(nativeoperation_model.ReasonExpiredBeforeAdmission)
+			case errors.Is(err, nativeoperation_model.ErrAdmissionLost):
+				op, readErr := nativeoperation_model.LookupOperation(settle, installation, q.OperationID)
+				if readErr != nil {
+					return sdk.OperationRecord{}, terminalResult{}, readErr
+				}
+				if op != nil && op.Revoked {
+					return refuse(nativeoperation_model.ReasonCancelledBeforeAdmission)
+				}
+			}
+			return sdk.OperationRecord{}, terminalResult{}, err
+		}
+		if !complete {
+			return ToRecord(committed), terminalResult{retain: true}, nil
+		}
+		if err := TestCrashBarrier(CrashPointHumanPullCreateAfterPrimary); err != nil {
+			return sdk.OperationRecord{}, terminalResult{}, err
+		}
+		// Only the committed capture grants this bounded completion. A lost
+		// request cannot erase it or authorize another primary/notification run.
+		completionCtx := context.WithoutCancel(owned)
+		if _, err := s.CompleteHumanPullCreateRef(completionCtx, installation, q); err != nil {
+			return sdk.OperationRecord{}, terminalResult{}, err
+		}
+		if err := TestCrashBarrier(CrashPointHumanPullCreateAfterRef); err != nil {
+			return sdk.OperationRecord{}, terminalResult{}, err
+		}
+		record, err := s.FinishHumanPullCreate(completionCtx, installation, q)
+		if record.CompletionState == nativeoperation_model.CompletionNeedsIntervention {
+			return record, terminalResult{retain: true}, nil
+		}
+		if err != nil {
+			return sdk.OperationRecord{}, terminalResult{}, err
+		}
+		if err := TestCrashBarrier(CrashPointHumanPullCreateAfterFinish); err != nil {
+			return sdk.OperationRecord{}, terminalResult{}, err
+		}
+		record, err = s.CompleteHumanPullCreate(completionCtx, installation, q)
+		if err != nil {
+			return sdk.OperationRecord{}, terminalResult{}, err
+		}
+		if err := TestCrashBarrier(CrashPointHumanPullCreateAfterRelease); err != nil {
+			return sdk.OperationRecord{}, terminalResult{}, err
+		}
+		return record, terminalResult{}, nil
+	})
+	return finish(r, err)
+}
diff --git a/services/nativeoperation/human_pull_create_complete.go b/services/nativeoperation/human_pull_create_complete.go
new file mode 100644
index 0000000000000000000000000000000000000000..ce211e5fc18fc07bdbaccff9fe49c9ab42b9e591
--- /dev/null
+++ b/services/nativeoperation/human_pull_create_complete.go
@@ -0,0 +1,157 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package nativeoperation
+
+import (
+	"context"
+	"errors"
+	"os"
+
+	sdk "forgejo.org/extension-sdk"
+	"forgejo.org/models/db"
+	issues_model "forgejo.org/models/issues"
+	nativeoperation_model "forgejo.org/models/nativeoperation"
+	execcontext "forgejo.org/modules/nativeoperation"
+	issue_service "forgejo.org/services/issue"
+	notify_service "forgejo.org/services/notify"
+	pull_service "forgejo.org/services/pull"
+)
+
+const HumanPullCreateFinishStarted = "human-pull-create-finish-started"
+const HumanPullCreateFinishDone = "human-pull-create-finish-done"
+
+var ErrHumanPullCreateFinishClaimed = errors.New("native human pull creation finishing was already claimed")
+var ErrHumanPullCreateCompletionNotReady = errors.New("native human pull creation completion is not ready")
+
+func (s *Service) checkHumanPullCreateRefEvidence(ctx context.Context, q sdk.HumanPullCreateRequest, pr *issues_model.PullRequest) error {
+	if err := checkHumanPullCreateTips(ctx, q, pr); err != nil {
+		return err
+	}
+	tip, absent, known := s.prCreateRefTip(ctx, pr.BaseRepo.RepoPath(), pr.GetGitRefName())
+	if !known || absent || tip != q.Expected.HeadOID {
+		return ErrHumanPullCreateEvidence
+	}
+	return nil
+}
+
+// FinishHumanPullCreate durably claims ordinary native creation finishing once.
+// It consumes committed SQL/ref truth, not renewed human creation authority.
+// Git reads and native notification dispatch run outside the claim transaction;
+// an interrupted or failed dispatch remains fenced and is never repeated here.
+func (s *Service) FinishHumanPullCreate(ctx context.Context, installation string, q sdk.HumanPullCreateRequest) (sdk.OperationRecord, error) {
+	if db.InTransaction(ctx) {
+		return sdk.OperationRecord{}, ErrInvalidIntent
+	}
+	v, held, scope, pr, op, err := readHumanPullCreateHeld(ctx, installation, q)
+	if err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	if scope.CompletionPhase == HumanPullCreateFinishStarted || scope.CompletionPhase == HumanPullCreateFinishDone {
+		return sdk.OperationRecord{}, ErrHumanPullCreateFinishClaimed
+	}
+	if scope.CompletionPhase != HumanPullCreateRefDone {
+		return sdk.OperationRecord{}, ErrHumanPullCreateCompletionNotReady
+	}
+	if err := s.checkHumanPullCreateRefEvidence(ctx, q, pr); err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	started, done := scope, scope
+	started.CompletionPhase, done.CompletionPhase = HumanPullCreateFinishStarted, HumanPullCreateFinishDone
+	startedJSON, err := encodeScope(started)
+	if err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	doneJSON, err := encodeScope(done)
+	if err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	want := humanPullCreateOperation(installation, v)
+	err = nativeoperation_model.WithHumanPullCreateReceipt(ctx, want, held.Owner, held.Generation, held.Scope, op.Receipt, func(tx context.Context, current *nativeoperation_model.Operation) error {
+		var err error
+		pr, err = readHumanPullCreateReceipt(tx, q, current.Receipt)
+		if err != nil {
+			return err
+		}
+		if err := pr.Issue.LoadPoster(tx); err != nil {
+			return err
+		}
+		_, err = nativeoperation_model.ChangeHumanPullCreatePhase(tx, want, held.Owner, held.Generation, held.Scope, startedJSON, current.Receipt)
+		return err
+	})
+	if err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	finishErr := func() error {
+		if err := s.checkHumanPullCreateRefEvidence(ctx, q, pr); err != nil {
+			return err
+		}
+		notifiers, err := pull_service.FinishPullRequestCreation(ctx, pr.BaseRepo, pr)
+		if err != nil {
+			return err
+		}
+		issue_service.ReviewRequestNotify(ctx, pr.Issue, pr.Issue.Poster, notifiers)
+		mentions, err := issues_model.FindAndUpdateIssueMentions(ctx, pr.Issue, pr.Issue.Poster, pr.Issue.Content)
+		if err != nil {
+			return err
+		}
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		notify_service.NewPullRequest(ctx, pr, mentions)
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		return s.checkHumanPullCreateRefEvidence(ctx, q, pr)
+	}()
+	var recorded *nativeoperation_model.Operation
+	err = nativeoperation_model.WithHumanPullCreateReceipt(context.WithoutCancel(ctx), want, held.Owner, held.Generation, startedJSON, op.Receipt, func(tx context.Context, current *nativeoperation_model.Operation) error {
+		if _, err := readHumanPullCreateReceipt(tx, q, current.Receipt); err != nil {
+			return err
+		}
+		var err error
+		recorded, err = nativeoperation_model.RecordHumanPullCreateFinish(tx, want, held.Owner, held.Generation, startedJSON, doneJSON, current.Receipt, finishErr == nil)
+		return err
+	})
+	if err != nil {
+		return sdk.OperationRecord{}, errors.Join(err, finishErr)
+	}
+	return ToRecord(recorded), finishErr
+}
+
+// CompleteHumanPullCreate releases only exact successfully finished creation.
+// The SQL completion/release revokes proof before its private file is retired.
+// Stopped-writer recovery is separate; retained lookup resolves lost replies.
+func (s *Service) CompleteHumanPullCreate(ctx context.Context, installation string, q sdk.HumanPullCreateRequest) (sdk.OperationRecord, error) {
+	if db.InTransaction(ctx) {
+		return sdk.OperationRecord{}, ErrInvalidIntent
+	}
+	v, held, scope, pr, op, err := readHumanPullCreateHeld(ctx, installation, q)
+	if err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	if scope.CompletionPhase != HumanPullCreateFinishDone {
+		return sdk.OperationRecord{}, ErrHumanPullCreateCompletionNotReady
+	}
+	if err := s.checkHumanPullCreateRefEvidence(ctx, q, pr); err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	var recorded *nativeoperation_model.Operation
+	want := humanPullCreateOperation(installation, v)
+	err = nativeoperation_model.WithHumanPullCreateReceipt(ctx, want, held.Owner, held.Generation, held.Scope, op.Receipt, func(tx context.Context, current *nativeoperation_model.Operation) error {
+		if _, err := readHumanPullCreateReceipt(tx, q, current.Receipt); err != nil {
+			return err
+		}
+		var err error
+		recorded, err = nativeoperation_model.CompleteHumanPullCreate(tx, want, held.Owner, held.Generation, held.Scope, current.Receipt)
+		return err
+	})
+	if err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	record := ToRecord(recorded)
+	if err := os.Remove(execcontext.FromContext(ctx).CapabilityPath); err != nil && !os.IsNotExist(err) {
+		return record, err
+	}
+	return record, nil
+}
diff --git a/services/nativeoperation/human_pull_create_recovery.go b/services/nativeoperation/human_pull_create_recovery.go
new file mode 100644
index 0000000000000000000000000000000000000000..3f22eb6aef22bdc6742a69269a6724f5c4bcf584
--- /dev/null
+++ b/services/nativeoperation/human_pull_create_recovery.go
@@ -0,0 +1,159 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package nativeoperation
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+
+	sdk "forgejo.org/extension-sdk"
+	"forgejo.org/models/db"
+	issues_model "forgejo.org/models/issues"
+	nativeoperation_model "forgejo.org/models/nativeoperation"
+	repo_model "forgejo.org/models/repo"
+	user_model "forgejo.org/models/user"
+	"forgejo.org/modules/git"
+
+	"github.com/google/uuid"
+)
+
+// Recover invokes this only for a stopped/inhibited mutation domain. SQL primary
+// and receipt are atomic; a similar PR never supplies a missing receipt. Git is
+// inspected before the atomic SQL outcome/release, with no transaction across it.
+func (s *Service) recoverHumanPullCreate(ctx context.Context, a *RecoveryAssessment, held *nativeoperation_model.Reservation, scope Scope, op *nativeoperation_model.Operation) (RecoveryAssessment, error) {
+	if db.InTransaction(ctx) {
+		return RecoveryAssessment{}, ErrInvalidIntent
+	}
+	var saved struct {
+		Payload sdk.HumanPullCreateRequest `json:"payload"`
+	}
+	if json.Unmarshal([]byte(op.Intent), &saved) != nil {
+		return fenced(a, ReasonRecoveryMissingEvidence, "human PR creation intent is missing")
+	}
+	q := saved.Payload
+	v, err := humanPullCreateIntent(q)
+	installation, parseErr := uuid.Parse(op.InstallationID)
+	if err != nil || parseErr != nil || installation.String() != op.InstallationID || !humanMergeCaptureMatches(op, v) || held.OwnerKind != nativeoperation_model.OwnerConditional || held.Generation < 1 || held.Revision != op.ExpectedNativeRevision+1 {
+		return fenced(a, ReasonRecoveryUncertainEffect, "human PR creation capture and held generation differ")
+	}
+	base, err := repo_model.GetRepositoryByID(ctx, v.RepositoryID)
+	if err != nil {
+		return fenced(a, ReasonRecoveryMissingEvidence, "human PR creation target is missing")
+	}
+	head, err := repo_model.GetRepositoryByID(ctx, nativeCommentID(q.Expected.HeadRepositoryID))
+	if err != nil {
+		return fenced(a, ReasonRecoveryMissingEvidence, "human PR creation source is missing")
+	}
+	if _, err := user_model.GetUserByID(ctx, v.ActorID); err != nil {
+		return fenced(a, ReasonRecoveryMissingEvidence, "human PR creation original actor is missing")
+	}
+	pending := !op.Admitted && (op.EffectState == nativeoperation_model.EffectPending || op.EffectState == nativeoperation_model.EffectNotCommitted) && op.Receipt == "" && op.Completion == "" && scope.CompletionPhase == ""
+	var pr *issues_model.PullRequest
+	if pending {
+		pr = &issues_model.PullRequest{BaseRepo: base, HeadRepo: head}
+	} else {
+		if !op.Admitted || op.EffectState != nativeoperation_model.EffectCommitted {
+			return fenced(a, ReasonRecoveryUncertainEffect, "human PR creation has no atomic committed receipt")
+		}
+		pr, err = readHumanPullCreateReceipt(ctx, q, op.Receipt)
+		if err != nil {
+			return fenced(a, ReasonRecoveryMissingEvidence, "human PR creation receipt or native primary differs; preserved")
+		}
+	}
+	if checkHumanPullCreateScope(q, scope, held.Scope, pr) != nil {
+		return fenced(a, ReasonRecoveryUncertainEffect, "human PR creation scope differs from its immutable capture")
+	}
+	if err := checkHumanPullCreateTips(ctx, q, pr); err != nil {
+		return fenced(a, ReasonRecoveryUncertainEffect, "human PR creation source or target Git evidence differs")
+	}
+	// No scope is permitted to invent a derived ref before the primary. A
+	// prepared writer may have stopped before or after its one exact CAS.
+	if !pending {
+		tip, absent, known := s.prCreateRefTip(ctx, base.RepoPath(), pr.GetGitRefName())
+		if !known || !absent && tip != q.Expected.HeadOID || scope.CompletionPhase == "" && !absent || scope.CompletionPhase != "" && scope.CompletionPhase != HumanPullCreateRefPrepared && absent {
+			return fenced(a, ReasonRecoveryUncertainEffect, "human PR creation derived ref contradicts the recorded phase")
+		}
+	}
+	// Successful native finishing necessarily wrote this exact initial push
+	// history (unless the comparison is empty). Read Git now; validate SQL in
+	// the release transaction. This neither recomputes nor dispatches reviews.
+	var history string
+	if scope.CompletionPhase == HumanPullCreateFinishDone {
+		history, err = humanPullCreateRecoveryHistory(ctx, pr)
+		if err != nil {
+			return fenced(a, ReasonRecoveryMissingEvidence, "human PR creation finished comparison cannot be read")
+		}
+	}
+	recorded, err := nativeoperation_model.RecoverHumanPullCreate(ctx, humanPullCreateOperation(op.InstallationID, v), held.Owner, held.Generation, held.Scope, func(tx context.Context, current *nativeoperation_model.Operation) (string, error) {
+		if current.Admitted != op.Admitted || current.EffectState != op.EffectState || current.Completion != op.Completion || current.Receipt != op.Receipt {
+			return "", ErrHumanPullCreateEvidence
+		}
+		if pending {
+			if err := humanPullCreateDuplicate(tx, q); err != nil {
+				return "", ErrHumanPullCreateEvidence
+			}
+			return "", nil
+		}
+		if _, err := readHumanPullCreateReceipt(tx, q, current.Receipt); err != nil {
+			return "", err
+		}
+		if scope.CompletionPhase == HumanPullCreateFinishDone {
+			var comments []*issues_model.Comment
+			if err := db.GetEngine(tx).Where("issue_id=? AND type=?", pr.IssueID, issues_model.CommentTypePullRequestPush).Find(&comments); err != nil {
+				return "", err
+			}
+			if history == "" && len(comments) != 0 || history != "" && (len(comments) != 1 || comments[0].PosterID != v.ActorID || comments[0].Content != history) {
+				return "", ErrHumanPullCreateEvidence
+			}
+		}
+		switch current.Completion {
+		case nativeoperation_model.CompletionPending:
+			if scope.CompletionPhase == HumanPullCreateFinishDone {
+				return nativeoperation_model.CompletionComplete, nil
+			}
+			return nativeoperation_model.CompletionNeedsIntervention, nil
+		case nativeoperation_model.CompletionComplete:
+			if scope.CompletionPhase != HumanPullCreateFinishDone {
+				return "", ErrHumanPullCreateEvidence
+			}
+			return current.Completion, nil
+		case nativeoperation_model.CompletionNeedsIntervention:
+			if scope.CompletionPhase == HumanPullCreateFinishDone {
+				return "", ErrHumanPullCreateEvidence
+			}
+			return current.Completion, nil
+		default:
+			return "", ErrHumanPullCreateEvidence
+		}
+	})
+	if err != nil {
+		if errors.Is(err, ErrHumanPullCreateEvidence) || errors.Is(err, nativeoperation_model.ErrAdmissionLost) || errors.Is(err, nativeoperation_model.ErrWrongOwner) || issues_model.IsErrPullRequestNotExist(err) || issues_model.IsErrIssueNotExist(err) {
+			return fenced(a, ReasonRecoveryUncertainEffect, "human PR creation native evidence or atomic outcome differs; preserved")
+		}
+		return RecoveryAssessment{}, err
+	}
+	a.Verdict, a.Effect = RecoveryReleased, recorded.EffectState
+	a.Checks = append(a.Checks, "exact human PR capture and native SQL/Git evidence reconciled; no primary, ref or notification replay")
+	s.retireStaleCapabilities()
+	return *a, nil
+}
+
+func humanPullCreateRecoveryHistory(ctx context.Context, pr *issues_model.PullRequest) (string, error) {
+	native, err := git.OpenRepository(ctx, pr.BaseRepo.RepoPath())
+	if err != nil {
+		return "", err
+	}
+	defer native.Close()
+	comparison, err := native.GetCompareInfo(pr.BaseRepo.RepoPath(), git.BranchPrefix+pr.BaseBranch, pr.GetGitRefName(), false, false)
+	if err != nil || len(comparison.Commits) == 0 {
+		return "", err
+	}
+	data := issues_model.PushActionContent{IsForcePush: false, CommitIDs: make([]string, 0, len(comparison.Commits))}
+	for i := len(comparison.Commits) - 1; i >= 0; i-- {
+		data.CommitIDs = append(data.CommitIDs, comparison.Commits[i].ID.String())
+	}
+	raw, err := json.Marshal(data)
+	return string(raw), err
+}
diff --git a/services/nativeoperation/human_pull_create_ref.go b/services/nativeoperation/human_pull_create_ref.go
new file mode 100644
index 0000000000000000000000000000000000000000..bbabb524d938755fbdf17eefef67d9e4ff18e278
--- /dev/null
+++ b/services/nativeoperation/human_pull_create_ref.go
@@ -0,0 +1,260 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package nativeoperation
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"strings"
+
+	sdk "forgejo.org/extension-sdk"
+	"forgejo.org/models/db"
+	issues_model "forgejo.org/models/issues"
+	nativeoperation_model "forgejo.org/models/nativeoperation"
+	"forgejo.org/modules/git"
+	execcontext "forgejo.org/modules/nativeoperation"
+	repo_module "forgejo.org/modules/repository"
+
+	"github.com/google/uuid"
+)
+
+const HumanPullCreateRefPrepared = "human-pull-create-ref-prepared"
+const HumanPullCreateRefDone = "human-pull-create-ref-done"
+
+var ErrHumanPullCreateEvidence = errors.New("native human pull creation evidence differs")
+var ErrHumanPullCreateRefClaimed = errors.New("native human pull creation ref was already claimed")
+
+// SQL-only evidence, shared by the phase transaction and native Git admission.
+// This consumes committed truth rather than reauthorizing creation as its author.
+func readHumanPullCreateReceipt(ctx context.Context, q sdk.HumanPullCreateRequest, raw string) (*issues_model.PullRequest, error) {
+	var r sdk.HumanPullCreateReceipt
+	if json.Unmarshal([]byte(raw), &r) != nil || !sdk.ValidHumanPullCreateReceipt(r, q) {
+		return nil, ErrHumanPullCreateEvidence
+	}
+	encoded, err := json.Marshal(r)
+	if err != nil || string(encoded) != raw {
+		return nil, ErrHumanPullCreateEvidence
+	}
+	pr, err := issues_model.GetPullRequestByID(ctx, r.PullID)
+	if err != nil {
+		return nil, err
+	}
+	if err := pr.LoadIssue(ctx); err != nil {
+		return nil, err
+	}
+	issue := pr.Issue
+	body := sha256.Sum256([]byte(issue.Content))
+	if pr.BaseRepoID != r.RepositoryID || pr.HeadRepoID != r.HeadRepositoryID || pr.IssueID != r.IssueID || pr.Index != r.Index || pr.BaseBranch != r.BaseBranch || pr.HeadBranch != r.HeadBranch || pr.MergeBase != r.MergeBaseOID || pr.AllowMaintainerEdit != r.AllowMaintainerEdit || pr.Type != issues_model.PullRequestGitea || pr.Flow != issues_model.PullRequestFlowGithub || pr.HasMerged ||
+		!issue.IsPull || issue.IsClosed || issue.RepoID != r.RepositoryID || issue.ID != r.IssueID || issue.Index != r.Index || issue.PosterID != r.ActorID || issue.Title != r.Title || int64(issue.ContentVersion) != r.ContentVersion || hex.EncodeToString(body[:]) != r.BodyDigest {
+		return nil, ErrHumanPullCreateEvidence
+	}
+	if err := pr.LoadBaseRepo(ctx); err != nil {
+		return nil, err
+	}
+	if err := pr.LoadHeadRepo(ctx); err != nil {
+		return nil, err
+	}
+	pr.HeadCommitID = r.HeadOID // Native field is computed, not a SQL column.
+	issue.Repo, issue.PullRequest = pr.BaseRepo, pr
+	return pr, nil
+}
+
+func checkHumanPullCreateScope(q sdk.HumanPullCreateRequest, scope Scope, raw string, pr *issues_model.PullRequest) error {
+	exact := humanPullCreateScope(q)
+	switch scope.CompletionPhase {
+	case "":
+	case HumanPullCreateRefPrepared, HumanPullCreateRefDone, HumanPullCreateFinishStarted, HumanPullCreateFinishDone:
+		exact.CompletionRef, exact.CompletionNewOID, exact.CompletionPhase = pr.GetGitRefName(), q.Expected.HeadOID, scope.CompletionPhase
+	default:
+		return ErrHumanPullCreateEvidence
+	}
+	encoded, err := encodeScope(exact)
+	if err != nil || encoded != raw {
+		return ErrHumanPullCreateEvidence
+	}
+	return nil
+}
+
+func readHumanPullCreateHeld(ctx context.Context, installation string, q sdk.HumanPullCreateRequest) (*ValidIntent, *nativeoperation_model.Reservation, Scope, *issues_model.PullRequest, *nativeoperation_model.Operation, error) {
+	id, err := uuid.Parse(installation)
+	if err != nil || id.String() != installation {
+		return nil, nil, Scope{}, nil, nil, ErrInvalidIntent
+	}
+	v, err := humanPullCreateIntent(q)
+	if err != nil {
+		return nil, nil, Scope{}, nil, nil, err
+	}
+	held, err := nativeoperation_model.ReadReservation(ctx)
+	if err != nil {
+		return nil, nil, Scope{}, nil, nil, err
+	}
+	x := execcontext.FromContext(ctx)
+	if x == nil || x.Owner != held.Owner || x.Generation != held.Generation || held.Owner != conditionalOwner(installation, q.OperationID) || held.OwnerKind != nativeoperation_model.OwnerConditional || held.Revision != v.ExpectedNativeRevision+1 {
+		return nil, nil, Scope{}, nil, nil, nativeoperation_model.ErrWrongOwner
+	}
+	proof, err := execcontext.ReadCapabilityFile(x.CapabilityPath)
+	if err != nil || !execcontext.VerifyProof(held.Verifier, proof) {
+		return nil, nil, Scope{}, nil, nil, nativeoperation_model.ErrWrongOwner
+	}
+	op, err := nativeoperation_model.LookupOperation(ctx, installation, q.OperationID)
+	if err != nil {
+		return nil, nil, Scope{}, nil, nil, err
+	}
+	if !humanMergeCaptureMatches(op, v) || !op.Admitted || op.EffectState != nativeoperation_model.EffectCommitted || op.Completion != nativeoperation_model.CompletionPending || op.Receipt == "" {
+		return nil, nil, Scope{}, nil, nil, ErrHumanPullCreateEvidence
+	}
+	pr, err := readHumanPullCreateReceipt(ctx, q, op.Receipt)
+	if err != nil {
+		return nil, nil, Scope{}, nil, nil, err
+	}
+	scope, err := decodeScope(held.Scope)
+	if err == nil {
+		err = checkHumanPullCreateScope(q, scope, held.Scope, pr)
+	}
+	return v, held, scope, pr, op, err
+}
+
+// Git reads must never run in the primary/phase SQL transaction.
+func checkHumanPullCreateTips(ctx context.Context, q sdk.HumanPullCreateRequest, pr *issues_model.PullRequest) error {
+	if db.InTransaction(ctx) {
+		return ErrInvalidIntent
+	}
+	for _, item := range []struct{ path, ref, oid string }{
+		{pr.BaseRepo.RepoPath(), git.BranchPrefix + q.Expected.BaseBranch, q.Expected.BaseOID},
+		{pr.HeadRepo.RepoPath(), git.BranchPrefix + q.Expected.HeadBranch, q.Expected.HeadOID},
+	} {
+		native, err := git.OpenRepository(ctx, item.path)
+		if err != nil {
+			return err
+		}
+		oid, err := native.GetRefCommitID(item.ref)
+		native.Close()
+		if err != nil || oid != item.oid {
+			return ErrHumanPullCreateEvidence
+		}
+	}
+	return nil
+}
+
+// CompleteHumanPullCreateRef consumes the committed SQL receipt to establish
+// exactly its new internal PR head ref. One durable claim precedes Git; another
+// caller never resumes an uncertain writer. Completion/notifications and owner
+// release remain separate. No caller SQL transaction spans object transfer/Git.
+func (s *Service) CompleteHumanPullCreateRef(ctx context.Context, installation string, q sdk.HumanPullCreateRequest) (sdk.OperationRecord, error) {
+	if db.InTransaction(ctx) {
+		return sdk.OperationRecord{}, ErrInvalidIntent
+	}
+	v, held, scope, pr, op, err := readHumanPullCreateHeld(ctx, installation, q)
+	if err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	if err := checkHumanPullCreateTips(ctx, q, pr); err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	tip, absent, known := s.prCreateRefTip(ctx, pr.BaseRepo.RepoPath(), pr.GetGitRefName())
+	if scope.CompletionPhase == HumanPullCreateRefDone {
+		if !known || absent || tip != q.Expected.HeadOID {
+			return sdk.OperationRecord{}, ErrHumanPullCreateEvidence
+		}
+		return ToRecord(op), nil
+	}
+	if scope.CompletionPhase != "" {
+		return sdk.OperationRecord{}, ErrHumanPullCreateRefClaimed
+	}
+	if !known || !absent {
+		return sdk.OperationRecord{}, ErrHumanPullCreateEvidence
+	}
+	started := scope
+	started.CompletionRef, started.CompletionNewOID, started.CompletionPhase = pr.GetGitRefName(), q.Expected.HeadOID, HumanPullCreateRefPrepared
+	startedJSON, err := encodeScope(started)
+	if err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	want := humanPullCreateOperation(installation, v)
+	transition := func(c context.Context, before, after string) (*nativeoperation_model.Operation, error) {
+		var recorded *nativeoperation_model.Operation
+		err := nativeoperation_model.WithHumanPullCreateReceipt(c, want, held.Owner, held.Generation, before, op.Receipt, func(tx context.Context, current *nativeoperation_model.Operation) error {
+			if _, err := readHumanPullCreateReceipt(tx, q, current.Receipt); err != nil {
+				return err
+			}
+			var err error
+			recorded, err = nativeoperation_model.ChangeHumanPullCreatePhase(tx, want, held.Owner, held.Generation, before, after, current.Receipt)
+			return err
+		})
+		return recorded, err
+	}
+	if _, err := transition(ctx, held.Scope, startedJSON); err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	// Fetch only the captured object, without local refs, tags or FETCH_HEAD.
+	// This also handles private forks whose commits do not exist in the base.
+	env := execcontext.AppendExecEnv(repo_module.RefWriteEnvironment(pr.BaseRepo), execcontext.FromContext(ctx))
+	if _, _, err := git.NewCommand(ctx, "fetch", "--no-tags", "--no-write-fetch-head", "--no-auto-maintenance", "--no-recurse-submodules", "--end-of-options").AddDynamicArguments("file://"+pr.HeadRepo.RepoPath(), q.Expected.HeadOID).RunStdString(&git.RunOpts{Dir: pr.BaseRepo.RepoPath(), Env: env}); err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	if err := checkHumanPullCreateTips(ctx, q, pr); err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	// An allocated PR ref must be absent. CAS and the generated native hook
+	// independently enforce the exact zero->captured-head tuple.
+	zero := strings.Repeat("0", len(q.Expected.HeadOID))
+	if _, _, err := git.NewCommand(ctx, "update-ref").AddDynamicArguments(pr.GetGitRefName(), q.Expected.HeadOID, zero).RunStdString(&git.RunOpts{Dir: pr.BaseRepo.RepoPath(), Env: env}); err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	tip, absent, known = s.prCreateRefTip(ctx, pr.BaseRepo.RepoPath(), pr.GetGitRefName())
+	if !known || absent || tip != q.Expected.HeadOID {
+		return sdk.OperationRecord{}, ErrHumanPullCreateEvidence
+	}
+	done := started
+	done.CompletionPhase = HumanPullCreateRefDone
+	doneJSON, err := encodeScope(done)
+	if err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	recorded, err := transition(context.WithoutCancel(ctx), startedJSON, doneJSON)
+	if err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	return ToRecord(recorded), nil
+}
+
+// Called only by prepared native reference-transaction admission after the
+// verifier, generation and target repository have already matched. SQL receipt,
+// exact capture/scope and both branch tips are re-read before admitting one ref.
+func (s *Service) admitHumanPullCreateRef(ctx context.Context, held *nativeoperation_model.Reservation, scope Scope, op *nativeoperation_model.Operation, lines []RefLine) (TransactionDecision, error) {
+	deny := TransactionDecision{Reason: nativeoperation_model.ReasonUnexpectedRefEffects}
+	var captured struct {
+		Payload sdk.HumanPullCreateRequest `json:"payload"`
+	}
+	if json.Unmarshal([]byte(op.Intent), &captured) != nil {
+		return TransactionDecision{Reason: nativeoperation_model.ReasonWrongOwner}, nil
+	}
+	q := captured.Payload
+	v, err := humanPullCreateIntent(q)
+	if err != nil || !humanMergeCaptureMatches(op, v) || !op.Admitted || op.EffectState != nativeoperation_model.EffectCommitted || op.Completion != nativeoperation_model.CompletionPending || held.Revision != v.ExpectedNativeRevision+1 || scope.CompletionPhase != HumanPullCreateRefPrepared {
+		return TransactionDecision{Reason: nativeoperation_model.ReasonWrongOwner}, nil
+	}
+	pr, err := readHumanPullCreateReceipt(ctx, q, op.Receipt)
+	if err != nil {
+		return TransactionDecision{Reason: nativeoperation_model.ReasonPRMismatch}, nil
+	}
+	if checkHumanPullCreateScope(q, scope, held.Scope, pr) != nil {
+		return deny, nil
+	}
+	if err := checkHumanPullCreateTips(ctx, q, pr); err != nil {
+		return TransactionDecision{Reason: nativeoperation_model.ReasonStaleBaseOrResult}, nil
+	}
+	// Object-only fetch can invoke an empty ref transaction. It grants no
+	// write, but still requires the exact committed capture and prepared scope.
+	if len(lines) == 0 {
+		return TransactionDecision{Allowed: true}, nil
+	}
+	if len(lines) != 1 || lines[0].Ref != pr.GetGitRefName() || lines[0].Old != strings.Repeat("0", len(q.Expected.HeadOID)) || lines[0].New != q.Expected.HeadOID {
+		return deny, nil
+	}
+	return TransactionDecision{Allowed: true}, nil
+}
diff --git a/services/nativeoperation/human_review.go b/services/nativeoperation/human_review.go
new file mode 100644
index 0000000000000000000000000000000000000000..fa521c8e19521fdd536dc172b0be4de0b4e81f1c
--- /dev/null
+++ b/services/nativeoperation/human_review.go
@@ -0,0 +1,250 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package nativeoperation
+
+import (
+	"context"
+	"encoding/json" //nolint:depguard // Exact persisted intent and native receipt.
+	"errors"
+	"time"
+
+	sdk "forgejo.org/extension-sdk"
+	"forgejo.org/models/db"
+	extensionauth_model "forgejo.org/models/extensionauth"
+	issues_model "forgejo.org/models/issues"
+	nativeoperation_model "forgejo.org/models/nativeoperation"
+	user_model "forgejo.org/models/user"
+	"forgejo.org/modules/git"
+	execcontext "forgejo.org/modules/nativeoperation"
+	pull_service "forgejo.org/services/pull"
+
+	"github.com/google/uuid"
+)
+
+const CrashPointHumanReviewBeforePrimary = "human-review-before-primary"
+const CrashPointHumanReviewAfterPrimary = "human-review-after-primary"
+
+// HumanReviewAdmission rechecks this exact review/inline/thread/reviewer request's current human/session,
+// installation and lifetime before claim/replay and inside atomic primary SQL.
+type HumanReviewAdmission func(context.Context) error
+
+func humanReviewIntent(q sdk.HumanReviewRequest) (*ValidIntent, error) {
+	if !sdk.ValidHumanReviewRequest(q) {
+		return nil, ErrInvalidIntent
+	}
+	intent := &ValidIntent{OperationID: q.OperationID, ActorID: nativeCommentID(q.Expected.ActorID), RepositoryID: nativeCommentID(q.Expected.RepositoryID), Kind: nativeoperation_model.KindHumanReview, AuthRevision: sdk.HumanReviewAuthorizationRevision, ExpectedNativeRevision: q.Expected.NativeRevision, NotAfter: q.NotAfter}
+	var err error
+	intent.Canonical, intent.Digest, err = sdk.CanonicalHumanReviewIntent(q)
+	return intent, err
+}
+
+func humanReviewType(event string) issues_model.ReviewType {
+	switch event {
+	case sdk.HumanReviewEventDraft:
+		return issues_model.ReviewTypePending
+	case sdk.HumanReviewEventComment:
+		return issues_model.ReviewTypeComment
+	case sdk.ReviewSubmitEventApproved:
+		return issues_model.ReviewTypeApprove
+	case sdk.ReviewSubmitEventRequestChanges:
+		return issues_model.ReviewTypeReject
+	default:
+		return issues_model.ReviewTypeUnknown
+	}
+}
+
+// SubmitHumanReview composes the prepared native primary with the existing
+// conditional journal/reservation, without background enrollment or credentials.
+func (s *Service) SubmitHumanReview(ctx context.Context, installation string, q sdk.HumanReviewRequest, admit HumanReviewAdmission) (sdk.OperationRecord, error) {
+	id, err := uuid.Parse(installation)
+	if err != nil || id.String() != installation || admit == nil {
+		return sdk.OperationRecord{}, ErrInvalidIntent
+	}
+	intent, err := humanReviewIntent(q)
+	if err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	if err := ctx.Err(); err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	if admit(ctx) != nil {
+		return sdk.OperationRecord{}, ErrAuthorityLost
+	}
+	existing, err := nativeoperation_model.LookupOperation(ctx, installation, q.OperationID)
+	if err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	if existing != nil {
+		return s.reconcileExisting(existing, intent)
+	}
+	if q.NotAfter <= s.clock() || q.NotAfter > s.clock()+int64(MaxOperationLifetime/time.Second) {
+		return sdk.OperationRecord{}, ErrInvalidIntent
+	}
+	scope := Scope{Kind: nativeoperation_model.OwnerConditional, RepositoryID: intent.RepositoryID, IssueID: nativeCommentID(q.Expected.IssueID)}
+	return s.claimConditionalSubmit(ctx, extensionauth_model.SubmissionDecision{ActorID: intent.ActorID}, installation, intent, scope, func(ctx context.Context, op *nativeoperation_model.Operation, _ *ValidIntent, execution *execcontext.Execution) (sdk.OperationRecord, terminalResult, error) {
+		return s.executeHumanReview(ctx, op, q, admit, execution)
+	})
+}
+
+// A bounded composite digest retains all existing own-draft code evidence
+// without clipping a large draft's receipt or exposing its text to clients.
+func humanReviewCommentsEvidence(ctx context.Context, review *issues_model.Review) (int64, string, error) {
+	var comments []*issues_model.Comment
+	if err := db.GetEngine(ctx).Where("review_id=? AND type=?", review.ID, issues_model.CommentTypeCode).OrderBy("id ASC").Find(&comments); err != nil {
+		return 0, "", err
+	}
+	type evidence struct {
+		ID, IssueID, ReviewID, ActorID, OriginalAuthorID int64
+		ResolveDoerID, ContentVersion, Created, Updated  int64
+		Content, Path, Commit, Patch                     string
+		OriginalAuthor                                   string
+		Line                                             int64
+		Anchor                                           *issues_model.CodeCommentAnchor
+		Invalidated                                      bool
+	}
+	rows := make([]evidence, 0, len(comments))
+	for _, c := range comments {
+		if c.IssueID != review.IssueID || c.ReviewID != review.ID || c.PosterID != review.ReviewerID || c.OriginalAuthorID != 0 {
+			return 0, "", issues_model.ErrExactReviewRefused{Reason: "pending draft comment identity differs"}
+		}
+		rows = append(rows, evidence{ID: c.ID, IssueID: c.IssueID, ReviewID: c.ReviewID, ActorID: c.PosterID, OriginalAuthorID: c.OriginalAuthorID, ResolveDoerID: c.ResolveDoerID, ContentVersion: int64(c.ContentVersion), Created: int64(c.CreatedUnix), Updated: int64(c.UpdatedUnix), Content: c.Content, Path: c.TreePath, Commit: c.CommitSHA, Patch: c.Patch, OriginalAuthor: c.OriginalAuthor, Line: c.Line, Anchor: c.OriginalAnchor, Invalidated: c.Invalidated})
+	}
+	raw, err := json.Marshal(rows)
+	if err != nil {
+		return 0, "", err
+	}
+	return int64(len(rows)), sdk.HumanReviewBodyDigest(string(raw)), nil
+}
+
+func (s *Service) executeHumanReview(ctx context.Context, op *nativeoperation_model.Operation, q sdk.HumanReviewRequest, admit HumanReviewAdmission, execution *execcontext.Execution) (sdk.OperationRecord, terminalResult, error) {
+	owned, release := execcontext.NewContext(ctx, execution), context.WithoutCancel(ctx)
+	refuse := func(reason string) (sdk.OperationRecord, terminalResult, error) {
+		r, err := nativeoperation_model.SetTerminal(release, op.InstallationID, op.OperationID, nativeoperation_model.TerminalOutcome{EffectState: nativeoperation_model.EffectNotCommitted, Reason: reason, Cancellation: nativeoperation_model.CancellationNone}, execution.Owner)
+		if err != nil {
+			return sdk.OperationRecord{}, terminalResult{}, err
+		}
+		return ToRecord(r), terminalResult{}, nil
+	}
+	if err := TestCrashBarrier(CrashPointHumanReviewBeforePrimary); err != nil {
+		return sdk.OperationRecord{}, terminalResult{}, err
+	}
+	var review *issues_model.Review
+	var comment *issues_model.Comment
+	var actor *user_model.User
+	committed, err := nativeoperation_model.CommitHumanReviewPrimary(owned, op.InstallationID, op.OperationID, execution.Owner, s.clock(), func(tx context.Context) (string, error) {
+		if tx.Err() != nil || admit(tx) != nil {
+			return "", ErrAuthorityLost
+		}
+		if s.clock() >= op.NotAfter {
+			return "", nativeoperation_model.ErrOperationExpired
+		}
+		p := q.Expected
+		issue, err := issues_model.GetIssueByID(tx, nativeCommentID(p.IssueID))
+		if err != nil {
+			return "", ErrAuthorityLost
+		}
+		if issue.RepoID != op.RepositoryID || issue.Index != nativeCommentID(p.Index) || !issue.IsPull {
+			return "", ErrAuthorityLost
+		}
+		if err := issue.LoadPullRequest(tx); err != nil || issue.PullRequest == nil {
+			return "", ErrAuthorityLost
+		}
+		if err := issue.LoadRepo(tx); err != nil {
+			return "", err
+		}
+		actor, err = user_model.GetUserByID(tx, op.ActorID)
+		if err != nil || !actor.IsAccessAllowed(tx) {
+			return "", ErrAuthorityLost
+		}
+		native, err := git.OpenRepository(tx, issue.Repo.RepoPath())
+		if err != nil {
+			return "", err
+		}
+		defer native.Close()
+		head, err := native.GetRefCommitID(issue.PullRequest.GetGitRefName())
+		if err != nil {
+			return "", issues_model.ErrExactReviewRefused{Reason: "head changed"}
+		}
+		base, err := native.GetRefCommitID(git.BranchPrefix + p.BaseBranch)
+		if err != nil {
+			return "", issues_model.ErrExactReviewRefused{Reason: "base changed"}
+		}
+		mergeBase, err := native.GetMergeBaseSimple(base, head)
+		if err != nil {
+			return "", issues_model.ErrExactReviewRefused{Reason: "merge base changed"}
+		}
+		want := issues_model.PreparedHumanReviewTarget{RepositoryID: op.RepositoryID, ReviewerID: op.ActorID, PullID: nativeCommentID(p.PullID), IssueID: issue.ID, Index: issue.Index, BaseBranch: p.BaseBranch, IsClosed: p.IsClosed, HasMerged: p.HasMerged, IsAuthor: p.IsAuthor, HeadOID: p.HeadOID, BaseOID: p.BaseOID, MergeBaseOID: p.MergeBaseOID, CurrentHeadOID: head, CurrentBaseOID: base, CurrentMergeBaseOID: mergeBase, PendingReviewID: nativeCommentID(p.PendingReviewID), PendingCommitID: p.PendingCommitID}
+		review, comment, err = issues_model.SubmitPreparedHumanReview(tx, humanReviewType(q.Event), q.Body, want)
+		if err != nil {
+			return "", err
+		}
+		count, digest, err := humanReviewCommentsEvidence(tx, review)
+		if err != nil {
+			return "", err
+		}
+		r := sdk.HumanReviewReceipt{RepositoryID: op.RepositoryID, ActorID: op.ActorID, PullID: want.PullID, IssueID: want.IssueID, Index: want.Index, ReviewID: review.ID, Event: q.Event, CommitID: review.CommitID, Official: review.Official, Stale: review.Stale, BodyDigest: sdk.HumanReviewBodyDigest(q.Body), DraftCommentsCount: count, DraftCommentsDigest: digest}
+		if comment != nil {
+			r.CommentID = comment.ID
+		}
+		if !sdk.ValidHumanReviewReceipt(r, q) {
+			return "", errors.New("native human review receipt differs")
+		}
+		if tx.Err() != nil {
+			return "", ErrAuthorityLost
+		}
+		raw, err := json.Marshal(r)
+		return string(raw), err
+	})
+	if err != nil {
+		var deterministic issues_model.ErrExactReviewRefused
+		switch {
+		case errors.Is(err, ErrAuthorityLost):
+			return refuse(nativeoperation_model.ReasonAuthorityLost)
+		case errors.As(err, &deterministic):
+			reason := nativeoperation_model.ReasonNativeRefused
+			switch deterministic.Reason {
+			case "head changed":
+				reason = nativeoperation_model.ReasonStaleHead
+			case "base changed", "merge base changed":
+				reason = nativeoperation_model.ReasonStaleBaseOrResult
+			case "pending draft changed":
+				reason = nativeoperation_model.ReasonPendingReviewExists
+			case "reviewer is inactive", "reviewer cannot read this pull request", "reviewer is blocked", "review workflow unavailable", "cannot review your own pull request":
+				reason = nativeoperation_model.ReasonAuthorityLost
+			case "human review parent changed", "human review pull changed":
+				reason = nativeoperation_model.ReasonPRMismatch
+			}
+			return refuse(reason)
+		case issues_model.IsContentEmptyErr(err):
+			return refuse(nativeoperation_model.ReasonNativeRefused)
+		case errors.Is(err, nativeoperation_model.ErrOperationExpired):
+			return refuse(nativeoperation_model.ReasonExpiredBeforeAdmission)
+		case errors.Is(err, nativeoperation_model.ErrAdmissionLost):
+			current, e := nativeoperation_model.LookupOperation(release, op.InstallationID, op.OperationID)
+			if e != nil {
+				return sdk.OperationRecord{}, terminalResult{}, e
+			}
+			if current != nil && current.Revoked {
+				return refuse(nativeoperation_model.ReasonCancelledBeforeAdmission)
+			}
+		}
+		return sdk.OperationRecord{}, terminalResult{}, err // Unknown commit results retain ownership for evidence recovery.
+	}
+	if err := TestCrashBarrier(CrashPointHumanReviewAfterPrimary); err != nil {
+		return sdk.OperationRecord{}, terminalResult{}, err
+	}
+	completion := nativeoperation_model.CompletionComplete
+	if q.Event != sdk.HumanReviewEventDraft {
+		if owned.Err() != nil {
+			completion = nativeoperation_model.CompletionNeedsIntervention
+		} else if err := pull_service.CompleteReviewSubmission(owned, actor, review.Issue, review, comment); err != nil {
+			completion = nativeoperation_model.CompletionNeedsIntervention
+		}
+	}
+	r, err := nativeoperation_model.SetCompletionAndRelease(release, committed.InstallationID, committed.OperationID, execution.Owner, execution.Generation, completion)
+	if err != nil {
+		return sdk.OperationRecord{}, terminalResult{}, err
+	}
+	return ToRecord(r), terminalResult{}, nil
+}
diff --git a/services/nativeoperation/human_review_recovery.go b/services/nativeoperation/human_review_recovery.go
