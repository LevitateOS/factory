+	// A scoped ID also owns cancellation tombstones before submit. Existing
+	// metadata must match the current principal; never project a foreign row.
+	lookup, err := service.Get(ctx, installation, operation)
+	if err != nil {
+		return nil, http.StatusServiceUnavailable
+	}
+	if record := lookup.Record; record != nil && record.Kind != "" && (record.Kind != extension.OperationKindHumanEdit || record.ActorID != strconv.FormatInt(entry.actorID, 10) || record.RepositoryID != request.RepositoryID) {
