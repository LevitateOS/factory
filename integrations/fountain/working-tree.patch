index 0000000000000000000000000000000000000000..1f6589f2d02209de58b400d6256f5582b3a19332
--- /dev/null
+++ b/services/nativeoperation/human_review_request.go
@@ -0,0 +1,222 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package nativeoperation
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"time"
+
+	sdk "forgejo.org/extension-sdk"
+	extensionauth_model "forgejo.org/models/extensionauth"
+	issues_model "forgejo.org/models/issues"
+	nativeoperation_model "forgejo.org/models/nativeoperation"
+	"forgejo.org/models/organization"
+	user_model "forgejo.org/models/user"
+	execcontext "forgejo.org/modules/nativeoperation"
+	issue_service "forgejo.org/services/issue"
+
+	"github.com/google/uuid"
+)
+
+const CrashPointHumanReviewRequestBeforePrimary = "human-review-request-before-primary"
+const CrashPointHumanReviewRequestAfterPrimary = "human-review-request-after-primary"
+
+func humanReviewRequestIntent(q sdk.HumanReviewRequestChange) (*ValidIntent, error) {
+	if !sdk.ValidHumanReviewRequestChange(q) {
+		return nil, ErrInvalidIntent
+	}
+	p := q.Expected.Review
+	intent := &ValidIntent{OperationID: q.OperationID, ActorID: nativeCommentID(p.ActorID), RepositoryID: nativeCommentID(p.RepositoryID), Kind: nativeoperation_model.KindHumanReviewRequest, AuthRevision: sdk.HumanReviewRequestAuthorizationRevision, ExpectedNativeRevision: p.NativeRevision, NotAfter: q.NotAfter}
+	var err error
+	intent.Canonical, intent.Digest, err = sdk.CanonicalHumanReviewRequestIntent(q)
+	return intent, err
+}
+
+// SubmitHumanReviewRequest uses current human request admission, never background
+// enrollment. Request rows, native history and exact receipt commit together.
+// Replays and early cancellation use the existing installation-bound journal.
+func (s *Service) SubmitHumanReviewRequest(ctx context.Context, installation string, q sdk.HumanReviewRequestChange, admit HumanReviewAdmission) (sdk.OperationRecord, error) {
+	id, err := uuid.Parse(installation)
+	if err != nil || id.String() != installation || admit == nil {
+		return sdk.OperationRecord{}, ErrInvalidIntent
+	}
+	intent, err := humanReviewRequestIntent(q)
+	if err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	if ctx.Err() != nil {
+		return sdk.OperationRecord{}, ctx.Err()
+	}
+	if admit(ctx) != nil {
+		return sdk.OperationRecord{}, ErrAuthorityLost
+	}
+	finish := func(r sdk.OperationRecord, err error) (sdk.OperationRecord, error) {
+		if err == nil || errors.Is(err, ErrCancelledBeforeSubmit) {
+			if ctx.Err() != nil || admit(ctx) != nil {
+				return sdk.OperationRecord{}, ErrAuthorityLost
+			}
+		}
+		return r, err
+	}
+	existing, err := nativeoperation_model.LookupOperation(ctx, installation, q.OperationID)
+	if err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	if existing != nil {
+		r, err := s.reconcileExisting(existing, intent)
+		return finish(r, err)
+	}
+	if q.NotAfter <= s.clock() || q.NotAfter > s.clock()+int64(MaxOperationLifetime/time.Second) {
+		return sdk.OperationRecord{}, ErrInvalidIntent
+	}
+	scope := Scope{Kind: nativeoperation_model.OwnerConditional, RepositoryID: intent.RepositoryID, IssueID: nativeCommentID(q.Expected.Review.IssueID)}
+	record, err := s.claimConditionalSubmit(ctx, extensionauth_model.SubmissionDecision{ActorID: intent.ActorID}, installation, intent, scope, func(ctx context.Context, op *nativeoperation_model.Operation, _ *ValidIntent, execution *execcontext.Execution) (sdk.OperationRecord, terminalResult, error) {
+		return s.executeHumanReviewRequest(ctx, op, q, admit, execution)
+	})
+	return finish(record, err)
+}
+
+func (s *Service) executeHumanReviewRequest(ctx context.Context, op *nativeoperation_model.Operation, q sdk.HumanReviewRequestChange, admit HumanReviewAdmission, execution *execcontext.Execution) (sdk.OperationRecord, terminalResult, error) {
+	owned, release := execcontext.NewContext(ctx, execution), context.WithoutCancel(ctx)
+	refuse := func(reason string) (sdk.OperationRecord, terminalResult, error) {
+		r, err := nativeoperation_model.SetTerminal(release, op.InstallationID, op.OperationID, nativeoperation_model.TerminalOutcome{EffectState: nativeoperation_model.EffectNotCommitted, Reason: reason, Cancellation: nativeoperation_model.CancellationNone}, execution.Owner)
+		if err != nil {
+			return sdk.OperationRecord{}, terminalResult{}, err
+		}
+		return ToRecord(r), terminalResult{}, nil
+	}
+	if err := TestCrashBarrier(CrashPointHumanReviewRequestBeforePrimary); err != nil {
+		return sdk.OperationRecord{}, terminalResult{}, err
+	}
+	var receipt sdk.HumanReviewRequestReceipt
+	committed, err := nativeoperation_model.CommitHumanReviewRequestPrimary(owned, op.InstallationID, op.OperationID, execution.Owner, s.clock(), func(tx context.Context) (string, error) {
+		gate := func(ctx context.Context) error {
+			if s.clock() >= op.NotAfter {
+				return nativeoperation_model.ErrOperationExpired
+			}
+			return admit(ctx)
+		}
+		result, err := ApplyPreparedHumanReviewRequest(tx, op.ActorID, q.Expected, q.Requested, gate)
+		if err != nil {
+			return "", err
+		}
+		p := q.Expected.Review
+		receipt = sdk.HumanReviewRequestReceipt{RepositoryID: op.RepositoryID, ActorID: op.ActorID, PullID: nativeCommentID(p.PullID), IssueID: nativeCommentID(p.IssueID), Index: nativeCommentID(p.Index), ReviewerKind: q.Expected.ReviewerKind, ReviewerID: nativeCommentID(q.Expected.ReviewerID), Before: result.Before, After: result.After, Changed: result.Changed, HistoryIDs: result.HistoryIDs, ReviewsBeforeDigest: result.ReviewsBeforeDigest, ReviewsAfterDigest: result.ReviewsAfterDigest}
+		receipt.HistoryDigest, err = humanReviewRequestHistoryDigest(tx, receipt, q.Requested)
+		if err != nil {
+			return "", err
+		}
+		if !sdk.ValidHumanReviewRequestReceipt(receipt, q) {
+			return "", errors.New("native human reviewer request receipt differs")
+		}
+		raw, err := json.Marshal(receipt)
+		if err != nil {
+			return "", err
+		}
+		if s.clock() >= op.NotAfter {
+			return "", nativeoperation_model.ErrOperationExpired
+		}
+		return string(raw), nil
+	})
+	if err != nil {
+		var deterministic issues_model.ErrExactReviewRefused
+		switch {
+		case errors.Is(err, ErrAuthorityLost):
+			return refuse(nativeoperation_model.ReasonAuthorityLost)
+		case errors.Is(err, nativeoperation_model.ErrOperationExpired):
+			return refuse(nativeoperation_model.ReasonExpiredBeforeAdmission)
+		case errors.Is(err, ErrHumanReviewRequestMissing), errors.Is(err, ErrHumanReviewRequestTooLarge):
+			return refuse(nativeoperation_model.ReasonStaleConversation)
+		case errors.As(err, &deterministic):
+			reason := nativeoperation_model.ReasonNativeRefused
+			switch deterministic.Reason {
+			case "reviewer head changed":
+				reason = nativeoperation_model.ReasonStaleHead
+			case "reviewer base changed", "reviewer merge base changed":
+				reason = nativeoperation_model.ReasonStaleBaseOrResult
+			case "reviewer policy or selected requests changed", "reviewer history changed":
+				reason = nativeoperation_model.ReasonStaleConversation
+			case "reviewer actor is inactive", "reviewer workflow unavailable", "reviewer actor cannot read pull":
+				reason = nativeoperation_model.ReasonAuthorityLost
+			case "reviewer parent changed", "reviewer pull changed":
+				reason = nativeoperation_model.ReasonPRMismatch
+			case "reviewer primary readback differs", "reviewer history differs from native effect", "created reviewer request differs", "removed reviewer history differs", "reviewer primary did not record expected history", "invalid persisted reviewer history":
+				return sdk.OperationRecord{}, terminalResult{}, err // Unexpected SQL effects retain the fence after rollback.
+			}
+			return refuse(reason)
+		case errors.Is(err, nativeoperation_model.ErrAdmissionLost):
+			current, e := nativeoperation_model.LookupOperation(release, op.InstallationID, op.OperationID)
+			if e != nil {
+				return sdk.OperationRecord{}, terminalResult{}, e
+			}
+			if current != nil && current.Revoked {
+				return refuse(nativeoperation_model.ReasonCancelledBeforeAdmission)
+			}
+		}
+		return sdk.OperationRecord{}, terminalResult{}, err
+	}
+	if err := TestCrashBarrier(CrashPointHumanReviewRequestAfterPrimary); err != nil {
+		return sdk.OperationRecord{}, terminalResult{}, err
+	}
+	completion := nativeoperation_model.CompletionComplete
+	if humanReviewRequestNeedsCompletion(receipt, q.Requested) {
+		if err := completeHumanReviewRequest(owned, receipt, q.Requested); err != nil {
+			completion = nativeoperation_model.CompletionNeedsIntervention
+		}
+	}
+	r, err := nativeoperation_model.SetCompletionAndRelease(release, committed.InstallationID, committed.OperationID, execution.Owner, execution.Generation, completion)
+	if err != nil {
+		return sdk.OperationRecord{}, terminalResult{}, err
+	}
+	return ToRecord(r), terminalResult{}, nil
+}
+
+func humanReviewRequestNeedsCompletion(r sdk.HumanReviewRequestReceipt, requested bool) bool {
+	return r.Changed && (r.ReviewerKind == "user" && r.ActorID != r.ReviewerID || r.ReviewerKind == "team" && requested)
+}
+
+func completeHumanReviewRequest(ctx context.Context, r sdk.HumanReviewRequestReceipt, requested bool) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	actor, err := user_model.GetUserByID(ctx, r.ActorID)
+	if err != nil {
+		return err
+	}
+	issue, err := issues_model.GetIssueByID(ctx, r.IssueID)
+	if err != nil {
+		return err
+	}
+	if err := issue.LoadRepo(ctx); err != nil {
+		return err
+	}
+	if err := issue.LoadPoster(ctx); err != nil {
+		return err
+	}
+	if err := issue.LoadPullRequest(ctx); err != nil {
+		return err
+	}
+	var reviewer *user_model.User
+	var team *organization.Team
+	if r.ReviewerKind == "user" {
+		reviewer, err = user_model.GetUserByID(ctx, r.ReviewerID)
+	} else {
+		team, err = organization.GetTeamByID(ctx, r.ReviewerID)
+	}
+	if err != nil {
+		return err
+	}
+	for _, id := range r.HistoryIDs {
+		comment, err := issues_model.GetCommentByID(ctx, nativeCommentID(id))
+		if err != nil {
+			return err
+		}
+		if err := issue_service.CompleteReviewRequestChange(ctx, issue, actor, reviewer, team, requested, comment); err != nil {
+			return err
+		}
+	}
+	return nil
+}
diff --git a/services/nativeoperation/human_review_request_policy.go b/services/nativeoperation/human_review_request_policy.go
new file mode 100644
index 0000000000000000000000000000000000000000..d242fdbc202c2a360bb3e5ab9b44baabb16483ef
--- /dev/null
+++ b/services/nativeoperation/human_review_request_policy.go
@@ -0,0 +1,95 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package nativeoperation
+
+import (
+	"context"
+	"errors"
+
+	sdk "forgejo.org/extension-sdk"
+	issues_model "forgejo.org/models/issues"
+	"forgejo.org/models/organization"
+	user_model "forgejo.org/models/user"
+	issue_service "forgejo.org/services/issue"
+)
+
+var ErrHumanReviewRequestMissing = errors.New("selected review request subject is not visible")
+
+// HumanReviewRequestSelection retains native subjects only inside the host.
+// Preparation and conditional SQL use the same defining native policy.
+type HumanReviewRequestSelection struct {
+	User         *user_model.User
+	Team         *organization.Team
+	Requests     sdk.HumanReviewRequestEvidence
+	AddAction    sdk.RepositoryActionCapability
+	RemoveAction sdk.RepositoryActionCapability
+}
+
+func ReadHumanReviewRequestSelection(ctx context.Context, actor *user_model.User, issue *issues_model.Issue, kind string, id int64) (*HumanReviewRequestSelection, error) {
+	if actor == nil || issue == nil || !issue.IsPull || id <= 0 || kind != "user" && kind != "team" {
+		return nil, ErrHumanReviewRequestMissing
+	}
+	if err := issue.LoadRepo(ctx); err != nil {
+		return nil, err
+	}
+	if err := issue.LoadPullRequest(ctx); err != nil {
+		return nil, err
+	}
+	s := &HumanReviewRequestSelection{AddAction: sdk.RepositoryActionCapability{State: "allowed", Reason: "review_request_add"}, RemoveAction: sdk.RepositoryActionCapability{State: "allowed", Reason: "review_request_remove"}}
+	var valid func(bool) error
+	var latest *issues_model.Review
+	var err error
+	if kind == "user" {
+		s.User, err = user_model.GetUserByID(ctx, id)
+		if user_model.IsErrUserNotExist(err) {
+			return nil, ErrHumanReviewRequestMissing
+		}
+		if err != nil {
+			return nil, err
+		}
+		valid = func(add bool) error { return issue_service.IsValidReviewRequest(ctx, s.User, actor, add, issue) }
+		latest, err = issues_model.GetReviewByIssueIDAndUserID(ctx, issue.ID, id)
+		if err != nil && !issues_model.IsErrReviewNotExist(err) {
+			return nil, err
+		}
+	} else {
+		s.Team, err = organization.GetTeamByID(ctx, id)
+		if organization.IsErrTeamNotExist(err) {
+			return nil, ErrHumanReviewRequestMissing
+		}
+		if err != nil {
+			return nil, err
+		}
+		if err := issue.Repo.LoadOwner(ctx); err != nil {
+			return nil, err
+		}
+		if !issue.Repo.Owner.IsOrganization() || s.Team.OrgID != issue.Repo.OwnerID {
+			return nil, ErrHumanReviewRequestMissing
+		}
+		valid = func(add bool) error { return issue_service.IsValidTeamReviewRequest(ctx, s.Team, actor, add, issue) }
+	}
+	for _, action := range []struct {
+		add  bool
+		fact *sdk.RepositoryActionCapability
+	}{{true, &s.AddAction}, {false, &s.RemoveAction}} {
+		if err := valid(action.add); err != nil {
+			if !issues_model.IsErrNotValidReviewRequest(err) {
+				return nil, err
+			}
+			*action.fact = sdk.RepositoryActionCapability{State: "denied", Reason: "review_request_policy"}
+		}
+	}
+	if kind == "user" && latest != nil && latest.Type != issues_model.ReviewTypeRequest && (issue.IsClosed || issue.PullRequest.HasMerged) {
+		s.AddAction = sdk.RepositoryActionCapability{State: "denied", Reason: "pull_closed"}
+	}
+	if issue.Repo.IsArchived {
+		s.AddAction = sdk.RepositoryActionCapability{State: "denied", Reason: "repository_archived"}
+		s.RemoveAction = s.AddAction
+	}
+	s.Requests, err = ReadHumanReviewRequestEvidence(ctx, issue.ID, kind, id)
+	if err != nil {
+		return nil, err
+	}
+	return s, nil
+}
diff --git a/services/nativeoperation/human_review_request_primary.go b/services/nativeoperation/human_review_request_primary.go
new file mode 100644
index 0000000000000000000000000000000000000000..706ad6f8e75578414bf47eff532f13b9199d4309
--- /dev/null
+++ b/services/nativeoperation/human_review_request_primary.go
@@ -0,0 +1,321 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package nativeoperation
+
+import (
+	"context"
+	"reflect"
+	"strconv"
+	"unicode/utf8"
+
+	sdk "forgejo.org/extension-sdk"
+	"forgejo.org/models/db"
+	issues_model "forgejo.org/models/issues"
+	access_model "forgejo.org/models/perm/access"
+	"forgejo.org/models/unit"
+	user_model "forgejo.org/models/user"
+	"forgejo.org/modules/git"
+)
+
+// PreparedHumanReviewRequestResult is primary SQL evidence, not an operation
+// receipt. History IDs identify native request-change comments. Review digests
+// also bind the selected subject's historical/pending records and official flags;
+// their prose remains private to the native host.
+type PreparedHumanReviewRequestResult struct {
+	Before, After                           sdk.HumanReviewRequestEvidence
+	Changed                                 bool
+	HistoryIDs                              []string
+	ReviewsBeforeDigest, ReviewsAfterDigest string
+}
+
+// ApplyPreparedHumanReviewRequest joins the caller's transaction under the exact
+// held native revision. The trusted actor and admission callback come from the
+// current human boundary, never request JSON. Desired-state no-ops preserve all
+// rows; removal consumes the complete selected request set. Native model writers
+// retain their official-review and history semantics. This primary sends no
+// notifications, claims no owner and activates no journal/transport.
+func ApplyPreparedHumanReviewRequest(ctx context.Context, actorID int64, want sdk.RepositoryReviewRequestSnapshot, requested bool, admit HumanReviewAdmission) (*PreparedHumanReviewRequestResult, error) {
+	p := want.Review
+	refuse := func(reason string) (*PreparedHumanReviewRequestResult, error) {
+		return nil, issues_model.ErrExactReviewRefused{Reason: reason}
+	}
+	q := sdk.RepositoryReviewRequestSnapshotRequest{Index: p.Index, ReviewerKind: want.ReviewerKind, ReviewerID: want.ReviewerID}
+	if actorID <= 0 || actorID != nativeCommentID(p.ActorID) || admit == nil || !sdk.ValidRepositoryReviewRequestSnapshot(&want, p.RepositoryID, p.ActorID, q) {
+		return refuse("invalid human reviewer target")
+	}
+	action := want.RemoveAction
+	if requested {
+		action = want.AddAction
+	}
+	if action.State != "allowed" {
+		return refuse("reviewer action was not admitted")
+	}
+	if err := requireHumanPrimaryOwner(ctx, p.NativeRevision); err != nil {
+		return nil, err
+	}
+	ctx, committer, err := db.TxContext(ctx)
+	if err != nil {
+		return nil, err
+	}
+	defer committer.Close()
+	if err := admitHumanPrimary(ctx, admit); err != nil {
+		return nil, err
+	}
+	actor, issue, selected, err := loadHumanReviewRequestPrimary(ctx, actorID, want, requested)
+	if err != nil {
+		return nil, err
+	}
+	beforeRows, err := humanReviewRequestHistory(ctx, issue.ID, want.ReviewerKind, nativeCommentID(want.ReviewerID))
+	if err != nil {
+		return nil, err
+	}
+	if err := admitHumanPrimary(ctx, admit); err != nil {
+		return nil, err
+	}
+	actor, issue, selected, err = loadHumanReviewRequestPrimary(ctx, actorID, want, requested)
+	if err != nil {
+		return nil, err
+	}
+	freshRows, err := humanReviewRequestHistory(ctx, issue.ID, want.ReviewerKind, nativeCommentID(want.ReviewerID))
+	if err != nil {
+		return nil, err
+	}
+	if !reflect.DeepEqual(beforeRows, freshRows) {
+		return refuse("reviewer history changed")
+	}
+	if err := requireHumanPrimaryOwner(ctx, p.NativeRevision); err != nil {
+		return nil, err
+	}
+	result := &PreparedHumanReviewRequestResult{Before: selected.Requests, HistoryIDs: []string{}}
+	result.Changed = requested != (len(result.Before.RequestIDs) > 0)
+	var official bool
+	if selected.User != nil {
+		official, err = issues_model.IsOfficialReviewer(ctx, issue, selected.User)
+	} else {
+		official, err = issues_model.IsOfficialReviewerTeam(ctx, issue, selected.Team)
+	}
+	if err != nil {
+		return nil, err
+	}
+	var created *issues_model.Review
+	if result.Changed {
+		steps := 1
+		if !requested {
+			steps = len(result.Before.RequestIDs)
+		}
+		for range steps {
+			var comment *issues_model.Comment
+			if selected.User != nil {
+				if requested {
+					comment, err = issues_model.AddReviewRequest(ctx, issue, selected.User, actor)
+				} else {
+					comment, err = issues_model.RemoveReviewRequest(ctx, issue, selected.User, actor)
+				}
+			} else if requested {
+				comment, err = issues_model.AddTeamReviewRequest(ctx, issue, selected.Team, actor)
+			} else {
+				comment, err = issues_model.RemoveTeamReviewRequest(ctx, issue, selected.Team, actor)
+			}
+			if err != nil {
+				return nil, err
+			}
+			if comment == nil || comment.ID <= 0 {
+				return refuse("reviewer primary did not record expected history")
+			}
+			stored, err := issues_model.GetCommentByID(ctx, comment.ID)
+			if err != nil {
+				return nil, err
+			}
+			userID, teamID := int64(0), int64(0)
+			if selected.User != nil {
+				userID = selected.User.ID
+			} else {
+				teamID = selected.Team.ID
+			}
+			if stored.Type != issues_model.CommentTypeReviewRequest || stored.IssueID != issue.ID || stored.PosterID != actor.ID || stored.AssigneeID != userID || stored.AssigneeTeamID != teamID || stored.RemovedAssignee == requested || stored.Content != "" || stored.OriginalAuthorID != 0 || stored.OriginalAuthor != "" {
+				return refuse("reviewer history differs from native effect")
+			}
+			if requested {
+				created, err = issues_model.GetReviewByID(ctx, stored.ReviewID)
+				if err != nil {
+					return nil, err
+				}
+				if created.Type != issues_model.ReviewTypeRequest || created.IssueID != issue.ID || created.ReviewerID != userID || created.ReviewerTeamID != teamID || created.Official != official || created.Content != "" || created.CommitID != "" || created.Stale || created.Dismissed || created.OriginalAuthorID != 0 || created.OriginalAuthor != "" {
+					return refuse("created reviewer request differs")
+				}
+			} else if stored.ReviewID != 0 {
+				return refuse("removed reviewer history differs")
+			}
+			result.HistoryIDs = append(result.HistoryIDs, strconv.FormatInt(stored.ID, 10))
+		}
+	}
+	result.After, err = ReadHumanReviewRequestEvidence(ctx, issue.ID, want.ReviewerKind, nativeCommentID(want.ReviewerID))
+	if err != nil {
+		return nil, err
+	}
+	expected := make([]humanReviewRequestRow, 0, len(beforeRows)+1)
+	removed := map[int64]bool{}
+	if result.Changed && !requested {
+		for _, id := range result.Before.RequestIDs {
+			removed[nativeCommentID(id)] = true
+		}
+	}
+	for _, row := range beforeRows {
+		if removed[row.ID] {
+			continue
+		}
+		if result.Changed && requested && selected.User != nil && official {
+			row.Official = false
+		}
+		expected = append(expected, row)
+	}
+	if result.Changed && !requested && official {
+		// The native remover restores the latest eligible review after removing
+		// requests. Team history uses the native negative reviewer convention
+		// internally; that convention never crosses the SDK selection boundary.
+		id := nativeCommentID(want.ReviewerID)
+		if selected.Team != nil {
+			id = -id
+		}
+		for i := len(expected) - 1; i >= 0; i-- {
+			r := &expected[i]
+			if r.ReviewerID == id && r.OriginalAuthorID == 0 && (r.Type == issues_model.ReviewTypeApprove || r.Type == issues_model.ReviewTypeReject || r.Type == issues_model.ReviewTypeRequest) {
+				r.Official = true
+				break
+			}
+		}
+	}
+	if created != nil {
+		expected = append(expected, humanReviewRequestStored(created))
+	}
+	afterRows, err := humanReviewRequestHistory(ctx, issue.ID, want.ReviewerKind, nativeCommentID(want.ReviewerID))
+	if err != nil {
+		return nil, err
+	}
+	if !reflect.DeepEqual(expected, afterRows) || requested != (len(result.After.RequestIDs) > 0) || requested && result.Changed && (len(result.After.RequestIDs) != 1 || result.After.RequestIDs[0] != strconv.FormatInt(created.ID, 10)) || !result.Changed && !reflect.DeepEqual(result.Before, result.After) {
+		return refuse("reviewer primary readback differs")
+	}
+	result.ReviewsBeforeDigest, err = humanReviewRequestDigest(beforeRows)
+	if err != nil {
+		return nil, err
+	}
+	result.ReviewsAfterDigest, err = humanReviewRequestDigest(afterRows)
+	if err != nil {
+		return nil, err
+	}
+	if err := admitHumanPrimary(ctx, admit); err != nil {
+		return nil, err
+	}
+	if err := requireHumanPrimaryOwner(ctx, p.NativeRevision); err != nil {
+		return nil, err
+	}
+	if err := committer.Commit(); err != nil {
+		return nil, err
+	}
+	return result, nil
+}
+
+func loadHumanReviewRequestPrimary(ctx context.Context, actorID int64, want sdk.RepositoryReviewRequestSnapshot, requested bool) (*user_model.User, *issues_model.Issue, *HumanReviewRequestSelection, error) {
+	p := want.Review
+	refuse := func(reason string) (*user_model.User, *issues_model.Issue, *HumanReviewRequestSelection, error) {
+		return nil, nil, nil, issues_model.ErrExactReviewRefused{Reason: reason}
+	}
+	actor, err := user_model.GetUserByID(ctx, actorID)
+	if err != nil {
+		return nil, nil, nil, err
+	}
+	if !actor.IsAccessAllowed(ctx) {
+		return refuse("reviewer actor is inactive")
+	}
+	issue, err := issues_model.GetIssueByID(ctx, nativeCommentID(p.IssueID))
+	if err != nil {
+		return nil, nil, nil, err
+	}
+	if issue.RepoID != nativeCommentID(p.RepositoryID) || issue.Index != nativeCommentID(p.Index) || !issue.IsPull || issue.IsClosed != p.IsClosed || issue.IsPoster(actorID) != p.IsAuthor {
+		return refuse("reviewer parent changed")
+	}
+	if err := issue.LoadPullRequest(ctx); err != nil {
+		return nil, nil, nil, err
+	}
+	pr := issue.PullRequest
+	if pr == nil || pr.ID != nativeCommentID(p.PullID) || pr.BaseRepoID != issue.RepoID || pr.IssueID != issue.ID || pr.Index != issue.Index || pr.BaseBranch != p.BaseBranch || pr.HasMerged != p.HasMerged {
+		return refuse("reviewer pull changed")
+	}
+	if err := issue.LoadRepo(ctx); err != nil {
+		return nil, nil, nil, err
+	}
+	repo := issue.Repo
+	if repo.IsArchived || !repo.AllowsPulls(ctx) {
+		return refuse("reviewer workflow unavailable")
+	}
+	permission, err := access_model.GetUserRepoPermission(ctx, repo, actor)
+	if err != nil {
+		return nil, nil, nil, err
+	}
+	for _, kind := range []unit.Type{unit.TypeCode, unit.TypePullRequests} {
+		if kind.UnitGlobalDisabled() || !repo.UnitEnabled(ctx, kind) || !permission.CanRead(kind) {
+			return refuse("reviewer actor cannot read pull")
+		}
+	}
+	native, err := git.OpenRepository(ctx, repo.RepoPath())
+	if err != nil {
+		return nil, nil, nil, err
+	}
+	defer native.Close()
+	head, err := native.GetRefCommitID(pr.GetGitRefName())
+	if err != nil || head != p.HeadOID {
+		return refuse("reviewer head changed")
+	}
+	base, err := native.GetRefCommitID(git.BranchPrefix + p.BaseBranch)
+	if err != nil || base != p.BaseOID {
+		return refuse("reviewer base changed")
+	}
+	mergeBase, err := native.GetMergeBaseSimple(base, head)
+	if err != nil || mergeBase != p.MergeBaseOID {
+		return refuse("reviewer merge base changed")
+	}
+	selected, err := ReadHumanReviewRequestSelection(ctx, actor, issue, want.ReviewerKind, nativeCommentID(want.ReviewerID))
+	if err != nil {
+		return nil, nil, nil, err
+	}
+	action := selected.RemoveAction
+	if requested {
+		action = selected.AddAction
+	}
+	if action.State != "allowed" || !reflect.DeepEqual(selected.Requests, want.Requests) {
+		return refuse("reviewer policy or selected requests changed")
+	}
+	return actor, issue, selected, nil
+}
+
+// Official-request mutations can update historical flags. Bound and prove that
+// entire selected history, including the native team historical identity, while
+// keeping its prose private. Other subjects' reviews are outside this primary.
+func humanReviewRequestHistory(ctx context.Context, issueID int64, kind string, id int64) ([]humanReviewRequestRow, error) {
+	query := db.GetEngine(ctx).Where("issue_id=?", issueID)
+	if kind == "user" {
+		query = query.And("reviewer_id=?", id)
+	} else {
+		query = query.And("(reviewer_team_id=? OR reviewer_id=?)", id, -id)
+	}
+	var reviews []*issues_model.Review
+	if err := query.Asc("id").Limit(10001).Find(&reviews); err != nil {
+		return nil, err
+	}
+	if len(reviews) > 10000 {
+		return nil, ErrHumanReviewRequestTooLarge
+	}
+	rows, total := make([]humanReviewRequestRow, 0, len(reviews)), 0
+	for _, r := range reviews {
+		total += len(r.Content) + len(r.OriginalAuthor) + len(r.CommitID)
+		if total > sdk.MaxReviewRequestSnapshotBodyBytes {
+			return nil, ErrHumanReviewRequestTooLarge
+		}
+		if !utf8.ValidString(r.Content) || !utf8.ValidString(r.OriginalAuthor) || !utf8.ValidString(r.CommitID) {
+			return nil, issues_model.ErrExactReviewRefused{Reason: "invalid persisted reviewer history"}
+		}
+		rows = append(rows, humanReviewRequestStored(r))
+	}
+	return rows, nil
+}
diff --git a/services/nativeoperation/human_review_request_recovery.go b/services/nativeoperation/human_review_request_recovery.go
new file mode 100644
index 0000000000000000000000000000000000000000..7000ecf89547250ee8f0d5051ba8dcdb2975abd3
--- /dev/null
+++ b/services/nativeoperation/human_review_request_recovery.go
@@ -0,0 +1,153 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package nativeoperation
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"reflect"
+	"unicode/utf8"
+
+	sdk "forgejo.org/extension-sdk"
+	"forgejo.org/models/db"
+	issues_model "forgejo.org/models/issues"
+	nativeoperation_model "forgejo.org/models/nativeoperation"
+	"forgejo.org/models/organization"
+	user_model "forgejo.org/models/user"
+)
+
+// Each history row is freshly loaded, without hydrated associations, both at
+// atomic commit and recovery. The digest includes complete stored event facts
+// and timestamps. No native model object or prose crosses the SDK receipt seam.
+func humanReviewRequestHistoryDigest(ctx context.Context, r sdk.HumanReviewRequestReceipt, requested bool) (string, error) {
+	if len(r.HistoryIDs) == 0 {
+		return sdk.HumanReviewBodyDigest("[]"), nil
+	}
+	ids := make([]int64, 0, len(r.HistoryIDs))
+	for _, id := range r.HistoryIDs {
+		ids = append(ids, nativeCommentID(id))
+	}
+	var comments []*issues_model.Comment
+	if err := db.GetEngine(ctx).In("id", ids).Asc("id").Find(&comments); err != nil {
+		return "", err
+	}
+	if len(comments) != len(ids) {
+		return "", errors.New("recorded reviewer history is missing")
+	}
+	userID, teamID := int64(0), int64(0)
+	if r.ReviewerKind == "user" {
+		userID = r.ReviewerID
+	} else {
+		teamID = r.ReviewerID
+	}
+	for i, c := range comments {
+		if c.ID != ids[i] || c.Type != issues_model.CommentTypeReviewRequest || c.IssueID != r.IssueID || c.PosterID != r.ActorID || c.AssigneeID != userID || c.AssigneeTeamID != teamID || c.RemovedAssignee == requested || c.OriginalAuthorID != 0 || c.OriginalAuthor != "" || c.Content != "" || c.OriginalAnchor != nil {
+			return "", errors.New("recorded reviewer history differs")
+		}
+		if requested && (len(r.After.RequestIDs) != 1 || c.ReviewID != nativeCommentID(r.After.RequestIDs[0])) || !requested && c.ReviewID != 0 {
+			return "", errors.New("recorded reviewer history target differs")
+		}
+		for _, value := range []string{c.OriginalAuthor, c.OldTitle, c.NewTitle, c.OldRef, c.NewRef, c.TreePath, c.Content, c.PatchQuoted, c.CommitSHA} {
+			if !utf8.ValidString(value) {
+				return "", errors.New("invalid persisted reviewer history text")
+			}
+		}
+	}
+	raw, err := json.Marshal(comments)
+	if err != nil {
+		return "", err
+	}
+	if len(raw) > sdk.MaxReviewRequestSnapshotBodyBytes {
+		return "", ErrHumanReviewRequestTooLarge
+	}
+	return sdk.HumanReviewBodyDigest(string(raw)), nil
+}
+
+// Offline recovery attributes exact SQL evidence under the stopped writer's
+// intact fence. It never reapplies desired state or repeats notifications.
+func (s *Service) recoverHumanReviewRequest(ctx context.Context, a *RecoveryAssessment, r *nativeoperation_model.Reservation, scope Scope, op *nativeoperation_model.Operation) (RecoveryAssessment, error) {
+	var saved struct {
+		Payload sdk.HumanReviewRequestChange `json:"payload"`
+	}
+	if json.Unmarshal([]byte(op.Intent), &saved) != nil {
+		return fenced(a, ReasonRecoveryMissingEvidence, "human reviewer request intent is missing")
+	}
+	q := saved.Payload
+	intent, err := humanReviewRequestIntent(q)
+	expectedScope := Scope{Kind: nativeoperation_model.OwnerConditional, RepositoryID: op.RepositoryID, IssueID: nativeCommentID(q.Expected.Review.IssueID)}
+	if err != nil || intent.Canonical != op.Intent || intent.Digest != op.IntentDigest || intent.OperationID != op.OperationID || intent.Kind != op.Kind || intent.ActorID != op.ActorID || intent.RepositoryID != op.RepositoryID || intent.AuthRevision != op.AuthRevision || intent.ExpectedNativeRevision != op.ExpectedNativeRevision || intent.NotAfter != op.NotAfter || !reflect.DeepEqual(scope, expectedScope) || r.Revision < 1 || r.Revision-1 != op.ExpectedNativeRevision || op.TokenID != 0 || op.CredentialFingerprint != "" {
+		return fenced(a, ReasonRecoveryUncertainEffect, "human reviewer request scope and intent differ")
+	}
+	if !op.Admitted && op.EffectState == nativeoperation_model.EffectPending && op.Receipt == "" && op.Completion == "" {
+		if _, err := nativeoperation_model.SetTerminal(ctx, op.InstallationID, op.OperationID, nativeoperation_model.TerminalOutcome{EffectState: nativeoperation_model.EffectNotCommitted, Reason: nativeoperation_model.ReasonRecoveredNoEffect, Cancellation: nativeoperation_model.CancellationNone}, ""); err != nil {
+			return RecoveryAssessment{}, err
+		}
+		return s.releaseRecovered(ctx, a, r, nativeoperation_model.EffectNotCommitted)
+	}
+	if !op.Admitted || op.EffectState != nativeoperation_model.EffectCommitted {
+		return fenced(a, ReasonRecoveryUncertainEffect, "human reviewer request has no atomic committed receipt")
+	}
+	var receipt sdk.HumanReviewRequestReceipt
+	if json.Unmarshal([]byte(op.Receipt), &receipt) != nil || !sdk.ValidHumanReviewRequestReceipt(receipt, q) {
+		return fenced(a, ReasonRecoveryUncertainEffect, "human reviewer request receipt differs from intent")
+	}
+	raw, err := json.Marshal(receipt)
+	if err != nil || string(raw) != op.Receipt {
+		return fenced(a, ReasonRecoveryUncertainEffect, "human reviewer request exact receipt encoding differs")
+	}
+	issue, err := issues_model.GetIssueByID(ctx, receipt.IssueID)
+	if err != nil || issue.RepoID != receipt.RepositoryID || issue.Index != receipt.Index || !issue.IsPull {
+		return fenced(a, ReasonRecoveryMissingEvidence, "human reviewer request parent differs")
+	}
+	if err := issue.LoadPullRequest(ctx); err != nil || issue.PullRequest == nil || issue.PullRequest.ID != receipt.PullID || issue.PullRequest.BaseRepoID != receipt.RepositoryID {
+		return fenced(a, ReasonRecoveryMissingEvidence, "human reviewer request pull identity differs")
+	}
+	if _, err := user_model.GetUserByID(ctx, receipt.ActorID); err != nil {
+		return fenced(a, ReasonRecoveryMissingEvidence, "human reviewer request original actor is missing")
+	}
+	if receipt.ReviewerKind == "user" {
+		_, err = user_model.GetUserByID(ctx, receipt.ReviewerID)
+	} else {
+		_, err = organization.GetTeamByID(ctx, receipt.ReviewerID)
+	}
+	if err != nil {
+		return fenced(a, ReasonRecoveryMissingEvidence, "human reviewer request subject is missing")
+	}
+	// Offline attribution retains original principals; current review permission
+	// and Git movement do not authorize any new work during recovery.
+	evidence, err := ReadHumanReviewRequestEvidence(ctx, receipt.IssueID, receipt.ReviewerKind, receipt.ReviewerID)
+	if err != nil || !reflect.DeepEqual(evidence, receipt.After) {
+		return fenced(a, ReasonRecoveryMissingEvidence, "human reviewer request selected post-state differs")
+	}
+	rows, err := humanReviewRequestHistory(ctx, receipt.IssueID, receipt.ReviewerKind, receipt.ReviewerID)
+	if err != nil {
+		return fenced(a, ReasonRecoveryMissingEvidence, "human reviewer request review history is missing")
+	}
+	digest, err := humanReviewRequestDigest(rows)
+	if err != nil || digest != receipt.ReviewsAfterDigest {
+		return fenced(a, ReasonRecoveryMissingEvidence, "human reviewer request complete review history differs")
+	}
+	digest, err = humanReviewRequestHistoryDigest(ctx, receipt, q.Requested)
+	if err != nil || digest != receipt.HistoryDigest {
+		return fenced(a, ReasonRecoveryMissingEvidence, "human reviewer request native change history differs")
+	}
+	if op.Completion == nativeoperation_model.CompletionComplete || op.Completion == nativeoperation_model.CompletionNeedsIntervention {
+		return s.releaseRecovered(ctx, a, r, nativeoperation_model.EffectCommitted)
+	}
+	if op.Completion != nativeoperation_model.CompletionPending && op.Completion != "" {
+		return fenced(a, ReasonRecoveryUncertainEffect, "human reviewer request completion differs")
+	}
+	completion := nativeoperation_model.CompletionComplete
+	if humanReviewRequestNeedsCompletion(receipt, q.Requested) {
+		completion = nativeoperation_model.CompletionNeedsIntervention
+	}
+	if _, err := nativeoperation_model.SetCompletionAndRelease(ctx, op.InstallationID, op.OperationID, r.Owner, r.Generation, completion); err != nil {
+		return RecoveryAssessment{}, err
+	}
+	a.Verdict, a.Effect = RecoveryReleased, nativeoperation_model.EffectCommitted
+	a.Checks = append(a.Checks, "atomic reviewer receipt and complete request/review/history post-state match; no primary or notification work replayed")
+	s.retireStaleCapabilities()
+	return *a, nil
+}
diff --git a/services/nativeoperation/human_review_request_snapshot.go b/services/nativeoperation/human_review_request_snapshot.go
new file mode 100644
index 0000000000000000000000000000000000000000..55f9a20f7c18496b793743e676412c9a3244cac1
--- /dev/null
+++ b/services/nativeoperation/human_review_request_snapshot.go
@@ -0,0 +1,85 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package nativeoperation
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"strconv"
+	"unicode/utf8"
+
+	sdk "forgejo.org/extension-sdk"
+	"forgejo.org/models/db"
+	issues_model "forgejo.org/models/issues"
+)
+
+var ErrHumanReviewRequestTooLarge = errors.New("complete selected review request set exceeds bounds")
+
+// Persisted columns only: native associations and later hydration never enter
+// the defining digest. This also lets the primary prove historical flag changes
+// without exposing completed or pending review prose.
+type humanReviewRequestRow struct {
+	ID, IssueID, ReviewerID, TeamID, OriginalAuthorID int64
+	Type                                              issues_model.ReviewType
+	Content, OriginalAuthor, CommitID                 string
+	Official, Stale, Dismissed                        bool
+	Created, Updated                                  int64
+}
+
+func humanReviewRequestStored(r *issues_model.Review) humanReviewRequestRow {
+	return humanReviewRequestRow{r.ID, r.IssueID, r.ReviewerID, r.ReviewerTeamID, r.OriginalAuthorID, r.Type, r.Content, r.OriginalAuthor, r.CommitID, r.Official, r.Stale, r.Dismissed, int64(r.CreatedUnix), int64(r.UpdatedUnix)}
+}
+
+func humanReviewRequestDigest(rows []humanReviewRequestRow) (string, error) {
+	raw, err := json.Marshal(rows)
+	if err != nil {
+		return "", err
+	}
+	sum := sha256.Sum256(raw)
+	return hex.EncodeToString(sum[:]), nil
+}
+
+// ReadHumanReviewRequestEvidence is shared by preparation and the conditional
+// native writer. Read only request rows: a selected human's private pending
+// review or prose from completed reviews is outside this evidence.
+func ReadHumanReviewRequestEvidence(ctx context.Context, issueID int64, kind string, reviewerID int64) (sdk.HumanReviewRequestEvidence, error) {
+	e := sdk.HumanReviewRequestEvidence{RequestIDs: []string{}}
+	if issueID <= 0 || reviewerID <= 0 || kind != "user" && kind != "team" {
+		return e, errors.New("invalid review request evidence scope")
+	}
+	query := db.GetEngine(ctx).Where("issue_id=? AND type=?", issueID, issues_model.ReviewTypeRequest)
+	if kind == "user" {
+		query = query.And("reviewer_id=? AND reviewer_team_id=0 AND original_author_id=0", reviewerID)
+	} else {
+		query = query.And("reviewer_team_id=?", reviewerID)
+	}
+	var reviews []*issues_model.Review
+	if err := query.Asc("id").Limit(sdk.MaxReviewRequestSnapshotRecords + 1).Find(&reviews); err != nil {
+		return e, err
+	}
+	if len(reviews) > sdk.MaxReviewRequestSnapshotRecords {
+		return e, ErrHumanReviewRequestTooLarge
+	}
+	// Serialize only persisted columns. Associated objects, future hydration and
+	// map iteration cannot change the digest. Exact strings and timestamps matter.
+	rows := make([]humanReviewRequestRow, 0, len(reviews))
+	total := 0
+	for _, r := range reviews {
+		if !utf8.ValidString(r.Content) || !utf8.ValidString(r.OriginalAuthor) || !utf8.ValidString(r.CommitID) {
+			return e, errors.New("invalid persisted review request text")
+		}
+		total += len(r.Content) + len(r.OriginalAuthor) + len(r.CommitID)
+		if total > sdk.MaxReviewRequestSnapshotBodyBytes {
+			return e, ErrHumanReviewRequestTooLarge
+		}
+		e.RequestIDs = append(e.RequestIDs, strconv.FormatInt(r.ID, 10))
+		rows = append(rows, humanReviewRequestStored(r))
+	}
+	digest, err := humanReviewRequestDigest(rows)
+	e.Digest = digest
+	return e, err
+}
diff --git a/services/nativeoperation/human_state.go b/services/nativeoperation/human_state.go
new file mode 100644
index 0000000000000000000000000000000000000000..e0656f0af93dd734e8287d6f61767c8c3cd5d723
--- /dev/null
+++ b/services/nativeoperation/human_state.go
@@ -0,0 +1,214 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package nativeoperation
+
+import (
+	"context"
+	"encoding/json" //nolint:depguard // Persisted native intent and receipt.
+	"errors"
+	"time"
+
+	sdk "forgejo.org/extension-sdk"
+	extensionauth_model "forgejo.org/models/extensionauth"
+	issues_model "forgejo.org/models/issues"
+	nativeoperation_model "forgejo.org/models/nativeoperation"
+	access_model "forgejo.org/models/perm/access"
+	repo_model "forgejo.org/models/repo"
+	"forgejo.org/models/unit"
+	user_model "forgejo.org/models/user"
+	execcontext "forgejo.org/modules/nativeoperation"
+	notify_service "forgejo.org/services/notify"
+
+	"github.com/google/uuid"
+)
+
+const CrashPointHumanStateBeforePrimary = "human-state-before-primary"
+const CrashPointHumanStateAfterPrimary = "human-state-after-primary"
+
+// HumanStateAdmission rechecks this exact request's current human/session,
+// installation and lifetime before replay/claim and inside primary SQL.
+type HumanStateAdmission func(context.Context) error
+
+var (
+	errHumanStateChanged      = errors.New("original state changed")
+	errHumanStateDependencies = errors.New("open native dependencies")
+)
+
+func humanStateIntent(q sdk.HumanStateRequest) (*ValidIntent, error) {
+	if !sdk.ValidHumanStateRequest(q) {
+		return nil, ErrInvalidIntent
+	}
+	intent := &ValidIntent{OperationID: q.OperationID, ActorID: nativeCommentID(q.Expected.ActorID), RepositoryID: nativeCommentID(q.Expected.RepositoryID), Kind: nativeoperation_model.KindHumanState, AuthRevision: sdk.HumanStateAuthorizationRevision, ExpectedNativeRevision: q.Expected.NativeRevision, NotAfter: q.NotAfter}
+	var err error
+	intent.Canonical, intent.Digest, err = sdk.CanonicalHumanStateIntent(q)
+	return intent, err
+}
+
+// SubmitHumanState uses live request admission, never background enrollment.
+// Its native state/history and operation receipt are one SQL primary effect.
+func (s *Service) SubmitHumanState(ctx context.Context, installation string, q sdk.HumanStateRequest, admit HumanStateAdmission) (sdk.OperationRecord, error) {
+	id, err := uuid.Parse(installation)
+	if err != nil || id.String() != installation || admit == nil {
+		return sdk.OperationRecord{}, ErrInvalidIntent
+	}
+	intent, err := humanStateIntent(q)
+	if err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	if err := ctx.Err(); err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	if admit(ctx) != nil {
+		return sdk.OperationRecord{}, ErrAuthorityLost
+	}
+	existing, err := nativeoperation_model.LookupOperation(ctx, installation, q.OperationID)
+	if err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	if existing != nil {
+		return s.reconcileExisting(existing, intent)
+	}
+	if q.NotAfter <= s.clock() || q.NotAfter > s.clock()+int64(MaxOperationLifetime/time.Second) {
+		return sdk.OperationRecord{}, ErrInvalidIntent
+	}
+	scope := Scope{Kind: nativeoperation_model.OwnerConditional, RepositoryID: intent.RepositoryID, IssueID: nativeCommentID(q.Expected.IssueID)}
+	return s.claimConditionalSubmit(ctx, extensionauth_model.SubmissionDecision{ActorID: intent.ActorID}, installation, intent, scope,
+		func(ctx context.Context, op *nativeoperation_model.Operation, _ *ValidIntent, execution *execcontext.Execution) (sdk.OperationRecord, terminalResult, error) {
+			return s.executeHumanState(ctx, op, q, admit, execution)
+		})
+}
+
+func humanStateParent(ctx context.Context, q sdk.HumanStateRequest, admit HumanStateAdmission) (*issues_model.Issue, *user_model.User, error) {
+	if ctx.Err() != nil || admit(ctx) != nil {
+		return nil, nil, ErrAuthorityLost
+	}
+	p := q.Expected
+	actor, err := user_model.GetUserByID(ctx, nativeCommentID(p.ActorID))
+	if err != nil || !actor.IsAccessAllowed(ctx) {
+		return nil, nil, ErrAuthorityLost
+	}
+	repo, err := repo_model.GetRepositoryByID(ctx, nativeCommentID(p.RepositoryID))
+	if err != nil || repo.IsArchived {
+		return nil, nil, ErrAuthorityLost
+	}
+	issue, err := issues_model.GetIssueByID(ctx, nativeCommentID(p.IssueID))
+	if err != nil || issue.RepoID != repo.ID || issue.Index != nativeCommentID(p.Index) || issue.IsPull != (p.Subject == "pull") {
+		return nil, nil, ErrAuthorityLost
+	}
+	if issue.IsPull {
+		if err := issue.LoadPullRequest(ctx); err != nil || issue.PullRequest == nil || issue.PullRequest.ID != nativeCommentID(p.SubjectID) {
+			return nil, nil, ErrAuthorityLost
+		}
+	}
+	if issue.IsPull && (issue.PullRequest.HasMerged != p.HasMerged || issue.PullRequest.HasMerged) {
+		return nil, nil, errHumanStateChanged
+	}
+	kind := unit.TypeIssues
+	if issue.IsPull {
+		kind = unit.TypePullRequests
+	}
+	permission, err := access_model.GetUserRepoPermission(ctx, repo, actor)
+	if err != nil || kind.UnitGlobalDisabled() || !repo.UnitEnabled(ctx, kind) || !permission.CanRead(kind) || (!issue.IsPoster(actor.ID) && !permission.CanWriteIssuesOrPulls(issue.IsPull)) || user_model.IsBlockedMultiple(ctx, []int64{repo.OwnerID, issue.PosterID}, actor.ID) {
+		return nil, nil, ErrAuthorityLost
+	}
+	if issue.IsClosed != p.IsClosed {
+		return nil, nil, errHumanStateChanged
+	}
+	if q.Close && repo.IsDependenciesEnabled(ctx) {
+		clear, err := issues_model.IssueNoDependenciesLeft(ctx, issue)
+		if err != nil {
+			return nil, nil, err
+		}
+		if !clear {
+			return nil, nil, errHumanStateDependencies
+		}
+	}
+	issue.Repo = repo
+	return issue, actor, nil
+}
+
+func (s *Service) executeHumanState(ctx context.Context, op *nativeoperation_model.Operation, q sdk.HumanStateRequest, admit HumanStateAdmission, execution *execcontext.Execution) (sdk.OperationRecord, terminalResult, error) {
+	owned, release := execcontext.NewContext(ctx, execution), context.WithoutCancel(ctx)
+	refuse := func(reason string) (sdk.OperationRecord, terminalResult, error) {
+		r, err := nativeoperation_model.SetTerminal(release, op.InstallationID, op.OperationID, nativeoperation_model.TerminalOutcome{EffectState: nativeoperation_model.EffectNotCommitted, Reason: reason, Cancellation: nativeoperation_model.CancellationNone}, execution.Owner)
+		if err != nil {
+			return sdk.OperationRecord{}, terminalResult{}, err
+		}
+		return ToRecord(r), terminalResult{}, nil
+	}
+	if err := TestCrashBarrier(CrashPointHumanStateBeforePrimary); err != nil {
+		return sdk.OperationRecord{}, terminalResult{}, err
+	}
+	var issue *issues_model.Issue
+	var actor *user_model.User
+	var comment *issues_model.Comment
+	committed, err := nativeoperation_model.CommitHumanStatePrimary(owned, op.InstallationID, op.OperationID, execution.Owner, s.clock(), func(tx context.Context) (string, error) {
+		var err error
+		issue, actor, err = humanStateParent(tx, q, admit)
+		if err != nil {
+			return "", err
+		}
+		if s.clock() >= op.NotAfter {
+			return "", nativeoperation_model.ErrOperationExpired
+		}
+		if tx.Err() != nil {
+			return "", ErrAuthorityLost
+		}
+		comment, err = issues_model.ChangeIssueStatus(tx, issue, actor, q.Close)
+		if err != nil {
+			return "", err
+		}
+		if comment == nil || comment.ID < 1 {
+			return "", errors.New("native state history missing")
+		}
+		if tx.Err() != nil {
+			return "", ErrAuthorityLost
+		}
+		raw, err := json.Marshal(sdk.HumanStateReceipt{RepositoryID: op.RepositoryID, ActorID: op.ActorID, Subject: q.Expected.Subject, SubjectID: nativeCommentID(q.Expected.SubjectID), IssueID: issue.ID, Index: issue.Index, IsClosed: issue.IsClosed, ClosedUnix: int64(issue.ClosedUnix), CommentID: comment.ID})
+		return string(raw), err
+	})
+	if err != nil {
+		switch {
+		case errors.Is(err, ErrAuthorityLost):
+			return refuse(nativeoperation_model.ReasonAuthorityLost)
+		case errors.Is(err, errHumanStateChanged), issues_model.IsErrIssueWasClosed(err), issues_model.IsErrPullWasClosed(err):
+			return refuse(nativeoperation_model.ReasonStaleConversation)
+		case errors.Is(err, errHumanStateDependencies), issues_model.IsErrDependenciesLeft(err):
+			return refuse(nativeoperation_model.ReasonNativeRefused)
+		case errors.Is(err, nativeoperation_model.ErrOperationExpired):
+			return refuse(nativeoperation_model.ReasonExpiredBeforeAdmission)
+		case errors.Is(err, nativeoperation_model.ErrAdmissionLost):
+			current, readErr := nativeoperation_model.LookupOperation(release, op.InstallationID, op.OperationID)
+			if readErr != nil {
+				return sdk.OperationRecord{}, terminalResult{}, readErr
+			}
+			if current != nil && current.Revoked {
+				return refuse(nativeoperation_model.ReasonCancelledBeforeAdmission)
+			}
+		}
+		return sdk.OperationRecord{}, terminalResult{}, err // Unknown SQL/commit results retain the fence.
+	}
+	if err := TestCrashBarrier(CrashPointHumanStateAfterPrimary); err != nil {
+		return sdk.OperationRecord{}, terminalResult{}, err
+	}
+	// Match native successful state completion after the atomic primary. Never
+	// replay partially finished stopwatch/notification work after a lost process.
+	completion := nativeoperation_model.CompletionComplete
+	if owned.Err() != nil {
+		completion = nativeoperation_model.CompletionNeedsIntervention
+	}
+	if completion == nativeoperation_model.CompletionComplete && q.Close {
+		if err := issues_model.FinishIssueStopwatchIfPossible(owned, actor, issue); err != nil {
+			completion = nativeoperation_model.CompletionNeedsIntervention
+		}
+	}
+	if completion == nativeoperation_model.CompletionComplete {
+		notify_service.IssueChangeStatus(owned, actor, "", issue, comment, q.Close)
+	}
+	r, err := nativeoperation_model.SetCompletionAndRelease(release, committed.InstallationID, committed.OperationID, execution.Owner, execution.Generation, completion)
+	if err != nil {
+		return sdk.OperationRecord{}, terminalResult{}, err
+	}
+	return ToRecord(r), terminalResult{}, nil
+}
diff --git a/services/nativeoperation/human_state_recovery.go b/services/nativeoperation/human_state_recovery.go
new file mode 100644
index 0000000000000000000000000000000000000000..d6b75a1520d5f11d8e1300545d5616474a2ce894
--- /dev/null
+++ b/services/nativeoperation/human_state_recovery.go
@@ -0,0 +1,74 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package nativeoperation
+
+import (
+	"context"
+	"encoding/json" //nolint:depguard // Persisted native intent and receipt.
+
+	sdk "forgejo.org/extension-sdk"
+	issues_model "forgejo.org/models/issues"
+	nativeoperation_model "forgejo.org/models/nativeoperation"
+)
+
+// Recovery attributes exact native state/history and never reapplies primary
+// or repeats uncertain stopwatch/notification completion.
+func (s *Service) recoverHumanState(ctx context.Context, a *RecoveryAssessment, r *nativeoperation_model.Reservation, scope Scope, op *nativeoperation_model.Operation) (RecoveryAssessment, error) {
+	var saved struct {
+		Payload sdk.HumanStateRequest `json:"payload"`
+	}
+	if json.Unmarshal([]byte(op.Intent), &saved) != nil {
+		return fenced(a, ReasonRecoveryMissingEvidence, "human state intent is missing")
+	}
+	q := saved.Payload
+	intent, err := humanStateIntent(q)
+	if err != nil || intent.Canonical != op.Intent || intent.Digest != op.IntentDigest || intent.ActorID != op.ActorID || intent.RepositoryID != op.RepositoryID || intent.OperationID != op.OperationID ||
+		scope.RepositoryID != op.RepositoryID || scope.IssueID != nativeCommentID(q.Expected.IssueID) || op.TokenID != 0 || op.CredentialFingerprint != "" ||
+		intent.AuthRevision != op.AuthRevision || intent.ExpectedNativeRevision != op.ExpectedNativeRevision || intent.NotAfter != op.NotAfter {
+		return fenced(a, ReasonRecoveryUncertainEffect, "human state scope and intent differ")
+	}
+	if !op.Admitted && op.EffectState == nativeoperation_model.EffectPending {
+		if _, err := nativeoperation_model.SetTerminal(ctx, op.InstallationID, op.OperationID, nativeoperation_model.TerminalOutcome{EffectState: nativeoperation_model.EffectNotCommitted, Reason: nativeoperation_model.ReasonRecoveredNoEffect, Cancellation: nativeoperation_model.CancellationNone}, ""); err != nil {
+			return RecoveryAssessment{}, err
+		}
+		return s.releaseRecovered(ctx, a, r, nativeoperation_model.EffectNotCommitted)
+	}
+	if !op.Admitted || op.EffectState != nativeoperation_model.EffectCommitted {
+		return fenced(a, ReasonRecoveryUncertainEffect, "human state has no atomic committed receipt")
+	}
+	var receipt sdk.HumanStateReceipt
+	if json.Unmarshal([]byte(op.Receipt), &receipt) != nil || !sdk.ValidHumanStateReceipt(receipt, q) {
+		return fenced(a, ReasonRecoveryUncertainEffect, "human state receipt differs from intent")
+	}
+	issue, err := issues_model.GetIssueByID(ctx, receipt.IssueID)
+	if err != nil || issue.RepoID != receipt.RepositoryID || issue.Index != receipt.Index || issue.IsPull != (receipt.Subject == "pull") || issue.IsClosed != receipt.IsClosed || int64(issue.ClosedUnix) != receipt.ClosedUnix {
+		return fenced(a, ReasonRecoveryMissingEvidence, "human state or parent differs")
+	}
+	if issue.IsPull {
+		if err := issue.LoadPullRequest(ctx); err != nil || issue.PullRequest == nil || issue.PullRequest.ID != receipt.SubjectID || issue.PullRequest.HasMerged {
+			return fenced(a, ReasonRecoveryUncertainEffect, "human state pull identity differs")
+		}
+	}
+	comment, err := issues_model.GetCommentByID(ctx, receipt.CommentID)
+	kind := issues_model.CommentTypeClose
+	if !q.Close {
+		kind = issues_model.CommentTypeReopen
+	}
+	if err != nil || comment.IssueID != issue.ID || comment.PosterID != op.ActorID || comment.Type != kind || comment.Content != "" || comment.OriginalAuthorID != 0 {
+		return fenced(a, ReasonRecoveryMissingEvidence, "human state native history differs")
+	}
+	if op.Completion == nativeoperation_model.CompletionComplete || op.Completion == nativeoperation_model.CompletionNeedsIntervention {
+		return s.releaseRecovered(ctx, a, r, nativeoperation_model.EffectCommitted)
+	}
+	if op.Completion != nativeoperation_model.CompletionPending && op.Completion != "" {
+		return fenced(a, ReasonRecoveryUncertainEffect, "human state completion differs")
+	}
+	if _, err := nativeoperation_model.SetCompletionAndRelease(ctx, op.InstallationID, op.OperationID, r.Owner, r.Generation, nativeoperation_model.CompletionNeedsIntervention); err != nil {
+		return RecoveryAssessment{}, err
+	}
+	a.Verdict, a.Effect = RecoveryReleased, nativeoperation_model.EffectCommitted
+	a.Checks = append(a.Checks, "atomic human state/history and receipt match; completion requires intervention")
+	s.retireStaleCapabilities()
+	return *a, nil
+}
diff --git a/services/nativeoperation/human_thread.go b/services/nativeoperation/human_thread.go
new file mode 100644
index 0000000000000000000000000000000000000000..39e419beba994ac8fa8b3f3c5a2e71dcc4833876
--- /dev/null
+++ b/services/nativeoperation/human_thread.go
@@ -0,0 +1,162 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package nativeoperation
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"time"
+
+	sdk "forgejo.org/extension-sdk"
+	extensionauth_model "forgejo.org/models/extensionauth"
+	issues_model "forgejo.org/models/issues"
+	nativeoperation_model "forgejo.org/models/nativeoperation"
+	execcontext "forgejo.org/modules/nativeoperation"
+
+	"github.com/google/uuid"
+)
+
+const CrashPointHumanThreadBeforePrimary = "human-thread-before-primary"
+const CrashPointHumanThreadAfterPrimary = "human-thread-after-primary"
+
+func humanThreadIntent(q sdk.HumanThreadRequest) (*ValidIntent, error) {
+	if !sdk.ValidHumanThreadRequest(q) {
+		return nil, ErrInvalidIntent
+	}
+	p := q.Expected.Review
+	intent := &ValidIntent{OperationID: q.OperationID, ActorID: nativeCommentID(p.ActorID), RepositoryID: nativeCommentID(p.RepositoryID), Kind: nativeoperation_model.KindHumanThread, AuthRevision: sdk.HumanThreadAuthorizationRevision, ExpectedNativeRevision: p.NativeRevision, NotAfter: q.NotAfter}
+	var err error
+	intent.Canonical, intent.Digest, err = sdk.CanonicalHumanThreadIntent(q)
+	return intent, err
+}
+
+// SubmitHumanThread uses current human request admission, never background
+// enrollment. Primary root state and exact before/after receipt commit together.
+// Replays and early cancellation use the existing installation-bound journal.
+func (s *Service) SubmitHumanThread(ctx context.Context, installation string, q sdk.HumanThreadRequest, admit HumanReviewAdmission) (sdk.OperationRecord, error) {
+	id, err := uuid.Parse(installation)
+	if err != nil || id.String() != installation || admit == nil {
+		return sdk.OperationRecord{}, ErrInvalidIntent
+	}
+	intent, err := humanThreadIntent(q)
+	if err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	if ctx.Err() != nil {
+		return sdk.OperationRecord{}, ctx.Err()
+	}
+	if admit(ctx) != nil {
+		return sdk.OperationRecord{}, ErrAuthorityLost
+	}
+	finish := func(r sdk.OperationRecord, err error) (sdk.OperationRecord, error) {
+		if err == nil || errors.Is(err, ErrCancelledBeforeSubmit) {
+			if ctx.Err() != nil || admit(ctx) != nil {
+				return sdk.OperationRecord{}, ErrAuthorityLost
+			}
+		}
+		return r, err
+	}
+	existing, err := nativeoperation_model.LookupOperation(ctx, installation, q.OperationID)
+	if err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	if existing != nil {
+		r, err := s.reconcileExisting(existing, intent)
+		return finish(r, err)
+	}
+	if q.NotAfter <= s.clock() || q.NotAfter > s.clock()+int64(MaxOperationLifetime/time.Second) {
+		return sdk.OperationRecord{}, ErrInvalidIntent
+	}
+	scope := Scope{Kind: nativeoperation_model.OwnerConditional, RepositoryID: intent.RepositoryID, IssueID: nativeCommentID(q.Expected.Review.IssueID)}
+	record, err := s.claimConditionalSubmit(ctx, extensionauth_model.SubmissionDecision{ActorID: intent.ActorID}, installation, intent, scope, func(ctx context.Context, op *nativeoperation_model.Operation, _ *ValidIntent, execution *execcontext.Execution) (sdk.OperationRecord, terminalResult, error) {
+		return s.executeHumanThread(ctx, op, q, admit, execution)
+	})
+	return finish(record, err)
+}
+
+func (s *Service) executeHumanThread(ctx context.Context, op *nativeoperation_model.Operation, q sdk.HumanThreadRequest, admit HumanReviewAdmission, execution *execcontext.Execution) (sdk.OperationRecord, terminalResult, error) {
+	owned, release := execcontext.NewContext(ctx, execution), context.WithoutCancel(ctx)
+	refuse := func(reason string) (sdk.OperationRecord, terminalResult, error) {
+		r, err := nativeoperation_model.SetTerminal(release, op.InstallationID, op.OperationID, nativeoperation_model.TerminalOutcome{EffectState: nativeoperation_model.EffectNotCommitted, Reason: reason, Cancellation: nativeoperation_model.CancellationNone}, execution.Owner)
+		if err != nil {
+			return sdk.OperationRecord{}, terminalResult{}, err
+		}
+		return ToRecord(r), terminalResult{}, nil
+	}
+	if err := TestCrashBarrier(CrashPointHumanThreadBeforePrimary); err != nil {
+		return sdk.OperationRecord{}, terminalResult{}, err
+	}
+	committed, err := nativeoperation_model.CommitHumanThreadPrimary(owned, op.InstallationID, op.OperationID, execution.Owner, s.clock(), func(tx context.Context) (string, error) {
+		gate := func(ctx context.Context) error {
+			if s.clock() >= op.NotAfter {
+				return nativeoperation_model.ErrOperationExpired
+			}
+			return admit(ctx)
+		}
+		result, err := ApplyPreparedHumanThread(tx, op.ActorID, q.Expected, q.Resolved, gate)
+		if err != nil {
+			return "", err
+		}
+		p := q.Expected.Review
+		receipt := sdk.HumanThreadReceipt{RepositoryID: op.RepositoryID, ActorID: op.ActorID, PullID: nativeCommentID(p.PullID), IssueID: nativeCommentID(p.IssueID), Index: nativeCommentID(p.Index), Before: result.Before, After: result.After, Changed: result.Changed}
+		if !sdk.ValidHumanThreadReceipt(receipt, q) {
+			return "", errors.New("native human thread receipt differs")
+		}
+		raw, err := json.Marshal(receipt)
+		if err != nil {
+			return "", err
+		}
+		if s.clock() >= op.NotAfter {
+			return "", nativeoperation_model.ErrOperationExpired
+		}
+		return string(raw), nil
+	})
+	if err != nil {
+		var deterministic issues_model.ErrExactReviewRefused
+		switch {
+		case errors.Is(err, ErrAuthorityLost):
+			return refuse(nativeoperation_model.ReasonAuthorityLost)
+		case errors.Is(err, nativeoperation_model.ErrOperationExpired):
+			return refuse(nativeoperation_model.ReasonExpiredBeforeAdmission)
+		case errors.Is(err, ErrHumanThreadMissing), errors.Is(err, ErrHumanThreadTarget), errors.Is(err, ErrHumanThreadChanged), errors.Is(err, ErrHumanThreadTooLarge):
+			return refuse(nativeoperation_model.ReasonStaleConversation)
+		case errors.As(err, &deterministic):
+			reason := nativeoperation_model.ReasonNativeRefused
+			switch deterministic.Reason {
+			case "head changed":
+				reason = nativeoperation_model.ReasonStaleHead
+			case "base changed", "merge base changed":
+				reason = nativeoperation_model.ReasonStaleBaseOrResult
+			case "human thread conversation changed":
+				reason = nativeoperation_model.ReasonStaleConversation
+			case "thread actor is inactive", "thread workflow unavailable", "thread actor cannot read pull request", "human thread permission lost":
+				reason = nativeoperation_model.ReasonAuthorityLost
+			case "human thread parent changed", "human thread pull changed":
+				reason = nativeoperation_model.ReasonPRMismatch
+			case "human thread primary evidence differs":
+				return sdk.OperationRecord{}, terminalResult{}, err // Unexpected SQL effects retain the fence after rollback.
+			}
+			return refuse(reason)
+		case errors.Is(err, nativeoperation_model.ErrAdmissionLost):
+			current, e := nativeoperation_model.LookupOperation(release, op.InstallationID, op.OperationID)
+			if e != nil {
+				return sdk.OperationRecord{}, terminalResult{}, e
+			}
+			if current != nil && current.Revoked {
+				return refuse(nativeoperation_model.ReasonCancelledBeforeAdmission)
+			}
+		}
+		return sdk.OperationRecord{}, terminalResult{}, err
+	}
+	if err := TestCrashBarrier(CrashPointHumanThreadAfterPrimary); err != nil {
+		return sdk.OperationRecord{}, terminalResult{}, err
+	}
+	// Native conversation marking has no notification/stopwatch work to replay.
+	r, err := nativeoperation_model.SetCompletionAndRelease(release, committed.InstallationID, committed.OperationID, execution.Owner, execution.Generation, nativeoperation_model.CompletionComplete)
+	if err != nil {
+		return sdk.OperationRecord{}, terminalResult{}, err
+	}
+	return ToRecord(r), terminalResult{}, nil
+}
diff --git a/services/nativeoperation/human_thread_primary.go b/services/nativeoperation/human_thread_primary.go
new file mode 100644
index 0000000000000000000000000000000000000000..ef334417471c471ab504918f1c0c296231a06624
--- /dev/null
+++ b/services/nativeoperation/human_thread_primary.go
@@ -0,0 +1,197 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package nativeoperation
+
+import (
+	"context"
+	"reflect"
+
+	sdk "forgejo.org/extension-sdk"
+	"forgejo.org/models/db"
+	issues_model "forgejo.org/models/issues"
+	access_model "forgejo.org/models/perm/access"
+	"forgejo.org/models/unit"
+	user_model "forgejo.org/models/user"
+	"forgejo.org/modules/git"
+)
+
+// PreparedHumanThreadResult is native primary evidence, not a journal receipt.
+// Resolving an already resolved root preserves its existing resolver. No-op
+// transitions retain exact evidence; unknown original context stays unknown.
+type PreparedHumanThreadResult struct {
+	Before  sdk.HumanThreadEvidence
+	After   sdk.HumanThreadEvidence
+	Changed bool
+}
+
+// ApplyPreparedHumanThread joins the caller's transaction and requires the exact
+// native owner of the captured revision. ActorID is the caller's trusted current
+// human, never selected from request JSON. Admit must recheck that same human,
+// request/installation and lifetime. This primary performs fresh Git/policy and
+// complete conversation proof, then native root-only MarkConversation SQL.
+// Caller-owned journal/receipt and primary can commit or roll back together.
+// It claims no owner, dispatches no notification and implements no replay.
+func ApplyPreparedHumanThread(ctx context.Context, actorID int64, want sdk.RepositoryThreadSnapshot, resolved bool, admit HumanReviewAdmission) (*PreparedHumanThreadResult, error) {
+	p := want.Review
+	refuse := func(reason string) (*PreparedHumanThreadResult, error) {
+		return nil, issues_model.ErrExactReviewRefused{Reason: reason}
+	}
+	if actorID <= 0 || actorID != nativeCommentID(p.ActorID) || admit == nil || !sdk.ValidRepositoryThreadSnapshot(&want, p.RepositoryID, p.ActorID, sdk.RepositoryThreadSnapshotRequest{Index: p.Index, ThreadID: want.Thread.RootCommentID}) {
+		return refuse("invalid human thread target")
+	}
+	action := want.UnresolveAction
+	if resolved {
+		action = want.ResolveAction
+	}
+	if action.State != "allowed" {
+		return refuse("human thread action was not admitted")
+	}
+	if err := requireHumanPrimaryOwner(ctx, p.NativeRevision); err != nil {
+		return nil, err
+	}
+	ctx, committer, err := db.TxContext(ctx)
+	if err != nil {
+		return nil, err
+	}
+	defer committer.Close()
+	if err := admitHumanPrimary(ctx, admit); err != nil {
+		return nil, err
+	}
+	actor, issue, err := loadHumanThreadPrimary(ctx, actorID, p)
+	if err != nil {
+		return nil, err
+	}
+	before, err := ReadHumanThreadEvidence(ctx, issue, actor, nativeCommentID(want.Thread.RootCommentID))
+	if err != nil {
+		return nil, err
+	}
+	if !reflect.DeepEqual(before, want.Thread) {
+		return refuse("human thread conversation changed")
+	}
+	nextResolver := int64(0)
+	if resolved {
+		nextResolver = nativeCommentID(before.ResolverID)
+		if !before.Resolved {
+			nextResolver = actorID
+		}
+	}
+	predicted, err := readHumanThreadEvidence(ctx, issue, actor, nativeCommentID(want.Thread.RootCommentID), &nextResolver)
+	if err != nil {
+		return nil, err
+	}
+	if err := admitHumanPrimary(ctx, admit); err != nil {
+		return nil, err
+	}
+	// Admission reads can span I/O. Repeat current policy/Git after them, before
+	// the native effect; native ownership orders every participating writer.
+	actor, issue, err = loadHumanThreadPrimary(ctx, actorID, p)
+	if err != nil {
+		return nil, err
+	}
+	fresh, err := ReadHumanThreadEvidence(ctx, issue, actor, nativeCommentID(want.Thread.RootCommentID))
+	if err != nil {
+		return nil, err
+	}
+	if !reflect.DeepEqual(fresh, before) {
+		return refuse("human thread conversation changed")
+	}
+	if err := requireHumanPrimaryOwner(ctx, p.NativeRevision); err != nil {
+		return nil, err
+	}
+	root, err := issues_model.GetCommentByID(ctx, nativeCommentID(want.Thread.RootCommentID))
+	if err != nil {
+		return nil, err
+	}
+	if err := issues_model.MarkConversation(ctx, root, actor, resolved); err != nil {
+		return nil, err
+	}
+	after, err := ReadHumanThreadEvidence(ctx, issue, actor, root.ID)
+	if err != nil {
+		return nil, err
+	}
+	if !reflect.DeepEqual(after, predicted) {
+		return refuse("human thread primary evidence differs")
+	}
+	if err := admitHumanPrimary(ctx, admit); err != nil {
+		return nil, err
+	}
+	if err := requireHumanPrimaryOwner(ctx, p.NativeRevision); err != nil {
+		return nil, err
+	}
+	if err := committer.Commit(); err != nil {
+		return nil, err
+	}
+	return &PreparedHumanThreadResult{Before: before, After: after, Changed: before.ResolverID != after.ResolverID}, nil
+}
+
+// Current native SQL and Git facts are observed under held ownership. Resolution
+// follows CanMarkConversation; it does not inherit review-event/self-review or
+// pending-draft adoption rules unrelated to changing a thread's resolution.
+func loadHumanThreadPrimary(ctx context.Context, actorID int64, p sdk.RepositoryReviewSnapshot) (*user_model.User, *issues_model.Issue, error) {
+	refuse := func(reason string) (*user_model.User, *issues_model.Issue, error) {
+		return nil, nil, issues_model.ErrExactReviewRefused{Reason: reason}
+	}
+	actor, err := user_model.GetUserByID(ctx, actorID)
+	if err != nil {
+		return nil, nil, err
+	}
+	if !actor.IsAccessAllowed(ctx) {
+		return refuse("thread actor is inactive")
+	}
+	issue, err := issues_model.GetIssueByID(ctx, nativeCommentID(p.IssueID))
+	if err != nil {
+		return nil, nil, err
+	}
+	if issue.RepoID != nativeCommentID(p.RepositoryID) || issue.Index != nativeCommentID(p.Index) || !issue.IsPull || issue.IsClosed != p.IsClosed || issue.IsPoster(actorID) != p.IsAuthor {
+		return refuse("human thread parent changed")
+	}
+	if err := issue.LoadPullRequest(ctx); err != nil {
+		return nil, nil, err
+	}
+	pr := issue.PullRequest
+	if pr == nil || pr.ID != nativeCommentID(p.PullID) || pr.IssueID != issue.ID || pr.BaseRepoID != issue.RepoID || pr.Index != issue.Index || pr.BaseBranch != p.BaseBranch || pr.HasMerged != p.HasMerged {
+		return refuse("human thread pull changed")
+	}
+	if err := issue.LoadRepo(ctx); err != nil {
+		return nil, nil, err
+	}
+	repo := issue.Repo
+	if repo.IsArchived || !repo.AllowsPulls(ctx) {
+		return refuse("thread workflow unavailable")
+	}
+	permission, err := access_model.GetUserRepoPermission(ctx, repo, actor)
+	if err != nil {
+		return nil, nil, err
+	}
+	for _, kind := range []unit.Type{unit.TypeCode, unit.TypePullRequests} {
+		if kind.UnitGlobalDisabled() || !repo.UnitEnabled(ctx, kind) || !permission.CanRead(kind) {
+			return refuse("thread actor cannot read pull request")
+		}
+	}
+	allowed, err := issues_model.CanMarkConversation(ctx, issue, actor)
+	if err != nil {
+		return nil, nil, err
+	}
+	if !allowed {
+		return refuse("human thread permission lost")
+	}
+	native, err := git.OpenRepository(ctx, repo.RepoPath())
+	if err != nil {
+		return nil, nil, err
+	}
+	defer native.Close()
+	head, err := native.GetRefCommitID(pr.GetGitRefName())
+	if err != nil || head != p.HeadOID {
+		return refuse("head changed")
+	}
+	base, err := native.GetRefCommitID(git.BranchPrefix + p.BaseBranch)
+	if err != nil || base != p.BaseOID {
+		return refuse("base changed")
+	}
+	mergeBase, err := native.GetMergeBaseSimple(base, head)
+	if err != nil || mergeBase != p.MergeBaseOID {
+		return refuse("merge base changed")
+	}
+	return actor, issue, nil
+}
diff --git a/services/nativeoperation/human_thread_recovery.go b/services/nativeoperation/human_thread_recovery.go
new file mode 100644
index 0000000000000000000000000000000000000000..931a31b177f7569d8cd56ac5e074cfeb73e51c5d
--- /dev/null
+++ b/services/nativeoperation/human_thread_recovery.go
@@ -0,0 +1,79 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package nativeoperation
+
+import (
+	"context"
+	"encoding/json"
+	"reflect"
+
+	sdk "forgejo.org/extension-sdk"
+	issues_model "forgejo.org/models/issues"
+	nativeoperation_model "forgejo.org/models/nativeoperation"
+	user_model "forgejo.org/models/user"
+)
+
+// Recovery proves SQL state under the stopped owner's intact fence. It neither
+// calls MarkConversation nor reconstructs/replays a human operation from today.
+func (s *Service) recoverHumanThread(ctx context.Context, a *RecoveryAssessment, r *nativeoperation_model.Reservation, scope Scope, op *nativeoperation_model.Operation) (RecoveryAssessment, error) {
+	var saved struct {
+		Payload sdk.HumanThreadRequest `json:"payload"`
+	}
+	if json.Unmarshal([]byte(op.Intent), &saved) != nil {
+		return fenced(a, ReasonRecoveryMissingEvidence, "human thread intent is missing")
+	}
+	q := saved.Payload
+	intent, err := humanThreadIntent(q)
+	expectedScope := Scope{Kind: nativeoperation_model.OwnerConditional, RepositoryID: op.RepositoryID, IssueID: nativeCommentID(q.Expected.Review.IssueID)}
+	if err != nil || intent.Canonical != op.Intent || intent.Digest != op.IntentDigest || intent.OperationID != op.OperationID || intent.ActorID != op.ActorID || intent.RepositoryID != op.RepositoryID || intent.AuthRevision != op.AuthRevision || intent.ExpectedNativeRevision != op.ExpectedNativeRevision || intent.NotAfter != op.NotAfter || !reflect.DeepEqual(scope, expectedScope) || r.Revision < 1 || r.Revision-1 != op.ExpectedNativeRevision || op.TokenID != 0 || op.CredentialFingerprint != "" {
+		return fenced(a, ReasonRecoveryUncertainEffect, "human thread scope and intent differ")
+	}
+	if !op.Admitted && op.EffectState == nativeoperation_model.EffectPending && op.Receipt == "" && op.Completion == "" {
+		if _, err := nativeoperation_model.SetTerminal(ctx, op.InstallationID, op.OperationID, nativeoperation_model.TerminalOutcome{EffectState: nativeoperation_model.EffectNotCommitted, Reason: nativeoperation_model.ReasonRecoveredNoEffect, Cancellation: nativeoperation_model.CancellationNone}, ""); err != nil {
+			return RecoveryAssessment{}, err
+		}
+		return s.releaseRecovered(ctx, a, r, nativeoperation_model.EffectNotCommitted)
+	}
+	if !op.Admitted || op.EffectState != nativeoperation_model.EffectCommitted {
+		return fenced(a, ReasonRecoveryUncertainEffect, "human thread has no atomic committed receipt")
+	}
+	var receipt sdk.HumanThreadReceipt
+	if json.Unmarshal([]byte(op.Receipt), &receipt) != nil || !sdk.ValidHumanThreadReceipt(receipt, q) {
+		return fenced(a, ReasonRecoveryUncertainEffect, "human thread receipt differs from intent")
+	}
+	canonicalReceipt, err := json.Marshal(receipt)
+	if err != nil || string(canonicalReceipt) != op.Receipt {
+		return fenced(a, ReasonRecoveryUncertainEffect, "human thread exact receipt encoding differs")
+	}
+	issue, err := issues_model.GetIssueByID(ctx, receipt.IssueID)
+	if err != nil || issue.RepoID != receipt.RepositoryID || issue.Index != receipt.Index || !issue.IsPull {
+		return fenced(a, ReasonRecoveryMissingEvidence, "human thread parent differs")
+	}
+	if err := issue.LoadPullRequest(ctx); err != nil || issue.PullRequest == nil || issue.PullRequest.ID != receipt.PullID || issue.PullRequest.BaseRepoID != receipt.RepositoryID {
+		return fenced(a, ReasonRecoveryMissingEvidence, "human thread pull identity differs")
+	}
+	actor, err := user_model.GetUserByID(ctx, receipt.ActorID)
+	if err != nil {
+		return fenced(a, ReasonRecoveryMissingEvidence, "human thread original actor is missing")
+	}
+	// This is offline attribution, not fresh permission. A retained principal can
+	// prove an original own draft even if current repository permission was lost.
+	evidence, err := ReadHumanThreadEvidence(ctx, issue, actor, nativeCommentID(receipt.After.RootCommentID))
+	if err != nil || !reflect.DeepEqual(evidence, receipt.After) {
+		return fenced(a, ReasonRecoveryMissingEvidence, "human thread complete post-state differs")
+	}
+	if op.Completion == nativeoperation_model.CompletionComplete {
+		return s.releaseRecovered(ctx, a, r, nativeoperation_model.EffectCommitted)
+	}
+	if op.Completion != nativeoperation_model.CompletionPending && op.Completion != "" {
+		return fenced(a, ReasonRecoveryUncertainEffect, "human thread completion differs")
+	}
+	if _, err := nativeoperation_model.SetCompletionAndRelease(ctx, op.InstallationID, op.OperationID, r.Owner, r.Generation, nativeoperation_model.CompletionComplete); err != nil {
+		return RecoveryAssessment{}, err
+	}
+	a.Verdict, a.Effect = RecoveryReleased, nativeoperation_model.EffectCommitted
+	a.Checks = append(a.Checks, "atomic human thread receipt and complete SQL post-state match; no primary or completion work replayed")
+	s.retireStaleCapabilities()
+	return *a, nil
+}
diff --git a/services/nativeoperation/human_thread_snapshot.go b/services/nativeoperation/human_thread_snapshot.go
new file mode 100644
index 0000000000000000000000000000000000000000..0216d301aead915624d0a4218e3707f9147172ee
--- /dev/null
+++ b/services/nativeoperation/human_thread_snapshot.go
@@ -0,0 +1,136 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package nativeoperation
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"strconv"
+	"strings"
+	"unicode/utf8"
+
+	sdk "forgejo.org/extension-sdk"
+	"forgejo.org/models/db"
+	issues_model "forgejo.org/models/issues"
+	user_model "forgejo.org/models/user"
+)
+
+var (
+	ErrHumanThreadMissing  = errors.New("human thread is not visible")
+	ErrHumanThreadTarget   = errors.New("human thread requires an exact valid root")
+	ErrHumanThreadChanged  = errors.New("human thread changed during preparation")
+	ErrHumanThreadTooLarge = errors.New("complete human thread exceeds preparation bounds")
+)
+
+// ReadHumanThreadEvidence observes a complete bounded conversation through the
+// defining native grouping. Callers own current read/mutation admission and Git
+// proofs. It starts no transaction, claims no owner and changes no native rows.
+// Conditional writers may repeat this same proof under their held owner.
+func ReadHumanThreadEvidence(ctx context.Context, issue *issues_model.Issue, user *user_model.User, rootID int64) (sdk.HumanThreadEvidence, error) {
+	return readHumanThreadEvidence(ctx, issue, user, rootID, nil)
+}
+
+// The internal resolver override predicts exactly one root-only SQL transition
+// from complete live evidence, without changing any native row.
+func readHumanThreadEvidence(ctx context.Context, issue *issues_model.Issue, user *user_model.User, rootID int64, resolverOverride *int64) (sdk.HumanThreadEvidence, error) {
+	var empty sdk.HumanThreadEvidence
+	if issue == nil || !issue.IsPull || user == nil || rootID <= 0 {
+		return empty, ErrHumanThreadTarget
+	}
+	var rows issues_model.CommentList
+	err := db.GetEngine(ctx).Where("issue_id=? AND type=?", issue.ID, issues_model.CommentTypeCode).
+		Cols("id", "type", "issue_id", "review_id", "poster_id", "tree_path", "line", "created_unix", "updated_unix", "content_version", "resolve_doer_id", "invalidated", "commit_sha", "original_anchor").
+		Asc("created_unix").Asc("id").Limit(10001).Find(&rows)
+	if err != nil {
+		return empty, err
+	}
+	if len(rows) > 10000 {
+		return empty, ErrHumanThreadTooLarge
+	}
+	thread := issues_model.FindCodeThread(issues_model.GroupCodeThreads(rows), rootID)
+	if len(thread) == 0 {
+		return empty, ErrHumanThreadMissing
+	}
+	root := thread.Root()
+	// Check visibility before reporting whether the supplied comment was a reply.
+	review, err := issues_model.GetReviewByID(ctx, root.ReviewID)
+	if err != nil {
+		return empty, err
+	}
+	if review.IssueID != issue.ID || review.Type == issues_model.ReviewTypePending && review.ReviewerID != user.ID {
+		return empty, ErrHumanThreadMissing
+	}
+	if root.ID != rootID {
+		return empty, ErrHumanThreadTarget
+	}
+	if len(thread) > sdk.MaxThreadSnapshotMembers {
+		return empty, ErrHumanThreadTooLarge
+	}
+	if root.TreePath == "" || len(root.TreePath) > 4096 || !utf8.ValidString(root.TreePath) || strings.ContainsRune(root.TreePath, 0) || root.Line < -9007199254740991 || root.Line > 9007199254740991 {
+		return empty, ErrHumanThreadTarget
+	}
+	side, line := "", int64(0)
+	if root.Line < 0 {
+		side, line = "old", -root.Line
+	} else if root.Line > 0 {
+		side, line = "new", root.Line
+	}
+	location := sdk.RenderThreadLocation(root.TreePath, side, line)
+	// Exact metadata complements the shared conversation digest, which encodes
+	// boolean resolver state rather than the native resolver's identity.
+	type evidenceMember struct {
+		ID, IssueID, ReviewID, PosterID, Type, Line, Version, Resolver, Created, Updated, OriginalAuthorID int64
+		Path, Commit, PatchDigest, OriginalAuthorDigest                                                    string
+		Invalidated                                                                                        bool
+		OriginalAnchor                                                                                     *sdk.RepositoryInlineAnchor
+	}
+	facts := make([]evidenceMember, 0, len(thread))
+	lines := make([]string, 0, len(thread))
+	total := 0
+	for _, meta := range thread {
+		c, err := issues_model.GetCommentByID(ctx, meta.ID)
+		if err != nil {
+			return empty, ErrHumanThreadChanged
+		}
+		if c.ID != meta.ID || c.Type != meta.Type || c.IssueID != meta.IssueID || c.ReviewID != meta.ReviewID || c.PosterID != meta.PosterID || c.TreePath != meta.TreePath || c.Line != meta.Line || c.CreatedUnix != meta.CreatedUnix || c.UpdatedUnix != meta.UpdatedUnix || c.ContentVersion != meta.ContentVersion || c.ResolveDoerID != meta.ResolveDoerID || c.Invalidated != meta.Invalidated || c.CommitSHA != meta.CommitSHA || !c.OriginalAnchor.Equal(meta.OriginalAnchor) {
+			return empty, ErrHumanThreadChanged
+		}
+		if c.OriginalAnchor != nil && c.OriginalAnchor.Validate() != nil || !utf8.ValidString(c.Content) || strings.ContainsRune(c.Content, 0) {
+			return empty, ErrHumanThreadTarget
+		}
+		total += len(c.Content) + len(c.Patch)
+		if total > sdk.MaxThreadSnapshotBodyBytes {
+			return empty, ErrHumanThreadTooLarge
+		}
+		if c.ID == rootID && resolverOverride != nil {
+			c.ResolveDoerID = *resolverOverride
+		}
+		anchor := threadOriginalAnchor(c.OriginalAnchor)
+		lines = append(lines, sdk.ResolveConversationLine(sdk.ResolveConversationMember{OriginalAnchor: anchor, ID: c.ID, Body: c.Content, ContentVer: int64(c.ContentVersion), Location: location, ResolverState: sdk.ThreadResolverState(c.ResolveDoerID)}))
+		facts = append(facts, evidenceMember{ID: c.ID, IssueID: c.IssueID, ReviewID: c.ReviewID, PosterID: c.PosterID, Type: int64(c.Type), Line: c.Line, Version: int64(c.ContentVersion), Resolver: c.ResolveDoerID, Created: int64(c.CreatedUnix), Updated: int64(c.UpdatedUnix), Path: c.TreePath, Commit: c.CommitSHA, Invalidated: c.Invalidated, OriginalAnchor: anchor, OriginalAuthorID: c.OriginalAuthorID, PatchDigest: sdk.HumanReviewBodyDigest(c.Patch), OriginalAuthorDigest: sdk.HumanReviewBodyDigest(c.OriginalAuthor)})
+	}
+	digest, err := sdk.ResolveConversationDigest(lines)
+	if err != nil {
+		return empty, err
+	}
+	raw, err := json.Marshal(struct {
+		ReviewID, ReviewerID, ReviewerTeamID, OriginalAuthorID, ReviewType, Created, Updated int64
+		ReviewDigest, OriginalAuthorDigest, Commit                                           string
+		Official, Stale, Dismissed                                                           bool
+		Members                                                                              []evidenceMember
+	}{review.ID, review.ReviewerID, review.ReviewerTeamID, review.OriginalAuthorID, int64(review.Type), int64(review.CreatedUnix), int64(review.UpdatedUnix), sdk.HumanReviewBodyDigest(review.Content), sdk.HumanReviewBodyDigest(review.OriginalAuthor), review.CommitID, review.Official, review.Stale, review.Dismissed, facts})
+	if err != nil {
+		return empty, err
+	}
+	resolverID := root.ResolveDoerID
+	if resolverOverride != nil {
+		resolverID = *resolverOverride
+	}
+	resolver := ""
+	if resolverID != 0 {
+		resolver = strconv.FormatInt(resolverID, 10)
+	}
+	return sdk.HumanThreadEvidence{RootCommentID: strconv.FormatInt(root.ID, 10), ReviewID: strconv.FormatInt(root.ReviewID, 10), OriginalAnchor: threadOriginalAnchor(root.OriginalAnchor), ConversationDigest: digest, EvidenceDigest: sdk.HumanReviewBodyDigest(string(raw)), MemberCount: len(thread), ResolverID: resolver, Resolved: resolver != ""}, nil
+}
diff --git a/services/nativeoperation/issue_intake.go b/services/nativeoperation/issue_intake.go
new file mode 100644
index 0000000000000000000000000000000000000000..f8fd850b86aa7c038dc918862b6b230463adc583
--- /dev/null
+++ b/services/nativeoperation/issue_intake.go
@@ -0,0 +1,243 @@
+package nativeoperation
+
+import (
+	"context"
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json" //nolint:depguard
+	"errors"
+	"strconv"
+	"strings"
+	"time"
+
+	sdk "forgejo.org/extension-sdk"
+	extensionauth "forgejo.org/models/extensionauth"
+	issues_model "forgejo.org/models/issues"
+	nativeoperation_model "forgejo.org/models/nativeoperation"
+	access_model "forgejo.org/models/perm/access"
+	repo_model "forgejo.org/models/repo"
+	"forgejo.org/models/unit"
+	user_model "forgejo.org/models/user"
+	"forgejo.org/modules/setting"
+)
+
+func intakeSignature(claims sdk.IssueIntakeClaims) string {
+	raw, _ := json.Marshal(claims)
+	mac := hmac.New(sha256.New, []byte(setting.SecretKey))
+	_, _ = mac.Write([]byte("native-issue-intake-v1\x00"))
+	_, _ = mac.Write(raw)
+	return hex.EncodeToString(mac.Sum(nil))
+}
+
+func checkIntakeAuthority(ctx context.Context, claims sdk.IssueIntakeClaims, now int64) error {
+	if setting.SecretKey == "" || claims.Installation == "" || claims.Expires <= now || !sdk.ValidIssueIntakeRequest(sdk.IssueIntakeAuthorizationRequest{Source: claims.Source, Revision: claims.Revision, Digest: claims.Digest}) {
+		return ErrAuthorityLost
+	}
+	actorID, err := strconv.ParseInt(claims.Actor, 10, 64)
+	if err != nil || actorID <= 0 {
+		return ErrAuthorityLost
+	}
+	repositoryID, err := strconv.ParseInt(claims.Repository, 10, 64)
+	if err != nil || repositoryID <= 0 {
+		return ErrAuthorityLost
+	}
+	actor, err := user_model.GetUserByID(ctx, actorID)
+	if err != nil || !actor.IsActive || actor.ProhibitLogin {
+		return ErrAuthorityLost
+	}
+	repository, err := repo_model.GetRepositoryByID(ctx, repositoryID)
+	if err != nil || repository.IsArchived || repository.IsMirror || user_model.IsBlocked(ctx, repository.OwnerID, actor.ID) {
+		return ErrAuthorityLost
+	}
+	permission, err := access_model.GetUserRepoPermission(ctx, repository, actor)
+	if err != nil || !permission.CanWrite(unit.TypeIssues) || !permission.CanWrite(unit.TypeCode) {
+		return ErrAuthorityLost
+	}
+	return nil
+}
+
+// MintIssueIntakeGrant is called only after a live native POST admission has
+// resolved its human, repository and installation. A retained grant authorizes
+// 16 issue slots and 32 conditional refinements, never execution or Git writes.
+func MintIssueIntakeGrant(ctx context.Context, claims sdk.IssueIntakeClaims) (sdk.IssueIntakeGrant, error) {
+	claims.Expires = time.Now().Add(time.Hour).Unix()
+	if err := checkIntakeAuthority(ctx, claims, time.Now().Unix()); err != nil {
+		return sdk.IssueIntakeGrant{}, err
+	}
+	raw, _ := json.Marshal(claims)
+	return sdk.IssueIntakeGrant{Claims: claims, Token: base64.RawURLEncoding.EncodeToString(raw) + "." + intakeSignature(claims)}, nil
+}
+
+func verifiedIntakeClaims(ctx context.Context, installation, token string, now int64) (sdk.IssueIntakeClaims, error) {
+	var claims sdk.IssueIntakeClaims
+	encoded, signature, ok := strings.Cut(token, ".")
+	if !ok || len(token) > 4096 {
+		return claims, ErrAuthorityLost
+	}
+	raw, err := base64.RawURLEncoding.DecodeString(encoded)
+	if err != nil || json.Unmarshal(raw, &claims) != nil || claims.Installation != installation || !hmac.Equal([]byte(signature), []byte(intakeSignature(claims))) {
+		return claims, ErrAuthorityLost
+	}
+	return claims, checkIntakeAuthority(ctx, claims, now)
+}
+
+func intakeOperationID(claims sdk.IssueIntakeClaims, action string, slot, step int) string {
+	raw := claims.Source + ":" + strconv.FormatInt(claims.Revision, 10) + ":" + action + ":"
+	if action == "create" {
+		raw += strconv.Itoa(slot)
+	} else {
+		raw += strconv.Itoa(step)
+	}
+	sum := sha256.Sum256([]byte(raw))
+	return "issue-intake-" + hex.EncodeToString(sum[:16])
+}
+
+func intakeAttemptID(base string, attempt int) string {
+	if attempt == 0 {
+		return base
+	}
+	return base + ".a" + strconv.Itoa(attempt)
+}
+
+func committedIntakeCreation(ctx context.Context, installation string, claims sdk.IssueIntakeClaims, slot int) (*nativeoperation_model.Operation, error) {
+	for attempt := 0; attempt < 6; attempt++ {
+		op, err := nativeoperation_model.LookupOperation(ctx, installation, intakeAttemptID(intakeOperationID(claims, "create", slot, 0), attempt))
+		if err != nil {
+			return nil, err
+		}
+		if op == nil {
+			return nil, ErrInvalidIntent
+		}
+		if op.EffectState == sdk.EffectCommitted {
+			return op, nil
+		}
+		if op.EffectState != sdk.EffectNotCommitted {
+			return nil, ErrBusy
+		}
+	}
+	return nil, ErrInvalidIntent
+}
+
+func storedIntakeGraph(op *nativeoperation_model.Operation) (sdk.IssueGraphPayload, error) {
+	var envelope struct {
+		Payload sdk.IssueGraphPayload `json:"payload"`
+	}
+	if json.Unmarshal([]byte(op.Intent), &envelope) != nil || envelope.Payload.Intake == nil {
+		return sdk.IssueGraphPayload{}, ErrInvalidIntent
+	}
+	return envelope.Payload, nil
+}
+
+func intakeReceipt(record sdk.OperationRecord, request sdk.IssueIntakeMutation) (sdk.IssueIntakeReceipt, error) {
+	if record.EffectState != sdk.EffectCommitted {
+		return sdk.IssueIntakeReceipt{}, errors.New("native issue intake did not commit: " + record.ReasonCode)
+	}
+	var receipt sdk.IssueGraphReceipt
+	if json.Unmarshal(record.Receipt, &receipt) != nil || len(receipt.Issues) != 1 {
+		return sdk.IssueIntakeReceipt{}, ErrInvalidIntent
+	}
+	issue := receipt.Issues[0]
+	digest := sha256.Sum256([]byte(request.Body))
+	return sdk.IssueIntakeReceipt{Index: issue.IssueIndex, IssueID: issue.IssueID, Slot: request.Slot, Title: request.Title, BodyDigest: hex.EncodeToString(digest[:])}, nil
+}
+
+// SubmitIssueIntake executes the same native conditional issue transaction as
+// graph writes, with a narrower live-session grant instead of a Factory PAT.
+func (s *Service) SubmitIssueIntake(ctx context.Context, installation string, request sdk.IssueIntakeMutation) (sdk.IssueIntakeReceipt, error) {
+	if !sdk.ValidIssueIntakeMutation(request) {
+		return sdk.IssueIntakeReceipt{}, ErrInvalidIntent
+	}
+	claims, err := verifiedIntakeClaims(ctx, installation, request.Grant, s.clock())
+	if err != nil {
+		return sdk.IssueIntakeReceipt{}, err
+	}
+	request.Grant = ""
+	raw, _ := json.Marshal(request)
+	sum := sha256.Sum256(raw)
+	requestHash := hex.EncodeToString(sum[:])
+	base := intakeOperationID(claims, request.Action, request.Slot, request.Step)
+	opID := ""
+	for attempt := 0; attempt < 6; attempt++ {
+		candidate := intakeAttemptID(base, attempt)
+		existing, err := nativeoperation_model.LookupOperation(ctx, installation, candidate)
+		if err != nil {
+			return sdk.IssueIntakeReceipt{}, err
+		}
+		if existing == nil {
+			opID = candidate
+			break
+		}
+		graph, err := storedIntakeGraph(existing)
+		if err != nil || graph.Intake.RequestHash != requestHash || graph.Intake.Claims.Source != claims.Source || graph.Intake.Claims.Revision != claims.Revision || graph.Intake.Claims.Digest != claims.Digest || graph.Intake.Claims.Actor != claims.Actor || graph.Intake.Claims.Repository != claims.Repository {
+			return sdk.IssueIntakeReceipt{}, ErrInvalidIntent
+		}
+		if existing.EffectState == sdk.EffectCommitted {
+			return intakeReceipt(ToRecord(existing), request)
+		}
+		if existing.EffectState != sdk.EffectNotCommitted {
+			return sdk.IssueIntakeReceipt{}, ErrBusy
+		}
+	}
+	if opID == "" {
+		return sdk.IssueIntakeReceipt{}, errors.New("native issue intake attempts exhausted")
+	}
+	graph := sdk.IssueGraphPayload{Intake: &sdk.IssueIntakeAuthorization{Claims: claims, RequestHash: requestHash, Slot: request.Slot, Step: request.Step}}
+	if request.Action == "create" {
+		graph.Creates = []sdk.IssueGraphCreate{{Key: strconv.Itoa(request.Slot), Title: request.Title, Body: request.Body}}
+	} else {
+		creation, err := committedIntakeCreation(ctx, installation, claims, request.Slot)
+		if err != nil {
+			return sdk.IssueIntakeReceipt{}, ErrInvalidIntent
+		}
+		createdGraph, err := storedIntakeGraph(creation)
+		if err != nil || createdGraph.Intake.Claims.Actor != claims.Actor || createdGraph.Intake.Claims.Repository != claims.Repository || createdGraph.Intake.Claims.Digest != claims.Digest {
+			return sdk.IssueIntakeReceipt{}, ErrAuthorityLost
+		}
+		var receipt sdk.IssueGraphReceipt
+		if json.Unmarshal([]byte(creation.Receipt), &receipt) != nil || len(receipt.Issues) != 1 {
+			return sdk.IssueIntakeReceipt{}, ErrInvalidIntent
+		}
+		issue, err := issues_model.GetIssueByID(ctx, receipt.Issues[0].IssueID)
+		if err != nil || issue.IsClosed || issue.IsPull || issue.RepoID != creation.RepositoryID {
+			return sdk.IssueIntakeReceipt{}, ErrInvalidIntent
+		}
+		digest := sha256.Sum256([]byte(issue.Content))
+		if issue.Title != request.ExpectedTitle || hex.EncodeToString(digest[:]) != request.ExpectedBodyDigest {
+			return sdk.IssueIntakeReceipt{}, errors.New("issue changed since intake; preserving current content")
+		}
+		graph.Edits = []sdk.IssueGraphEdit{{IssueID: issue.ID, ExpectedTitle: issue.Title, ExpectedBody: issue.Content, ExpectedContentVersion: issue.ContentVersion, Title: request.Title, Body: request.Body}}
+	}
+	observation, err := s.ReadNativeRevision(ctx)
+	if err != nil {
+		return sdk.IssueIntakeReceipt{}, err
+	}
+	if !observation.Idle {
+		return sdk.IssueIntakeReceipt{}, ErrBusy
+	}
+	payload, _ := json.Marshal(graph)
+	actor, _ := strconv.ParseInt(claims.Actor, 10, 64)
+	repository, _ := strconv.ParseInt(claims.Repository, 10, 64)
+	intent, err := ValidateIntent(opID, actor, repository, nativeoperation_model.KindIssueGraph, "issue-intake/"+claims.Source+"/"+strconv.FormatInt(claims.Revision, 10), observation.Revision, min(claims.Expires, s.clock()+300), payload, s.clock())
+	if err != nil {
+		return sdk.IssueIntakeReceipt{}, err
+	}
+	record, err := s.Submit(ctx, extensionauth.SubmissionDecision{ActorID: actor, CredentialFingerprint: intakeSignature(claims)}, installation, intent)
+	if err != nil {
+		return sdk.IssueIntakeReceipt{}, err
+	}
+	return intakeReceipt(record, request)
+}
+
+func (s *Service) revalidateIssueIntake(ctx context.Context, op *nativeoperation_model.Operation) error {
+	graph, err := storedIntakeGraph(op)
+	if err != nil {
+		return ErrAuthorityLost
+	}
+	claims := graph.Intake.Claims
+	if claims.Installation != op.InstallationID || claims.Actor != strconv.FormatInt(op.ActorID, 10) || claims.Repository != strconv.FormatInt(op.RepositoryID, 10) || !hmac.Equal([]byte(op.CredentialFingerprint), []byte(intakeSignature(claims))) {
+		return ErrAuthorityLost
+	}
+	return checkIntakeAuthority(ctx, claims, s.clock())
+}
diff --git a/services/pull/merge_metadata.go b/services/pull/merge_metadata.go
new file mode 100644
index 0000000000000000000000000000000000000000..b73bee5cdeb191f55bb969a03819050b949d6b1f
--- /dev/null
+++ b/services/pull/merge_metadata.go
@@ -0,0 +1,61 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package pull
+
+import (
+	"context"
+	"errors"
+
+	"forgejo.org/models/db"
+	issues_model "forgejo.org/models/issues"
+	nativeoperation_model "forgejo.org/models/nativeoperation"
+	pull_model "forgejo.org/models/pull"
+	user_model "forgejo.org/models/user"
+	"forgejo.org/modules/timeutil"
+)
+
+var ErrMergeMetadata = errors.New("native merge metadata differs from the committed merge")
+
+// ApplyMergeMetadata is the shared native SQL merge completion owner. It uses
+// SetMerged for issue closure, history and counters, and consumes a scheduled
+// merge in the same transaction. Exact replay makes no new history; a different
+// prior merge refuses. Notifications, cross references and ref writes are separate.
+func ApplyMergeMetadata(ctx context.Context, pullID int64, merger *user_model.User, commitID, mergeBase string) (changed bool, err error) {
+	if pullID < 1 || merger == nil || merger.ID < 1 || commitID == "" {
+		return false, ErrMergeMetadata
+	}
+	err = db.WithTx(ctx, func(ctx context.Context) error {
+		if err := nativeoperation_model.RequireHeldOwnership(ctx); err != nil {
+			return err
+		}
+		// Lock the natural idempotence marker before reading its merged state.
+		if _, err := db.GetEngine(ctx).Exec("UPDATE `pull_request` SET `issue_id`=`issue_id` WHERE `id`=?", pullID); err != nil {
+			return err
+		}
+		pr, err := issues_model.GetPullRequestByID(ctx, pullID)
+		if err != nil {
+			return err
+		}
+		if err := pr.LoadIssue(ctx); err != nil {
+			return err
+		}
+		if pr.HasMerged {
+			if pr.MergedCommitID != commitID || pr.MergerID != merger.ID || pr.MergeBase != mergeBase || pr.MergedUnix <= 0 || !pr.Issue.IsClosed {
+				return ErrMergeMetadata
+			}
+			return nil
+		}
+		pr.MergedCommitID, pr.MergeBase = commitID, mergeBase
+		pr.MergedUnix, pr.Merger, pr.MergerID = timeutil.TimeStampNow(), merger, merger.ID
+		if err := pull_model.DeleteScheduledAutoMerge(ctx, pr.ID); err != nil && !db.IsErrNotExist(err) {
+			return err
+		}
+		changed, err = pr.SetMerged(ctx)
+		return err
+	})
+	if err != nil {
+		return false, err
+	}
+	return changed, nil
+}
diff --git a/services/pull/merge_stage.go b/services/pull/merge_stage.go
new file mode 100644
index 0000000000000000000000000000000000000000..3a26c5d85720dc7475bfbe98d54c96b45c9d3328
--- /dev/null
+++ b/services/pull/merge_stage.go
@@ -0,0 +1,219 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package pull
+
+import (
+	"context"
+	"crypto/sha256"
+	"fmt"
+	"sync"
+
+	"forgejo.org/models"
+	issues_model "forgejo.org/models/issues"
+	nativeoperation_model "forgejo.org/models/nativeoperation"
+	repo_model "forgejo.org/models/repo"
+	user_model "forgejo.org/models/user"
+	"forgejo.org/modules/git"
+	execcontext "forgejo.org/modules/nativeoperation"
+)
+
+// prepareMergeCommits is the one ordinary merge-method engine. Computing local
+// objects is separate from LFS transfer, ref push and native completion.
+func prepareMergeCommits(ctx context.Context, pr *issues_model.PullRequest, doer *user_model.User, mergeStyle repo_model.MergeStyle, expectedHeadCommitID, expectedBaseOID, message string) (*mergeContext, context.CancelFunc, error) {
+	// Clone base repo.
+	mergeCtx, cancel, err := createTemporaryRepoForMerge(ctx, pr, doer, expectedHeadCommitID)
+	if err != nil {
+		return nil, nil, err
+	}
+	keep := false
+	defer func() {
+		if !keep {
+			cancel()
+		}
+	}()
+	if expectedBaseOID != "" {
+		base, err := git.GetFullCommitID(ctx, mergeCtx.tmpBasePath, "original_"+baseBranch)
+		if err != nil {
+			return nil, nil, err
+		}
+		if base != expectedBaseOID {
+			return nil, nil, ErrExactMergeRefused{Reason: ExactMergeRefusedStaleBase}
+		}
+	}
+
+	// Merge commits.
+	switch mergeStyle {
+	case repo_model.MergeStyleMerge:
+		if err := doMergeStyleMerge(mergeCtx, message); err != nil {
+			return nil, nil, err
+		}
+	case repo_model.MergeStyleRebase, repo_model.MergeStyleRebaseMerge:
+		if err := doMergeStyleRebase(mergeCtx, mergeStyle, message); err != nil {
+			return nil, nil, err
+		}
+	case repo_model.MergeStyleSquash:
+		if err := doMergeStyleSquash(mergeCtx, message); err != nil {
+			return nil, nil, err
+		}
+	case repo_model.MergeStyleFastForwardOnly:
+		if err := doMergeStyleFastForwardOnly(mergeCtx); err != nil {
+			return nil, nil, err
+		}
+	default:
+		return nil, nil, models.ErrInvalidMergeStyle{ID: pr.BaseRepo.ID, Style: mergeStyle}
+	}
+
+	keep = true
+	return mergeCtx, cancel, nil
+}
+
+// PreparedMergeResult describes computed local objects, never a published ref or
+// operation receipt. Its parent/tree evidence binds the actual method result.
+type PreparedMergeResult struct {
+	CommitID, TreeID, HeadOID, BaseOID string
+	Parents                            []string
+	Method                             repo_model.MergeStyle
+}
+
+// PreparedExactMerge owns a private local worktree and the native PR working
+// pool hold. Close is mandatory; this object exposes no publish operation.
+type PreparedExactMerge struct {
+	merge   *mergeContext
+	result  PreparedMergeResult
+	close   func()
+	runMu   sync.Mutex
+	mu      sync.RWMutex
+	closed  bool
+	started bool
+	target  preparedMergeTarget
+}
+
+// Private input facts survive later native model reloads and caller mutation.
+type preparedMergeTarget struct {
+	owner                         string
+	generation, actor, repository int64
+	pull, issue, index            int64
+	headRepository, poster        int64
+	originalAuthor                int64
+	baseBranch, headBranch        string
+	flow                          issues_model.PullRequestFlow
+	message                       [32]byte
+}
+
+func (p *PreparedExactMerge) Result() PreparedMergeResult {
+	r := p.result
+	r.Parents = append([]string(nil), r.Parents...)
+	return r
+}
+func (p *PreparedExactMerge) Close() {
+	if p == nil {
+		return
+	}
+	// A Git push calls back into WithExactTarget through its native hook. Wait
+	// here before queuing the RW writer so that callback can still take RLock.
+	p.runMu.Lock()
+	defer p.runMu.Unlock()
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if !p.closed {
+		p.closed = true
+		if p.close != nil {
+			p.close()
+		}
+	}
+}
+
+// WithExactTarget runs a native gate against this open stage's original inputs.
+// Close waits for that gate. No private path, mutation or publish operation is
+// exposed, and a result copied from another stage cannot substitute for it.
+func (p *PreparedExactMerge) WithExactTarget(ctx context.Context, pr *issues_model.PullRequest, actor *user_model.User, method repo_model.MergeStyle, head, base, message string, gate func(PreparedMergeResult) error) error {
+	return p.withExactTarget(ctx, pr, actor, method, head, base, message, false, false, gate)
+}
+
+// WithQuiescentExactTarget proves the original native stage attempted its single
+// synchronous push and Close finished waiting for the Git child/hooks and local
+// resource cleanup. A result copy, an open/unused stage or a foreign generation
+// cannot substitute. Closed stages cannot acquire another push or gate.
+func (p *PreparedExactMerge) WithQuiescentExactTarget(ctx context.Context, pr *issues_model.PullRequest, actor *user_model.User, method repo_model.MergeStyle, head, base, message string, gate func(PreparedMergeResult) error) error {
+	return p.withExactTarget(ctx, pr, actor, method, head, base, message, true, true, gate)
+}
+
+// WithClosedExactTarget also accepts a closed stage that never entered the push
+// engine. Refusal cleanup separately proves non-admission and no ref effect;
+// committed completion must use WithQuiescentExactTarget's attempted-push check.
+func (p *PreparedExactMerge) WithClosedExactTarget(ctx context.Context, pr *issues_model.PullRequest, actor *user_model.User, method repo_model.MergeStyle, head, base, message string, gate func(PreparedMergeResult) error) error {
+	return p.withExactTarget(ctx, pr, actor, method, head, base, message, true, false, gate)
+}
+
+func (p *PreparedExactMerge) withExactTarget(ctx context.Context, pr *issues_model.PullRequest, actor *user_model.User, method repo_model.MergeStyle, head, base, message string, closed, requireStarted bool, gate func(PreparedMergeResult) error) error {
+	if p == nil || pr == nil || pr.Issue == nil || actor == nil || gate == nil {
+		return ErrExactMergeRefused{Reason: ExactMergeRefusedPRMismatch}
+	}
+	p.mu.RLock()
+	defer p.mu.RUnlock()
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	x, t := execcontext.FromContext(ctx), p.target
+	if p.closed != closed || requireStarted && !p.started || p.merge == nil || x == nil || x.Owner != t.owner || x.Generation != t.generation || actor.ID != t.actor || pr.BaseRepoID != t.repository || pr.ID != t.pull || pr.IssueID != t.issue || pr.Index != t.index || pr.BaseBranch != t.baseBranch || pr.HeadRepoID != t.headRepository || pr.HeadBranch != t.headBranch || pr.Flow != t.flow || pr.Issue.PosterID != t.poster || pr.Issue.OriginalAuthorID != t.originalAuthor || sha256.Sum256([]byte(message)) != t.message || p.result.Method != method || p.result.HeadOID != head || p.result.BaseOID != base {
+		return ErrExactMergeRefused{Reason: ExactMergeRefusedPRMismatch}
+	}
+	return gate(p.Result())
+}
+
+// PrepareExactMerge computes all ordinary immediate methods with the existing
+// engine against exact copied head/base tips. The caller owns human/native policy
+// and must hold the global execution throughout. No LFS or remote ref is written.
+func PrepareExactMerge(ctx context.Context, pr *issues_model.PullRequest, doer *user_model.User, method repo_model.MergeStyle, head, base, message string) (*PreparedExactMerge, error) {
+	execution := execcontext.FromContext(ctx)
+	held, err := nativeoperation_model.ReadReservation(ctx)
+	if err != nil {
+		return nil, err
+	}
+	if execution == nil || execution.Owner == "" || held.Owner != execution.Owner || held.Generation != execution.Generation {
+		return nil, nativeoperation_model.ErrBusy
+	}
+	_, headErr := git.NewIDFromString(head)
+	_, baseErr := git.NewIDFromString(base)
+	if pr == nil || pr.Issue == nil || pr.ID <= 0 || pr.BaseRepoID <= 0 || pr.IssueID <= 0 || doer == nil || doer.ID <= 0 || headErr != nil || baseErr != nil {
+		return nil, ErrExactMergeRefused{Reason: ExactMergeRefusedPRMismatch}
+	}
+	pullWorkingPool.CheckIn(fmt.Sprint(pr.ID))
+	release := func() { pullWorkingPool.CheckOut(fmt.Sprint(pr.ID)) }
+	merge, cancel, err := prepareMergeCommits(ctx, pr, doer, method, head, base, message)
+	if err != nil {
+		release()
+		return nil, err
+	}
+	keep := false
+	defer func() {
+		if !keep {
+			cancel()
+			release()
+		}
+	}()
+	repo, err := git.OpenRepository(ctx, merge.tmpBasePath)
+	if err != nil {
+		return nil, err
+	}
+	defer repo.Close()
+	result, err := repo.GetBranchCommit(baseBranch)
+	if err != nil {
+		return nil, err
+	}
+	r := PreparedMergeResult{CommitID: result.ID.String(), TreeID: result.Tree.ID.String(), HeadOID: head, BaseOID: base, Method: method}
+	for _, parent := range result.Parents {
+		r.Parents = append(r.Parents, parent.String())
+	}
+	held, err = nativeoperation_model.ReadReservation(ctx)
+	if err != nil {
+		return nil, err
+	}
+	if held.Owner != execution.Owner || held.Generation != execution.Generation {
+		return nil, nativeoperation_model.ErrBusy
+	}
+	keep = true
+	target := preparedMergeTarget{owner: execution.Owner, generation: execution.Generation, actor: doer.ID, repository: pr.BaseRepoID, pull: pr.ID, issue: pr.IssueID, index: pr.Index, headRepository: pr.HeadRepoID, headBranch: pr.HeadBranch, baseBranch: pr.BaseBranch, flow: pr.Flow, poster: pr.Issue.PosterID, originalAuthor: pr.Issue.OriginalAuthorID, message: sha256.Sum256([]byte(message))}
+	return &PreparedExactMerge{merge: merge, result: r, target: target, close: func() { cancel(); release() }}, nil
+}
