new file mode 100644
index 0000000000000000000000000000000000000000..e40b909c6261a6ea456ba5d4910a7768ddd6f885
--- /dev/null
+++ b/services/nativeoperation/human_merge_branch.go
@@ -0,0 +1,50 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package nativeoperation
+
+import (
+	"context"
+
+	sdk "forgejo.org/extension-sdk"
+	git_model "forgejo.org/models/git"
+	issues_model "forgejo.org/models/issues"
+	repo_model "forgejo.org/models/repo"
+	user_model "forgejo.org/models/user"
+	"forgejo.org/modules/git"
+	repo_module "forgejo.org/modules/repository"
+	pull_service "forgejo.org/services/pull"
+)
+
+// SyncHumanMergeBranch mirrors the committed merge target through the same
+// native branch-catalog owner used by ordinary post-receive. Exact PR metadata
+// must already match the receipt. A fresh native catalog keeps its usual bootstrap
+// behavior. No ref write, push queue/notification, completion or owner release occurs.
+func (s *Service) SyncHumanMergeBranch(ctx context.Context, installation string, q sdk.HumanMergeRequest) error {
+	_, err := s.withHumanMergeReceipt(ctx, installation, q, func(tx context.Context, receipt sdk.HumanMergeReceipt, pr *issues_model.PullRequest, _ *user_model.User) (bool, error) {
+		if !pr.HasMerged || !pr.Issue.IsClosed || pr.MergedCommitID != receipt.ResultOID || pr.MergerID != receipt.ActorID || pr.MergeBase != receipt.MergeBaseOID || pr.MergedUnix <= 0 {
+			return false, pull_service.ErrMergeMetadata
+		}
+		repository, err := repo_model.GetRepositoryByID(tx, receipt.RepositoryID)
+		if err != nil {
+			return false, err
+		}
+		native, err := git.OpenRepository(tx, repository.RepoPath())
+		if err != nil {
+			return false, err
+		}
+		defer native.Close()
+		if err := repo_module.SyncBranchesToDB(tx, repository.ID, receipt.ActorID, []string{receipt.BaseBranch}, native.GetBranchCommit); err != nil {
+			return false, err
+		}
+		branch, err := git_model.GetBranch(tx, repository.ID, receipt.BaseBranch)
+		if err != nil {
+			return false, err
+		}
+		if branch.IsDeleted || branch.CommitID != receipt.ResultOID {
+			return false, ErrHumanMergePushEvidence
+		}
+		return false, nil
+	})
+	return err
+}
diff --git a/services/nativeoperation/human_merge_capture.go b/services/nativeoperation/human_merge_capture.go
new file mode 100644
index 0000000000000000000000000000000000000000..13511e509029bb092d1bb210825f8c2dd3b84a82
--- /dev/null
+++ b/services/nativeoperation/human_merge_capture.go
@@ -0,0 +1,103 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package nativeoperation
+
+import (
+	"context"
+	"encoding/json"
+	"time"
+
+	sdk "forgejo.org/extension-sdk"
+	nativeoperation_model "forgejo.org/models/nativeoperation"
+	"forgejo.org/modules/git"
+	execcontext "forgejo.org/modules/nativeoperation"
+	pull_service "forgejo.org/services/pull"
+
+	"github.com/google/uuid"
+)
+
+func humanMergeIntent(q sdk.HumanMergeRequest) (*ValidIntent, error) {
+	if !sdk.ValidHumanMergeRequest(q) {
+		return nil, ErrInvalidIntent
+	}
+	p := q.Expected
+	intent := &ValidIntent{OperationID: q.OperationID, ActorID: nativeCommentID(p.ActorID), RepositoryID: nativeCommentID(p.RepositoryID), Kind: nativeoperation_model.KindHumanMerge, AuthRevision: sdk.HumanMergeAuthorizationRevision, ExpectedNativeRevision: p.NativeRevision, NotAfter: q.NotAfter}
+	var err error
+	intent.Canonical, intent.Digest, err = sdk.CanonicalHumanMergeIntent(q)
+	return intent, err
+}
+
+// This is the unprepared scope. Only the later prepared-push binder may add the
+// server-computed NewOID; client captures never select a result commit.
+func humanMergeCaptureScope(q sdk.HumanMergeRequest) Scope {
+	p := q.Expected
+	return Scope{Kind: nativeoperation_model.OwnerConditional, RepositoryID: nativeCommentID(p.RepositoryID), IssueID: nativeCommentID(p.IssueID), PRNumber: nativeCommentID(p.Index), Ref: git.BranchPrefix + p.BaseBranch, OldOID: p.BaseOID, HeadRef: git.PullPrefix + p.Index + "/head", HeadOID: p.HeadOID}
+}
+
+// PrepareHumanMergeOperation consumes a previously persisted pending command
+// under its exact held owner. It allocates no operation and publishes nothing.
+// The caller MUST Close the private result. Push admission and durable merge
+// completion are separate consumers; this function never marks an op admitted.
+func (s *Service) PrepareHumanMergeOperation(ctx context.Context, installation string, q sdk.HumanMergeRequest, admit HumanReviewAdmission) (*pull_service.PreparedExactMerge, error) {
+	id, err := uuid.Parse(installation)
+	if err != nil || id.String() != installation || admit == nil {
+		return nil, ErrInvalidIntent
+	}
+	intent, err := humanMergeIntent(q)
+	if err != nil {
+		return nil, err
+	}
+	scope, err := json.Marshal(humanMergeCaptureScope(q))
+	if err != nil {
+		return nil, err
+	}
+	if err := s.checkHumanMergeCapture(ctx, installation, intent, string(scope)); err != nil {
+		return nil, err
+	}
+	return PrepareHumanMerge(ctx, intent.ActorID, q.Expected, q.Message, func(ctx context.Context) error {
+		if err := admitHumanPrimary(ctx, admit); err != nil {
+			return err
+		}
+		return s.checkHumanMergeCapture(ctx, installation, intent, string(scope))
+	})
+}
+
+func (s *Service) checkHumanMergeCapture(ctx context.Context, installation string, intent *ValidIntent, scope string) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	op, err := nativeoperation_model.LookupOperation(ctx, installation, intent.OperationID)
+	if err != nil {
+		return err
+	}
+	if !humanMergeCaptureMatches(op, intent) || op.Revoked || op.Admitted || op.EffectState != nativeoperation_model.EffectPending || op.Receipt != "" || op.Completion != "" {
+		return ErrInvalidIntent
+	}
+	now := s.clock()
+	if now >= intent.NotAfter {
+		return nativeoperation_model.ErrOperationExpired
+	}
+	if intent.NotAfter > now+int64(MaxOperationLifetime/time.Second) {
+		return ErrInvalidIntent
+	}
+	held, err := nativeoperation_model.ReadReservation(ctx)
+	if err != nil {
+		return err
+	}
+	execution := execcontext.FromContext(ctx)
+	if execution == nil || held.OwnerKind != nativeoperation_model.OwnerConditional || held.Owner != conditionalOwner(installation, intent.OperationID) || execution.Owner != held.Owner || execution.Generation != held.Generation {
+		return nativeoperation_model.ErrWrongOwner
+	}
+	if held.Scope != scope {
+		return ErrInvalidIntent
+	}
+	if err := requireHumanPrimaryOwner(ctx, intent.ExpectedNativeRevision); err != nil {
+		return err
+	}
+	return nil
+}
+
+func humanMergeCaptureMatches(op *nativeoperation_model.Operation, intent *ValidIntent) bool {
+	return op != nil && intent != nil && op.Submitted && op.TokenID == 0 && op.CredentialFingerprint == "" && op.Kind == intent.Kind && op.OperationID == intent.OperationID && op.ActorID == intent.ActorID && op.RepositoryID == intent.RepositoryID && op.AuthRevision == intent.AuthRevision && op.ExpectedNativeRevision == intent.ExpectedNativeRevision && op.NotAfter == intent.NotAfter && op.Intent == intent.Canonical && op.IntentDigest == intent.Digest
+}
diff --git a/services/nativeoperation/human_merge_complete.go b/services/nativeoperation/human_merge_complete.go
new file mode 100644
index 0000000000000000000000000000000000000000..42aceed285fc8b5363a17eb2e1c857a1c0aa1e70
--- /dev/null
+++ b/services/nativeoperation/human_merge_complete.go
@@ -0,0 +1,78 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package nativeoperation
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"os"
+	"slices"
+
+	sdk "forgejo.org/extension-sdk"
+	"forgejo.org/models/db"
+	git_model "forgejo.org/models/git"
+	issues_model "forgejo.org/models/issues"
+	nativeoperation_model "forgejo.org/models/nativeoperation"
+	repo_model "forgejo.org/models/repo"
+	user_model "forgejo.org/models/user"
+	execcontext "forgejo.org/modules/nativeoperation"
+	pull_service "forgejo.org/services/pull"
+)
+
+var ErrHumanMergeCompletionNotReady = errors.New("native human merge completion is not ready")
+
+// CompleteHumanMerge releases a live writer only after its exact native stage
+// is closed, its primary receipt is proved, and all native completion dispatch
+// phases succeeded. It cannot release an interrupted writer without that live
+// stage; stopped-writer recovery is separate. Retained lookup resolves a lost
+// result without replaying a push, notification or completion event.
+func (s *Service) CompleteHumanMerge(ctx context.Context, installation string, q sdk.HumanMergeRequest, stage *pull_service.PreparedExactMerge) (sdk.OperationRecord, error) {
+	if stage == nil || db.InTransaction(ctx) {
+		return sdk.OperationRecord{}, ErrInvalidIntent
+	}
+	intent, held, scope, err := readHumanMergeHeld(ctx, installation, q)
+	if err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	if scope.CompletionPhase != HumanMergePushEventDone {
+		return sdk.OperationRecord{}, ErrHumanMergeCompletionNotReady
+	}
+	want := humanMergeExpectedOperation(installation, intent)
+	var recorded *nativeoperation_model.Operation
+	_, err = s.withHumanMergeReceipt(ctx, installation, q, func(tx context.Context, receipt sdk.HumanMergeReceipt, pr *issues_model.PullRequest, actor *user_model.User) (bool, error) {
+		if !pr.HasMerged || !pr.Issue.IsClosed || pr.MergedCommitID != receipt.ResultOID || pr.MergerID != receipt.ActorID || pr.MergeBase != receipt.MergeBaseOID || pr.MergedUnix <= 0 {
+			return false, pull_service.ErrMergeMetadata
+		}
+		branch, err := git_model.GetBranch(tx, receipt.RepositoryID, receipt.BaseBranch)
+		if err != nil {
+			return false, err
+		}
+		if branch.IsDeleted || branch.CommitID != receipt.ResultOID {
+			return false, ErrHumanMergePushEvidence
+		}
+		err = stage.WithQuiescentExactTarget(tx, pr, actor, repo_model.MergeStyle(q.Expected.Method), q.Expected.HeadOID, q.Expected.BaseOID, q.Message, func(result pull_service.PreparedMergeResult) error {
+			if result.CommitID != receipt.ResultOID || result.TreeID != receipt.TreeOID || !slices.Equal(result.Parents, receipt.Parents) {
+				return ErrHumanMergePushEvidence
+			}
+			raw, err := json.Marshal(receipt)
+			if err != nil {
+				return err
+			}
+			recorded, err = nativeoperation_model.CompleteHumanMerge(tx, want, held.Owner, held.Generation, held.Scope, string(raw))
+			return err
+		})
+		return false, err
+	})
+	if err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	// The SQL release revokes this proof before deleting its private file. If
+	// cleanup fails, lookup still reports the committed completion truth.
+	record := ToRecord(recorded)
+	if err := os.Remove(execcontext.FromContext(ctx).CapabilityPath); err != nil && !os.IsNotExist(err) {
+		return record, err
+	}
+	return record, nil
+}
diff --git a/services/nativeoperation/human_merge_effect.go b/services/nativeoperation/human_merge_effect.go
new file mode 100644
index 0000000000000000000000000000000000000000..9a67e915176d44422d872030a8cf5d1a71fec923
--- /dev/null
+++ b/services/nativeoperation/human_merge_effect.go
@@ -0,0 +1,168 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package nativeoperation
+
+import (
+	"context"
+	"encoding/json"
+
+	sdk "forgejo.org/extension-sdk"
+	nativeoperation_model "forgejo.org/models/nativeoperation"
+	repo_model "forgejo.org/models/repo"
+	"forgejo.org/modules/git"
+	execcontext "forgejo.org/modules/nativeoperation"
+
+	"github.com/google/uuid"
+)
+
+// RecordHumanMergeEffect attributes only the held operation's primary ref
+// effect. Raw writer reports and caller-provided commit facts are not evidence.
+// It needs the native execution capability, not renewed permission to perform a
+// merge: current authority loss must not erase a primary effect already made.
+// Every outcome retains the owner/capability for completion or quiescence/recovery.
+func (s *Service) RecordHumanMergeEffect(ctx context.Context, installation string, q sdk.HumanMergeRequest) (sdk.OperationRecord, error) {
+	intent, held, scope, err := readHumanMergeHeld(ctx, installation, q)
+	if err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	want := humanMergeExpectedOperation(installation, intent)
+	recorded, err := nativeoperation_model.RecordHumanMergeEffect(ctx, want, held.Owner, held.Generation, held.Scope, func(tx context.Context, op *nativeoperation_model.Operation) (nativeoperation_model.TerminalOutcome, error) {
+		return s.observeHumanMergeEffect(tx, op, q, scope)
+	})
+	if err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	if recorded.EffectState == nativeoperation_model.EffectCommitted {
+		var receipt sdk.HumanMergeReceipt
+		if json.Unmarshal([]byte(recorded.Receipt), &receipt) != nil || !sdk.ValidHumanMergeReceipt(receipt, q) || receipt.ResultOID != scope.NewOID {
+			return sdk.OperationRecord{}, ErrHumanMergePushEvidence
+		}
+		raw, err := json.Marshal(receipt)
+		if err != nil || string(raw) != recorded.Receipt {
+			return sdk.OperationRecord{}, ErrHumanMergePushEvidence
+		}
+	}
+	return ToRecord(recorded), nil
+}
+
+func humanMergeEffectOutcome(op *nativeoperation_model.Operation, effect, reason, receipt string) nativeoperation_model.TerminalOutcome {
+	o := nativeoperation_model.TerminalOutcome{EffectState: effect, Reason: reason, Receipt: receipt, Cancellation: nativeoperation_model.CancellationNone}
+	if effect == nativeoperation_model.EffectCommitted {
+		o.Completion = nativeoperation_model.CompletionPending
+	}
+	if op.Revoked {
+		switch effect {
+		case nativeoperation_model.EffectCommitted:
+			o.Cancellation = nativeoperation_model.CancellationTooLate
+		case nativeoperation_model.EffectNotCommitted:
+			o.Cancellation = nativeoperation_model.CancellationCancelled
+		default:
+			o.Cancellation = nativeoperation_model.CancellationIndeterminate
+		}
+	}
+	return o
+}
+
+func (s *Service) observeHumanMergeEffect(ctx context.Context, op *nativeoperation_model.Operation, q sdk.HumanMergeRequest, scope Scope) (nativeoperation_model.TerminalOutcome, error) {
+	uncertain := func(reason string) (nativeoperation_model.TerminalOutcome, error) {
+		return humanMergeEffectOutcome(op, nativeoperation_model.EffectIndeterminate, reason, ""), nil
+	}
+	repository, err := repo_model.GetRepositoryByID(ctx, op.RepositoryID)
+	if err != nil {
+		return uncertain(nativeoperation_model.ReasonNativeRefused)
+	}
+	native, err := git.OpenRepository(ctx, repository.RepoPath())
+	if err != nil {
+		return uncertain(nativeoperation_model.ReasonNativeRefused)
+	}
+	defer native.Close()
+	tip, err := native.GetRefCommitID(scope.Ref)
+	if err != nil {
+		return uncertain(nativeoperation_model.ReasonStaleBaseOrResult)
+	}
+	if !op.Admitted {
+		if tip != scope.OldOID {
+			return uncertain(nativeoperation_model.ReasonUnexpectedRefEffects)
+		}
+		reason := op.Reason
+		if op.Revoked {
+			reason = nativeoperation_model.ReasonCancelledBeforeAdmission
+		} else if reason == "" {
+			reason = nativeoperation_model.ReasonNativeRefused
+		}
+		return humanMergeEffectOutcome(op, nativeoperation_model.EffectNotCommitted, reason, ""), nil
+	}
+	if scope.NewOID == "" || tip != scope.NewOID || tip == scope.OldOID {
+		return uncertain(nativeoperation_model.ReasonStaleBaseOrResult)
+	}
+	commit, err := native.GetCommit(tip)
+	if err != nil {
+		return uncertain(nativeoperation_model.ReasonNativeRefused)
+	}
+	base, err := native.GetMergeBaseSimple(scope.OldOID, tip)
+	if err != nil || base != scope.OldOID {
+		return uncertain(nativeoperation_model.ReasonStaleBaseOrResult)
+	}
+	p := q.Expected
+	r := sdk.HumanMergeReceipt{RepositoryID: op.RepositoryID, ActorID: op.ActorID, PullID: nativeCommentID(p.PullID), IssueID: nativeCommentID(p.IssueID), Index: nativeCommentID(p.Index), Method: p.Method, BaseBranch: p.BaseBranch, HeadOID: p.HeadOID, BaseOID: p.BaseOID, MergeBaseOID: p.MergeBaseOID, ResultOID: tip, TreeOID: commit.Tree.ID.String(), IntentDigest: op.IntentDigest}
+	for _, parent := range commit.Parents {
+		r.Parents = append(r.Parents, parent.String())
+	}
+	if !sdk.ValidHumanMergeReceipt(r, q) {
+		return uncertain(nativeoperation_model.ReasonNativeRefused)
+	}
+	raw, err := json.Marshal(r)
+	if err != nil {
+		return nativeoperation_model.TerminalOutcome{}, err
+	}
+	return humanMergeEffectOutcome(op, nativeoperation_model.EffectCommitted, "", string(raw)), nil
+}
+
+func readHumanMergeHeld(ctx context.Context, installation string, q sdk.HumanMergeRequest) (*ValidIntent, *nativeoperation_model.Reservation, Scope, error) {
+	id, err := uuid.Parse(installation)
+	if err != nil || id.String() != installation {
+		return nil, nil, Scope{}, ErrInvalidIntent
+	}
+	intent, err := humanMergeIntent(q)
+	if err != nil {
+		return nil, nil, Scope{}, err
+	}
+	held, err := nativeoperation_model.ReadReservation(ctx)
+	if err != nil {
+		return nil, nil, Scope{}, err
+	}
+	x := execcontext.FromContext(ctx)
+	if x == nil || held.OwnerKind != nativeoperation_model.OwnerConditional || x.Owner != held.Owner || x.Generation != held.Generation || held.Owner != conditionalOwner(installation, q.OperationID) || held.Revision != intent.ExpectedNativeRevision+1 {
+		return nil, nil, Scope{}, nativeoperation_model.ErrWrongOwner
+	}
+	proof, err := execcontext.ReadCapabilityFile(x.CapabilityPath)
+	if err != nil || !execcontext.VerifyProof(held.Verifier, proof) {
+		return nil, nil, Scope{}, nativeoperation_model.ErrWrongOwner
+	}
+	scope, err := decodeScope(held.Scope)
+	if err != nil {
+		return nil, nil, Scope{}, err
+	}
+	if err := checkHumanMergeScope(q, scope, held.Scope); err != nil {
+		return nil, nil, Scope{}, err
+	}
+	return intent, held, scope, nil
+}
+
+// Live attribution and offline recovery share one exact scope definition.
+func checkHumanMergeScope(q sdk.HumanMergeRequest, scope Scope, raw string) error {
+	exact := humanMergeCaptureScope(q)
+	exact.NewOID = scope.NewOID
+	// Completion claims are server-derived phases after the ref primary. They
+	// never alter its exact tuple or immutable receipt, and admit no new push.
+	if scope.CompletionPhase != "" && scope.CompletionPhase != HumanMergeFinishStarted && scope.CompletionPhase != HumanMergeFinishDone && scope.CompletionPhase != HumanMergePushEventStarted && scope.CompletionPhase != HumanMergePushEventDone {
+		return ErrInvalidIntent
+	}
+	exact.CompletionPhase = scope.CompletionPhase
+	encoded, err := encodeScope(exact)
+	if err != nil || encoded != raw || scope.NewOID != "" && (!sdk.ValidPullDiffCommit(scope.NewOID) || scope.NewOID == scope.OldOID) {
+		return ErrInvalidIntent
+	}
+	return nil
+}
diff --git a/services/nativeoperation/human_merge_finish.go b/services/nativeoperation/human_merge_finish.go
new file mode 100644
index 0000000000000000000000000000000000000000..8d4730f32177c47081d6aa9309593d352726c131
--- /dev/null
+++ b/services/nativeoperation/human_merge_finish.go
@@ -0,0 +1,90 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package nativeoperation
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+
+	sdk "forgejo.org/extension-sdk"
+	"forgejo.org/models/db"
+	git_model "forgejo.org/models/git"
+	issues_model "forgejo.org/models/issues"
+	nativeoperation_model "forgejo.org/models/nativeoperation"
+	user_model "forgejo.org/models/user"
+	pull_service "forgejo.org/services/pull"
+)
+
+const HumanMergeFinishStarted = "human-merge-finish-started"
+const HumanMergeFinishDone = "human-merge-finish-done"
+
+var ErrHumanMergeFinishClaimed = errors.New("native human merge finishing was already claimed")
+
+// FinishHumanMerge dispatches native merge notification/cross-reference work
+// once after exact PR and branch-catalog completion. The durable scope marker
+// commits before dispatch; an uncertain/failed attempt is never replayed here.
+// Overall completion and ownership remain pending for push-event processing and
+// safe writer quiescence/recovery. No new merge authorization is performed.
+func (s *Service) FinishHumanMerge(ctx context.Context, installation string, q sdk.HumanMergeRequest) (sdk.OperationRecord, error) {
+	// The claim must commit before dispatch, independently of any caller SQL.
+	if db.InTransaction(ctx) {
+		return sdk.OperationRecord{}, ErrInvalidIntent
+	}
+	intent, held, scope, err := readHumanMergeHeld(ctx, installation, q)
+	if err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	if scope.CompletionPhase != "" {
+		return sdk.OperationRecord{}, ErrHumanMergeFinishClaimed
+	}
+	started := scope
+	started.CompletionPhase = HumanMergeFinishStarted
+	startedJSON, err := encodeScope(started)
+	if err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	done := scope
+	done.CompletionPhase = HumanMergeFinishDone
+	doneJSON, err := encodeScope(done)
+	if err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	want := humanMergeExpectedOperation(installation, intent)
+	var pull *issues_model.PullRequest
+	var merger *user_model.User
+	var receiptJSON string
+	_, err = s.withHumanMergeReceipt(ctx, installation, q, func(tx context.Context, receipt sdk.HumanMergeReceipt, pr *issues_model.PullRequest, actor *user_model.User) (bool, error) {
+		if !pr.HasMerged || !pr.Issue.IsClosed || pr.MergedCommitID != receipt.ResultOID || pr.MergerID != receipt.ActorID || pr.MergeBase != receipt.MergeBaseOID || pr.MergedUnix <= 0 {
+			return false, pull_service.ErrMergeMetadata
+		}
+		branch, err := git_model.GetBranch(tx, receipt.RepositoryID, receipt.BaseBranch)
+		if err != nil {
+			return false, err
+		}
+		if branch.IsDeleted || branch.CommitID != receipt.ResultOID {
+			return false, ErrHumanMergePushEvidence
+		}
+		raw, err := json.Marshal(receipt)
+		if err != nil {
+			return false, err
+		}
+		receiptJSON = string(raw)
+		if err := nativeoperation_model.ClaimHumanMergeDispatch(tx, want, held.Owner, held.Generation, held.Scope, startedJSON, receiptJSON); err != nil {
+			return false, err
+		}
+		pull, merger = pr, actor
+		return false, nil
+	})
+	if err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	// No SQL transaction spans native notification/issue-status dispatch.
+	finishErr := pull_service.FinishMerge(ctx, pull, merger, false)
+	recorded, err := nativeoperation_model.RecordHumanMergeDispatch(context.WithoutCancel(ctx), want, held.Owner, held.Generation, startedJSON, doneJSON, receiptJSON, finishErr == nil)
+	if err != nil {
+		return sdk.OperationRecord{}, errors.Join(err, finishErr)
+	}
+	return ToRecord(recorded), nil
+}
diff --git a/services/nativeoperation/human_merge_gate.go b/services/nativeoperation/human_merge_gate.go
new file mode 100644
index 0000000000000000000000000000000000000000..df896ee6204d54cd78f9aa431d24b47f6a9bf50e
--- /dev/null
+++ b/services/nativeoperation/human_merge_gate.go
@@ -0,0 +1,198 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package nativeoperation
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"time"
+
+	sdk "forgejo.org/extension-sdk"
+	nativeoperation_model "forgejo.org/models/nativeoperation"
+	repo_model "forgejo.org/models/repo"
+	execcontext "forgejo.org/modules/nativeoperation"
+	pull_service "forgejo.org/services/pull"
+
+	"github.com/google/uuid"
+)
+
+// A live request witness stays only in the service that dispatches native hooks.
+// No session, callback or reusable bearer is persisted in the operation/scope.
+type humanMergeAdmission struct {
+	mu         sync.Mutex
+	retired    bool
+	ctx        context.Context
+	want       *nativeoperation_model.Operation
+	generation int64
+	scope      string
+	query      sdk.HumanMergeRequest
+	stage      *pull_service.PreparedExactMerge
+	admit      HumanReviewAdmission
+}
+
+func humanMergeExpectedOperation(installation string, intent *ValidIntent) *nativeoperation_model.Operation {
+	return &nativeoperation_model.Operation{InstallationID: installation, OperationID: intent.OperationID, ActorID: intent.ActorID, RepositoryID: intent.RepositoryID, Kind: intent.Kind, AuthRevision: intent.AuthRevision, ExpectedNativeRevision: intent.ExpectedNativeRevision, NotAfter: intent.NotAfter, Intent: intent.Canonical, IntentDigest: intent.Digest}
+}
+
+// BindHumanMergeStage binds the actual open stage's result exactly once and
+// retains live human admission for this held generation. The same Service must
+// dispatch its prepared hook. The caller MUST defer retirement and stage.Close
+// until its push has finished. Retirement never releases or rewrites the durable
+// fence; a missing witness after restart cannot authorize a merge.
+func (s *Service) BindHumanMergeStage(ctx context.Context, installation string, q sdk.HumanMergeRequest, stage *pull_service.PreparedExactMerge, admit HumanReviewAdmission) (retire func(), err error) {
+	id, parseErr := uuid.Parse(installation)
+	if parseErr != nil || id.String() != installation || stage == nil || admit == nil {
+		return nil, ErrInvalidIntent
+	}
+	intent, err := humanMergeIntent(q)
+	if err != nil {
+		return nil, err
+	}
+	before, err := encodeScope(humanMergeCaptureScope(q))
+	if err != nil {
+		return nil, err
+	}
+	if err := s.checkHumanMergeCapture(ctx, installation, intent, before); err != nil {
+		return nil, err
+	}
+	pr, actor, err := checkHumanMergeTarget(ctx, intent.ActorID, q.Expected, admit)
+	if err != nil {
+		return nil, err
+	}
+	execution := execcontext.FromContext(ctx) // Exact held execution checked above.
+	owner, generation := execution.Owner, execution.Generation
+	var witness *humanMergeAdmission
+	err = stage.WithExactTarget(ctx, pr, actor, repo_model.MergeStyle(q.Expected.Method), q.Expected.HeadOID, q.Expected.BaseOID, q.Message, func(result pull_service.PreparedMergeResult) error {
+		bound := humanMergeCaptureScope(q)
+		bound.NewOID = result.CommitID
+		after, err := encodeScope(bound)
+		if err != nil {
+			return err
+		}
+		want := humanMergeExpectedOperation(installation, intent)
+		s.humanMergeMu.Lock()
+		defer s.humanMergeMu.Unlock()
+		if s.humanMerges[owner] != nil {
+			return nativeoperation_model.ErrBusy
+		}
+		if err := nativeoperation_model.BindHumanMergeScope(ctx, want, owner, generation, before, after, s.clock()); err != nil {
+			return err
+		}
+		witness = &humanMergeAdmission{ctx: ctx, want: want, generation: generation, scope: after, query: q, stage: stage, admit: admit}
+		if s.humanMerges == nil {
+			s.humanMerges = make(map[string]*humanMergeAdmission)
+		}
+		s.humanMerges[owner] = witness
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	var once sync.Once
+	return func() {
+		once.Do(func() {
+			// Serialize retirement against an in-flight decision. When this
+			// returns, no later prepared admission may use this witness.
+			witness.mu.Lock()
+			witness.retired = true
+			witness.mu.Unlock()
+			s.humanMergeMu.Lock()
+			if s.humanMerges[owner] == witness {
+				delete(s.humanMerges, owner)
+			}
+			s.humanMergeMu.Unlock()
+		})
+	}, nil
+}
+
+func (s *Service) admitHumanMergePrepared(ctx context.Context, held *nativeoperation_model.Reservation, scope Scope, op *nativeoperation_model.Operation, lines []RefLine) (TransactionDecision, error) {
+	s.humanMergeMu.Lock()
+	w := s.humanMerges[held.Owner]
+	s.humanMergeMu.Unlock()
+	if w == nil {
+		return TransactionDecision{Reason: nativeoperation_model.ReasonAuthorityLost}, nil
+	}
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	if w.retired || w.generation != held.Generation || w.scope != held.Scope || w.want.InstallationID != op.InstallationID || w.want.OperationID != op.OperationID {
+		return TransactionDecision{Reason: nativeoperation_model.ReasonWrongOwner}, nil
+	}
+	// The generated Git hook has execution proof, but no human session. Combine
+	// its cancellation with the original request and immutable admission deadline.
+	live, cancel := context.WithDeadline(ctx, time.Unix(w.want.NotAfter, 0))
+	defer cancel()
+	stop := context.AfterFunc(w.ctx, cancel)
+	defer stop()
+	if w.ctx.Err() != nil {
+		cancel()
+	}
+	owned := execcontext.NewContext(live, &execcontext.Execution{Owner: held.Owner, Generation: held.Generation})
+	reason := ""
+	switch {
+	case len(lines) != 1:
+		reason = nativeoperation_model.ReasonUnexpectedRefEffects
+	case lines[0].Ref != scope.Ref || lines[0].Old != scope.OldOID || lines[0].New != scope.NewOID:
+		reason = nativeoperation_model.ReasonStaleBaseOrResult
+	case s.clock() >= w.want.NotAfter:
+		reason = nativeoperation_model.ReasonExpiredBeforeAdmission
+	case owned.Err() != nil:
+		reason = nativeoperation_model.ReasonAuthorityLost
+	}
+	decision := func(ctx context.Context, reason string) (TransactionDecision, error) {
+		// Refusals still use the request context, not a cancelled derived deadline,
+		// so expiry/cancel ordering can be durably recorded without authorizing.
+		recorded, yes, err := nativeoperation_model.RecordHumanMergeAdmission(ctx, w.want, held.Owner, held.Generation, held.Scope, s.clock(), reason == "", reason)
+		if errors.Is(err, nativeoperation_model.ErrWrongOwner) {
+			return TransactionDecision{Reason: nativeoperation_model.ReasonWrongOwner}, nil
+		}
+		if errors.Is(err, nativeoperation_model.ErrAdmissionLost) {
+			return TransactionDecision{Reason: nativeoperation_model.ReasonNativeRefused}, nil
+		}
+		if err != nil {
+			return TransactionDecision{}, err
+		}
+		if !yes {
+			return TransactionDecision{Reason: lostAdmissionReason(recorded)}, nil
+		}
+		return TransactionDecision{Allowed: true}, nil
+	}
+	if reason != "" {
+		return decision(ctx, reason)
+	}
+	pr, actor, err := checkHumanMergeTarget(owned, w.want.ActorID, w.query.Expected, w.admit)
+	if err != nil {
+		reason = nativeoperation_model.ReasonNativeRefused
+		if errors.Is(err, ErrAuthorityLost) {
+			reason = nativeoperation_model.ReasonAuthorityLost
+		}
+		if s.clock() >= w.want.NotAfter || errors.Is(err, nativeoperation_model.ErrOperationExpired) {
+			reason = nativeoperation_model.ReasonExpiredBeforeAdmission
+		}
+		return decision(ctx, reason)
+	}
+	var result TransactionDecision
+	err = w.stage.WithExactTarget(owned, pr, actor, repo_model.MergeStyle(w.query.Expected.Method), w.query.Expected.HeadOID, w.query.Expected.BaseOID, w.query.Message, func(_ pull_service.PreparedMergeResult) error {
+		var err error
+		// AfterFunc propagates cancellation to in-flight I/O. Also observe the
+		// original request directly at admission, without waiting for its callback
+		// goroutine to run after a cancellation during native validation.
+		if w.ctx.Err() != nil {
+			result, err = decision(ctx, nativeoperation_model.ReasonAuthorityLost)
+			return err
+		}
+		result, err = decision(owned, "")
+		return err
+	})
+	if err != nil {
+		// Infrastructure errors retain the pending fence; a closed/foreign stage
+		// is a deterministic refusal. No error can turn into an allowed decision.
+		var mismatch pull_service.ErrExactMergeRefused
+		if errors.As(err, &mismatch) {
+			return decision(ctx, nativeoperation_model.ReasonNativeRefused)
+		}
+		return TransactionDecision{}, err
+	}
+	return result, nil
+}
diff --git a/services/nativeoperation/human_merge_metadata.go b/services/nativeoperation/human_merge_metadata.go
new file mode 100644
index 0000000000000000000000000000000000000000..230b4609d1eb741e15ec56d5fd5905fb81ad9903
--- /dev/null
+++ b/services/nativeoperation/human_merge_metadata.go
@@ -0,0 +1,76 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package nativeoperation
+
+import (
+	"context"
+	"encoding/json"
+
+	sdk "forgejo.org/extension-sdk"
+	issues_model "forgejo.org/models/issues"
+	nativeoperation_model "forgejo.org/models/nativeoperation"
+	user_model "forgejo.org/models/user"
+	pull_service "forgejo.org/services/pull"
+)
+
+// ApplyHumanMergeMetadata consumes the exact committed ref receipt, never a new
+// merge grant. It applies native PR/issue/history/counter/schedule SQL once. The
+// primary receipt, completion-pending state, owner and capability stay intact for
+// notification/cross-reference completion and interrupted-writer reconciliation.
+func (s *Service) ApplyHumanMergeMetadata(ctx context.Context, installation string, q sdk.HumanMergeRequest) (bool, error) {
+	return s.withHumanMergeReceipt(ctx, installation, q, func(tx context.Context, receipt sdk.HumanMergeReceipt, pr *issues_model.PullRequest, merger *user_model.User) (bool, error) {
+		return pull_service.ApplyMergeMetadata(tx, pr.ID, merger, receipt.ResultOID, receipt.MergeBaseOID)
+	})
+}
+
+// All receipt-consuming SQL bookkeeping shares the same native execution,
+// immutable evidence, scope/operation locks and exact current PR identity.
+func (s *Service) withHumanMergeReceipt(ctx context.Context, installation string, q sdk.HumanMergeRequest, apply func(context.Context, sdk.HumanMergeReceipt, *issues_model.PullRequest, *user_model.User) (bool, error)) (bool, error) {
+	intent, held, scope, err := readHumanMergeHeld(ctx, installation, q)
+	if err != nil {
+		return false, err
+	}
+	op, err := nativeoperation_model.LookupOperation(ctx, installation, q.OperationID)
+	if err != nil {
+		return false, err
+	}
+	if op == nil {
+		return false, ErrInvalidIntent
+	}
+	var receipt sdk.HumanMergeReceipt
+	if json.Unmarshal([]byte(op.Receipt), &receipt) != nil || !sdk.ValidHumanMergeReceipt(receipt, q) || receipt.ResultOID != scope.NewOID {
+		return false, ErrHumanMergePushEvidence
+	}
+	raw, err := json.Marshal(receipt)
+	if err != nil || string(raw) != op.Receipt {
+		return false, ErrHumanMergePushEvidence
+	}
+	return nativeoperation_model.ApplyHumanMergeMetadata(ctx, humanMergeExpectedOperation(installation, intent), held.Owner, held.Generation, held.Scope, op.Receipt, func(tx context.Context, current *nativeoperation_model.Operation) (bool, error) {
+		// The primary receipt is immutable historical truth. Metadata completion
+		// additionally needs its exact current target/object evidence; divergence
+		// refuses bookkeeping without undoing that primary truth.
+		observed, err := s.observeHumanMergeEffect(tx, current, q, scope)
+		if err != nil {
+			return false, err
+		}
+		if observed.EffectState != nativeoperation_model.EffectCommitted || observed.Receipt != current.Receipt {
+			return false, ErrHumanMergePushEvidence
+		}
+		pr, err := issues_model.GetPullRequestByID(tx, receipt.PullID)
+		if err != nil {
+			return false, err
+		}
+		if err := pr.LoadIssue(tx); err != nil {
+			return false, err
+		}
+		if pr.BaseRepoID != receipt.RepositoryID || pr.IssueID != receipt.IssueID || pr.Index != receipt.Index || pr.BaseBranch != receipt.BaseBranch || !pr.Issue.IsPull || pr.Issue.RepoID != receipt.RepositoryID || pr.Issue.Index != receipt.Index {
+			return false, pull_service.ErrMergeMetadata
+		}
+		merger, err := user_model.GetUserByID(tx, receipt.ActorID)
+		if err != nil {
+			return false, err
+		}
+		return apply(tx, receipt, pr, merger)
+	})
+}
diff --git a/services/nativeoperation/human_merge_noncommit.go b/services/nativeoperation/human_merge_noncommit.go
new file mode 100644
index 0000000000000000000000000000000000000000..f6dd236b7a51aaa82c167078d60028ac418e875c
--- /dev/null
+++ b/services/nativeoperation/human_merge_noncommit.go
@@ -0,0 +1,71 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package nativeoperation
+
+import (
+	"context"
+	"os"
+
+	sdk "forgejo.org/extension-sdk"
+	"forgejo.org/models/db"
+	issues_model "forgejo.org/models/issues"
+	nativeoperation_model "forgejo.org/models/nativeoperation"
+	repo_model "forgejo.org/models/repo"
+	user_model "forgejo.org/models/user"
+	execcontext "forgejo.org/modules/nativeoperation"
+	pull_service "forgejo.org/services/pull"
+)
+
+// ReleaseHumanMergeNotCommitted retires a proved live refusal after Close has
+// stopped its exact stage, including a pre-launch refusal. A saved non-commit
+// alone is insufficient: admission must remain false and the current ref must
+// still prove no effect. No fresh human permission is needed to preserve already
+// recorded refusal truth. Interrupted writers without their stage need recovery.
+func (s *Service) ReleaseHumanMergeNotCommitted(ctx context.Context, installation string, q sdk.HumanMergeRequest, stage *pull_service.PreparedExactMerge) (sdk.OperationRecord, error) {
+	if stage == nil || db.InTransaction(ctx) {
+		return sdk.OperationRecord{}, ErrInvalidIntent
+	}
+	intent, held, scope, err := readHumanMergeHeld(ctx, installation, q)
+	if err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	if scope.CompletionPhase != "" {
+		return sdk.OperationRecord{}, ErrHumanMergeCompletionNotReady
+	}
+	recorded, err := nativeoperation_model.ReleaseHumanMergeNotCommitted(ctx, humanMergeExpectedOperation(installation, intent), held.Owner, held.Generation, held.Scope, func(tx context.Context, op *nativeoperation_model.Operation) error {
+		observed, err := s.observeHumanMergeEffect(tx, op, q, scope)
+		if err != nil {
+			return err
+		}
+		if observed.EffectState != nativeoperation_model.EffectNotCommitted || observed.Receipt != "" || observed.Completion != "" {
+			return ErrHumanMergePushEvidence
+		}
+		pr, err := issues_model.GetPullRequestByID(tx, nativeCommentID(q.Expected.PullID))
+		if err != nil {
+			return err
+		}
+		if err := pr.LoadIssue(tx); err != nil {
+			return err
+		}
+		actor, err := user_model.GetUserByID(tx, intent.ActorID)
+		if err != nil {
+			return err
+		}
+		return stage.WithClosedExactTarget(tx, pr, actor, repo_model.MergeStyle(q.Expected.Method), q.Expected.HeadOID, q.Expected.BaseOID, q.Message, func(result pull_service.PreparedMergeResult) error {
+			if scope.NewOID != "" && scope.NewOID != result.CommitID {
+				return ErrHumanMergePushEvidence
+			}
+			return nil
+		})
+	})
+	if err != nil {
+		return sdk.OperationRecord{}, err
+	}
+	record := ToRecord(recorded)
+	// SQL has already revoked this proof, even if private-file cleanup fails.
+	if err := os.Remove(execcontext.FromContext(ctx).CapabilityPath); err != nil && !os.IsNotExist(err) {
+		return record, err
+	}
+	return record, nil
+}
diff --git a/services/nativeoperation/human_merge_push.go b/services/nativeoperation/human_merge_push.go
new file mode 100644
index 0000000000000000000000000000000000000000..1b865bb905cd4db5ecad50606f0f0a8c5211a9a3
--- /dev/null
+++ b/services/nativeoperation/human_merge_push.go
@@ -0,0 +1,116 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package nativeoperation
+
+import (
+	"context"
+	"errors"
+	"time"
+
+	sdk "forgejo.org/extension-sdk"
+	nativeoperation_model "forgejo.org/models/nativeoperation"
+	repo_model "forgejo.org/models/repo"
+	execcontext "forgejo.org/modules/nativeoperation"
+	pull_service "forgejo.org/services/pull"
+)
+
+var ErrHumanMergePushEvidence = errors.New("human merge push evidence is incomplete or differs")
+
+// HumanMergePushObservation contains native evidence after the synchronous Git
+// call for the future journal reconciler. An interrupted writer still requires
+// quiescence/recovery qualification. A successful Git exit is not a receipt;
+// attribution needs the saved admission and exact tip, plus native completion.
+type HumanMergePushObservation struct {
+	Result      pull_service.PreparedMergeResult
+	Attempted   bool
+	Admitted    bool
+	ObservedOID string
+}
+
+// PushHumanMergeOperation binds and pushes one already journaled, staged human
+// command through native hooks. It never releases the owner or capability,
+// assigns an effect/completion state, or retries an uncertain writer. The caller
+// MUST reconcile the retained operation before releasing it, and Close the stage.
+func (s *Service) PushHumanMergeOperation(ctx context.Context, installation string, q sdk.HumanMergeRequest, stage *pull_service.PreparedExactMerge, admit HumanReviewAdmission) (observation HumanMergePushObservation, err error) {
+	if stage == nil || admit == nil {
+		return observation, ErrInvalidIntent
+	}
+	intent, err := humanMergeIntent(q)
+	if err != nil {
+		return observation, err
+	}
+	observation.Result = stage.Result()
+	if observation.Result.CommitID == q.Expected.BaseOID {
+		return observation, pull_service.ErrExactMergeRefused{Reason: pull_service.ExactMergeRefusedNoOp}
+	}
+	execution := execcontext.FromContext(ctx)
+	held, err := nativeoperation_model.ReadReservation(ctx)
+	if err != nil {
+		return observation, err
+	}
+	if execution == nil || execution.Owner != held.Owner || execution.Generation != held.Generation {
+		return observation, nativeoperation_model.ErrWrongOwner
+	}
+	proof, err := execcontext.ReadCapabilityFile(execution.CapabilityPath)
+	if err != nil || !execcontext.VerifyProof(held.Verifier, proof) {
+		return observation, nativeoperation_model.ErrWrongOwner
+	}
+	pr, actor, err := checkHumanMergeTarget(ctx, intent.ActorID, q.Expected, admit)
+	if err != nil {
+		return observation, err
+	}
+	if err := pull_service.CheckPreparedMergeHooks(ctx, pr.BaseRepo); err != nil {
+		return observation, err
+	}
+	live, cancel := context.WithDeadline(ctx, time.Unix(q.NotAfter, 0))
+	defer cancel()
+	retire, err := s.BindHumanMergeStage(live, installation, q, stage, admit)
+	if err != nil {
+		return observation, err
+	}
+	defer retire() // The synchronous Git child and its hooks quiesce first.
+	bound := humanMergeCaptureScope(q)
+	bound.NewOID = observation.Result.CommitID
+	encoded, err := encodeScope(bound)
+	if err != nil {
+		return observation, err
+	}
+	guard := func() error {
+		if err := live.Err(); err != nil {
+			return err
+		}
+		// Current session/native policy/source are re-read after LFS too. The
+		// prepared hook performs its own final check under locked ref inputs.
+		if _, _, err := checkHumanMergeTarget(live, intent.ActorID, q.Expected, admit); err != nil {
+			return err
+		}
+		return s.checkHumanMergeCapture(live, installation, intent, encoded)
+	}
+	observation.Attempted, err = stage.PushExact(live, pr, actor, repo_model.MergeStyle(q.Expected.Method), q.Expected.HeadOID, q.Expected.BaseOID, q.Message, guard)
+	// Preserve pending truth on every error; a failed/lost reply and an old tip
+	// never prove non-commit or quiescence of an interrupted process tree.
+	readback := context.WithoutCancel(ctx)
+	current, readErr := nativeoperation_model.LookupOperation(readback, installation, q.OperationID)
+	if readErr == nil && current != nil {
+		observation.Admitted = current.Admitted
+	} else if readErr == nil {
+		readErr = ErrHumanMergePushEvidence
+	}
+	observation.ObservedOID, readErr = readHumanMergeTip(readback, s, intent.RepositoryID, bound.Ref, readErr)
+	if err == nil && readErr == nil && (!observation.Admitted || observation.ObservedOID != observation.Result.CommitID) {
+		readErr = ErrHumanMergePushEvidence
+	}
+	return observation, errors.Join(err, readErr)
+}
+
+func readHumanMergeTip(ctx context.Context, s *Service, repositoryID int64, ref string, earlier error) (string, error) {
+	if earlier != nil {
+		return "", earlier
+	}
+	repository, err := repo_model.GetRepositoryByID(ctx, repositoryID)
+	if err != nil {
+		return "", err
+	}
+	return s.readRef(ctx, repository.RepoPath(), ref)
+}
