+	if !validHumanThreadEvidence(a) || !validHumanThreadEvidence(b) || b.RootCommentID != a.RootCommentID || b.ReviewID != a.ReviewID || b.MemberCount != a.MemberCount || !reflect.DeepEqual(b.OriginalAnchor, a.OriginalAnchor) {
+		return false
+	}
