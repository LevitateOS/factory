@@ -0,0 +1,132 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: MIT
+
+package extensions
+
+import (
+	"context"
+	"net/http"
+	"strconv"
+
+	extension "forgejo.org/extension-sdk"
+	issues_model "forgejo.org/models/issues"
+	access_model "forgejo.org/models/perm/access"
+	repo_model "forgejo.org/models/repo"
+	"forgejo.org/models/unit"
+	user_model "forgejo.org/models/user"
+	"forgejo.org/modules/git"
+	nativeoperation_service "forgejo.org/services/nativeoperation"
+)
+
+func readPullCreateSnapshot(ctx context.Context, admission *callbackAdmission, repository string, q extension.RepositoryPullCreateSnapshotRequest) (*extension.RepositoryPullCreateSnapshot, int) {
+	user, status := resolveCurrentUser(ctx, admission)
+	if status != http.StatusOK {
+		return nil, status
+	}
+	base, err := repo_model.GetRepositoryByID(ctx, mustParsePositiveID(repository))
+	if repo_model.IsErrRepoNotExist(err) {
+		return nil, http.StatusNotFound
+	}
+	if err != nil {
+		return nil, http.StatusServiceUnavailable
+	}
+	head, err := repo_model.GetRepositoryByID(ctx, mustParsePositiveID(q.HeadRepositoryID))
+	if repo_model.IsErrRepoNotExist(err) {
+		return nil, http.StatusNotFound
+	}
+	if err != nil {
+		return nil, http.StatusServiceUnavailable
+	}
+	basePermission, err := access_model.GetUserRepoPermission(ctx, base, user)
+	if err != nil {
+		return nil, http.StatusServiceUnavailable
+	}
+	// Match native explicit-repository comparison: reading base Code/Pulls and
+	// head Code is sufficient. A writer role or owned fork is not required.
+	if !base.AllowsPulls(ctx) {
+		return nil, http.StatusNotFound
+	}
+	for _, kind := range []unit.Type{unit.TypeCode, unit.TypePullRequests} {
+		if kind.UnitGlobalDisabled() || !base.UnitEnabled(ctx, kind) || !basePermission.CanRead(kind) {
+			return nil, http.StatusNotFound
+		}
+	}
+	headPermission, err := access_model.GetUserRepoPermission(ctx, head, user)
+	if err != nil {
+		return nil, http.StatusServiceUnavailable
+	}
+	if !head.UnitEnabled(ctx, unit.TypeCode) || !headPermission.CanRead(unit.TypeCode) {
+		return nil, http.StatusNotFound
+	}
+	if base.ObjectFormatName != head.ObjectFormatName {
+		return nil, http.StatusUnprocessableEntity
+	}
+	baseGit, err := git.OpenRepository(ctx, base.RepoPath())
+	if err != nil {
+		return nil, http.StatusServiceUnavailable
+	}
+	defer baseGit.Close()
+	headGit, err := git.OpenRepository(ctx, head.RepoPath())
+	if err != nil {
+		return nil, http.StatusServiceUnavailable
+	}
+	defer headGit.Close()
+	baseOID := capabilityCommit(baseGit, git.BranchPrefix+q.BaseBranch)
+	headOID := capabilityCommit(headGit, git.BranchPrefix+q.HeadBranch)
+	if baseOID == "" || headOID == "" {
+		return nil, http.StatusNotFound
+	}
+	action := capabilityFact("allowed", "native_pull_create_reads_passed")
+	if base.ID == head.ID && q.BaseBranch == q.HeadBranch {
+		action = capabilityFact("denied", "same_pull_source_and_target")
+	}
+	_, err = issues_model.GetUnmergedPullRequest(ctx, head.ID, base.ID, q.HeadBranch, q.BaseBranch, issues_model.PullRequestFlowGithub)
+	if err == nil {
+		action = capabilityFact("denied", "pull_already_exists")
+	} else if !issues_model.IsErrPullRequestNotExist(err) {
+		return nil, http.StatusServiceUnavailable
+	}
+	if user_model.IsBlocked(ctx, base.OwnerID, user.ID) {
+		action = capabilityFact("denied", "pull_creator_blocked")
+	}
+	if base.IsArchived {
+		action = capabilityFact("denied", "repository_archived")
+	}
+	if _, status := resolveCurrentUser(ctx, admission); status != http.StatusOK {
+		return nil, status
+	}
+	if capabilityCommit(baseGit, git.BranchPrefix+q.BaseBranch) != baseOID || capabilityCommit(headGit, git.BranchPrefix+q.HeadBranch) != headOID {
+		return nil, http.StatusConflict
+	}
+	return &extension.RepositoryPullCreateSnapshot{RepositoryID: repository, ActorID: strconv.FormatInt(user.ID, 10), HeadRepositoryID: q.HeadRepositoryID, BaseBranch: q.BaseBranch, HeadBranch: q.HeadBranch, BaseOID: baseOID, HeadOID: headOID, Action: action}, http.StatusOK
+}
+
+func resolvePullCreateSnapshot(ctx context.Context, admission *callbackAdmission, request extension.CallbackRequest) (*extension.RepositoryPullCreateSnapshot, int) {
+	before, err := nativeoperation_service.Default().ReadNativeRevision(ctx)
+	if err != nil || !before.Idle {
+		return nil, http.StatusServiceUnavailable
+	}
+	first, status := readPullCreateSnapshot(ctx, admission, request.RepositoryID, *request.PullCreateSnapshot)
+	if status != http.StatusOK {
+		return nil, status
+	}
+	second, status := readPullCreateSnapshot(ctx, admission, request.RepositoryID, *request.PullCreateSnapshot)
+	if status == http.StatusNotFound || status == http.StatusUnprocessableEntity {
+		return nil, http.StatusConflict
+	}
+	if status != http.StatusOK {
+		return nil, status
+	}
+	if _, status := resolveCurrentUser(ctx, admission); status != http.StatusOK {
+		return nil, status
+	}
+	after, err := nativeoperation_service.Default().ReadNativeRevision(ctx)
+	if err != nil {
+		return nil, http.StatusServiceUnavailable
+	}
+	if !after.Idle || before.Revision != after.Revision || *first != *second {
+		return nil, http.StatusConflict
+	}
+	first.NativeRevision = before.Revision
+	return first, http.StatusOK
+}
diff --git a/routers/web/extensions/callback_pull_files.go b/routers/web/extensions/callback_pull_files.go
new file mode 100644
index 0000000000000000000000000000000000000000..76ee4364b0e5680b203dd2f2064b5346901aeb4e
--- /dev/null
+++ b/routers/web/extensions/callback_pull_files.go
@@ -0,0 +1,283 @@
+package extensions
+
+import (
+	"bytes"
+	"context"
+	"io"
+	"net/http"
+	"strconv"
+	"strings"
+	"unicode/utf8"
+
+	extension "forgejo.org/extension-sdk"
+	issues_model "forgejo.org/models/issues"
+	repo_model "forgejo.org/models/repo"
+	"forgejo.org/modules/git"
+)
+
+const pullPatchLimit = 16384
+
+// Keep subprocess output bounded and propagate the actual command failure.
+// The UI diff helper logs subprocess errors; an API must not call that an empty
+// complete diff, so this reader uses the same mature Git command owner directly.
+type pullDiffBuffer struct {
+	buffer   bytes.Buffer
+	limit    int
+	exceeded bool
+}
+
+func (b *pullDiffBuffer) Len() int      { return b.buffer.Len() }
+func (b *pullDiffBuffer) Bytes() []byte { return b.buffer.Bytes() }
+
+func (b *pullDiffBuffer) Write(p []byte) (int, error) {
+	remaining := b.limit - b.Len()
+	if len(p) > remaining {
+		_, _ = b.buffer.Write(p[:remaining])
+		b.exceeded = true
+		return remaining, io.ErrShortWrite
+	}
+	return b.buffer.Write(p)
+}
+func pullDiffCommand(ctx context.Context, repo *git.Repository, base, head string, output *pullDiffBuffer, kind string, paths ...string) error {
+	cmd := git.NewCommand(ctx, "--literal-pathspecs", "diff", "--no-ext-diff", "--no-textconv", "--no-color", "--no-relative", "--ignore-submodules=none", "--submodule=short", "--find-renames=50%", "--diff-algorithm=histogram")
+	switch kind {
+	case "raw":
+		cmd.AddArguments("--raw", "-z", "--no-abbrev")
+	case "stat":
+		cmd.AddArguments("--numstat", "-z")
+	case "patch":
+		cmd.AddArguments("--patch", "--src-prefix=a/", "--dst-prefix=b/", "--unified=3")
+	}
+	return cmd.AddDynamicArguments(base, head).AddDashesAndList(paths...).Run(&git.RunOpts{Dir: repo.Path, Stdout: output})
+}
+
+type nativePullFile struct{ old, new, change string }
+
+func pullFileRecords(raw []byte) ([]nativePullFile, bool) {
+	parts := bytes.Split(raw, []byte{0})
+	files := []nativePullFile{}
+	for i := 0; i < len(parts)-1; {
+		header := strings.Fields(string(parts[i]))
+		i++
+		if len(header) != 5 || !strings.HasPrefix(header[0], ":") || i >= len(parts)-1 {
+			return nil, false
+		}
+		path := string(parts[i])
+		i++
+		f := nativePullFile{old: path, new: path, change: "unknown"}
+		switch header[4][0] {
+		case 'A':
+			f.old, f.change = "", "added"
+		case 'D':
+			f.new, f.change = "", "deleted"
+		case 'M', 'T':
+			f.change = "modified"
+		case 'R', 'C':
+			if i >= len(parts)-1 {
+				return nil, false
+			}
+			f.new = string(parts[i])
+			i++
+			f.change = "renamed"
+			if header[4][0] == 'C' {
+				f.change = "copied"
+			}
+		}
+		if path == "" || f.old == "" && f.new == "" || len(f.old) > 4096 || len(f.new) > 4096 || !utf8.ValidString(f.old) || !utf8.ValidString(f.new) {
+			return nil, false
+		}
+		files = append(files, f)
+		if len(files) > 10000 {
+			return nil, false
+		}
+	}
+	return files, len(parts) > 0 && len(parts[len(parts)-1]) == 0
+}
+
+// Numstat uses NUL-delimited names, including a distinct old/new rename pair.
+// Refuse to attribute multiple/mismatched records to one file.
+func pullFileStat(raw []byte, f nativePullFile) (add, del *int, binary, valid bool) {
+	fields := bytes.SplitN(raw, []byte{'\t'}, 3)
+	if len(fields) != 3 {
+		return nil, nil, false, false
+	}
+	paths := bytes.Split(fields[2], []byte{0})
+	if len(paths) == 4 && len(paths[0]) == 0 && len(paths[3]) == 0 {
+		if string(paths[1]) != f.old || string(paths[2]) != f.new {
+			return nil, nil, false, false
+		}
+	} else if len(paths) == 2 && len(paths[1]) == 0 {
+		path := f.new
+		if path == "" {
+			path = f.old
+		}
+		if string(paths[0]) != path {
+			return nil, nil, false, false
+		}
+	} else {
+		return nil, nil, false, false
+	}
+	if string(fields[0]) == "-" && string(fields[1]) == "-" {
+		return nil, nil, true, true
+	}
+	a, e1 := strconv.Atoi(string(fields[0]))
+	d, e2 := strconv.Atoi(string(fields[1]))
+	if e1 != nil || e2 != nil || a < 0 || d < 0 {
+		return nil, nil, false, false
+	}
+	return &a, &d, false, true
+}
+
+func readPullFile(ctx context.Context, repo *git.Repository, base, head string, f nativePullFile) (extension.RepositoryPullFile, error) {
+	item := extension.RepositoryPullFile{OldPath: f.old, NewPath: f.new, Change: f.change, PatchState: "unavailable"}
+	paths := []string{}
+	if f.old != "" {
+		paths = append(paths, f.old)
+	}
+	if f.new != "" && f.new != f.old {
+		paths = append(paths, f.new)
+	}
+	stat := &pullDiffBuffer{limit: 16384}
+	if err := pullDiffCommand(ctx, repo, base, head, stat, "stat", paths...); err != nil {
+		return item, err
+	}
+	add, del, binary, valid := pullFileStat(stat.Bytes(), f)
+	if !valid {
+		return item, nil
+	}
+	if binary {
+		item.PatchState = "binary"
+		return item, nil
+	}
+	item.Additions, item.Deletions = add, del
+	patch := &pullDiffBuffer{limit: pullPatchLimit}
+	err := pullDiffCommand(ctx, repo, base, head, patch, "patch", paths...)
+	if err != nil && !patch.exceeded {
+		return item, err
+	}
+	data := patch.Bytes()
+	if patch.exceeded {
+		// Clipping may split the final UTF-8 rune. Interior invalid bytes are
+		// unrepresentable as text, not silently replaced by the JSON encoder.
+		for len(data) > 0 && !utf8.Valid(data) && len(patch.Bytes())-len(data) < 4 {
+			data = data[:len(data)-1]
+		}
+	}
+	if !utf8.Valid(data) {
+		item.PatchState = "unavailable"
+		return item, nil
+	}
+	text := string(data)
+	item.Patch = &text
+	item.PatchState = "complete"
+	if patch.exceeded {
+		item.PatchState = "truncated"
+	}
+	return item, nil
+}
+
+func pullFilesParent(ctx context.Context, admission *callbackAdmission, repository, index string) (*issues_model.PullRequest, int) {
+	issue, id, status := discussionParent(ctx, admission, repository, extension.RepositoryCommentsRequest{Subject: "pull", Index: index, Limit: 1})
+	if status != http.StatusOK {
+		return nil, status
+	}
+	pr := issue.PullRequest
+	if pr == nil || strconv.FormatInt(pr.ID, 10) != id || pr.IssueID != issue.ID || pr.BaseRepoID != issue.RepoID || pr.Index != issue.Index {
+		return nil, http.StatusServiceUnavailable
+	}
+	return pr, http.StatusOK
+}
+func pullFilesCursor(repository, pull, base, head string, offset int) string {
+	return strings.Join([]string{repository, pull, base, head, strconv.Itoa(offset)}, ".")
+}
+
+func resolveRepositoryPullFiles(ctx context.Context, admission *callbackAdmission, request extension.CallbackRequest) (*extension.RepositoryPullFiles, int) {
+	q := *request.PullFiles
+	pr, status := pullFilesParent(ctx, admission, request.RepositoryID, q.Index)
+	if status != http.StatusOK {
+		return nil, status
+	}
+	repository, err := repo_model.GetRepositoryByID(ctx, pr.BaseRepoID)
+	if err != nil {
+		return nil, http.StatusServiceUnavailable
+	}
+	native, err := git.OpenRepository(ctx, repository.RepoPath())
+	if err != nil {
+		return nil, http.StatusServiceUnavailable
+	}
+	defer native.Close()
+	base := pr.MergeBase
+	head, err := native.GetRefCommitID(pr.GetGitRefName())
+	if err != nil || !extension.ValidPullDiffCommit(base) || !extension.ValidPullDiffCommit(head) {
+		return nil, http.StatusServiceUnavailable
+	}
+	baseCommit, err := native.GetCommit(base)
+	if err != nil || baseCommit.ID.String() != base {
+		return nil, http.StatusServiceUnavailable
+	}
+	headCommit, err := native.GetCommit(head)
+	if err != nil || headCommit.ID.String() != head {
+		return nil, http.StatusServiceUnavailable
+	}
+	if base != head {
+		ancestor, err := headCommit.HasPreviousCommit(baseCommit.ID)
+		if err != nil || !ancestor {
+			return nil, http.StatusServiceUnavailable
+		}
+	}
+	if q.Base != "" && (q.Base != base || q.Head != head) {
+		return nil, http.StatusConflict
+	}
+	id := strconv.FormatInt(pr.ID, 10)
+	offset := 0
+	if q.Cursor != "" {
+		parts := strings.Split(q.Cursor, ".")
+		if len(parts) != 5 {
+			return nil, http.StatusBadRequest
+		}
+		offset, err = strconv.Atoi(parts[4])
+		if err != nil || offset < 1 || q.Cursor != pullFilesCursor(request.RepositoryID, id, base, head, offset) {
+			return nil, http.StatusBadRequest
+		}
+	}
+	raw := &pullDiffBuffer{limit: 2 * 1024 * 1024}
+	err = pullDiffCommand(ctx, native, base, head, raw, "raw")
+	if raw.exceeded {
+		return nil, http.StatusRequestEntityTooLarge
+	}
+	if err != nil {
+		return nil, http.StatusServiceUnavailable
+	}
+	files, valid := pullFileRecords(raw.Bytes())
+	if !valid {
+		return nil, http.StatusServiceUnavailable
+	}
+	if offset > 0 && offset >= len(files) {
+		return nil, http.StatusBadRequest
+	}
+	end := min(offset+q.Limit, len(files))
+	page := &extension.RepositoryPullFiles{RepositoryID: request.RepositoryID, PullID: id, Index: q.Index, Base: base, Head: head, Items: []extension.RepositoryPullFile{}}
+	for _, f := range files[offset:end] {
+		item, err := readPullFile(ctx, native, base, head, f)
+		if err != nil {
+			return nil, http.StatusServiceUnavailable
+		}
+		page.Items = append(page.Items, item)
+	}
+	if end < len(files) {
+		page.NextCursor = pullFilesCursor(request.RepositoryID, id, base, head, end)
+	}
+	// Recheck current native authority, parent and head after all Git I/O.
+	after, status := pullFilesParent(ctx, admission, request.RepositoryID, q.Index)
+	if status != http.StatusOK {
+		return nil, status
+	}
+	afterHead, err := native.GetRefCommitID(after.GetGitRefName())
+	if err != nil {
+		return nil, http.StatusServiceUnavailable
+	}
+	if after.ID != pr.ID || after.MergeBase != base || afterHead != head || after.HeadRepoID != pr.HeadRepoID || after.HeadBranch != pr.HeadBranch || after.BaseBranch != pr.BaseBranch {
+		return nil, http.StatusConflict
+	}
+	return page, http.StatusOK
+}
diff --git a/routers/web/extensions/callback_pulls.go b/routers/web/extensions/callback_pulls.go
new file mode 100644
index 0000000000000000000000000000000000000000..7a330c68610e15aa6ad54c8d0bd1a889971dfefd
--- /dev/null
+++ b/routers/web/extensions/callback_pulls.go
@@ -0,0 +1,118 @@
+package extensions
+
+import (
+	"context"
+	"net/http"
+	"strconv"
+	"time"
+
+	extension "forgejo.org/extension-sdk"
+	"forgejo.org/models/db"
+	issues_model "forgejo.org/models/issues"
+	access_model "forgejo.org/models/perm/access"
+	repo_model "forgejo.org/models/repo"
+	"forgejo.org/models/unit"
+	"xorm.io/builder"
+)
+
+func readablePullRepository(ctx context.Context, admission *callbackAdmission, repository string) int {
+	if _, status := resolveRepository(ctx, admission, repository); status != http.StatusOK {
+		return status
+	}
+	user, status := resolveCurrentUser(ctx, admission)
+	if status != http.StatusOK {
+		return status
+	}
+	repo, err := repo_model.GetRepositoryByID(ctx, mustParsePositiveID(repository))
+	if err != nil {
+		return http.StatusServiceUnavailable
+	}
+	permission, err := access_model.GetUserRepoPermission(ctx, repo, user)
+	if err != nil {
+		return http.StatusServiceUnavailable
+	}
+	if !permission.CanRead(unit.TypePullRequests) {
+		return http.StatusNotFound
+	}
+	return http.StatusOK
+}
+
+func resolveRepositoryPulls(ctx context.Context, admission *callbackAdmission, request extension.CallbackRequest) (*extension.RepositoryPullPage, int) {
+	if status := readablePullRepository(ctx, admission, request.RepositoryID); status != http.StatusOK {
+		return nil, status
+	}
+	q := *request.Pulls
+	var issues []*issues_model.Issue
+	if q.Index != "" {
+		issue, err := issues_model.GetIssueByIndex(ctx, mustParsePositiveID(request.RepositoryID), mustParsePositiveID(q.Index))
+		if issues_model.IsErrIssueNotExist(err) || err == nil && !issue.IsPull {
+			return nil, http.StatusNotFound
+		}
+		if err != nil {
+			return nil, http.StatusServiceUnavailable
+		}
+		issues = append(issues, issue)
+	} else {
+		condition := builder.Eq{"repo_id": mustParsePositiveID(request.RepositoryID), "is_pull": true}
+		if q.State != "all" {
+			condition["is_closed"] = q.State == "closed"
+		}
+		bound := int64(0)
+		if q.Cursor != "" {
+			bound = mustParsePositiveID(q.Cursor)
+		}
+		if err := db.GetEngine(ctx).Where(condition).And(builder.Gt{"`index`": bound}).Asc("index").Limit(q.Limit + 1).Find(&issues); err != nil {
+			return nil, http.StatusServiceUnavailable
+		}
+	}
+	page := &extension.RepositoryPullPage{RepositoryID: request.RepositoryID, Items: []extension.RepositoryPull{}}
+	if len(issues) > q.Limit {
+		issues = issues[:q.Limit]
+		page.NextCursor = strconv.FormatInt(issues[len(issues)-1].Index, 10)
+	}
+	for _, issue := range issues {
+		if err := issue.LoadPullRequest(ctx); err != nil || issue.PullRequest == nil {
+			return nil, http.StatusServiceUnavailable
+		}
+		pr := issue.PullRequest
+		if pr.ID < 1 || pr.IssueID != issue.ID || pr.Index != issue.Index || pr.BaseRepoID != issue.RepoID {
+			return nil, http.StatusServiceUnavailable
+		}
+		if err := issue.LoadPoster(ctx); err != nil {
+			return nil, http.StatusServiceUnavailable
+		}
+		pr.Issue = issue
+		item := extension.RepositoryPull{ID: strconv.FormatInt(pr.ID, 10), Index: strconv.FormatInt(issue.Index, 10), Title: issue.Title, Body: issue.Content, Closed: issue.IsClosed, Merged: pr.HasMerged, Draft: pr.IsWorkInProgress(ctx), BaseBranch: pr.BaseBranch}
+		if issue.Poster != nil && issue.Poster.ID > 0 {
+			item.Author = &extension.RepositoryIssueActor{ID: strconv.FormatInt(issue.Poster.ID, 10), Username: issue.Poster.Name}
+		}
+		if issue.CreatedUnix > 0 {
+			value := time.Unix(int64(issue.CreatedUnix), 0).UTC()
+			item.CreatedAt = &value
+		}
+		if issue.UpdatedUnix > 0 {
+			value := time.Unix(int64(issue.UpdatedUnix), 0).UTC()
+			item.UpdatedAt = &value
+		}
+		if pr.HasMerged && pr.MergedUnix > 0 {
+			value := time.Unix(int64(pr.MergedUnix), 0).UTC()
+			item.MergedAt = &value
+		}
+		if pr.HeadRepoID > 0 {
+			head, status := resolveRepository(ctx, admission, strconv.FormatInt(pr.HeadRepoID, 10))
+			switch status {
+			case http.StatusOK:
+				item.Head = &extension.RepositoryPullSide{RepositoryID: head.ID, Owner: head.Owner, Name: head.Name, Branch: pr.HeadBranch}
+			case http.StatusNotFound: // A deleted or inaccessible head does not hide the visible PR.
+			default:
+				return nil, status
+			}
+		}
+		page.Items = append(page.Items, item)
+	}
+	// Reload repository/unit permissions after all metadata and head reads.
+	if status := readablePullRepository(ctx, admission, request.RepositoryID); status != http.StatusOK {
+		return nil, status
+	}
+	return page, http.StatusOK
+}
diff --git a/routers/web/extensions/callback_review_request_snapshot.go b/routers/web/extensions/callback_review_request_snapshot.go
new file mode 100644
index 0000000000000000000000000000000000000000..7df5e73da29d43a66277143d9ec289a8682fde75
--- /dev/null
+++ b/routers/web/extensions/callback_review_request_snapshot.go
@@ -0,0 +1,79 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: MIT
+
+package extensions
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"reflect"
+
+	extension "forgejo.org/extension-sdk"
+	issues_model "forgejo.org/models/issues"
+	nativeoperation_service "forgejo.org/services/nativeoperation"
+)
+
+type reviewRequestSnapshotFacts struct {
+	Snapshot extension.RepositoryReviewRequestSnapshot
+	Parent   reviewSnapshotFacts
+}
+
+func readReviewRequestSnapshot(ctx context.Context, admission *callbackAdmission, repository string, q extension.RepositoryReviewRequestSnapshotRequest) (*reviewRequestSnapshotFacts, int) {
+	parent, status := readReviewSnapshot(ctx, admission, repository, extension.RepositoryReviewSnapshotRequest{Index: q.Index})
+	if status != http.StatusOK {
+		return nil, status
+	}
+	actor, status := resolveCurrentUser(ctx, admission)
+	if status != http.StatusOK {
+		return nil, status
+	}
+	issue, err := issues_model.GetIssueByID(ctx, mustParsePositiveID(parent.Snapshot.IssueID))
+	if err != nil {
+		return nil, http.StatusServiceUnavailable
+	}
+	if issue.RepoID != mustParsePositiveID(repository) || !issue.IsPull {
+		return nil, http.StatusConflict
+	}
+	selection, err := nativeoperation_service.ReadHumanReviewRequestSelection(ctx, actor, issue, q.ReviewerKind, mustParsePositiveID(q.ReviewerID))
+	if errors.Is(err, nativeoperation_service.ErrHumanReviewRequestMissing) {
+		return nil, http.StatusNotFound
+	}
+	if errors.Is(err, nativeoperation_service.ErrHumanReviewRequestTooLarge) {
+		return nil, http.StatusRequestEntityTooLarge
+	}
+	if err != nil {
+		return nil, http.StatusServiceUnavailable
+	}
+	return &reviewRequestSnapshotFacts{Snapshot: extension.RepositoryReviewRequestSnapshot{Review: parent.Snapshot, ReviewerKind: q.ReviewerKind, ReviewerID: q.ReviewerID, Requests: selection.Requests, AddAction: selection.AddAction, RemoveAction: selection.RemoveAction}, Parent: *parent}, http.StatusOK
+}
+
+func resolveReviewRequestSnapshot(ctx context.Context, admission *callbackAdmission, request extension.CallbackRequest) (*extension.RepositoryReviewRequestSnapshot, int) {
+	before, err := nativeoperation_service.Default().ReadNativeRevision(ctx)
+	if err != nil || !before.Idle {
+		return nil, http.StatusServiceUnavailable
+	}
+	first, status := readReviewRequestSnapshot(ctx, admission, request.RepositoryID, *request.ReviewRequestSnapshot)
+	if status != http.StatusOK {
+		return nil, status
+	}
+	second, status := readReviewRequestSnapshot(ctx, admission, request.RepositoryID, *request.ReviewRequestSnapshot)
+	if status == http.StatusNotFound {
+		return nil, http.StatusConflict
+	}
+	if status != http.StatusOK {
+		return nil, status
+	}
+	if _, status := resolveCurrentUser(ctx, admission); status != http.StatusOK {
+		return nil, status
+	}
+	after, err := nativeoperation_service.Default().ReadNativeRevision(ctx)
+	if err != nil {
+		return nil, http.StatusServiceUnavailable
+	}
+	if !after.Idle || after.Revision != before.Revision || !reflect.DeepEqual(first, second) {
+		return nil, http.StatusConflict
+	}
+	first.Snapshot.Review.NativeRevision = before.Revision
+	return &first.Snapshot, http.StatusOK
+}
diff --git a/routers/web/extensions/callback_review_snapshot.go b/routers/web/extensions/callback_review_snapshot.go
new file mode 100644
index 0000000000000000000000000000000000000000..cdd0e0e978e61c0828c9405b416d7ebe485986b3
--- /dev/null
+++ b/routers/web/extensions/callback_review_snapshot.go
@@ -0,0 +1,126 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: MIT
+
+package extensions
+
+import (
+	"context"
+	"net/http"
+	"strconv"
+
+	extension "forgejo.org/extension-sdk"
+	issues_model "forgejo.org/models/issues"
+	access_model "forgejo.org/models/perm/access"
+	repo_model "forgejo.org/models/repo"
+	"forgejo.org/models/unit"
+	user_model "forgejo.org/models/user"
+	"forgejo.org/modules/git"
+	nativeoperation_service "forgejo.org/services/nativeoperation"
+)
+
+// Compare private source/author facts as well as the public preparation without
+// disclosing a private fork's repository ID or branch in the SDK response.
+type reviewSnapshotFacts struct {
+	Snapshot                                     extension.RepositoryReviewSnapshot
+	HeadRepositoryID, PosterID, OriginalAuthorID int64
+	HeadBranch                                   string
+}
+
+func resolveReviewSnapshot(ctx context.Context, admission *callbackAdmission, request extension.CallbackRequest) (*extension.RepositoryReviewSnapshot, int) {
+	before, err := nativeoperation_service.Default().ReadNativeRevision(ctx)
+	if err != nil || !before.Idle {
+		return nil, http.StatusServiceUnavailable
+	}
+	first, status := readReviewSnapshot(ctx, admission, request.RepositoryID, *request.ReviewSnapshot)
+	if status != http.StatusOK {
+		return nil, status
+	}
+	second, status := readReviewSnapshot(ctx, admission, request.RepositoryID, *request.ReviewSnapshot)
+	if status == http.StatusNotFound {
+		return nil, http.StatusConflict
+	}
+	if status != http.StatusOK {
+		return nil, status
+	}
+	after, err := nativeoperation_service.Default().ReadNativeRevision(ctx)
+	if err != nil {
+		return nil, http.StatusServiceUnavailable
+	}
+	if !after.Idle || after.Revision != before.Revision || *first != *second {
+		return nil, http.StatusConflict
+	}
+	first.Snapshot.NativeRevision = before.Revision
+	return &first.Snapshot, http.StatusOK
+}
+
+func readReviewSnapshot(ctx context.Context, admission *callbackAdmission, repository string, q extension.RepositoryReviewSnapshotRequest) (*reviewSnapshotFacts, int) {
+	pr, status := pullFilesParent(ctx, admission, repository, q.Index)
+	if status != http.StatusOK {
+		return nil, status
+	}
+	user, status := resolveCurrentUser(ctx, admission)
+	if status != http.StatusOK {
+		return nil, status
+	}
+	repo, err := repo_model.GetRepositoryByID(ctx, pr.BaseRepoID)
+	if err != nil {
+		return nil, http.StatusServiceUnavailable
+	}
+	permission, err := access_model.GetUserRepoPermission(ctx, repo, user)
+	if err != nil {
+		return nil, http.StatusServiceUnavailable
+	}
+	for _, kind := range []unit.Type{unit.TypeCode, unit.TypePullRequests} {
+		if kind.UnitGlobalDisabled() || !repo.UnitEnabled(ctx, kind) || !permission.CanRead(kind) {
+			return nil, http.StatusNotFound
+		}
+	}
+	if !repo.AllowsPulls(ctx) {
+		return nil, http.StatusNotFound
+	}
+	native, err := git.OpenRepository(ctx, repo.RepoPath())
+	if err != nil {
+		return nil, http.StatusServiceUnavailable
+	}
+	defer native.Close()
+	head, base := capabilityCommit(native, pr.GetGitRefName()), capabilityCommit(native, git.BranchPrefix+pr.BaseBranch)
+	if head == "" || base == "" {
+		return nil, http.StatusServiceUnavailable
+	}
+	mergeBase, err := native.GetMergeBaseSimple(base, head)
+	if err != nil || !extension.ValidPullDiffCommit(mergeBase) {
+		return nil, http.StatusServiceUnavailable
+	}
+	if capabilityCommit(native, pr.GetGitRefName()) != head || capabilityCommit(native, git.BranchPrefix+pr.BaseBranch) != base {
+		return nil, http.StatusConflict
+	}
+	issue := pr.Issue
+	snapshot := extension.RepositoryReviewSnapshot{RepositoryID: repository, ActorID: strconv.FormatInt(user.ID, 10), PullID: strconv.FormatInt(pr.ID, 10), IssueID: strconv.FormatInt(issue.ID, 10), Index: q.Index, BaseBranch: pr.BaseBranch, HeadOID: head, BaseOID: base, MergeBaseOID: mergeBase, IsClosed: issue.IsClosed, HasMerged: pr.HasMerged, IsAuthor: issue.IsPoster(user.ID),
+		CommentAction: capabilityFact("allowed", "review_comment"), DraftAction: capabilityFact("allowed", "review_start_draft"), ApproveAction: capabilityFact("allowed", "review_approve"), RequestChangesAction: capabilityFact("allowed", "review_request_changes")}
+	pending, err := issues_model.GetCurrentReview(ctx, user, issue)
+	if err != nil && !issues_model.IsErrReviewNotExist(err) {
+		return nil, http.StatusServiceUnavailable
+	}
+	if pending != nil {
+		snapshot.PendingReviewID = strconv.FormatInt(pending.ID, 10)
+		snapshot.PendingCommitID = pending.CommitID
+		snapshot.DraftAction = capabilityFact("allowed", "review_continue_draft")
+	}
+	if snapshot.IsAuthor {
+		snapshot.ApproveAction = capabilityFact("denied", "self_review")
+		snapshot.RequestChangesAction = capabilityFact("denied", "self_review")
+	}
+	if user_model.IsBlockedMultiple(ctx, []int64{repo.OwnerID, issue.PosterID}, user.ID) {
+		snapshot.CommentAction = capabilityFact("denied", "review_actor_blocked")
+		snapshot.DraftAction = snapshot.CommentAction
+		snapshot.ApproveAction = snapshot.CommentAction
+		snapshot.RequestChangesAction = snapshot.CommentAction
+	}
+	if repo.IsArchived {
+		snapshot.CommentAction = capabilityFact("denied", "repository_archived")
+		snapshot.DraftAction = snapshot.CommentAction
+		snapshot.ApproveAction = snapshot.CommentAction
+		snapshot.RequestChangesAction = snapshot.CommentAction
+	}
+	return &reviewSnapshotFacts{Snapshot: snapshot, HeadRepositoryID: pr.HeadRepoID, HeadBranch: pr.HeadBranch, PosterID: issue.PosterID, OriginalAuthorID: issue.OriginalAuthorID}, http.StatusOK
+}
diff --git a/routers/web/extensions/callback_reviews.go b/routers/web/extensions/callback_reviews.go
new file mode 100644
index 0000000000000000000000000000000000000000..f75cba8cb09294c86aa8d9cc3d961ee67dfaface
--- /dev/null
+++ b/routers/web/extensions/callback_reviews.go
@@ -0,0 +1,114 @@
+package extensions
+
+import (
+	"context"
+	"net/http"
+	"strconv"
+	"time"
+
+	extension "forgejo.org/extension-sdk"
+	"forgejo.org/models/db"
+	issues_model "forgejo.org/models/issues"
+	user_model "forgejo.org/models/user"
+	"xorm.io/builder"
+)
+
+// The same draft rule as Fountain's native review API, evaluated from a fresh
+// native user. A caller's actor/admin selectors never supply this authority.
+func readableReviewCondition(issue int64, user *user_model.User) builder.Cond {
+	cond := builder.Eq{"issue_id": issue}.And(builder.Neq{"type": issues_model.ReviewTypeRequest})
+	if !user.IsAdmin {
+		cond = cond.And(builder.Or(builder.Neq{"type": issues_model.ReviewTypePending}, builder.Eq{"reviewer_id": user.ID}))
+	}
+	return cond
+}
+func resolveRepositoryReviews(ctx context.Context, admission *callbackAdmission, request extension.CallbackRequest) (*extension.RepositoryReviewPage, int) {
+	q := *request.Reviews
+	issue, id, status := discussionParent(ctx, admission, request.RepositoryID, extension.RepositoryCommentsRequest{Subject: "pull", Index: q.Index, Limit: 1})
+	if status != http.StatusOK {
+		return nil, status
+	}
+	if issue.PullRequest == nil || issue.PullRequest.IssueID != issue.ID || issue.PullRequest.BaseRepoID != issue.RepoID || issue.PullRequest.Index != issue.Index {
+		return nil, http.StatusServiceUnavailable
+	}
+	user, status := resolveCurrentUser(ctx, admission)
+	if status != http.StatusOK {
+		return nil, status
+	}
+	cond := readableReviewCondition(issue.ID, user)
+	if q.ReviewID != "" {
+		cond = cond.And(builder.Eq{"id": mustParsePositiveID(q.ReviewID)})
+	}
+	if q.Cursor != "" {
+		cond = cond.And(builder.Gt{"id": mustParsePositiveID(q.Cursor)})
+	}
+	var reviews []*issues_model.Review
+	if err := db.GetEngine(ctx).Where(cond).Asc("id").Limit(q.Limit + 1).Find(&reviews); err != nil {
+		return nil, http.StatusServiceUnavailable
+	}
+	if q.ReviewID != "" && len(reviews) != 1 {
+		return nil, http.StatusNotFound
+	}
+	page := &extension.RepositoryReviewPage{RepositoryID: request.RepositoryID, PullID: id, Index: q.Index, Items: []extension.RepositoryReview{}}
+	if len(reviews) > q.Limit {
+		reviews = reviews[:q.Limit]
+		page.NextCursor = strconv.FormatInt(reviews[len(reviews)-1].ID, 10)
+	}
+	ids := make([]int64, 0, len(reviews))
+	for _, review := range reviews {
+		ids = append(ids, review.ID)
+		if err := review.LoadReviewer(ctx); err != nil {
+			return nil, http.StatusServiceUnavailable
+		}
+		item := extension.RepositoryReview{ID: strconv.FormatInt(review.ID, 10), State: "unknown", Body: review.Content, Stale: review.Stale, Official: review.Official}
+		switch review.Type {
+		case issues_model.ReviewTypePending:
+			item.State = "pending"
+		case issues_model.ReviewTypeApprove:
+			item.State = "approved"
+		case issues_model.ReviewTypeComment:
+			item.State = "commented"
+		case issues_model.ReviewTypeReject:
+			item.State = "changes_requested"
+		}
+		if review.Dismissed && review.Type != issues_model.ReviewTypePending {
+			item.State = "dismissed"
+		}
+		if extension.ValidPullDiffCommit(review.CommitID) {
+			item.Commit = review.CommitID
+		}
+		if review.Reviewer != nil && review.Reviewer.ID > 0 {
+			item.Author = &extension.RepositoryIssueActor{ID: strconv.FormatInt(review.Reviewer.ID, 10), Username: review.Reviewer.Name}
+		}
+		// This follows native API's CreatedUnix convention for submitted reviews.
+		// A draft's creation time must not become a submission timestamp.
+		if review.Type != issues_model.ReviewTypePending && review.CreatedUnix > 0 {
+			value := time.Unix(int64(review.CreatedUnix), 0).UTC()
+			item.SubmittedAt = &value
+		}
+		page.Items = append(page.Items, item)
+	}
+	after, afterID, status := discussionParent(ctx, admission, request.RepositoryID, extension.RepositoryCommentsRequest{Subject: "pull", Index: q.Index, Limit: 1})
+	if status != http.StatusOK {
+		return nil, status
+	}
+	if afterID != id || after.ID != issue.ID {
+		return nil, http.StatusServiceUnavailable
+	}
+	current, status := resolveCurrentUser(ctx, admission)
+	if status != http.StatusOK {
+		return nil, status
+	}
+	// A returned public review may become another user's pending review while
+	// I/O is in progress. Reload visibility; a cached draft check can leak it.
+	if len(ids) > 0 {
+		count, err := db.GetEngine(ctx).Where(readableReviewCondition(after.ID, current)).In("id", ids).Count(new(issues_model.Review))
+		if err != nil {
+			return nil, http.StatusServiceUnavailable
+		}
+		if count != int64(len(ids)) {
+			return nil, http.StatusNotFound
+		}
+	}
+	return page, http.StatusOK
+}
